@prefix : <http://purl.org/ontoksd#> .
@prefix dc: <http://purl.org/dc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontoksd: <http://purl.org/ontoksd/> .
@base <http://purl.org/ontoksd/> .

<http://purl.org/ontoksd/> rdf:type owl:Ontology ;
                            owl:versionIRI <http://purl.org/ontoksd/> ;
                            owl:imports <file:/I:/Meu%20Drive/OntoKSD/cc2020Vocabulary/cc2020-dispositions.ttl> ,
                                        <file:/I:/Meu%20Drive/OntoKSD/cc2020Vocabulary/cc2020-foundational-knowledge.ttl> ,
                                        <file:/I:/Meu%20Drive/OntoKSD/cc2020Vocabulary/cc2020-knowledge.ttl> ,
                                        <file:/I:/Meu%20Drive/OntoKSD/cc2020Vocabulary/ontoksd-knowledgeType-full-mapping.ttl> ,
                                        <file:/I:/Meu%20Drive/OntoKSD/ontoKSDOntology/ontoKSD-Bloom-mapping.ttl> ,
                                        <file:/I:/Meu%20Drive/OntoKSD/ontoKSDOntology/ontoKSD-knowledgeType.ttl> ,
                                        <http://purl.org/edu/bloom> ,
                                        <http://www.w3.org/2004/02/skos/core> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/ontoksd/consistsOfLevels
ontoksd:consistsOfLevels rdf:type owl:ObjectProperty ;
                         rdfs:domain <http://purl.org/ontoksd/ontoksd#Scale> ;
                         rdfs:range <http://purl.org/ontoksd/ontoksd#ProficiencyLevel> .


###  http://purl.org/ontoksd/hasCognitiveLevel
ontoksd:hasCognitiveLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain <http://purl.org/ontoksd/ontoksd#Skill> ;
                          rdfs:range <http://purl.org/edu/bloom#CognitiveProcessLevel> .


###  http://purl.org/ontoksd/hasPersonModelCompetenceElement
ontoksd:hasPersonModelCompetenceElement rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#hasCompetenceElement> ;
                                        rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                        rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> .


###  http://purl.org/ontoksd/hasPrerequisiteCompetence
ontoksd:hasPrerequisiteCompetence rdf:type owl:ObjectProperty ;
                                  rdfs:domain <http://purl.org/ontoksd/ontoksd#InstructionalEntity> ;
                                  rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> .


###  http://purl.org/ontoksd/hasTargetCompetence
ontoksd:hasTargetCompetence rdf:type owl:ObjectProperty ;
                            rdfs:domain <http://purl.org/ontoksd/ontoksd#InstructionalEntity> ;
                            rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> .


###  http://purl.org/ontoksd/representsKnowledgeArea
ontoksd:representsKnowledgeArea rdf:type owl:ObjectProperty ;
                                rdfs:domain <http://purl.org/ontoksd/ontoksd#Knowledge> ;
                                rdfs:range skos:Concept .


###  http://purl.org/ontoksd/ontoksd#acquiredIn
<http://purl.org/ontoksd/ontoksd#acquiredIn> rdf:type owl:ObjectProperty ;
                                             rdfs:range <http://purl.org/ontoksd/ontoksd#InstructionalEntity> ;
                                             rdfs:comment "Indicates where a learning goal was acquired."@en .


###  http://purl.org/ontoksd/ontoksd#aplliesFor
<http://purl.org/ontoksd/ontoksd#aplliesFor> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                             rdfs:range <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                             rdfs:comment "Specifies the role a person is applying for."@en .


###  http://purl.org/ontoksd/ontoksd#appliesKnowledge
<http://purl.org/ontoksd/ontoksd#appliesKnowledge> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#Skill> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#Knowledge> ;
                                                   rdfs:comment "Indicates that a Skill requires certain Knowledge."@en .


###  http://purl.org/ontoksd/ontoksd#assessesCompetenceElement
<http://purl.org/ontoksd/ontoksd#assessesCompetenceElement> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                            rdfs:range <http://purl.org/ontoksd/ontoksd#Competency> .


###  http://purl.org/ontoksd/ontoksd#consistsOf
<http://purl.org/ontoksd/ontoksd#consistsOf> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                             rdfs:range <http://purl.org/ontoksd/ontoksd#Competency> ;
                                             rdfs:comment "Indicates the set of Competencies that form a Competence."@en .


###  http://purl.org/ontoksd/ontoksd#equivalentClass
<http://purl.org/ontoksd/ontoksd#equivalentClass> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                  rdfs:range <http://purl.org/ontoksd/ontoksd#RCD> ;
                                                  rdfs:comment "Equivalence relation to another class such as RCD."@en .


###  http://purl.org/ontoksd/ontoksd#evidenceBasedOn
<http://purl.org/ontoksd/ontoksd#evidenceBasedOn> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                  rdfs:range <http://purl.org/ontoksd/ontoksd#InstructionalEntity> ;
                                                  rdfs:comment "Links the evidence to the Instructional Entity it is derived from."@en .


###  http://purl.org/ontoksd/ontoksd#evidencesCompetence
<http://purl.org/ontoksd/ontoksd#evidencesCompetence> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                      rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                      rdfs:comment "Specifies the Competence being evidenced by a given evidence."@en .


###  http://purl.org/ontoksd/ontoksd#forCompetence
<http://purl.org/ontoksd/ontoksd#forCompetence> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://purl.org/ontoksd/ontoksd#DocumentDetail> ;
                                                rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                rdfs:comment "Indicates the competence detail supported by the document."@en .


###  http://purl.org/ontoksd/ontoksd#forCompetenceElement
<http://purl.org/ontoksd/ontoksd#forCompetenceElement> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://purl.org/ontoksd/ontoksd#DocumentDetail> ;
                                                       rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                       rdfs:comment "Indicates the competency detail supported by the document."@en .


###  http://purl.org/ontoksd/ontoksd#hasAcquisitionContext
<http://purl.org/ontoksd/ontoksd#hasAcquisitionContext> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <http://purl.org/ontoksd/ontoksd#InstructionalEntity> ;
                                                        rdfs:range <http://purl.org/ontoksd/ontoksd#AcquisitionContext> ;
                                                        rdfs:comment "Specifies the context of acquisition for an instructional entity."@en .


###  http://purl.org/ontoksd/ontoksd#hasAgencyType
<http://purl.org/ontoksd/ontoksd#hasAgencyType> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://purl.org/ontoksd/ontoksd#Agency> ;
                                                rdfs:range <http://purl.org/ontoksd/ontoksd#AgencyType> ;
                                                rdfs:comment "Specifies the type of the agency."@en .


###  http://purl.org/ontoksd/ontoksd#hasAttitude
<http://purl.org/ontoksd/ontoksd#hasAttitude> rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#hasDisposition> ;
                                              owl:inverseOf <http://purl.org/ontoksd/ontoksd#isAttitudeFor> ;
                                              rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                              rdfs:range <http://purl.org/ontoksd/ontoksd#Attitude> .


###  http://purl.org/ontoksd/ontoksd#hasAttitudeType
<http://purl.org/ontoksd/ontoksd#hasAttitudeType> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#hasDispositionType> ;
                                                  rdfs:domain <http://purl.org/ontoksd/ontoksd#Attitude> ;
                                                  rdfs:range <http://purl.org/ontoksd/ontoksd#AttitudeType> ;
                                                  rdfs:comment "Relates an Attitude to its categorized type."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceContext
<http://purl.org/ontoksd/ontoksd#hasCompetenceContext> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                       rdfs:range <http://purl.org/ontoksd/ontoksd#Context> ;
                                                       rdfs:comment "Specifies the context in which a Competence is applied."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceDetailContext
<http://purl.org/ontoksd/ontoksd#hasCompetenceDetailContext> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                             rdfs:range <http://purl.org/ontoksd/ontoksd#Context> ;
                                                             rdfs:comment "Contextual information about the Competence Detail."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceElement
<http://purl.org/ontoksd/ontoksd#hasCompetenceElement> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf <http://purl.org/ontoksd/ontoksd#isCompetenceElementFor> ;
                                                       rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                       rdfs:range <http://purl.org/ontoksd/ontoksd#Competency> ;
                                                       rdfs:comment "As propriedades hasSkill, hasKnowledge e hasAttitude foram criadas como subpropriedades de hasCompetenceElement."@en ,
                                                                    "Indicates the competency detail of a person."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceElementContext
<http://purl.org/ontoksd/ontoksd#hasCompetenceElementContext> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <http://purl.org/ontoksd/ontoksd#Competency> ;
                                                              rdfs:range <http://purl.org/ontoksd/ontoksd#Context> ;
                                                              rdfs:comment "Context in which the Competency is expressed or observed."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceElementDetailContext
<http://purl.org/ontoksd/ontoksd#hasCompetenceElementDetailContext> rdf:type owl:ObjectProperty ;
                                                                    rdfs:domain <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                                    rdfs:range <http://purl.org/ontoksd/ontoksd#Context> ;
                                                                    rdfs:comment "Contextualizes a Competency Detail."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceElementLevel
<http://purl.org/ontoksd/ontoksd#hasCompetenceElementLevel> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                            rdfs:range <http://purl.org/ontoksd/ontoksd#ProficiencyLevel> ;
                                                            rdfs:comment "Assigns a Level to a Competency Detail."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceElementScale
<http://purl.org/ontoksd/ontoksd#hasCompetenceElementScale> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://purl.org/ontoksd/ontoksd#Competency> ;
                                                            rdfs:range <http://purl.org/ontoksd/ontoksd#Scale> ;
                                                            rdfs:comment "Specifies the measurement scale for a Competency."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceLevel
<http://purl.org/ontoksd/ontoksd#hasCompetenceLevel> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#ProficiencyLevel> ;
                                                     rdfs:comment "Assigns a Level to a Competence Detail."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceScale
<http://purl.org/ontoksd/ontoksd#hasCompetenceScale> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#Scale> ;
                                                     rdfs:comment "Defines the scale used to measure a Competence."@en .


###  http://purl.org/ontoksd/ontoksd#hasCompetenceType
<http://purl.org/ontoksd/ontoksd#hasCompetenceType> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                    rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceType> ;
                                                    rdfs:comment "Specifies whether a competence is atomic, composite, or another type."@en .


###  http://purl.org/ontoksd/ontoksd#hasComponent
<http://purl.org/ontoksd/ontoksd#hasComponent> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <http://purl.org/ontoksd/ontoksd#isComponentOf> ;
                                               rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                               rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> .


###  http://purl.org/ontoksd/ontoksd#hasDisposition
<http://purl.org/ontoksd/ontoksd#hasDisposition> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#hasCompetenceElement> ;
                                                 owl:inverseOf <http://purl.org/ontoksd/ontoksd#isDispositionFor> ;
                                                 rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                 rdfs:range <http://purl.org/ontoksd/ontoksd#Disposition> .


###  http://purl.org/ontoksd/ontoksd#hasDispositionType
<http://purl.org/ontoksd/ontoksd#hasDispositionType> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#Disposition> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#DispositionType> .


###  http://purl.org/ontoksd/ontoksd#hasEducation
<http://purl.org/ontoksd/ontoksd#hasEducation> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                               rdfs:comment "Links a person model to their educational background."@en .


###  http://purl.org/ontoksd/ontoksd#hasEducationLevel
<http://purl.org/ontoksd/ontoksd#hasEducationLevel> rdf:type owl:ObjectProperty ;
                                                    rdfs:range <http://purl.org/ontoksd/ontoksd#ProficiencyLevel> ;
                                                    rdfs:comment "Associates an educational detail with a level."@en .


###  http://purl.org/ontoksd/ontoksd#hasEducationScale
<http://purl.org/ontoksd/ontoksd#hasEducationScale> rdf:type owl:ObjectProperty ;
                                                    rdfs:range <http://purl.org/ontoksd/ontoksd#Scale> ;
                                                    rdfs:comment "Specifies the scale used in educational evaluation."@en .


###  http://purl.org/ontoksd/ontoksd#hasEvidence
<http://purl.org/ontoksd/ontoksd#hasEvidence> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                              rdfs:range <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                              rdfs:comment "Indicates the evidence collected for the person."@en .


###  http://purl.org/ontoksd/ontoksd#hasEvidenceContext
<http://purl.org/ontoksd/ontoksd#hasEvidenceContext> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#Context> ;
                                                     rdfs:comment "Provides the context in which the evidence is observed."@en .


###  http://purl.org/ontoksd/ontoksd#hasEvidenceLevel
<http://purl.org/ontoksd/ontoksd#hasEvidenceLevel> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#ProficiencyLevel> ;
                                                   rdfs:comment "Specifies the assessment level attributed to the evidence."@en .


###  http://purl.org/ontoksd/ontoksd#hasEvidenceType
<http://purl.org/ontoksd/ontoksd#hasEvidenceType> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                  rdfs:range <http://purl.org/ontoksd/ontoksd#EvidenceType> ;
                                                  rdfs:comment "Defines the classification of the evidence."@en .


###  http://purl.org/ontoksd/ontoksd#hasFormativeCredit
<http://purl.org/ontoksd/ontoksd#hasFormativeCredit> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#DocumentDetail> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#FormativeCredit> ;
                                                     rdfs:comment "Specifies the credit gained from a document detail."@en .


###  http://purl.org/ontoksd/ontoksd#hasGoal
<http://purl.org/ontoksd/ontoksd#hasGoal> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://purl.org/ontoksd/ontoksd#InstructionalEntity> ;
                                          rdfs:comment "Associates a learning goal with an instructional entity."@en .


###  http://purl.org/ontoksd/ontoksd#hasKnowledge
<http://purl.org/ontoksd/ontoksd#hasKnowledge> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#hasCompetenceElement> ;
                                               owl:inverseOf <http://purl.org/ontoksd/ontoksd#isKnowledgeFor> ;
                                               rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                               rdfs:range <http://purl.org/ontoksd/ontoksd#Knowledge> .


###  http://purl.org/ontoksd/ontoksd#hasKnowledgeComponent
<http://purl.org/ontoksd/ontoksd#hasKnowledgeComponent> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <http://purl.org/ontoksd/ontoksd#KnowledgeSkill> ;
                                                        rdfs:range <http://purl.org/ontoksd/ontoksd#Knowledge> .


###  http://purl.org/ontoksd/ontoksd#hasKnowledgeSkill
<http://purl.org/ontoksd/ontoksd#hasKnowledgeSkill> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                    rdfs:range <http://purl.org/ontoksd/ontoksd#KnowledgeSkill> .


###  http://purl.org/ontoksd/ontoksd#hasKnowledgeType
<http://purl.org/ontoksd/ontoksd#hasKnowledgeType> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#Knowledge> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#KnowledgeType> ;
                                                   rdfs:comment "Relates a Knowledge to its specific knowledge type."@en .


###  http://purl.org/ontoksd/ontoksd#hasLearningNeeds
<http://purl.org/ontoksd/ontoksd#hasLearningNeeds> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#LearningNeed> ;
                                                   rdfs:comment "Lists the learning needs of a person."@en .


###  http://purl.org/ontoksd/ontoksd#hasPerformedRole
<http://purl.org/ontoksd/ontoksd#hasPerformedRole> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#RoleDetail> ;
                                                   rdfs:comment "Indicates the role detail already performed by a person."@en .


###  http://purl.org/ontoksd/ontoksd#hasPersonModelCompetence
<http://purl.org/ontoksd/ontoksd#hasPersonModelCompetence> rdf:type owl:ObjectProperty ;
                                                           rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                                           rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                           rdfs:comment "Indicates the competence detail of a person."@en .


###  http://purl.org/ontoksd/ontoksd#hasPersonality
<http://purl.org/ontoksd/ontoksd#hasPersonality> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                                 rdfs:comment "Associates a person with a personality profile."@en .


###  http://purl.org/ontoksd/ontoksd#hasPersonalitySourceType
<http://purl.org/ontoksd/ontoksd#hasPersonalitySourceType> rdf:type owl:ObjectProperty ;
                                                           rdfs:comment "Defines the source type of the personality description."@en .


###  http://purl.org/ontoksd/ontoksd#hasSkill
<http://purl.org/ontoksd/ontoksd#hasSkill> rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#hasCompetenceElement> ;
                                           owl:inverseOf <http://purl.org/ontoksd/ontoksd#isSkillFor> ;
                                           rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                           rdfs:range <http://purl.org/ontoksd/ontoksd#Skill> ;
                                           rdfs:comment "Indicates a skill that composes the competence."@en .


###  http://purl.org/ontoksd/ontoksd#hasSkillComponent
<http://purl.org/ontoksd/ontoksd#hasSkillComponent> rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                                    rdfs:domain <http://purl.org/ontoksd/ontoksd#KnowledgeSkill> ;
                                                    rdfs:range <http://purl.org/ontoksd/ontoksd#Skill> .


###  http://purl.org/ontoksd/ontoksd#hasSkillType
<http://purl.org/ontoksd/ontoksd#hasSkillType> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://purl.org/ontoksd/ontoksd#Skill> ;
                                               rdfs:range <http://purl.org/ontoksd/ontoksd#SkillType> ;
                                               rdfs:comment "Associates a Skill with its classified type."@en .


###  http://purl.org/ontoksd/ontoksd#hasStructureType
<http://purl.org/ontoksd/ontoksd#hasStructureType> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#StructureType> .


###  http://purl.org/ontoksd/ontoksd#includesCompetenceDetail
<http://purl.org/ontoksd/ontoksd#includesCompetenceDetail> rdf:type owl:ObjectProperty ;
                                                           rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                           rdfs:comment "Links a learning goal to the competence details it supports."@en .


###  http://purl.org/ontoksd/ontoksd#includesCompetenceElementDetail
<http://purl.org/ontoksd/ontoksd#includesCompetenceElementDetail> rdf:type owl:ObjectProperty ;
                                                                  rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                                  rdfs:comment "Links a learning goal to the competency details it supports."@en .


###  http://purl.org/ontoksd/ontoksd#includesInstructionalEntity
<http://purl.org/ontoksd/ontoksd#includesInstructionalEntity> rdf:type owl:ObjectProperty ;
                                                              rdfs:range <http://purl.org/ontoksd/ontoksd#InstructionalEntity> ;
                                                              rdfs:comment "Includes one or more instructional entities in a learning model."@en .


###  http://purl.org/ontoksd/ontoksd#includesResponsibility
<http://purl.org/ontoksd/ontoksd#includesResponsibility> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                                         rdfs:range <http://purl.org/ontoksd/ontoksd#Responsibility> ;
                                                         rdfs:comment "Lists responsibilities included in a role."@en .


###  http://purl.org/ontoksd/ontoksd#isAttitudeFor
<http://purl.org/ontoksd/ontoksd#isAttitudeFor> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#isDispositionFor> ;
                                                rdfs:domain <http://purl.org/ontoksd/ontoksd#Attitude> ;
                                                rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> .


###  http://purl.org/ontoksd/ontoksd#isCompetenceElementFor
<http://purl.org/ontoksd/ontoksd#isCompetenceElementFor> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://purl.org/ontoksd/ontoksd#Competency> ;
                                                         rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                         rdfs:comment "Indicates that a Competency is mandatory for a given Competence."@en .


###  http://purl.org/ontoksd/ontoksd#isComponentOf
<http://purl.org/ontoksd/ontoksd#isComponentOf> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                rdfs:comment "Competences may be an aggregation of other competences" .


###  http://purl.org/ontoksd/ontoksd#isDispositionFor
<http://purl.org/ontoksd/ontoksd#isDispositionFor> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#isCompetenceElementFor> ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#Disposition> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> .


###  http://purl.org/ontoksd/ontoksd#isHigherThanLevel
<http://purl.org/ontoksd/ontoksd#isHigherThanLevel> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://purl.org/ontoksd/ontoksd#ProficiencyLevel> ;
                                                    rdfs:range <http://purl.org/ontoksd/ontoksd#ProficiencyLevel> ;
                                                    rdfs:comment "Defines a hierarchical relationship between levels."@en .


###  http://purl.org/ontoksd/ontoksd#isKnowledgeFor
<http://purl.org/ontoksd/ontoksd#isKnowledgeFor> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#isCompetenceElementFor> ;
                                                 rdfs:domain <http://purl.org/ontoksd/ontoksd#Knowledge> ;
                                                 rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> .


###  http://purl.org/ontoksd/ontoksd#isObservedBy
<http://purl.org/ontoksd/ontoksd#isObservedBy> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                               rdfs:range <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                               rdfs:comment "Specifies the PersonModel who observed the evidence."@en .


###  http://purl.org/ontoksd/ontoksd#isSkillFor
<http://purl.org/ontoksd/ontoksd#isSkillFor> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://purl.org/ontoksd/ontoksd#isCompetenceElementFor> ;
                                             rdfs:domain <http://purl.org/ontoksd/ontoksd#Skill> ;
                                             rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> .


###  http://purl.org/ontoksd/ontoksd#needsCompetence
<http://purl.org/ontoksd/ontoksd#needsCompetence> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningNeed> ;
                                                  rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                  rdfs:comment "Defines the competence needed by a learning need."@en .


###  http://purl.org/ontoksd/ontoksd#needsCompetenceElement
<http://purl.org/ontoksd/ontoksd#needsCompetenceElement> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningNeed> ;
                                                         rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                         rdfs:comment "Defines the competency required by a learning need."@en .


###  http://purl.org/ontoksd/ontoksd#providesEvidence
<http://purl.org/ontoksd/ontoksd#providesEvidence> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#RoleDetail> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                   rdfs:comment "Specifies the evidence provided in a role detail."@en .


###  http://purl.org/ontoksd/ontoksd#providesInstructionalEntity
<http://purl.org/ontoksd/ontoksd#providesInstructionalEntity> rdf:type owl:ObjectProperty ;
                                                              rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                              rdfs:comment "Indicates the competence detail supported by an education process."@en .


###  http://purl.org/ontoksd/ontoksd#providesSelfAssessment
<http://purl.org/ontoksd/ontoksd#providesSelfAssessment> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://purl.org/ontoksd/ontoksd#PersonModel> ;
                                                         rdfs:range <http://purl.org/ontoksd/ontoksd#Evidence> ;
                                                         rdfs:comment "Links a person to a self-assessment evidence."@en .


###  http://purl.org/ontoksd/ontoksd#refersToClassification
<http://purl.org/ontoksd/ontoksd#refersToClassification> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                                         rdfs:range <http://purl.org/ontoksd/ontoksd#Classification> ;
                                                         rdfs:comment "Links the role to its classification."@en .


###  http://purl.org/ontoksd/ontoksd#refersToCompetence
<http://purl.org/ontoksd/ontoksd#refersToCompetence> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#Competence> ;
                                                     rdfs:comment "Links a detailed record to a high-level Competence."@en .


###  http://purl.org/ontoksd/ontoksd#refersToCompetenceElement
<http://purl.org/ontoksd/ontoksd#refersToCompetenceElement> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                            rdfs:range <http://purl.org/ontoksd/ontoksd#Competency> ;
                                                            rdfs:comment "Associates a Competency Detail to a Competency."@en .


###  http://purl.org/ontoksd/ontoksd#refersToDocument
<http://purl.org/ontoksd/ontoksd#refersToDocument> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/ontoksd/ontoksd#DocumentDetail> ;
                                                   rdfs:range <http://purl.org/ontoksd/ontoksd#Document> ;
                                                   rdfs:comment "Links document detail to a document."@en .


###  http://purl.org/ontoksd/ontoksd#refersToEducation
<http://purl.org/ontoksd/ontoksd#refersToEducation> rdf:type owl:ObjectProperty ;
                                                    rdfs:comment "Links education detail to a general education context."@en .


###  http://purl.org/ontoksd/ontoksd#refersToRole
<http://purl.org/ontoksd/ontoksd#refersToRole> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://purl.org/ontoksd/ontoksd#RoleDetail> ;
                                               rdfs:range <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                               rdfs:comment "Links a role detail to a specific role."@en .


###  http://purl.org/ontoksd/ontoksd#releases
<http://purl.org/ontoksd/ontoksd#releases> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://purl.org/ontoksd/ontoksd#Agency> ;
                                           rdfs:range <http://purl.org/ontoksd/ontoksd#DocumentDetail> ;
                                           rdfs:comment "Indicates the document detail issued by the agency."@en .


###  http://purl.org/ontoksd/ontoksd#requiresCompetence
<http://purl.org/ontoksd/ontoksd#requiresCompetence> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                     rdfs:comment "Specifies the required competence for a role."@en .


###  http://purl.org/ontoksd/ontoksd#requiresCompetenceElement
<http://purl.org/ontoksd/ontoksd#requiresCompetenceElement> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                                            rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                            rdfs:comment "Defines a competency needed to fulfill the role."@en .


###  http://purl.org/ontoksd/ontoksd#suggestsCompetence
<http://purl.org/ontoksd/ontoksd#suggestsCompetence> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                                     rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceDetail> ;
                                                     rdfs:comment "Suggests a competence as beneficial for the role."@en .


###  http://purl.org/ontoksd/ontoksd#suggestsCompetenceElement
<http://purl.org/ontoksd/ontoksd#suggestsCompetenceElement> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://purl.org/ontoksd/ontoksd#LearningRole> ;
                                                            rdfs:range <http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> ;
                                                            rdfs:comment "Recommends a competency as helpful for the role."@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/edu/bloom#CognitiveProcessLevel
<http://purl.org/edu/bloom#CognitiveProcessLevel> rdf:type owl:Class .


###  http://purl.org/ontoksd/Assessment
ontoksd:Assessment rdf:type owl:Class ;
                   rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#InstructionalEntity> .


###  http://purl.org/ontoksd/LearningTask
ontoksd:LearningTask rdf:type owl:Class ;
                     rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#LearningActivity> .


###  http://purl.org/ontoksd/ontoksd#AcquisitionContext
<http://purl.org/ontoksd/ontoksd#AcquisitionContext> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#Context> .


###  http://purl.org/ontoksd/ontoksd#Agency
<http://purl.org/ontoksd/ontoksd#Agency> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#AgencyType
<http://purl.org/ontoksd/ontoksd#AgencyType> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#Attitude
<http://purl.org/ontoksd/ontoksd#Attitude> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#Disposition> ;
                                           rdfs:comment "A context-specific disposition reflecting a favorable or unfavorable mental state toward an object, person, or situation."@en ;
                                           rdfs:label "Attitude"@en .


###  http://purl.org/ontoksd/ontoksd#AttitudeType
<http://purl.org/ontoksd/ontoksd#AttitudeType> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#DispositionType> .


###  http://purl.org/ontoksd/ontoksd#Certificate
<http://purl.org/ontoksd/ontoksd#Certificate> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#Document> ;
                                              owl:disjointWith <http://purl.org/ontoksd/ontoksd#Validation> ;
                                              rdfs:comment "A document confirming the successful completion of an educational or competence process."@en ;
                                              rdfs:label "Certificate"@en .


###  http://purl.org/ontoksd/ontoksd#Classification
<http://purl.org/ontoksd/ontoksd#Classification> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#Competence
<http://purl.org/ontoksd/ontoksd#Competence> rdf:type owl:Class ;
                                             rdfs:comment """The ability of an actor to do actions for a situation in an effective and efficient way; it cannot be directly measurable, but estimated from the performance (Miranda et al, 2017)

A broader construct combining multiple personal features (knowledge, skill and dispositions) that someone may have or need to do a task in a specific context and scale.

Different people may have the same competence but different context and evidences for it."""@en ;
                                             rdfs:label "Competence"@en .


###  http://purl.org/ontoksd/ontoksd#CompetenceDetail
<http://purl.org/ontoksd/ontoksd#CompetenceDetail> rdf:type owl:Class ;
                                                   rdfs:comment "A detailed representation of a competence with its context and level."@en .


###  http://purl.org/ontoksd/ontoksd#CompetenceElementDetail
<http://purl.org/ontoksd/ontoksd#CompetenceElementDetail> rdf:type owl:Class ;
                                                          rdfs:comment "Detailed specification of a competence element, including context and assessment."@en .


###  http://purl.org/ontoksd/ontoksd#CompetenceType
<http://purl.org/ontoksd/ontoksd#CompetenceType> rdf:type owl:Class ;
                                                 rdfs:comment "Categoria funcional ou pedagógica da competência (e.g., cognitive, technical, interpersonal)" .


###  http://purl.org/ontoksd/ontoksd#Competency
<http://purl.org/ontoksd/ontoksd#Competency> rdf:type owl:Class ;
                                             <http://purl.org/dc/elements/1.1/description> "Competence elements correspond to personal characteristics that constitute the underlying structure of a competence, as described by Miranda et al. (2018)."@en ;
                                             dcterms:bibliographicCitation "Cited as Competency in Miranda, S. et al. (2018). An Ontology-Based Model for Competence Management. Journal of Intelligent Manufacturing."@en ;
                                             rdfs:comment "An observable or measurable part of the competence like a skill, a piece of knowledge or an attitude. (Miranda et al, 2017)"@en ;
                                             rdfs:label "CompetenceElement"@en .


###  http://purl.org/ontoksd/ontoksd#Context
<http://purl.org/ontoksd/ontoksd#Context> rdf:type owl:Class ;
                                          rdfs:comment """The environment or situation in which a competence or a competence element is demonstrated.

Context where the person may apply her competences; the context may refer to a work area or a typical situation"""@en ;
                                          rdfs:label "Context"@en .


###  http://purl.org/ontoksd/ontoksd#Disposition
<http://purl.org/ontoksd/ontoksd#Disposition> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#Competency> ;
                                              rdfs:comment """A habitual tendency or inclination of an individual to behave or respond in a particular way, influencing how knowledge and skills are applied in context.

As disposições englobam traços socioemocionais, comportamentos e atitudes que influenciam a inclinação do indivíduo em realizar tarefas e saber quando e como fazê-lo."""@en .


###  http://purl.org/ontoksd/ontoksd#DispositionType
<http://purl.org/ontoksd/ontoksd#DispositionType> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#Document
<http://purl.org/ontoksd/ontoksd#Document> rdf:type owl:Class ;
                                           rdfs:comment "A record that may certify competences, competencies, or education."@en ;
                                           rdfs:label "Document"@en .


###  http://purl.org/ontoksd/ontoksd#DocumentDetail
<http://purl.org/ontoksd/ontoksd#DocumentDetail> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#EducationalResource
<http://purl.org/ontoksd/ontoksd#EducationalResource> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#InstructionalEntity> .


###  http://purl.org/ontoksd/ontoksd#Evidence
<http://purl.org/ontoksd/ontoksd#Evidence> rdf:type owl:Class ;
                                           rdfs:comment "Artifacts or observations that support the assessment of competencies or competences."@en ;
                                           rdfs:label "Evidence"@en .


###  http://purl.org/ontoksd/ontoksd#EvidenceType
<http://purl.org/ontoksd/ontoksd#EvidenceType> rdf:type owl:Class ;
                                               dcterms:bibliographicCitation """Depending on the way they are collected, the evidences may be of different type 

(EvidenceType): self-assessment, observation or instructional evidence. 
SelfAssessment, PeerAssessment, TeacherAssessment, ProjectArtifact, PerformanceObservation, WrittenExam, Presentation, PortfolioEvidence.

Moreover, they arise from a motivation."""@en .


###  http://purl.org/ontoksd/ontoksd#FormativeCredit
<http://purl.org/ontoksd/ontoksd#FormativeCredit> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#InstructionalEntity
<http://purl.org/ontoksd/ontoksd#InstructionalEntity> rdf:type owl:Class ;
                                                      rdfs:comment """Representa a entidade concreta (atividade, tarefa, recurso, avaliação etc.) que pode gerar evidência de competência.

Representa um componente-chave para conectar a ontologia de competências ao domínio educacional. 
Serve como ponto de articulação entre competências (estáticas e dinâmicas) e os artefatos instrucionais que suportam sua aquisição ou validação.

Definição:
Uma InstructionalEntity é qualquer objeto, atividade ou unidade educacional projetada com o propósito de ensinar, reforçar ou avaliar uma ou mais competências.

Exemplos:
Cursos, módulos, treinamentos presenciais ou online (Course, Module)
Avaliações, projetos, simuladores (Assessment, Scenario)
Recursos educacionais digitais (LearningObject, ContentItem)

Ela é uma abstração, podendo ser especializada conforme o domínio (educação formal, corporativa, informal etc.)."""@en .


###  http://purl.org/ontoksd/ontoksd#Knowledge
<http://purl.org/ontoksd/ontoksd#Knowledge> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#Competency> ;
                                            rdfs:comment """Theoretical or practical understanding of a subject, modeled as a type of Competence Element.
Representa uma instância de conhecimento necessário para uma competência."""@en ;
                                            rdfs:label "Knowledge"@en .


###  http://purl.org/ontoksd/ontoksd#KnowledgeSkill
<http://purl.org/ontoksd/ontoksd#KnowledgeSkill> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#KnowledgeType
<http://purl.org/ontoksd/ontoksd#KnowledgeType> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#LearningActivity
<http://purl.org/ontoksd/ontoksd#LearningActivity> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#InstructionalEntity> .


###  http://purl.org/ontoksd/ontoksd#LearningNeed
<http://purl.org/ontoksd/ontoksd#LearningNeed> rdf:type owl:Class ;
                                               rdfs:comment "A gap between current and desired competence levels requiring educational intervention."@en .


###  http://purl.org/ontoksd/ontoksd#LearningRole
<http://purl.org/ontoksd/ontoksd#LearningRole> rdf:type owl:Class ;
                                               rdfs:comment """A professional or organizational function that requires specific competences.

A LearningRole representa um papel desempenhado pelo aluno em uma atividade educacional ou disciplina, como \"desenvolvedor de projeto\", \"líder de grupo\", \"relator\", \"aluno pesquisador\", etc. Esses papéis estão associados a competências esperadas e são usados para contextualizar a avaliação de desempenho.

Representa o papel educacional assumido por um aluno em uma disciplina, curso ou atividade (ex: \"aluno de algoritmos\", \"líder de grupo\", \"monitor\").
Pode ser usado para definir competências requeridas e sugeridas por esse papel — útil para tarefas, disciplinas ou perfis curriculares."""@en .


###  http://purl.org/ontoksd/ontoksd#PersonModel
<http://purl.org/ontoksd/ontoksd#PersonModel> rdf:type owl:Class ;
                                              rdfs:comment """A representation of an individual's competences, learning, education, and roles.

Representa o perfil educacional do aluno: competências evidenciadas, papéis, evidências, lacunas, etc.
É a entidade central da visão educacional — é a partir dela que se derivam análises como “lacuna de competência”, “progresso”, “evidências” etc."""@en .


###  http://purl.org/ontoksd/ontoksd#ProficiencyLevel
<http://purl.org/ontoksd/ontoksd#ProficiencyLevel> rdf:type owl:Class ;
                                                   rdfs:comment """A classification indicating the depth or complexity of a Competence or Competence Element.

(Proficiency Level) is a set of levels for classifying competences in doing actions."""@en .


###  http://purl.org/ontoksd/ontoksd#RCD
<http://purl.org/ontoksd/ontoksd#RCD> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#Responsibility
<http://purl.org/ontoksd/ontoksd#Responsibility> rdf:type owl:Class ;
                                                 rdfs:comment "A duty associated with a role that may require specific competences or competencies."@en ;
                                                 rdfs:label "Responsibility"@en .


###  http://purl.org/ontoksd/ontoksd#RoleDetail
<http://purl.org/ontoksd/ontoksd#RoleDetail> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#Scale
<http://purl.org/ontoksd/ontoksd#Scale> rdf:type owl:Class ;
                                        rdfs:comment "The measurement scale used to assess competence or competency levels."@en ;
                                        rdfs:label "Scale"@en .


###  http://purl.org/ontoksd/ontoksd#Skill
<http://purl.org/ontoksd/ontoksd#Skill> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#Competency> ;
                                        rdfs:comment "A learned ability to perform tasks, considered a subtype of Competency."@en ;
                                        rdfs:label "Skill"@en .


###  http://purl.org/ontoksd/ontoksd#SkillType
<http://purl.org/ontoksd/ontoksd#SkillType> rdf:type owl:Class .


###  http://purl.org/ontoksd/ontoksd#StructureType
<http://purl.org/ontoksd/ontoksd#StructureType> rdf:type owl:Class ;
                                                rdfs:comment "Forma como a competência está estruturalmente organizada (e.g., atomic, pair-based, composite)" .


###  http://purl.org/ontoksd/ontoksd#Validation
<http://purl.org/ontoksd/ontoksd#Validation> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.org/ontoksd/ontoksd#Document> ;
                                             rdfs:comment "A type of document certifying the achievement or recognition of a competence."@en ;
                                             rdfs:label "Validation"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://purl.org/ontoksd/Exam
ontoksd:Exam rdf:type owl:NamedIndividual ,
                      <http://purl.org/ontoksd/ontoksd#EvidenceType> .


###  http://purl.org/ontoksd/Instructional
ontoksd:Instructional rdf:type owl:NamedIndividual ,
                               <http://purl.org/ontoksd/ontoksd#EvidenceType> .


###  http://purl.org/ontoksd/Observed
ontoksd:Observed rdf:type owl:NamedIndividual ,
                          <http://purl.org/ontoksd/ontoksd#EvidenceType> .


###  http://purl.org/ontoksd/Peer_Assessment
ontoksd:Peer_Assessment rdf:type owl:NamedIndividual ,
                                 <http://purl.org/ontoksd/ontoksd#EvidenceType> ;
                        rdfs:label "Peer Assessment" .


