#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Disposition
                :Knowledge
                :Skill
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :DispositionType
                :KnowledgeType
                :SkillType
              )
] .


