@prefix : <http://purl.org/ontoksd#> .
@prefix dc: <http://purl.org/dc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rcd: <http://purl.org/ontoksd/rcd#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontoksd: <http://purl.org/ontoksd#> .
@base <http://purl.org/ontoksd#> .

<http://purl.org/ontoksd#> rdf:type owl:Ontology ;
                            owl:versionIRI <http://purl.org/ontoksd#1.1.0> ;
                            owl:imports <http://purl.org/edu/bloom> ,
                                        <http://purl.org/nemo/gufo#/1.0.0> ,
                                        <http://purl.org/ontoksd/rcd> ,
                                        <http://www.w3.org/2004/02/skos/core.rdf> ;
                            rdfs:comment "Ontology for Knowledge, Skill, and Disposition representation."@en ;
                            rdfs:label "OntoKSD Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .


###  http://purl.org/ontoksd#hasSuggestedVerb
ontoksd:hasSuggestedVerb rdf:type owl:AnnotationProperty ;
                         rdfs:comment "Propriedade leve para anotar semanticamente uma KnowledgeSkill, informando verbos acidionais, mas sem alterar a estrutura ontológica." ;
                         rdfs:domain ontoksd:KnowledgeSkill .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/nemo/gufo#hasReifiedQualityValue
<http://purl.org/nemo/gufo#hasReifiedQualityValue> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#inheresIn
<http://purl.org/nemo/gufo#inheresIn> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#isComponentOf
<http://purl.org/nemo/gufo#isComponentOf> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#mediates
<http://purl.org/nemo/gufo#mediates> rdf:type owl:ObjectProperty .


###  http://purl.org/ontoksd#alignedWith
ontoksd:alignedWith rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Competence ;
                    rdfs:range ontoksd:ExternalCompetence .


###  http://purl.org/ontoksd#appliesKnowledge
ontoksd:appliesKnowledge rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Skill ;
                         rdfs:range ontoksd:Knowledge ;
                         rdfs:comment "Indicates that a Skill requires certain Knowledge."@en .


###  http://purl.org/ontoksd#contextualizesRole
ontoksd:contextualizesRole rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Profile ;
                           rdfs:range ontoksd:Learner ;
                           rdfs:comment "Specifies the role a person is applying for."@en .


###  http://purl.org/ontoksd#correspondsToLevel
ontoksd:correspondsToLevel rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:ScaleInterval ;
                           rdfs:range ontoksd:ProficiencyLevel ;
                           rdfs:comment """Relates a scale interval to the proficiency level assigned to scores that fall within that interval.

Comment

The property correspondsToLevel links a ScaleInterval to the ProficiencyLevel that it determines within a given proficiency schema. This property captures the interpretive rule by which a numeric score range is translated into a qualitative proficiency category.

For example, the interval (8.0, 10.0] may correspond to the level Advanced.

Each scale interval is typically expected to correspond to exactly one proficiency level within a given schema.""" .


###  http://purl.org/ontoksd#definesInterval
ontoksd:definesInterval rdf:type owl:ObjectProperty ;
                        owl:inverseOf ontoksd:intervalDefinedInScheme ;
                        rdfs:domain ontoksd:ProficiencyScheme ;
                        rdfs:range ontoksd:ScaleInterval ;
                        rdfs:comment """Relates a proficiency schema to an interval it uses for score classification.

Comment

The property definesInterval links a ProficiencySchema to the ScaleInterval instances that it adopts as part of its interpretive structure. This property captures the fact that intervals acquire classificatory meaning within a schema, not merely within a numeric scale.

A proficiency schema typically defines one or more intervals.""" .


###  http://purl.org/ontoksd#definesLevel
ontoksd:definesLevel rdf:type owl:ObjectProperty ;
                     owl:inverseOf ontoksd:levelDefinedInSchema ;
                     rdfs:domain ontoksd:ProficiencyScheme ;
                     rdfs:range ontoksd:ProficiencyLevel ;
                     rdfs:comment """Relates a proficiency schema to a proficiency level that forms part of its classification structure.

Comment

The property definesLevel links a ProficiencySchema to the ProficiencyLevel categories it uses to interpret score ranges. It expresses that proficiency levels are not free-floating labels, but components of a specific classification scheme.

A proficiency schema typically defines one or more proficiency levels.""" .


###  http://purl.org/ontoksd#derivedFromParticipation
ontoksd:derivedFromParticipation rdf:type owl:ObjectProperty ;
                                 rdfs:domain [ rdf:type owl:Class ;
                                               owl:unionOf ( ontoksd:EvidencedCompetence
                                                             ontoksd:EvidencedCompetenceConstituent
                                                           )
                                             ] ;
                                 rdfs:range ontoksd:AssessmentParticipation ;
                                 rdfs:comment """Relates an EvidencedCompetence or EvidencedCompetenceConstituent to the AssessmentParticipation from which that evidential record is derived.

In OntoKSD, derivedFromParticipation is used to indicate that a contextualized record of demonstrated competence or constituent-level demonstration is grounded in a specific participant-level evaluative relation. This property supports traceability between evidential records and the assessment participations from which they are interpreted.""" .


###  http://purl.org/ontoksd#evidenceBasedOn
ontoksd:evidenceBasedOn rdf:type owl:ObjectProperty ;
                        owl:inverseOf ontoksd:producesEvidence ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range ontoksd:AssessmentOccurrence ;
                        rdfs:comment "Links the evidence to the Instructional Entity it is derived from."@en .


###  http://purl.org/ontoksd#evidencesCompetence
ontoksd:evidencesCompetence rdf:type owl:ObjectProperty ;
                            owl:inverseOf ontoksd:supportedByEvidence ;
                            rdfs:domain ontoksd:Evidence ;
                            rdfs:range [ rdf:type owl:Class ;
                                         owl:unionOf ( ontoksd:EvidencedCompetence
                                                       ontoksd:EvidencedCompetenceConstituent
                                                     )
                                       ] ;
                            rdfs:comment """Relates an Evidence instance to the EvidencedCompetence or EvidencedCompetenceConstituent that it supports.

In OntoKSD, evidencesCompetence is used to indicate that a given evidence contributes to the identification or recognition of a contextualized competence-related evidential record. The property does not link evidence directly to an abstract Competence, but to the specific evidenced record supported by that evidence.""" .


###  http://purl.org/ontoksd#hasAcquisitionContext
ontoksd:hasAcquisitionContext rdf:type owl:ObjectProperty ;
                              owl:inverseOf ontoksd:isAcquisitionContextOf ;
                              rdfs:domain ontoksd:InstructionalUnit ;
                              rdfs:range ontoksd:AcquisitionContext ;
                              rdfs:comment """hasAcquisitionContext
Relates an InstructionalUnit to an AcquisitionContext in which competency development, activation, practice, or assessment is pedagogically situated.

In OntoKSD, hasAcquisitionContext is used to represent the relevant educational context associated with an instructional unit. Such context may include, for example, the learning environment, instructional setting, modality, organizational conditions, or other pedagogically significant circumstances under which the unit is carried out.

This relation supports the contextualized representation of competency-oriented instruction by making explicit that instructional units do not occur in isolation, but within meaningful acquisition conditions.""" .


###  http://purl.org/ontoksd#hasActivationConstraint
ontoksd:hasActivationConstraint rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf ontoksd:hasActivationQualifier ;
                                rdfs:domain ontoksd:CompetenceRelator ;
                                rdfs:range ontoksd:ActivationConstraint .


###  http://purl.org/ontoksd#hasActivationFunction
ontoksd:hasActivationFunction rdf:type owl:ObjectProperty ;
                              owl:inverseOf ontoksd:isActivationFunctionOf ;
                              rdfs:domain ontoksd:CompetenceRelator ;
                              rdfs:range ontoksd:ActivationFunction .


###  http://purl.org/ontoksd#hasActivationMode
ontoksd:hasActivationMode rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ontoksd:hasActivationQualifier ;
                          rdfs:domain ontoksd:CompetenceRelator ;
                          rdfs:range ontoksd:ActivationMode .


###  http://purl.org/ontoksd#hasActivationQualifier
ontoksd:hasActivationQualifier rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf owl:topObjectProperty ;
                               owl:inverseOf ontoksd:isActivationQualifierOf ;
                               rdfs:domain ontoksd:CompetenceRelator ;
                               rdfs:range ontoksd:ActivationQualifier .


###  http://purl.org/ontoksd#hasActivationRole
ontoksd:hasActivationRole rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ontoksd:hasActivationQualifier ;
                          rdfs:domain ontoksd:CompetenceRelator ;
                          rdfs:range ontoksd:ActivationRole .


###  http://purl.org/ontoksd#hasAssessmentTypeConcept
ontoksd:hasAssessmentTypeConcept rdf:type owl:ObjectProperty ;
                                 rdfs:domain ontoksd:Assessment ;
                                 rdfs:range skos:Concept ;
                                 rdfs:comment """hasAssessmentTypeConcept
Relates an Assessment to a controlled assessment-related concept used for its semantic classification.

In OntoKSD, this property is used to associate an assessment with a SKOS concept drawn from one or more controlled assessment classification schemes. Depending on the adopted classification model, such concepts may represent dimensions such as assessment agent, modality, strategy, or other relevant evaluative perspectives.

This property provides a lightweight and extensible mechanism for assessment classification without requiring all classificatory categories to be modeled as ontology classes.""" .


###  http://purl.org/ontoksd#hasAssessor
ontoksd:hasAssessor rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                    rdfs:domain ontoksd:AssessmentParticipation ;
                    rdfs:range ontoksd:Assessor ;
                    rdfs:comment """hasAssessor
Relates an AssessmentParticipation to the Assessor involved in that participant-specific evaluative relation.

In OntoKSD, hasAssessor is used when a given assessment participation includes an explicit evaluating agent responsible for reviewing, judging, grading, or validating the learner’s performance in a concrete assessment occurrence. This property is optional because not all evaluative settings require a separately modeled assessor.""" .


###  http://purl.org/ontoksd#hasAttitude
ontoksd:hasAttitude rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ontoksd:hasDisposition ;
                    owl:inverseOf ontoksd:isAttitudeOf ;
                    rdfs:domain ontoksd:Competence ;
                    rdfs:range ontoksd:Attitude .


###  http://purl.org/ontoksd#hasBloomLevel
ontoksd:hasBloomLevel rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ontoksd:hasSkillComponent ;
                      rdfs:domain ontoksd:KnowledgeSkill ;
                      rdfs:range <http://purl.org/edu/bloom#CognitiveProcessLevel> .


###  http://purl.org/ontoksd#hasBloomLevelJustificationVerb
ontoksd:hasBloomLevelJustificationVerb rdf:type owl:ObjectProperty ;
                                       rdfs:domain ontoksd:KnowledgeSkill ;
                                       rdfs:range <http://purl.org/edu/bloom#ActionVerb> .


###  http://purl.org/ontoksd#hasCS2023SkillLevel
ontoksd:hasCS2023SkillLevel rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf ontoksd:hasSkillLevel ;
                            rdfs:domain ontoksd:Skill ;
                            rdfs:range <http://purl.org/edu/cs2023#CS2023SkillLevel> .


###  http://purl.org/ontoksd#hasCognitiveLevel
ontoksd:hasCognitiveLevel rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ontoksd:hasSkillLevel ;
                          rdfs:domain ontoksd:Skill ;
                          rdfs:range <http://purl.org/edu/bloom#CognitiveProcessLevel> .


###  http://purl.org/ontoksd#hasCompetenceConstituent
ontoksd:hasCompetenceConstituent rdf:type owl:ObjectProperty ;
                                 owl:inverseOf ontoksd:isCompetenceConstituentOf ;
                                 rdfs:domain ontoksd:Competence ;
                                 rdfs:range ontoksd:CompetenceConstituent ;
                                 rdfs:comment """\"Relates a Competence to a CompetenceConstituent that forms part of its internal semantic structure.

In OntoKSD, hasCompetenceConstituent is used to represent that a competence is constituted by one or more elements such as knowledge, skills, or dispositions. This property provides a generalized relation at the constituent level, allowing more specific subproperties such as hasKnowledge, hasSkill, and hasDisposition.

Ontological rationale:
hasCompetenceConstituent is introduced to represent the compositional structure of competencies in a generalized way, while supporting more specific constituent relations through subproperties.""" .


###  http://purl.org/ontoksd#hasCompetenceRelator
ontoksd:hasCompetenceRelator rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf owl:topObjectProperty ;
                             rdfs:domain ontoksd:InstructionalUnit ;
                             rdfs:range ontoksd:CompetenceRelator ;
                             rdfs:comment """hasCompetenceRelator
Relates an InstructionalUnit to a CompetenceRelator that mediates its pedagogical association with one or more competencies.

In OntoKSD, this property is used to avoid representing instructional alignment as a simple direct link between an instructional unit and a competency. Instead, the relation is mediated by a CompetenceRelator, which can capture the specific semantic nature of that association, such as whether the competency is primarily developed, practiced, supported, mobilized, or assessed in the instructional unit.

This modeling choice improves semantic precision and supports richer descriptions of the pedagogical role that competencies play within instructional structures."""@en ;
                             rdfs:label "hasCompetenceActivation" .


###  http://purl.org/ontoksd#hasCompetenceScope
ontoksd:hasCompetenceScope rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:CompetenceScope ;
                           rdfs:comment "Specifies whether a competence is educational, profissional, or another type."@en .


###  http://purl.org/ontoksd#hasComponent
ontoksd:hasComponent rdf:type owl:ObjectProperty ;
                     owl:inverseOf ontoksd:isCompetenceOf ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Competence ;
                     rdfs:comment """Indicates a compositional relationship, where a meta-competence (composite competence) is composed of several component competencies. The meta-competence is considered fully demonstrated only if all of its components are evidenced.

Use case: Supports logical aggregation and progressive demonstration of more general abilities."""@en .


###  http://purl.org/ontoksd#hasContext
ontoksd:hasContext rdf:type owl:ObjectProperty ;
                   owl:inverseOf ontoksd:providesContextFor ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( ontoksd:Competence
                                               ontoksd:CompetenceConstituent
                                               ontoksd:Evidence
                                               ontoksd:EvidencedCompetence
                                               ontoksd:EvidencedCompetenceConstituent
                                             )
                               ] ;
                   rdfs:range ontoksd:Context ;
                   rdfs:comment """Relates a competence, competence constituent, evidence artifact, or evidenced competency element to the situational setting in which it is applicable, manifested, observed, interpreted, or evidenced.

In OntoKSD, hasContext is used to associate competence-related entities with a general Context that frames their relevance or interpretation. This context may correspond to professional, organizational, social, task-specific, or other situational conditions under which a competence or its related evidence becomes meaningful.

Unlike hasAcquisitionContext, which is restricted to pedagogically oriented settings of learning and assessment, hasContext captures the broader contextual conditions in which competencies or evidence are situated.""" .


###  http://purl.org/ontoksd#hasDisposition
ontoksd:hasDisposition rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ontoksd:hasCompetenceConstituent ;
                       owl:inverseOf ontoksd:isDispositionOf ;
                       rdfs:domain ontoksd:Competence ;
                       rdfs:range ontoksd:Disposition .


###  http://purl.org/ontoksd#hasDispositionCategory
ontoksd:hasDispositionCategory rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Disposition ;
                               rdfs:range ontoksd:DispositionCategory .


###  http://purl.org/ontoksd#hasEvidence
ontoksd:hasEvidence rdf:type owl:ObjectProperty ;
                    owl:inverseOf ontoksd:isObservedBy ;
                    rdfs:domain ontoksd:Profile ;
                    rdfs:range ontoksd:Evidence ;
                    rdfs:comment "Indicates the evidence collected for the person."@en .


###  http://purl.org/ontoksd#hasEvidenceType
ontoksd:hasEvidenceType rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range ontoksd:EvidenceType ;
                        rdfs:comment "Defines the classification of the evidence."@en .


###  http://purl.org/ontoksd#hasEvidencedCompetence
ontoksd:hasEvidencedCompetence rdf:type owl:ObjectProperty ;
                               owl:inverseOf ontoksd:isEvidencedCompetenceOf ;
                               rdfs:domain ontoksd:Profile ;
                               rdfs:range ontoksd:EvidencedCompetence ;
                               rdfs:comment """Relates a Profile to an EvidencedCompetence that forms part of its competency record.

In OntoKSD, hasEvidencedCompetence is used to indicate that a profile includes a contextualized evidential record of a competence demonstrated by the corresponding individual. This property supports the representation of competency profiles grounded in evidence.""" .


###  http://purl.org/ontoksd#hasEvidencedConstituent
ontoksd:hasEvidencedConstituent rdf:type owl:ObjectProperty ;
                                owl:inverseOf ontoksd:isEvidencedCompetenceConstituentOf ;
                                rdfs:domain ontoksd:EvidencedCompetence ;
                                rdfs:range ontoksd:EvidencedCompetenceConstituent .


###  http://purl.org/ontoksd#hasInstructionalUnit
ontoksd:hasInstructionalUnit rdf:type owl:ObjectProperty ;
                             rdfs:domain ontoksd:Course ;
                             rdfs:range ontoksd:InstructionalUnit .


###  http://purl.org/ontoksd#hasInterval
ontoksd:hasInterval rdf:type owl:ObjectProperty ;
                    owl:inverseOf ontoksd:isIntervalOf ;
                    rdfs:domain ontoksd:Scale ;
                    rdfs:range ontoksd:ScaleInterval ;
                    rdfs:comment """Definition

Relates a scale to an interval that belongs to its numeric range.

Comment

The property hasInterval links a Scale to a ScaleInterval that partitions or subdivides its numeric space. Through this relation, the ontology can represent how a scale is structurally divided into subranges used for score interpretation.

A scale may have one or more intervals.""" .


###  http://purl.org/ontoksd#hasKnowledge
ontoksd:hasKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ontoksd:hasCompetenceConstituent ;
                     owl:inverseOf ontoksd:isKnowledgeOf ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Knowledge .


###  http://purl.org/ontoksd#hasKnowledgeComponent
ontoksd:hasKnowledgeComponent rdf:type owl:ObjectProperty ;
                              rdfs:domain ontoksd:KnowledgeSkill ;
                              rdfs:range ontoksd:Knowledge ;
                              rdfs:comment "Associates a KnowledgeSkill with the knowledge component involved."@en .


###  http://purl.org/ontoksd#hasKnowledgeSkill
ontoksd:hasKnowledgeSkill rdf:type owl:ObjectProperty ;
                          owl:inverseOf ontoksd:isKnowledgeSkillOf ;
                          rdfs:domain ontoksd:Competence ;
                          rdfs:range ontoksd:KnowledgeSkill .


###  http://purl.org/ontoksd#hasKnowledgeType
ontoksd:hasKnowledgeType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Knowledge ;
                         rdfs:range ontoksd:KnowledgeType ;
                         rdfs:comment "Relates a Knowledge to its specific knowledge type."@en .


###  http://purl.org/ontoksd#hasLearner
ontoksd:hasLearner rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                   rdfs:domain ontoksd:AssessmentParticipation ;
                   rdfs:range ontoksd:Learner ;
                   rdfs:comment """hasLearner
Relates an AssessmentParticipation to the Learner whose performance is being evaluated in that participant-specific evaluative relation.

In OntoKSD, hasLearner identifies the learner involved in a given assessment participation. This property makes explicit that participant-specific evaluation is anchored in the relation between a concrete assessment occurrence and the learner whose performance, products, or results are under evaluation.""" .


###  http://purl.org/ontoksd#hasLearningNeed
ontoksd:hasLearningNeed rdf:type owl:ObjectProperty ;
                        owl:inverseOf ontoksd:identifiedIn ;
                        rdfs:domain ontoksd:Profile ;
                        rdfs:range ontoksd:LearningNeed ;
                        rdfs:comment "Lists the learning needs of a person."@en .


###  http://purl.org/ontoksd#hasPerformedRole
ontoksd:hasPerformedRole rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Profile ;
                         rdfs:range ontoksd:RoleDetail ;
                         rdfs:comment "Indicates the role detail already performed by a person."@en .


###  http://purl.org/ontoksd#hasProficiencyLevel
ontoksd:hasProficiencyLevel rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( ontoksd:EvidencedCompetence
                                                        ontoksd:EvidencedCompetenceConstituent
                                                      )
                                        ] ;
                            rdfs:range ontoksd:ProficiencyLevel .


###  http://purl.org/ontoksd#hasProfile
ontoksd:hasProfile rdf:type owl:ObjectProperty ;
                   owl:inverseOf ontoksd:isProfileOf ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain ontoksd:Learner ;
                   rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#hasRCD
ontoksd:hasRCD rdf:type owl:ObjectProperty ;
               owl:inverseOf ontoksd:representsCompetence ;
               rdfs:domain ontoksd:Competence ;
               rdfs:range rcd:RCD .


###  http://purl.org/ontoksd#hasResourceTypeConcept
ontoksd:hasResourceTypeConcept rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:EducationalResource ;
                               rdfs:range skos:Concept ;
                               rdfs:comment """hasResourceTypeConcept
Relates an entity to a controlled conceptual category represented as a SKOS concept.

In OntoKSD, hasResourceTypeConcept is used to associate domain entities with controlled classification concepts defined in SKOS concept schemes, such as resource-type or assessment-related schemes. This property supports lightweight semantic classification without requiring stronger ontological commitment at the class level.

The use of hasResourceTypeConcept allows OntoKSD to distinguish between domain entities, which are represented as ontology classes or individuals, and conceptual categories, which are represented as SKOS concepts for terminological organization, interoperability, and controlled vocabulary management.""" .


###  http://purl.org/ontoksd#hasSkill
ontoksd:hasSkill rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf ontoksd:hasCompetenceConstituent ;
                 owl:inverseOf ontoksd:isSkillOf ;
                 rdfs:domain ontoksd:Competence ;
                 rdfs:range ontoksd:Skill ;
                 rdfs:comment "Indicates a skill that composes the competence."@en .


###  http://purl.org/ontoksd#hasSkillComponent
ontoksd:hasSkillComponent rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain ontoksd:KnowledgeSkill ;
                          rdfs:range ontoksd:Skill ;
                          rdfs:comment "Associates a KnowledgeSkill with the skill component that operates on the knowledge."@en .


###  http://purl.org/ontoksd#hasSkillDimension
ontoksd:hasSkillDimension rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Skill ;
                          rdfs:range ontoksd:SkillDimension ;
                          rdfs:comment """hasSkillDimension
Relates a Skill element to a SkillDimension that classifies the primary dimension under which that skill is characterized within a competency specification.

This property is used to support the explicit semantic classification of skill elements in OntoKSD, enabling skills to be distinguished according to their predominant cognitive, technical, or interpersonal dimension.

Domain: Skill
Range: SkillDimension"""@en .


###  http://purl.org/ontoksd#hasSkillLevel
ontoksd:hasSkillLevel rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:Skill ;
                      rdfs:range <http://purl.org/edu/bloom#SkillLevel> .


###  http://purl.org/ontoksd#hasStructureType
ontoksd:hasStructureType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Competence ;
                         rdfs:range ontoksd:StructureType ;
                         rdfs:comment """This property is used to indicate whether a competence is modeled as an atomic competence or as a composite competence. 

Through hasStructureType, OntoKSD can distinguish competencies that are represented as indivisible units from those that are explicitly composed of component competencies."""@en .


###  http://purl.org/ontoksd#hasSupportDocument
ontoksd:hasSupportDocument rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Evidence ;
                           rdfs:range ontoksd:Document ;
                           rdfs:comment "Evidence can be supported by a Document"@en .


###  http://purl.org/ontoksd#identifiedIn
ontoksd:identifiedIn rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:LearningNeed ;
                     rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#intervalDefinedInScheme
ontoksd:intervalDefinedInScheme rdf:type owl:ObjectProperty ;
                                rdfs:domain ontoksd:ScaleInterval ;
                                rdfs:range ontoksd:ProficiencyScheme ;
                                rdfs:comment """Relates a scale interval to the proficiency schema in which it is defined.

Comment

The property intervalDefinedInSchema is the inverse of definesInterval. It indicates that a ScaleInterval participates in the classification structure of a particular ProficiencySchema.

This property is useful when the same numeric scale may be interpreted by different schemas.""" .


###  http://purl.org/ontoksd#involvesAssessmentParticipation
ontoksd:involvesAssessmentParticipation rdf:type owl:ObjectProperty ;
                                        owl:inverseOf ontoksd:occursInAssessmentOccurrence ;
                                        rdfs:domain ontoksd:AssessmentOccurrence ;
                                        rdfs:range ontoksd:AssessmentParticipation ;
                                        rdfs:comment """involvesAssessmentParticipation
Relates an AssessmentOccurrence to an AssessmentParticipation established within that concrete evaluative event.

In OntoKSD, this property is used to indicate that a given assessment occurrence includes one or more participant-specific evaluative relations. It links the collective evaluative event to the individualized participations through which learners and, where applicable, assessors are connected to that occurrence.""" .


###  http://purl.org/ontoksd#isAcquisitionContextOf
ontoksd:isAcquisitionContextOf rdf:type owl:ObjectProperty ;
                               owl:inverseOf ontoksd:occursInAcquisitionContext ;
                               rdfs:domain ontoksd:AcquisitionContext ;
                               rdfs:range ontoksd:InstructionalUnit .


###  http://purl.org/ontoksd#isActivationFunctionOf
ontoksd:isActivationFunctionOf rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                               rdfs:domain ontoksd:ActivationFunction ;
                               rdfs:range ontoksd:CompetenceRelator .


###  http://purl.org/ontoksd#isActivationQualifierOf
ontoksd:isActivationQualifierOf rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                                rdfs:domain ontoksd:ActivationQualifier ;
                                rdfs:range ontoksd:CompetenceRelator .


###  http://purl.org/ontoksd#isAttitudeOf
ontoksd:isAttitudeOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ontoksd:isDispositionOf ;
                     rdfs:domain ontoksd:Attitude ;
                     rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isBasedOnActivity
ontoksd:isBasedOnActivity rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain ontoksd:Assessment ;
                          rdfs:range ontoksd:LearningActivity ;
                          rdfs:comment """isBasedOnActivity
Relates an Assessment to a LearningActivity on which its evaluative design is pedagogically based.

In OntoKSD, isBasedOnActivity indicates that an assessment is grounded in, derived from, or structured around a learning activity whose performance, products, or engagement may serve as the basis for evaluative judgment. The relation does not imply that the learning activity and the assessment are identical, but rather that the activity provides a relevant pedagogical basis for the assessment.""" .


###  http://purl.org/ontoksd#isCompetenceConstituentOf
ontoksd:isCompetenceConstituentOf rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                                  rdfs:domain ontoksd:CompetenceConstituent ;
                                  rdfs:range ontoksd:Competence ;
                                  rdfs:comment """Relates a CompetenceConstituent to the Competence of which it forms part.

In OntoKSD, isCompetenceConstituentOf is the inverse of hasCompetenceConstituent and expresses that a knowledge element, skill, or disposition participates in the semantic constitution of a competence.

This property makes explicit the role of the constituent as part of a broader competency specification.""" .


###  http://purl.org/ontoksd#isCompetenceOf
ontoksd:isCompetenceOf rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                       rdfs:domain ontoksd:Competence ;
                       rdfs:range ontoksd:Competence ;
                       rdfs:comment "Competences may be an aggregation of other competences" .


###  http://purl.org/ontoksd#isConstituentEvidencedBy
ontoksd:isConstituentEvidencedBy rdf:type owl:ObjectProperty ;
                                 owl:inverseOf ontoksd:refersToCompetenceConstituent ;
                                 rdfs:domain ontoksd:CompetenceConstituent ;
                                 rdfs:range ontoksd:EvidencedCompetenceConstituent .


###  http://purl.org/ontoksd#isDispositionOf
ontoksd:isDispositionOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf ontoksd:isCompetenceConstituentOf ;
                        rdfs:domain ontoksd:Disposition ;
                        rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isEvidencedBy
ontoksd:isEvidencedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf ontoksd:refersToCompetence ;
                      rdfs:domain ontoksd:Competence ;
                      rdfs:range ontoksd:EvidencedCompetence .


###  http://purl.org/ontoksd#isEvidencedCompetenceConstituentOf
ontoksd:isEvidencedCompetenceConstituentOf rdf:type owl:ObjectProperty ;
                                           rdfs:domain ontoksd:EvidencedCompetenceConstituent ;
                                           rdfs:range ontoksd:EvidencedCompetence .


###  http://purl.org/ontoksd#isEvidencedCompetenceOf
ontoksd:isEvidencedCompetenceOf rdf:type owl:ObjectProperty ;
                                rdfs:domain ontoksd:EvidencedCompetence ;
                                rdfs:range ontoksd:Profile ;
                                rdfs:comment """Relates an EvidencedCompetence to the Profile of which it forms part.

In OntoKSD, isEvidencedCompetenceOf is the inverse of hasEvidencedCompetence and expresses that a demonstrated competence record belongs to a particular profile.""" .


###  http://purl.org/ontoksd#isIntervalOf
ontoksd:isIntervalOf rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:ScaleInterval ;
                     rdfs:range ontoksd:Scale ;
                     rdfs:comment """The property isIntervalOf is the inverse of hasInterval. It indicates that a given ScaleInterval is defined within the numeric range of a specific Scale.

Each scale interval should belong to exactly one scale.""" .


###  http://purl.org/ontoksd#isKnowledgeOf
ontoksd:isKnowledgeOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ontoksd:isCompetenceConstituentOf ;
                      rdfs:domain ontoksd:Knowledge ;
                      rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isKnowledgeSkillOf
ontoksd:isKnowledgeSkillOf rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                           rdfs:domain ontoksd:KnowledgeSkill ;
                           rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isObservedBy
ontoksd:isObservedBy rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:Evidence ;
                     rdfs:range ontoksd:Profile ;
                     rdfs:comment "Specifies the Profile who observed the evidence."@en .


###  http://purl.org/ontoksd#isProfileOf
ontoksd:isProfileOf rdf:type owl:ObjectProperty ,
                             owl:InverseFunctionalProperty ;
                    rdfs:domain ontoksd:Profile ;
                    rdfs:range ontoksd:Learner .


###  http://purl.org/ontoksd#isRealizedBy
ontoksd:isRealizedBy rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     owl:inverseOf ontoksd:realizes ;
                     rdfs:domain ontoksd:Assessment ;
                     rdfs:range ontoksd:AssessmentOccurrence ;
                     rdfs:comment """isRealizedBy
Relates an Assessment to an AssessmentOccurrence through which that evaluative unit is concretely carried out.

In OntoKSD, isRealizedBy is the inverse of realizes and expresses that an assessment, understood as a pedagogically specified evaluative unit, may have one or more concrete occurrences in practice.

This property supports the distinction between evaluative design and evaluative execution while preserving their formal connection.""" .


###  http://purl.org/ontoksd#isSkillOf
ontoksd:isSkillOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ontoksd:isCompetenceConstituentOf ;
                  rdfs:domain ontoksd:Skill ;
                  rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isSpecializationOf
ontoksd:isSpecializationOf rdf:type owl:ObjectProperty ;
                           owl:inverseOf ontoksd:specializes ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#levelDefinedInSchema
ontoksd:levelDefinedInSchema rdf:type owl:ObjectProperty ;
                             rdfs:domain ontoksd:ProficiencyLevel ;
                             rdfs:range ontoksd:ProficiencyScheme .


###  http://purl.org/ontoksd#mediatesCompetence
ontoksd:mediatesCompetence rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                           rdf:type owl:FunctionalProperty ;
                           rdfs:domain ontoksd:CompetenceRelator ;
                           rdfs:range ontoksd:Competence ;
                           rdfs:comment """A relation between an InstructionalEntity and a Competence indicating that the competence is a prerequisite for meaningful engagement or successful completion of the instructional activity.
This property specifies that certain competences must already be possessed or evidenced before participation in the InstructionalEntity.

Intended semantics: If an InstructionalEntity requires a competence, learners without that competence may struggle to engage fully with the activity or achieve its intended outcomes.

Examples:

An “Advanced Machine Learning” course requiring competence in “Linear Algebra” and “Programming in Python”.

A “Capstone Project” requiring “Research Methodology” competence.

A “Professional Ethics Seminar” requiring “Critical Reading and Writing” competence.

Ontological notes:

requiresCompetence enables curriculum sequencing and prerequisite mapping in both formal and informal learning contexts.

This property supports curriculum traceability by clarifying the dependency structure between competences.""" .


###  http://purl.org/ontoksd#mediatesCourse
ontoksd:mediatesCourse rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain ontoksd:CourseCompetenceSpecification ;
                       rdfs:range ontoksd:Course ;
                       rdfs:comment """mediatesCourse
Relates a CourseCompetenceSpecification to the Course whose curricular scope it qualifies with respect to a given competence.

In OntoKSD, mediatesCourse is used to indicate that a CourseCompetenceSpecification semantically involves a particular course as one of the relata of the curricular specification. Through this relation, the ontology makes explicit that the specification is not an abstract statement about competence alone, but a qualified curricular association anchored in a specific Course.

This property should be interpreted together with mediatesCourseCompetence, since both relations jointly identify the two poles connected by the same curricular specification.

Ontological rationale:
mediatesCourse is modeled as a mediation relation because CourseCompetenceSpecification reifies the qualified association between a course and a competence. The property makes explicit the participation of the course in that relator, rather than reducing the association to a direct unqualified link.""" .


###  http://purl.org/ontoksd#mediatesCourseCompetence
ontoksd:mediatesCourseCompetence rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                                 rdf:type owl:FunctionalProperty ;
                                 rdfs:domain ontoksd:CourseCompetenceSpecification ;
                                 rdfs:range ontoksd:Competence ;
                                 rdfs:comment """mediatesCourseCompetence
Relates a CourseCompetenceSpecification to the Competence that is curricularly specified in association with a given Course.

In OntoKSD, mediatesCourseCompetence is used to indicate that a CourseCompetenceSpecification semantically involves a particular competence as one of the relata of the curricular specification. Through this relation, the ontology makes explicit which competence is included, expected, or required within the curricular scope of the course.

This property should be interpreted together with mediatesCourse, since both relations jointly represent the qualified association reified by the same CourseCompetenceSpecification.

Ontological rationale:
mediatesCourseCompetence is modeled as a mediation relation because the association between a course and a competence is treated in OntoKSD as a semantically qualified curricular specification. The property identifies the competence involved in that relator while preserving the possibility of attaching additional constraints and qualifications to the association.""" .


###  http://purl.org/ontoksd#mediatesInstructionalUnit
ontoksd:mediatesInstructionalUnit rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                                  rdf:type owl:FunctionalProperty ;
                                  rdfs:domain ontoksd:CompetenceRelator ;
                                  rdfs:range ontoksd:InstructionalUnit .


###  http://purl.org/ontoksd#occursInAcquisitionContext
ontoksd:occursInAcquisitionContext rdf:type owl:ObjectProperty ;
                                   rdfs:domain ontoksd:AssessmentOccurrence ;
                                   rdfs:range ontoksd:AcquisitionContext ;
                                   rdfs:comment """occursInAcquisitionContext
Relates an AssessmentOccurrence to the AcquisitionContext in which that concrete evaluative event takes place.

In OntoKSD, occursInAcquisitionContext is used to situate an assessment occurrence within the pedagogically relevant setting that frames its realization. This includes the instructional, environmental, organizational, and situational conditions under which the assessment is carried out and within which evidence may be produced and interpreted.

This property makes explicit that an assessment occurrence is not context-free, but embedded in a concrete educational or training situation.""" .


###  http://purl.org/ontoksd#occursInAssessmentOccurrence
ontoksd:occursInAssessmentOccurrence rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                                     rdfs:domain ontoksd:AssessmentParticipation ;
                                     rdfs:range ontoksd:AssessmentOccurrence ;
                                     rdfs:comment """occursInAssessmentOccurrence
Relates an AssessmentParticipation to the AssessmentOccurrence in which that participant-specific evaluative relation is established.

In OntoKSD, occursInAssessmentOccurrence is used to situate an assessment participation within the concrete evaluative event that grounds it. This property makes explicit that the identity of an AssessmentParticipation depends on the occurrence in which it is established.""" .


###  http://purl.org/ontoksd#participatesIn
ontoksd:participatesIn rdf:type owl:ObjectProperty ;
                       rdfs:domain ontoksd:Learner ;
                       rdfs:range ontoksd:AssessmentParticipation .


###  http://purl.org/ontoksd#producesEvidence
ontoksd:producesEvidence rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:AssessmentOccurrence ;
                         rdfs:range ontoksd:Evidence ;
                         rdfs:comment """Relates an AssessmentOccurrence to the Evidence produced in the context of that concrete evaluative event.

In OntoKSD, producesEvidence represents that evidence relevant to competency judgment emerges from the realization of an assessment occurrence. Such evidence may be individual or collective, depending on the evaluative setting, but it remains grounded in the occurrence as the concrete event in which the evaluative process takes place.

This property reinforces the distinction between the abstract specification of an assessment and the concrete production of evaluative evidence in practice, linking evaluative outcomes to their corresponding occurrences.""" .


###  http://purl.org/ontoksd#proficiencyLevelOf
ontoksd:proficiencyLevelOf rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:ProficiencyLevel ;
                           rdfs:range [ rdf:type owl:Class ;
                                        owl:unionOf ( ontoksd:EvidencedCompetence
                                                      ontoksd:EvidencedCompetenceConstituent
                                                    )
                                      ] ;
                           rdfs:comment """Relates a ProficiencyLevel to the EvidencedCompetence or EvidencedCompetenceConstituent to which that level is attributed.

In OntoKSD, proficiencyLevelOf is used to represent that a contextualized evidential record has been interpreted or classified according to a proficiency level. This property supports the attribution of proficiency to demonstrated competence records rather than to abstract competency specifications.""" .


###  http://purl.org/ontoksd#providesContextFor
ontoksd:providesContextFor rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Context ;
                           rdfs:range [ rdf:type owl:Class ;
                                        owl:unionOf ( ontoksd:Competence
                                                      ontoksd:CompetenceConstituent
                                                      ontoksd:Evidence
                                                      ontoksd:EvidencedCompetence
                                                      ontoksd:EvidencedCompetenceConstituent
                                                    )
                                      ] .


###  http://purl.org/ontoksd#providesEvidence
ontoksd:providesEvidence rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:RoleDetail ;
                         rdfs:range ontoksd:Evidence ;
                         rdfs:comment "Specifies the evidence provided in a role detail."@en .


###  http://purl.org/ontoksd#providesSelfAssessment
ontoksd:providesSelfAssessment rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Profile ;
                               rdfs:range ontoksd:Evidence ;
                               rdfs:comment "Links a person to a self-assessment evidence."@en .


###  http://purl.org/ontoksd#realizes
ontoksd:realizes rdf:type owl:ObjectProperty ;
                 rdfs:domain ontoksd:AssessmentOccurrence ;
                 rdfs:range ontoksd:Assessment ;
                 rdfs:comment """realizes
Relates an AssessmentOccurrence to the Assessment whose evaluative specification it concretely performs.

In OntoKSD, realizes is used to indicate that a concrete evaluative event is the eventive realization of a previously defined assessment. The property links the level of pedagogical specification to the level of actual evaluative execution.

This relation makes explicit that an assessment occurrence is not an isolated event, but the concrete realization of a defined evaluative unit.""" .


###  http://purl.org/ontoksd#referencesEvidencedCompetence
ontoksd:referencesEvidencedCompetence rdf:type owl:ObjectProperty ;
                                      rdfs:domain ontoksd:Document ;
                                      rdfs:range ontoksd:EvidencedCompetence ;
                                      rdfs:comment "Indicates the competence detail supported by the document."@en .


###  http://purl.org/ontoksd#referencesEvidencedCompetenceConstituent
ontoksd:referencesEvidencedCompetenceConstituent rdf:type owl:ObjectProperty ;
                                                 rdfs:domain ontoksd:Document ;
                                                 rdfs:range ontoksd:EvidencedCompetenceConstituent ;
                                                 rdfs:comment "Indicates the competency detail supported by the document."@en .


###  http://purl.org/ontoksd#refersToCompetence
ontoksd:refersToCompetence rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:EvidencedCompetence ;
                           rdfs:range ontoksd:Competence ;
                           rdfs:comment """Relates an EvidencedCompetence to the Competence that it evidentially refers to.

In OntoKSD, refersToCompetence is used to indicate which abstract competency specification is being evidenced by a given EvidencedCompetence. This property links the contextualized evidential record to its corresponding conceptual reference competence.

Ontological rationale:
This property is essential for maintaining the distinction between competency specification and competency evidence while preserving their formal connection.""" .


###  http://purl.org/ontoksd#refersToCompetenceConstituent
ontoksd:refersToCompetenceConstituent rdf:type owl:ObjectProperty ;
                                      rdfs:domain ontoksd:EvidencedCompetenceConstituent ;
                                      rdfs:range ontoksd:CompetenceConstituent ;
                                      rdfs:comment """Relates an EvidencedCompetenceConstituent to the CompetenceConstituent that it evidentially refers to.

In OntoKSD, refersToCompetenceConstituent is used to indicate which abstract constituent element—such as a knowledge, skill, or disposition—is being evidenced by a given EvidencedCompetenceConstituent. This property links the contextualized constituent-level evidential record to its corresponding specification element.""" .


###  http://purl.org/ontoksd#refersToRole
ontoksd:refersToRole rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:RoleDetail ;
                     rdfs:range ontoksd:Learner ;
                     rdfs:comment "Links a role detail to a specific role."@en .


###  http://purl.org/ontoksd#representsCompetence
ontoksd:representsCompetence rdf:type owl:ObjectProperty ;
                             rdfs:domain rcd:RCD ;
                             rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#representsKnowledgeArea
ontoksd:representsKnowledgeArea rdf:type owl:ObjectProperty ;
                                rdfs:domain ontoksd:Knowledge ;
                                rdfs:range skos:Concept .


###  http://purl.org/ontoksd#requires
ontoksd:requires rdf:type owl:ObjectProperty ;
                 rdfs:domain ontoksd:Competence ;
                 rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#requiresEvidencedCompetenceConstituent
ontoksd:requiresEvidencedCompetenceConstituent rdf:type owl:ObjectProperty ;
                                               rdfs:domain ontoksd:Learner ;
                                               rdfs:range ontoksd:EvidencedCompetenceConstituent ;
                                               rdfs:comment "Defines a competency needed to fulfill the role."@en .


###  http://purl.org/ontoksd#requiresMinimumProficiencyLevel
ontoksd:requiresMinimumProficiencyLevel rdf:type owl:ObjectProperty ;
                                        rdfs:domain ontoksd:CourseCompetenceSpecification ;
                                        rdfs:range ontoksd:ProficiencyLevel ;
                                        rdfs:comment """requiresMinimumProficiencyLevel
Relates a CourseCompetenceSpecification to the minimum proficiency level required for a competence to be considered meaningfully contemplated within the curricular scope of a Course.

In OntoKSD, this property is used to qualify the curricular association between a course and a competence by specifying the minimum proficiency level that the course is expected to address with respect to that competence. It does not represent an individual student's achievement, a grading threshold, or a criterion for course approval. Instead, it expresses the minimum level at which the competence should be developed, supported, or addressed so that it can be considered effectively covered by the course specification.

This property is particularly useful for distinguishing cases in which a competence is only superficially mentioned from cases in which the course is expected to support its development to a defined level of proficiency.

Ontological rationale:
requiresMinimumProficiencyLevel is introduced to make explicit that curricular inclusion of a competence may vary in depth and expected mastery. By associating a course–competence specification with a minimum proficiency level, OntoKSD can represent curricular expectations more precisely than would be possible through a simple binary association alone.""" .


###  http://purl.org/ontoksd#specializes
ontoksd:specializes rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Competence ;
                    rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#suggestsEvidencedCompetenceConstituent
ontoksd:suggestsEvidencedCompetenceConstituent rdf:type owl:ObjectProperty ;
                                               rdfs:domain ontoksd:Learner ;
                                               rdfs:range ontoksd:EvidencedCompetenceConstituent ;
                                               rdfs:comment "Recommends a competency as helpful for the role."@en .


###  http://purl.org/ontoksd#suggestsRoleCompetence
ontoksd:suggestsRoleCompetence rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Learner ;
                               rdfs:range ontoksd:EvidencedCompetence ;
                               rdfs:comment "Suggests a competence as beneficial for the role."@en .


###  http://purl.org/ontoksd#supportedByEvidence
ontoksd:supportedByEvidence rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( ontoksd:EvidencedCompetence
                                                        ontoksd:EvidencedCompetenceConstituent
                                                      )
                                        ] ;
                            rdfs:range ontoksd:Evidence ;
                            rdfs:comment """Relates an EvidencedCompetence or EvidencedCompetenceConstituent to the Evidence that supports its identification or recognition.

In OntoKSD, supportedByEvidence is used to indicate that a contextualized evidential record is grounded in one or more concrete pieces of evidence. This property links the interpreted evidential record to the artefacts, observations, or records that support it.""" .


###  http://purl.org/ontoksd#targetsCompetence
ontoksd:targetsCompetence rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:LearningNeed ;
                          rdfs:range ontoksd:Competence ;
                          rdfs:comment "Defines the competence needed by a learning need."@en .


###  http://purl.org/ontoksd#targetsCompetenceConstituent
ontoksd:targetsCompetenceConstituent rdf:type owl:ObjectProperty ;
                                     rdfs:domain ontoksd:LearningNeed ;
                                     rdfs:range ontoksd:CompetenceConstituent ;
                                     rdfs:comment "Defines the competency required by a learning need."@en .


###  http://purl.org/ontoksd#usedAsTypeOfKnowledge
ontoksd:usedAsTypeOfKnowledge rdf:type owl:ObjectProperty ;
                              rdfs:domain skos:Concept ;
                              rdfs:range ontoksd:KnowledgeType .


###  http://purl.org/ontoksd#usesProficiencyScheme
ontoksd:usesProficiencyScheme rdf:type owl:ObjectProperty ;
                              rdfs:domain ontoksd:AssessmentOccurrence ;
                              rdfs:range ontoksd:ProficiencyScheme .


###  http://purl.org/ontoksd#usesResource
ontoksd:usesResource rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:InstructionalUnit ;
                     rdfs:range ontoksd:EducationalResource ;
                     rdfs:comment """usesResource
Relates an InstructionalUnit to an EducationalResource that is used to support, mediate, document, or facilitate its pedagogical realization.

In OntoKSD, usesResource expresses that a given instructional unit makes pedagogical use of a resource such as a textbook, slide deck, video, worksheet, rubric, dataset, simulator, source code example, or other relevant educational artefact. The relation does not imply that the resource constitutes the instructional unit itself, but rather that it functions as supporting material within that unit.

This property helps preserve the distinction between instructional units, which are bounded pedagogical structures, and educational resources, which are artefacts employed within those structures.""" .


###  http://purl.org/ontoksd#usesScale
ontoksd:usesScale rdf:type owl:ObjectProperty ;
                  rdfs:domain ontoksd:ProficiencyScheme ;
                  rdfs:range ontoksd:Scale ;
                  rdfs:comment """Definition

Relates a proficiency schema to the scale whose numeric range it interprets.

Comment

The property usesScale links a ProficiencySchema to the Scale on which its score classification is based. This property expresses that the schema does not define numeric measurement independently, but instead interprets scores expressed within a pre-established scale.

Each proficiency schema is expected to use exactly one scale.""" .


###  http://purl.org/ontoksd#wasEvidencedIn
ontoksd:wasEvidencedIn rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( ontoksd:EvidencedCompetence
                                                   ontoksd:EvidencedCompetenceConstituent
                                                 )
                                   ] ;
                       rdfs:range ontoksd:AssessmentOccurrence .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/edu/bloom#hasComplexityLevel
<http://purl.org/edu/bloom#hasComplexityLevel> rdf:type owl:DatatypeProperty ;
                                               rdfs:range xsd:integer .


###  http://purl.org/nemo/gufo#hasQualityValue
<http://purl.org/nemo/gufo#hasQualityValue> rdf:type owl:DatatypeProperty .


###  http://purl.org/ontoksd#evidencedAt
ontoksd:evidencedAt rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( ontoksd:EvidencedCompetence
                                                ontoksd:EvidencedCompetenceConstituent
                                              )
                                ] ;
                    rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#generatedAt
ontoksd:generatedAt rdf:type owl:DatatypeProperty ;
                    rdfs:domain ontoksd:Evidence ;
                    rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#hasBeginning
ontoksd:hasBeginning rdf:type owl:DatatypeProperty ;
                     rdfs:domain ontoksd:RoleDetail ;
                     rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#hasEnd
ontoksd:hasEnd rdf:type owl:DatatypeProperty ;
               rdfs:domain ontoksd:RoleDetail ;
               rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#hasOrdinalPosition
ontoksd:hasOrdinalPosition rdf:type owl:DatatypeProperty ;
                           rdfs:domain ontoksd:ProficiencyLevel ;
                           rdfs:range xsd:int .


###  http://purl.org/ontoksd#hasScore
ontoksd:hasScore rdf:type owl:DatatypeProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( ontoksd:AssessmentOccurrence
                                             ontoksd:AssessmentParticipation
                                           )
                             ] ;
                 rdfs:range xsd:double .


###  http://purl.org/ontoksd#hasSyllabusText
ontoksd:hasSyllabusText rdf:type owl:DatatypeProperty ;
                        rdfs:domain ontoksd:Course ;
                        rdfs:range xsd:string .


###  http://purl.org/ontoksd#includesLower
ontoksd:includesLower rdf:type owl:DatatypeProperty ;
                      rdfs:domain ontoksd:ScaleInterval ;
                      rdfs:range xsd:boolean .


###  http://purl.org/ontoksd#includesUpper
ontoksd:includesUpper rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain ontoksd:ScaleInterval ;
                      rdfs:range xsd:boolean .


###  http://purl.org/ontoksd#intendedUse
ontoksd:intendedUse rdf:type owl:DatatypeProperty ;
                    rdfs:domain ontoksd:EducationalResource ;
                    rdfs:range xsd:string .


###  http://purl.org/ontoksd#isMandatory
ontoksd:isMandatory rdf:type owl:DatatypeProperty ;
                    rdfs:domain ontoksd:CourseCompetenceSpecification ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment """isMandatory
Indicates whether the competence associated with a CourseCompetenceSpecification is mandatory within the curricular scope of the Course.

In OntoKSD, isMandatory is used to qualify the curricular status of a competence in relation to a course. When true, it indicates that the competence is considered an essential or required component of the course specification. When false, it indicates that the competence may be associated with the course in a complementary, optional, supportive, or non-central way.

This property does not refer to whether a specific learner must individually demonstrate the competence for approval. Instead, it characterizes the role of the competence within the curricular design of the course itself.

Ontological rationale:
isMandatory is modeled as a qualification of CourseCompetenceSpecification because obligatoriness is not an intrinsic property of either the course or the competence taken separately. Rather, it emerges from the specific curricular relation established between them.""" .


###  http://purl.org/ontoksd#isTeamBased
ontoksd:isTeamBased rdf:type owl:DatatypeProperty ;
                    rdfs:domain ontoksd:LearningActivity ;
                    rdfs:range xsd:boolean .


###  http://purl.org/ontoksd#lowerBound
ontoksd:lowerBound rdf:type owl:DatatypeProperty ;
                   rdfs:domain ontoksd:ScaleInterval ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment """Definition

Specifies the lower numeric bound of a scale interval.

Comment

The property lowerBound identifies the minimum boundary value of a ScaleInterval. Together with upperBound, it defines the numeric range covered by the interval.

For example, in the interval (3.0, 6.0], the lower bound is 3.0.""" .


###  http://purl.org/ontoksd#maxScore
ontoksd:maxScore rdf:type owl:DatatypeProperty ;
                 rdfs:domain ontoksd:Assessment ;
                 rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#maxValue
ontoksd:maxValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain ontoksd:Scale ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment """Specifies the maximum numeric value of a scale.

Comment

The property maxValue indicates the upper bound of the numeric range defined by a Scale. It establishes the maximum valid score that may be expressed within that scale.

For example, a scale from 0 to 10 has maximum value 10.0.""" .


###  http://purl.org/ontoksd#minValue
ontoksd:minValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain ontoksd:Scale ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment """Specifies the minimum numeric value of a scale.

Comment

The property minValue indicates the lower bound of the numeric range defined by a Scale. It establishes the minimum valid score that may be expressed within that scale.

For example, a scale from 0 to 10 has minimum value 0.0""" .


###  http://purl.org/ontoksd#numericValue
ontoksd:numericValue rdf:type owl:DatatypeProperty ;
                     rdfs:range xsd:double .


###  http://purl.org/ontoksd#passingScore
ontoksd:passingScore rdf:type owl:DatatypeProperty ;
                     rdfs:domain ontoksd:Assessment ;
                     rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#step
ontoksd:step rdf:type owl:DatatypeProperty ;
             rdfs:domain ontoksd:Scale ;
             rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#upperBound
ontoksd:upperBound rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain ontoksd:ScaleInterval ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment """Definition

Specifies the upper numeric bound of a scale interval.

Comment

The property upperBound identifies the maximum boundary value of a ScaleInterval. Together with lowerBound, it defines the numeric range covered by the interval.

For example, in the interval (3.0, 6.0], the upper bound is 6.0.""" .


###  http://purl.org/ontoksd#validUntil
ontoksd:validUntil rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( ontoksd:EvidencedCompetence
                                               ontoksd:EvidencedCompetenceConstituent
                                             )
                               ] ;
                   rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#validatedAt
ontoksd:validatedAt rdf:type owl:DatatypeProperty ;
                    rdfs:domain ontoksd:Evidence ;
                    rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#weight
ontoksd:weight rdf:type owl:DatatypeProperty ;
               rdfs:domain ontoksd:Assessment ;
               rdfs:range xsd:decimal .


#################################################################
