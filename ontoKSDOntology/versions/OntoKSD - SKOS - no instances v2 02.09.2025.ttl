@prefix : <http://purl.org/ontoksd#> .
@prefix dc: <http://purl.org/dc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rcd: <http://purl.org/ontoksd/rcd#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontoksd: <http://purl.org/ontoksd#> .
@base <http://purl.org/ontoksd#> .

<http://purl.org/ontoksd#> rdf:type owl:Ontology ;
                            owl:versionIRI <http://purl.org/ontoksd#1.1.0> ;
                            owl:imports <http://purl.org/nemo/gufo#/1.0.0> ,
                                        <http://purl.org/ontoksd/rcd> ,
                                        <http://www.w3.org/2004/02/skos/core.rdf> ;
                            rdfs:comment "Ontology for Knowledge, Skill, and Disposition representation."@en ;
                            rdfs:label "OntoKSD Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .


###  http://purl.org/ontoksd#hasSuggestedVerb
ontoksd:hasSuggestedVerb rdf:type owl:AnnotationProperty ;
                         rdfs:comment "Propriedade leve para anotar semanticamente uma KnowledgeSkill, informando verbos acidionais, mas sem alterar a estrutura ontológica." ;
                         rdfs:domain ontoksd:KnowledgeSkill .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/nemo/gufo#mediates
<http://purl.org/nemo/gufo#mediates> rdf:type owl:ObjectProperty .


###  http://purl.org/ontoksd#acquiredIn
ontoksd:acquiredIn rdf:type owl:ObjectProperty ;
                   rdfs:comment "Indicates where a learning goal was acquired."@en .


###  http://purl.org/ontoksd#alignsWithPerformanceClass
ontoksd:alignsWithPerformanceClass rdf:type owl:ObjectProperty ;
                                   rdfs:domain ontoksd:ProficiencyValue ;
                                   rdfs:range skos:Concept .


###  http://purl.org/ontoksd#aplliesTo
ontoksd:aplliesTo rdf:type owl:ObjectProperty ;
                  rdfs:domain ontoksd:Profile ;
                  rdfs:range ontoksd:LearningRole ;
                  rdfs:comment "Specifies the role a person is applying for."@en .


###  http://purl.org/ontoksd#appliesKnowledge
ontoksd:appliesKnowledge rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Skill ;
                         rdfs:range ontoksd:Knowledge ;
                         rdfs:comment "Indicates that a Skill requires certain Knowledge."@en .


###  http://purl.org/ontoksd#assessesCompetenceElement
ontoksd:assessesCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:Evidence ;
                                  rdfs:range ontoksd:CompetenceElement .


###  http://purl.org/ontoksd#determinesPerformanceClass
ontoksd:determinesPerformanceClass rdf:type owl:ObjectProperty ;
                                   rdfs:domain ontoksd:ProficiencyLevel ;
                                   rdfs:range skos:Concept ;
                                   rdfs:comment "Maps a ProficiencyLevel to a performance class concept within the collection of its Scale.\""@en .


###  http://purl.org/ontoksd#evidenceBasedOn
ontoksd:evidenceBasedOn rdf:type owl:ObjectProperty ;
                        owl:inverseOf ontoksd:producesEvidence ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range ontoksd:InstructionalEntity ;
                        rdfs:comment "Links the evidence to the Instructional Entity it is derived from."@en .


###  http://purl.org/ontoksd#evidencesCompetence
ontoksd:evidencesCompetence rdf:type owl:ObjectProperty ;
                            rdfs:domain ontoksd:Evidence ;
                            rdfs:range ontoksd:Competence ;
                            rdfs:comment "Specifies the Competence being evidenced by a given evidence."@en .


###  http://purl.org/ontoksd#forCompetence
ontoksd:forCompetence rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:DocumentDetail ;
                      rdfs:range ontoksd:CompetenceDetail ;
                      rdfs:comment "Indicates the competence detail supported by the document."@en .


###  http://purl.org/ontoksd#forCompetenceElement
ontoksd:forCompetenceElement rdf:type owl:ObjectProperty ;
                             rdfs:domain ontoksd:DocumentDetail ;
                             rdfs:range ontoksd:CompetenceElementDetail ;
                             rdfs:comment "Indicates the competency detail supported by the document."@en .


###  http://purl.org/ontoksd#hasAcquisitionContext
ontoksd:hasAcquisitionContext rdf:type owl:ObjectProperty ;
                              owl:inverseOf ontoksd:isAcquisitionContextOf ;
                              rdfs:domain ontoksd:InstructionalEntity ;
                              rdfs:range ontoksd:AcquisitionContext ;
                              rdfs:comment "Indicates the context (course offering, session, institution, etc.) in which the instructional entity is executed and competence evidence may be observed."@en .


###  http://purl.org/ontoksd#hasAgencyType
ontoksd:hasAgencyType rdf:type owl:ObjectProperty ;
                      rdfs:comment "Specifies the type of the agency."@en .


###  http://purl.org/ontoksd#hasAssessmentType
ontoksd:hasAssessmentType rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Assessment ;
                          rdfs:range ontoksd:AssessmentType .


###  http://purl.org/ontoksd#hasAttitude
ontoksd:hasAttitude rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ontoksd:hasDisposition ;
                    owl:inverseOf ontoksd:isAttitudeOf ;
                    rdfs:domain ontoksd:Competence ;
                    rdfs:range ontoksd:Attitude .


###  http://purl.org/ontoksd#hasAttitudeType
ontoksd:hasAttitudeType rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf ontoksd:hasDispositionType ;
                        rdfs:domain ontoksd:Attitude ;
                        rdfs:range ontoksd:AttitudeType ;
                        rdfs:comment "Relates an Attitude to its categorized type."@en .


###  http://purl.org/ontoksd#hasCognitiveLevel
ontoksd:hasCognitiveLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Skill .


###  http://purl.org/ontoksd#hasCompetenceContext
ontoksd:hasCompetenceContext rdf:type owl:ObjectProperty ;
                             rdfs:domain ontoksd:Competence ;
                             rdfs:range ontoksd:Context ;
                             rdfs:comment "Specifies the context in which a Competence is applied."@en .


###  http://purl.org/ontoksd#hasCompetenceDetailContext
ontoksd:hasCompetenceDetailContext rdf:type owl:ObjectProperty ;
                                   rdfs:domain ontoksd:CompetenceDetail ;
                                   rdfs:range ontoksd:Context ;
                                   rdfs:comment "Contextual information about the Competence Detail."@en .


###  http://purl.org/ontoksd#hasCompetenceElement
ontoksd:hasCompetenceElement rdf:type owl:ObjectProperty ;
                             owl:inverseOf ontoksd:isCompetenceElementOf ;
                             rdfs:domain ontoksd:Competence ;
                             rdfs:range ontoksd:CompetenceElement ;
                             rdfs:comment "As propriedades hasSkill, hasKnowledge e hasAttitude foram criadas como subpropriedades de hasCompetenceElement."@en ,
                                          "Indicates the competency detail of a person."@en .


###  http://purl.org/ontoksd#hasCompetenceElementContext
ontoksd:hasCompetenceElementContext rdf:type owl:ObjectProperty ;
                                    rdfs:domain ontoksd:CompetenceElement ;
                                    rdfs:range ontoksd:Context ;
                                    rdfs:comment "Context in which the Competency is expressed or observed."@en .


###  http://purl.org/ontoksd#hasCompetenceElementDetailContext
ontoksd:hasCompetenceElementDetailContext rdf:type owl:ObjectProperty ;
                                          rdfs:domain ontoksd:CompetenceElementDetail ;
                                          rdfs:range ontoksd:Context ;
                                          rdfs:comment "Contextualizes a Competency Detail."@en .


###  http://purl.org/ontoksd#hasCompetenceElementLevel
ontoksd:hasCompetenceElementLevel rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:CompetenceElementDetail ;
                                  rdfs:range ontoksd:ProficiencyLevel ;
                                  rdfs:comment "Assigns a Level to a Competency Detail."@en .


###  http://purl.org/ontoksd#hasCompetenceElementScale
ontoksd:hasCompetenceElementScale rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:CompetenceElement ;
                                  rdfs:range ontoksd:Scale ;
                                  rdfs:comment "Specifies the measurement scale for a Competency."@en .


###  http://purl.org/ontoksd#hasCompetenceScale
ontoksd:hasCompetenceScale rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:Scale ;
                           rdfs:comment "Defines the scale used to measure a Competence."@en .


###  http://purl.org/ontoksd#hasCompetenceType
ontoksd:hasCompetenceType rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Competence ;
                          rdfs:range ontoksd:CompetenceType ;
                          rdfs:comment "Specifies whether a competence is educational, profissional, or another type."@en .


###  http://purl.org/ontoksd#hasComponent
ontoksd:hasComponent rdf:type owl:ObjectProperty ;
                     owl:inverseOf ontoksd:isComponentOf ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Competence ;
                     rdfs:comment """Indicates a compositional relationship, where a meta-competence (composite competence) is composed of several component competencies. The meta-competence is considered fully demonstrated only if all of its components are evidenced.

Use case: Supports logical aggregation and progressive demonstration of more general abilities."""@en .


###  http://purl.org/ontoksd#hasDigitalArtifact
ontoksd:hasDigitalArtifact rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:InstructionalEntity ;
                           rdfs:range ontoksd:DigitalArtifact .


###  http://purl.org/ontoksd#hasDisposition
ontoksd:hasDisposition rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                       owl:inverseOf ontoksd:isDispositionOf ;
                       rdfs:domain ontoksd:Competence ;
                       rdfs:range ontoksd:Disposition .


###  http://purl.org/ontoksd#hasDispositionType
ontoksd:hasDispositionType rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Disposition ;
                           rdfs:range ontoksd:DispositionType .


###  http://purl.org/ontoksd#hasEducation
ontoksd:hasEducation rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:Profile ;
                     rdfs:comment "Links a person model to their educational background."@en .


###  http://purl.org/ontoksd#hasEducationLevel
ontoksd:hasEducationLevel rdf:type owl:ObjectProperty ;
                          rdfs:range ontoksd:ProficiencyLevel ;
                          rdfs:comment "Associates an educational detail with a level."@en .


###  http://purl.org/ontoksd#hasEducationScale
ontoksd:hasEducationScale rdf:type owl:ObjectProperty ;
                          rdfs:range ontoksd:Scale ;
                          rdfs:comment "Specifies the scale used in educational evaluation."@en .


###  http://purl.org/ontoksd#hasEvidence
ontoksd:hasEvidence rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Profile ;
                    rdfs:range ontoksd:Evidence ;
                    rdfs:comment "Indicates the evidence collected for the person."@en .


###  http://purl.org/ontoksd#hasEvidenceContext
ontoksd:hasEvidenceContext rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Evidence ;
                           rdfs:range ontoksd:Context ;
                           rdfs:comment "Provides the context in which the evidence is observed."@en .


###  http://purl.org/ontoksd#hasEvidenceLevel
ontoksd:hasEvidenceLevel rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Evidence ;
                         rdfs:range ontoksd:ProficiencyLevel ;
                         rdfs:comment "Specifies the assessment level attributed to the evidence."@en .


###  http://purl.org/ontoksd#hasEvidenceType
ontoksd:hasEvidenceType rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range ontoksd:EvidenceType ;
                        rdfs:comment "Defines the classification of the evidence."@en .


###  http://purl.org/ontoksd#hasFormativeCredit
ontoksd:hasFormativeCredit rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:DocumentDetail ;
                           rdfs:range ontoksd:FormativeCredit ;
                           rdfs:comment "Specifies the credit gained from a document detail."@en .


###  http://purl.org/ontoksd#hasInstructionalEntity
ontoksd:hasInstructionalEntity rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Course ;
                               rdfs:range ontoksd:InstructionalEntity .


###  http://purl.org/ontoksd#hasInterval
ontoksd:hasInterval rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Scale ;
                    rdfs:range ontoksd:Interval .


###  http://purl.org/ontoksd#hasKnowledge
ontoksd:hasKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                     owl:inverseOf ontoksd:isKnowledgeOf ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Knowledge .


###  http://purl.org/ontoksd#hasKnowledgeComponent
ontoksd:hasKnowledgeComponent rdf:type owl:ObjectProperty ;
                              rdfs:domain ontoksd:KnowledgeSkill ;
                              rdfs:range ontoksd:Knowledge ;
                              rdfs:comment "Associates a KnowledgeSkill with the knowledge component involved."@en .


###  http://purl.org/ontoksd#hasKnowledgeSkill
ontoksd:hasKnowledgeSkill rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Competence ;
                          rdfs:range ontoksd:KnowledgeSkill .


###  http://purl.org/ontoksd#hasKnowledgeType
ontoksd:hasKnowledgeType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Knowledge ;
                         rdfs:range ontoksd:KnowledgeType ;
                         rdfs:comment "Relates a Knowledge to its specific knowledge type."@en .


###  http://purl.org/ontoksd#hasLearningNeeds
ontoksd:hasLearningNeeds rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Profile ;
                         rdfs:range ontoksd:LearningNeed ;
                         rdfs:comment "Lists the learning needs of a person."@en .


###  http://purl.org/ontoksd#hasLevel
ontoksd:hasLevel rdf:type owl:ObjectProperty ;
                 owl:inverseOf ontoksd:selectedInScale ;
                 rdfs:domain ontoksd:Scale ;
                 rdfs:range ontoksd:ProficiencyLevel .


###  http://purl.org/ontoksd#hasPerformanceClass
ontoksd:hasPerformanceClass rdf:type owl:ObjectProperty ;
                            rdfs:domain ontoksd:CompetenceDetail ;
                            rdfs:range skos:Concept ;
                            owl:propertyChainAxiom ( ontoksd:hasProficiencyLevel
                                                     ontoksd:determinesPerformanceClass
                                                   ) ;
                            rdfs:comment "Can be inferred from hasProficiencyLevel ∘ determinesPerformanceClass.\""@en .


###  http://purl.org/ontoksd#hasPerformanceClassCollection
ontoksd:hasPerformanceClassCollection rdf:type owl:ObjectProperty ;
                                      rdfs:domain ontoksd:Scale ;
                                      rdfs:range ontoksd:PerformanceClassScheme .


###  http://purl.org/ontoksd#hasPerformedRole
ontoksd:hasPerformedRole rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Profile ;
                         rdfs:range ontoksd:RoleDetail ;
                         rdfs:comment "Indicates the role detail already performed by a person."@en .


###  http://purl.org/ontoksd#hasPersonality
ontoksd:hasPersonality rdf:type owl:ObjectProperty ;
                       rdfs:domain ontoksd:Profile ;
                       rdfs:comment "Associates a person with a personality profile."@en .


###  http://purl.org/ontoksd#hasPersonalitySourceType
ontoksd:hasPersonalitySourceType rdf:type owl:ObjectProperty ;
                                 rdfs:comment "Defines the source type of the personality description."@en .


###  http://purl.org/ontoksd#hasProficiencyLevel
ontoksd:hasProficiencyLevel rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( ontoksd:CompetenceDetail
                                                        ontoksd:CompetenceElementDetail
                                                        ontoksd:Evidence
                                                      )
                                        ] ;
                            rdfs:range ontoksd:ProficiencyLevel ;
                            owl:propertyChainAxiom ( [ owl:inverseOf ontoksd:proficiencyOfCompetenceDetail
                                                     ]
                                                   ) ,
                                                   ( [ owl:inverseOf ontoksd:proficiencyOfElementDetail
                                                     ]
                                                   ) ,
                                                   ( [ owl:inverseOf ontoksd:proficiencyOfEvidence
                                                     ]
                                                   ) ;
                            rdfs:comment "Convenience link from bearer to its proficiency-level quality instance(s)."@en .


###  http://purl.org/ontoksd#hasProficiencyValue
ontoksd:hasProficiencyValue rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasReifiedQualityValue> ;
                            rdfs:domain ontoksd:ProficiencyLevel ;
                            rdfs:range ontoksd:ProficiencyValue .


###  http://purl.org/ontoksd#hasProfile
ontoksd:hasProfile rdf:type owl:ObjectProperty ;
                   owl:inverseOf ontoksd:isProfileOf ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain ontoksd:Person ;
                   rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#hasProfileCompetence
ontoksd:hasProfileCompetence rdf:type owl:ObjectProperty ;
                             owl:inverseOf ontoksd:isCompetenceDetailOfProfile ;
                             rdfs:domain ontoksd:Profile ;
                             rdfs:range ontoksd:CompetenceDetail ;
                             rdfs:comment "Indicates the competence detail of a person."@en .


###  http://purl.org/ontoksd#hasProfileCompetenceElement
ontoksd:hasProfileCompetenceElement rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    rdfs:domain ontoksd:Profile ;
                                    rdfs:range ontoksd:CompetenceElementDetail .


###  http://purl.org/ontoksd#hasRCD
ontoksd:hasRCD rdf:type owl:ObjectProperty ;
               owl:inverseOf ontoksd:representsCompetence ;
               rdfs:domain ontoksd:Competence ;
               rdfs:range rcd:RCD .


###  http://purl.org/ontoksd#hasResourceType
ontoksd:hasResourceType rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:EducationalResource ;
                        rdfs:range ontoksd:ResourceType .


###  http://purl.org/ontoksd#hasSkill
ontoksd:hasSkill rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                 owl:inverseOf ontoksd:isSkillOf ;
                 rdfs:domain ontoksd:Competence ;
                 rdfs:range ontoksd:Skill ;
                 rdfs:comment "Indicates a skill that composes the competence."@en .


###  http://purl.org/ontoksd#hasSkillComponent
ontoksd:hasSkillComponent rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain ontoksd:KnowledgeSkill ;
                          rdfs:range ontoksd:Skill ;
                          rdfs:comment "Associates a KnowledgeSkill with the skill component that operates on the knowledge."@en .


###  http://purl.org/ontoksd#hasSkillType
ontoksd:hasSkillType rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:Skill ;
                     rdfs:range ontoksd:SkillType ;
                     rdfs:comment "Associates a Skill with its classified type."@en .


###  http://purl.org/ontoksd#hasSpecialization
ontoksd:hasSpecialization rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Competence ;
                          rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#hasStructureType
ontoksd:hasStructureType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Competence ;
                         rdfs:range ontoksd:StructureType ;
                         rdfs:comment "Specifies whether a competence is atomic, composite, or another type."@en .


###  http://purl.org/ontoksd#hasSupportDocument
ontoksd:hasSupportDocument rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Evidence ;
                           rdfs:range ontoksd:Document ;
                           rdfs:comment "Evidence can be supported by a Document"@en .


###  http://purl.org/ontoksd#hasSyllabus
ontoksd:hasSyllabus rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain ontoksd:Course ;
                    rdfs:range ontoksd:DigitalArtifact ;
                    rdfs:comment "The property hasSyllabus links a Course to a DigitalArtifact representing its official syllabus. The syllabus contains structured information such as objectives, competencies, topics, evaluation methods, and references. This property is functional, ensuring that a course cannot be associated with more than one syllabus simultaneously."@en ;
                    skos:example """If a course has a syllabus, it should be instantiated as a DigitalArtifact and connected via hasSyllabus.

Examples of digital artifacts include:

- Markdown or PDF syllabus files

- URLs linking to institutional repositories

- Structured syllabus metadata in digital repositories

A course without a syllabus remains valid in the ontology, supporting lifecycle states (e.g., planned or provisional courses)."""@en .


###  http://purl.org/ontoksd#includesResponsibility
ontoksd:includesResponsibility rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningRole ;
                               rdfs:comment "Lists responsibilities included in a role."@en .


###  http://purl.org/ontoksd#isAcquisitionContextOf
ontoksd:isAcquisitionContextOf rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:AcquisitionContext ;
                               rdfs:range ontoksd:InstructionalEntity .


###  http://purl.org/ontoksd#isAttitudeOf
ontoksd:isAttitudeOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ontoksd:isDispositionOf ;
                     rdfs:domain ontoksd:Attitude ;
                     rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isBroaderThan
ontoksd:isBroaderThan rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:Competence ;
                      rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isCompetenceDetailOfProfile
ontoksd:isCompetenceDetailOfProfile rdf:type owl:ObjectProperty ;
                                    rdfs:domain ontoksd:CompetenceDetail ;
                                    rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#isCompetenceElementOf
ontoksd:isCompetenceElementOf rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                              rdfs:domain ontoksd:CompetenceElement ;
                              rdfs:range ontoksd:Competence ;
                              rdfs:comment "Indicates that a Competency is mandatory for a given Competence."@en .


###  http://purl.org/ontoksd#isComponentOf
ontoksd:isComponentOf rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:Competence ;
                      rdfs:range ontoksd:Competence ;
                      rdfs:comment "Competences may be an aggregation of other competences" .


###  http://purl.org/ontoksd#isDispositionOf
ontoksd:isDispositionOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf ontoksd:isCompetenceElementOf ;
                        rdfs:domain ontoksd:Disposition ;
                        rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isEvidenceOfProfile
ontoksd:isEvidenceOfProfile rdf:type owl:ObjectProperty ;
                            rdfs:domain ontoksd:Evidence ;
                            rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#isKnowledgeOf
ontoksd:isKnowledgeOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ontoksd:isCompetenceElementOf ;
                      rdfs:domain ontoksd:Knowledge ;
                      rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isLinkedToCompetenceVia
ontoksd:isLinkedToCompetenceVia rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf owl:topObjectProperty ;
                                rdfs:domain ontoksd:InstructionalEntity ;
                                rdfs:range ontoksd:CompetenceAssociation ;
                                rdfs:comment "Shortcut property linking an instructional entity to a CompetenceAssociation that specifies its target or prerequisite competencies."@en .


###  http://purl.org/ontoksd#isObservedBy
ontoksd:isObservedBy rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:Evidence ;
                     rdfs:range ontoksd:Profile ;
                     rdfs:comment "Specifies the Profile who observed the evidence."@en .


###  http://purl.org/ontoksd#isProfileOf
ontoksd:isProfileOf rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Profile ;
                    rdfs:range ontoksd:Person .


###  http://purl.org/ontoksd#isSkillOf
ontoksd:isSkillOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ontoksd:isCompetenceElementOf ;
                  rdfs:domain ontoksd:Skill ;
                  rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isSpecializationOf
ontoksd:isSpecializationOf rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#mapsToProficiencyValue
ontoksd:mapsToProficiencyValue rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Interval ;
                               rdfs:range ontoksd:ProficiencyValue .


###  http://purl.org/ontoksd#mediatesInstructionalEntity
ontoksd:mediatesInstructionalEntity rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                                    rdfs:domain ontoksd:CompetenceAssociation ;
                                    rdfs:range ontoksd:InstructionalEntity .


###  http://purl.org/ontoksd#mediatesPrerequisiteCompetence
ontoksd:mediatesPrerequisiteCompetence rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                                       rdfs:domain ontoksd:CompetenceAssociation ;
                                       rdfs:range ontoksd:Competence ;
                                       rdfs:comment """A relation between an InstructionalEntity and a Competence indicating that the competence is a prerequisite for meaningful engagement or successful completion of the instructional activity.
This property specifies that certain competences must already be possessed or evidenced before participation in the InstructionalEntity.

Intended semantics: If an InstructionalEntity requires a competence, learners without that competence may struggle to engage fully with the activity or achieve its intended outcomes.

Examples:

An “Advanced Machine Learning” course requiring competence in “Linear Algebra” and “Programming in Python”.

A “Capstone Project” requiring “Research Methodology” competence.

A “Professional Ethics Seminar” requiring “Critical Reading and Writing” competence.

Ontological notes:

requiresCompetence enables curriculum sequencing and prerequisite mapping in both formal and informal learning contexts.

This property supports curriculum traceability by clarifying the dependency structure between competences.""" .


###  http://purl.org/ontoksd#mediatesTargetCompetence
ontoksd:mediatesTargetCompetence rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                                 rdfs:domain ontoksd:CompetenceAssociation ;
                                 rdfs:range ontoksd:Competence ;
                                 rdfs:comment """A relation between an InstructionalEntity and a Competence indicating that the competence is an intended learning outcome of the instructional design.
This property specifies that the InstructionalEntity is deliberately planned to develop or reinforce the target competence through its activities, resources, and assessments.

Intended semantics: If an InstructionalEntity targets a competence, successful completion or participation should provide the learner with the opportunity to acquire, improve, or demonstrate that competence.

Examples:

A “Software Engineering Project” course targeting “Collaborative Software Development” competence.

A “Data Structures” module targeting “Algorithmic Problem-Solving” competence.

A “Public Speaking Workshop” targeting “Oral Communication” competence.

Ontological notes:

targetsCompetence links the instructional domain to the competence model in the planning stage (competence as intended outcome).

Assessment artifacts within the InstructionalEntity may generate Evidence linked back to the targeted competence for validation.""" .


###  http://purl.org/ontoksd#needsCompetence
ontoksd:needsCompetence rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:LearningNeed ;
                        rdfs:range ontoksd:CompetenceDetail ;
                        rdfs:comment "Defines the competence needed by a learning need."@en .


###  http://purl.org/ontoksd#needsCompetenceElement
ontoksd:needsCompetenceElement rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningNeed ;
                               rdfs:range ontoksd:CompetenceElementDetail ;
                               rdfs:comment "Defines the competency required by a learning need."@en .


###  http://purl.org/ontoksd#producesEvidence
ontoksd:producesEvidence rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:InstructionalEntity ;
                         rdfs:range ontoksd:Evidence .


###  http://purl.org/ontoksd#proficiencyOfCompetenceDetail
ontoksd:proficiencyOfCompetenceDetail rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                                      rdfs:domain ontoksd:ProficiencyLevel ;
                                      rdfs:range ontoksd:CompetenceDetail .


###  http://purl.org/ontoksd#proficiencyOfElementDetail
ontoksd:proficiencyOfElementDetail rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                                   rdfs:domain ontoksd:ProficiencyLevel ;
                                   rdfs:range ontoksd:CompetenceElementDetail .


###  http://purl.org/ontoksd#proficiencyOfEvidence
ontoksd:proficiencyOfEvidence rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                              rdfs:domain ontoksd:ProficiencyLevel ;
                              rdfs:range ontoksd:Evidence .


###  http://purl.org/ontoksd#providesEvidence
ontoksd:providesEvidence rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:RoleDetail ;
                         rdfs:range ontoksd:Evidence ;
                         rdfs:comment "Specifies the evidence provided in a role detail."@en .


###  http://purl.org/ontoksd#providesSelfAssessment
ontoksd:providesSelfAssessment rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Profile ;
                               rdfs:range ontoksd:Evidence ;
                               rdfs:comment "Links a person to a self-assessment evidence."@en .


###  http://purl.org/ontoksd#refersToClassification
ontoksd:refersToClassification rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningRole ;
                               rdfs:comment "Links the role to its classification."@en .


###  http://purl.org/ontoksd#refersToCompetence
ontoksd:refersToCompetence rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:CompetenceDetail ;
                           rdfs:range ontoksd:Competence ;
                           rdfs:comment "Links a detailed record to a high-level Competence."@en .


###  http://purl.org/ontoksd#refersToCompetenceElement
ontoksd:refersToCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:CompetenceElementDetail ;
                                  rdfs:range ontoksd:CompetenceElement ;
                                  rdfs:comment "Associates a Competency Detail to a Competency."@en .


###  http://purl.org/ontoksd#refersToDocument
ontoksd:refersToDocument rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:DocumentDetail ;
                         rdfs:range ontoksd:Document ;
                         rdfs:comment "Links document detail to a document."@en .


###  http://purl.org/ontoksd#refersToRole
ontoksd:refersToRole rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:RoleDetail ;
                     rdfs:range ontoksd:LearningRole ;
                     rdfs:comment "Links a role detail to a specific role."@en .


###  http://purl.org/ontoksd#releases
ontoksd:releases rdf:type owl:ObjectProperty ;
                 rdfs:range ontoksd:DocumentDetail ;
                 rdfs:comment "Indicates the document detail issued by the agency."@en .


###  http://purl.org/ontoksd#representsCompetence
ontoksd:representsCompetence rdf:type owl:ObjectProperty ;
                             rdfs:domain rcd:RCD ;
                             rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#representsKnowledgeArea
ontoksd:representsKnowledgeArea rdf:type owl:ObjectProperty ;
                                rdfs:domain ontoksd:Knowledge ;
                                rdfs:range skos:Concept .


###  http://purl.org/ontoksd#requiresCompetence
ontoksd:requiresCompetence rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#requiresCompetenceElement
ontoksd:requiresCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:LearningRole ;
                                  rdfs:range ontoksd:CompetenceElementDetail ;
                                  rdfs:comment "Defines a competency needed to fulfill the role."@en .


###  http://purl.org/ontoksd#requiresRoleCompetence
ontoksd:requiresRoleCompetence rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningRole ;
                               rdfs:range ontoksd:CompetenceDetail ;
                               rdfs:comment "Specifies the required competence for a role."@en .


###  http://purl.org/ontoksd#selectedInScale
ontoksd:selectedInScale rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain ontoksd:ProficiencyLevel ;
                        rdfs:range ontoksd:Scale ;
                        rdfs:comment "Each ProficiencyLevel belongs to exactly one Scale"@en .


###  http://purl.org/ontoksd#suggestsCompetenceElement
ontoksd:suggestsCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:LearningRole ;
                                  rdfs:range ontoksd:CompetenceElementDetail ;
                                  rdfs:comment "Recommends a competency as helpful for the role."@en .


###  http://purl.org/ontoksd#suggestsRoleCompetence
ontoksd:suggestsRoleCompetence rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningRole ;
                               rdfs:range ontoksd:CompetenceDetail ;
                               rdfs:comment "Suggests a competence as beneficial for the role."@en .


###  http://purl.org/ontoksd#usedAsTypeOfKnowledge
ontoksd:usedAsTypeOfKnowledge rdf:type owl:ObjectProperty ;
                              rdfs:domain skos:Concept ;
                              rdfs:range ontoksd:KnowledgeType .


###  http://purl.org/ontoksd#usesResource
ontoksd:usesResource rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:InstructionalEntity ;
                     rdfs:range ontoksd:EducationalResource .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/ontoksd#courseEndDate
ontoksd:courseEndDate rdf:type owl:DatatypeProperty ;
                      rdfs:domain ontoksd:Course ;
                      rdfs:range xsd:date .


###  http://purl.org/ontoksd#courseStartDate
ontoksd:courseStartDate rdf:type owl:DatatypeProperty ;
                        rdfs:domain ontoksd:Course ;
                        rdfs:range xsd:date .


###  http://purl.org/ontoksd#hasBeginning
ontoksd:hasBeginning rdf:type owl:DatatypeProperty ;
                     rdfs:domain ontoksd:RoleDetail ;
                     rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#hasEnd
ontoksd:hasEnd rdf:type owl:DatatypeProperty ;
               rdfs:domain ontoksd:RoleDetail ;
               rdfs:range xsd:dateTime .


###  http://purl.org/ontoksd#hasNumericProficiencyValue
ontoksd:hasNumericProficiencyValue rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                   rdfs:domain ontoksd:ProficiencyLevel ;
                                   rdfs:range xsd:decimal ;
                                   rdfs:comment "Numeric score on a scale (e.g., 0–100) associated with the proficiency level.\""@en .


###  http://purl.org/ontoksd#includesLower
ontoksd:includesLower rdf:type owl:DatatypeProperty ;
                      rdfs:domain ontoksd:Interval ;
                      rdfs:range xsd:boolean .


###  http://purl.org/ontoksd#includesUpper
ontoksd:includesUpper rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain ontoksd:Interval ;
                      rdfs:range xsd:boolean .


###  http://purl.org/ontoksd#intendedUse
ontoksd:intendedUse rdf:type owl:DatatypeProperty ;
                    rdfs:domain ontoksd:EducationalResource ;
                    rdfs:range xsd:string .


###  http://purl.org/ontoksd#isTeamBased
ontoksd:isTeamBased rdf:type owl:DatatypeProperty ;
                    rdfs:domain ontoksd:LearningActivity ;
                    rdfs:range xsd:boolean .


###  http://purl.org/ontoksd#lowerBound
ontoksd:lowerBound rdf:type owl:DatatypeProperty ;
                   rdfs:domain ontoksd:Interval ;
                   rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#maxScore
ontoksd:maxScore rdf:type owl:DatatypeProperty ;
                 rdfs:domain ontoksd:Assessment ;
                 rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#maxValue
ontoksd:maxValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain ontoksd:Scale ;
                 rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#minValue
ontoksd:minValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain ontoksd:Scale ;
                 rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#passingScore
ontoksd:passingScore rdf:type owl:DatatypeProperty ;
                     rdfs:domain ontoksd:Assessment ;
                     rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#step
ontoksd:step rdf:type owl:DatatypeProperty ;
             rdfs:domain ontoksd:Scale ;
             rdfs:range xsd:decimal .


###  http://purl.org/ontoksd#upperBound
ontoksd:upperBound rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain ontoksd:Interval ;
