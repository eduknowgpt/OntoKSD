#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontoksd:AttitudeType
                ontoksd:DispositionType
                ontoksd:KnowledgeType
                ontoksd:SkillType
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontoksd:Disposition
                ontoksd:Knowledge
                ontoksd:Skill
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontoksd:DispositionType
                ontoksd:KnowledgeType
                ontoksd:SkillType
              )
] .


