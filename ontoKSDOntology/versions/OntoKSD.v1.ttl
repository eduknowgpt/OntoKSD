@prefix : <http://www.semanticweb.org/ontoksd#> .
@prefix dc: <http://purl.org/dc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oksd: <http://www.semanticweb.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontoksd: <http://www.semanticweb.org/ontoksd#> .
@prefix www.semanticweb.org: <http://www.semanticweb.org/> .
@base <http://www.semanticweb.org/> .

<http://www.semanticweb.org/> rdf:type owl:Ontology ;
                               owl:versionIRI <http://www.semanticweb.org/> ;
                               owl:imports <http://www.w3.org/2004/02/skos/core> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/consistsOfLevels
www.semanticweb.org:consistsOfLevels rdf:type owl:ObjectProperty ;
                                     rdfs:domain ontoksd:Scale ;
                                     rdfs:range ontoksd:ProficiencyLevel .


###  http://www.semanticweb.org/hasPersonModelCompetenceElement
www.semanticweb.org:hasPersonModelCompetenceElement rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                                                    rdfs:domain ontoksd:PersonModel ;
                                                    rdfs:range ontoksd:CompetenceElementDetail .


###  http://www.semanticweb.org/hasPrerequisiteCompetence
www.semanticweb.org:hasPrerequisiteCompetence rdf:type owl:ObjectProperty ;
                                              rdfs:domain ontoksd:InstructionalEntity ;
                                              rdfs:range ontoksd:Competence .


###  http://www.semanticweb.org/hasTargetCompetence
www.semanticweb.org:hasTargetCompetence rdf:type owl:ObjectProperty ;
                                        rdfs:domain ontoksd:InstructionalEntity ;
                                        rdfs:range ontoksd:Competence .


###  http://www.semanticweb.org/representsKnowledgeArea
www.semanticweb.org:representsKnowledgeArea rdf:type owl:ObjectProperty ;
                                            rdfs:domain ontoksd:Knowledge .


###  http://www.semanticweb.org/ontoksd#acquiredIn
ontoksd:acquiredIn rdf:type owl:ObjectProperty ;
                   rdfs:range ontoksd:InstructionalEntity ;
                   rdfs:comment "Indicates where a learning goal was acquired."@en .


###  http://www.semanticweb.org/ontoksd#aplliesFor
ontoksd:aplliesFor rdf:type owl:ObjectProperty ;
                   rdfs:domain ontoksd:PersonModel ;
                   rdfs:range ontoksd:LearningRole ;
                   rdfs:comment "Specifies the role a person is applying for."@en .


###  http://www.semanticweb.org/ontoksd#assessesCompetenceElement
ontoksd:assessesCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:Evidence ;
                                  rdfs:range ontoksd:Competency .


###  http://www.semanticweb.org/ontoksd#consistsOf
ontoksd:consistsOf rdf:type owl:ObjectProperty ;
                   rdfs:domain ontoksd:Competence ;
                   rdfs:range ontoksd:Competency ;
                   rdfs:comment "Indicates the set of Competencies that form a Competence."@en .


###  http://www.semanticweb.org/ontoksd#equivalentClass
ontoksd:equivalentClass rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:Competence ;
                        rdfs:range ontoksd:RCD ;
                        rdfs:comment "Equivalence relation to another class such as RCD."@en .


###  http://www.semanticweb.org/ontoksd#evidenceBasedOn
ontoksd:evidenceBasedOn rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range ontoksd:InstructionalEntity ;
                        rdfs:comment "Links the evidence to the Instructional Entity it is derived from."@en .


###  http://www.semanticweb.org/ontoksd#evidencesCompetence
ontoksd:evidencesCompetence rdf:type owl:ObjectProperty ;
                            rdfs:domain ontoksd:Evidence ;
                            rdfs:range ontoksd:Competence ;
                            rdfs:comment "Specifies the Competence being evidenced by a given evidence."@en .


###  http://www.semanticweb.org/ontoksd#forCompetence
ontoksd:forCompetence rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:DocumentDetail ;
                      rdfs:range ontoksd:CompetenceDetail ;
                      rdfs:comment "Indicates the competence detail supported by the document."@en .


###  http://www.semanticweb.org/ontoksd#forCompetenceElement
ontoksd:forCompetenceElement rdf:type owl:ObjectProperty ;
                             rdfs:domain ontoksd:DocumentDetail ;
                             rdfs:range ontoksd:CompetenceElementDetail ;
                             rdfs:comment "Indicates the competency detail supported by the document."@en .


###  http://www.semanticweb.org/ontoksd#hasAcquisitionContext
ontoksd:hasAcquisitionContext rdf:type owl:ObjectProperty ;
                              rdfs:domain ontoksd:InstructionalEntity ;
                              rdfs:range ontoksd:AcquisitionContext ;
                              rdfs:comment "Specifies the context of acquisition for an instructional entity."@en .


###  http://www.semanticweb.org/ontoksd#hasAgencyType
ontoksd:hasAgencyType rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:Agency ;
                      rdfs:range ontoksd:AgencyType ;
                      rdfs:comment "Specifies the type of the agency."@en .


###  http://www.semanticweb.org/ontoksd#hasAttitude
ontoksd:hasAttitude rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ontoksd:hasDisposition ;
                    owl:inverseOf ontoksd:isAttitudeFor ;
                    rdfs:domain ontoksd:Competence ;
                    rdfs:range ontoksd:Attitude .


###  http://www.semanticweb.org/ontoksd#hasAttitudeType
ontoksd:hasAttitudeType rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf ontoksd:hasDispositionType ;
                        rdfs:domain ontoksd:Attitude ;
                        rdfs:range ontoksd:AttitudeType ;
                        rdfs:comment "Relates an Attitude to its categorized type."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceContext
ontoksd:hasCompetenceContext rdf:type owl:ObjectProperty ;
                             rdfs:domain ontoksd:Competence ;
                             rdfs:range ontoksd:Context ;
                             rdfs:comment "Specifies the context in which a Competence is applied."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceDetailContext
ontoksd:hasCompetenceDetailContext rdf:type owl:ObjectProperty ;
                                   rdfs:domain ontoksd:CompetenceDetail ;
                                   rdfs:range ontoksd:Context ;
                                   rdfs:comment "Contextual information about the Competence Detail."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceElement
ontoksd:hasCompetenceElement rdf:type owl:ObjectProperty ;
                             owl:inverseOf ontoksd:isCompetenceElementFor ;
                             rdfs:domain ontoksd:Competence ;
                             rdfs:range ontoksd:Competency ;
                             rdfs:comment "As propriedades hasSkill, hasKnowledge e hasAttitude foram criadas como subpropriedades de hasCompetenceElement."@en ,
                                          "Indicates the competency detail of a person."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceElementContext
ontoksd:hasCompetenceElementContext rdf:type owl:ObjectProperty ;
                                    rdfs:domain ontoksd:Competency ;
                                    rdfs:range ontoksd:Context ;
                                    rdfs:comment "Context in which the Competency is expressed or observed."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceElementDetailContext
ontoksd:hasCompetenceElementDetailContext rdf:type owl:ObjectProperty ;
                                          rdfs:domain ontoksd:CompetenceElementDetail ;
                                          rdfs:range ontoksd:Context ;
                                          rdfs:comment "Contextualizes a Competency Detail."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceElementLevel
ontoksd:hasCompetenceElementLevel rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:CompetenceElementDetail ;
                                  rdfs:range ontoksd:ProficiencyLevel ;
                                  rdfs:comment "Assigns a Level to a Competency Detail."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceElementScale
ontoksd:hasCompetenceElementScale rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:Competency ;
                                  rdfs:range ontoksd:Scale ;
                                  rdfs:comment "Specifies the measurement scale for a Competency."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceLevel
ontoksd:hasCompetenceLevel rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:CompetenceDetail ;
                           rdfs:range ontoksd:ProficiencyLevel ;
                           rdfs:comment "Assigns a Level to a Competence Detail."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceScale
ontoksd:hasCompetenceScale rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:Scale ;
                           rdfs:comment "Defines the scale used to measure a Competence."@en .


###  http://www.semanticweb.org/ontoksd#hasCompetenceType
ontoksd:hasCompetenceType rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Competence ;
                          rdfs:range ontoksd:CompetenceType ;
                          rdfs:comment "Specifies whether a competence is atomic, composite, or another type."@en .


###  http://www.semanticweb.org/ontoksd#hasComponent
ontoksd:hasComponent rdf:type owl:ObjectProperty ;
                     owl:inverseOf ontoksd:isComponentOf ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Competence .


###  http://www.semanticweb.org/ontoksd#hasDisposition
ontoksd:hasDisposition rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                       owl:inverseOf ontoksd:isDispositionFor ;
                       rdfs:domain ontoksd:Competence ;
                       rdfs:range ontoksd:Disposition .


###  http://www.semanticweb.org/ontoksd#hasDispositionType
ontoksd:hasDispositionType rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Disposition ;
                           rdfs:range ontoksd:DispositionType .


###  http://www.semanticweb.org/ontoksd#hasEducation
ontoksd:hasEducation rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:PersonModel ;
                     rdfs:comment "Links a person model to their educational background."@en .


###  http://www.semanticweb.org/ontoksd#hasEducationLevel
ontoksd:hasEducationLevel rdf:type owl:ObjectProperty ;
                          rdfs:range ontoksd:ProficiencyLevel ;
                          rdfs:comment "Associates an educational detail with a level."@en .


###  http://www.semanticweb.org/ontoksd#hasEducationScale
ontoksd:hasEducationScale rdf:type owl:ObjectProperty ;
                          rdfs:range ontoksd:Scale ;
                          rdfs:comment "Specifies the scale used in educational evaluation."@en .


###  http://www.semanticweb.org/ontoksd#hasEvidence
ontoksd:hasEvidence rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:PersonModel ;
                    rdfs:range ontoksd:Evidence ;
                    rdfs:comment "Indicates the evidence collected for the person."@en .


###  http://www.semanticweb.org/ontoksd#hasEvidenceContext
ontoksd:hasEvidenceContext rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Evidence ;
                           rdfs:range ontoksd:Context ;
                           rdfs:comment "Provides the context in which the evidence is observed."@en .


###  http://www.semanticweb.org/ontoksd#hasEvidenceLevel
ontoksd:hasEvidenceLevel rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Evidence ;
                         rdfs:range ontoksd:ProficiencyLevel ;
                         rdfs:comment "Specifies the assessment level attributed to the evidence."@en .


###  http://www.semanticweb.org/ontoksd#hasEvidenceType
ontoksd:hasEvidenceType rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range ontoksd:EvidenceType ;
                        rdfs:comment "Defines the classification of the evidence."@en .


###  http://www.semanticweb.org/ontoksd#hasFormativeCredit
ontoksd:hasFormativeCredit rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:DocumentDetail ;
                           rdfs:range ontoksd:FormativeCredit ;
                           rdfs:comment "Specifies the credit gained from a document detail."@en .


###  http://www.semanticweb.org/ontoksd#hasGoal
ontoksd:hasGoal rdf:type owl:ObjectProperty ;
                rdfs:domain ontoksd:InstructionalEntity ;
                rdfs:comment "Associates a learning goal with an instructional entity."@en .


###  http://www.semanticweb.org/ontoksd#hasKnowledge
ontoksd:hasKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                     owl:inverseOf ontoksd:isKnowledgeFor ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Knowledge .


###  http://www.semanticweb.org/ontoksd#hasKnowledgeComponent
ontoksd:hasKnowledgeComponent rdf:type owl:ObjectProperty ;
                              rdfs:domain ontoksd:KnowledgeSkill ;
                              rdfs:range ontoksd:Knowledge .


###  http://www.semanticweb.org/ontoksd#hasKnowledgeSkill
ontoksd:hasKnowledgeSkill rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Competence ;
                          rdfs:range ontoksd:KnowledgeSkill .


###  http://www.semanticweb.org/ontoksd#hasKnowledgeType
ontoksd:hasKnowledgeType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Knowledge ;
                         rdfs:range ontoksd:KnowledgeType ;
                         rdfs:comment "Relates a Knowledge to its specific knowledge type."@en .


###  http://www.semanticweb.org/ontoksd#hasLearningNeeds
ontoksd:hasLearningNeeds rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:PersonModel ;
                         rdfs:range ontoksd:LearningNeed ;
                         rdfs:comment "Lists the learning needs of a person."@en .


###  http://www.semanticweb.org/ontoksd#hasPerformedRole
ontoksd:hasPerformedRole rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:PersonModel ;
                         rdfs:range ontoksd:RoleDetail ;
                         rdfs:comment "Indicates the role detail already performed by a person."@en .


###  http://www.semanticweb.org/ontoksd#hasPersonModelCompetence
ontoksd:hasPersonModelCompetence rdf:type owl:ObjectProperty ;
                                 rdfs:domain ontoksd:PersonModel ;
                                 rdfs:range ontoksd:CompetenceDetail ;
                                 rdfs:comment "Indicates the competence detail of a person."@en .


###  http://www.semanticweb.org/ontoksd#hasPersonality
ontoksd:hasPersonality rdf:type owl:ObjectProperty ;
                       rdfs:domain ontoksd:PersonModel ;
                       rdfs:comment "Associates a person with a personality profile."@en .


###  http://www.semanticweb.org/ontoksd#hasPersonalitySourceType
ontoksd:hasPersonalitySourceType rdf:type owl:ObjectProperty ;
                                 rdfs:comment "Defines the source type of the personality description."@en .


###  http://www.semanticweb.org/ontoksd#hasSkill
ontoksd:hasSkill rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                 owl:inverseOf ontoksd:isSkillFor ;
                 rdfs:domain ontoksd:Competence ;
                 rdfs:range ontoksd:Skill ;
                 rdfs:comment "Indicates a skill that composes the competence."@en .


###  http://www.semanticweb.org/ontoksd#hasSkillComponent
ontoksd:hasSkillComponent rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain ontoksd:KnowledgeSkill ;
                          rdfs:range ontoksd:Skill .


###  http://www.semanticweb.org/ontoksd#hasSkillType
ontoksd:hasSkillType rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:Skill ;
                     rdfs:range ontoksd:SkillType ;
                     rdfs:comment "Associates a Skill with its classified type."@en .


###  http://www.semanticweb.org/ontoksd#hasStructureType
ontoksd:hasStructureType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Competence ;
                         rdfs:range ontoksd:StructureType .


###  http://www.semanticweb.org/ontoksd#includesCompetenceDetail
ontoksd:includesCompetenceDetail rdf:type owl:ObjectProperty ;
                                 rdfs:range ontoksd:CompetenceDetail ;
                                 rdfs:comment "Links a learning goal to the competence details it supports."@en .


###  http://www.semanticweb.org/ontoksd#includesCompetenceElementDetail
ontoksd:includesCompetenceElementDetail rdf:type owl:ObjectProperty ;
                                        rdfs:range ontoksd:CompetenceElementDetail ;
                                        rdfs:comment "Links a learning goal to the competency details it supports."@en .


###  http://www.semanticweb.org/ontoksd#includesInstructionalEntity
ontoksd:includesInstructionalEntity rdf:type owl:ObjectProperty ;
                                    rdfs:range ontoksd:InstructionalEntity ;
                                    rdfs:comment "Includes one or more instructional entities in a learning model."@en .


###  http://www.semanticweb.org/ontoksd#includesResponsibility
ontoksd:includesResponsibility rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningRole ;
                               rdfs:range ontoksd:Responsibility ;
                               rdfs:comment "Lists responsibilities included in a role."@en .


###  http://www.semanticweb.org/ontoksd#isAttitudeFor
ontoksd:isAttitudeFor rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ontoksd:isDispositionFor ;
                      rdfs:domain ontoksd:Attitude ;
                      rdfs:range ontoksd:Competence .


###  http://www.semanticweb.org/ontoksd#isCompetenceElementFor
ontoksd:isCompetenceElementFor rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Competency ;
                               rdfs:range ontoksd:Competence ;
                               rdfs:comment "Indicates that a Competency is mandatory for a given Competence."@en .


###  http://www.semanticweb.org/ontoksd#isComponentOf
ontoksd:isComponentOf rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:Competence ;
                      rdfs:range ontoksd:Competence ;
                      rdfs:comment "Competences may be an aggregation of other competences" .


###  http://www.semanticweb.org/ontoksd#isDispositionFor
ontoksd:isDispositionFor rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf ontoksd:isCompetenceElementFor ;
                         rdfs:domain ontoksd:Disposition ;
                         rdfs:range ontoksd:Competence .


###  http://www.semanticweb.org/ontoksd#isHigherThanLevel
ontoksd:isHigherThanLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:ProficiencyLevel ;
                          rdfs:range ontoksd:ProficiencyLevel ;
                          rdfs:comment "Defines a hierarchical relationship between levels."@en .


###  http://www.semanticweb.org/ontoksd#isKnowledgeFor
ontoksd:isKnowledgeFor rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ontoksd:isCompetenceElementFor ;
                       rdfs:domain ontoksd:Knowledge ;
                       rdfs:range ontoksd:Competence .


###  http://www.semanticweb.org/ontoksd#isObservedBy
ontoksd:isObservedBy rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:Evidence ;
                     rdfs:range ontoksd:PersonModel ;
                     rdfs:comment "Specifies the PersonModel who observed the evidence."@en .


###  http://www.semanticweb.org/ontoksd#isSkillFor
ontoksd:isSkillFor rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf ontoksd:isCompetenceElementFor ;
                   rdfs:domain ontoksd:Skill ;
                   rdfs:range ontoksd:Competence .


###  http://www.semanticweb.org/ontoksd#needsCompetence
ontoksd:needsCompetence rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:LearningNeed ;
                        rdfs:range ontoksd:CompetenceDetail ;
                        rdfs:comment "Defines the competence needed by a learning need."@en .


###  http://www.semanticweb.org/ontoksd#needsCompetenceElement
ontoksd:needsCompetenceElement rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningNeed ;
                               rdfs:range ontoksd:CompetenceElementDetail ;
                               rdfs:comment "Defines the competency required by a learning need."@en .


###  http://www.semanticweb.org/ontoksd#providesEvidence
ontoksd:providesEvidence rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:RoleDetail ;
                         rdfs:range ontoksd:Evidence ;
                         rdfs:comment "Specifies the evidence provided in a role detail."@en .


###  http://www.semanticweb.org/ontoksd#providesInstructionalEntity
ontoksd:providesInstructionalEntity rdf:type owl:ObjectProperty ;
                                    rdfs:range ontoksd:CompetenceDetail ;
                                    rdfs:comment "Indicates the competence detail supported by an education process."@en .


###  http://www.semanticweb.org/ontoksd#providesSelfAssessment
ontoksd:providesSelfAssessment rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:PersonModel ;
                               rdfs:range ontoksd:Evidence ;
                               rdfs:comment "Links a person to a self-assessment evidence."@en .


###  http://www.semanticweb.org/ontoksd#refersToClassification
ontoksd:refersToClassification rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:LearningRole ;
                               rdfs:range ontoksd:Classification ;
                               rdfs:comment "Links the role to its classification."@en .


###  http://www.semanticweb.org/ontoksd#refersToCompetence
ontoksd:refersToCompetence rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:CompetenceDetail ;
                           rdfs:range ontoksd:Competence ;
                           rdfs:comment "Links a detailed record to a high-level Competence."@en .


###  http://www.semanticweb.org/ontoksd#refersToCompetenceElement
ontoksd:refersToCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:CompetenceElementDetail ;
                                  rdfs:range ontoksd:Competency ;
                                  rdfs:comment "Associates a Competency Detail to a Competency."@en .


###  http://www.semanticweb.org/ontoksd#refersToDocument
ontoksd:refersToDocument rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:DocumentDetail ;
                         rdfs:range ontoksd:Document ;
                         rdfs:comment "Links document detail to a document."@en .


###  http://www.semanticweb.org/ontoksd#refersToEducation
ontoksd:refersToEducation rdf:type owl:ObjectProperty ;
                          rdfs:comment "Links education detail to a general education context."@en .


###  http://www.semanticweb.org/ontoksd#refersToRole
ontoksd:refersToRole rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:RoleDetail ;
                     rdfs:range ontoksd:LearningRole ;
                     rdfs:comment "Links a role detail to a specific role."@en .


###  http://www.semanticweb.org/ontoksd#releases
ontoksd:releases rdf:type owl:ObjectProperty ;
                 rdfs:domain ontoksd:Agency ;
                 rdfs:range ontoksd:DocumentDetail ;
                 rdfs:comment "Indicates the document detail issued by the agency."@en .


###  http://www.semanticweb.org/ontoksd#requiresCompetence
ontoksd:requiresCompetence rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:LearningRole ;
                           rdfs:range ontoksd:CompetenceDetail ;
                           rdfs:comment "Specifies the required competence for a role."@en .


###  http://www.semanticweb.org/ontoksd#requiresCompetenceElement
ontoksd:requiresCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:LearningRole ;
                                  rdfs:range ontoksd:CompetenceElementDetail ;
                                  rdfs:comment "Defines a competency needed to fulfill the role."@en .


###  http://www.semanticweb.org/ontoksd#requiresKnowledge
ontoksd:requiresKnowledge rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Skill ;
                          rdfs:range ontoksd:Knowledge ;
                          rdfs:comment "Indicates that a Skill requires certain Knowledge."@en ;
                          rdfs:label "requires knowledge"@en .


###  http://www.semanticweb.org/ontoksd#suggestsCompetence
ontoksd:suggestsCompetence rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:LearningRole ;
                           rdfs:range ontoksd:CompetenceDetail ;
                           rdfs:comment "Suggests a competence as beneficial for the role."@en .


###  http://www.semanticweb.org/ontoksd#suggestsCompetenceElement
ontoksd:suggestsCompetenceElement rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:LearningRole ;
                                  rdfs:range ontoksd:CompetenceElementDetail ;
                                  rdfs:comment "Recommends a competency as helpful for the role."@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/Assessment
www.semanticweb.org:Assessment rdf:type owl:Class ;
                               rdfs:subClassOf ontoksd:InstructionalEntity .


###  http://www.semanticweb.org/LearningTask
www.semanticweb.org:LearningTask rdf:type owl:Class ;
                                 rdfs:subClassOf ontoksd:LearningActivity .


###  http://www.semanticweb.org/ontoksd#AcquisitionContext
ontoksd:AcquisitionContext rdf:type owl:Class ;
                           rdfs:subClassOf ontoksd:Context .


###  http://www.semanticweb.org/ontoksd#Agency
ontoksd:Agency rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#AgencyType
ontoksd:AgencyType rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#Attitude
ontoksd:Attitude rdf:type owl:Class ;
                 rdfs:subClassOf ontoksd:Disposition ;
                 rdfs:comment "A context-specific disposition reflecting a favorable or unfavorable mental state toward an object, person, or situation."@en ;
                 rdfs:label "Attitude"@en .


###  http://www.semanticweb.org/ontoksd#AttitudeType
ontoksd:AttitudeType rdf:type owl:Class ;
                     rdfs:subClassOf ontoksd:DispositionType .


###  http://www.semanticweb.org/ontoksd#Certificate
ontoksd:Certificate rdf:type owl:Class ;
                    rdfs:subClassOf ontoksd:Document ;
                    owl:disjointWith ontoksd:Validation ;
                    rdfs:comment "A document confirming the successful completion of an educational or competence process."@en ;
                    rdfs:label "Certificate"@en .


###  http://www.semanticweb.org/ontoksd#Classification
ontoksd:Classification rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#Competence
ontoksd:Competence rdf:type owl:Class ;
                   rdfs:comment """The ability of an actor to do actions for a situation in an effective and efficient way; it cannot be directly measurable, but estimated from the performance (Miranda et al, 2017)

A broader construct combining multiple personal features (knowledge, skill and dispositions) that someone may have or need to do a task in a specific context and scale.

Different people may have the same competence but different context and evidences for it."""@en ;
                   rdfs:label "Competence"@en .


###  http://www.semanticweb.org/ontoksd#CompetenceDetail
ontoksd:CompetenceDetail rdf:type owl:Class ;
                         rdfs:comment "A detailed representation of a competence with its context and level."@en .


###  http://www.semanticweb.org/ontoksd#CompetenceElementDetail
ontoksd:CompetenceElementDetail rdf:type owl:Class ;
                                rdfs:comment "Detailed specification of a competence element, including context and assessment."@en .


###  http://www.semanticweb.org/ontoksd#CompetenceType
ontoksd:CompetenceType rdf:type owl:Class ;
                       rdfs:comment "Categoria funcional ou pedagógica da competência (e.g., cognitive, technical, interpersonal)" .


###  http://www.semanticweb.org/ontoksd#Competency
ontoksd:Competency rdf:type owl:Class ;
                   <http://purl.org/dc/elements/1.1/description> "Competence elements correspond to personal characteristics that constitute the underlying structure of a competence, as described by Miranda et al. (2018)."@en ;
                   dcterms:bibliographicCitation "Cited as Competency in Miranda, S. et al. (2018). An Ontology-Based Model for Competence Management. Journal of Intelligent Manufacturing."@en ;
                   rdfs:comment "An observable or measurable part of the competence like a skill, a piece of knowledge or an attitude. (Miranda et al, 2017)"@en ;
                   rdfs:label "CompetenceElement"@en .


###  http://www.semanticweb.org/ontoksd#Context
ontoksd:Context rdf:type owl:Class ;
                rdfs:comment """The environment or situation in which a competence or a competence element is demonstrated.

Context where the person may apply her competences; the context may refer to a work area or a typical situation"""@en ;
                rdfs:label "Context"@en .


###  http://www.semanticweb.org/ontoksd#Disposition
ontoksd:Disposition rdf:type owl:Class ;
                    rdfs:subClassOf ontoksd:Competency ;
                    rdfs:comment """A habitual tendency or inclination of an individual to behave or respond in a particular way, influencing how knowledge and skills are applied in context.

As disposições englobam traços socioemocionais, comportamentos e atitudes que influenciam a inclinação do indivíduo em realizar tarefas e saber quando e como fazê-lo."""@en .


###  http://www.semanticweb.org/ontoksd#DispositionType
ontoksd:DispositionType rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#Document
ontoksd:Document rdf:type owl:Class ;
                 rdfs:comment "A record that may certify competences, competencies, or education."@en ;
                 rdfs:label "Document"@en .


###  http://www.semanticweb.org/ontoksd#DocumentDetail
ontoksd:DocumentDetail rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#EducationalResource
ontoksd:EducationalResource rdf:type owl:Class ;
                            rdfs:subClassOf ontoksd:InstructionalEntity .


###  http://www.semanticweb.org/ontoksd#Evidence
ontoksd:Evidence rdf:type owl:Class ;
                 rdfs:comment "Artifacts or observations that support the assessment of competencies or competences."@en ;
                 rdfs:label "Evidence"@en .


###  http://www.semanticweb.org/ontoksd#EvidenceType
ontoksd:EvidenceType rdf:type owl:Class ;
                     dcterms:bibliographicCitation """Depending on the way they are collected, the evidences may be of different type 

(EvidenceType): self-assessment, observation or instructional evidence. 
SelfAssessment, PeerAssessment, TeacherAssessment, ProjectArtifact, PerformanceObservation, WrittenExam, Presentation, PortfolioEvidence.

Moreover, they arise from a motivation."""@en .


###  http://www.semanticweb.org/ontoksd#FormativeCredit
ontoksd:FormativeCredit rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#InstructionalEntity
ontoksd:InstructionalEntity rdf:type owl:Class ;
                            rdfs:comment """Representa a entidade concreta (atividade, tarefa, recurso, avaliação etc.) que pode gerar evidência de competência.

Representa um componente-chave para conectar a ontologia de competências ao domínio educacional. 
Serve como ponto de articulação entre competências (estáticas e dinâmicas) e os artefatos instrucionais que suportam sua aquisição ou validação.

Definição:
Uma InstructionalEntity é qualquer objeto, atividade ou unidade educacional projetada com o propósito de ensinar, reforçar ou avaliar uma ou mais competências.

Exemplos:
Cursos, módulos, treinamentos presenciais ou online (Course, Module)
Avaliações, projetos, simuladores (Assessment, Scenario)
Recursos educacionais digitais (LearningObject, ContentItem)

Ela é uma abstração, podendo ser especializada conforme o domínio (educação formal, corporativa, informal etc.)."""@en .


###  http://www.semanticweb.org/ontoksd#Knowledge
ontoksd:Knowledge rdf:type owl:Class ;
                  rdfs:subClassOf ontoksd:Competency ;
                  rdfs:comment """Theoretical or practical understanding of a subject, modeled as a type of Competence Element.
Representa uma instância de conhecimento necessário para uma competência."""@en ;
                  rdfs:label "Knowledge"@en .


###  http://www.semanticweb.org/ontoksd#KnowledgeSkill
ontoksd:KnowledgeSkill rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#KnowledgeType
ontoksd:KnowledgeType rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#LearningActivity
ontoksd:LearningActivity rdf:type owl:Class ;
                         rdfs:subClassOf ontoksd:InstructionalEntity .


###  http://www.semanticweb.org/ontoksd#LearningNeed
ontoksd:LearningNeed rdf:type owl:Class ;
                     rdfs:comment "A gap between current and desired competence levels requiring educational intervention."@en .


###  http://www.semanticweb.org/ontoksd#LearningRole
ontoksd:LearningRole rdf:type owl:Class ;
                     rdfs:comment """A professional or organizational function that requires specific competences.

A LearningRole representa um papel desempenhado pelo aluno em uma atividade educacional ou disciplina, como \"desenvolvedor de projeto\", \"líder de grupo\", \"relator\", \"aluno pesquisador\", etc. Esses papéis estão associados a competências esperadas e são usados para contextualizar a avaliação de desempenho.

Representa o papel educacional assumido por um aluno em uma disciplina, curso ou atividade (ex: \"aluno de algoritmos\", \"líder de grupo\", \"monitor\").
Pode ser usado para definir competências requeridas e sugeridas por esse papel — útil para tarefas, disciplinas ou perfis curriculares."""@en .


###  http://www.semanticweb.org/ontoksd#PersonModel
ontoksd:PersonModel rdf:type owl:Class ;
                    rdfs:comment """A representation of an individual's competences, learning, education, and roles.

Representa o perfil educacional do aluno: competências evidenciadas, papéis, evidências, lacunas, etc.
É a entidade central da visão educacional — é a partir dela que se derivam análises como “lacuna de competência”, “progresso”, “evidências” etc."""@en .


###  http://www.semanticweb.org/ontoksd#ProficiencyLevel
ontoksd:ProficiencyLevel rdf:type owl:Class ;
                         rdfs:comment """A classification indicating the depth or complexity of a Competence or Competence Element.

(Proficiency Level) is a set of levels for classifying competences in doing actions."""@en .


###  http://www.semanticweb.org/ontoksd#RCD
ontoksd:RCD rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#Responsibility
ontoksd:Responsibility rdf:type owl:Class ;
                       rdfs:comment "A duty associated with a role that may require specific competences or competencies."@en ;
                       rdfs:label "Responsibility"@en .


###  http://www.semanticweb.org/ontoksd#RoleDetail
ontoksd:RoleDetail rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#Scale
ontoksd:Scale rdf:type owl:Class ;
              rdfs:comment "The measurement scale used to assess competence or competency levels."@en ;
              rdfs:label "Scale"@en .


###  http://www.semanticweb.org/ontoksd#Skill
ontoksd:Skill rdf:type owl:Class ;
              rdfs:subClassOf ontoksd:Competency ;
              rdfs:comment "A learned ability to perform tasks, considered a subtype of Competency."@en ;
              rdfs:label "Skill"@en .


###  http://www.semanticweb.org/ontoksd#SkillType
ontoksd:SkillType rdf:type owl:Class .


###  http://www.semanticweb.org/ontoksd#StructureType
ontoksd:StructureType rdf:type owl:Class ;
                      rdfs:comment "Forma como a competência está estruturalmente organizada (e.g., atomic, pair-based, composite)" .


###  http://www.semanticweb.org/ontoksd#Validation
ontoksd:Validation rdf:type owl:Class ;
                   rdfs:subClassOf ontoksd:Document ;
                   rdfs:comment "A type of document certifying the achievement or recognition of a competence."@en ;
                   rdfs:label "Validation"@en .


