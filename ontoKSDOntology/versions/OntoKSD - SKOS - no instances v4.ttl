@prefix : <http://purl.org/ontoksd#> .
@prefix dc: <http://purl.org/dc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rcd: <http://purl.org/ontoksd/rcd#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontoksd: <http://purl.org/ontoksd#> .
@base <http://purl.org/ontoksd#> .

<http://purl.org/ontoksd#> rdf:type owl:Ontology ;
                            owl:versionIRI <http://purl.org/ontoksd#1.1.0> ;
                            owl:imports <http://purl.org/edu/bloom> ,
                                        <http://purl.org/nemo/gufo#/1.0.0> ,
                                        <http://purl.org/ontoksd/rcd> ,
                                        <http://www.w3.org/2004/02/skos/core.rdf> ;
                            rdfs:comment "Ontology for Knowledge, Skill, and Disposition representation."@en ;
                            rdfs:label "OntoKSD Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .


###  http://purl.org/ontoksd#hasSuggestedVerb
ontoksd:hasSuggestedVerb rdf:type owl:AnnotationProperty ;
                         rdfs:comment "Propriedade leve para anotar semanticamente uma KnowledgeSkill, informando verbos acidionais, mas sem alterar a estrutura ontológica." ;
                         rdfs:domain ontoksd:KnowledgeSkill .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/nemo/gufo#hasReifiedQualityValue
<http://purl.org/nemo/gufo#hasReifiedQualityValue> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#inheresIn
<http://purl.org/nemo/gufo#inheresIn> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#isComponentOf
<http://purl.org/nemo/gufo#isComponentOf> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#mediates
<http://purl.org/nemo/gufo#mediates> rdf:type owl:ObjectProperty .


###  http://purl.org/ontoksd#aggregatesEvidence
ontoksd:aggregatesEvidence rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Document ;
                           rdfs:range ontoksd:Evidence .


###  http://purl.org/ontoksd#alignedWith
ontoksd:alignedWith rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Competence ;
                    rdfs:range ontoksd:ExternalCompetence .


###  http://purl.org/ontoksd#alignsWithPerformanceClass
ontoksd:alignsWithPerformanceClass rdf:type owl:ObjectProperty ;
                                   rdfs:domain ontoksd:ProficiencyValue ;
                                   rdfs:range skos:Concept .


###  http://purl.org/ontoksd#aplliesTo
ontoksd:aplliesTo rdf:type owl:ObjectProperty ;
                  rdfs:domain ontoksd:Profile ;
                  rdfs:range ontoksd:Learner ;
                  rdfs:comment "Specifies the role a person is applying for."@en .


###  http://purl.org/ontoksd#appliesKnowledge
ontoksd:appliesKnowledge rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Skill ;
                         rdfs:range ontoksd:Knowledge ;
                         rdfs:comment "Indicates that a Skill requires certain Knowledge."@en .


###  http://purl.org/ontoksd#assignedTo
ontoksd:assignedTo rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                   rdfs:domain ontoksd:ProficiencyLevel ;
                   rdfs:range ontoksd:EvidencedCompetenceElement .


###  http://purl.org/ontoksd#assignedToElement
ontoksd:assignedToElement rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                          rdfs:domain ontoksd:ProficiencyLevel ;
                          rdfs:range ontoksd:EvidencedCompetence .


###  http://purl.org/ontoksd#determinesPerformanceClass
ontoksd:determinesPerformanceClass rdf:type owl:ObjectProperty ;
                                   rdfs:domain ontoksd:ProficiencyLevel ;
                                   rdfs:range skos:Concept ;
                                   rdfs:comment "Maps a ProficiencyLevel to a performance class concept within the collection of its Scale.\""@en .


###  http://purl.org/ontoksd#evidenceBasedOn
ontoksd:evidenceBasedOn rdf:type owl:ObjectProperty ;
                        owl:inverseOf ontoksd:producesEvidence ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range [ rdf:type owl:Class ;
                                     owl:unionOf ( ontoksd:AssessmentOcurrence
                                                   ontoksd:InstructionalEntity
                                                 )
                                   ] ;
                        rdfs:comment "Links the evidence to the Instructional Entity it is derived from."@en .


###  http://purl.org/ontoksd#evidencesCompetence
ontoksd:evidencesCompetence rdf:type owl:ObjectProperty ;
                            owl:inverseOf ontoksd:supportedByEvidence ;
                            rdfs:domain ontoksd:Evidence ;
                            rdfs:range [ rdf:type owl:Class ;
                                         owl:unionOf ( ontoksd:EvidencedCompetence
                                                       ontoksd:EvidencedCompetenceElement
                                                     )
                                       ] ;
                            rdfs:comment "Specifies the Competence being evidenced by a given evidence."@en .


###  http://purl.org/ontoksd#expectsEvidenceType
ontoksd:expectsEvidenceType rdf:type owl:ObjectProperty ;
                            rdfs:domain ontoksd:CompetenceRelator ;
                            rdfs:range ontoksd:EvidenceType .


###  http://purl.org/ontoksd#hasAcquisitionContext
ontoksd:hasAcquisitionContext rdf:type owl:ObjectProperty ;
                              owl:inverseOf ontoksd:isAcquisitionContextOf ;
                              rdfs:domain ontoksd:InstructionalEntity ;
                              rdfs:range ontoksd:AcquisitionContext ;
                              rdfs:comment "Indicates the context (course offering, session, institution, etc.) in which the instructional entity is executed and competence evidence may be observed."@en .


###  http://purl.org/ontoksd#hasActivationConstraint
ontoksd:hasActivationConstraint rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf ontoksd:hasActivationQualifier ;
                                rdfs:domain ontoksd:CompetenceRelator ;
                                rdfs:range ontoksd:ActivationConstraint .


###  http://purl.org/ontoksd#hasActivationFunction
ontoksd:hasActivationFunction rdf:type owl:ObjectProperty ;
                              rdfs:domain ontoksd:CompetenceRelator ;
                              rdfs:range ontoksd:ActivationFunction .


###  http://purl.org/ontoksd#hasActivationMode
ontoksd:hasActivationMode rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ontoksd:hasActivationQualifier ;
                          rdfs:domain ontoksd:CompetenceRelator ;
                          rdfs:range ontoksd:ActivationMode .


###  http://purl.org/ontoksd#hasActivationQualifier
ontoksd:hasActivationQualifier rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf owl:topObjectProperty ;
                               rdfs:domain ontoksd:CompetenceRelator ;
                               rdfs:range ontoksd:ActivationQualifier .


###  http://purl.org/ontoksd#hasActivationRole
ontoksd:hasActivationRole rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ontoksd:hasActivationQualifier ;
                          rdfs:domain ontoksd:CompetenceRelator ;
                          rdfs:range ontoksd:ActivationRole .


###  http://purl.org/ontoksd#hasArtifact
ontoksd:hasArtifact rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:InstructionalEntity ;
                    rdfs:range ontoksd:Artifact .


###  http://purl.org/ontoksd#hasAssessment
ontoksd:hasAssessment rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                      owl:inverseOf ontoksd:involvesAssessmentRelator ;
                      rdfs:domain ontoksd:AssessmentRelator ;
                      rdfs:range ontoksd:AssessmentOcurrence .


###  http://purl.org/ontoksd#hasAssessmentType
ontoksd:hasAssessmentType rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Assessment ;
                          rdfs:range ontoksd:AssessmentType .


###  http://purl.org/ontoksd#hasAssessor
ontoksd:hasAssessor rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                    rdfs:domain ontoksd:AssessmentRelator ;
                    rdfs:range ontoksd:Assessor .


###  http://purl.org/ontoksd#hasAttitude
ontoksd:hasAttitude rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ontoksd:hasDisposition ;
                    owl:inverseOf ontoksd:isAttitudeOf ;
                    rdfs:domain ontoksd:Competence ;
                    rdfs:range ontoksd:Attitude .


###  http://purl.org/ontoksd#hasBloomLevel
ontoksd:hasBloomLevel rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ontoksd:hasSkillComponent ;
                      rdfs:domain ontoksd:KnowledgeSkill ;
                      rdfs:range <http://purl.org/edu/bloom#CognitiveProcessLevel> .


###  http://purl.org/ontoksd#hasBloomLevelJustificationVerb
ontoksd:hasBloomLevelJustificationVerb rdf:type owl:ObjectProperty ;
                                       rdfs:domain ontoksd:KnowledgeSkill ;
                                       rdfs:range <http://purl.org/edu/bloom#ActionVerb> .


###  http://purl.org/ontoksd#hasCS2023SkillLevel
ontoksd:hasCS2023SkillLevel rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf ontoksd:hasSkillLevel ;
                            rdfs:domain ontoksd:Skill ;
                            rdfs:range <http://purl.org/edu/cs2023#CS2023SkillLevel> .


###  http://purl.org/ontoksd#hasCognitiveLevel
ontoksd:hasCognitiveLevel rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ontoksd:hasSkillLevel ;
                          rdfs:domain ontoksd:Skill ;
                          rdfs:range <http://purl.org/edu/bloom#CognitiveProcessLevel> .


###  http://purl.org/ontoksd#hasCompetenceElement
ontoksd:hasCompetenceElement rdf:type owl:ObjectProperty ;
                             owl:inverseOf ontoksd:isCompetenceElementOf ;
                             rdfs:domain ontoksd:Competence ;
                             rdfs:range ontoksd:CompetenceElement ;
                             rdfs:comment "As propriedades hasSkill, hasKnowledge e hasAttitude foram criadas como subpropriedades de hasCompetenceElement."@en ,
                                          "Indicates the competency detail of a person."@en .


###  http://purl.org/ontoksd#hasCompetenceRelator
ontoksd:hasCompetenceRelator rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf owl:topObjectProperty ;
                             rdfs:domain ontoksd:InstructionalEntity ;
                             rdfs:range ontoksd:CompetenceRelator ;
                             rdfs:comment "Shortcut property linking an instructional entity to a CompetenceAssociation that specifies its target or prerequisite competencies."@en ;
                             rdfs:label "hasCompetenceActivation" .


###  http://purl.org/ontoksd#hasCompetenceRelatorType
ontoksd:hasCompetenceRelatorType rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdfs:domain ontoksd:CompetenceRelator .


###  http://purl.org/ontoksd#hasCompetenceScope
ontoksd:hasCompetenceScope rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:CompetenceScope ;
                           rdfs:comment "Specifies whether a competence is educational, profissional, or another type."@en .


###  http://purl.org/ontoksd#hasComponent
ontoksd:hasComponent rdf:type owl:ObjectProperty ;
                     owl:inverseOf ontoksd:isCompetenceOf ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Competence ;
                     rdfs:comment """Indicates a compositional relationship, where a meta-competence (composite competence) is composed of several component competencies. The meta-competence is considered fully demonstrated only if all of its components are evidenced.

Use case: Supports logical aggregation and progressive demonstration of more general abilities."""@en .


###  http://purl.org/ontoksd#hasContext
ontoksd:hasContext rdf:type owl:ObjectProperty ;
                   owl:inverseOf ontoksd:providesContextFor ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( ontoksd:Competence
                                               ontoksd:CompetenceElement
                                               ontoksd:Evidence
                                               ontoksd:EvidencedCompetence
                                               ontoksd:EvidencedCompetenceElement
                                             )
                               ] ;
                   rdfs:range ontoksd:Context ;
                   rdfs:comment "Context in which the Competency is expressed or observed."@en .


###  http://purl.org/ontoksd#hasDisposition
ontoksd:hasDisposition rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                       owl:inverseOf ontoksd:isDispositionOf ;
                       rdfs:domain ontoksd:Competence ;
                       rdfs:range ontoksd:Disposition .


###  http://purl.org/ontoksd#hasDispositionCategory
ontoksd:hasDispositionCategory rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:Disposition ;
                               rdfs:range ontoksd:DispositionCategory .


###  http://purl.org/ontoksd#hasDocumentDetail
ontoksd:hasDocumentDetail rdf:type owl:ObjectProperty ;
                          owl:inverseOf ontoksd:refersToDocument ;
                          rdfs:domain ontoksd:Document ;
                          rdfs:range ontoksd:DocumentDetail .


###  http://purl.org/ontoksd#hasEvidence
ontoksd:hasEvidence rdf:type owl:ObjectProperty ;
                    owl:inverseOf ontoksd:isObservedBy ;
                    rdfs:domain ontoksd:Profile ;
                    rdfs:range ontoksd:Evidence ;
                    rdfs:comment "Indicates the evidence collected for the person."@en .


###  http://purl.org/ontoksd#hasEvidenceType
ontoksd:hasEvidenceType rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:Evidence ;
                        rdfs:range ontoksd:EvidenceType ;
                        rdfs:comment "Defines the classification of the evidence."@en .


###  http://purl.org/ontoksd#hasEvidencedCompetence
ontoksd:hasEvidencedCompetence rdf:type owl:ObjectProperty ;
                               owl:inverseOf ontoksd:isEvidencedCompetenceOf ;
                               rdfs:domain ontoksd:Profile ;
                               rdfs:range ontoksd:EvidencedCompetence ;
                               rdfs:comment "Indicates the competence detail of a person."@en .


###  http://purl.org/ontoksd#hasFormativeCredit
ontoksd:hasFormativeCredit rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:DocumentDetail ;
                           rdfs:range ontoksd:FormativeCredit ;
                           rdfs:comment "Specifies the credit gained from a document detail."@en .


###  http://purl.org/ontoksd#hasInstructionalEntity
ontoksd:hasInstructionalEntity rdf:type owl:ObjectProperty ;
                               rdfs:domain [ rdf:type owl:Class ;
                                             owl:unionOf ( ontoksd:Assessment
                                                           ontoksd:Course
                                                         )
                                           ] ;
                               rdfs:range ontoksd:InstructionalEntity .


###  http://purl.org/ontoksd#hasInterval
ontoksd:hasInterval rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Scale ;
                    rdfs:range ontoksd:Interval .


###  http://purl.org/ontoksd#hasKnowledge
ontoksd:hasKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                     owl:inverseOf ontoksd:isKnowledgeOf ;
                     rdfs:domain ontoksd:Competence ;
                     rdfs:range ontoksd:Knowledge .


###  http://purl.org/ontoksd#hasKnowledgeComponent
ontoksd:hasKnowledgeComponent rdf:type owl:ObjectProperty ;
                              rdfs:domain ontoksd:KnowledgeSkill ;
                              rdfs:range ontoksd:Knowledge ;
                              rdfs:comment "Associates a KnowledgeSkill with the knowledge component involved."@en .


###  http://purl.org/ontoksd#hasKnowledgeSkill
ontoksd:hasKnowledgeSkill rdf:type owl:ObjectProperty ;
                          owl:inverseOf ontoksd:isKnowledgeSkillOf ;
                          rdfs:domain ontoksd:Competence ;
                          rdfs:range ontoksd:KnowledgeSkill .


###  http://purl.org/ontoksd#hasKnowledgeType
ontoksd:hasKnowledgeType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Knowledge ;
                         rdfs:range ontoksd:KnowledgeType ;
                         rdfs:comment "Relates a Knowledge to its specific knowledge type."@en .


###  http://purl.org/ontoksd#hasLearner
ontoksd:hasLearner rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                   rdfs:domain ontoksd:AssessmentRelator ;
                   rdfs:range ontoksd:Learner .


###  http://purl.org/ontoksd#hasLearningNeed
ontoksd:hasLearningNeed rdf:type owl:ObjectProperty ;
                        owl:inverseOf ontoksd:identifiedIn ;
                        rdfs:domain ontoksd:Profile ;
                        rdfs:range ontoksd:LearningNeed ;
                        rdfs:comment "Lists the learning needs of a person."@en .


###  http://purl.org/ontoksd#hasLevel
ontoksd:hasLevel rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( ontoksd:Evidence
                                             ontoksd:EvidencedCompetence
                                             ontoksd:EvidencedCompetenceElement
                                           )
                             ] .


###  http://purl.org/ontoksd#hasPerformanceClass
ontoksd:hasPerformanceClass rdf:type owl:ObjectProperty ;
                            rdfs:domain ontoksd:EvidencedCompetence ;
                            rdfs:range skos:Concept ;
                            rdfs:comment "Can be inferred from hasProficiencyLevel ∘ determinesPerformanceClass.\""@en .


###  http://purl.org/ontoksd#hasPerformanceClassCollection
ontoksd:hasPerformanceClassCollection rdf:type owl:ObjectProperty ;
                                      rdfs:domain ontoksd:Scale ;
                                      rdfs:range ontoksd:PerformanceClassScheme .


###  http://purl.org/ontoksd#hasPerformedRole
ontoksd:hasPerformedRole rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Profile ;
                         rdfs:range ontoksd:RoleDetail ;
                         rdfs:comment "Indicates the role detail already performed by a person."@en .


###  http://purl.org/ontoksd#hasProfile
ontoksd:hasProfile rdf:type owl:ObjectProperty ;
                   owl:inverseOf ontoksd:isProfileOf ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain ontoksd:Person ;
                   rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#hasProfileCompetenceElement
ontoksd:hasProfileCompetenceElement rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf owl:topObjectProperty ;
                                    rdfs:domain ontoksd:Profile ;
                                    rdfs:range ontoksd:EvidencedCompetenceElement .


###  http://purl.org/ontoksd#hasRCD
ontoksd:hasRCD rdf:type owl:ObjectProperty ;
               owl:inverseOf ontoksd:representsCompetence ;
               rdfs:domain ontoksd:Competence ;
               rdfs:range rcd:RCD .


###  http://purl.org/ontoksd#hasReliabilityLevel
ontoksd:hasReliabilityLevel rdf:type owl:ObjectProperty ;
                            rdfs:domain ontoksd:Evidence ;
                            rdfs:range ontoksd:ReliabilityLevel .


###  http://purl.org/ontoksd#hasResourceType
ontoksd:hasResourceType rdf:type owl:ObjectProperty ;
                        rdfs:domain ontoksd:EducationalResource ;
                        rdfs:range ontoksd:ResourceType .


###  http://purl.org/ontoksd#hasScale
ontoksd:hasScale rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( ontoksd:Competence
                                             ontoksd:CompetenceElement
                                           )
                             ] ;
                 rdfs:range ontoksd:Scale ;
                 rdfs:comment "Specifies the measurement scale for a Competency."@en .


###  http://purl.org/ontoksd#hasSkill
ontoksd:hasSkill rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf ontoksd:hasCompetenceElement ;
                 owl:inverseOf ontoksd:isSkillOf ;
                 rdfs:domain ontoksd:Competence ;
                 rdfs:range ontoksd:Skill ;
                 rdfs:comment "Indicates a skill that composes the competence."@en .


###  http://purl.org/ontoksd#hasSkillComponent
ontoksd:hasSkillComponent rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain ontoksd:KnowledgeSkill ;
                          rdfs:range ontoksd:Skill ;
                          rdfs:comment "Associates a KnowledgeSkill with the skill component that operates on the knowledge."@en .


###  http://purl.org/ontoksd#hasSkillDimension
ontoksd:hasSkillDimension rdf:type owl:ObjectProperty ;
                          rdfs:domain ontoksd:Skill ;
                          rdfs:range ontoksd:SkillDimension ;
                          rdfs:comment """hasSkillDimension
Relates a Skill element to a SkillDimension that classifies the primary dimension under which that skill is characterized within a competency specification.

This property is used to support the explicit semantic classification of skill elements in OntoKSD, enabling skills to be distinguished according to their predominant cognitive, technical, or interpersonal dimension.

Domain: Skill
Range: SkillDimension"""@en .


###  http://purl.org/ontoksd#hasSkillLevel
ontoksd:hasSkillLevel rdf:type owl:ObjectProperty ;
                      rdfs:domain ontoksd:Skill ;
                      rdfs:range <http://purl.org/edu/bloom#SkillLevel> .


###  http://purl.org/ontoksd#hasStructureType
ontoksd:hasStructureType rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:Competence ;
                         rdfs:range ontoksd:StructureType ;
                         rdfs:comment """This property is used to indicate whether a competence is modeled as an atomic competence or as a composite competence. 

Through hasStructureType, OntoKSD can distinguish competencies that are represented as indivisible units from those that are explicitly composed of component competencies."""@en .


###  http://purl.org/ontoksd#hasSupportDocument
ontoksd:hasSupportDocument rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Evidence ;
                           rdfs:range ontoksd:Document ;
                           rdfs:comment "Evidence can be supported by a Document"@en .


###  http://purl.org/ontoksd#hasSyllabus
ontoksd:hasSyllabus rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain ontoksd:Course ;
                    rdfs:range ontoksd:Artifact ;
                    rdfs:comment "The property hasSyllabus links a Course to a DigitalArtifact representing its official syllabus. The syllabus contains structured information such as objectives, competencies, topics, evaluation methods, and references. This property is functional, ensuring that a course cannot be associated with more than one syllabus simultaneously."@en ;
                    skos:example """If a course has a syllabus, it should be instantiated as a DigitalArtifact and connected via hasSyllabus.

Examples of digital artifacts include:

- Markdown or PDF syllabus files

- URLs linking to institutional repositories

- Structured syllabus metadata in digital repositories

A course without a syllabus remains valid in the ontology, supporting lifecycle states (e.g., planned or provisional courses)."""@en .


###  http://purl.org/ontoksd#hasValue
ontoksd:hasValue rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasReifiedQualityValue> ;
                 rdfs:domain ontoksd:ProficiencyLevel ;
                 rdfs:range ontoksd:ProficiencyValue .


###  http://purl.org/ontoksd#identifiedIn
ontoksd:identifiedIn rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:LearningNeed ;
                     rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#includesProficiencyLevel
ontoksd:includesProficiencyLevel rdf:type owl:ObjectProperty ;
                                 owl:inverseOf ontoksd:selectedIn ;
                                 rdfs:domain ontoksd:Scale ;
                                 rdfs:range ontoksd:ProficiencyLevel .


###  http://purl.org/ontoksd#involvesAssessmentRelator
ontoksd:involvesAssessmentRelator rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontoksd:AssessmentOcurrence ;
                                  rdfs:range ontoksd:AssessmentRelator .


###  http://purl.org/ontoksd#isAcquisitionContextOf
ontoksd:isAcquisitionContextOf rdf:type owl:ObjectProperty ;
                               rdfs:domain ontoksd:AcquisitionContext ;
                               rdfs:range ontoksd:InstructionalEntity .


###  http://purl.org/ontoksd#isAttitudeOf
ontoksd:isAttitudeOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ontoksd:isDispositionOf ;
                     rdfs:domain ontoksd:Attitude ;
                     rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isCompetenceElementOf
ontoksd:isCompetenceElementOf rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                              rdfs:domain ontoksd:CompetenceElement ;
                              rdfs:range ontoksd:Competence ;
                              rdfs:comment "Indicates that a Competency is mandatory for a given Competence."@en .


###  http://purl.org/ontoksd#isCompetenceOf
ontoksd:isCompetenceOf rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                       rdfs:domain ontoksd:Competence ;
                       rdfs:range ontoksd:Competence ;
                       rdfs:comment "Competences may be an aggregation of other competences" .


###  http://purl.org/ontoksd#isDispositionOf
ontoksd:isDispositionOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf ontoksd:isCompetenceElementOf ;
                        rdfs:domain ontoksd:Disposition ;
                        rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isElementEvidencedBy
ontoksd:isElementEvidencedBy rdf:type owl:ObjectProperty ;
                             owl:inverseOf ontoksd:refersToCompetenceElement ;
                             rdfs:domain ontoksd:CompetenceElement ;
                             rdfs:range ontoksd:EvidencedCompetenceElement .


###  http://purl.org/ontoksd#isEvidencedBy
ontoksd:isEvidencedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf ontoksd:refersToCompetence ;
                      rdfs:domain ontoksd:Competence ;
                      rdfs:range ontoksd:EvidencedCompetence .


###  http://purl.org/ontoksd#isEvidencedCompetenceOf
ontoksd:isEvidencedCompetenceOf rdf:type owl:ObjectProperty ;
                                rdfs:domain ontoksd:EvidencedCompetence ;
                                rdfs:range ontoksd:Profile .


###  http://purl.org/ontoksd#isKnowledgeOf
ontoksd:isKnowledgeOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ontoksd:isCompetenceElementOf ;
                      rdfs:domain ontoksd:Knowledge ;
                      rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isKnowledgeSkillOf
ontoksd:isKnowledgeSkillOf rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                           rdfs:domain ontoksd:KnowledgeSkill ;
                           rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isObservedBy
ontoksd:isObservedBy rdf:type owl:ObjectProperty ;
                     rdfs:domain ontoksd:Evidence ;
                     rdfs:range ontoksd:Profile ;
                     rdfs:comment "Specifies the Profile who observed the evidence."@en .


###  http://purl.org/ontoksd#isProfileOf
ontoksd:isProfileOf rdf:type owl:ObjectProperty ;
                    rdfs:domain ontoksd:Profile ;
                    rdfs:range ontoksd:Person .


###  http://purl.org/ontoksd#isRealizedBy
ontoksd:isRealizedBy rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     owl:inverseOf ontoksd:realizes ;
                     rdfs:domain ontoksd:Assessment ;
                     rdfs:range ontoksd:AssessmentOcurrence .


###  http://purl.org/ontoksd#isSkillOf
ontoksd:isSkillOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ontoksd:isCompetenceElementOf ;
                  rdfs:domain ontoksd:Skill ;
                  rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#isSpecializationOf
ontoksd:isSpecializationOf rdf:type owl:ObjectProperty ;
                           owl:inverseOf ontoksd:specializes ;
                           rdfs:domain ontoksd:Competence ;
                           rdfs:range ontoksd:Competence .


###  http://purl.org/ontoksd#mapsTo
ontoksd:mapsTo rdf:type owl:ObjectProperty ;
               rdfs:domain ontoksd:Interval ;
               rdfs:range ontoksd:ProficiencyValue .


###  http://purl.org/ontoksd#mediatesCompetence
ontoksd:mediatesCompetence rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                           rdfs:domain ontoksd:CompetenceRelator ;
                           rdfs:range ontoksd:Competence ;
                           rdfs:comment """A relation between an InstructionalEntity and a Competence indicating that the competence is a prerequisite for meaningful engagement or successful completion of the instructional activity.
This property specifies that certain competences must already be possessed or evidenced before participation in the InstructionalEntity.

Intended semantics: If an InstructionalEntity requires a competence, learners without that competence may struggle to engage fully with the activity or achieve its intended outcomes.

Examples:

An “Advanced Machine Learning” course requiring competence in “Linear Algebra” and “Programming in Python”.

A “Capstone Project” requiring “Research Methodology” competence.

A “Professional Ethics Seminar” requiring “Critical Reading and Writing” competence.

Ontological notes:

requiresCompetence enables curriculum sequencing and prerequisite mapping in both formal and informal learning contexts.

This property supports curriculum traceability by clarifying the dependency structure between competences.""" .


###  http://purl.org/ontoksd#mediatesInstructionalEntity
ontoksd:mediatesInstructionalEntity rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                                    rdfs:domain ontoksd:CompetenceRelator ;
                                    rdfs:range ontoksd:InstructionalEntity .


###  http://purl.org/ontoksd#producesEvidence
ontoksd:producesEvidence rdf:type owl:ObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( ontoksd:AssessmentOcurrence
                                                     ontoksd:InstructionalEntity
                                                   )
                                     ] ;
                         rdfs:range ontoksd:Evidence .


###  http://purl.org/ontoksd#producesResource
ontoksd:producesResource rdf:type owl:ObjectProperty ;
                         rdfs:domain ontoksd:InstructionalEntity ;
                         rdfs:range ontoksd:EducationalResource .


###  http://purl.org/ontoksd#proficiencyOfEvidence
ontoksd:proficiencyOfEvidence rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf <http://purl.org/nemo/gufo#inheresIn> ;
                              rdfs:domain ontoksd:ProficiencyLevel ;
                              rdfs:range ontoksd:Evidence .


###  http://purl.org/ontoksd#providesContextFor
ontoksd:providesContextFor rdf:type owl:ObjectProperty ;
                           rdfs:domain ontoksd:Context ;
                           rdfs:range [ rdf:type owl:Class ;
                                        owl:unionOf ( ontoksd:Competence
                                                      ontoksd:CompetenceElement
                                                      ontoksd:Evidence
                                                      ontoksd:EvidencedCompetence
                                                      ontoksd:EvidencedCompetenceElement
                                                    )
                                      ] .


