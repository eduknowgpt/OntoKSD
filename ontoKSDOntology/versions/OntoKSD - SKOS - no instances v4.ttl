#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontoksd:Assessment
                ontoksd:EducationalResource
                ontoksd:LearningActivity
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontoksd:Disposition
                ontoksd:Knowledge
                ontoksd:Skill
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontoksd:DispositionCategory
                ontoksd:KnowledgeType
                ontoksd:SkillDimension
              )
] .


