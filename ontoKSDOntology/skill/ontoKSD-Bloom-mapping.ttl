@prefix bloom: <http://purl.org/edu/bloom#> .
@prefix ontoksd:  <http://purl.org/ontoksd#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

<http://purl.org/ontoksd/abox/skill>
    a owl:Ontology ;
    rdfs:label "OntoKSD Skills ABox"@en ;
    rdfs:comment "Assertional individuals for OntoKSD:Skill, mapped to Bloom's CognitiveProcessLevel concepts."@en .
	
	


#################################################################
# Skills mapped to Bloom's Taxonomy Levels
#################################################################

ontoksd:rememberingSkill
    a ontoksd:Skill ;
    rdfs:label "Remembering"@en ;
    ontoksd:hasCognitiveLevel bloom:Remembering .

ontoksd:understandingSkill
    a ontoksd:Skill ;
    rdfs:label "Understanding"@en ;
    ontoksd:hasCognitiveLevel bloom:Understanding .

ontoksd:applyingSkill
    a ontoksd:Skill ;
    rdfs:label "Applying"@en ;
    ontoksd:hasCognitiveLevel bloom:Applying .

ontoksd:analyzingSkill
    a ontoksd:Skill ;
    rdfs:label "Analyzing"@en ;
    ontoksd:hasCognitiveLevel bloom:Analyzing .

ontoksd:evaluatingSkill
    a ontoksd:Skill ;
    rdfs:label "Evaluating"@en ;
    ontoksd:hasCognitiveLevel bloom:Evaluating .

ontoksd:creatingSkill
    a ontoksd:Skill ;
    rdfs:label "Creating"@en ;
    ontoksd:hasCognitiveLevel bloom:Creating .
