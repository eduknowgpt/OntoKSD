PREFIX ontoksd: <https://example.org/ontoksd#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

#################################################
# NÍVEIS DE PROFICIÊNCIA COMO QUALIDADES (gUFO 2.4)
# (instâncias concretas por evidência/detalhe)
#################################################

# Deve-se inferir que, uma vez que o aluno concluiu a TASK01 com nota 78, ele evidencia todas as competências da TASK01 com esta nota, no mínimo.

INSERT DATA {
# Exemplo de portador
ontoksd:evidence_s2021_01_T01 a ontoksd:Evidence ;
  dcterms:description "Evidence for student_MATC94_2021_01 concluding the Learning Task Task01."@en ;
  ontoksd:evidenceBasedOn ontoksd:TASK01 ;
  ontoksd:isEvidenceOfProfile ontoksd:profile_2021_01 ;
  dcterms:date "2021".

# A qualidade que inere na Evidence
ontoksd:pl_ev_s2021_01_T01 a ontoksd:ProficiencyLevel ;
  ontoksd:proficiencyOfEvidence ontoksd:evidence_s2021_01_T01 ;
  ontoksd:selectedInScale ontoksd:Scale_0_100 ;
  ontoksd:hasNumericProficiencyValue "78"^^xsd:decimal ;
  ontoksd:hasProficiencyValue ontoksd:PV_Advanced .
  
}

  
  
############################
# COMPETENCE DETAIL + QUALITY
############################

PREFIX ontoksd: <https://example.org/ontoksd#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
  # Detalhe de competência (CD) no contexto 2022_02
  ontoksd:cd_C05_2022_02 a ontoksd:CompetenceDetail ;
    dcterms:description "Observed performance for competence_EdukNow_C05 in context contextMATC94_02 for student_MATC94_2022_02."@en ;
    ontoksd:hasCompetenceDetailContext ontoksd:contextMATC94_02 ;
    ontoksd:refersToCompetence ontoksd:competence_EdukNow_C05 ;
    ontoksd:isCompetenceDetailOfProfile ontoksd:profile_2022_02 .

  # ProficiencyLevel (qualidade) que inere no detalhe acima
  ontoksd:pl_cd_2022_02_C05 a ontoksd:ProficiencyLevel ;
    ontoksd:proficiencyOfCompetenceDetail ontoksd:cd_C05_2022_02 ;
    ontoksd:selectedInScale ontoksd:Scale_0_100 ;
    ontoksd:hasNumericProficiencyValue "78"^^xsd:decimal ;
    ontoksd:hasProficiencyValue ontoksd:PV_Advanced .
}

}

