# Example proficiency vocabulary. Load the current OntoKSD separately.
# Decimal coverage: [0,36), [36,61), [61,80), [80,100].
# The four labels and thresholds express a local example policy; positions are ordinal, not distances.
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
ontoksd:ProficiencyLevel_Advanced a ontoksd:ProficiencyLevel ;
    rdfs:label "Advanced"@en ;
    dcterms:description "Category assigned to an interpreted assessment result from 80 through 100 under this example policy."@en ;
    dcterms:identifier "ProficiencyLevel_Advanced" ;
    ontoksd:hasOrdinalPosition "4"^^xsd:int ;
    ontoksd:levelDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    skos:note "An ordinal category within the named example scheme. The score alone does not establish autonomy, transfer, or performance in more complex contexts."@en ;
    skos:prefLabel "Advanced"@en,
        "Avançado"@pt .

ontoksd:ProficiencyLevel_Basic a ontoksd:ProficiencyLevel ;
    rdfs:label "Basic"@en ;
    dcterms:description "Category assigned to an interpreted assessment result from 36 inclusive to 61 exclusive under this example policy."@en ;
    dcterms:identifier "ProficiencyLevel_Basic" ;
    ontoksd:hasOrdinalPosition "2"^^xsd:int ;
    ontoksd:levelDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    skos:note "An ordinal category within the named example scheme. The score alone does not establish autonomy, transfer, or performance in more complex contexts."@en ;
    skos:prefLabel "Basic"@en,
        "Básico"@pt .

ontoksd:ProficiencyLevel_Insufficient a ontoksd:ProficiencyLevel ;
    rdfs:label "Insufficient"@en ;
    dcterms:description "Category assigned to an interpreted assessment result below 36 under this example policy. It does not mean that evidence is absent."@en ;
    dcterms:identifier "ProficiencyLevel_Insufficient" ;
    ontoksd:hasOrdinalPosition "1"^^xsd:int ;
    ontoksd:levelDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    skos:note "An ordinal category within the named example scheme. The score alone does not establish autonomy, transfer, or performance in more complex contexts."@en ;
    skos:prefLabel "Insufficient"@en,
        "Insuficiente"@pt .

ontoksd:ProficiencyLevel_Proficient a ontoksd:ProficiencyLevel ;
    rdfs:label "Proficient"@en ;
    dcterms:description "Category assigned to an interpreted assessment result from 61 inclusive to 80 exclusive under this example policy."@en ;
    dcterms:identifier "ProficiencyLevel_Proficient" ;
    ontoksd:hasOrdinalPosition "3"^^xsd:int ;
    ontoksd:levelDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    skos:note "An ordinal category within the named example scheme. The score alone does not establish autonomy, transfer, or performance in more complex contexts."@en ;
    skos:prefLabel "Proficient"@en,
        "Proficiente"@pt .

ontoksd:ScaleInterval_0_35 a ontoksd:ScaleInterval ;
    rdfs:label "[0,36)"@en ;
    dcterms:description "Decimal interval [0,36) on the 0-100 scale, corresponding to Insufficient in this example scheme."@en ;
    dcterms:identifier "ScaleInterval_0_35" ;
    ontoksd:correspondsToLevel ontoksd:ProficiencyLevel_Insufficient ;
    ontoksd:includesLower true ;
    ontoksd:includesUpper false ;
    ontoksd:intervalDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    ontoksd:isIntervalOf ontoksd:Scale_0_100 ;
    ontoksd:lowerBound 0.0 ;
    ontoksd:upperBound 36.0 ;
    skos:prefLabel "[0,36)"@en,
        "[0,36)"@pt ;
    skos:scopeNote "The lowerBound/upperBound values and endpoint flags define membership. The IRI abbreviates the associated integer-score span."@en .

ontoksd:ScaleInterval_36_60 a ontoksd:ScaleInterval ;
    rdfs:label "[36,61)"@en ;
    dcterms:description "Decimal interval [36,61) on the 0-100 scale, corresponding to Basic in this example scheme."@en ;
    dcterms:identifier "ScaleInterval_36_60" ;
    ontoksd:correspondsToLevel ontoksd:ProficiencyLevel_Basic ;
    ontoksd:includesLower true ;
    ontoksd:includesUpper false ;
    ontoksd:intervalDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    ontoksd:isIntervalOf ontoksd:Scale_0_100 ;
    ontoksd:lowerBound 36.0 ;
    ontoksd:upperBound 61.0 ;
    skos:prefLabel "[36,61)"@en,
        "[36,61)"@pt ;
    skos:scopeNote "The lowerBound/upperBound values and endpoint flags define membership. The IRI abbreviates the associated integer-score span."@en .

ontoksd:ScaleInterval_61_79 a ontoksd:ScaleInterval ;
    rdfs:label "[61,80)"@en ;
    dcterms:description "Decimal interval [61,80) on the 0-100 scale, corresponding to Proficient in this example scheme."@en ;
    dcterms:identifier "ScaleInterval_61_79" ;
    ontoksd:correspondsToLevel ontoksd:ProficiencyLevel_Proficient ;
    ontoksd:includesLower true ;
    ontoksd:includesUpper false ;
    ontoksd:intervalDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    ontoksd:isIntervalOf ontoksd:Scale_0_100 ;
    ontoksd:lowerBound 61.0 ;
    ontoksd:upperBound 80.0 ;
    skos:prefLabel "[61,80)"@en,
        "[61,80)"@pt ;
    skos:scopeNote "The lowerBound/upperBound values and endpoint flags define membership. The IRI abbreviates the associated integer-score span."@en .

ontoksd:ScaleInterval_80_100 a ontoksd:ScaleInterval ;
    rdfs:label "[80,100]"@en ;
    dcterms:description "Decimal interval [80,100] on the 0-100 scale, corresponding to Advanced in this example scheme."@en ;
    dcterms:identifier "ScaleInterval_80_100" ;
    ontoksd:correspondsToLevel ontoksd:ProficiencyLevel_Advanced ;
    ontoksd:includesLower true ;
    ontoksd:includesUpper true ;
    ontoksd:intervalDefinedInScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    ontoksd:isIntervalOf ontoksd:Scale_0_100 ;
    ontoksd:lowerBound 80.0 ;
    ontoksd:upperBound 100.0 ;
    skos:prefLabel "[80,100]"@en,
        "[80,100]"@pt ;
    skos:scopeNote "The lowerBound/upperBound values and endpoint flags define membership. The IRI abbreviates the associated integer-score span."@en .

ontoksd:Scale_0_100 a ontoksd:Scale ;
    rdfs:label "0–100 numeric assessment scale"@en ;
    dcterms:description "A decimal score scale from 0 to 100. No fixed step or automatic rounding is imposed."@en ;
    dcterms:identifier "Scale_0_100" ;
    ontoksd:hasInterval ontoksd:ScaleInterval_0_35,
        ontoksd:ScaleInterval_36_60,
        ontoksd:ScaleInterval_61_79,
        ontoksd:ScaleInterval_80_100 ;
    ontoksd:maxValue 100.0 ;
    ontoksd:minValue 0.0 ;
    skos:prefLabel "0–100 numeric assessment scale"@en,
        "Escala numérica de avaliação de 0 a 100"@pt .

ontoksd:ProficiencyScheme_0_100_FourLevels a ontoksd:ProficiencyScheme ;
    rdfs:label "Four-level proficiency scheme for the 0–100 scale"@en ;
    dcterms:description "Illustrative local policy interpreting decimal scores with four ordered proficiency categories. Thresholds and labels are example choices, not prescribed by OntoKSD or CS2023."@en ;
    dcterms:identifier "ProficiencyScheme_0_100_FourLevels" ;
    ontoksd:definesInterval ontoksd:ScaleInterval_0_35,
        ontoksd:ScaleInterval_36_60,
        ontoksd:ScaleInterval_61_79,
        ontoksd:ScaleInterval_80_100 ;
    ontoksd:definesLevel ontoksd:ProficiencyLevel_Advanced,
        ontoksd:ProficiencyLevel_Basic,
        ontoksd:ProficiencyLevel_Insufficient,
        ontoksd:ProficiencyLevel_Proficient ;
    ontoksd:usesScale ontoksd:Scale_0_100 ;
    skos:prefLabel "Four-level proficiency scheme for the 0–100 scale"@en,
        "Esquema de proficiência em quatro níveis para a escala de 0 a 100"@pt .
}
