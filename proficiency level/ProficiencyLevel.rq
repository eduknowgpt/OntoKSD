@prefix ontoksd: <https://example.org/ontoksd#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .

############################
# SCALE (0–100) + INTERVALS
############################

INSERT DATA {
ontoksd:Scale_0_100 a ontoksd:Scale ;
  dcterms:description "Numeric scale from 0 to 100 for competence assessments."@en ;
  ontoksd:minValue "0"^^xsd:decimal ;
  ontoksd:maxValue "100"^^xsd:decimal ;
  ontoksd:step "1"^^xsd:decimal ;
  ontoksd:hasPerformanceClassCollection ontoksd:PerfClasses_A2E ;
  ontoksd:hasInterval ontoksd:Int_0_35 ,
                      ontoksd:Int_36_60 ,
                      ontoksd:Int_61_79 ,
                      ontoksd:Int_80_100 .

# Intervals (documentam cortes)
ontoksd:Int_0_35 a ontoksd:Interval ;
  ontoksd:lowerBound "0"^^xsd:decimal ;
  ontoksd:upperBound "35"^^xsd:decimal ;
  ontoksd:includesLower "true"^^xsd:boolean ;
  ontoksd:includesUpper "true"^^xsd:boolean ;
  ontoksd:label "0–35"@en .

ontoksd:Int_36_60 a ontoksd:Interval ;
  ontoksd:lowerBound "36"^^xsd:decimal ;
  ontoksd:upperBound "60"^^xsd:decimal ;
  ontoksd:includesLower "true"^^xsd:boolean ;
  ontoksd:includesUpper "true"^^xsd:boolean ;
  ontoksd:label "36–60"@en .

ontoksd:Int_61_79 a ontoksd:Interval ;
  ontoksd:lowerBound "61"^^xsd:decimal ;
  ontoksd:upperBound "79"^^xsd:decimal ;
  ontoksd:includesLower "true"^^xsd:boolean ;
  ontoksd:includesUpper "true"^^xsd:boolean ;
  ontoksd:label "61–79"@en .  # corrigido

ontoksd:Int_80_100 a ontoksd:Interval ;
  ontoksd:lowerBound "80"^^xsd:decimal ;
  ontoksd:upperBound "100"^^xsd:decimal ;
  ontoksd:includesLower "true"^^xsd:boolean ;
  ontoksd:includesUpper "true"^^xsd:boolean ;
  ontoksd:label "80–100"@en .

##############################################
# PERFORMANCE CLASSES (SKOS) + VALORES REIFICADOS
##############################################

# PerfClasses_A2E é uma PerformanceClassScheme
ontoksd:PerfClasses_A2E a ontoksd:PerformanceClassScheme ;
  dcterms:description "Ordered performance classes mapped from proficiency intervals."@en ;
  skos:member ontoksd:Perf_Beginner ,
              ontoksd:Perf_Intermediate ,
              ontoksd:Perf_Advanced ,
              ontoksd:Perf_Expert ;
  rdf:_1 ontoksd:Perf_Beginner ;
  rdf:_2 ontoksd:Perf_Intermediate ;
  rdf:_3 ontoksd:Perf_Advanced ;
  rdf:_4 ontoksd:Perf_Expert .

ontoksd:Perf_Beginner     a skos:Concept ; skos:prefLabel "Beginner"@en .
ontoksd:Perf_Intermediate a skos:Concept ; skos:prefLabel "Intermediate"@en .
ontoksd:Perf_Advanced     a skos:Concept ; skos:prefLabel "Advanced"@en .
ontoksd:Perf_Expert       a skos:Concept ; skos:prefLabel "Expert"@en .

# Valores reificados de proficiência (gUFO 2.5)
ontoksd:PV_Beginner     a ontoksd:ProficiencyValue ;
  ontoksd:alignsWithPerformanceClass ontoksd:Perf_Beginner .

ontoksd:PV_Intermediate a ontoksd:ProficiencyValue ;
  ontoksd:alignsWithPerformanceClass ontoksd:Perf_Intermediate .

ontoksd:PV_Advanced     a ontoksd:ProficiencyValue ;
  ontoksd:alignsWithPerformanceClass ontoksd:Perf_Advanced .

ontoksd:PV_Expert       a ontoksd:ProficiencyValue ;
  ontoksd:alignsWithPerformanceClass ontoksd:Perf_Expert .

}


