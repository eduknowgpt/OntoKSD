# Fictional assessment example: current OntoKSD + skill-level vocabulary + file 01 are prerequisites.
# Develop is a required SkillLevel; Proficient is a separately interpreted ProficiencyLevel.
# The final update interprets the whole-competence score; constituent levels are not inferred from it.
PREFIX cs2023level: <http://purl.org/edu/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
ontoksd:Activation_DFAWrittenExam_DFAConstruction a ontoksd:CompetenceActivation ;
    ontoksd:hasActivationFunction ontoksd:targetFunction ;
    ontoksd:mediatesCompetence ontoksd:Competence_DFAConstruction ;
    ontoksd:mediatesInstructionalUnit ontoksd:Assessment_DFAWrittenExam .

ontoksd:Assessor_Assessor_01 a ontoksd:Assessor ;
    rdfs:label "Prof. Assessor_01 as assessor"@en ;
    dcterms:description "A fictional person acting as assessor for the learner-specific assessment participation."@en ;
    dcterms:identifier "Assessor_Assessor_01" ;
    skos:prefLabel "Prof. Assessor_01 as assessor"@en,
        "Profa. Assessor_01 como avaliadora"@pt .

ontoksd:Document_DFAExam_Learner_01_2026_01 a ontoksd:Document ;
    rdfs:label "Illustrative learner response document"@en .

ontoksd:KnowledgeSkill_DFAConstruction a ontoksd:KnowledgeSkill ;
    rdfs:label "Knowledge-skill pair for deterministic finite automata construction"@en ;
    dcterms:description "Knowledge-level requirement pairing DFA conceptual knowledge with Develop in the CS2023 skill-level vocabulary. The explicit Skill constituent is associated with the competence separately."@en ;
    dcterms:identifier "KnowledgeSkill_DFAConstruction" ;
    ontoksd:hasKnowledgeComponent ontoksd:Knowledge_DFAConcepts ;
    ontoksd:hasSkillLevel cs2023level:Develop ;
    ontoksd:isKnowledgeSkillOf ontoksd:Competence_DFAConstruction ;
    skos:prefLabel "Knowledge-skill pair for deterministic finite automata construction"@en,
        "Par conhecimento-habilidade para construção de autômatos finitos determinísticos"@pt .

ontoksd:WrittenExam a ontoksd:EvidenceType ;
    rdfs:label "Written assessment response"@en ;
    skos:scopeNote "Classifies the response material used as evidence, rather than the assessment specification or its occurrence."@en .

ontoksd:AssessmentOccurrence_DFAWrittenExam_2026_01 a ontoksd:AssessmentOccurrence ;
    rdfs:label "Occurrence of the DFA written assessment - 2026-01"@en ;
    dcterms:description "A fictional assessment event using the example 0-100 proficiency scheme. The scheme does not itself execute score interpretation."@en ;
    dcterms:identifier "AssessmentOccurrence_DFAWrittenExam_2026_01" ;
    ontoksd:involvesAssessmentParticipation ontoksd:AssessmentParticipation_Learner_01_DFAExam_2026_01 ;
    ontoksd:occursInAcquisitionContext ontoksd:AcquisitionContext_DFAExam_2026_01 ;
    ontoksd:producesEvidence ontoksd:Evidence_DFAExam_Learner_01_2026_01 ;
    ontoksd:realizes ontoksd:Assessment_DFAWrittenExam ;
    ontoksd:usesProficiencyScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    skos:prefLabel "Occurrence of the DFA written assessment - 2026-01"@en,
        "Ocorrência da avaliação escrita de AFD - 2026-01"@pt .

ontoksd:Assessment_DFAWrittenExam a ontoksd:Assessment ;
    rdfs:label "Written assessment on deterministic finite automata"@en ;
    dcterms:description "A written assessment designed to evaluate the learner's ability to analyze languages and construct deterministic finite automata."@en ;
    dcterms:identifier "Assessment_DFAWrittenExam" ;
    ontoksd:hasAcquisitionContext ontoksd:AcquisitionContext_DFAExam_2026_01 ;
    ontoksd:hasCompetenceActivation ontoksd:Activation_DFAWrittenExam_DFAConstruction ;
    ontoksd:maxScore 100.0 ;
    ontoksd:passingScore 60.0 ;
    skos:prefLabel "Written assessment on deterministic finite automata"@en,
        "Avaliação escrita sobre autômatos finitos determinísticos"@pt .

ontoksd:EvidencedConstituent_DFAConcepts_Learner_01 a ontoksd:EvidencedCompetenceConstituent ;
    rdfs:label "Evidenced DFA conceptual knowledge of Learner_01"@en ;
    dcterms:description "Contextualized evidential record indicating that Learner_01 evidenced knowledge of deterministic finite automata concepts in the assessment occurrence."@en ;
    dcterms:identifier "EvidencedConstituent_DFAConcepts_Learner_01" ;
    ontoksd:derivedFromParticipation ontoksd:AssessmentParticipation_Learner_01_DFAExam_2026_01 ;
    ontoksd:evidencedAt "2026-01-20T12:00:00+00:00"^^xsd:dateTime ;
    ontoksd:hasContext ontoksd:AcquisitionContext_DFAExam_2026_01 ;
    ontoksd:isEvidencedCompetenceConstituentOf ontoksd:EvidencedCompetence_DFAConstruction_Learner_01 ;
    ontoksd:refersToCompetenceConstituent ontoksd:Knowledge_DFAConcepts ;
    ontoksd:supportedByEvidence ontoksd:Evidence_DFAExam_Learner_01_2026_01 ;
    skos:prefLabel "Evidenced DFA conceptual knowledge of Learner_01"@en,
        "Conhecimento conceitual evidenciado de AFD de Learner_01"@pt ;
    skos:scopeNote "Illustrative constituent-level observation supported by the response material. No proficiency level is copied from the overall participation score; an independent criterion-based interpretation is needed."@en .

ontoksd:EvidencedConstituent_DFAConstructionSkill_Learner_01 a ontoksd:EvidencedCompetenceConstituent ;
    rdfs:label "Evidenced DFA construction skill of Learner_01"@en ;
    dcterms:description "Contextualized evidential record indicating that Learner_01 evidenced the skill of constructing deterministic finite automata in the assessment occurrence."@en ;
    dcterms:identifier "EvidencedConstituent_DFAConstructionSkill_Learner_01" ;
    ontoksd:derivedFromParticipation ontoksd:AssessmentParticipation_Learner_01_DFAExam_2026_01 ;
    ontoksd:evidencedAt "2026-01-20T12:00:00+00:00"^^xsd:dateTime ;
    ontoksd:hasContext ontoksd:AcquisitionContext_DFAExam_2026_01 ;
    ontoksd:isEvidencedCompetenceConstituentOf ontoksd:EvidencedCompetence_DFAConstruction_Learner_01 ;
    ontoksd:refersToCompetenceConstituent ontoksd:Skill_DFAConstruction ;
    ontoksd:supportedByEvidence ontoksd:Evidence_DFAExam_Learner_01_2026_01 ;
    skos:prefLabel "Evidenced DFA construction skill of Learner_01"@en,
        "Habilidade evidenciada de construção de AFD de Learner_01"@pt ;
    skos:scopeNote "Illustrative constituent-level observation supported by the response material. No proficiency level is copied from the overall participation score; an independent criterion-based interpretation is needed."@en .

ontoksd:Learner_Learner_01 a ontoksd:Learner ;
    rdfs:label "Learner_01 as learner"@en ;
    dcterms:description "A fictional learner considered in an educational setting; the individual is a Person through the Learner class."@en ;
    dcterms:identifier "Learner_Learner_01" ;
    ontoksd:hasProfile ontoksd:Profile_Learner_01 ;
    ontoksd:participatesIn ontoksd:AssessmentParticipation_Learner_01_DFAExam_2026_01 ;
    skos:prefLabel "Learner_01 as learner"@en,
        "Learner_01 como aprendiz"@pt .

ontoksd:Profile_Learner_01 a ontoksd:Profile ;
    rdfs:label "Profile of Learner_01"@en ;
    dcterms:description "Educational profile of Learner_01, including evidenced competences and associated evidence records."@en ;
    dcterms:identifier "Profile_Learner_01" ;
    ontoksd:hasEvidence ontoksd:Evidence_DFAExam_Learner_01_2026_01 ;
    ontoksd:hasEvidencedCompetence ontoksd:EvidencedCompetence_DFAConstruction_Learner_01 ;
    ontoksd:isProfileOf ontoksd:Learner_Learner_01 ;
    skos:prefLabel "Profile of Learner_01"@en,
        "Perfil de Learner_01"@pt .

ontoksd:Skill_DFAConstruction a ontoksd:Skill ;
    rdfs:label "Construct deterministic finite automata"@en ;
    dcterms:description "Skill of designing and representing deterministic finite automata for a given formal language specification."@en ;
    dcterms:identifier "Skill_DFAConstruction" ;
    ontoksd:appliesKnowledge ontoksd:Knowledge_DFAConcepts ;
    ontoksd:isSkillOf ontoksd:Competence_DFAConstruction ;
    skos:prefLabel "Construct deterministic finite automata"@en,
        "Construir autômatos finitos determinísticos"@pt .

ontoksd:EvidencedCompetence_DFAConstruction_Learner_01 a ontoksd:EvidencedCompetence ;
    rdfs:label "Evidenced competence of Learner_01 in DFA construction"@en ;
    dcterms:description "Contextualized evidential record indicating that Learner_01 evidenced the competence of constructing deterministic finite automata in the written assessment occurrence."@en ;
    dcterms:identifier "EvidencedCompetence_DFAConstruction_Learner_01" ;
    ontoksd:derivedFromParticipation ontoksd:AssessmentParticipation_Learner_01_DFAExam_2026_01 ;
    ontoksd:evidencedAt "2026-01-20T12:00:00+00:00"^^xsd:dateTime ;
    ontoksd:hasContext ontoksd:AcquisitionContext_DFAExam_2026_01 ;
    ontoksd:hasEvidencedConstituent ontoksd:EvidencedConstituent_DFAConcepts_Learner_01,
        ontoksd:EvidencedConstituent_DFAConstructionSkill_Learner_01 ;
    ontoksd:interpretedUsingScheme ontoksd:ProficiencyScheme_0_100_FourLevels ;
    ontoksd:isEvidencedCompetenceOf ontoksd:Profile_Learner_01 ;
    ontoksd:refersToCompetence ontoksd:Competence_DFAConstruction ;
    ontoksd:supportedByEvidence ontoksd:Evidence_DFAExam_Learner_01_2026_01 ;
    skos:prefLabel "Evidenced competence of Learner_01 in DFA construction"@en,
        "Competência evidenciada de Learner_01 em construção de AFD"@pt ;
    skos:scopeNote "The example policy treats the participation score as the result for this single whole-competence judgment. Applying this policy to an assessment addressing several competences requires separately justified results."@en .

ontoksd:Knowledge_DFAConcepts a ontoksd:Knowledge ;
    rdfs:label "Concepts of deterministic finite automata"@en ;
    dcterms:description "Knowledge of states, transitions, alphabet, initial state, accepting states, and formal language recognition by deterministic finite automata."@en ;
    dcterms:identifier "Knowledge_DFAConcepts" ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    ontoksd:isKnowledgeOf ontoksd:Competence_DFAConstruction ;
    skos:prefLabel "Concepts of deterministic finite automata"@en,
        "Conceitos de autômatos finitos determinísticos"@pt .

ontoksd:AssessmentParticipation_Learner_01_DFAExam_2026_01 a ontoksd:AssessmentParticipation ;
    rdfs:label "Learner_01 participation in DFA written assessment occurrence"@en ;
    dcterms:description "Participant-specific evaluative relation connecting Learner_01 to the concrete occurrence of the DFA written assessment, with individual score attribution."@en ;
    dcterms:identifier "AssessmentParticipation_Learner_01_DFAExam_2026_01" ;
    ontoksd:hasAssessor ontoksd:Assessor_Assessor_01 ;
    ontoksd:hasLearner ontoksd:Learner_Learner_01 ;
    ontoksd:hasScore 74.00 ;
    ontoksd:occursInAssessmentOccurrence ontoksd:AssessmentOccurrence_DFAWrittenExam_2026_01 ;
    skos:prefLabel "Learner_01 participation in DFA written assessment occurrence"@en,
        "Participação de Learner_01 na ocorrência da avaliação escrita de AFD"@pt .

ontoksd:Competence_DFAConstruction a ontoksd:Competence ;
    rdfs:label "Construct deterministic finite automata for formal languages"@en ;
    dcterms:description "Competence related to constructing deterministic finite automata that correctly recognize specified formal languages."@en ;
    dcterms:identifier "Competence_DFAConstruction" ;
    ontoksd:hasKnowledge ontoksd:Knowledge_DFAConcepts ;
    ontoksd:hasKnowledgeSkill ontoksd:KnowledgeSkill_DFAConstruction ;
    ontoksd:hasSkill ontoksd:Skill_DFAConstruction ;
    skos:prefLabel "Construct deterministic finite automata for formal languages"@en,
        "Construir autômatos finitos determinísticos para linguagens formais"@pt .

ontoksd:Evidence_DFAExam_Learner_01_2026_01 a ontoksd:Evidence ;
    rdfs:label "Evidence from Learner_01's DFA written assessment"@en ;
    dcterms:description "Evidence produced in the context of Learner_01's written assessment on deterministic finite automata."@en ;
    dcterms:identifier "Evidence_DFAExam_Learner_01_2026_01" ;
    ontoksd:evidenceBasedOn ontoksd:AssessmentOccurrence_DFAWrittenExam_2026_01 ;
    ontoksd:evidencesCompetence ontoksd:EvidencedCompetence_DFAConstruction_Learner_01,
        ontoksd:EvidencedConstituent_DFAConcepts_Learner_01,
        ontoksd:EvidencedConstituent_DFAConstructionSkill_Learner_01 ;
    ontoksd:generatedAt "2026-01-20T10:00:00+00:00"^^xsd:dateTime ;
    ontoksd:hasContext ontoksd:AcquisitionContext_DFAExam_2026_01 ;
    ontoksd:hasEvidenceType ontoksd:WrittenExam ;
    ontoksd:hasSupportDocument ontoksd:Document_DFAExam_Learner_01_2026_01 ;
    skos:prefLabel "Evidence from Learner_01's DFA written assessment"@en,
        "Evidência da avaliação escrita de AFD de Learner_01"@pt .

ontoksd:AcquisitionContext_DFAExam_2026_01 a ontoksd:AcquisitionContext ;
    rdfs:label "Fictional DFA assessment setting"@en .
}

;
# Recalculate the example judgment only. Run on an isolated demonstration dataset.
DELETE { ontoksd:EvidencedCompetence_DFAConstruction_Learner_01 ontoksd:hasProficiencyLevel ?oldLevel . }
WHERE { ontoksd:EvidencedCompetence_DFAConstruction_Learner_01 ontoksd:hasProficiencyLevel ?oldLevel . }
;
INSERT { ?judgment ontoksd:hasProficiencyLevel ?level . }
WHERE {
  VALUES ?judgment { ontoksd:EvidencedCompetence_DFAConstruction_Learner_01 }
  ?judgment a ontoksd:EvidencedCompetence ;
      ontoksd:interpretedUsingScheme ?scheme ;
      ontoksd:derivedFromParticipation ?participation ;
      ontoksd:supportedByEvidence ?evidence .
  ?participation ontoksd:hasScore ?score ;
      ontoksd:occursInAssessmentOccurrence ?occurrence .
  ?occurrence ontoksd:usesProficiencyScheme ?scheme .
  ?evidence ontoksd:evidenceBasedOn ?occurrence .
  ?scheme ontoksd:usesScale ?scale ;
      ontoksd:definesInterval ?interval ;
      ontoksd:definesLevel ?level .
  ?scale ontoksd:minValue ?minimum ; ontoksd:maxValue ?maximum .
  ?interval ontoksd:isIntervalOf ?scale ;
      ontoksd:intervalDefinedInScheme ?scheme ;
      ontoksd:lowerBound ?lower ; ontoksd:upperBound ?upper ;
      ontoksd:includesLower ?includeLower ; ontoksd:includesUpper ?includeUpper ;
      ontoksd:correspondsToLevel ?level .
  FILTER(datatype(?score) = xsd:decimal)
  FILTER(?score >= ?minimum && ?score <= ?maximum)
  FILTER((?score > ?lower || (?includeLower && ?score = ?lower)) &&
         (?score < ?upper || (?includeUpper && ?score = ?upper)))
  FILTER NOT EXISTS { ?participation ontoksd:hasScore ?anotherScore . FILTER(?anotherScore != ?score) }
  FILTER NOT EXISTS { ?judgment ontoksd:derivedFromParticipation ?anotherParticipation . FILTER(?anotherParticipation != ?participation) }
  FILTER NOT EXISTS { ?judgment ontoksd:interpretedUsingScheme ?anotherScheme . FILTER(?anotherScheme != ?scheme) }
  FILTER NOT EXISTS {
    ?scheme ontoksd:definesInterval ?otherInterval .
    ?otherInterval ontoksd:isIntervalOf ?scale ;
      ontoksd:lowerBound ?otherLower ; ontoksd:upperBound ?otherUpper ;
      ontoksd:includesLower ?otherIncludesLower ; ontoksd:includesUpper ?otherIncludesUpper .
    FILTER(?otherInterval != ?interval)
    FILTER((?score > ?otherLower || (?otherIncludesLower && ?score = ?otherLower)) &&
           (?score < ?otherUpper || (?otherIncludesUpper && ?score = ?otherUpper)))
  }
}
