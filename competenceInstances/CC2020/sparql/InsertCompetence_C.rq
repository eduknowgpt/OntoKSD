# CC2020 example C: specification data, not an assessment or learner record.
# Load OntoKSD, the Bloom skill-level module, and the CC2020 knowledge/disposition populations first.
# KnowledgeSkill uses hasKnowledgeComponent + hasSkillLevel; no Relator instances are created.
# Atomic is a project granularity choice; the reference Task is explicit to satisfy the current OWL axioms.
# Only exact conflicting assertions for these example records are removed; unrelated data are preserved.
PREFIX bloom: <http://purl.org/edu/bloom#>
PREFIX cc2020: <http://purl.org/cc2020/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>



INSERT DATA {
ontoksd:KS_C_01 a ontoksd:KnowledgeSkill,
        owl:NamedIndividual ;
    rdfs:label "Requirements Analysis and Specifications × Evaluating"@en ;
    dcterms:description "Source knowledge label: \"Requirements Analysis\". Required source skill level: Evaluating."@en ;
    dcterms:identifier "KS_C_01" ;
    dcterms:references ontoksd:CC2020_Source_Example_C ;
    dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> ;
    ontoksd:hasKnowledgeComponent cc2020:RequirementsAnalysisAndSpecifications ;
    ontoksd:hasSkillLevel bloom:Evaluating ;
    ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_C ;
    rdfs:comment "A knowledge-level specification constituent of CC2020 competence C, pairing the referenced Knowledge with the required Evaluating category. It is not modeled as a Relator or an explicit Skill."@en ;
    skos:prefLabel "Requirements Analysis and Specifications × Evaluating"@en ;
    skos:scopeNote "The source label \"Requirements Analysis\" is mapped to the project Knowledge entry \"Requirements Analysis and Specifications\" for curricular traceability. This documented label alignment is not an owl:sameAs assertion or a general claim of complete equivalence."@en .

