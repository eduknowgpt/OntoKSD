        ontoksd:KS_C_04 ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasTask ontoksd:Task_CC2020_Competence_C ;
    rdfs:comment "A competence specification instantiating example C in CC2020 section 4.2.5, using knowledge-level constituents and dispositions. It represents expected performance, not learner attainment."@en ;
    skos:altLabel "CC2020 Competence C"@en ;
