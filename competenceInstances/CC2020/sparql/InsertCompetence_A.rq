PREFIX ontoksd:     <http://purl.org/ontoksd#>
PREFIX cc2020:      <http://purl.org/cc2020/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>
PREFIX bloom:       <http://purl.org/edu/bloom#>
PREFIX rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:        <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:         <http://www.w3.org/2002/07/owl#>
PREFIX skos:        <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:     <http://purl.org/dc/terms/>

INSERT DATA {

  #################################################################
  # Source marker
  #################################################################

  <http://purl.org/ontoksd/source/cc2020-competence-catalog>
      a owl:NamedIndividual ;
      rdfs:label "CC2020 competence catalog"@en ;
      rdfs:comment "Source for competencies instantiated from the CC2020 report."@en .

  #################################################################
  # Competence
  #################################################################

  ontoksd:CC2020_Competence_A
      a ontoksd:Competence ;
      rdfs:label "Manage computer system and digital circuit design"@en ;
      skos:prefLabel "A"@en ;
      skos:altLabel "CC2020 Competence A"@en ;
      skos:definition """Manage the design of a computer system for a manufacturer using appropriate tools, design digital circuits including the basic building blocks of Boolean algebra, computer numbering systems, data encoding, combinatorial and sequential elements."""@en ;
      rdfs:comment """Competence derived from the CC2020 report."""@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;

      ontoksd:hasDisposition ontoksd:selfDirected ;
      ontoksd:hasDisposition ontoksd:meticulous ;
      ontoksd:hasDisposition ontoksd:inventive ;

      ontoksd:hasKnowledgeSkill ontoksd:KS_A_01 ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_A_02 ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_A_03 ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_A_04 ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_A_05 ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_A_06 ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_A_07 ;

      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> ;
	  dcterms:bibliographicCitation "Computing Curricula 2020 (CC2020), pp. 51–52."@en ;	  
      dcterms:references <http://purl.org/ontoksd/source/cc2020-competence-catalog> .

  #################################################################
  # KnowledgeSkill relators
  #################################################################

  ontoksd:KS_A_01
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Architecture and Organization × Creating"@en ;
      skos:prefLabel "Architecture and Organization × Creating"@en ;
      rdfs:comment "KnowledgeSkill relation for CC2020 Competence A linking the knowledge element Architecture and Organization to the required Bloom skill level Creating."@en ;
      ontoksd:hasKnowledgeComponent cc2020:ArchitectureAndOrganization ;
      ontoksd:hasRequiredSkillLevel bloom:Creating ;
      ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_A .

  ontoksd:KS_A_02
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Digital Design × Creating"@en ;
      skos:prefLabel "Digital Design × Creating"@en ;
      rdfs:comment "KnowledgeSkill relation for CC2020 Competence A linking the knowledge element Digital Design to the required Bloom skill level Creating."@en ;
      ontoksd:hasKnowledgeComponent cc2020:DigitalDesign ;
      ontoksd:hasRequiredSkillLevel bloom:Creating ;
      ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_A .

  ontoksd:KS_A_03
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Circuits and Electronics × Creating"@en ;
      skos:prefLabel "Circuits and Electronics × Creating"@en ;
      rdfs:comment "KnowledgeSkill relation for CC2020 Competence A linking the knowledge element Circuits and Electronics to the required Bloom skill level Creating."@en ;
      ontoksd:hasKnowledgeComponent cc2020:CircuitsAndElectronics ;
      ontoksd:hasRequiredSkillLevel bloom:Creating ;
      ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_A .

  ontoksd:KS_A_04
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Analytical and Critical Thinking × Applying"@en ;
      skos:prefLabel "Analytical and Critical Thinking × Applying"@en ;
      rdfs:comment "KnowledgeSkill relation for CC2020 Competence A linking the knowledge element Analytical and Critical Thinking to the required Bloom skill level Applying."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasRequiredSkillLevel bloom:Applying ;
      ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_A .

  ontoksd:KS_A_05
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Mathematics and Statistics × Applying"@en ;
      skos:prefLabel "Mathematics and Statistics × Applying"@en ;
      rdfs:comment "KnowledgeSkill relation for CC2020 Competence A linking the knowledge element Mathematics and Statistics to the required Bloom skill level Applying."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:MathematicsAndStatistics ;
      ontoksd:hasRequiredSkillLevel bloom:Applying ;
      ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_A .

  ontoksd:KS_A_06
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Problem Solving and Trouble Shooting × Applying"@en ;
      skos:prefLabel "Problem Solving and Trouble Shooting × Applying"@en ;
      rdfs:comment "KnowledgeSkill relation for CC2020 Competence A linking the knowledge element Problem Solving and Trouble Shooting to the required Bloom skill level Applying."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:ProblemSolvingAndTroubleShooting ;
      ontoksd:hasRequiredSkillLevel bloom:Applying ;
      ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_A .

  ontoksd:KS_A_07
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Research and Self-Starter/Learner × Applying"@en ;
      skos:prefLabel "Research and Self-Starter/Learner × Applying"@en ;
      rdfs:comment "KnowledgeSkill relation for CC2020 Competence A linking the knowledge element Research and Self-Starter/Learner to the required Bloom skill level Applying."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:ResearchAndSelfStarterLearner ;
      ontoksd:hasRequiredSkillLevel bloom:Applying ;
      ontoksd:isKnowledgeSkillOf ontoksd:CC2020_Competence_A .

}