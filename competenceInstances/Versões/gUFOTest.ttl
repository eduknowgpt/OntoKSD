@prefix : <http://example.com#>.
@prefix gufo: <http://purl.org/nemo/gufo#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<http://example.com> rdf:type owl:Ontology;
    owl:imports gufo:.
:KnowledgeSkill rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "KnowledgeSkill"@en.
:Skill rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Skill"@en.
:Knowledge rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Knowledge"@en.
:Competency rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Competency"@en.
:CompositeCompetency rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "CompositeCompetency"@en.
:AtomicCompetency rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "AtomicCompetency"@en.
:CompositeCompetency rdfs:subClassOf :Competency.
:AtomicCompetency rdfs:subClassOf :Competency.
:isSkillPartOf rdf:type owl:ObjectProperty;
    rdfs:domain :Skill;
    rdfs:range :KnowledgeSkill;
    rdfs:subPropertyOf gufo:isComponentOf.
:hasSkillPart rdf:type owl:ObjectProperty;
    rdfs:range :Skill;
    rdfs:domain :KnowledgeSkill;
    rdfs:label "hasSkillPart"@en;
    rdfs:subPropertyOf <gufoi:hasComponent>.
:isKnowledgePartOf rdf:type owl:ObjectProperty;
    rdfs:domain :Knowledge;
    rdfs:range :KnowledgeSkill;
    rdfs:subPropertyOf gufo:isComponentOf.
:hasKnowledgePart rdf:type owl:ObjectProperty;
    rdfs:range :Knowledge;
    rdfs:domain :KnowledgeSkill;
    rdfs:label "hasKnowledgePart"@en;
    rdfs:subPropertyOf <gufoi:hasComponent>.
:competencyIsComponentOfCompositeCompetency rdf:type owl:ObjectProperty;
    rdfs:domain :Competency;
    rdfs:range :CompositeCompetency;
    rdfs:subPropertyOf gufo:isComponentOf;
    rdf:type owl:ObjectProperty;
    rdfs:range :Competency;
    rdfs:domain :CompositeCompetency;
    rdfs:subPropertyOf <gufoi:hasComponent>.
:hasKnowledgeSkill rdf:type owl:ObjectProperty;
    rdfs:domain :AtomicCompetency;
    rdfs:range :KnowledgeSkill.
:atomicCompetencyHasKnowledgeSkill rdf:type owl:ObjectProperty;
    rdfs:range :AtomicCompetency;
    rdfs:domain :KnowledgeSkill.
