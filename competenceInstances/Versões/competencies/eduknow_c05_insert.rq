PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://example.org/bloom#>

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:FiniteStateMachines ontoksd:applyingSkill)
    (cs2013:RequirementsEngineering ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C05 ################

INSERT {
  ontoksd:competence_EdukNow_C05 a ontoksd:Competence ;
    dcterms:title "Develop problem solutions using Automata"@en ;
    dcterms:description "This competency refers to the ability to design, construct, and validate automaton-based solutions that address well-defined computational problems. Students are expected to interpret system requirements and model behavior using finite state machines, applying formal methods to ensure logical consistency and operational correctness."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C05"@en ;
    ontoksd:hasCompetenceElement ontoksd:Collaborative ,
                                 ontoksd:Responsible ,
                                 ontoksd:Proactive ,
                                 ontoksd:Creative ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:FiniteStateMachines ontoksd:applyingSkill)
    (cs2013:RequirementsEngineering ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:FiniteStateMachines ontoksd:applyingSkill bloom:Construct)
    (cs2013:FiniteStateMachines ontoksd:applyingSkill bloom:Develop)
    (cs2013:FiniteStateMachines ontoksd:applyingSkill bloom:Design)

    (cs2013:RequirementsEngineering ontoksd:applyingSkill bloom:Interpret)
    (cs2013:RequirementsEngineering ontoksd:applyingSkill bloom:Implement)
    (cs2013:RequirementsEngineering ontoksd:applyingSkill bloom:Organize)

    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:Analyze)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:Justify)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:Evaluate)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
