PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://purl.org/edu/bloom#>

#### "Write a Technical Report"

############# INSERÇÃO CONDICIONAL DO PAR KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent cc2020fpk:WrittenCommunication ;
      ontoksd:hasSkillComponent ontoksd:applyingSkill .
}
WHERE {
  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent cc2020fpk:WrittenCommunication ;
              ontoksd:hasSkillComponent ontoksd:applyingSkill .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C05 ################

INSERT {
  ontoksd:competence_EdukNow_C05 a ontoksd:Competence ;
   	ontoksd:hasStructureType	ontoksd:Atomic ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain ;
    dcterms:title "Write a Technical Report"@en ;
    dcterms:description "This competency involves the collaborative production of a well-organized technical report that effectively communicates the design, implementation, and evaluation of automaton-based solutions."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C05"@en ;
    ontoksd:hasDisposition ontoksd:collaborative ,
                                 ontoksd:Meticulous ,
                                 ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent cc2020fpk:WrittenCommunication ;
      ontoksd:hasSkillComponent ontoksd:applyingSkill .
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cc2020fpk:WrittenCommunication ontoksd:applyingSkill bloom:document)
    (cc2020fpk:WrittenCommunication ontoksd:applyingSkill bloom:structure)
    (cc2020fpk:WrittenCommunication ontoksd:applyingSkill bloom:explain)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}