
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://purl.org/edu/bloom#>

####  Interpret rule-based notation

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:Push_down_automata__PDAs_ ontoksd:understandingSkill)
    (cs2013:Context_free_grammars ontoksd:understandingSkill)
    (cs2013:Regular_languages ontoksd:understandingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C13 ################

INSERT {
  ontoksd:competence_EdukNow_C13 a ontoksd:Competence ;
   	ontoksd:hasStructureType	ontoksd:Atomic ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain ;
    dcterms:title "Interpret rule-based notation"@en ;
    dcterms:description "This competency involves the ability to understand and interpret formal rule-based notations, such as context-free grammars, used to define and control system behavior through structured symbol sequences. Learners are expected to analyze how production rules govern valid sequences of operations, enabling the representation of decision-making logic, procedural flows, or communication protocols. This competency is applicable across domains that require symbolic modeling, such as language processing, robotic control, and formal specification. It emphasizes the comprehension of syntax and rule hierarchies, and the capacity to interpret how such notations define constraints and guide execution within computational systems."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C13"@en ;
    ontoksd:hasDisposition ontoksd:inventive ,
                                 ontoksd:collaborative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive ,
                                 ontoksd:creative ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:Push_down_automata__PDAs_ ontoksd:understandingSkill)
    (cs2013:Context_free_grammars ontoksd:understandingSkill)
    (cs2013:Regular_languages ontoksd:understandingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Push_down_automata__PDAs_ ontoksd:understandingSkill bloom:recognize)
    (cs2013:Push_down_automata__PDAs_ ontoksd:understandingSkill bloom:explain)
    (cs2013:Push_down_automata__PDAs_ ontoksd:understandingSkill bloom:compare)

    (cs2013:Context_free_grammars ontoksd:understandingSkill bloom:interpret)
    (cs2013:Context_free_grammars ontoksd:understandingSkill bloom:construct)
    (cs2013:Context_free_grammars ontoksd:understandingSkill bloom:relate)

    (cs2013:Regular_languages ontoksd:understandingSkill bloom:interpret)
    (cs2013:Regular_languages ontoksd:understandingSkill bloom:construct)
    (cs2013:Regular_languages ontoksd:understandingSkill bloom:relate)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
