PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Systems4
      a ontoksd:Competence ;
      rdfs:label "Design the data storage needs, assess the social and ethical implications for collecting and storing the data, determine how to store a new application's data, and create the database, including appropriate indices"@en ;
      skos:prefLabel "Design the data storage needs, assess the social and ethical implications for collecting and storing the data, determine how to store a new application's data, and create the database, including appropriate indices"@en ;
      skos:definition "Design the data storage needs (data modeling), assess the social and ethical implications for collecting and storing the data, determine how to store a new application's data (RDBMS vs NoSQL), and create the database, including appropriate indices."@en ;
      rdfs:comment "Competence derived from the CS2023 Systems Competency Area, Task Systems4. The competence is specified through explicit KnowledgeSkill pairs and the desirable professional dispositions associated with the task."@en ;
      dcterms:identifier "Systems4"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Systems4 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Systems4_DM_Data_1_Develop ,
          cs2023c:KS_Systems4_DM_Core_1_Develop ,
          cs2023c:KS_Systems4_DM_Modeling_1_Develop ,
          cs2023c:KS_Systems4_DM_Relational_1_Develop ,
          cs2023c:KS_Systems4_DM_NoSQL_1_Develop ,
          cs2023c:KS_Systems4_DM_Internals_1_Develop ,
          cs2023c:KS_Systems4_SEP_Context_1_Develop ,
          cs2023c:KS_Systems4_SEP_Ethical_Analysis_1_Develop ,
          cs2023c:KS_Systems4_SEP_Privacy_1_Develop ,
          cs2023c:KS_Systems4_SEP_Professional_Ethics_1_Develop ,
          cs2023c:KS_Systems4_SEP_Security_1_Develop ,
          cs2023c:KS_Systems4_SEP_DEIA_1_Develop ,
          cs2023c:KS_Systems4_SEC_Foundations_1_Develop ;
      ontoksd:hasDisposition
          ontoksd:inventive ,
          ontoksd:meticulous ,
          ontoksd:responsible ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Systems4
      a ontoksd:Task ;
      rdfs:label "Systems4 task"@en ;
      skos:prefLabel "Systems4 task"@en ;
      ontoksd:hasTaskStatement "Create a database for a new application."@en ;
      rdfs:comment "Specification-level task associated with Competence_Systems4. The task concerns designing the data storage needs of a new application, evaluating implications of data collection and storage, determining an appropriate storage approach such as RDBMS or NoSQL, and creating the database including suitable indices."@en ;
      dcterms:identifier "Task_Systems4"^^xsd:string ;
      ontoksd:hasTaskComponent
          cs2023c:TaskComponent_Systems4_ApplicationData ,
          cs2023c:TaskComponent_Systems4_Database ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Systems4_Model ,
          cs2023c:TaskActivity_Systems4_Assess ,
          cs2023c:TaskActivity_Systems4_Determine ,
          cs2023c:TaskActivity_Systems4_Create ,
          cs2023c:TaskActivity_Systems4_Index ;
      ontoksd:hasTaskConstraint
          cs2023c:TaskConstraint_Systems4_SocialEthicalImplications ,
          cs2023c:TaskConstraint_Systems4_RDBMSvsNoSQL .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Systems4_ApplicationData
      a ontoksd:TaskComponent ;
      rdfs:label "new application's data"@en ;
      skos:prefLabel "new application's data"@en ;
      rdfs:comment "Task component corresponding to the data to be modeled, collected, stored, and protected in the new application."@en .

  cs2023c:TaskComponent_Systems4_Database
      a ontoksd:TaskComponent ;
      rdfs:label "database including appropriate indices"@en ;
      skos:prefLabel "database including appropriate indices"@en ;
      rdfs:comment "Task component corresponding to the database structure to be created, including indexing decisions appropriate to the application needs."@en .

  cs2023c:TaskActivity_Systems4_Model
      a ontoksd:TaskActivity ;
      rdfs:label "model"@en ;
      skos:prefLabel "model"@en ;
      rdfs:comment "Task activity capturing the design of data storage needs through data modeling."@en .

  cs2023c:TaskActivity_Systems4_Assess
      a ontoksd:TaskActivity ;
      rdfs:label "assess"@en ;
      skos:prefLabel "assess"@en ;
      rdfs:comment "Task activity capturing the assessment of social and ethical implications of collecting and storing data."@en .

  cs2023c:TaskActivity_Systems4_Determine
      a ontoksd:TaskActivity ;
      rdfs:label "determine"@en ;
      skos:prefLabel "determine"@en ;
      rdfs:comment "Task activity capturing the decision regarding how to store the application's data, including the choice between RDBMS and NoSQL approaches."@en .

  cs2023c:TaskActivity_Systems4_Create
      a ontoksd:TaskActivity ;
      rdfs:label "create"@en ;
      skos:prefLabel "create"@en ;
      rdfs:comment "Task activity capturing the creation of the database for the new application."@en .

  cs2023c:TaskActivity_Systems4_Index
      a ontoksd:TaskActivity ;
      rdfs:label "index"@en ;
      skos:prefLabel "index"@en ;
      rdfs:comment "Task activity capturing the definition of appropriate indices for efficient and suitable database operation."@en .

  cs2023c:TaskConstraint_Systems4_SocialEthicalImplications
      a ontoksd:TaskConstraint ;
      rdfs:label "with assessment of social and ethical implications of collecting and storing data"@en ;
      skos:prefLabel "with assessment of social and ethical implications of collecting and storing data"@en ;
      rdfs:comment "Task constraint stating that database design must consider the social and ethical implications of collecting and storing application data."@en .

  cs2023c:TaskConstraint_Systems4_RDBMSvsNoSQL
      a ontoksd:TaskConstraint ;
      rdfs:label "with determination of an appropriate storage approach such as RDBMS or NoSQL"@en ;
      skos:prefLabel "with determination of an appropriate storage approach such as RDBMS or NoSQL"@en ;
      rdfs:comment "Task constraint stating that the database design must include a justified choice of storage approach, such as relational or NoSQL solutions, according to application needs."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Systems4_DM_Data_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "DM-Data × Develop"@en ;
      skos:prefLabel "DM-Data × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates DM-Data knowledge with the CS2023 skill level Develop in the design and creation of a database for a new application."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_DM_Data_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_DM_Core_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "DM-Core × Develop"@en ;
      skos:prefLabel "DM-Core × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates DM-Core knowledge with the CS2023 skill level Develop in core database design and implementation decisions."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_DM_Core_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_DM_Modeling_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "DM-Modeling × Develop"@en ;
      skos:prefLabel "DM-Modeling × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates DM-Modeling knowledge with the CS2023 skill level Develop in modeling the data storage needs of the new application."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_DM_Modeling_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_DM_Relational_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "DM-Relational × Develop"@en ;
      skos:prefLabel "DM-Relational × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates DM-Relational knowledge with the CS2023 skill level Develop in relational database design and implementation."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_DM_Relational_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_DM_NoSQL_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "DM-NoSQL × Develop"@en ;
      skos:prefLabel "DM-NoSQL × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates DM-NoSQL knowledge with the CS2023 skill level Develop in determining whether non-relational storage is appropriate for the application."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_DM_NoSQL_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_DM_Internals_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "DM-Internals × Develop"@en ;
      skos:prefLabel "DM-Internals × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates DM-Internals knowledge with the CS2023 skill level Develop in creating database structures and appropriate indices."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_DM_Internals_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_SEP_Context_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Context × Develop"@en ;
      skos:prefLabel "SEP-Context × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates SEP-Context knowledge with the CS2023 skill level Develop in designing data solutions that are sensitive to stakeholder and contextual factors."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Context_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_SEP_Ethical_Analysis_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Ethical-Analysis × Develop"@en ;
      skos:prefLabel "SEP-Ethical-Analysis × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates SEP-Ethical-Analysis knowledge with the CS2023 skill level Develop in incorporating ethical analysis into database design decisions."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Ethical_Analysis_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_SEP_Privacy_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Privacy × Develop"@en ;
      skos:prefLabel "SEP-Privacy × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates SEP-Privacy knowledge with the CS2023 skill level Develop in designing data storage solutions that preserve privacy."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Privacy_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_SEP_Professional_Ethics_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Professional-Ethics × Develop"@en ;
      skos:prefLabel "SEP-Professional-Ethics × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates SEP-Professional-Ethics knowledge with the CS2023 skill level Develop in responsibly designing and implementing database solutions."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Professional_Ethics_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_SEP_Security_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Security × Develop"@en ;
      skos:prefLabel "SEP-Security × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates SEP-Security knowledge with the CS2023 skill level Develop in incorporating security concerns into database creation and data storage decisions."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Security_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_SEP_DEIA_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-DEIA × Develop"@en ;
      skos:prefLabel "SEP-DEIA × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates SEP-DEIA knowledge with the CS2023 skill level Develop in considering diverse stakeholder impacts in database and data-storage design."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_DEIA_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems4_SEC_Foundations_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEC-Foundations × Develop"@en ;
      skos:prefLabel "SEC-Foundations × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems4. It associates SEC-Foundations knowledge with the CS2023 skill level Develop in implementing secure and appropriate database foundations for a new application."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEC_Foundations_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

}