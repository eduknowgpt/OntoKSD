PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom: <http://purl.org/edu/bloom#>


############# PARES KS ################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:DM-Data              ontoksd:cs2023DevelopSkill)
    (cs2023:DM-Core              ontoksd:cs2023DevelopSkill)
    (cs2023:DM-Modeling          ontoksd:cs2023DevelopSkill)
    (cs2023:DM-Relational        ontoksd:cs2023DevelopSkill)
    (cs2023:DM-NoSQL             ontoksd:cs2023DevelopSkill)
    (cs2023:DM-Internals         ontoksd:cs2023DevelopSkill)
    (cs2023:SEP-Context          ontoksd:cs2023DevelopSkill)
    (cs2023:SEP-Ethical-Analysis ontoksd:cs2023DevelopSkill)
    (cs2023:SEP-Privacy          ontoksd:cs2023DevelopSkill)
    (cs2023:SEP-Professional-Ethics ontoksd:cs2023DevelopSkill)
    (cs2023:SEP-Security         ontoksd:cs2023DevelopSkill)
    (cs2023:SEP-DEIA             ontoksd:cs2023DevelopSkill)
    (cs2023:SEC-Foundations      ontoksd:cs2023DevelopSkill)
  }
  FILTER NOT EXISTS { ?existing a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s . }
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}
;

############# COMPETÊNCIA ################
INSERT {
  ontoksd:competence_CS2023_Systems4 a ontoksd:Competence ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
    dcterms:title "Create a database for a new application"@en ;
    dcterms:description "Design the data storage needs, assess ethical implications, choose a suitable database type, and create the database with appropriate indices."@en ;
    dcterms:source "CS2023 Competence Report"@en ;
    skos:notation "CS2023 Competence - Systems4"@en ;
    ontoksd:hasDisposition ontoksd:inventive ,
                           ontoksd:meticulous ,
                           ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE { ?ks a ontoksd:KnowledgeSkill . }


############# VERBOS ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2023:DM-Data              ontoksd:cs2023DevelopSkill bloom:design)
    (cs2023:DM-Core              ontoksd:cs2023DevelopSkill bloom:construct)
    (cs2023:DM-Modeling          ontoksd:cs2023DevelopSkill bloom:model)
    (cs2023:DM-Relational        ontoksd:cs2023DevelopSkill bloom:implement)
    (cs2023:DM-NoSQL             ontoksd:cs2023DevelopSkill bloom:select)
    (cs2023:DM-Internals         ontoksd:cs2023DevelopSkill bloom:optimize)
    (cs2023:SEP-Context          ontoksd:cs2023DevelopSkill bloom:analyze)
    (cs2023:SEP-Ethical-Analysis ontoksd:cs2023DevelopSkill bloom:assess)
    (cs2023:SEP-Privacy          ontoksd:cs2023DevelopSkill bloom:ensure)
    (cs2023:SEP-Professional-Ethics ontoksd:cs2023DevelopSkill bloom:consider)
    (cs2023:SEP-Security         ontoksd:cs2023DevelopSkill bloom:apply)
    (cs2023:SEP-DEIA             ontoksd:cs2023DevelopSkill bloom:address)
    (cs2023:SEC-Foundations      ontoksd:cs2023DevelopSkill bloom:implement)
  }
  ?ks a ontoksd:KnowledgeSkill .
}
