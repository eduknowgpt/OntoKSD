PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom: <http://purl.org/edu/bloom#>

############# PARES KS ################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:AI-ML  ontoksd:cs2023ApplySkill)
    (cs2023:AI-ML  ontoksd:cs2023DevelopSkill)
    (cs2023:AI-SEP ontoksd:cs2023ApplySkill)
    (cs2023:AI-SEP ontoksd:cs2023DevelopSkill)
  }
  FILTER NOT EXISTS { ?existing a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s . }
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}
;

############# COMPETÊNCIA ################
INSERT {
  ontoksd:competence_CS2023_Applications2 a ontoksd:Competence ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
    dcterms:title "Analyze tabular data (e.g., customer purchases) to identify trends and predict variables of interest."@en ;
    dcterms:description "Use machine learning libraries, data preprocessing, training infrastructures, and evaluation methodologies to create a basic supervised learning pipeline."@en ;
    dcterms:source "CS2023 Competence Report"@en ;
    skos:notation "CS2023 Competence - Applications2"@en ;
    ontoksd:hasDisposition ontoksd:meticulous ,
                           ontoksd:persistent ,
                           ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE { ?ks a ontoksd:KnowledgeSkill . }
;

############# VERBOS ################
INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2023:AI-ML  ontoksd:cs2023ApplySkill   bloom:apply)
    (cs2023:AI-ML  ontoksd:cs2023DevelopSkill bloom:implement)
    (cs2023:AI-SEP ontoksd:cs2023ApplySkill   bloom:analyze)
    (cs2023:AI-SEP ontoksd:cs2023DevelopSkill bloom:develop)
  }
  ?ks a ontoksd:KnowledgeSkill .
}
