PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom: <http://purl.org/edu/bloom#>

############# PARES KS ################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:AR-Heterogeneity ontoksd:cs2023EvaluateSkill)
    (cs2023:AR-Heterogeneity ontoksd:cs2023DevelopSkill)
    (cs2023:PDC-Programs     ontoksd:cs2023EvaluateSkill)
    (cs2023:PDC-Programs     ontoksd:cs2023DevelopSkill)
    (cs2023:SF-Design        ontoksd:cs2023EvaluateSkill)
    (cs2023:SF-Design        ontoksd:cs2023DevelopSkill)
  }
  FILTER NOT EXISTS { ?existing a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s . }
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}
;

############# COMPETÊNCIA ################
INSERT {
  ontoksd:competence_CS2023_Systems1 a ontoksd:Competence ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
    dcterms:title "Develop a version of a CPU-based application to run on a hardware accelerator"@en ;
    dcterms:description "Apply knowledge from systems design to accelerate an application code and evaluate the code speed-up."@en ;
    dcterms:source "CS2023 Competence Report"@en ;
    skos:notation "CS2023 Competence - Systems1"@en ;
    ontoksd:hasDisposition ontoksd:meticulous ,
                           ontoksd:inventive ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:AR-Heterogeneity ontoksd:cs2023EvaluateSkill)
    (cs2023:AR-Heterogeneity ontoksd:cs2023DevelopSkill)
    (cs2023:PDC-Programs     ontoksd:cs2023EvaluateSkill)
    (cs2023:PDC-Programs     ontoksd:cs2023DevelopSkill)
    (cs2023:SF-Design        ontoksd:cs2023EvaluateSkill)
    (cs2023:SF-Design        ontoksd:cs2023DevelopSkill)
  }
  ?ks a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s .
}
;

############# VERBOS ################
INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2023:AR-Heterogeneity ontoksd:cs2023DevelopSkill bloom:implement)
    (cs2023:AR-Heterogeneity ontoksd:cs2023EvaluateSkill bloom:evaluate)
    (cs2023:PDC-Programs     ontoksd:cs2023DevelopSkill bloom:parallelize)
    (cs2023:PDC-Programs     ontoksd:cs2023EvaluateSkill bloom:measure)
    (cs2023:SF-Design        ontoksd:cs2023DevelopSkill bloom:design)
    (cs2023:SF-Design        ontoksd:cs2023EvaluateSkill bloom:analyze)
  }
  ?ks a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s .
}
