PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Systems1
      a ontoksd:Competence ;
      rdfs:label "Apply knowledge from systems design to accelerate an application code and evaluate the code speed-up"@en ;
      skos:prefLabel "Apply knowledge from systems design to accelerate an application code and evaluate the code speed-up"@en ;
      skos:definition "Apply knowledge from systems design to accelerate an application code and evaluate the code speed-up."@en ;
      rdfs:comment "Competence derived from the CS2023 Systems Competency Area, Task Systems1. Since the task explicitly combines development of an accelerator-ready version of a CPU-based application and evaluation of the achieved code speed-up, this formalization distributes the required CS2023 skill levels across the selected knowledge elements: Develop for the knowledge mobilized in adaptation and acceleration, and Evaluate for the knowledge mobilized in performance judgment."@en ;
      dcterms:identifier "Systems1"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Systems1 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Systems1_AR_Heterogeneity_3_Develop ,
          cs2023c:KS_Systems1_PDC_Programs_3_e_Develop ,
          cs2023c:KS_Systems1_SF_Design_1_Evaluate ;
      ontoksd:hasDisposition
          ontoksd:meticulous ,
          ontoksd:inventive ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Systems1
      a ontoksd:Task ;
      rdfs:label "Systems1 task"@en ;
      skos:prefLabel "Systems1 task"@en ;
      ontoksd:hasTaskStatement "Develop a version of a CPU-based application to run on a hardware accelerator (GPU, TPU, NPU)."@en ;
      rdfs:comment "Specification-level task associated with Competence_Systems1. The task concerns adapting a CPU-based application to execute on a hardware accelerator and evaluating the resulting speed-up."@en ;
      dcterms:identifier "Task_Systems1"^^xsd:string ;
      ontoksd:hasTaskComponent
          cs2023c:TaskComponent_Systems1_CPUBasedApplication ,
          cs2023c:TaskComponent_Systems1_AcceleratedApplicationVersion ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Systems1_Adapt ,
          cs2023c:TaskActivity_Systems1_Develop ,
          cs2023c:TaskActivity_Systems1_Accelerate ,
          cs2023c:TaskActivity_Systems1_Evaluate ;
      ontoksd:hasTaskConstraint
          cs2023c:TaskConstraint_Systems1_HardwareAccelerator ,
          cs2023c:TaskConstraint_Systems1_CodeSpeedup .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Systems1_CPUBasedApplication
      a ontoksd:TaskComponent ;
      rdfs:label "CPU-based application"@en ;
      skos:prefLabel "CPU-based application"@en ;
      rdfs:comment "Task component corresponding to the original application designed to run on a CPU."@en .

  cs2023c:TaskComponent_Systems1_AcceleratedApplicationVersion
      a ontoksd:TaskComponent ;
      rdfs:label "accelerated version of the application"@en ;
      skos:prefLabel "accelerated version of the application"@en ;
      rdfs:comment "Task component corresponding to the new version of the application adapted to run on a hardware accelerator."@en .

  cs2023c:TaskActivity_Systems1_Adapt
      a ontoksd:TaskActivity ;
      rdfs:label "adapt"@en ;
      skos:prefLabel "adapt"@en ;
      rdfs:comment "Task activity capturing the adaptation of a CPU-based application for execution on a hardware accelerator."@en .

  cs2023c:TaskActivity_Systems1_Develop
      a ontoksd:TaskActivity ;
      rdfs:label "develop"@en ;
      skos:prefLabel "develop"@en ;
      rdfs:comment "Task activity capturing the development of an accelerator-ready version of the application."@en .

  cs2023c:TaskActivity_Systems1_Accelerate
      a ontoksd:TaskActivity ;
      rdfs:label "accelerate"@en ;
      skos:prefLabel "accelerate"@en ;
      rdfs:comment "Task activity capturing the use of heterogeneous hardware to improve application performance."@en .

  cs2023c:TaskActivity_Systems1_Evaluate
      a ontoksd:TaskActivity ;
      rdfs:label "evaluate"@en ;
      skos:prefLabel "evaluate"@en ;
      rdfs:comment "Task activity capturing the evaluation of the speed-up achieved by the accelerated version of the application."@en .

  cs2023c:TaskConstraint_Systems1_HardwareAccelerator
      a ontoksd:TaskConstraint ;
      rdfs:label "to run on a hardware accelerator (GPU, TPU, NPU)"@en ;
      skos:prefLabel "to run on a hardware accelerator (GPU, TPU, NPU)"@en ;
      rdfs:comment "Task constraint stating that the developed version of the application must target a hardware accelerator such as a GPU, TPU, or NPU."@en .

  cs2023c:TaskConstraint_Systems1_CodeSpeedup
      a ontoksd:TaskConstraint ;
      rdfs:label "with evaluation of the achieved code speed-up"@en ;
      skos:prefLabel "with evaluation of the achieved code speed-up"@en ;
      rdfs:comment "Task constraint stating that the task includes judging the performance gain obtained by the accelerated application."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Systems1_AR_Heterogeneity_3_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Domain-Specific Architectures (DSAs) × Develop"@en ;
      skos:prefLabel "Domain-Specific Architectures (DSAs) × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems1. It associates AR-Heterogeneity knowledge with the CS2023 skill level Develop in the context of creating an accelerator-ready version of an application."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AR_Heterogeneity_3 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems1_PDC_Programs_3_e_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Granularity: execution cost of action bodies should outweigh the overhead of arranging them × Develop"@en ;
      skos:prefLabel "Granularity: execution cost of action bodies should outweigh the overhead of arranging them × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems1. It associates PDC-Programs knowledge with the CS2023 skill level Develop in the context of restructuring application code for efficient accelerated execution."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_PDC_Programs_3_e ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

  cs2023c:KS_Systems1_SF_Design_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Common criteria of system design (e.g., liveness, safety, robustness, scalability, and security) × Evaluate"@en ;
      skos:prefLabel "Common criteria of system design (e.g., liveness, safety, robustness, scalability, and security) × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Systems1. It associates systems-design knowledge with the CS2023 skill level Evaluate in the context of judging the achieved code speed-up and the quality of the accelerated solution."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SF_Design_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

}