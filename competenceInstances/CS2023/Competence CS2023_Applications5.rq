PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Applications5
      a ontoksd:Competence ;
      rdfs:label "Apply knowledge of usability, accessibility, and inclusivity to evaluate a user-facing system"@en ;
      skos:prefLabel "Apply knowledge of usability, accessibility, and inclusivity to evaluate a user-facing system"@en ;
      skos:definition "Apply knowledge of usability, accessibility, and inclusivity to evaluate a user-facing system."@en ;
      rdfs:comment "Competence derived from the CS2023 Applications Competency Area, Task Applications5. The competence is specified through explicit KnowledgeSkill pairs and the desirable professional dispositions associated with the task. Since the CS2023 statement assigns the skill level Evaluate, the selected knowledge elements are represented with that required skill level."@en ;
      dcterms:identifier "Applications5"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Applications5 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Applications5_HCI_User_1_Evaluate ,
          cs2023c:KS_Applications5_HCI_Accessibility_1_Evaluate ,
          cs2023c:KS_Applications5_HCI_Evaluation_1_Evaluate ,
          cs2023c:KS_Applications5_HCI_Design_1_Evaluate ,
          cs2023c:KS_Applications5_HCI_SEP_1_Evaluate ;
      ontoksd:hasDisposition
          ontoksd:meticulous ,
          ontoksd:responsible ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Applications5
      a ontoksd:Task ;
      rdfs:label "Applications5 task"@en ;
      skos:prefLabel "Applications5 task"@en ;
      ontoksd:hasTaskStatement "Evaluate and provide recommendations to improve a user-facing system."@en ;
      rdfs:comment "Specification-level task associated with Competence_Applications5. The task concerns evaluating a user-facing system and producing recommendations for improvement based on usability, accessibility, and inclusivity considerations."@en ;
      dcterms:identifier "Task_Applications5"^^xsd:string ;
      ontoksd:hasTaskComponent
          cs2023c:TaskComponent_Applications5_UserFacingSystem ,
          cs2023c:TaskComponent_Applications5_Recommendations ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Applications5_Evaluate ,
          cs2023c:TaskActivity_Applications5_Recommend ,
          cs2023c:TaskActivity_Applications5_Improve ;
      ontoksd:hasTaskConstraint
          cs2023c:TaskConstraint_Applications5_UsabilityAccessibilityInclusivity .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Applications5_UserFacingSystem
      a ontoksd:TaskComponent ;
      rdfs:label "user-facing system"@en ;
      skos:prefLabel "user-facing system"@en ;
      rdfs:comment "Task component corresponding to the interactive system to be evaluated."@en .

  cs2023c:TaskComponent_Applications5_Recommendations
      a ontoksd:TaskComponent ;
      rdfs:label "recommendations for improvement"@en ;
      skos:prefLabel "recommendations for improvement"@en ;
      rdfs:comment "Task component corresponding to the recommendations produced from the evaluation."@en .

  cs2023c:TaskActivity_Applications5_Evaluate
      a ontoksd:TaskActivity ;
      rdfs:label "evaluate"@en ;
      skos:prefLabel "evaluate"@en ;
      rdfs:comment "Task activity capturing the evaluation of the user-facing system."@en .

  cs2023c:TaskActivity_Applications5_Recommend
      a ontoksd:TaskActivity ;
      rdfs:label "recommend"@en ;
      skos:prefLabel "recommend"@en ;
      rdfs:comment "Task activity capturing the formulation of recommendations to improve the system."@en .

  cs2023c:TaskActivity_Applications5_Improve
      a ontoksd:TaskActivity ;
      rdfs:label "improve"@en ;
      skos:prefLabel "improve"@en ;
      rdfs:comment "Task activity capturing the orientation of the evaluation toward system improvement."@en .

  cs2023c:TaskConstraint_Applications5_UsabilityAccessibilityInclusivity
      a ontoksd:TaskConstraint ;
      rdfs:label "with respect to usability, accessibility, and inclusivity"@en ;
      skos:prefLabel "with respect to usability, accessibility, and inclusivity"@en ;
      rdfs:comment "Task constraint stating that the evaluation must be grounded in usability, accessibility, and inclusivity considerations."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Applications5_HCI_User_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "HCI-User × Evaluate"@en ;
      skos:prefLabel "HCI-User × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications5. It associates HCI-User knowledge with the CS2023 skill level Evaluate in assessing the quality of user interaction and experience in a user-facing system."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_HCI_User_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

  cs2023c:KS_Applications5_HCI_Accessibility_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "HCI-Accessibility × Evaluate"@en ;
      skos:prefLabel "HCI-Accessibility × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications5. It associates HCI-Accessibility knowledge with the CS2023 skill level Evaluate in assessing how well the system supports accessible use."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_HCI_Accessibility_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

  cs2023c:KS_Applications5_HCI_Evaluation_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "HCI-Evaluation × Evaluate"@en ;
      skos:prefLabel "HCI-Evaluation × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications5. It associates HCI-Evaluation knowledge with the CS2023 skill level Evaluate in carrying out and interpreting the system evaluation."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_HCI_Evaluation_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

  cs2023c:KS_Applications5_HCI_Design_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "HCI-Design × Evaluate"@en ;
      skos:prefLabel "HCI-Design × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications5. It associates HCI-Design knowledge with the CS2023 skill level Evaluate in judging design choices and recommending improvements."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_HCI_Design_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

  cs2023c:KS_Applications5_HCI_SEP_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "HCI-SEP × Evaluate"@en ;
      skos:prefLabel "HCI-SEP × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications5. It associates HCI-SEP knowledge with the CS2023 skill level Evaluate in considering social, ethical, and participatory implications relevant to inclusivity in the user-facing system."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_HCI_SEP_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

}