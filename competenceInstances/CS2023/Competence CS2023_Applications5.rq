PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom: <http://purl.org/edu/bloom#>

############# PARES KS ################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:HCI-User         ontoksd:cs2023EvaluateSkill)
    (cs2023:HCI-Accessibility ontoksd:cs2023EvaluateSkill)
    (cs2023:HCI-Evaluation   ontoksd:cs2023EvaluateSkill)
    (cs2023:HCI-Design       ontoksd:cs2023EvaluateSkill)
    (cs2023:HCI-SEP          ontoksd:cs2023EvaluateSkill)
  }
  FILTER NOT EXISTS { ?existing a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s . }
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}
;

############# COMPETÊNCIA ################
INSERT {
  ontoksd:competence_CS2023_Applications5 a ontoksd:Competence ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
    dcterms:title "Evaluate and provide recommendations to improve a user-facing system"@en ;
    dcterms:description "Apply knowledge of usability, accessibility, and inclusivity to evaluate a user-facing system."@en ;
    dcterms:source "CS2023 Competence Report"@en ;
    skos:notation "CS2023 Competence - Applications5"@en ;
    ontoksd:hasDisposition ontoksd:meticulous ,
                           ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE { ?ks a ontoksd:KnowledgeSkill . }
;

############# VERBOS ################
INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2023:HCI-User          ontoksd:cs2023EvaluateSkill bloom:evaluate)
    (cs2023:HCI-Accessibility ontoksd:cs2023EvaluateSkill bloom:assess)
    (cs2023:HCI-Evaluation    ontoksd:cs2023EvaluateSkill bloom:analyze)
    (cs2023:HCI-Design        ontoksd:cs2023EvaluateSkill bloom:judge)
    (cs2023:HCI-SEP           ontoksd:cs2023EvaluateSkill bloom:consider)
  }
  ?ks a ontoksd:KnowledgeSkill .
}
