PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Software2
      a ontoksd:Competence ;
      rdfs:label "Communicate clearly and collaboratively to provide feedback to a teammate about a piece of code"@en ;
      skos:prefLabel "Communicate clearly and collaboratively to provide feedback to a teammate about a piece of code"@en ;
      skos:definition "Communicate clearly and collaboratively to provide feedback to a teammate about a piece of code."@en ;
      rdfs:comment "Competence derived from the CS2023 Software Competency Area, Task Software2. The competence is specified through explicit KnowledgeSkill pairs and the desirable professional dispositions associated with the task."@en ;
      dcterms:identifier "Software2"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Software2 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Software2_SDF_Practices_3_Apply ,
          cs2023c:KS_Software2_SE_Teamwork_3_b_Apply ,
          cs2023c:KS_Software2_SE_Validation_10_a_Apply ;
      ontoksd:hasDisposition
          ontoksd:collaborative ,
          ontoksd:communicative ,
          ontoksd:meticulous ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Software2
      a ontoksd:Task ;
      rdfs:label "Software2 task"@en ;
      skos:prefLabel "Software2 task"@en ;
      ontoksd:hasTaskStatement "Perform code review for a teammate."@en ;
      rdfs:comment "Specification-level task associated with Competence_Software2. The task is centered on reviewing a teammate's code and communicating feedback in a clear and collaborative manner."@en ;
      dcterms:identifier "Task_Software2"^^xsd:string ;
      ontoksd:hasTaskComponent cs2023c:TaskComponent_Software2_CodeArtifact ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Software2_Review ,
          cs2023c:TaskActivity_Software2_Communicate ,
          cs2023c:TaskActivity_Software2_ProvideFeedback ;
      ontoksd:hasTaskConstraint cs2023c:TaskConstraint_Software2_TeammateContext .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Software2_CodeArtifact
      a ontoksd:TaskComponent ;
      rdfs:label "a piece of code"@en ;
      skos:prefLabel "a piece of code"@en ;
      rdfs:comment "Task component corresponding to the code artifact that is examined and discussed in the review process."@en .

  cs2023c:TaskActivity_Software2_Review
      a ontoksd:TaskActivity ;
      rdfs:label "review"@en ;
      skos:prefLabel "review"@en ;
      rdfs:comment "Task activity capturing the examination of a code artifact with the aim of identifying issues, strengths, and opportunities for improvement."@en .

  cs2023c:TaskActivity_Software2_Communicate
      a ontoksd:TaskActivity ;
      rdfs:label "communicate"@en ;
      skos:prefLabel "communicate"@en ;
      rdfs:comment "Task activity capturing the need to express observations and judgments clearly to another team member."@en .

  cs2023c:TaskActivity_Software2_ProvideFeedback
      a ontoksd:TaskActivity ;
      rdfs:label "provide feedback"@en ;
      skos:prefLabel "provide feedback"@en ;
      rdfs:comment "Task activity capturing the act of offering constructive and actionable feedback about the reviewed code."@en .

  cs2023c:TaskConstraint_Software2_TeammateContext
      a ontoksd:TaskConstraint ;
      rdfs:label "to a teammate, clearly and collaboratively"@en ;
      skos:prefLabel "to a teammate, clearly and collaboratively"@en ;
      rdfs:comment "Task constraint that qualifies the social and interactional context of the task: the review is addressed to a teammate and must be conducted through clear and collaborative communication."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Software2_SDF_Practices_3_Apply
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Programming style that improves readability × Apply"@en ;
      skos:prefLabel "Programming style that improves readability × Apply"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software2. It associates the SDF-Practices knowledge related to programming style and readability with the CS2023 skill level required in a code review context."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SDF_Practices_3 ;
      ontoksd:hasRequiredSkillLevel cs2023:Apply .

  cs2023c:KS_Software2_SE_Teamwork_3_b_Apply
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Code review × Apply"@en ;
      skos:prefLabel "Code review × Apply"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software2. It associates the SE-Teamwork knowledge element explicitly concerned with code review with the CS2023 skill level required when reviewing a teammate's code."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Teamwork_3_b ;
      ontoksd:hasRequiredSkillLevel cs2023:Apply .

  cs2023c:KS_Software2_SE_Validation_10_a_Apply
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Static analysis × Apply"@en ;
      skos:prefLabel "Static analysis × Apply"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software2. It associates the SE-Validation knowledge element 'Static analysis' with the CS2023 skill level required to support verification-oriented judgment during code review."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Validation_10_a ;
      ontoksd:hasRequiredSkillLevel cs2023:Apply .

}