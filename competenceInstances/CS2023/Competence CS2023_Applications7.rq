PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Applications7
      a ontoksd:Competence ;
      rdfs:label "Gather information regarding accountability, responsibility and liability assumed by a company when releasing a service/software/product and present it in a coherent and actionable manner"@en ;
      skos:prefLabel "Gather information regarding accountability, responsibility and liability assumed by a company when releasing a service/software/product and present it in a coherent and actionable manner"@en ;
      skos:definition "Gather information regarding accountability, responsibility and liability assumed by a company when releasing a service/software/product and present it in a coherent and actionable manner."@en ;
      rdfs:comment "Competence derived from the CS2023 Applications Competency Area, Task Applications7. The competence is specified through explicit KnowledgeSkill pairs and the desirable professional dispositions associated with the task. Since the CS2023 statement assigns the skill level Explain, the selected knowledge elements are represented with that required skill level."@en ;
      dcterms:identifier "Applications7"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Applications7 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Applications7_SEP_Professional_Ethics_1_Explain ,
          cs2023c:KS_Applications7_SEP_IP_1_Explain ,
          cs2023c:KS_Applications7_SEP_Privacy_1_Explain ,
          cs2023c:KS_Applications7_SEP_Communication_1_Explain ,
          cs2023c:KS_Applications7_SEP_DEIA_1_Explain ;
      ontoksd:hasDisposition
          ontoksd:meticulous ,
          ontoksd:proactive ,
          ontoksd:responsible ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Applications7
      a ontoksd:Task ;
      rdfs:label "Applications7 task"@en ;
      skos:prefLabel "Applications7 task"@en ;
      ontoksd:hasTaskStatement "Document the professional implications of a service/software/product for the company that produced it."@en ;
      rdfs:comment "Specification-level task associated with Competence_Applications7. The task concerns gathering and organizing information about accountability, responsibility, and liability assumed by a company when releasing a service, software system, or product, and presenting that information in a coherent and actionable manner."@en ;
      dcterms:identifier "Task_Applications7"^^xsd:string ;
      ontoksd:hasTaskComponent
          cs2023c:TaskComponent_Applications7_ServiceSoftwareProduct ,
          cs2023c:TaskComponent_Applications7_ProfessionalImplicationsDocumentation ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Applications7_Gather ,
          cs2023c:TaskActivity_Applications7_Document ,
          cs2023c:TaskActivity_Applications7_Present ,
          cs2023c:TaskActivity_Applications7_Explain ;
      ontoksd:hasTaskConstraint
          cs2023c:TaskConstraint_Applications7_CompanyRelease ,
          cs2023c:TaskConstraint_Applications7_CoherentActionablePresentation .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Applications7_ServiceSoftwareProduct
      a ontoksd:TaskComponent ;
      rdfs:label "service/software/product"@en ;
      skos:prefLabel "service/software/product"@en ;
      rdfs:comment "Task component corresponding to the service, software, or product whose professional implications are to be documented."@en .

  cs2023c:TaskComponent_Applications7_ProfessionalImplicationsDocumentation
      a ontoksd:TaskComponent ;
      rdfs:label "documentation of professional implications"@en ;
      skos:prefLabel "documentation of professional implications"@en ;
      rdfs:comment "Task component corresponding to the organized documentation that presents accountability, responsibility, and liability implications for the producing company."@en .

  cs2023c:TaskActivity_Applications7_Gather
      a ontoksd:TaskActivity ;
      rdfs:label "gather"@en ;
      skos:prefLabel "gather"@en ;
      rdfs:comment "Task activity capturing the gathering of relevant information concerning accountability, responsibility, and liability."@en .

  cs2023c:TaskActivity_Applications7_Document
      a ontoksd:TaskActivity ;
      rdfs:label "document"@en ;
      skos:prefLabel "document"@en ;
      rdfs:comment "Task activity capturing the documentation of the professional implications associated with release of the service, software, or product."@en .

  cs2023c:TaskActivity_Applications7_Present
      a ontoksd:TaskActivity ;
      rdfs:label "present"@en ;
      skos:prefLabel "present"@en ;
      rdfs:comment "Task activity capturing the presentation of the gathered information in a coherent and actionable manner."@en .

  cs2023c:TaskActivity_Applications7_Explain
      a ontoksd:TaskActivity ;
      rdfs:label "explain"@en ;
      skos:prefLabel "explain"@en ;
      rdfs:comment "Task activity capturing the explanation of accountability, responsibility, liability, and related professional implications."@en .

  cs2023c:TaskConstraint_Applications7_CompanyRelease
      a ontoksd:TaskConstraint ;
      rdfs:label "when releasing a service/software/product"@en ;
      skos:prefLabel "when releasing a service/software/product"@en ;
      rdfs:comment "Task constraint stating that the analysis must concern the implications assumed by a company when releasing a service, software product, or other product."@en .

  cs2023c:TaskConstraint_Applications7_CoherentActionablePresentation
      a ontoksd:TaskConstraint ;
      rdfs:label "presented in a coherent and actionable manner"@en ;
      skos:prefLabel "presented in a coherent and actionable manner"@en ;
      rdfs:comment "Task constraint stating that the resulting documentation must be coherent, practically useful, and oriented toward action."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Applications7_SEP_Professional_Ethics_1_Explain
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Professional-Ethics × Explain"@en ;
      skos:prefLabel "SEP-Professional-Ethics × Explain"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications7. It associates SEP-Professional-Ethics knowledge with the CS2023 skill level Explain in articulating professional accountability, responsibility, and liability related to releasing a service, software system, or product."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Professional_Ethics_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Explain .

  cs2023c:KS_Applications7_SEP_IP_1_Explain
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-IP × Explain"@en ;
      skos:prefLabel "SEP-IP × Explain"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications7. It associates SEP-IP knowledge with the CS2023 skill level Explain in documenting intellectual property implications relevant to released services, software, or products."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_IP_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Explain .

  cs2023c:KS_Applications7_SEP_Privacy_1_Explain
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Privacy × Explain"@en ;
      skos:prefLabel "SEP-Privacy × Explain"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications7. It associates SEP-Privacy knowledge with the CS2023 skill level Explain in describing privacy-related responsibilities and liabilities of a company releasing a service, software system, or product."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Privacy_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Explain .

  cs2023c:KS_Applications7_SEP_Communication_1_Explain
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-Communication × Explain"@en ;
      skos:prefLabel "SEP-Communication × Explain"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications7. It associates SEP-Communication knowledge with the CS2023 skill level Explain in presenting professional implications in a coherent and actionable manner."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_Communication_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Explain .

  cs2023c:KS_Applications7_SEP_DEIA_1_Explain
      a ontoksd:KnowledgeSkill ;
      rdfs:label "SEP-DEIA × Explain"@en ;
      skos:prefLabel "SEP-DEIA × Explain"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications7. It associates SEP-DEIA knowledge with the CS2023 skill level Explain in articulating how professional implications may affect diverse groups and inclusion-related responsibilities."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SEP_DEIA_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Explain .

}