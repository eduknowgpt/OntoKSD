cs2023c:TaskConstraint_Systems6_ExecutionEnvironment a ontoksd:TaskConstraint ;
    rdfs:label "on an operating system/runtime/virtualized operating system/container"@en ;
    rdfs:comment "Task constraint stating that deployment must be performed in an execution environment such as an operating system, runtime, virtualized operating system, or container."@en ;
    skos:prefLabel "on an operating system/runtime/virtualized operating system/container"@en .

cs2023c:Task_Systems6 a ontoksd:Task ;
    rdfs:label "Systems6 task"@en ;
    dcterms:identifier "Task_Systems6"^^xsd:string ;
    ontoksd:hasTaskActivity cs2023c:TaskActivity_Systems6_Automate,
