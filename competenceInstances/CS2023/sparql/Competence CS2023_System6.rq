cs2023c:TaskConstraint_Systems6_ComponentExecutionMonitoring a ontoksd:TaskConstraint ;
    rdfs:label "with monitoring of component execution"@en ;
    rdfs:comment "Task constraint stating that the deployed component must have its execution monitored appropriately."@en ;
