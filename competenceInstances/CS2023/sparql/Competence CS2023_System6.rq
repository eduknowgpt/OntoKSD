    ontoksd:hasTaskStatement "Deploy an application component on an operating system/runtime/virtualized operating system/container."@en ;
    ontoksd:isTaskOf cs2023c:Competence_Systems6 ;
    rdfs:comment "Specification-level task associated with Competence_Systems6. The task concerns deploying an application component on an operating system, runtime, virtualized operating system, or container, while identifying and mitigating deployment problems, automating environment setup, and establishing monitoring of component execution."@en ;
    skos:prefLabel "Systems6 task"@en ;
    prov:wasDerivedFrom cs2023c:Source_Systems6 .

cs2023c:Competence_Systems6 a ontoksd:CS2023Competence,
        ontoksd:Competence,
