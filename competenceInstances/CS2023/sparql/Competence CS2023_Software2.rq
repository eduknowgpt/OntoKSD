    skos:prefLabel "SE-Teamwork × Apply"@en ;
    prov:wasDerivedFrom cs2023c:Source_Software2 .

cs2023c:KS_Software2_SE_Validation_10_a_Apply a ontoksd:KnowledgeSkill,
