# CS2023 Applications1; source requirements and explicit OntoKSD local assignments.
# INSERT-only instance data; load dependencies described in README.md.
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX level: <http://purl.org/edu/cs2023#>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
cs2023c:KS_Applications1_AI_KRR_1_Apply a ontoksd:KnowledgeSkill,
        owl:NamedIndividual ;
    rdfs:label "AI-KRR × Apply"@en ;
    ontoksd:hasKnowledgeComponent cs2023c:KnowledgeUnitContent_AI_KRR ;
    ontoksd:hasSkillLevel level:Apply ;
    ontoksd:isKnowledgeSkillOf cs2023c:Competence_Applications1 ;
    rdfs:comment "Local knowledge–level assignment for Applications1: AI-KRR at Apply. The unit and level occur in the source lists; the specific binding is a modeling decision. The source does not allocate each listed level to individual units. Multiple levels are not reduced by an assumed hierarchy."@en ;
    skos:prefLabel "AI-KRR × Apply"@en ;
    prov:wasDerivedFrom cs2023c:Source_Applications1 .

cs2023c:KS_Applications1_AI_Search_1_Develop a ontoksd:KnowledgeSkill,
        owl:NamedIndividual ;
    rdfs:label "AI-Search × Develop"@en ;
    ontoksd:hasKnowledgeComponent cs2023c:KnowledgeUnitContent_AI_Search ;
    ontoksd:hasSkillLevel level:Develop ;
    ontoksd:isKnowledgeSkillOf cs2023c:Competence_Applications1 ;
    rdfs:comment "Local knowledge–level assignment for Applications1: AI-Search at Develop. The unit and level occur in the source lists; the specific binding is a modeling decision. The source does not allocate each listed level to individual units. Multiple levels are not reduced by an assumed hierarchy."@en ;
    skos:prefLabel "AI-Search × Develop"@en ;
    prov:wasDerivedFrom cs2023c:Source_Applications1 .

cs2023c:TaskActivity_Applications1_Design a ontoksd:TaskActivity ;
    rdfs:label "design"@en ;
    rdfs:comment "Task activity capturing the design of the strategic decision-making approach for the game agent."@en ;
    skos:prefLabel "design"@en .

cs2023c:TaskActivity_Applications1_Develop a ontoksd:TaskActivity ;
    rdfs:label "develop"@en ;
    rdfs:comment "Task activity capturing the implementation of the agent and its game-solving algorithm."@en ;
    skos:prefLabel "develop"@en .

cs2023c:TaskComponent_Applications1_Computation a ontoksd:TaskComponent ;
    rdfs:label "algorithm for a two-player game"@en ;
    rdfs:comment "Task component corresponding to the computation, namely an algorithm designed for the specific problem of a two-player game."@en ;
    skos:prefLabel "algorithm for a two-player game"@en .

cs2023c:TaskConstraint_Applications1_AdversarialGame a ontoksd:TaskConstraint ;
    rdfs:label "for a two-player adversarial game"@en ;
    rdfs:comment "Task constraint stating that the solution must address a two-player adversarial game setting."@en ;
    skos:prefLabel "for a two-player adversarial game"@en .

cs2023c:TaskConstraint_Applications1_UncertainActions a ontoksd:TaskConstraint ;
    rdfs:label "with uncertain actions"@en ;
    rdfs:comment "Task constraint stating that the game includes uncertainty, motivating the use of chance-aware decision procedures such as expectiminimax."@en ;
    skos:prefLabel "with uncertain actions"@en .

cs2023c:Task_Applications1 a ontoksd:Task ;
    rdfs:label "Applications1 task"@en ;
    dcterms:identifier "Task_Applications1"^^xsd:string ;
    ontoksd:hasTaskActivity cs2023c:TaskActivity_Applications1_Design,
        cs2023c:TaskActivity_Applications1_Develop ;
    ontoksd:hasTaskComponent cs2023c:TaskComponent_Applications1_Computation ;
    ontoksd:hasTaskConstraint cs2023c:TaskConstraint_Applications1_AdversarialGame,
        cs2023c:TaskConstraint_Applications1_UncertainActions ;
    ontoksd:hasTaskStatement "Implement an agent to make strategic decisions in a two-player adversarial game with uncertain actions (e.g., a board game, strategic stock purchasing)."@en ;
    ontoksd:isTaskOf cs2023c:Competence_Applications1 ;
    rdfs:comment "Specification-level task associated with Competence_Applications1. This compound task concerns designing and developing an algorithmic agent for a specific two-player adversarial game with uncertain actions, using search-based decision procedures and heuristic evaluation."@en ;
    skos:prefLabel "Applications1 task"@en ;
    prov:wasDerivedFrom cs2023c:Source_Applications1 .

cs2023c:Competence_Applications1 a ontoksd:CS2023Competence,
        ontoksd:Competence,
        owl:NamedIndividual ;
    rdfs:label "Use minimax with alpha-beta pruning, possible chance nodes (expectiminimax), and heuristic move evaluation to solve a two-player zero-sum game"@en ;
    dcterms:identifier "Applications1"^^xsd:string ;
    dcterms:source cs2023:CS2023Document ;
    ontoksd:hasDisposition ontoksd:inventive,
        ontoksd:persistent ;
    ontoksd:hasKnowledgeSkill cs2023c:KS_Applications1_AI_KRR_1_Apply,
        cs2023c:KS_Applications1_AI_Search_1_Develop ;
    ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern ;
    ontoksd:hasTask cs2023c:Task_Applications1 ;
    rdfs:comment "OntoKSD representation of CS2023 example Applications1. The source record retains the complete, unpaired knowledge-unit and skill-level lists. KnowledgeSkill pairings are explicit local assignments and do not claim that CS2023 specifies those individual bindings. Task elements are an analytical interpretation of the reference task and competence statement."@en ;
    skos:definition "Use minimax with alpha-beta pruning, and possible chance nodes (expectiminimax), and heuristic move evaluation (at a particular depth) to solve a two-player zero-sum game."@en ;
    skos:prefLabel "Use minimax with alpha-beta pruning, possible chance nodes (expectiminimax), and heuristic move evaluation to solve a two-player zero-sum game"@en ;
    prov:wasDerivedFrom cs2023:CS2023Document,
        cs2023c:Source_Applications1 .

cs2023c:Source_Applications1 a prov:Entity ;
    dcterms:bibliographicCitation "Computer Science Curricula 2023, Competency Framework Examples, example Applications1, starting on printed page 403."@en ;
    dcterms:description "Task: Implement an agent to make strategic decisions in a two-player adversarial game with uncertain actions (e.g., a board game, strategic stock purchasing). Competency statement: Use minimax with alpha-beta pruning, and possible chance nodes (expectiminimax), and heuristic move evaluation (at a particular depth) to solve a two-player zero-sum game. Required knowledge: AI-Search, AI-KRR. Required skills: Apply, Develop. Desirable professional dispositions: Inventive, Persistent."@en ;
    dcterms:identifier "Applications1" ;
    dcterms:isPartOf cs2023:CS2023Document ;
    dcterms:requires cs2023:KU_AI_KRR,
        cs2023:KU_AI_Search,
        level:Apply,
        level:Develop .
}
