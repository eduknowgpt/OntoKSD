# CS2023 Applications2; source requirements and explicit OntoKSD local assignments.
# INSERT-only instance data; load dependencies described in README.md.
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX level: <http://purl.org/edu/cs2023#>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
cs2023c:KS_Applications2_AI_ML_1_Develop a ontoksd:KnowledgeSkill,
        owl:NamedIndividual ;
    rdfs:label "AI-ML × Develop"@en ;
    ontoksd:hasKnowledgeComponent cs2023c:KnowledgeUnitContent_AI_ML ;
    ontoksd:hasSkillLevel level:Develop ;
    ontoksd:isKnowledgeSkillOf cs2023c:Competence_Applications2 ;
    rdfs:comment "Local knowledge–level assignment for Applications2: AI-ML at Develop. The unit and level occur in the source lists; the specific binding is a modeling decision. The source does not allocate each listed level to individual units. Multiple levels are not reduced by an assumed hierarchy."@en ;
    skos:prefLabel "AI-ML × Develop"@en ;
    prov:wasDerivedFrom cs2023c:Source_Applications2 .

cs2023c:KS_Applications2_AI_SEP_1_Apply a ontoksd:KnowledgeSkill,
        owl:NamedIndividual ;
    rdfs:label "AI-SEP × Apply"@en ;
    ontoksd:hasKnowledgeComponent cs2023c:KnowledgeUnitContent_AI_SEP ;
    ontoksd:hasSkillLevel level:Apply ;
    ontoksd:isKnowledgeSkillOf cs2023c:Competence_Applications2 ;
    rdfs:comment "Local knowledge–level assignment for Applications2: AI-SEP at Apply. The unit and level occur in the source lists; the specific binding is a modeling decision. The source does not allocate each listed level to individual units. Multiple levels are not reduced by an assumed hierarchy."@en ;
    skos:prefLabel "AI-SEP × Apply"@en ;
    prov:wasDerivedFrom cs2023c:Source_Applications2 .

cs2023c:TaskActivity_Applications2_Analyze a ontoksd:TaskActivity ;
    rdfs:label "analyze"@en ;
    rdfs:comment "Task activity capturing the analysis of tabular data to identify patterns and relevant predictive targets."@en ;
    skos:prefLabel "analyze"@en .

cs2023c:TaskActivity_Applications2_Create a ontoksd:TaskActivity ;
    rdfs:label "create"@en ;
    rdfs:comment "Task activity capturing the creation of the supervised learning pipeline."@en ;
    skos:prefLabel "create"@en .

cs2023c:TaskActivity_Applications2_Evaluate a ontoksd:TaskActivity ;
    rdfs:label "evaluate"@en ;
    rdfs:comment "Task activity capturing the evaluation of model performance using appropriate methodologies."@en ;
    skos:prefLabel "evaluate"@en .

cs2023c:TaskActivity_Applications2_Predict a ontoksd:TaskActivity ;
    rdfs:label "predict"@en ;
    rdfs:comment "Task activity capturing the prediction of variables of interest from the analyzed data."@en ;
    skos:prefLabel "predict"@en .

cs2023c:TaskActivity_Applications2_Preprocess a ontoksd:TaskActivity ;
    rdfs:label "preprocess"@en ;
    rdfs:comment "Task activity capturing the preprocessing of data for supervised learning."@en ;
    skos:prefLabel "preprocess"@en .

cs2023c:TaskActivity_Applications2_Train a ontoksd:TaskActivity ;
    rdfs:label "train"@en ;
    rdfs:comment "Task activity capturing the training of models within the supervised learning pipeline."@en ;
    skos:prefLabel "train"@en .

cs2023c:TaskComponent_Applications2_SupervisedLearningPipeline a ontoksd:TaskComponent ;
    rdfs:label "basic supervised learning pipeline"@en ;
    rdfs:comment "Task component corresponding to the machine learning pipeline created to preprocess data, train a model, evaluate results, and predict variables of interest."@en ;
    skos:prefLabel "basic supervised learning pipeline"@en .

cs2023c:TaskComponent_Applications2_TabularData a ontoksd:TaskComponent ;
    rdfs:label "tabular data"@en ;
    rdfs:comment "Task component corresponding to the structured dataset, such as customer purchases, to be analyzed for trend identification and prediction."@en ;
    skos:prefLabel "tabular data"@en .

cs2023c:TaskConstraint_Applications2_TabularData a ontoksd:TaskConstraint ;
    rdfs:label "using tabular data"@en ;
    rdfs:comment "Task constraint stating that the analysis and prediction pipeline must be built over tabular data."@en ;
    skos:prefLabel "using tabular data"@en .

cs2023c:TaskConstraint_Applications2_TrendsAndPrediction a ontoksd:TaskConstraint ;
    rdfs:label "to identify trends and predict variables of interest"@en ;
    rdfs:comment "Task constraint stating that the pipeline must support both trend identification and prediction of variables of interest."@en ;
    skos:prefLabel "to identify trends and predict variables of interest"@en .

cs2023c:Task_Applications2 a ontoksd:Task ;
    rdfs:label "Applications2 task"@en ;
    dcterms:identifier "Task_Applications2"^^xsd:string ;
    ontoksd:hasTaskActivity cs2023c:TaskActivity_Applications2_Analyze,
        cs2023c:TaskActivity_Applications2_Create,
        cs2023c:TaskActivity_Applications2_Evaluate,
        cs2023c:TaskActivity_Applications2_Predict,
        cs2023c:TaskActivity_Applications2_Preprocess,
        cs2023c:TaskActivity_Applications2_Train ;
    ontoksd:hasTaskComponent cs2023c:TaskComponent_Applications2_SupervisedLearningPipeline,
        cs2023c:TaskComponent_Applications2_TabularData ;
    ontoksd:hasTaskConstraint cs2023c:TaskConstraint_Applications2_TabularData,
        cs2023c:TaskConstraint_Applications2_TrendsAndPrediction ;
    ontoksd:hasTaskStatement "Analyze tabular data (e.g., customer purchases) to identify trends and predict variables of interest."@en ;
    ontoksd:isTaskOf cs2023c:Competence_Applications2 ;
    rdfs:comment "Specification-level task associated with Competence_Applications2. The task concerns analyzing tabular data, such as customer purchases, in order to identify trends and predict variables of interest through the creation of a basic supervised learning pipeline."@en ;
    skos:prefLabel "Applications2 task"@en ;
    prov:wasDerivedFrom cs2023c:Source_Applications2 .

cs2023c:Competence_Applications2 a ontoksd:CS2023Competence,
        ontoksd:Competence,
        owl:NamedIndividual ;
    rdfs:label "Use machine learning libraries, data preprocessing, training infrastructures, and evaluation methodologies to create a basic supervised learning pipeline"@en ;
    dcterms:identifier "Applications2"^^xsd:string ;
    dcterms:source cs2023:CS2023Document ;
    ontoksd:hasDisposition ontoksd:meticulous,
        ontoksd:persistent,
        ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill cs2023c:KS_Applications2_AI_ML_1_Develop,
        cs2023c:KS_Applications2_AI_SEP_1_Apply ;
    ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern ;
    ontoksd:hasTask cs2023c:Task_Applications2 ;
    rdfs:comment "OntoKSD representation of CS2023 example Applications2. The source record retains the complete, unpaired knowledge-unit and skill-level lists. KnowledgeSkill pairings are explicit local assignments and do not claim that CS2023 specifies those individual bindings. Task elements are an analytical interpretation of the reference task and competence statement."@en ;
    skos:definition "Use machine learning libraries, data preprocessing, training infrastructures, and evaluation methodologies to create a basic supervised learning pipeline."@en ;
    skos:prefLabel "Use machine learning libraries, data preprocessing, training infrastructures, and evaluation methodologies to create a basic supervised learning pipeline"@en ;
    prov:wasDerivedFrom cs2023:CS2023Document,
        cs2023c:Source_Applications2 .

cs2023c:Source_Applications2 a prov:Entity ;
    dcterms:bibliographicCitation "Computer Science Curricula 2023, Competency Framework Examples, example Applications2, starting on printed page 404."@en ;
    dcterms:description "Task: Analyze tabular data (e.g., customer purchases) to identify trends and predict variables of interest. Competency statement: Use machine learning libraries, data preprocessing, training infrastructures, and evaluation methodologies to create a basic supervised learning pipeline. Required knowledge: AI-ML, AI-SEP. Required skills: Apply, Develop. Desirable professional dispositions: Meticulous, Persistent, Responsible."@en ;
    dcterms:identifier "Applications2" ;
    dcterms:isPartOf cs2023:CS2023Document ;
    dcterms:requires cs2023:KU_AI_ML,
        cs2023:KU_AI_SEP,
        level:Apply,
        level:Develop .
}
