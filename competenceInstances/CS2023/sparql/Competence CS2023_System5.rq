    ontoksd:hasTaskStatement "Evaluate the performance of a network."@en ;
    ontoksd:isTaskOf cs2023c:Competence_Systems5 ;
    rdfs:comment "Specification-level task associated with Competence_Systems5. The task concerns evaluating network performance in terms of latency, throughput, congestion, and service levels."@en ;
