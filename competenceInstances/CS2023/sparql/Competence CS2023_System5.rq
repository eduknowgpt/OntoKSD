    rdfs:label "evaluate"@en ;
    rdfs:comment "Task activity capturing the evaluative judgment of network performance."@en ;
    skos:prefLabel "evaluate"@en .

cs2023c:TaskActivity_Systems5_Measure a ontoksd:TaskActivity ;
    rdfs:label "measure"@en ;
    rdfs:comment "Task activity capturing the measurement of latency, throughput, congestion, and service levels."@en ;
    skos:prefLabel "measure"@en .

cs2023c:TaskComponent_Systems5_Network a ontoksd:TaskComponent ;
