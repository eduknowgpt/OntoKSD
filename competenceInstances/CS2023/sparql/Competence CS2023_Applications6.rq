cs2023c:TaskActivity_Applications6_Determine a ontoksd:TaskActivity ;
    rdfs:label "determine"@en ;
    rdfs:comment "Task activity capturing the determination of which aspects of the implementation require revision."@en ;
    skos:prefLabel "determine"@en .

cs2023c:TaskActivity_Applications6_Evaluate a ontoksd:TaskActivity ;
    rdfs:label "evaluate"@en ;
    rdfs:comment "Task activity capturing the evaluation of a system with respect to internationalization needs."@en ;
    skos:prefLabel "evaluate"@en .

cs2023c:TaskActivity_Applications6_Identify a ontoksd:TaskActivity ;
    rdfs:label "identify"@en ;
    rdfs:comment "Task activity capturing the identification of locale-sensitive text, symbols, and patterns."@en ;
    skos:prefLabel "identify"@en .

cs2023c:TaskActivity_Applications6_Revise a ontoksd:TaskActivity ;
    rdfs:label "revise"@en ;
    rdfs:comment "Task activity capturing the orientation toward revision of implementation aspects to support internationalization."@en ;
    skos:prefLabel "revise"@en .

cs2023c:TaskComponent_Applications6_LocaleSensitiveElements a ontoksd:TaskComponent ;
    rdfs:label "culturally-relevant or language-relevant text, symbols, and patterns"@en ;
    rdfs:comment "Task component corresponding to the text, symbols, and interaction patterns that may vary by locale and therefore require revision."@en ;
    skos:prefLabel "culturally-relevant or language-relevant text, symbols, and patterns"@en .

cs2023c:TaskComponent_Applications6_SystemImplementation a ontoksd:TaskComponent ;
    rdfs:label "system implementation"@en ;
    rdfs:comment "Task component corresponding to the implemented system whose elements must be examined for internationalization support."@en ;
    skos:prefLabel "system implementation"@en .

cs2023c:TaskConstraint_Applications6_Internationalization a ontoksd:TaskConstraint ;
    rdfs:label "to support internationalization"@en ;
    rdfs:comment "Task constraint stating that the evaluation must be directed toward supporting internationalization in the system implementation."@en ;
    skos:prefLabel "to support internationalization"@en .

cs2023c:TaskConstraint_Applications6_LocaleVariation a ontoksd:TaskConstraint ;
    rdfs:label "with respect to elements that may vary by locale"@en ;
    rdfs:comment "Task constraint stating that the evaluation must consider text, symbols, and patterns whose meaning or appropriateness may differ across locales."@en ;
    skos:prefLabel "with respect to elements that may vary by locale"@en .

cs2023c:Task_Applications6 a ontoksd:Task ;
    rdfs:label "Applications6 task"@en ;
    dcterms:identifier "Task_Applications6"^^xsd:string ;
    ontoksd:hasTaskActivity cs2023c:TaskActivity_Applications6_Determine,
        cs2023c:TaskActivity_Applications6_Evaluate,
        cs2023c:TaskActivity_Applications6_Identify,
        cs2023c:TaskActivity_Applications6_Revise ;
    ontoksd:hasTaskComponent cs2023c:TaskComponent_Applications6_LocaleSensitiveElements,
        cs2023c:TaskComponent_Applications6_SystemImplementation ;
    ontoksd:hasTaskConstraint cs2023c:TaskConstraint_Applications6_Internationalization,
        cs2023c:TaskConstraint_Applications6_LocaleVariation ;
    ontoksd:hasTaskStatement "Determine the aspects of an implementation that require revision to support internationalization."@en ;
    ontoksd:isTaskOf cs2023c:Competence_Applications6 ;
    rdfs:comment "Specification-level task associated with Competence_Applications6. The task concerns evaluating an implemented system in order to determine which aspects must be revised to support internationalization, especially those involving locale-sensitive text, symbols, and interaction patterns."@en ;
    skos:prefLabel "Applications6 task"@en ;
    prov:wasDerivedFrom cs2023c:Source_Applications6 .

cs2023c:Competence_Applications6 a ontoksd:CS2023Competence,
        ontoksd:Competence,
        owl:NamedIndividual ;
    rdfs:label "Evaluate a system to identify culturally-relevant or language-relevant text, symbols, and patterns that may vary by locale"@en ;
    dcterms:identifier "Applications6"^^xsd:string ;
    dcterms:source cs2023:CS2023Document ;
    ontoksd:hasDisposition ontoksd:meticulous,
        ontoksd:proactive,
        ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill cs2023c:KS_Applications6_HCI_Accessibility_1_Evaluate,
        cs2023c:KS_Applications6_HCI_Accountability_1_Evaluate,
        cs2023c:KS_Applications6_HCI_Evaluation_1_Evaluate,
        cs2023c:KS_Applications6_HCI_User_1_Evaluate ;
    ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern ;
    ontoksd:hasTask cs2023c:Task_Applications6 ;
    rdfs:comment "OntoKSD representation of CS2023 example Applications6. The source record retains the complete, unpaired knowledge-unit and skill-level lists. KnowledgeSkill pairings are explicit local assignments and do not claim that CS2023 specifies those individual bindings. Task elements are an analytical interpretation of the reference task and competence statement."@en ;
    skos:definition "Evaluate a system to identify culturally-relevant or language-relevant text, symbols, and patterns that may vary by locale."@en ;
    skos:prefLabel "Evaluate a system to identify culturally-relevant or language-relevant text, symbols, and patterns that may vary by locale"@en ;
    prov:wasDerivedFrom cs2023:CS2023Document,
        cs2023c:Source_Applications6 .

cs2023c:Source_Applications6 a prov:Entity ;
    dcterms:bibliographicCitation "Computer Science Curricula 2023, Competency Framework Examples, example Applications6, starting on printed page 405."@en ;
    dcterms:description "Task: Determine the aspects of an implementation that require revision to support internationalization. Competency statement: Evaluate a system to identify culturally-relevant or language-relevant text, symbols, and patterns that may vary by locale. Required knowledge: HCI-User, HCI-Accountability, HCI-Accessibility, HCI-Evaluation. Required skills: Evaluate. Desirable professional dispositions: Meticulous, Proactive, Responsible."@en ;
    dcterms:identifier "Applications6" ;
    dcterms:isPartOf cs2023:CS2023Document ;
    dcterms:requires cs2023:KU_HCI_Accessibility,
        cs2023:KU_HCI_Accountability,
        cs2023:KU_HCI_Evaluation,
        cs2023:KU_HCI_User,
        level:Evaluate .
