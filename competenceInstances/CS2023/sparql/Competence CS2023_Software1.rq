# CS2023 Software1; source requirements and explicit OntoKSD local assignments.
# INSERT-only instance data; load dependencies described in README.md.
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX level: <http://purl.org/edu/cs2023#>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
cs2023c:KS_Software1_SDF_Practices_1_Develop a ontoksd:KnowledgeSkill,
        owl:NamedIndividual ;
    rdfs:label "SDF-Practices × Develop"@en ;
    ontoksd:hasKnowledgeComponent cs2023c:KnowledgeUnitContent_SDF_Practices ;
    ontoksd:hasSkillLevel level:Develop ;
    ontoksd:isKnowledgeSkillOf cs2023c:Competence_Software1 ;
    rdfs:comment "Local knowledge–level assignment for Software1: SDF-Practices at Develop. The unit and level occur in the source lists; the specific binding is a modeling decision. The source does not allocate each listed level to individual units. Multiple levels are not reduced by an assumed hierarchy."@en ;
    skos:prefLabel "SDF-Practices × Develop"@en ;
    prov:wasDerivedFrom cs2023c:Source_Software1 .

cs2023c:TaskActivity_Software1_Design a ontoksd:TaskActivity ;
    rdfs:label "design"@en ;
    rdfs:comment "Task activity capturing the design dimension involved in defining appropriate test cases."@en ;
    skos:prefLabel "design"@en .

cs2023c:TaskActivity_Software1_Develop a ontoksd:TaskActivity ;
    rdfs:label "develop"@en ;
    rdfs:comment "Task activity capturing the development of the test cases required by the task."@en ;
    skos:prefLabel "develop"@en .

cs2023c:TaskActivity_Software1_Document a ontoksd:TaskActivity ;
    rdfs:label "document"@en ;
    rdfs:comment "Task activity capturing the need to document the produced test cases and their intended use."@en ;
    skos:prefLabel "document"@en .

cs2023c:TaskComponent_Software1_TestCaseSet a ontoksd:TaskComponent ;
    rdfs:label "set of test cases for a program"@en ;
    rdfs:comment "Task component corresponding to the principal semantic target of the task: the set of test cases to be produced and used in relation to a given program."@en ;
    skos:prefLabel "set of test cases for a program"@en .

cs2023c:TaskConstraint_Software1_FunctionalCorrectness a ontoksd:TaskConstraint ;
    rdfs:label "verifying the correctness of implementation of the program"@en ;
    rdfs:comment "Task constraint that qualifies the task in terms of its intended purpose: checking whether the implementation of the given program is functionally correct."@en ;
    skos:prefLabel "verifying the correctness of implementation of the program"@en .

cs2023c:Task_Software1 a ontoksd:Task ;
    rdfs:label "Software1 task"@en ;
    dcterms:identifier "Task_Software1"^^xsd:string ;
    ontoksd:hasTaskActivity cs2023c:TaskActivity_Software1_Design,
        cs2023c:TaskActivity_Software1_Develop,
        cs2023c:TaskActivity_Software1_Document ;
    ontoksd:hasTaskComponent cs2023c:TaskComponent_Software1_TestCaseSet ;
    ontoksd:hasTaskConstraint cs2023c:TaskConstraint_Software1_FunctionalCorrectness ;
    ontoksd:hasTaskStatement "Develop test cases to determine if a program is functionally correct."@en ;
    ontoksd:isTaskOf cs2023c:Competence_Software1 ;
    rdfs:comment "Specification-level task associated with Competence_Software1. This task is analytically decomposed according to the CS2023-inspired structure adopted in OntoKSD."@en ;
    skos:prefLabel "Software1 task"@en ;
    prov:wasDerivedFrom cs2023c:Source_Software1 .

cs2023c:Competence_Software1 a ontoksd:CS2023Competence,
        ontoksd:Competence,
        owl:NamedIndividual ;
    rdfs:label "Develop test cases and test a given program"@en ;
    dcterms:identifier "Software1"^^xsd:string ;
    dcterms:source cs2023:CS2023Document ;
    ontoksd:hasDisposition ontoksd:meticulous,
        ontoksd:persistent,
        ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill cs2023c:KS_Software1_SDF_Practices_1_Develop ;
    ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern ;
    ontoksd:hasTask cs2023c:Task_Software1 ;
    rdfs:comment "OntoKSD representation of CS2023 example Software1. The source record retains the complete, unpaired knowledge-unit and skill-level lists. KnowledgeSkill pairings are explicit local assignments and do not claim that CS2023 specifies those individual bindings. Task elements are an analytical interpretation of the reference task and competence statement."@en ;
    skos:definition "Develop test cases and test a given program."@en ;
    skos:prefLabel "Develop test cases and test a given program"@en ;
    prov:wasDerivedFrom cs2023:CS2023Document,
        cs2023c:Source_Software1 .

cs2023c:Source_Software1 a prov:Entity ;
    dcterms:bibliographicCitation "Computer Science Curricula 2023, Competency Framework Examples, example Software1, starting on printed page 398."@en ;
    dcterms:description "Task: Develop test cases to determine if a program is functionally correct. Competency statement: Develop test cases and test a given program. Required knowledge: SDF-Practices. Required skills: Develop. Desirable professional dispositions: Meticulous, Persistent, Responsible."@en ;
    dcterms:identifier "Software1" ;
    dcterms:isPartOf cs2023:CS2023Document ;
    dcterms:requires cs2023:KU_SDF_Practices,
        level:Develop .
}
