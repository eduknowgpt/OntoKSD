PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Optional disposition extension
  #################################################################

  ontoksd:persistent a ontoksd:Disposition , skos:Concept ;
      rdfs:label "Persistent"@en ;
      skos:prefLabel "Persistent"@en ;
      rdfs:comment "A disposition characterized by sustained effort, perseverance, and continued engagement when facing difficulty, iteration, or failure during task execution."@en .

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Applications4
      a ontoksd:Competence ;
      rdfs:label "Given weather data for a region, design and implement an animation depicting temperature changes over time"@en ;
      skos:prefLabel "Given weather data for a region, design and implement an animation depicting temperature changes over time"@en ;
      skos:definition "Given weather data for a region, design and implement an animation depicting temperature changes over time."@en ;
      rdfs:comment "Competence derived from the CS2023 Applications Competency Area, Task Applications4. Since the competence combines the application of graphical and user-centered knowledge, evaluative judgment about visualization design, and the development of an animated visualization artifact, this formalization distributes the required CS2023 skill levels across the selected knowledge elements: Apply for using foundational and rendering knowledge, Evaluate for judging visualization and interaction design choices, and Develop for implementing the animation."@en ;
      dcterms:identifier "Applications4"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Applications4 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Applications4_GIT_Fundamentals_1_Apply ,
          cs2023c:KS_Applications4_GIT_Rendering_1_Apply ,
          cs2023c:KS_Applications4_GIT_Visualization_1_Evaluate ,
          cs2023c:KS_Applications4_HCI_Design_1_Evaluate ,
          cs2023c:KS_Applications4_HCI_User_1_Develop ;
      ontoksd:hasDisposition
          ontoksd:inventive ,
          ontoksd:persistent ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Applications4
      a ontoksd:Task ;
      rdfs:label "Applications4 task"@en ;
      skos:prefLabel "Applications4 task"@en ;
      ontoksd:hasTaskStatement "Visualize a region's temperature record."@en ;
      rdfs:comment "Specification-level task associated with Competence_Applications4. The task concerns designing and implementing an animated visualization that depicts temperature changes over time for a given region using weather data."@en ;
      dcterms:identifier "Task_Applications4"^^xsd:string ;
      ontoksd:hasTaskComponent
          cs2023c:TaskComponent_Applications4_WeatherData ,
          cs2023c:TaskComponent_Applications4_Animation ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Applications4_Design ,
          cs2023c:TaskActivity_Applications4_Implement ,
          cs2023c:TaskActivity_Applications4_Visualize ,
          cs2023c:TaskActivity_Applications4_Animate ,
          cs2023c:TaskActivity_Applications4_Evaluate ;
      ontoksd:hasTaskConstraint
          cs2023c:TaskConstraint_Applications4_Region ,
          cs2023c:TaskConstraint_Applications4_TemperatureChangeOverTime .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Applications4_WeatherData
      a ontoksd:TaskComponent ;
      rdfs:label "weather data for a region"@en ;
      skos:prefLabel "weather data for a region"@en ;
      rdfs:comment "Task component corresponding to the regional weather data used to generate the visualization."@en .

  cs2023c:TaskComponent_Applications4_Animation
      a ontoksd:TaskComponent ;
      rdfs:label "animation depicting temperature changes over time"@en ;
      skos:prefLabel "animation depicting temperature changes over time"@en ;
      rdfs:comment "Task component corresponding to the animated visualization artifact that represents temperature variation over time."@en .

  cs2023c:TaskActivity_Applications4_Design
      a ontoksd:TaskActivity ;
      rdfs:label "design"@en ;
      skos:prefLabel "design"@en ;
      rdfs:comment "Task activity capturing the design of the visualization and animation strategy."@en .

  cs2023c:TaskActivity_Applications4_Implement
      a ontoksd:TaskActivity ;
      rdfs:label "implement"@en ;
      skos:prefLabel "implement"@en ;
      rdfs:comment "Task activity capturing the implementation of the animated visualization."@en .

  cs2023c:TaskActivity_Applications4_Visualize
      a ontoksd:TaskActivity ;
      rdfs:label "visualize"@en ;
      skos:prefLabel "visualize"@en ;
      rdfs:comment "Task activity capturing the representation of temperature data in visual form."@en .

  cs2023c:TaskActivity_Applications4_Animate
      a ontoksd:TaskActivity ;
      rdfs:label "animate"@en ;
      skos:prefLabel "animate"@en ;
      rdfs:comment "Task activity capturing the depiction of temperature changes over time through animation."@en .

  cs2023c:TaskActivity_Applications4_Evaluate
      a ontoksd:TaskActivity ;
      rdfs:label "evaluate"@en ;
      skos:prefLabel "evaluate"@en ;
      rdfs:comment "Task activity capturing the evaluation of visualization effectiveness and design adequacy."@en .

  cs2023c:TaskConstraint_Applications4_Region
      a ontoksd:TaskConstraint ;
      rdfs:label "for a region"@en ;
      skos:prefLabel "for a region"@en ;
      rdfs:comment "Task constraint stating that the visualization must be based on weather data for a specific region."@en .

  cs2023c:TaskConstraint_Applications4_TemperatureChangeOverTime
      a ontoksd:TaskConstraint ;
      rdfs:label "depicting temperature changes over time"@en ;
      skos:prefLabel "depicting temperature changes over time"@en ;
      rdfs:comment "Task constraint stating that the animation must represent temporal changes in temperature."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Applications4_GIT_Fundamentals_1_Apply
      a ontoksd:KnowledgeSkill ;
      rdfs:label "GIT-Fundamentals × Apply"@en ;
      skos:prefLabel "GIT-Fundamentals × Apply"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications4. It associates GIT-Fundamentals knowledge with the CS2023 skill level Apply in working with graphical and imaging foundations required for the visualization."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_GIT_Fundamentals_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Apply .

  cs2023c:KS_Applications4_GIT_Rendering_1_Apply
      a ontoksd:KnowledgeSkill ;
      rdfs:label "GIT-Rendering × Apply"@en ;
      skos:prefLabel "GIT-Rendering × Apply"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications4. It associates GIT-Rendering knowledge with the CS2023 skill level Apply in implementing the rendering aspects of the animated visualization."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_GIT_Rendering_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Apply .

  cs2023c:KS_Applications4_GIT_Visualization_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "GIT-Visualization × Evaluate"@en ;
      skos:prefLabel "GIT-Visualization × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications4. It associates GIT-Visualization knowledge with the CS2023 skill level Evaluate in judging how best to depict temperature changes over time."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_GIT_Visualization_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

  cs2023c:KS_Applications4_HCI_Design_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "HCI-Design × Evaluate"@en ;
      skos:prefLabel "HCI-Design × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications4. It associates HCI-Design knowledge with the CS2023 skill level Evaluate in assessing interface and visualization design choices for clarity and effectiveness."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_HCI_Design_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

  cs2023c:KS_Applications4_HCI_User_1_Develop
      a ontoksd:KnowledgeSkill ;
      rdfs:label "HCI-User × Develop"@en ;
      skos:prefLabel "HCI-User × Develop"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Applications4. It associates HCI-User knowledge with the CS2023 skill level Develop in creating an animated visualization oriented to user interpretation and use."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_HCI_User_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Develop .

}