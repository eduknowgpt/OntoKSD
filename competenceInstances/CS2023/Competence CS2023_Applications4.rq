PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom: <http://purl.org/edu/bloom#>

############# PARES KS ################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:GIT-Fundamentals ontoksd:cs2023ApplySkill)
    (cs2023:GIT-Fundamentals ontoksd:cs2023EvaluateSkill)
    (cs2023:GIT-Fundamentals ontoksd:cs2023DevelopSkill)
    (cs2023:GIT-Rendering   ontoksd:cs2023ApplySkill)
    (cs2023:GIT-Rendering   ontoksd:cs2023EvaluateSkill)
    (cs2023:GIT-Rendering   ontoksd:cs2023DevelopSkill)
    (cs2023:GIT-Visualization ontoksd:cs2023ApplySkill)
    (cs2023:GIT-Visualization ontoksd:cs2023EvaluateSkill)
    (cs2023:GIT-Visualization ontoksd:cs2023DevelopSkill)
    (cs2023:HCI-Design      ontoksd:cs2023ApplySkill)
    (cs2023:HCI-Design      ontoksd:cs2023EvaluateSkill)
    (cs2023:HCI-Design      ontoksd:cs2023DevelopSkill)
    (cs2023:HCI-User        ontoksd:cs2023ApplySkill)
    (cs2023:HCI-User        ontoksd:cs2023EvaluateSkill)
    (cs2023:HCI-User        ontoksd:cs2023DevelopSkill)
  }
  FILTER NOT EXISTS { ?existing a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s . }
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}
;

############# COMPETÊNCIA ################
INSERT {
  ontoksd:competence_CS2023_Applications4 a ontoksd:Competence ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
    dcterms:title "Visualize a region’s temperature record"@en ;
    dcterms:description "Given weather data for a region, design and implement an animation depicting temperature changes over time."@en ;
    dcterms:source "CS2023 Competence Report"@en ;
    skos:notation "CS2023 Competence - Applications4"@en ;
    ontoksd:hasDisposition ontoksd:inventive ,
                           ontoksd:persistent ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE { ?ks a ontoksd:KnowledgeSkill . }
;

############# VERBOS ################
INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2023:GIT-Fundamentals ontoksd:cs2023ApplySkill   bloom:apply)
    (cs2023:GIT-Fundamentals ontoksd:cs2023EvaluateSkill bloom:evaluate)
    (cs2023:GIT-Fundamentals ontoksd:cs2023DevelopSkill  bloom:implement)
    (cs2023:GIT-Rendering    ontoksd:cs2023ApplySkill   bloom:apply)
    (cs2023:GIT-Rendering    ontoksd:cs2023EvaluateSkill bloom:analyze)
    (cs2023:GIT-Rendering    ontoksd:cs2023DevelopSkill  bloom:develop)
    (cs2023:GIT-Visualization ontoksd:cs2023ApplySkill   bloom:apply)
    (cs2023:GIT-Visualization ontoksd:cs2023EvaluateSkill bloom:evaluate)
    (cs2023:GIT-Visualization ontoksd:cs2023DevelopSkill  bloom:visualize)
    (cs2023:HCI-Design       ontoksd:cs2023ApplySkill   bloom:design)
    (cs2023:HCI-Design       ontoksd:cs2023EvaluateSkill bloom:assess)
    (cs2023:HCI-Design       ontoksd:cs2023DevelopSkill  bloom:implement)
    (cs2023:HCI-User         ontoksd:cs2023ApplySkill   bloom:apply)
    (cs2023:HCI-User         ontoksd:cs2023EvaluateSkill bloom:evaluate)
    (cs2023:HCI-User         ontoksd:cs2023DevelopSkill  bloom:develop)
  }
  ?ks a ontoksd:KnowledgeSkill .
}
