PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom: <http://purl.org/edu/bloom#>

############# PARES KS ################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:PDC-Evaluation ontoksd:cs2023EvaluateSkill)
    (cs2023:PDC-Evaluation ontoksd:cs2023DevelopSkill)
    (cs2023:FPL-Parallel   ontoksd:cs2023EvaluateSkill)
    (cs2023:FPL-Parallel   ontoksd:cs2023DevelopSkill)
  }
  FILTER NOT EXISTS { ?existing a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s . }
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}
;

############# COMPETÊNCIA ################
INSERT {
  ontoksd:competence_CS2023_Systems7 a ontoksd:Competence ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
    dcterms:title "Improve performance of a sequential application by introducing parallelism"@en ;
    dcterms:description "Evaluate opportunities for parallelism, implement them, and measure the results."@en ;
    dcterms:source "CS2023 Competence Report"@en ;
    skos:notation "CS2023 Competence - Systems7"@en ;
    ontoksd:hasDisposition ontoksd:meticulous ,
                           ontoksd:persistent ,
                           ontoksd:proactive ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE { ?ks a ontoksd:KnowledgeSkill . }


############# VERBOS ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2023:PDC-Evaluation ontoksd:cs2023EvaluateSkill bloom:evaluate)
    (cs2023:PDC-Evaluation ontoksd:cs2023DevelopSkill  bloom:measure)
    (cs2023:FPL-Parallel   ontoksd:cs2023EvaluateSkill bloom:assess)
    (cs2023:FPL-Parallel   ontoksd:cs2023DevelopSkill  bloom:implement)
  }
  ?ks a ontoksd:KnowledgeSkill .
}
