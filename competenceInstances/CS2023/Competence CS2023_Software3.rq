PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Software3
      a ontoksd:Competence ;
      rdfs:label "Focus on long-term team dynamics and communicate effectively"@en ;
      skos:prefLabel "Focus on long-term team dynamics and communicate effectively"@en ;
      skos:definition "Focus on long-term team dynamics and communicate effectively."@en ;
      rdfs:comment "Competence derived from the CS2023 Software Competency Area, Task Software3. The competence is specified through explicit KnowledgeSkill pairs and the desirable professional dispositions associated with the task."@en ;
      dcterms:identifier "Software3"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Software3 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Software3_SE_Teamwork_1_Apply ,
          cs2023c:KS_Software3_SE_Teamwork_5_Apply ;
      ontoksd:hasDisposition
          ontoksd:collaborative ,
          ontoksd:communicative ,
          ontoksd:proactive ,
          ontoksd:responsive ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Software3
      a ontoksd:Task ;
      rdfs:label "Software3 task"@en ;
      skos:prefLabel "Software3 task"@en ;
      ontoksd:hasTaskStatement "Work on a team effectively."@en ;
      rdfs:comment "Specification-level task associated with Competence_Software3. The task emphasizes sustained and effective participation in team-based work, with attention both to communication and to the long-term dynamics that shape collaborative performance."@en ;
      dcterms:identifier "Task_Software3"^^xsd:string ;
      ontoksd:hasTaskComponent cs2023c:TaskComponent_Software3_TeamworkContext ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Software3_Collaborate ,
          cs2023c:TaskActivity_Software3_Communicate ,
          cs2023c:TaskActivity_Software3_Coordinate ;
      ontoksd:hasTaskConstraint cs2023c:TaskConstraint_Software3_LongTermDynamics .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Software3_TeamworkContext
      a ontoksd:TaskComponent ;
      rdfs:label "team-based work context"@en ;
      skos:prefLabel "team-based work context"@en ;
      rdfs:comment "Task component corresponding to the collaborative context in which the individual works as part of a team over time."@en .

  cs2023c:TaskActivity_Software3_Collaborate
      a ontoksd:TaskActivity ;
      rdfs:label "collaborate"@en ;
      skos:prefLabel "collaborate"@en ;
      rdfs:comment "Task activity capturing active participation in shared team work."@en .

  cs2023c:TaskActivity_Software3_Communicate
      a ontoksd:TaskActivity ;
      rdfs:label "communicate"@en ;
      skos:prefLabel "communicate"@en ;
      rdfs:comment "Task activity capturing the need to communicate effectively with other team members."@en .

  cs2023c:TaskActivity_Software3_Coordinate
      a ontoksd:TaskActivity ;
      rdfs:label "coordinate"@en ;
      skos:prefLabel "coordinate"@en ;
      rdfs:comment "Task activity capturing the organization and alignment of individual contributions within ongoing team processes."@en .

  cs2023c:TaskConstraint_Software3_LongTermDynamics
      a ontoksd:TaskConstraint ;
      rdfs:label "with focus on long-term team dynamics and effective communication"@en ;
      skos:prefLabel "with focus on long-term team dynamics and effective communication"@en ;
      rdfs:comment "Task constraint that qualifies the task in terms of sustained team functioning, including communication quality, coordination over time, and attention to ongoing team dynamics."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Software3_SE_Teamwork_1_Apply
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Effective communication, including oral and written, as well as formal and informal communication × Apply"@en ;
      skos:prefLabel "Effective communication, including oral and written, as well as formal and informal communication × Apply"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software3. It associates the SE-Teamwork knowledge element on effective communication with the CS2023 skill level required in team-based work."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Teamwork_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Apply .

  cs2023c:KS_Software3_SE_Teamwork_5_Apply
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Team processes responsibilities for tasks, effort estimation, meeting structure, work schedule × Apply"@en ;
      skos:prefLabel "Team processes responsibilities for tasks, effort estimation, meeting structure, work schedule × Apply"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software3. It associates the SE-Teamwork knowledge element on team processes and work organization with the CS2023 skill level required in sustaining long-term team dynamics."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Teamwork_5 ;
      ontoksd:hasRequiredSkillLevel cs2023:Apply .

}