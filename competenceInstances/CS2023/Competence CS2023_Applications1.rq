PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023: <http://purl.org/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom: <http://purl.org/edu/bloom#>

############# PARES KS ################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2023:AI-Search ontoksd:cs2023ApplySkill)
    (cs2023:AI-Search ontoksd:cs2023DevelopSkill)
    (cs2023:AI-KRR    ontoksd:cs2023ApplySkill)
    (cs2023:AI-KRR    ontoksd:cs2023DevelopSkill)
  }
  FILTER NOT EXISTS { ?existing a ontoksd:KnowledgeSkill ; ontoksd:hasKnowledgeComponent ?k ; ontoksd:hasSkillComponent ?s . }
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}
;

############# COMPETÊNCIA ################
INSERT {
  ontoksd:competence_CS2023_Applications1 a ontoksd:Competence ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
    dcterms:title "Implement an agent to make strategic decisions in a two-player adversarial game with uncertain actions (e.g., a board game, strategic stock purchasing)."@en ;
    dcterms:description "Use minimax with alpha-beta pruning, and possible chance nodes (expectiminimax), and heuristic move evaluation (at a particular depth) to solve a two-player zero-sum game."@en ;
    dcterms:source "CS2023 Competence Report"@en ;
    skos:notation "CS2023 Competence - Applications1"@en ;
    ontoksd:hasDisposition ontoksd:inventive ,
                           ontoksd:persistent ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE { ?ks a ontoksd:KnowledgeSkill . }
;

############# VERBOS ################
INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2023:AI-Search ontoksd:cs2023ApplySkill   bloom:apply)
    (cs2023:AI-Search ontoksd:cs2023DevelopSkill bloom:implement)
    (cs2023:AI-KRR    ontoksd:cs2023ApplySkill   bloom:use)
    (cs2023:AI-KRR    ontoksd:cs2023DevelopSkill bloom:develop)
  }
  ?ks a ontoksd:KnowledgeSkill .
}
