PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX cs2023:  <http://purl.org/cs2023#>
PREFIX cs2023k: <http://purl.org/cs2023/knowledge#>
PREFIX cs2023c: <http://purl.org/cs2023/competency#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Competence
  #################################################################

  cs2023c:Competence_Software4
      a ontoksd:Competence ;
      rdfs:label "Apply knowledge of multiple programming paradigms, including their strengths and weaknesses relative to the application to be developed, and select an appropriate paradigm and programming language"@en ;
      skos:prefLabel "Apply knowledge of multiple programming paradigms, including their strengths and weaknesses relative to the application to be developed, and select an appropriate paradigm and programming language"@en ;
      skos:definition "Apply knowledge of multiple programming paradigms, including their strengths and weaknesses relative to the application to be developed, and select an appropriate paradigm and programming language."@en ;
	  rdfs:comment "Competence derived from the CS2023 Software Competency Area, Task Software4. The CS2023 statement specifies the skill levels Explain and Evaluate without explicitly binding them to particular knowledge elements. In this formalization, OntoKSD represents the highest required skill level, Evaluate, in the corresponding KnowledgeSkill pairs, while explanatory performance is preserved in the associated task activities."@en ;
      dcterms:identifier "Software4"^^xsd:string ;
      dcterms:source cs2023:CS2023Document ;
      prov:wasDerivedFrom cs2023:CS2023Document ;
      ontoksd:hasTask cs2023c:Task_Software4 ;
      ontoksd:hasKnowledgeSkill
          cs2023c:KS_Software4_FPL_OOP_2_Evaluate ,
          cs2023c:KS_Software4_FPL_Functional_3_Evaluate ,
          cs2023c:KS_Software4_FPL_Logic_13_Evaluate ,
          cs2023c:KS_Software4_FPL_Event_Driven_3_Evaluate ,
          cs2023c:KS_Software4_FPL_Types_18_Evaluate ,
          cs2023c:KS_Software4_FPL_Translation_1_Evaluate ,
          cs2023c:KS_Software4_FPL_Pragmatics_3_Evaluate ,
          cs2023c:KS_Software4_SPD_Embedded_1_Evaluate ,
          cs2023c:KS_Software4_FPL_Constructs_2_Evaluate ;
      ontoksd:hasDisposition
          ontoksd:inventive ;
      ontoksd:hasSpecificationPattern ontoksd:CS2023SpecificationPattern .

  #################################################################
  # Specification-level Task
  #################################################################

  cs2023c:Task_Software4
      a ontoksd:Task ;
      rdfs:label "Software4 task"@en ;
      skos:prefLabel "Software4 task"@en ;
      ontoksd:hasTaskStatement "Make an informed decision regarding which programming language/paradigm to select and use for a specific application."@en ;
      rdfs:comment "Specification-level task associated with Competence_Software4. The task concerns selecting an appropriate programming paradigm and programming language for a specific application on the basis of comparative consideration of strengths, weaknesses, and application needs."@en ;
      dcterms:identifier "Task_Software4"^^xsd:string ;
      ontoksd:hasTaskComponent
          cs2023c:TaskComponent_Software4_Application ,
          cs2023c:TaskComponent_Software4_ParadigmAndLanguageSelection ;
      ontoksd:hasTaskActivity
          cs2023c:TaskActivity_Software4_Analyze ,
          cs2023c:TaskActivity_Software4_Explain ,
          cs2023c:TaskActivity_Software4_Evaluate ,
          cs2023c:TaskActivity_Software4_Select ;
      ontoksd:hasTaskConstraint cs2023c:TaskConstraint_Software4_ApplicationFitness .

  #################################################################
  # Task elements
  #################################################################

  cs2023c:TaskComponent_Software4_Application
      a ontoksd:TaskComponent ;
      rdfs:label "specific application to be developed"@en ;
      skos:prefLabel "specific application to be developed"@en ;
      rdfs:comment "Task component corresponding to the target application whose characteristics and requirements guide the paradigm and language selection."@en .

  cs2023c:TaskComponent_Software4_ParadigmAndLanguageSelection
      a ontoksd:TaskComponent ;
      rdfs:label "programming paradigm and programming language selection"@en ;
      skos:prefLabel "programming paradigm and programming language selection"@en ;
      rdfs:comment "Task component corresponding to the decision outcome, namely the selected programming paradigm and programming language."@en .

  cs2023c:TaskActivity_Software4_Analyze
      a ontoksd:TaskActivity ;
      rdfs:label "analyze"@en ;
      skos:prefLabel "analyze"@en ;
      rdfs:comment "Task activity capturing the analysis of application requirements and paradigm characteristics."@en .

  cs2023c:TaskActivity_Software4_Explain
      a ontoksd:TaskActivity ;
      rdfs:label "explain"@en ;
      skos:prefLabel "explain"@en ;
      rdfs:comment "Task activity capturing the explanation of strengths, weaknesses, and trade-offs among alternative paradigms and languages."@en .

  cs2023c:TaskActivity_Software4_Evaluate
      a ontoksd:TaskActivity ;
      rdfs:label "evaluate"@en ;
      skos:prefLabel "evaluate"@en ;
      rdfs:comment "Task activity capturing the evaluative judgment required to determine the suitability of a paradigm and language for the target application."@en .

  cs2023c:TaskActivity_Software4_Select
      a ontoksd:TaskActivity ;
      rdfs:label "select"@en ;
      skos:prefLabel "select"@en ;
      rdfs:comment "Task activity capturing the selection of an appropriate paradigm and programming language."@en .

  cs2023c:TaskConstraint_Software4_ApplicationFitness
      a ontoksd:TaskConstraint ;
      rdfs:label "relative to the application to be developed"@en ;
      skos:prefLabel "relative to the application to be developed"@en ;
      rdfs:comment "Task constraint stating that the decision must be justified with respect to the characteristics and needs of the application to be developed."@en .

  #################################################################
  # Knowledge-Skill pairs
  #################################################################

  cs2023c:KS_Software4_FPL_OOP_2_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Object-oriented design × Evaluate"@en ;
      skos:prefLabel "Object-oriented design × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates object-oriented programming knowledge with the CS2023 skill level Evaluate in the context of paradigm and language selection."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_OOP_2 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

 
  cs2023c:KS_Software4_FPL_Functional_3_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Compare and contrast computational solutions in procedural, functional, and object-oriented approaches × Evaluate"@en ;
      skos:prefLabel "Compare and contrast computational solutions in procedural, functional, and object-oriented approaches × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates functional-programming-related comparative knowledge with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_Functional_3 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .


  cs2023c:KS_Software4_FPL_Logic_13_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Integration with other programming paradigms such as object-oriented programming × Evaluate"@en ;
      skos:prefLabel "Integration with other programming paradigms such as object-oriented programming × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates logic-programming knowledge with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_Logic_13 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .


  cs2023c:KS_Software4_FPL_Event_Driven_3_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Define and use a reactive framework × Evaluate"@en ;
      skos:prefLabel "Define and use a reactive framework × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates event-driven and reactive-programming knowledge with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_Event_Driven_3 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .


  cs2023c:KS_Software4_FPL_Types_18_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Explain how static overloading and associated resolution algorithms influence the dynamic behavior of programs × Evaluate"@en ;
      skos:prefLabel "Explain how static overloading and associated resolution algorithms influence the dynamic behavior of programs × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates type-system knowledge with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_Types_18 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

 
  cs2023c:KS_Software4_FPL_Translation_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Differences among compiled, JIT, and interpreted language implementations × Evaluate"@en ;
      skos:prefLabel "Differences among compiled, JIT, and interpreted language implementations × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates language-translation knowledge with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_Translation_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .


  cs2023c:KS_Software4_FPL_Pragmatics_3_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Criteria for good programming language design × Evaluate"@en ;
      skos:prefLabel "Criteria for good programming language design × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates programming-language pragmatics knowledge with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_Pragmatics_3 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .



  cs2023c:KS_Software4_SPD_Embedded_1_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "Introduction to the unique characteristics of embedded systems × Evaluate"@en ;
      skos:prefLabel "Introduction to the unique characteristics of embedded systems × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates embedded-systems-related knowledge with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SPD_Embedded_1 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .


  cs2023c:KS_Software4_FPL_Constructs_2_Evaluate
      a ontoksd:KnowledgeSkill ;
      rdfs:label "How advanced programming constructs improve program structure, software quality, and productivity × Evaluate"@en ;
      skos:prefLabel "How advanced programming constructs improve program structure, software quality, and productivity × Evaluate"@en ;
      rdfs:comment "Knowledge-skill pair for Competence_Software4. It associates knowledge about advanced programming constructs with the CS2023 skill level Evaluate."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_FPL_Constructs_2 ;
      ontoksd:hasRequiredSkillLevel cs2023:Evaluate .

}