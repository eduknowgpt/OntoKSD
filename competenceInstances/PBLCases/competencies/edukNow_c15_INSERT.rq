PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://purl.org/edu/bloom#>

#### Understand the Halting Problem and its Implications


############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:The_halting_problem ontoksd:understandingSkill)
    (cs2013:Computability ontoksd:understandingSkill)	
    (cs2013:Turing_machines ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C15 ################

INSERT {
  ontoksd:competence_EdukNow_C15 a ontoksd:Competence ;
   	ontoksd:hasStructureType	ontoksd:Atomic ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain ;
    dcterms:title "Understand the Halting Problem and its Implications"@en ;
    dcterms:description "This competency involves the ability to understand and articulate the theoretical foundations and practical implications of the Halting Problem, one of the central results in Computation Theory. Students must be able to explain why it is undecidable to determine whether an arbitrary program halts on a given input, and how this impacts the design and limitations of automated systems. Learners must demonstrate an understanding of the relationship between Turing Machines, recursively enumerable languages, and undecidability, and apply this knowledge to justify the impossibility of general-purpose loop detection."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C15"@en ;
    ontoksd:hasDisposition ontoksd:inventive ,
                                 ontoksd:collaborative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:The_halting_problem ontoksd:understandingSkill)
    (cs2013:Computability ontoksd:understandingSkill)	
    (cs2013:Turing_machines ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:The_halting_problem ontoksd:understandingSkill bloom:describe)
    (cs2013:The_halting_problem ontoksd:understandingSkill bloom:justify)
    (cs2013:The_halting_problem ontoksd:understandingSkill bloom:relate)
	
    (cs2013:Computability ontoksd:understandingSkill bloom:classify)
    (cs2013:Computability ontoksd:understandingSkill bloom:recognize)
    (cs2013:Computability ontoksd:understandingSkill bloom:explain)	
	
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:use)
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:model)
	(cs2013:Turing_machines ontoksd:applyingSkill bloom:explain)
	
	(cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:evaluate)
	(cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:structure)
	(cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:argue)	
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
