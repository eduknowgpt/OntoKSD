PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://purl.org/edu/bloom#>


####  Test Automata Using Simulators

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:Finite_state_machine ontoksd:applyingSkill)
    (cc2020fpk:ProblemSolvingAndTroubleShooting ontoksd:applyingSkill)
    (cs2013:Foundational_approaches_to_validating_models ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C03 ################

INSERT {
  ontoksd:competence_EdukNow_C03 a ontoksd:Competence ;
    ontoksd:hasStructureType	ontoksd:Atomic ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain ;
    dcterms:title "Test Automata Using Simulators"@en ;
    dcterms:description "This competency relates to the use of simulation tools (e.g., JFLAP) to verify the correctness and behavior of automata implementations. It emphasizes systematic testing and iterative refinement of state-machine models."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C03"@en ;
    ontoksd:hasDisposition ontoksd:investigative ,
                                 ontoksd:collaborative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive ,
                                 ontoksd:creative ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:Finite_state_machine ontoksd:applyingSkill)
    (cc2020fpk:ProblemSolvingAndTroubleShooting ontoksd:applyingSkill)
    (cs2013:Foundational_approaches_to_validating_models ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Finite_state_machine ontoksd:applyingSkill bloom:experiment)
    (cs2013:Finite_state_machine ontoksd:applyingSkill bloom:relate)
    (cs2013:Finite_state_machine ontoksd:applyingSkill bloom:simulate)

    (cc2020fpk:ProblemSolvingAndTroubleShooting ontoksd:applyingSkill bloom:diagnose)
    (cc2020fpk:ProblemSolvingAndTroubleShooting ontoksd:applyingSkill bloom:debug)
    (cc2020fpk:ProblemSolvingAndTroubleShooting ontoksd:applyingSkill bloom:refine)

    (cs2013:Foundational_approaches_to_validating_models ontoksd:applyingSkill bloom:model)
    (cs2013:Foundational_approaches_to_validating_models ontoksd:applyingSkill bloom:simulate)
    (cs2013:Foundational_approaches_to_validating_models ontoksd:applyingSkill bloom:verify)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
