PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://purl.org/edu/bloom#>

####  Develop Problem-Solving Solutions Using Turing Machines

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ontoksd:applyingSkill .
}
WHERE {
  VALUES ?k {
    cs2013:Turing_machines
    cs2013:Requirements_specification
    cc2020fpk:AnalyticalThinking
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ontoksd:applyingSkill .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C07 ################

INSERT {
  ontoksd:competence_EdukNow_C07 a ontoksd:Competence ;
   	ontoksd:hasStructureType	ontoksd:Atomic ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain ;
    dcterms:title "Develop Problem-Solving Solutions Using Turing Machines"@en ;
    dcterms:description "Design and implement computational solutions using Turing Machines as a formal model of computation. This competency involves analyzing system requirements, translating them into abstract machine representations, and constructing Turing Machines capable of solving well-defined problems. Learners must be able to define states, transitions, and input/output behaviors consistent with the problem specification, ensuring logical correctness and completeness. This competency emphasizes the application of formal reasoning and computational modeling to address complex problems, preparing students to leverage Turing Machines as a foundational tool in theoretical computer science and algorithmic analysis."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C07"@en ;
    ontoksd:hasDisposition ontoksd:collaborative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive ,
                                 ontoksd:creative ,
                                 ontoksd:inventive ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ontoksd:applyingSkill .

  VALUES ?k {
    cs2013:Turing_machines
    cs2013:Requirements_specification
    cc2020fpk:AnalyticalThinking
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?verb) {
    (cs2013:Turing_machines bloom:use)
    (cs2013:Turing_machines bloom:Implement)
    (cs2013:Turing_machines bloom:execute)

    (cs2013:Requirements_specification bloom:interpret)
    (cs2013:Requirements_specification bloom:organize)

    (cc2020fpk:AnalyticalThinking bloom:analyze)
    (cc2020fpk:AnalyticalThinking bloom:justify)
    (cc2020fpk:AnalyticalThinking bloom:evaluate)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ontoksd:applyingSkill .
}
