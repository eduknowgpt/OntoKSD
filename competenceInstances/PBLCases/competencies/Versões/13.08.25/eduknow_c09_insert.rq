PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://example.org/bloom#>


####  Apply Turing Machine Variants


############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:Turing_machines ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C09 ################

INSERT {
  ontoksd:competence_EdukNow_C09 a ontoksd:Competence ;
    dcterms:title "Apply Turing Machine Variants"@en ;
    dcterms:description "Demonstrate the ability to select and apply appropriate variants of Turing Machines, such as multi-tape, non-deterministic, or extended models, to design computational solutions tailored to specific problem characteristics. This competency requires learners to analyze the demands of a computational task and assess whether a standard Turing Machine suffices or if an extended variant offers greater efficiency or expressiveness. It also involves articulating the connection between formal computational models and the intuitive notion of algorithmic solvability, as outlined by the Church-Turing Thesis. Through the use of critical reasoning and modeling skills, students are expected to justify the use of specific Turing Machine variants and effectively implement them to represent or simulate solutions to formal problems in computer science."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C09"@en ;
    ontoksd:hasCompetenceElement ontoksd:Inventive ,
                                 ontoksd:Responsible ,
                                 ontoksd:Proactive ,
                                 ontoksd:Collaborative ,
                                 ontoksd:Creative ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:Turing_machines ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:Use)
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:Adapt)
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:Implement)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}