
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://example.org/bloom#>

####  Identify Patterns in Finite State Machines

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks1 a ontoksd:KnowledgeSkill ;
       ontoksd:hasKnowledgeComponent cs2013:Finite_state_machines ;
       ontoksd:hasSkillComponent ontoksd:analyzingSkill .

  ?ks2 a ontoksd:KnowledgeSkill ;
       ontoksd:hasKnowledgeComponent cc2020fpk:AnalyticalThinking ;
       ontoksd:hasSkillComponent ontoksd:applyingSkill .
}
WHERE {
  FILTER NOT EXISTS {
    ?ks1 a ontoksd:KnowledgeSkill ;
         ontoksd:hasKnowledgeComponent cs2013:Finite_state_machines ;
         ontoksd:hasSkillComponent ontoksd:analyzingSkill .
  }

  FILTER NOT EXISTS {
    ?ks2 a ontoksd:KnowledgeSkill ;
         ontoksd:hasKnowledgeComponent cc2020fpk:AnalyticalThinking ;
         ontoksd:hasSkillComponent ontoksd:applyingSkill .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks1)
  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks2)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C11 ################

INSERT {
  ontoksd:competence_EdukNow_C11 a ontoksd:Competence ;
    dcterms:title "Identify Patterns in Finite State Machines"@en ;
    dcterms:description "This competency focuses on the ability to analyze the structure and behavior of Finite State Machines (FSMs) to identify recurring patterns, regularities, or redundancies that influence model complexity, efficiency, and expressiveness."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C11"@en ;
    ontoksd:hasCompetenceElement ontoksd:Inventive ,
                                 ontoksd:Creative ,
                                 ontoksd:Meticulous ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:Finite_state_machines ontoksd:analyzingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Finite_state_machines ontoksd:analyzingSkill bloom:Examine)
    (cs2013:Finite_state_machines ontoksd:analyzingSkill bloom:Evaluate)
    (cs2013:Finite_state_machines ontoksd:analyzingSkill bloom:Compare)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
