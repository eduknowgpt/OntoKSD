
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://example.org/bloom#>

####  Test Turing Machines Using Simulators

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:Turing_machines ontoksd:applyingSkill)
    (cc2020fpk:ProblemSolvingAndTroubleShooting ontoksd:applyingSkill)
    (cs2013:Foundational_approaches_to_validating_models ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C10 ################

INSERT {
  ontoksd:competence_EdukNow_C10 a ontoksd:Competence ;
    dcterms:title "Test Turing Machines Using Simulators"@en ;
    dcterms:description "This competency involves the ability to simulate and assess the behavior of Turing Machines using dedicated computational tools such as JFLAP or equivalent simulators. It ensures that students can validate Turing Machine models by checking their correctness, completeness, and adherence to formal problem specifications."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C10"@en ;
    ontoksd:hasCompetenceElement ontoksd:Inventive ,
                                 ontoksd:Responsible ,
                                 ontoksd:Proactive ,
                                 ontoksd:Collaborative ,
                                 ontoksd:Creative ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:Turing_machines ontoksd:applyingSkill)
    (cc2020fpk:ProblemSolvingAndTroubleShooting ontoksd:applyingSkill)
    (cs2013:Foundational_approaches_to_validating_models ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:Use)
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:Adapt)
    (cs2013:Turing_machines ontoksd:applyingSkill bloom:Implement)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
