PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://purl.org/edu/bloom#>

###  Justify the use of Deterministic Finite Automata (DFAs)

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:Review_of_deterministic_finite_automata__DFAs_ ontoksd:understandingSkill)
    (cs2013:Requirements_specification ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C02 ################

INSERT {
  ontoksd:competence_EdukNow_C02 a ontoksd:Competence ;
  	ontoksd:hasStructureType	ontoksd:Atomic ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain ;
    dcterms:title "Justify the use of Deterministic Finite Automata (DFAs)"@en ;
    dcterms:description "This competency focuses on students' ability to distinguish between deterministic and non-deterministic finite automata, and evaluate which model is best suited to a given problem."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C02"@en ;
    ontoksd:hasDisposition ontoksd:investigative ,
                                 ontoksd:collaborative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:Review_of_deterministic_finite_automata__DFAs_ ontoksd:understandingSkill)
    (cs2013:Requirements_specification ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Review_of_deterministic_finite_automata__DFAs_ ontoksd:understandingSkill bloom:compare)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:justify)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:evaluate)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
