PREFIX ontoksd: <https://example.org/ontoksd#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX gufo:    <http://purl.org/nemo/gufo#>

INSERT DATA {

  ########## LearningRole (gufo:Role) ##########

  ontoksd:MATC94_student_role a ontoksd:LearningRole ;
    dcterms:title "Student Role in MATC94"@en ;
    dcterms:description "Represents the role of a learner enrolled as a student in the course 'Introduction to Formal Languages and Theory of Computation' (MATC94). This role contextualizes the student's participation, expected competences, and assessment within the course."@en .


  ########## RoleDetail (mediações do papel em contextos específicos) ##########
  # Conectamos cada RoleDetail ao papel, à pessoa e ao curso.

  ontoksd:MATC94_role_detail_2021_01 a ontoksd:RoleDetail ;
    ontoksd:refersToRole ontoksd:MATC94_student_role ;
	time:hasBeginning    "2021-03-01T00:00:00-03:00"^^xsd:dateTime ;
    time:hasEnd          "2021-07-01T00:00:00-03:00"^^xsd:dateTime .
	
  ontoksd:MATC94_role_detail_2021_02 a ontoksd:RoleDetail ;
    ontoksd:refersToRole ontoksd:MATC94_student_role ;
	time:hasBeginning    "2021-03-01T00:00:00-03:00"^^xsd:dateTime ;
    time:hasEnd          "2021-07-01T00:00:00-03:00"^^xsd:dateTime .

  ontoksd:MATC94_role_detail_2021_03 a ontoksd:RoleDetail ;
    ontoksd:refersToRole ontoksd:MATC94_student_role ;
	time:hasBeginning    "2021-03-01T00:00:00-03:00"^^xsd:dateTime ;
    time:hasEnd          "2021-07-01T00:00:00-03:00"^^xsd:dateTime .
	
  ontoksd:MATC94_role_detail_2022_01 a ontoksd:RoleDetail ;
    ontoksd:refersToRole ontoksd:MATC94_student_role ;
    time:hasBeginning    "2022-03-01T00:00:00-03:00"^^xsd:dateTime ;
    time:hasEnd          "2022-07-01T00:00:00-03:00"^^xsd:dateTime 

  ontoksd:MATC94_role_detail_2022_02 a ontoksd:RoleDetail ;
    ontoksd:refersToRole ontoksd:MATC94_student_role ;
    time:hasBeginning    "2022-03-01T00:00:00-03:00"^^xsd:dateTime ;
    time:hasEnd          "2022-07-01T00:00:00-03:00"^^xsd:dateTime 

  ontoksd:MATC94_role_detail_2022_03 a ontoksd:RoleDetail ;
    ontoksd:refersToRole ontoksd:MATC94_student_role ;
    time:hasBeginning    "2022-03-01T00:00:00-03:00"^^xsd:dateTime ;
    time:hasEnd          "2022-07-01T00:00:00-03:00"^^xsd:dateTime 



########## Profiles (um perfil por aluno/semestre) ##########
  # Ajuste: Profile é classe própria; liga-se ao LearningRole (appliesTo) e ao RoleDetail (hasPerformedRole).

  ontoksd:profile_2021_01 a ontoksd:Profile ;
    ontoksd:appliesTo       ontoksd:MATC94_student_role ;
    ontoksd:hasPerformedRole ontoksd:MATC94_role_detail_2021_01 .

  ontoksd:profile_2021_02 a ontoksd:Profile ;
    ontoksd:appliesTo       ontoksd:MATC94_student_role ;
    ontoksd:hasPerformedRole ontoksd:MATC94_role_detail_2021_02 .

  ontoksd:profile_2021_03 a ontoksd:Profile ;
    ontoksd:appliesTo       ontoksd:MATC94_student_role ;
    ontoksd:hasPerformedRole ontoksd:MATC94_role_detail_2021_03 .

  ontoksd:profile_2022_01 a ontoksd:Profile ;
    ontoksd:appliesTo       ontoksd:MATC94_student_role ;
    ontoksd:hasPerformedRole ontoksd:MATC94_role_detail_2022_01 .

  ontoksd:profile_2022_02 a ontoksd:Profile ;
    ontoksd:appliesTo       ontoksd:MATC94_student_role ;
    ontoksd:hasPerformedRole ontoksd:MATC94_role_detail_2022_02 .

  ontoksd:profile_2022_03 a ontoksd:Profile ;
    ontoksd:appliesTo       ontoksd:MATC94_student_role ;
    ontoksd:hasPerformedRole ontoksd:MATC94_role_detail_2022_03 .



########## Persons (vínculo pessoa ↔ profile) ##########

  ontoksd:student_MATC94_2021_01 a ontoksd:Person ;
    ontoksd:hasProfile ontoksd:profile_2021_01 .

  ontoksd:student_MATC94_2021_02 a ontoksd:Person ;
    ontoksd:hasProfile ontoksd:profile_2021_02 .

  ontoksd:student_MATC94_2021_03 a ontoksd:Person ;
    ontoksd:hasProfile ontoksd:profile_2021_03 .

  ontoksd:student_MATC94_2022_01 a ontoksd:Person ;
    ontoksd:hasProfile ontoksd:profile_2022_01 .

  ontoksd:student_MATC94_2022_02 a ontoksd:Person ;
    ontoksd:hasProfile ontoksd:profile_2022_02 .

  ontoksd:student_MATC94_2022_03 a ontoksd:Person ;
    ontoksd:hasProfile ontoksd:profile_2022_03 .
}
