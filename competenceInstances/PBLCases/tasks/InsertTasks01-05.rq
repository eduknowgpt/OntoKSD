  ontoksd:TASK04_C13 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK04 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C13 ;
