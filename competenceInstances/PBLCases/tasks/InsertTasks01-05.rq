prefix ontoksd:   <https://example.org/ontoksd#> 
prefix dcterms:   <http://purl.org/dc/terms/> 
prefix xsd:       <http://www.w3.org/2001/XMLSchema#> 
prefix time:      <http://www.w3.org/2006/time#> 
prefix foaf:      <http://xmlns.com/foaf/0.1/> 
prefix dcat:      <http://www.w3.org/ns/dcat#> 
prefix schema:    <https://schema.org/> 
prefix gufo:      <https://purl.org/nemo/gufo#> 

############# TASK01 #############
INSERT DATA {
  ontoksd:TASK01 a ontoksd:LearningTask ;
    ontoksd:hasAcquisitionContext ontoksd:contextMATC94_01 ;
    dcterms:title "The Vending Machine for Sodas and Snacks"@en ;
    dcterms:description "The task presents a problem related to change calculation in vending machine transactions, where payments are made using coins and banknotes. The task requires students to design a solution that enables the vending machine to accept payments, dispense change accurately, and operate according to predefined functional requirements."@en ;
    dcterms:creator "Luiz Gavaza"@en , "Lais Salvador"@en , "David Moises"@en , "Roberta Oliveira"@en ;
    dcterms:contributor "Edeyson Gomes"@en , "Jéssica Santana"@en .

  ontoksd:TASK01_C02 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK01 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C02 ;
	dcterms:description "This competency focuses on students' ability to distinguish between deterministic and non-deterministic finite automata, and evaluate which model is best suited to a given problem. Emphasis is placed on understanding the implications of determinism in automata design and on making reasoned decisions based on system constraints and complexity."@en .

  ontoksd:TASK01_C03 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK01 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C03 ;
	dcterms:description "This competency relates to the use of simulation tools (e.g., JFLAP) to verify the correctness and behavior of automata implementations. It emphasizes systematic testing and iterative refinement of state-machine models."@en .

  ontoksd:TASK01_C04 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK01 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C04 ;
	dcterms:description "This competency focuses on the ability to relate regular expressions to finite automata, both theoretically and in practice."@en .

  ontoksd:TASK01_C05 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK01 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C05 ;
	dcterms:description "One of the required deliverables is a technical report formatted according to SBC guidelines. This competence supports the collaborative writing of structured technical documentation that clearly communicates system design decisions, implementation strategies, simulation results, and compliance with regulatory specifications—an essential component of the project’s final assessment."@en .
	
  ontoksd:TASK01_C06 a ontoksd:CompetenceAssociation ;
  	gufo:hasBeginPointInXSDDate "2025-01-01"^^xsd:date ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK01 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C06 ;
	dcterms:description "Students are expected to interpret system requirements and model behavior using automata, applying formal methods to ensure logical consistency and operational correctness."@en .
}
;

############# TASK02 #############
INSERT DATA {
  ontoksd:TASK02 a ontoksd:LearningTask ;
    ontoksd:hasAcquisitionContext ontoksd:contextMATC94_01 ;
    dcterms:title "Traffic Control"@en ;
    dcterms:description "This task engages students in designing a computational model using Turing Machines to monitor and classify vehicle types on highways. Inspired by a real-world problem posed by the Bahia Department of Transport Infrastructure (DERBA), the task emphasizes the application of formal modeling, state-based computation, and systems thinking to develop a reliable and efficient monitoring solution aligned with public infrastructure needs."@en ;
    dcterms:creator "Luiz Gavaza"@en , "Lais Salvador"@en , "David Moises"@en ;
    dcterms:contributor "Edeyson Gomes"@en , "Jéssica Santana"@en .

  ontoksd:TASK02_C05 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK02 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C05 ;
	dcterms:description "One of the required deliverables is a technical report formatted according to SBC guidelines. This competence supports the collaborative writing of structured technical documentation that clearly communicates system design decisions, implementation strategies, simulation results, and compliance with regulatory specifications—an essential component of the project’s final assessment."@en .

  ontoksd:TASK02_C07 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK02 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C07 ;
	dcterms:description "The task requires students to design and implement a Turing Machine that ingests and classifies vehicle data, translating elicited user requirements into a formal specification and a functioning model."@en .
	
  ontoksd:TASK02_C08 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK02 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C08 ;
	dcterms:description "The task requires students to characterize and differentiate Turing-machine variants (e.g., multi-tape, nondeterministic, or other extensions), analyze their computational power and constraints, and justify when a standard Turing Machine suffices versus when an extended model is warranted to meet system requirements."@en .
	
  ontoksd:TASK02_C09 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK02 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C09 ;
	dcterms:description "The task requires students to select and apply appropriate Turing-machine variants (e.g., multi-tape, nondeterministic) to devise efficient solutions to specified computational problems based on requirement analysis; students must argue the adequacy of the chosen model relative to a standard Turing Machine and the trade-offs involved."@en .
	
  ontoksd:TASK02_C10 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK02 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C10 ;
	dcterms:description "Students must simulate and evaluate Turing-machine behavior with tools such as JFLAP (or equivalent), validating each model for correctness, completeness, termination, and conformance to the formal specification."@en .
}
;

############# TASK03 #############
INSERT DATA {
  ontoksd:TASK03 a ontoksd:LearningTask ;
    ontoksd:hasAcquisitionContext ontoksd:contextMATC94_01 ;
    dcterms:title "The Farmer Robot"@en ;
    dcterms:description "This task engages students in developing a prototype system for herd identification in extensive livestock farming environments. The scenario is based on a real-world challenge proposed by the company Farmer Robot, which seeks a low-cost solution to automate the classification of animals—bovines, caprines, and swine—using a robotic system equipped with a visual identification module. The task integrates concepts from robotics, pattern recognition, and automaton-based modeling."@en ;
    dcterms:creator "Luiz Gavaza"@en , "Lais Salvador"@en , "Daniel Cason"@en , "Roberta Oliveira"@en ;
    dcterms:contributor "Edeyson Gomes"@en , "Jéssica Santana"@en .

  ontoksd:TASK03_C03 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK03 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C03 ;
	dcterms:description "The task requires students to use simulation tools such as JFLAP to verify the correctness and behavior of automata implementations, applying systematic testing and iterative refinement to ensure model accuracy and reliability."@en .

  ontoksd:TASK03_C04 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK03 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C04 ;
	dcterms:description "The task requires students to understand the correspondence between regular expressions and finite automata, interpreting automaton behavior through equivalent formal representations, and applying requirements analysis to model or validate regular-language components."@en .

  ontoksd:TASK03_C05 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK03 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C05 ;
	dcterms:description "The task requires students to collaboratively produce a technical report following SBC formatting guidelines, clearly documenting system design choices, implementation strategies, simulation results, and compliance with project specifications as part of the final deliverable."@en .

  ontoksd:TASK03_C06 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK03 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C06;
	dcterms:description "The task requires to design and implement FSM-based models to solve system modeling problems involving states and transitions, demonstrating the ability to translate requirements into reliable, testable computational solutions."@en .

  ontoksd:TASK03_C11 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK03 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C11 ;
	dcterms:description "The task requires students to analyze the structure and behavior of Finite State Machines (FSMs), identifying patterns, redundancies, and relationships between inputs, transitions, and state configurations, in order to evaluate and refine model complexity and effectiveness."@en .
}
;

############# TASK04 #############
INSERT DATA {
  ontoksd:TASK04 a ontoksd:LearningTask ;
    ontoksd:hasAcquisitionContext ontoksd:contextMATC94_01 ;
    dcterms:title "The Return of the Farmer Robot"@en ;
    dcterms:description "This task challenges students to design a navigation module that enables a robot to autonomously return to its base location after issuing food delivery alerts. Grounded in a real agricultural scenario, the solution must be modeled using computational techniques and validated through simulation. The task emphasizes the integration of formal methods—especially automata theory and context-free grammars—to solve autonomous navigation problems in dynamic environments."@en ;
    dcterms:creator "Luiz Gavaza"@en , "Lais Salvador"@en , "Daniel Cason"@en , "Roberta Oliveira"@en , "Jéssica Santana"@en , "Otávio Neto"@en ;
    dcterms:contributor "Edeyson Gomes"@en .

  ontoksd:TASK04_C03 a ontoksd:CompetenceAssociation ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK04 ;
    ontoksd:mediatesTargetCompetence ontoksd:competence_EdukNow_C03 ;
	dcterms:description ""@en .
	
  ontoksd:TASK04_C05 a ontoksd:CompetenceAssociation ;
