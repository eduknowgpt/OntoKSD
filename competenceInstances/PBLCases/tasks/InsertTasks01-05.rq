PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

############# INSERÇÃO DO CONTEXTO DE AQUISIÇÃO ################

INSERT DATA {
  ontoksd:contextEduknow a ontoksd:AcquisitionContext ;
    dcterms:description "The Competency Specification Process (CSP) was applied in a multiple-case study involving five PBL-based educational tasks in a Computer Science course. Four domain experts in Educational Informatics collaboratively analyzed the tasks, identified learning requirements, and derived formal competency statements. This context allowed for the empirical evaluation and iterative refinement of the CSP in real instructional settings."@en .
}

;


PREFIX ontoksd: <http://purl.org/ontoksd#>
