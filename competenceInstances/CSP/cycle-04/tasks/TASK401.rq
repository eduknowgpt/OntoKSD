ontoksd:Task401_Reference a ontoksd:Task ;
    rdfs:label "Tic-Tac-Toe reference performance"@en ;
    ontoksd:hasTaskActivity ontoksd:TA_Task401_design,
        ontoksd:TA_Task401_explain,
        ontoksd:TA_Task401_implement ;
    ontoksd:hasTaskComponent ontoksd:TC_Task401 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task401_1,
        ontoksd:TCons_Task401_2 ;
    ontoksd:hasTaskStatement "In groups of two or three, implement a 3 x 3 text-based or graphical tic-tac-toe game for two human players, alternating X and O."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK401-TicTacToe/TASK401-CSP-Adjustments.md>,
