ontoksd:AS_Task401 a ontoksd:Assessment ;
    rdfs:label "Tic-Tac-Toe assessment specification"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task401 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task401_CM01_Assessment,
        ontoksd:CA_Task401_CM02_Assessment,
