ontoksd:LT_Task401 a ontoksd:LearningTask ;
    rdfs:label "Tic-Tac-Toe learning task"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task401 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task401_CM01_Learning,
        ontoksd:CA_Task401_CM02_Learning,
        ontoksd:CA_Task401_CM03_Learning,
        ontoksd:CA_Task401_CM04_Learning,
        ontoksd:CA_Task401_CM05_Learning,
        ontoksd:CA_Task401_CM06_Learning,
        ontoksd:CA_Task401_CM07_Learning,
        ontoksd:CA_Task401_CM08_Learning,
        ontoksd:CA_Task401_CM09_Learning,
        ontoksd:CA_Task401_CM10_Learning,
        ontoksd:CA_Task401_CM12_Learning ;
    ontoksd:hasInstructionalStatement "Assess individual accountability and acknowledged, fairly distributed contributions to the group. A requirements analysis, systematic test record or diagnostic activity is conditional on the explicit request or opportunity described in the activation table."@en,
        "Display the current board after each accepted move and submit source code and a complete-match demonstration."@en,
        "In groups of two or three, implement a 3 x 3 text-based or graphical tic-tac-toe game for two human players, alternating X and O."@en,
        "Represent the board; reject malformed or illegal moves without changing the board or player; detect row, column and diagonal wins and draws. A winning last move takes precedence over a draw."@en,
        "The conditional arithmetic-expression explanation is an extension. Requiring functions alone does not establish independently designed organization at Creating."@en,
        "Under the TASK401 adjustment, organize the solution into functions with explicit responsibilities and data exchange. Require each learner to explain data organization, state updates, decisions, repetition and function organization coherently."@en ;
    ontoksd:isTeamBased true ;
    ontoksd:usesResource ontoksd:ER_Task401_Statement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK401-TicTacToe/TASK401-CSP-Adjustments.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK401-TicTacToe/TASK401-CSP-Report.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK401-TicTacToe/TASK401-TicTacToe.md> .
