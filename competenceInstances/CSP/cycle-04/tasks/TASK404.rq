        ontoksd:TA_Task404_select ;
    ontoksd:hasTaskComponent ontoksd:TC_Task404 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task404_1 ;
    ontoksd:hasTaskStatement "Read a side count of 3, 4 or 5 and a positive side length in centimeters. Display TRIANGLE and its equilateral area for 3, SQUARE and its area for 4, and only PENTAGON for 5."@en ;
