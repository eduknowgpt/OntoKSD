ontoksd:LT_Task407 a ontoksd:LearningTask ;
    rdfs:label "Prime Numbers and Smallest Divisors learning task"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task407 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task407_CM03_Learning,
