ontoksd:AS_Task411 a ontoksd:Assessment ;
    rdfs:label "Finding the Snake in a Grid assessment specification"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task411 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task411_CM02_Assessment,
        ontoksd:CA_Task411_CM03_Assessment,
