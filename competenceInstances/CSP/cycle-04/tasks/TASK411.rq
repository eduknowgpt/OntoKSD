ontoksd:Task411_Reference a ontoksd:Task ;
    rdfs:label "Finding the Snake in a Grid reference performance"@en ;
    ontoksd:hasTaskActivity ontoksd:TA_Task411_explain,
        ontoksd:TA_Task411_locate,
        ontoksd:TA_Task411_return,
        ontoksd:TA_Task411_traverse ;
    ontoksd:hasTaskComponent ontoksd:TC_Task411 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task411_1,
        ontoksd:TCons_Task411_2,
        ontoksd:TCons_Task411_3 ;
    ontoksd:hasTaskStatement "For an arbitrary M x N rectangular matrix, locate h and return every snake cell exactly once from head to tail as zero-based [row, column] coordinates."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK411-Snake/TASK411-CSP-Report.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK411-Snake/TASK411-Snake.md> .

ontoksd:LT_Task411 a ontoksd:LearningTask ;
    rdfs:label "Finding the Snake in a Grid learning task"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task411 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task411_CM02_Learning,
        ontoksd:CA_Task411_CM03_Learning,
        ontoksd:CA_Task411_CM04_Learning,
        ontoksd:CA_Task411_CM08_Learning,
        ontoksd:CA_Task411_CM14_Learning,
        ontoksd:CA_Task411_CM15_Learning ;
    ontoksd:hasInstructionalStatement "Assume exactly one valid, connected snake, without branches, loops or disconnected cells, with one head and tail. No invalid-grid validation or interactive input parser is required; the matrix may be supplied directly."@en,
        "Every body arrow points to its predecessor toward the head. Select an edge-adjacent body cell whose arrow points to the current cell; mere occupied adjacency is insufficient. The tail has no adjacent body cell pointing to it."@en,
        "For an arbitrary M x N rectangular matrix, locate h and return every snake cell exactly once from head to tail as zero-based [row, column] coordinates."@en,
        "Submit source code, coordinate sequences for both supplied examples, and a brief explanation of arrow-based selection and tail recognition. Rectangular-grid and boundary-head checks with explicit comparison and judgment are optional."@en ;
    ontoksd:usesResource ontoksd:ER_Task411_Statement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK411-Snake/TASK411-CSP-Report.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK411-Snake/TASK411-Snake.md> .
