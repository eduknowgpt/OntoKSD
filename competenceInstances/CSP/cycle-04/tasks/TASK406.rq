ontoksd:LT_Task406 a ontoksd:LearningTask ;
    rdfs:label "School Census learning task"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task406 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task406_CM03_Learning,
