        ontoksd:TA_Task406_summarize ;
    ontoksd:hasTaskComponent ontoksd:TC_Task406 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task406_1,
        ontoksd:TCons_Task406_2 ;
    ontoksd:hasTaskStatement "Read each student name, sex code M/F and three separate Boolean values for myopia, hypermetropia and astigmatism. Check the name FIM before requesting any remaining fields and exclude the sentinel from all counts."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK406-SchoolCenso/TASK406-CSP-Report.md>,
