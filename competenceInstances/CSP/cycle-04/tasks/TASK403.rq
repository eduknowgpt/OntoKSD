ontoksd:Task403_Reference a ontoksd:Task ;
    rdfs:label "Average Velocity reference performance"@en ;
    ontoksd:hasTaskActivity ontoksd:TA_Task403_explain,
        ontoksd:TA_Task403_implement,
        ontoksd:TA_Task403_investigate,
        ontoksd:TA_Task403_rearrange ;
    ontoksd:hasTaskComponent ontoksd:TC_Task403 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task403_1,
        ontoksd:TCons_Task403_2 ;
    ontoksd:hasTaskStatement "Investigate displacement, time interval and average velocity for positive-direction straight-line motion without reversal; document all three formula rearrangements in writing or code comments."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK403-Velocity/TASK403-CSP-Report.md>,
