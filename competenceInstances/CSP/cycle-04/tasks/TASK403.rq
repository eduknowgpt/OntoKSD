ontoksd:LT_Task403 a ontoksd:LearningTask ;
    rdfs:label "Average Velocity learning task"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task403 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task403_CM03_Learning,
        ontoksd:CA_Task403_CM04_Learning,
        ontoksd:CA_Task403_CM05_Learning,
        ontoksd:CA_Task403_CM08_Learning,
        ontoksd:CA_Task403_CM18_Learning,
        ontoksd:CA_Task403_CM19_Learning,
        ontoksd:CA_Task403_CM20_Learning,
        ontoksd:CA_Task403_CM21_Learning,
        ontoksd:CA_Task403_CM22_Learning ;
    ontoksd:hasInstructionalStatement "Investigate displacement, time interval and average velocity for positive-direction straight-line motion without reversal; document all three formula rearrangements in writing or code comments."@en,
        "Receive exactly two positive numeric values and identify the missing quantity using an explicitly stated marker; calculate the third quantity and display the result and its unit using fixed coherent units."@en,
        "Submit commented source code and a brief description of the marker, exit command, identification logic, units, validation and usage examples. Test comparison is optional; complete CM18 explanatory assessment is conditional on an additional request."@en,
        "Support repeated calculations and an explicit exit command distinct from the missing-value marker, recognized before requesting remaining fields."@en,
        "Validate numeric positivity, exactly one missing quantity and nonzero denominators. Recognize a zero marker as missing before validating data, if zero is chosen. Reject invalid combinations and request a new attempt without calculation."@en ;
    ontoksd:usesResource ontoksd:ER_Task403_Statement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK403-Velocity/TASK403-CSP-Report.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK403-Velocity/TASK403-Velocity.md> .
