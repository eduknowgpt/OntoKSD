ontoksd:Task405_Reference a ontoksd:Task ;
    rdfs:label "Factorials Using Functions and Loops reference performance"@en ;
    ontoksd:hasTaskActivity ontoksd:TA_Task405_calculate,
        ontoksd:TA_Task405_implement,
        ontoksd:TA_Task405_invoke ;
    ontoksd:hasTaskComponent ontoksd:TC_Task405 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task405_1,
        ontoksd:TCons_Task405_2 ;
    ontoksd:hasTaskStatement "Read a positive integer n and process exactly n valid nonnegative integer values. For each x, invoke a separate factorial(x) function that receives x, calculates factorial using a loop and returns the result."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK405-Factorial/TASK405-CSP-Report.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK405-Factorial/TASK405-Factorial.md> .

ontoksd:LT_Task405 a ontoksd:LearningTask ;
    rdfs:label "Factorials Using Functions and Loops learning task"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task405 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task405_CM03_Learning,
        ontoksd:CA_Task405_CM04_Learning,
        ontoksd:CA_Task405_CM05_Learning,
        ontoksd:CA_Task405_CM08_Learning,
        ontoksd:CA_Task405_CM20_Learning,
        ontoksd:CA_Task405_CM23_Learning ;
    ontoksd:hasInstructionalStatement "Assume n is positive and subsequent inputs are integers; do not add mandatory nonnumeric-input validation. Submit source code including function, loops and rejection behavior."@en,
        "Large-number handling and storing a summary are optional extensions. Running the example with explicit outcome comparison and judgment is optional."@en,
        "Read a positive integer n and process exactly n valid nonnegative integer values. For each x, invoke a separate factorial(x) function that receives x, calculates factorial using a loop and returns the result."@en,
        "Reject negative x with an error and request a replacement; rejected inputs do not count toward n. Calculate 0! = 1 and display each accepted result as x! = result."@en ;
    ontoksd:usesResource ontoksd:ER_Task405_Statement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK405-Factorial/TASK405-CSP-Report.md>,
