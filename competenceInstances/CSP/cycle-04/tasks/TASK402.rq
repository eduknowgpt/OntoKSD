ontoksd:LT_Task402 a ontoksd:LearningTask ;
    rdfs:label "Variable Manipulation learning task"@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task402 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task402_CM11_Learning,
        ontoksd:CA_Task402_CM18_Learning ;
    ontoksd:hasInstructionalStatement "A state table is recommended supplementary evidence, not an original mandatory deliverable. An individual explanation of updates and arithmetic evaluation activates CM18 only when explicitly requested."@en,
        "For the supplied C program with float variables and successful %f input of 10, 15, 20 and 25, follow assignments in execution order using current values and operator precedence; select the final-value alternative."@en,
        "Interpret supplied code; program construction and debugging are not required. A correct selected alternative alone does not demonstrate the tracing procedure."@en ;
    ontoksd:usesResource ontoksd:ER_Task402_Statement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK402-VariablesManipulation/TASK402-CSP-Report.md>,
