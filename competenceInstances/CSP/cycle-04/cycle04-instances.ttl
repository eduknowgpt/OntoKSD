ns1:LT_Task404 a ns1:LearningTask ;
    rdfs:label "Area of Regular Polygons learning task"@en ;
    ns1:hasAcquisitionContext ns1:AC_Task404 ;
    ns1:hasCompetenceActivation ns1:CA_Task404_CM03_Learning,
        ns1:CA_Task404_CM05_Learning,
        ns1:CA_Task404_CM08_Learning,
        ns1:CA_Task404_CM20_Learning ;
    ns1:hasInstructionalStatement "Read a side count of 3, 4 or 5 and a positive side length in centimeters. Display TRIANGLE and its equilateral area for 3, SQUARE and its area for 4, and only PENTAGON for 5."@en,
        "Submit source code. Running the examples and comparing actual and expected results is optional."@en,
        "Use the supplied formulas A = (sqrt(3)/4) * l^2 and A = l^2. Preserve fractional results and display areas in square centimeters; no fixed decimal formatting is required."@en ;
    ns1:usesResource ns1:ER_Task404_Statement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK404-Area/TASK-CSP-Report.md>,
