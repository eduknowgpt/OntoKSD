ns1:TC_Task401 a ns1:TaskComponent ;
    rdfs:label "A complete interactive tic-tac-toe solution"@en .

ns1:TC_Task402 a ns1:TaskComponent ;
    rdfs:label "Successive states of a supplied C program"@en .

ns1:TC_Task403 a ns1:TaskComponent ;
    rdfs:label "An interactive average-velocity calculation program"@en .

ns1:TC_Task404 a ns1:TaskComponent ;
    rdfs:label "Polygon classification and the supplied area calculations"@en .

ns1:TC_Task405 a ns1:TaskComponent ;
    rdfs:label "An iterative factorial function and repeated input processing"@en .

ns1:TC_Task406 a ns1:TaskComponent ;
    rdfs:label "A sentinel-controlled census summary"@en .

ns1:TC_Task407 a ns1:TaskComponent ;
    rdfs:label "Prime classification and smallest-divisor reporting"@en .

ns1:TC_Task408 a ns1:TaskComponent ;
    rdfs:label "Two supplied pseudocode decision fragments"@en .

ns1:TC_Task409 a ns1:TaskComponent ;
    rdfs:label "Excess catch and fine calculations under supplied exercise rules"@en .

ns1:TC_Task410 a ns1:TaskComponent ;
    rdfs:label "A sentinel-controlled football survey summary"@en .

ns1:TC_Task411 a ns1:TaskComponent ;
    rdfs:label "An ordered snake path in a rectangular character matrix"@en .

ns1:TCons_Task401_1 a ns1:TaskConstraint ;
    rdfs:label "Small groups of two or three with individual oral accountability."@en .

ns1:TCons_Task401_2 a ns1:TaskConstraint ;
    rdfs:label "Apply the documented adjustment prospectively; do not attribute its modularization requirement retrospectively to an earlier occurrence."@en .

ns1:TCons_Task402_1 a ns1:TaskConstraint ;
    rdfs:label "Assume all four inputs were successfully read."@en .

ns1:TCons_Task402_2 a ns1:TaskConstraint ;
    rdfs:label "Use current values after each assignment; a supplementary tracing table is recommended rather than required."@en .

ns1:TCons_Task403_1 a ns1:TaskConstraint ;
    rdfs:label "Positive-only data are a restriction of this task, not a universal physical law."@en .

ns1:TCons_Task403_2 a ns1:TaskConstraint ;
    rdfs:label "No unit conversion, prescribed function organization, arrays or additional oral defense is required."@en .

ns1:TCons_Task404_1 a ns1:TaskConstraint ;
    rdfs:label "Assume valid inputs; no validation, loops, functions, arrays, geometric derivation or pentagon-area calculation is required."@en .

ns1:TCons_Task405_1 a ns1:TaskConstraint ;
    rdfs:label "A return value is required; printing inside the function alone does not satisfy its contract."@en .

ns1:TCons_Task405_2 a ns1:TaskConstraint ;
    rdfs:label "A supplied function contract supports bounded implementation at Applying; it does not itself demonstrate independent modular design at Creating."@en .

ns1:TCons_Task406_1 a ns1:TaskConstraint ;
    rdfs:label "Pairwise condition counts include students with all three conditions."@en .

ns1:TCons_Task406_2 a ns1:TaskConstraint ;
    rdfs:label "No invalid-input handling or storage of all individual records is required."@en .

ns1:TCons_Task407_1 a ns1:TaskConstraint ;
    rdfs:label "Report the smallest divisor even if a chosen primality algorithm does not directly provide it."@en .

ns1:TCons_Task407_2 a ns1:TaskConstraint ;
    rdfs:label "Required explanatory comments are distinct from the optional testing judgment; no additional oral assessment is imposed."@en .

ns1:TCons_Task408_1 a ns1:TaskConstraint ;
    rdfs:label "Count condition evaluations according to the pseudocode, without assuming compiler optimization."@en .

ns1:TCons_Task408_2 a ns1:TaskConstraint ;
    rdfs:label "Only CM14 is a current direct competence association; the withdrawn CM24/K19 proposal is excluded."@en .

ns1:TCons_Task409_1 a ns1:TaskConstraint ;
    rdfs:label "The limit and fine are problem parameters, not a claim about current regulations."@en .

ns1:TCons_Task409_2 a ns1:TaskConstraint ;
    rdfs:label "No input validation, repeated calculation, functions, arrays or individual explanation is required."@en .

ns1:TCons_Task410_1 a ns1:TaskConstraint ;
    rdfs:label "Each group average uses only its own count and salary sum."@en .

ns1:TCons_Task410_2 a ns1:TaskConstraint ;
    rdfs:label "Termination entries are not respondents."@en .

ns1:TCons_Task411_1 a ns1:TaskConstraint ;
    rdfs:label "Coordinates are [row, column], not [x, y]; rows increase downwards and columns rightwards."@en .

ns1:TCons_Task411_2 a ns1:TaskConstraint ;
    rdfs:label "Required example outputs alone do not demonstrate optional test comparison and judgment."@en .

ns1:TCons_Task411_3 a ns1:TaskConstraint ;
    rdfs:label "Do not prescribe a visited structure, search strategy or function organization."@en .

ns1:Task408_Reference a ns1:Task ;
    rdfs:label "Independent IF Statements and IF-ELSE reference performance"@en ;
    ns1:hasTaskActivity ns1:TA_Task408_compare,
        ns1:TA_Task408_explain,
        ns1:TA_Task408_interpret ;
    ns1:hasTaskComponent ns1:TC_Task408 ;
