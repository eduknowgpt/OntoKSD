        ns1:CA_Task409_CM20_Learning ;
    ns1:hasInstructionalStatement "Display E in kilograms and M in Brazilian reais to two decimal places. Submit source code; explicit example comparison and judgment is optional."@en,
        "Read a valid nonnegative fractional catch weight P. Under the exercise rule of 50 kilograms and R$4.00 per excess kilogram, set E = P - 50 and M = 4 * E only when P > 50; otherwise assign zero to both."@en ;
    ns1:usesResource ns1:ER_Task409_Statement ;
