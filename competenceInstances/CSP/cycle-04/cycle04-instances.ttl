ns1:LT_Task408 a ns1:LearningTask ;
    rdfs:label "Independent IF Statements and IF-ELSE learning task"@en ;
    ns1:hasAcquisitionContext ns1:AC_Task408 ;
    ns1:hasCompetenceActivation ns1:CA_Task408_CM14_Learning ;
    ns1:hasInstructionalStatement "Examine the two supplied fragments for integer x: independent tests x > 0 and x <= 0 versus a single IF-ELSE. Assume x remains unchanged and displaying a message has no side effects."@en,
        "Explain why source-level counts do not guarantee lower runtime in every environment and why arbitrary independent IF statements are not universally equivalent to IF-ELSE. No implementation, execution, benchmark or formal complexity analysis is required."@en,
