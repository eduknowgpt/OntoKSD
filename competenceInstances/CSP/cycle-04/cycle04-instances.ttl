        ns1:CA_Task407_CM20_Learning ;
    ns1:hasInstructionalStatement "For a prime, identify it as prime. For a composite greater than one, report its smallest positive divisor greater than one. Handle 1 explicitly as nonprime with no such divisor."@en,
        "Implement a suitable algorithm and explain divisor checks, stopping conditions and special cases in code comments. Identify any external algorithm source used."@en,
        "Repeatedly read valid integers. Process positive values and stop on a nonpositive value without evaluating it."@en,
        "Submit commented source code. Comparing expected and actual outcomes and judging correctness is optional."@en ;
    ns1:usesResource ns1:ER_Task407_Statement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-04/en/TASK407-Primes/TASK407-CSP-Report.md>,
