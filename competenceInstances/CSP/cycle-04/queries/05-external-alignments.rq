PREFIX o: <http://purl.org/ontoksd#>
SELECT ?competence ?external ?type ?justification WHERE {
 ?a a o:ExternalCompetenceAlignment; o:hasInternalCompetence ?competence; o:hasExternalCompetence ?external; o:hasAlignmentType ?type; o:hasAlignmentJustification ?justification .
 FILTER(STRSTARTS(STR(?a), "http://purl.org/ontoksd#CSP4_Alignment_"))
} ORDER BY ?competence ?external
