    dcterms:identifier "CM20" ;
    ontoksd:hasDisposition ontoksd:meticulous ;
    ontoksd:hasKnowledgeSkill ontoksd:CM20_KS1,
        ontoksd:CM20_KS2,
        ontoksd:CM20_KS3 ;
