ontoksd:CM20_KS1 a ontoksd:KnowledgeSkill ;
    rdfs:label "K03 - Data types, constants and variables x Apply"@en ;
    dcterms:description "Represent numeric inputs and results using appropriate types and variables."@en ;
    ontoksd:hasBloomLevelJustificationVerb bloom:represent ;
