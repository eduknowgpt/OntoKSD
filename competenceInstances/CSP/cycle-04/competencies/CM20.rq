    dcterms:description "Encode a calculation with appropriate operands and operator precedence."@en ;
    ontoksd:hasBloomLevelJustificationVerb bloom:encode ;
    ontoksd:hasCurricularKnowledgeReference ontoksd:CSP4_Curricular_K04 ;
    ontoksd:hasKnowledgeComponent ontoksd:Knowledge_CSP4_K04 ;
