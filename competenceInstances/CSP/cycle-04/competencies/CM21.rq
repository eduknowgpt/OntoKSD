    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasTask ontoksd:Task403_Reference ;
    skos:definition "validate input values and operation conditions, rejecting invalid combinations before processing them."@en ;
    skos:scopeNote "Documented CSP cycle-04 proposal. CC2020SpecificationPattern identifies the knowledge-level/disposition structure, not authorship in the CC2020 report or formal approval. Definition is independent of task-specific manifestations."@en ;
