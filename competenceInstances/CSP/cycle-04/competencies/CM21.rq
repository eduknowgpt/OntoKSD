ontoksd:CM21_KS1 a ontoksd:KnowledgeSkill ;
    rdfs:label "K03 - Data types, constants and variables x Apply"@en ;
    dcterms:description "Check input compatibility with the required types and representations."@en ;
    ontoksd:hasBloomLevelJustificationVerb bloom:check ;
    ontoksd:hasCurricularKnowledgeReference ontoksd:CSP4_Curricular_K03 ;
    ontoksd:hasKnowledgeComponent ontoksd:Knowledge_CSP4_K03 ;
    ontoksd:hasSkillLevel bloom:Applying ;
