ontoksd:CM21_KS2 a ontoksd:KnowledgeSkill ;
    rdfs:label "K07 - Relational and logical operators x Apply"@en ;
    dcterms:description "Express the conditions that make inputs and operations valid."@en ;
    ontoksd:hasBloomLevelJustificationVerb bloom:express ;
    ontoksd:hasCurricularKnowledgeReference ontoksd:CSP4_Curricular_K07 ;
    ontoksd:hasKnowledgeComponent ontoksd:Knowledge_CSP4_K07 ;
    ontoksd:hasSkillLevel bloom:Applying ;
