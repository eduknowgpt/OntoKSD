INSERT DATA {
ontoksd:CM21 a ontoksd:AtomicCompetence,
        ontoksd:CC2020Competence,
        ontoksd:Competence ;
    rdfs:label "Validate input values and operation conditions"@en ;
    dcterms:identifier "CM21" ;
    ontoksd:hasDisposition ontoksd:meticulous,
        ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ontoksd:CM21_KS1,
        ontoksd:CM21_KS2,
        ontoksd:CM21_KS3 ;
