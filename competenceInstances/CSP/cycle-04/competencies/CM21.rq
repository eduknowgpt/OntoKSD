ontoksd:CM21_KS3 a ontoksd:KnowledgeSkill ;
    rdfs:label "K08 - Decision structures x Apply"@en ;
    dcterms:description "Accept valid combinations and reject invalid ones before performing the operation."@en ;
    ontoksd:hasBloomLevelJustificationVerb bloom:accept,
