ontoksd:CM13_KS1 a ontoksd:KnowledgeSkill ;
    rdfs:label "K10 - Arrays and matrices x Understand"@en ;
    dcterms:description "Explain the organization of an indexed structure and the correspondence between indexes and stored elements."@en ;
    ontoksd:hasBloomLevelJustificationVerb bloom:explain ;
