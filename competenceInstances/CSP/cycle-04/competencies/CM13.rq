INSERT DATA {
ontoksd:CM13 a ontoksd:AtomicCompetence,
        ontoksd:CC2020Competence,
        ontoksd:Competence ;
    rdfs:label "Explain data organization"@en ;
    dcterms:identifier "CM13" ;
    ontoksd:hasDisposition ontoksd:communicative,
        ontoksd:meticulous ;
