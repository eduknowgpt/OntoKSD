    rdfs:label "The Minotaur's Labyrinth assessment specification"@en ;
    dcterms:identifier "Task303-Assessment" ;
    dcterms:references ns1:CSPCycle03_TenPointScale ;
    ns1:hasAcquisitionContext ns1:AC_Task303 ;
