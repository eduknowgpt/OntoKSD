ns1:LT_Task303 a ns1:LearningTask ;
    rdfs:label "The Minotaur's Labyrinth learning task"@en ;
    dcterms:identifier "Task303-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task303 ;
    ns1:hasCompetenceActivation ns1:CA_Task303_C02_Learning,
        ns1:CA_Task303_C03_Learning,
        ns1:CA_Task303_C05_01_Learning,
        ns1:CA_Task303_C12_Learning,
        ns1:CA_Task303_C13_01_Learning,
        ns1:CA_Task303_C14_Learning,
        ns1:CA_Task303_C17_Learning,
        ns1:CA_Task303_C18_Learning,
        ns1:CA_Task303_C19_Learning,
        ns1:CA_Task303_C22_Learning ;
    ns1:hasInstructionalStatement "Construct a CFG for the adopted PDA route language and explain the correspondence as elaborated by the integrated CSP report; example tests alone do not prove equivalence for an infinite language."@en,
        "Construct a JFLAP navigation model and an SBC report describing operations, at least two simulations, location-sequence notation, difficulties and investigation results."@en,
        "Discuss multiple exits or dynamic obstacles as investigation questions; do not silently turn them into mandatory implementation products."@en,
        "Model outward navigation and return to the entrance using route memory in the adopted PDA formulation."@en,
        "Retain C12 as the direct PDA-construction competence in the current consolidated set. Symbol naming alone is not grammar-rule interpretation or a homomorphism analysis."@en,
        "State route-language, movement-inverse and memory assumptions. A finite pictured maze by itself does not prove nonregularity."@en ;
    ns1:isTeamBased true ;
    ns1:usesResource ns1:CSPResource_JFLAP,
        ns1:CSPResource_SBC,
        ns1:ER_Task303_Labirinto,
        ns1:ER_Task303_ProblemStatement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK303%20-%20TheMinotaursLabyrinth/TASK303%20-%20TheMinotaursLabyrinth.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK303%20-%20TheMinotaursLabyrinth/TASK303-CSP-Report.md> .

ns1:C19 a ns1:AtomicCompetence,
        ns1:CC2020Competence,
        ns1:Competence,
        owl:NamedIndividual ;
    rdfs:label "Apply homomorphisms in formal languages"@en ;
    dcterms:identifier "C19"^^xsd:string ;
    ns1:hasCompetenceScope ns1:computingSpecificCompetenceScope ;
    ns1:hasDisposition ns1:cspEpistemicRigor,
        ns1:cspIntellectualResponsibility,
        ns1:reflective ;
    ns1:hasKnowledgeSkill ns1:KS_C19_AnalyticalThinking_Analyzing,
        ns1:KS_C19_Codifications_Applying,
        ns1:KS_C19_FormalLanguages_Understanding,
        ns1:KS_C19_Homomorphisms_Applying ;
    ns1:hasSpecificationPattern ns1:CC2020SpecificationPattern ;
    ns1:hasStructureType ns1:Atomic ;
    ns1:hasTask ns1:Task301_Reference,
        ns1:Task303_Reference ;
    ns1:isComponentOfCompetence ns1:C20 ;
    rdfs:comment "This competency involves the ability to define and apply homomorphisms over symbols, strings, and languages, using formal encodings to relate symbolic representations of the same domain or different domains. Learners demonstrate this competency by: - defining mappings on symbols and applying their extensions to strings and languages; - identifying which structural properties are preserved, modified, or lost; - analyzing the conditions under which representations can be related by a formal encoding; - justifying the limits of equivalence while distinguishing structural correspondence from semantic equivalence. The scope is conceptual and interpretative, without implementation of encoding functions. The task's declared correspondence between a score and its recording motivates the analysis; it does not by itself prove a homomorphism or structural equivalence. Initial domain modeling is addressed by C18 and language operations by C17."@en ;
    owl:differentFrom ns1:C04,
        ns1:C05_01,
        ns1:C23 ;
    skos:definition "Apply homomorphisms in formal languages"@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ns1:C20 a ns1:CC2020Competence,
        ns1:Competence,
        ns1:CompositeCompetence,
        owl:NamedIndividual ;
    rdfs:label "Model and analyze musical collections as formal languages"@en ;
    dcterms:identifier "C20"^^xsd:string ;
    ns1:hasCompetenceScope ns1:computingSpecificCompetenceScope ;
    ns1:hasComponentCompetence ns1:C04,
        ns1:C05_01,
        ns1:C17,
        ns1:C18,
        ns1:C19,
        ns1:C23 ;
    ns1:hasDisposition ns1:cspEpistemicRigor,
        ns1:cspIntellectualResponsibility,
        ns1:persistent,
        ns1:reflective ;
    ns1:hasIntegrationDescription "Integrate formal abstraction (C18), operations (C17), encoding analysis (C19), regular-expression characterization (C04), consistent algebraic notation (C23) and rigorous written justification (C05.01) into one coherent account of musical collections. Alphabet/model assumptions, operations, representations and conclusions must remain mutually consistent. Integration is additional expected performance, not automatic synthesis of component evidence."@en ;
    ns1:hasKnowledgeSkill ns1:KS_C20_AnalyticalThinking_Analyzing,
        ns1:KS_C20_FormalLanguages_Applying,
        ns1:KS_C20_HomomorphismsAndCodifications_Applying,
        ns1:KS_C20_LanguageTheory_Understanding,
        ns1:KS_C20_RegularExpressions_Applying,
        ns1:KS_C20_TechnicalWrittenCommunication_Creating ;
    ns1:hasSpecificationPattern ns1:CC2020SpecificationPattern ;
    ns1:hasStructureType ns1:Composite ;
    ns1:hasTask ns1:Task301_Reference ;
    rdfs:comment "This task-level competency involves the ability to integrate concepts, operations, and representations from Formal Language Theory in order to model musical collections as formal languages and analyze rigorously their structural properties. Learners demonstrate this competency by: - abstracting musical artifacts as symbols, strings, and languages; - applying algebraic operations and regular expressions to characterize musical collections; - analyzing formal codifications and transformations between representations; - justifying structural properties, limitations, and implications through explicit definitions, minimal examples, counterexamples, and logical argumentation. This competency synthesizes the component competencies specified for this task into a coherent formal analysis of a real-world problem, without requiring implementation or operational recognizer construction."@en ;
    skos:definition "Model and analyze musical collections as formal languages"@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ns1:C18 a ns1:AtomicCompetence,
        ns1:CC2020Competence,
        ns1:Competence,
        owl:NamedIndividual ;
    rdfs:label "Model real-world problems using formal language concepts"@en ;
    dcterms:identifier "C18"^^xsd:string ;
    ns1:hasCompetenceScope ns1:computingSpecificCompetenceScope ;
    ns1:hasDisposition ns1:cspEpistemicRigor,
        ns1:cspIntellectualResponsibility,
        ns1:reflective ;
    ns1:hasKnowledgeSkill ns1:KS_C18_AnalyticalThinking_Analyzing,
        ns1:KS_C18_FormalLanguages_Applying,
        ns1:KS_C18_HomomorphismsAndCodifications_Applying,
        ns1:KS_C18_LanguageTheory_Understanding ;
    ns1:hasSpecificationPattern ns1:CC2020SpecificationPattern ;
    ns1:hasStructureType ns1:Atomic ;
    ns1:hasTask ns1:Task301_Reference,
        ns1:Task302_Reference,
        ns1:Task303_Reference,
        ns1:Task304_Reference ;
    ns1:isComponentOfCompetence ns1:C20 ;
    rdfs:comment "This competency involves the ability to abstract elements of a real-world domain and model them as formal language-based representations through explicit alphabets, strings, and languages that capture relevant structural features. Learners demonstrate this competency by: - establishing explicit mappings between domain entities and formal symbols; - defining alphabets, strings, and languages appropriate to the selected representation; - justifying modeling choices, including exclusions and simplifications; - assessing the structural adequacy of the model and identifying its formal limitations; - distinguishing structural correctness from semantic interpretation. The scope is abstraction and modeling. Operations on the resulting languages are addressed by C17, and transformations between representations by C19. Conceptual mapping supports the initial abstraction without subsuming the separate analysis of homomorphisms."@en ;
    owl:differentFrom ns1:C04,
        ns1:C05_01,
        ns1:C17,
        ns1:C19,
        ns1:C23 ;
    skos:definition "Model real-world problems using formal language concepts"@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ns1:C17 a ns1:AtomicCompetence,
        ns1:CC2020Competence,
        ns1:Competence,
        owl:NamedIndividual ;
    rdfs:label "Apply operations on formal languages"@en ;
    dcterms:identifier "C17"^^xsd:string ;
    ns1:hasCompetenceScope ns1:computingSpecificCompetenceScope ;
    ns1:hasDisposition ns1:cspEpistemicRigor,
        ns1:cspIntellectualResponsibility,
        ns1:persistent ;
    ns1:hasKnowledgeSkill ns1:KS_C17_AnalyticalThinking_Analyzing,
        ns1:KS_C17_LanguageTheory_Understanding,
        ns1:KS_C17_OperationsOnFormalLanguages_Analyzing,
        ns1:KS_C17_OperationsOnFormalLanguages_Applying,
        ns1:KS_C17_RegularExpressions_Applying ;
    ns1:hasSpecificationPattern ns1:CC2020SpecificationPattern ;
    ns1:hasStructureType ns1:Atomic ;
    ns1:hasTask ns1:Task301_Reference,
        ns1:Task302_Reference,
        ns1:Task303_Reference,
        ns1:Task304_Reference ;
    ns1:isComponentOfCompetence ns1:C20 ;
    rdfs:comment "This competency involves the ability to apply, analyze, and justify formal operations over languages, including concatenation, union, intersection, difference, complement, Kleene closure, and reversal, with attention to their structural effects and theoretical properties. Learners demonstrate this competency by: - applying operations to languages over an explicitly defined alphabet and specifying the universe for complement; - assessing the structural validity of the resulting languages; - determining whether relevant properties, including class membership, finiteness, or infinitude, are preserved; - justifying conclusions through definitions, examples, counterexamples, and known theoretical properties. The scope is conceptual and algebraic; it does not require automaton construction, simulation, or implementation."@en ;
    owl:differentFrom ns1:C04,
        ns1:C05_01,
        ns1:C19,
        ns1:C23 ;
    skos:definition "Apply operations on formal languages"@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ns1:C23 a ns1:AtomicCompetence,
        ns1:CC2020Competence,
        ns1:Competence,
        owl:NamedIndividual ;
    rdfs:label "Interpret and apply algebraic notation for strings and languages"@en ;
    dcterms:identifier "C23"^^xsd:string ;
    ns1:hasCompetenceScope ns1:computingSpecificCompetenceScope ;
    ns1:hasDisposition ns1:meticulous,
        ns1:responsible ;
    ns1:hasKnowledgeSkill ns1:KS_C23_AnalyticalThinking_Analyzing,
        ns1:KS_C23_FormalLanguages_Applying,
        ns1:KS_C23_LanguageTheory_Understanding,
        ns1:KS_C23_WrittenCommunication_Applying ;
    ns1:hasSpecificationPattern ns1:CC2020SpecificationPattern ;
    ns1:hasStructureType ns1:Atomic ;
    ns1:hasTask ns1:Task301_Reference,
        ns1:Task302_Reference,
        ns1:Task304_Reference ;
    ns1:isComponentOfCompetence ns1:C20 ;
    rdfs:comment "This competency involves the ability to interpret, use, and justify formal algebraic notation for strings and languages in order to represent, analyze, and communicate structural properties of symbolic systems. Learners demonstrate this competency by: - interpreting standard notation for strings, such as ε, Σ, |x|, concatenation, exponentiation, reversal, prefixes, suffixes, and substrings; - interpreting and applying standard notation for languages, such as union, intersection, complement, concatenation, \\(L^n\\), and \\(L^*\\); - using algebraic notation consistently to express structural properties, operations, and relations over strings and languages; - connecting formal notation to conceptual reasoning about symbolic structures and language behavior; - justifying the meaning and use of notation in formally rigorous answers. This competency supports instructional contexts in which learners must reason explicitly through symbolic notation, not merely recognize concepts informally."@en ;
    owl:differentFrom ns1:C05_01 ;
    skos:definition "Interpret and apply algebraic notation for strings and languages"@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ns1:C05_01 a ns1:AtomicCompetence,
        ns1:CC2020Competence,
        ns1:Competence,
        owl:NamedIndividual ;
    rdfs:label "Write mathematically rigorous answers"@en ;
    dcterms:identifier "C05.01"^^xsd:string ;
    ns1:hasCompetenceScope ns1:transversalCompetenceScope ;
    ns1:hasDisposition ns1:meticulous,
        ns1:responsible ;
    ns1:hasKnowledgeSkill ns1:C05_01_KS1,
        ns1:C05_01_KS2,
        ns1:C05_01_KS3 ;
    ns1:hasSpecializationDescription "C05.01 directly specializes C05 by requiring mathematically rigorous answers with explicit definitions, precise notation, structured argumentation, examples and counterexamples where appropriate. The relationship does not copy base values automatically or establish learner attainment."@en ;
    ns1:hasSpecificationPattern ns1:CC2020SpecificationPattern ;
    ns1:hasStructureType ns1:Atomic ;
    ns1:hasTask ns1:Task301_Reference,
        ns1:Task302_Reference,
        ns1:Task303_Reference,
        ns1:Task304_Reference ;
    ns1:isComponentOfCompetence ns1:C20 ;
    ns1:isSpecializationOf ns1:C05 ;
    rdfs:comment "This competency involves the ability to produce mathematically rigorous written answers that clearly justify conclusions through explicit definitions, precise notation, structured arguments, and appropriate supporting examples. Learners demonstrate this competency by: - stating relevant formal definitions clearly; - organizing answers so that claims, justifications, and conclusions are explicitly connected; - using examples or counterexamples when they help clarify or validate the reasoning; - applying appropriate technical and mathematical notation consistently; - presenting arguments with sufficient rigor to support the correctness of the conclusion. This competency specializes technical report writing toward tasks in which the main evidence lies not only in presenting a result, but in formally justifying why the result is valid."@en ;
    skos:definition "Write mathematically rigorous answers"@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

