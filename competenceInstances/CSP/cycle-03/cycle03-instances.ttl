ns1:LT_Task301 a ns1:LearningTask ;
    rdfs:label "Music Collection learning task"@en ;
    dcterms:identifier "Task301-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task301 ;
    ns1:hasCompetenceActivation ns1:CA_Task301_C04_Learning,
        ns1:CA_Task301_C05_01_Learning,
        ns1:CA_Task301_C14_Learning,
        ns1:CA_Task301_C17_Learning,
        ns1:CA_Task301_C18_Learning,
        ns1:CA_Task301_C19_Learning,
        ns1:CA_Task301_C20_Learning,
        ns1:CA_Task301_C23_Learning ;
    ns1:hasInstructionalStatement "Address the collection questions: the 3500 rock pieces, 700 operas, first-20-note excerpts, empty collection, empty song, repetition, romantic-song predicate, union/intersection, combined instruments and complement relative to an explicit universe."@en,
        "Analyze concatenation, prefixes/suffixes/substrings and reversal, distinguishing structural validity from musical interpretation."@en,
        "Analyze whether score/MP3 correspondence supports interchangeability or a formal encoding; the declared correspondence is not by itself a proof of a homomorphism."@en,
        "Define the alphabet and encoding assumptions for single-instrument and compound multi-instrument score symbols; represent songs as finite strings and collections as languages."@en,
        "Justify every answer using definitions, explicit notation, examples, counterexamples and arguments where relevant. Work as a group."@en,
        "Use regular expressions and automata conceptually where they support an argument; no executable automaton or simulation deliverable is required."@en ;
    ns1:isTeamBased true ;
    ns1:usesResource ns1:ER_Task301_ProblemStatement,
        ns1:ER_Task301_img01,
        ns1:ER_Task301_img02 ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301%20-%20MusicCollection.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ns1:LT_Task302 a ns1:LearningTask ;
    rdfs:label "The Vending Machine for Soft Drinks and Snacks learning task"@en ;
    dcterms:identifier "Task302-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task302 ;
    ns1:hasCompetenceActivation ns1:CA_Task302_C02_Learning,
        ns1:CA_Task302_C03_Learning,
        ns1:CA_Task302_C04_Learning,
        ns1:CA_Task302_C05_01_Learning,
        ns1:CA_Task302_C06_Learning,
        ns1:CA_Task302_C17_Learning,
        ns1:CA_Task302_C18_Learning,
        ns1:CA_Task302_C23_Learning ;
    ns1:hasInstructionalStatement "If a regular-expression representation for a selected fragment is feasible, include it and its construction method; otherwise justify the limitation."@en,
        "Investigate nondeterministic behavior, relate machine options/payments to alphabet symbols and use formal notation consistently."@en,
        "Model at least three products, accepting R$1 and R$2, dispensing the selected product and returning change. The listed drinks cost R$5/R$7 and snack packets R$7/R$10."@en,
        "Preserve the source simulation objective despite conditional activation metadata; hypothetical examples are not evidence that the model was executed."@en,
        "Submit a JFLAP-compatible automaton file and an SBC-format report describing payment/dispensing operations with at least two examples."@en,
        "The R$1 random bonus-change modification under exact payment is an additional challenge, not a baseline requirement."@en ;
    ns1:usesResource ns1:CSPResource_JFLAP,
        ns1:CSPResource_SBC,
        ns1:ER_Task302_ProblemStatement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK302%20-%20TheVendingMachine/TASK302%20-%20TheVendingMachine.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK302%20-%20TheVendingMachine/TASK302-CSP-Report.md> .

ns1:LT_Task304 a ns1:LearningTask ;
    rdfs:label "Traffic Control learning task"@en ;
    dcterms:identifier "Task304-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task304 ;
    ns1:hasCompetenceActivation ns1:CA_Task304_C05_01_Learning,
        ns1:CA_Task304_C07_Learning,
        ns1:CA_Task304_C09_Learning,
        ns1:CA_Task304_C10_Learning,
        ns1:CA_Task304_C16_Learning,
        ns1:CA_Task304_C17_Learning,
        ns1:CA_Task304_C18_Learning,
        ns1:CA_Task304_C23_Learning ;
    ns1:hasInstructionalStatement "Classify light vehicles at weight <=6 tonnes, heavy vehicles at 6<weight<10 tonnes and very-heavy vehicles at weight >=10 tonnes."@en,
        "Consider the need for Turing Machine extensions and explain the relation between the formal model and the intuitive algorithm notion in the source objectives."@en,
        "Develop the adopted machine model and submit one or more JFLAP files and an SBC-format report with detailed system operation and theoretical justification."@en,
        "Preserve algebraic encoding, formal reasoning and model-adequacy discussion without redefining the reusable competence pairings."@en,
        "Use the sensor-derived input to count vehicles by category during the previous night and identify the most frequent category."@en,
        "Variant-related discussion remains conditional; the adopted formalism is an instructional representation, not a blanket proof that every bounded formulation excludes other models."@en ;
    ns1:usesResource ns1:CSPResource_JFLAP,
        ns1:CSPResource_SBC,
        ns1:ER_Task304_ProblemStatement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK304%20-%20TrafficControl/TASK304%20-%20TrafficControl.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK304%20-%20TrafficControl/TASK304-CSP-Report.md> .

ns1:LT_Task305 a ns1:LearningTask ;
    rdfs:label "Online Judges at Logistic Solutions learning task"@en ;
    dcterms:identifier "Task305-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task305 ;
    ns1:hasCompetenceActivation ns1:CA_Task305_C02_Learning,
        ns1:CA_Task305_C03_Learning,
        ns1:CA_Task305_C05_Learning,
        ns1:CA_Task305_C06_Learning,
        ns1:CA_Task305_C14_Learning,
        ns1:CA_Task305_C15_Learning,
        ns1:CA_Task305_C16_Learning,
        ns1:CA_Task305_C21_Learning ;
    ns1:hasInstructionalStatement "Analyze TSP and timetabling submissions and reasons for TLE in relation to input size, algorithmic strategy, resource limits and problem formulation."@en,
        "Explain computability/termination limits and distinguish them from practical time limits and NP-hardness."@en,
        "Preserve the source simulation/testing objective while documenting conditional C03 activation. Do not treat every timeout as an infinite loop."@en,
        "Provide an SBC-format article with hypotheses, characterization of TSP/PT, manager-facing answers, the FSM and illustrative examples."@en,
        "Represent observable Online Judge workflow and AC, WA, TLE, CE and RE outcomes with an FSM, explaining model and evaluation limits."@en,
        "State the formulation before assigning a complexity class: decision TSP and optimization TSP are different formulations; timetabling depends on its constraints."@en,
        "The experiment evaluating TSP/PT code at different input sizes is an extra challenge; no benchmark result or executed evaluation is asserted."@en ;
    ns1:usesResource ns1:CSPResource_JFLAP,
        ns1:CSPResource_SBC,
        ns1:ER_Task305_ProblemStatement ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK305%20-%20OnlineJudges/TASK305%20-%20OnlineJudges.md>,
        <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK305%20-%20OnlineJudges/TASK305-CSP-Report.md> .

