ontoksd:C20 a ontoksd:CC2020Competence,
        ontoksd:Competence,
        ontoksd:CompositeCompetence,
        owl:NamedIndividual ;
    rdfs:label "Model and analyze musical collections as formal languages"@en ;
    dcterms:identifier "C20"^^xsd:string ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasComponentCompetence ontoksd:C04,
        ontoksd:C05_01,
        ontoksd:C17,
        ontoksd:C18,
        ontoksd:C19,
        ontoksd:C23 ;
    ontoksd:hasDisposition ontoksd:cspEpistemicRigor,
        ontoksd:cspIntellectualResponsibility,
        ontoksd:persistent,
        ontoksd:reflective ;
    ontoksd:hasIntegrationDescription "Integrate formal abstraction (C18), operations (C17), encoding analysis (C19), regular-expression characterization (C04), consistent algebraic notation (C23) and rigorous written justification (C05.01) into one coherent account of musical collections. Alphabet/model assumptions, operations, representations and conclusions must remain mutually consistent. Integration is additional expected performance, not automatic synthesis of component evidence."@en ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_C20_AnalyticalThinking_Analyzing,
        ontoksd:KS_C20_FormalLanguages_Applying,
        ontoksd:KS_C20_HomomorphismsAndCodifications_Applying,
        ontoksd:KS_C20_LanguageTheory_Understanding,
        ontoksd:KS_C20_RegularExpressions_Applying,
        ontoksd:KS_C20_TechnicalWrittenCommunication_Creating ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasStructureType ontoksd:Composite ;
    rdfs:comment "This task-level competency involves the ability to integrate concepts, operations, and representations from Formal Language Theory in order to model musical collections as formal languages and analyze rigorously their structural properties. Learners demonstrate this competency by: - abstracting musical artifacts as symbols, strings, and languages; - applying algebraic operations and regular expressions to characterize musical collections; - analyzing formal codifications and transformations between representations; - justifying structural properties, limitations, and implications through explicit definitions, minimal examples, counterexamples, and logical argumentation. This competency synthesizes the component competencies specified for this task into a coherent formal analysis of a real-world problem, without requiring implementation or operational recognizer construction."@en ;
    skos:definition "Model and analyze musical collections as formal languages"@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .
