    ontoksd:hasAlignmentType ontoksd:NarrowerThanExternalAlignment ;
    ontoksd:hasAlignmentJustification "The competence addresses a specific part of the BNCC refinement process: translating a problem into inputs, outputs, variables, and computational structure."@en .

  ontoksd:EA_CT25.24.1_BNCC_EM13CO01 a ontoksd:ExternalCompetenceAlignment ;
    ontoksd:mediatesInternalCompetence ontoksd:CT25.24.1 ;
    ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO01 ;
    ontoksd:hasAlignmentType ontoksd:PartialAlignment ;
    ontoksd:hasAlignmentJustification "The task may reuse known formula structures and solution patterns, but reuse is not the main focus of the competence."@en .

  ontoksd:EA_CT25.24.1_BNCC_CG1 a ontoksd:ExternalCompetenceAlignment ;
    ontoksd:mediatesInternalCompetence ontoksd:CT25.24.1 ;
    ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_1 ;
    ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ;
    ontoksd:hasAlignmentJustification "Supports understanding possibilities and limits of computing for solving problems and proposing computational solutions."@en .

  ontoksd:EA_CT25.24.1_BNCC_EF69CO05 a ontoksd:ExternalCompetenceAlignment ;
