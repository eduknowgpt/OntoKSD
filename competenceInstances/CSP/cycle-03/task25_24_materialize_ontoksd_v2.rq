  #################################################################
  # Competence activations
  #################################################################

  ontoksd:CA_Task25.24_CT25.24.1 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.24.1 in Task25.24"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.24 ;
    ontoksd:mediatesCompetence ontoksd:CT25.24.1 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalyticalConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.24.1 is activated as a mandatory core analytical-constructive competence because the task requires learners to translate a physics-based situation into variables, inputs, outputs, constraints, and computational structure."@en .

  ontoksd:CA_Task25.24_CT25.24.2 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.24.2 in Task25.24"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.24 ;
    ontoksd:mediatesCompetence ontoksd:CT25.24.2 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.24.2 is activated as a mandatory core analytical competence because the program must branch among the possible missing-variable cases and select the appropriate calculation."@en .

  ontoksd:CA_Task25.24_CT25.24.3 a ontoksd:CompetenceActivation ;
