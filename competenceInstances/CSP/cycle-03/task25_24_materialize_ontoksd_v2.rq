    ontoksd:mediatesExternalCompetence ontoksd:BNCC_EF69CO05 ;
    ontoksd:hasAlignmentType ontoksd:CurricularContinuityAlignment ;
    ontoksd:hasAlignmentJustification "Prior-stage support for identifying inputs, expected outputs, and defining a problem as a relation between input and output."@en .

