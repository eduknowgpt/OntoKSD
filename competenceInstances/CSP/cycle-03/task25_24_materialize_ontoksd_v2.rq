    ontoksd:hasAlignmentType ontoksd:NarrowerThanExternalAlignment ;
    ontoksd:hasAlignmentJustification "Input validation is a specific refinement needed to make the computational solution robust."@en .

  ontoksd:EA_CT25.24.3_BNCC_EM13CO06 a ontoksd:ExternalCompetenceAlignment ;
    ontoksd:mediatesInternalCompetence ontoksd:CT25.24.3 ;
