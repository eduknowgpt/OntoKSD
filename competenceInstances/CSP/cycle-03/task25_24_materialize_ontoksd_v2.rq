  #################################################################
  # Assessment and evidence specification
  #################################################################

  ontoksd:Assessment_Task25.24 a ontoksd:Assessment ;
    rdfs:label "Assessment specification for Task25.24"@en ;
    dcterms:title "Assessment specification for Task25.24"@en ;
    dc:description "Assessment specification for the source code, documented reasoning, test cases, and explanation of the interactive average-velocity program associated with Task25.24."@en ;
    ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentType ;
    rdfs:comment "The assessment design distinguishes artifact-level evidence from performance-level execution evidence and learner-level explanation. This is important because the Physics formula acts as a prerequisite context, while the competence evidence concerns computational modeling, branching, validation, repetition, testing, and explanation."@en .

  ontoksd:AssessmentOccurrence_Task25.24 a ontoksd:AssessmentOccurrence ;
    rdfs:label "Assessment occurrence for Task25.24"@en ;
    ontoksd:realizes ontoksd:Assessment_Task25.24 ;
    ontoksd:occursInAcquisitionContext ontoksd:AC_Task25.24 ;
    ontoksd:producesEvidence ontoksd:Evidence_Task25.24_SourceCode ,
                             ontoksd:Evidence_Task25.24_DocumentedReasoning ,
                             ontoksd:Evidence_Task25.24_TestCases ,
                             ontoksd:Evidence_Task25.24_ProgramExecution ,
                             ontoksd:Evidence_Task25.24_Explanation ;
    rdfs:comment "Concrete assessment occurrence that produces evidence from source code, documentation, test cases, correct program execution across scenarios, handling of invalid inputs, and learner explanation of computational logic and decisions."@en .

  ontoksd:Evidence_Task25.24_SourceCode a ontoksd:Evidence ;
    rdfs:label "Task25.24 source code evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:SourceCode ;
    rdfs:comment "Artifact-level evidence consisting of the implemented program, including conditional logic, input validation, loop structure, and computation of the missing variable."@en .

  ontoksd:Evidence_Task25.24_DocumentedReasoning a ontoksd:Evidence ;
    rdfs:label "Task25.24 documented reasoning evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:Document ;
    rdfs:comment "Artifact-level evidence consisting of documentation that explains the computational model, input-output constraints, conditional cases, validation strategy, and decisions used in the program."@en .

  ontoksd:Evidence_Task25.24_TestCases a ontoksd:Evidence ;
    rdfs:label "Task25.24 test cases evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:TestCaseSet ;
    rdfs:comment "Artifact-level and performance-oriented evidence consisting of test cases showing correct behavior across different input scenarios, including each missing-variable case and invalid input configurations."@en .

  ontoksd:Evidence_Task25.24_ProgramExecution a ontoksd:Evidence ;
    rdfs:label "Task25.24 program execution evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:ProgramExecution ;
    rdfs:comment "Performance-level evidence showing correct execution across scenarios, correct branching logic, handling of invalid inputs, and termination or repeated execution behavior."@en .

  ontoksd:Evidence_Task25.24_Explanation a ontoksd:Evidence ;
    rdfs:label "Task25.24 explanation of computational logic evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:OralExplanation ;
    rdfs:comment "Learner-level evidence consisting of the learner's explanation and justification of how the missing variable is identified and computed, why validation rules are necessary, how loops are controlled, and how test cases support confidence in correctness."@en .

}
