    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.24.4 is activated as a mandatory core constructive competence because the interactive program must allow repeated execution through loops and explicit termination conditions."@en .

  ontoksd:CA_Task25.24_CT25.24.5 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.24.5 in Task25.24"@en ;
