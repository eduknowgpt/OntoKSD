    ontoksd:mediatesCompetence ontoksd:CT25.24.3 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalyticalConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.24.3 is activated as a mandatory core analytical-constructive competence because learners must check constraints, validate inputs, and implement handling for invalid computational states."@en .

  ontoksd:CA_Task25.24_CT25.24.4 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.24.4 in Task25.24"@en ;
