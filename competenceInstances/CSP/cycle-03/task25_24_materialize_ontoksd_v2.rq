PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX dc:        <http://purl.org/dc/elements/1.1/>
PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <https://csed.acm.org/knowledge-area/>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {


  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.24 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.24 — Program to Explore the Average Velocity Formula"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.24 in an introductory programming context integrated with Physics for students in the first-year Integrated Technical Program in Informatics. The interdisciplinary nature supports conceptual understanding, while the specified competencies remain focused on computational modeling, conditional logic, input validation, loops, testing, and explanation of program logic."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.24 a ontoksd:LearningTask ;
    rdfs:label "Task25.24 — Program to Explore the Average Velocity Formula"@en ;
    dcterms:title "Task25.24 — Program to Explore the Average Velocity Formula"@en ;
    dc:description "Learning task in which learners develop an interactive program that receives two of three variables — average velocity, distance, and time — and computes the missing one using the appropriate rearrangement of the formula. The program identifies the missing value, validates inputs, applies conditional branches, allows repeated execution through a loop, and is tested across multiple scenarios."@en ;
    rdfs:comment "Although the uploaded CSP-Report internally refers to TASK26.6, this materialization follows the user's request for Task25.24. Physics knowledge, including the average velocity formula and algebraic rearrangement, is represented as prerequisite support rather than as the target of the competency specification. The task is modeled as a LearningTask focused on computing competencies."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.24 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.24_CT25.24.1 ,
                                 ontoksd:CA_Task25.24_CT25.24.2 ,
                                 ontoksd:CA_Task25.24_CT25.24.3 ,
                                 ontoksd:CA_Task25.24_CT25.24.4 ,
                                 ontoksd:CA_Task25.24_CT25.24.5 ,
                                 ontoksd:CA_Task25.24_CT25.24.6 .

  #################################################################
  # Prerequisite knowledge base
  #################################################################

  ontoksd:PrerequisiteKnowledge_Task25.24_AverageVelocityFormula a ontoksd:Knowledge ;
    rdfs:label "Prerequisite knowledge for Task25.24 — Average velocity formula"@en ;
    skos:prefLabel "Average velocity formula as prerequisite knowledge"@en ;
    rdfs:comment "Prerequisite knowledge used to support the task context: understanding of the average velocity formula, algebraic rearrangement of formulas, and interpretation of physical quantities. This knowledge is not modeled as a target competence in Task25.24 because the CSP-Report explicitly states that the competency specification focuses on Computing."@en .

  #################################################################
  # Competence specifications
  #################################################################

  ontoksd:CT25.24.1 a ontoksd:Competence ;
    rdfs:label "CT25.24.1 — Model computational problems with multiple input-output configurations"@en ;
    dcterms:title "Model computational problems with multiple input-output configurations"@en ;
    dc:description "This competence involves transforming a real-world problem into a computational model by identifying variables, inputs, outputs, and constraints."@en ;
    rdfs:comment "In Task25.24, this competence is demonstrated when learners identify that exactly one of the three variables is unknown and must be computed from the other two."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:analytical ;
    ontoksd:hasPrerequisiteKnowledge ontoksd:PrerequisiteKnowledge_Task25.24_AverageVelocityFormula ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.24.1_ProblemModeling_Applying ,
                              ontoksd:KS_CT25.24.1_InputsOutputs_Applying ,
                              ontoksd:KS_CT25.24.1_VariableRepresentation_Applying .

  ontoksd:CT25.24.2 a ontoksd:Competence ;
    rdfs:label "CT25.24.2 — Design conditional logic for multi-case computational problems"@en ;
    dcterms:title "Design conditional logic for multi-case computational problems"@en ;
    dc:description "This competence involves designing conditional structures to handle different execution paths based on input conditions."@en ;
    rdfs:comment "In Task25.24, this competence is demonstrated when learners create branches to determine which variable must be calculated and select the appropriate formula transformation."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:logical ;
    ontoksd:hasPrerequisiteKnowledge ontoksd:PrerequisiteKnowledge_Task25.24_AverageVelocityFormula ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.24.2_ConditionalStructures_Applying ,
                              ontoksd:KS_CT25.24.2_MultiCaseLogic_Analyzing ,
                              ontoksd:KS_CT25.24.2_ExecutionFlow_Applying .

  ontoksd:CT25.24.3 a ontoksd:Competence ;
    rdfs:label "CT25.24.3 — Validate user input and handle invalid computational states"@en ;
    dcterms:title "Validate user input and handle invalid computational states"@en ;
    dc:description "This competence involves ensuring that input data satisfies constraints and that invalid configurations are detected and handled."@en ;
    rdfs:comment "In Task25.24, this competence is demonstrated when learners validate values, detect invalid states, avoid invalid calculations, and ensure that exactly two valid inputs are provided."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:responsible , ontoksd:careful ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.24.3_InputValidation_Applying ,
                              ontoksd:KS_CT25.24.3_ErrorHandling_Applying ,
                              ontoksd:KS_CT25.24.3_ConstraintChecking_Analyzing .

  ontoksd:CT25.24.4 a ontoksd:Competence ;
    rdfs:label "CT25.24.4 — Control program execution using loops and termination conditions"@en ;
    dcterms:title "Control program execution using loops and termination conditions"@en ;
    dc:description "This competence involves structuring repetitive execution and defining conditions for continuation and termination."@en ;
    rdfs:comment "In Task25.24, this competence is demonstrated when learners implement a loop to allow repeated executions and define a termination condition for the interactive program."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:persistent ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.24.4_Loops_Applying ,
                              ontoksd:KS_CT25.24.4_TerminationConditions_Applying ,
                              ontoksd:KS_CT25.24.4_ExecutionControl_Applying .

  ontoksd:CT25.24.5 a ontoksd:Competence ;
    rdfs:label "CT25.24.5 — Test and verify computational solutions across multiple scenarios"@en ;
    dcterms:title "Test and verify computational solutions across multiple scenarios"@en ;
    dc:description "This competence involves testing the program with different inputs to verify correctness and robustness."@en ;
    rdfs:comment "In Task25.24, this competence is demonstrated when learners produce test cases, verify expected outputs, and inspect program behavior across valid and invalid input configurations."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:critical ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.24.5_Testing_Applying ,
                              ontoksd:KS_CT25.24.5_CaseAnalysis_Analyzing ,
                              ontoksd:KS_CT25.24.5_OutputVerification_Applying .

  ontoksd:CT25.24.6 a ontoksd:Competence ;
    rdfs:label "CT25.24.6 — Explain and document computational logic and decisions"@en ;
    dcterms:title "Explain and document computational logic and decisions"@en ;
    dc:description "This competence involves explaining the reasoning behind the program and documenting the logic used."@en ;
    rdfs:comment "In Task25.24, this competence is demonstrated when learners explain how the missing variable is identified and computed, document conditional and validation logic, and justify implementation decisions."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:professionalCompetenceScope ;
    ontoksd:hasDisposition ontoksd:communicative , ontoksd:reflective ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.24.6_AlgorithmExplanation_Understanding ,
                              ontoksd:KS_CT25.24.6_Documentation_Applying ,
                              ontoksd:KS_CT25.24.6_LogicalReasoning_Applying .

