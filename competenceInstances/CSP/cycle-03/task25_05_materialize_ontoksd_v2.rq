PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ontoksd: <http://purl.org/ontoksd#>

INSERT DATA {

  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.05 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.05 — Juízes Online na Logistic Solutions"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.05 in ILFTC – Introdução às Linguagens Formais e Teoria da Computação. This context frames a problem-based learning task centered on Online Judges, finite-state modeling of evaluation flow, computational complexity of TSP and timetabling, practical causes of TLE, theoretical limits of automated program analysis, and rigorous technical reporting."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.05 a ontoksd:LearningTask ;
    rdfs:label "Task25.05 — Juízes Online na Logistic Solutions"@pt ;
    dcterms:title "Task25.05 — Juízes Online na Logistic Solutions"@pt ;
    dc:description "Learning task in which learners analyze Online Judges, explain why TSP and timetabling instances tend to produce TLE, discuss practical and theoretical limits of automated program evaluation, model the judge's behavior through a finite-state machine, and communicate the analysis in a rigorous technical report."@en ;
    rdfs:comment "Task25.05 is a formal modeling and theoretical analysis task in which learners investigate the behavior and limitations of Online Judges by combining finite-state modeling, computational complexity analysis, and computability-based reasoning. The task requires explanation of why difficult problems such as the Traveling Salesman Problem and Timetabling often lead to TLE, discussion of algorithmic strategies to achieve Accepted results, analysis of what Online Judges can and cannot diagnose in general, construction of a finite-state machine representing the evaluation flow, possible JFLAP simulation of that model, and a technical report that articulates practical observations with concepts such as NP-hardness, the Halting Problem, and Turing-based computational limits."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.05 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.05_C21 ,
                                 ontoksd:CA_Task25.05_C15 ,
                                 ontoksd:CA_Task25.05_C06 ,
                                 ontoksd:CA_Task25.05_C16 ,
                                 ontoksd:CA_Task25.05_C03 ,
                                 ontoksd:CA_Task25.05_C02 ,
                                 ontoksd:CA_Task25.05_C14 ,
                                 ontoksd:CA_Task25.05_C05 .

  #################################################################
  # Competence activations
  #################################################################

  ontoksd:CA_Task25.05_C21 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C21 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C21 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C21 is activated in Task25.05 as a core analytical competence because learners must explain why TSP and timetabling instances tend to return TLE, relate these outcomes to computational complexity and NP-hardness, and discuss practical strategies for obtaining Accepted results under Online Judge constraints."@en .

  ontoksd:CA_Task25.05_C15 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C15 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C15 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ,
                               ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C15 is activated in Task25.05 as a core competence because learners must explain fundamental theoretical limits of Online Judges, especially why certain program behaviors and causes of nontermination or TLE cannot be completely diagnosed in general, grounding the discussion in the Halting Problem and its implications."@en .

  ontoksd:CA_Task25.05_C06 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C06 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C06 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C06 is activated in Task25.05 as a mandatory supporting competence because learners must construct a finite-state machine that represents the evaluation flow of an Online Judge, including outcomes such as AC, WA, CE, RE, and TLE, as an explicit explanatory model of system behavior."@en .

  ontoksd:CA_Task25.05_C16 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C16 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C16 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amInterpretative ;
    ontoksd:hasActivationConstraint ontoksd:acConditional ;
    rdfs:comment "C16 is activated in Task25.05 as a conditional supporting competence when learners explicitly interpret Turing Machine concepts, universal computation, and computability notions to analyze what Online Judges can and cannot determine about arbitrary submitted programs."@en .

  ontoksd:CA_Task25.05_C03 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C03 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C03 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amArtifactOriented ;
    ontoksd:hasActivationConstraint ontoksd:acConditional ;
    rdfs:comment "C03 is activated in Task25.05 as a conditional supporting competence when learners use JFLAP or an equivalent simulator to test and illustrate the finite-state machine that models the Online Judge evaluation flow."@en .

  ontoksd:CA_Task25.05_C02 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C02 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C02 ;
    ontoksd:hasActivationRole ontoksd:arExtension ;
    ontoksd:hasActivationMode ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acOptional ;
    rdfs:comment "C02 is activated in Task25.05 as an optional extension competence when learners explicitly justify why a deterministic finite-state model is adequate to represent the observable evaluation flow of an Online Judge, even though this justification is not required as an independent core outcome."@en .

  ontoksd:CA_Task25.05_C14 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C14 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C14 ;
    ontoksd:hasActivationRole ontoksd:arExtension ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acOptional ;
    rdfs:comment "C14 is activated in Task25.05 as an optional extension competence when learners enrich their analysis by relating Online Judge capabilities and limitations to broader distinctions among language classes, formal grammars, or abstract computational models."@en .

  ontoksd:CA_Task25.05_C05 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C05 in Task25.05"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.05 ;
    ontoksd:mediatesCompetence ontoksd:C05 ;
    ontoksd:hasActivationRole ontoksd:arTransversal ;
    ontoksd:hasActivationMode ontoksd:amArtifactOriented ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C05 is activated in Task25.05 as a transversal competence because the main evidence of learning is an SBC-style technical report that must clearly articulate the FSM model of the Online Judge, the analysis of TSP and timetabling under time limits, and the practical and theoretical explanations of system limitations."@en .

}
