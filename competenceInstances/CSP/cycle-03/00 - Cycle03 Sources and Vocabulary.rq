# Cycle-03 CSP references, shared knowledge, dispositions and numeric course scale; no source documents bundled.
# Incremental INSERT-only cycle-03 data. See README.md for dependencies and source limits.
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
ontoksd:CSPCycle03_TenPointScale a ontoksd:Scale ;
    rdfs:label "Cycle-03 syllabus numeric grading scale, 0 to 10"@en ;
    ontoksd:maxValue 10.0 ;
    ontoksd:minValue 0.0 ;
    skos:scopeNote "The syllabus documents a numeric range only. No score step, qualitative proficiency bands, minimum attainment or course-approval threshold is inferred."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/syllabus/syllabusTheoryOfComputation.md> .

ontoksd:Course_FormalLanguagesAndTheoryOfComputation a ontoksd:Course ;
    ontoksd:hasInstructionalUnit ontoksd:AS_Task301,
        ontoksd:AS_Task302,
        ontoksd:AS_Task303,
        ontoksd:AS_Task304,
        ontoksd:AS_Task305,
        ontoksd:LT_Task301,
        ontoksd:LT_Task302,
        ontoksd:LT_Task303,
        ontoksd:LT_Task304,
        ontoksd:LT_Task305 ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/syllabus/syllabusTheoryOfComputation.md> .

ontoksd:Knowledge_CSP_AlgorithmicScalability a ontoksd:Knowledge ;
    rdfs:label "Algorithmic Scalability"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Conceptual relationships among input growth, algorithmic cost, practical resource limits and feasibility of solving instances."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK305%20-%20OnlineJudges/TASK305-CSP-Report.md> .

ontoksd:Knowledge_CSP_Codifications a ontoksd:Knowledge ;
    rdfs:label "Codifications"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Formal encodings and conditions under which symbolic representations can or cannot be treated as structurally interchangeable."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ontoksd:Knowledge_CSP_ComplexityClassesAndIntractability a ontoksd:Knowledge ;
    rdfs:label "Complexity Classes and Intractability"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "P, NP, NP-hardness, NP-completeness and the distinction between decision and optimization formulations and their tractability implications."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK305%20-%20OnlineJudges/TASK305-CSP-Report.md> .

ontoksd:Knowledge_CSP_ComputationalComplexity a ontoksd:Knowledge ;
    rdfs:label "Computational Complexity"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Analysis of input size, computational resources, cost growth and performance limits of algorithmic solutions."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK305%20-%20OnlineJudges/TASK305-CSP-Report.md> .

ontoksd:Knowledge_CSP_FormalLanguages a ontoksd:Knowledge ;
    rdfs:label "Formal Languages"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Collections as sets of strings, representation assumptions and structural properties considered independently of semantic interpretation."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ontoksd:Knowledge_CSP_Homomorphisms a ontoksd:Knowledge ;
    rdfs:label "Homomorphisms"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Mappings defined on symbols and extended to strings and languages, including structural preservation and transformation properties."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ontoksd:Knowledge_CSP_HomomorphismsAndCodifications a ontoksd:Knowledge ;
    rdfs:label "Homomorphisms and Codifications"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Mappings between symbolic representations, preservation/loss of structure, and limits of representational equivalence."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ontoksd:Knowledge_CSP_LanguageTheory a ontoksd:Knowledge ;
    rdfs:label "Language Theory"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Alphabets, strings, languages, empty string/language, substructures and finite/infinite collections, as foundations of formal representation."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ontoksd:Knowledge_CSP_OperationsOnFormalLanguages a ontoksd:Knowledge ;
    rdfs:label "Operations on Formal Languages"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Concatenation, union, intersection, difference, complement relative to a universe, Kleene closure, reversal and conceptual closure properties."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ontoksd:cspEpistemicRigor a ontoksd:Disposition ;
    rdfs:label "Epistemic Rigor"@en ;
    skos:definition "An orientation toward explicit formal justification, with careful distinction among definitions, examples, counterexamples and conclusions, rather than reliance on informal intuition."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

ontoksd:cspIntellectualResponsibility a ontoksd:Disposition ;
    rdfs:label "Intellectual Responsibility"@en ;
    skos:definition "An orientation toward accountability for the correctness, assumptions and limits of formal claims and explanatory arguments."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-03/en/TASK301%20-%20MusicCollection/TASK301-CSP-Report.md> .

