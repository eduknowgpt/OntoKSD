PREFIX ontoksd:     <http://purl.org/ontoksd#>
PREFIX rdfs:        <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:         <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:     <http://purl.org/dc/terms/>

INSERT DATA {

  ontoksd:C20   a ontoksd:Competence ;
      rdfs:label "Model and analyze musical collections as formal languages"@en ;
      dcterms:identifier "C20"^^xsd:string ;
      rdfs:comment "Core composite task-level competence concerned with integrating concepts, representations, and formal operations from Formal Language Theory in order to model musical collections as formal languages and analyze their structural properties in a coherent and rigorously justified way. Demonstration of this competence requires coordinated performance across abstraction of the musical domain into symbols, strings, and languages; algebraic characterization of collections through formal operations and regular expressions; conceptual analysis of codifications and transformations between representations; and explicit justification of structural properties, limits, and consequences through precise definitions, minimal examples, counterexamples, and logically structured argumentation. This competence does not introduce isolated new knowledge components of its own; rather, it synthesizes previously developed atomic and transversal competences into an integrated formal analysis of a real-world problem."@en ;
      ontoksd:hasStructureType ontoksd:Composite ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasDisposition
          ontoksd:Reflectiveness ,
          ontoksd:Persistence ;
      ontoksd:hasComponent
          ontoksd:C18_ModelRealWorldProblemsUsingFormalLanguageConcepts ,
          ontoksd:C17_ApplyOperationsOnFormalLanguages ,
          ontoksd:C19_ApplyHomomorphismsInFormalLanguages ,
          ontoksd:C04_DefineRegularExpressionsForFiniteAutomata ,
          ontoksd:C13_Prime_InterpretAndApplyAlgebraicNotationForStringsAndLanguages ,
          ontoksd:C05_Prime_WriteMathematicallyRigorousAnswers .

}