PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C07 a ontoksd:Competence ;
      rdfs:label "Develop problem-solving solutions using Turing Machines"@en ;
      dcterms:identifier "C07"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with designing, constructing, and validating complete problem-solving solutions using Turing Machines as formal computational models, based on structured requirements and justified modeling decisions."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C07_TuringMachines_Creating ,
                                ontoksd:KS_C07_RequirementsEngineering_Applying ,
                                ontoksd:KS_C07_AnalyticalThinking_Applying ;
      ontoksd:hasDisposition ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:inventive ,
                             ontoksd:creative .

  ontoksd:KS_C07_TuringMachines_Creating a ontoksd:KnowledgeSkill ;
      rdfs:label "C07 KS Pair — Turing Machines × Creating"@en ;
      dcterms:identifier "C07-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with creating executable Turing Machine models that solve well-defined computational problems by defining states, alphabets, transition functions, and halting conditions in accordance with formal specifications."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AL_Models_8 ;
      ontoksd:hasBloomCognitiveLevel bloom:Creating ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:design ,
                                             bloom:construct ,
                                             bloom:develop ,
                                             bloom:validate .

  ontoksd:KS_C07_RequirementsEngineering_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C07 KS Pair — Requirements Engineering × Applying"@en ;
      dcterms:identifier "C07-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying requirements-engineering knowledge to interpret, organize, and specify problem requirements as precise machine-level specifications that guide Turing Machine construction."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Requirements_3 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SE_Requirements_3 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:interpret ,
                                             bloom:organize ,
                                             bloom:specify .

  ontoksd:KS_C07_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C07 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C07-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying analytical and critical thinking to decompose the problem, identify relevant constraints and variables, and justify modeling decisions throughout solution development and validation."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:decompose ,
                                             bloom:identify ,
                                             bloom:justify .

  cs2023k:Knowledge_AL_Models_8
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_SE_Requirements_3
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
