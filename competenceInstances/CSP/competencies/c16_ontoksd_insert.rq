PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C16 a ontoksd:Competence ;
      rdfs:label "Interpret Turing Machine Concepts to Analyze Computational System Capabilities"@en ;
      dcterms:identifier "C16"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with interpreting Turing Machine concepts as a conceptual reference model for analyzing the capabilities and inherent limitations of computational systems, especially in relation to computability boundaries, semi-decidability, and the limits of automated program analysis."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C16_TuringMachines_Understanding ,
                                ontoksd:KS_C16_Computability_Understanding ,
                                ontoksd:KS_C16_AnalyticalThinking_Applying ;
      ontoksd:hasDisposition ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:creative .

  ontoksd:KS_C16_TuringMachines_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C16 KS Pair — Turing Machines × Understanding"@en ;
      dcterms:identifier "C16-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding Turing Machines as a conceptual and universal reference model for computation, in order to explain, relate, and interpret their role in analyzing computational system capabilities."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AL_Models_8 ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:explain ,
                                             bloom:relate ,
                                             bloom:interpret .

  ontoksd:KS_C16_Computability_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C16 KS Pair — Computability × Understanding"@en ;
      dcterms:identifier "C16-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding computability at a conceptual level in order to classify and distinguish decidable, semi-decidable, and undecidable problems when reasoning about computational system capabilities."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C16_ComputabilityTheory ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasBloomLevelJustificationVerb bloom:classify ,
                                             bloom:distinguish ,
                                             bloom:explain .

  ontoksd:KS_C16_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C16 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C16-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying analytical and critical thinking to analyze implications, structure explanations, and justify conclusions about the capabilities and limitations of computational systems using Turing Machine concepts as a theoretical reference."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:analyze ,
                                             bloom:structure ,
                                             bloom:justify .

  ontoksd:Knowledge_C16_ComputabilityTheory a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Computability Theory"@en ;
      skos:prefLabel "Computability Theory"@en ;
      skos:definition "Computing-specific knowledge concerning decidability, semi-decidability, undecidability, and the conceptual limits of what can be computed or automated in general-purpose computational systems."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C16 because the specialized conceptual role of computability theory is explicitly required in the competency and is treated as supporting knowledge distinct from the more specific Halting Problem focus of C15."@en ;
      dcterms:identifier "C16-K-ComputabilityTheory"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_AL_Models_8
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
