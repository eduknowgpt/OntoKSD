PREFIX ontoksd:      <http://purl.org/ontoksd#>
PREFIX rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:         <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:          <http://www.w3.org/2002/07/owl#>
PREFIX xsd:          <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:         <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:      <http://purl.org/dc/terms/>
PREFIX bloom:        <http://purl.org/edu/bloom#>
PREFIX cs2023:       <http://purl.org/cs2023#>
PREFIX cs2023k:      <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found:  <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C02 a ontoksd:Competence ;
      rdfs:label "Justify the use of Deterministic Finite Automata (DFAs)"@en ;
      dcterms:identifier "C02"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with justifying the use of Deterministic Finite Automata (DFAs) as appropriate formal models for solving well-defined computational problems, based on elicited problem requirements, representational clarity, and implementation constraints."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C02_DFA_Understanding ,
                                ontoksd:KS_C02_AnalyticalThinking_Applying ,
                                ontoksd:KS_C02_RequirementsElicitation_Applying ;
      ontoksd:hasDisposition ontoksd:investigative ,
                             ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive .

  ontoksd:KS_C02_DFA_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C02 KS Pair — Deterministic Finite Automata × Understanding"@en ;
      dcterms:identifier "C02-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing covering conceptual understanding of Deterministic Finite Automata (DFAs), including the identification of their structural and behavioral properties and the recognition of problem situations in which a deterministic automaton provides an appropriate formal model."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AL_Models_7 ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_7 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:identify ,
                                             bloom:explain ,
                                             bloom:recognize .

  ontoksd:KS_C02_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C02 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C02-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing covering the application of analytical and critical thinking to evaluate problem constraints, analyze how those constraints support the adoption of a deterministic solution, and justify the selection of a DFA on logical and computational grounds."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:analyze ,
                                             bloom:evaluate ,
                                             bloom:justify .

  ontoksd:KS_C02_RequirementsElicitation_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C02 KS Pair — Requirements Elicitation × Applying"@en ;
      dcterms:identifier "C02-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing covering the application of requirements elicitation to identify, interpret, and organize problem requirements relevant to automaton selection, thereby supporting the justification for adopting a Deterministic Finite Automaton (DFA)."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Requirements_3 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SE_Requirements_3 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:identify ,
                                             bloom:interpret ,
                                             bloom:organize .

  cs2023k:Knowledge_AL_Models_7
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_SE_Requirements_3
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}