PREFIX ontoksd:      <http://purl.org/ontoksd#>
PREFIX rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:         <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:          <http://www.w3.org/2002/07/owl#>
PREFIX xsd:          <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:         <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:      <http://purl.org/dc/terms/>
PREFIX bloom:        <http://purl.org/edu/bloom#>
PREFIX cs2023:       <http://purl.org/cs2023#>
PREFIX cs2023k:      <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found:  <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C10 a ontoksd:Competence ;
      rdfs:label "Test Turing Machines Using Simulators"@en ;
      dcterms:identifier "C10"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with testing, validating, and refining Turing Machine models through formal simulation tools in order to verify correctness, completeness, halting behavior, and conformity with formal problem requirements."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C10_TuringMachines_Applying ,
                                ontoksd:KS_C10_FormalSimulationToolUse_Applying ,
                                ontoksd:KS_C10_ProblemSolvingAndTroubleshooting_Applying ;
      ontoksd:hasDisposition ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:creative .

  ontoksd:KS_C10_TuringMachines_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C10 KS Pair — Turing Machines × Applying"@en ;
      dcterms:identifier "C10-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying Turing Machine knowledge to simulate, evaluate, and verify machine execution, including the analysis of transitions, tape behavior, outputs, and halting conditions under representative inputs."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AL_Models_8 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:simulate ,
                                             bloom:evaluate ,
                                             bloom:verify .

  ontoksd:KS_C10_FormalSimulationToolUse_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C10 KS Pair — Formal Simulation Tool Use × Applying"@en ;
      dcterms:identifier "C10-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying simulator-based tool use to execute Turing Machine models, inspect observed behavior, interpret discrepancies between expected and actual outcomes, and support iterative refinement through formal validation."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Validation_7_d ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SE_Validation_7_d ;
      ontoksd:hasBloomLevelJustificationVerb bloom:test ,
                                             bloom:interpret ,
                                             bloom:validate ,
                                             bloom:refine .

  ontoksd:KS_C10_ProblemSolvingAndTroubleshooting_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C10 KS Pair — Problem Solving and Troubleshooting × Applying"@en ;
      dcterms:identifier "C10-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying troubleshooting-oriented reasoning to diagnose modeling errors, debug transition logic, and iteratively refine Turing Machine configurations based on simulation results."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:ProblemSolvingAndTroubleshooting ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:ProblemSolvingAndTroubleshooting ;
      ontoksd:hasBloomLevelJustificationVerb bloom:diagnose ,
                                             bloom:debug ,
                                             bloom:refine .

  cs2023k:Knowledge_AL_Models_8
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_SE_Validation_7_d
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}