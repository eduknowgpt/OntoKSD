PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C03 a ontoksd:Competence;
      rdfs:label "Test automata using simulators"@en ;
      dcterms:identifier "C03"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with systematically testing, analyzing, and refining finite automata by means of simulator-based execution, observation of behavior, diagnosis of discrepancies, and iterative correction until the model satisfies formal specifications."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C03_FiniteStateMachines_Applying ,
                                ontoksd:KS_C03_TestTooling_Applying ,
                                ontoksd:KS_C03_ProblemSolvingAndTroubleshooting_Applying ;
      ontoksd:hasDisposition ontoksd:investigative ,
                             ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:creative .

  ontoksd:KS_C03_FiniteStateMachines_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C03 KS Pair — Finite State Machines × Applying"@en ;
      dcterms:identifier "C03-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying finite-state-machine knowledge in simulator-based testing to execute runs, inspect state transitions, and validate acceptance behavior against formal expectations."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SF_Foundations_5 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SF_Foundations_5 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:simulate ,
                                             bloom:execute ,
                                             bloom:validate .

  ontoksd:KS_C03_TestTooling_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C03 KS Pair — Test Tooling × Applying"@en ;
      dcterms:identifier "C03-KS2"^^xsd:string ;
      rdfs:comment "This KS pair reuses the BoKCS2023 knowledge 'Test tooling, including code coverage, static analysis, and fuzzing' in place of the broader label 'Modeling and Simulation'. The adjustment reflects the final lifecycle of C03 more precisely: the competence is centered on using simulator-based tools to run tests, inspect observed behavior, interpret discrepancies, and support iterative refinement of finite automata, rather than on generic modeling or simulation as an abstract topic."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Validation_7_d ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SE_Validation_7_d ;
      ontoksd:hasBloomLevelJustificationVerb bloom:test ,
                                             bloom:interpret ,
                                             bloom:refine .

  ontoksd:KS_C03_ProblemSolvingAndTroubleshooting_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C03 KS Pair — Problem Solving and Troubleshooting × Applying"@en ;
      dcterms:identifier "C03-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying troubleshooting-oriented reasoning to diagnose modeling errors, implement corrections, and improve automata behavior through iterative testing cycles."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:ProblemSolvingAndTroubleshooting ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:ProblemSolvingAndTroubleshooting ;
      ontoksd:hasBloomLevelJustificationVerb bloom:diagnose ,
                                             bloom:correct ,
                                             bloom:refine .

  cs2023k:Knowledge_SF_Foundations_5
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_SE_Validation_7_d
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
