PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://example.org/bloom#>

####  Define Regular Expressions for Finite Automata

############# INSERÇÃO CONDICIONAL DOS PARES KNOWLEDGESKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:Finite_state_machines ontoksd:understandingSkill)
    (cs2013:Regular_expressions ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }

  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }

  BIND(IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks)
}

;

############# INSERÇÃO DA COMPETÊNCIA EdukNow_C04 ################

INSERT {
  ontoksd:competence_EdukNow_C04 a ontoksd:Competence ;
    dcterms:title "Define Regular Expressions for Finite Automata"@en ;
    dcterms:description "This competency focuses on the ability to relate regular expressions to finite automata, both theoretically and in practice."@en ;
    dcterms:source "EdukNow Competence Project"@en ;
    skos:notation "EdukNow Competence - C04"@en ;
    ontoksd:hasCompetenceElement ontoksd:Investigative ,
                                 ontoksd:Collaborative ,
                                 ontoksd:Responsible ,
                                 ontoksd:Proactive ,
                                 ontoksd:Creative ;
    ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .

  VALUES (?k ?s) {
    (cs2013:Finite_state_machines ontoksd:understandingSkill)
    (cs2013:Regular_expressions ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill)
  }
}

;

############# INSERÇÃO DOS VERBOS COMO ANOTAÇÃO (leve) ################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Finite_state_machines ontoksd:understandingSkill bloom:Interpret)
    (cs2013:Finite_state_machines ontoksd:understandingSkill bloom:Relate)
    (cs2013:Finite_state_machines ontoksd:understandingSkill bloom:Represent)

    (cs2013:Regular_expressions ontoksd:applyingSkill bloom:Decompose)
    (cs2013:Regular_expressions ontoksd:applyingSkill bloom:Translate)
    (cs2013:Regular_expressions ontoksd:applyingSkill bloom:Construct)

    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:Analyze)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:Test)
    (cc2020fpk:AnalyticalThinking ontoksd:applyingSkill bloom:Refine)
  }

  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
