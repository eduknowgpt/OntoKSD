PREFIX ontoksd:      <http://purl.org/ontoksd#>
PREFIX rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:         <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:          <http://www.w3.org/2002/07/owl#>
PREFIX xsd:          <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:         <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:      <http://purl.org/dc/terms/>
PREFIX bloom:        <http://purl.org/edu/bloom#>
PREFIX cs2023:       <http://purl.org/cs2023#>
PREFIX cs2023k:      <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found:  <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C07_01 a ontoksd:Competence ;
      rdfs:label "Develop Integrated Multi-Agent Solutions Using Turing Machines"@en ;
      dcterms:identifier "C07.01"^^xsd:string ;
      rdfs:comment "Specialized competence concerned with designing, integrating, coordinating, and validating multi-agent computational solutions using Turing Machines as a unified formal modeling framework. It specializes C07 by introducing system-level integration, coordination constraints, and analysis of global consistency and emergent behavior."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:isSpecializationOf ontoksd:C07_DevelopProblemSolvingSolutionsUsingTuringMachines ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C07_01_TuringMachines_Creating ,
                                ontoksd:KS_C07_01_SystemIntegrationCoordination_Analyzing ,
                                ontoksd:KS_C07_01_RequirementsEngineering_Applying ,
                                ontoksd:KS_C07_01_AnalyticalThinking_Analyzing ;
      ontoksd:hasDisposition ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:inventive ,
                             ontoksd:creative .

  ontoksd:KS_C07_01_TuringMachines_Creating a ontoksd:KnowledgeSkill ;
      rdfs:label "C07.01 KS Pair — Turing Machines × Creating"@en ;
      dcterms:identifier "C07.01-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with creating integrated computational solutions by designing, constructing, integrating, and coordinating multiple Turing Machine models whose combined behavior yields a coherent system-level solution."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AL_Models_8 ;
      ontoksd:hasBloomCognitiveLevel bloom:Creating ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:design ,
                                             bloom:integrate ,
                                             bloom:construct ,
                                             bloom:coordinate .

  ontoksd:KS_C07_01_SystemIntegrationCoordination_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C07.01 KS Pair — System Integration and Coordination Concepts × Analyzing"@en ;
      dcterms:identifier "C07.01-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with analyzing interacting subsystems, coordination dependencies, shared-memory versus distributed-memory implications, synchronization needs, signaling logic, and possible consistency issues arising from integrated multi-agent solutions."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:SystemIntegrationAndCoordinationConcepts ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AI_Introduction_4_b ,
                                              cs2023:Topic_AR_Heterogeneity_2_a ,
                                              cs2023:Topic_AR_Performance_Energy_4_c ;
      ontoksd:hasBloomLevelJustificationVerb bloom:decompose ,
                                             bloom:examine ,
                                             bloom:evaluate ,
                                             bloom:synchronize .

  ontoksd:KS_C07_01_RequirementsEngineering_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C07.01 KS Pair — Requirements Engineering × Applying"@en ;
      dcterms:identifier "C07.01-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying system-level requirements engineering to elicit, formalize, align, and constrain global requirements, inter-agent dependencies, and coordination rules that guide the integrated Turing Machine solution."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Requirements_3 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SE_Requirements_3 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:elicit ,
                                             bloom:formalize ,
                                             bloom:align ,
                                             bloom:constrain .

  ontoksd:KS_C07_01_AnalyticalThinking_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C07.01 KS Pair — Analytical and Critical Thinking × Analyzing"@en ;
      dcterms:identifier "C07.01-KS4"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with reasoning about emergent behavior, justifying architectural choices, and evaluating the adequacy, coherence, robustness, and global correctness of the integrated multi-agent solution."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:reason ,
                                             bloom:justify ,
                                             bloom:validate ,
                                             bloom:evaluate .

  cs2023k:Knowledge_AL_Models_8
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_SE_Requirements_3
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  ontoksd:SystemIntegrationAndCoordinationConcepts a ontoksd:Knowledge ;
      rdfs:label "System Integration and Coordination Concepts"@en ;
      rdfs:comment "Knowledge concerning coordination mechanisms, interaction dependencies, signaling logic, synchronization conditions, and shared versus distributed memory considerations in integrated multi-agent computational systems."@en ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AI_Introduction_4_b ,
                                              cs2023:Topic_AR_Heterogeneity_2_a ,
                                              cs2023:Topic_AR_Performance_Energy_4_c .

}