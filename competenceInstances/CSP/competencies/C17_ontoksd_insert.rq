PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C17 a ontoksd:Competence ;
      rdfs:label "Apply operations on formal languages"@en ;
      dcterms:identifier "C17"^^xsd:string ;
      rdfs:comment "Core atomic competence concerned with the conceptual and algebraic application of formal operations on languages defined over explicit alphabets. It includes not only carrying out operations such as concatenation, union, intersection, difference, complement, Kleene closure, and reversal, but also analyzing the structural consequences of these operations on the resulting language. Demonstration of the competence requires formally justified conclusions about properties such as class membership, finiteness or infiniteness, and closure behavior, using precise definitions, minimal examples, counterexamples, and known theoretical properties. The competence explicitly excludes the construction, simulation, or implementation of automata or algorithms, remaining restricted to conceptual and algebraic reasoning."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C17_LanguageTheory_Understanding ,
                                ontoksd:KS_C17_OperationsOnFormalLanguages_Applying ,
                                ontoksd:KS_C17_RegularExpressions_Applying ,
                                ontoksd:KS_C17_AnalyticalThinking_Analyzing ;
      ontoksd:hasDisposition ontoksd:Persistence .

  ontoksd:KS_C17_LanguageTheory_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C17 KS Pair — Language Theory × Understanding"@en ;
      dcterms:identifier "C17-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding the foundational concepts of language theory needed to interpret and explain formal operations on languages. This includes alphabets, strings, languages, and the conceptual distinction between finite and infinite languages. The role of this KS pair is to provide the semantic basis required before formal operations can be applied or their consequences justified."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C17_LanguageTheory ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_2 ,
                                              cs2023:Topic_AL_Models_4 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:interpret ,
                                             bloom:explain .

  ontoksd:KS_C17_OperationsOnFormalLanguages_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C17 KS Pair — Operations on Formal Languages × Applying"@en ;
      dcterms:identifier "C17-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying and analytically examining formal operations on languages, including concatenation, union, intersection, difference, complement, Kleene closure, and reversal. The emphasis is not merely on performing symbolic manipulations, but on analyzing the structural effects of each operation and justifying conclusions about resulting properties such as closure, expressiveness, and class preservation."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C17_OperationsOnFormalLanguages ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_2 ,
                                              cs2023:Topic_AL_Models_4 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:apply ,
                                             bloom:justify .

  ontoksd:KS_C17_RegularExpressions_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C17 KS Pair — Regular Expressions × Applying"@en ;
      dcterms:identifier "C17-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying regular expressions as algebraic notation to specify, relate, and reason about formal languages. In this competence, regular expressions are not treated as implementation artifacts, but as compact symbolic descriptions that support conceptual comparison, relational description, and justification of language operations."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AL_Models_2_a_i ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_2_a_i ;
      ontoksd:hasBloomLevelJustificationVerb bloom:specify ,
                                             bloom:relate .

  ontoksd:KS_C17_AnalyticalThinking_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C17 KS Pair — Analytical and Critical Thinking × Analyzing"@en ;
      dcterms:identifier "C17-KS4"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with analyzing formal arguments about languages and their operations. It supports the identification of inconsistencies, the evaluation of whether a conclusion follows from definitions and closure properties, and the justification of claims through precise reasoning rather than informal intuition."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:analyze ,
                                             bloom:evaluate ,
                                             bloom:justify .

  ontoksd:Knowledge_C17_LanguageTheory a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Language Theory"@en ;
      skos:prefLabel "Language Theory"@en ;
      skos:definition "Computing-specific knowledge concerning alphabets, strings, languages, and the conceptual distinction between finite and infinite languages, used as the basis for reasoning about formal language operations."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C17 because the competence explicitly requires a compact but foundational knowledge unit covering core language-theoretic notions that support the later application and analysis of operations on languages."@en ;
      dcterms:identifier "C17-K-LanguageTheory"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  ontoksd:Knowledge_C17_OperationsOnFormalLanguages a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Operations on Formal Languages"@en ;
      skos:prefLabel "Operations on Formal Languages"@en ;
      skos:definition "Computing-specific knowledge concerning formal operations on languages, including concatenation, union, intersection, difference, complement, Kleene closure, and reversal, together with their conceptual closure properties and structural consequences."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C17 because the competence centers on a coherent family of algebraic operations and their theoretical effects, which is more precise here than reuse of a single generic curricular topic alone."@en ;
      dcterms:identifier "C17-K-OperationsOnFormalLanguages"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
