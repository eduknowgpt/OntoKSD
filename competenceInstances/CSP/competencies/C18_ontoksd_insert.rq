PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C18 a ontoksd:Competence ;
      rdfs:label "Model real-world problems using formal language concepts"@en ;
      dcterms:identifier "C18"^^xsd:string ;
      rdfs:comment "Core atomic competence concerned with abstracting relevant elements of a real-world domain and modeling them as formal language-based representations through the explicit definition of alphabets, strings, and languages. Demonstration of this competence requires establishing justified mappings between domain entities and formal symbols, making explicit modeling choices and exclusions, evaluating the structural adequacy of the resulting representation, and recognizing its formal limitations. The competence is restricted to the abstraction and modeling phase: it does not yet include the application of formal operations on languages or transformations between representations through homomorphisms as independent tasks, although it may conceptually anticipate such later developments."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C18_LanguageTheory_Understanding ,
                                ontoksd:KS_C18_FormalLanguages_Applying ,
                                ontoksd:KS_C18_HomomorphismsAndCodifications_Applying ,
                                ontoksd:KS_C18_AnalyticalThinking_Analyzing ;
      ontoksd:hasDisposition ontoksd:Reflectiveness .

  ontoksd:KS_C18_LanguageTheory_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C18 KS Pair — Language Theory × Understanding"@en ;
      dcterms:identifier "C18-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding the relation between real-world domains and formal symbolic representations. It provides the conceptual basis for interpreting how alphabets, strings, and languages can be used to represent relevant aspects of a domain while abstracting away from irrelevant detail."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C18_LanguageTheory ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_2 ,
                                              cs2023:Topic_AL_Models_4 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:interpret ,
                                             bloom:explain .

  ontoksd:KS_C18_FormalLanguages_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C18 KS Pair — Formal Languages × Applying"@en ;
      dcterms:identifier "C18-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying formal language concepts to model a domain by constructing explicit alphabets, strings, and language sets that capture structurally relevant aspects of the original problem. The emphasis is on representational adequacy and formal coherence, not on later algebraic manipulation or recognizer construction."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C18_FormalLanguages ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_2 ,
                                              cs2023:Topic_AL_Models_4 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:model ,
                                             bloom:represent ,
                                             bloom:construct .

  ontoksd:KS_C18_HomomorphismsAndCodifications_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C18 KS Pair — Homomorphisms and Codifications × Applying"@en ;
      dcterms:identifier "C18-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying, at a conceptual level, the idea of formal mappings between domain entities and symbolic representations. In this competence, homomorphisms and codifications are used to support the explicit encoding of domain elements into symbols and to reason about preservation or loss of information as a boundary of the chosen model."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C18_HomomorphismsAndCodifications ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_2 ,
                                              cs2023:Topic_AL_Models_4 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:map ,
                                             bloom:encode .

  ontoksd:KS_C18_AnalyticalThinking_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C18 KS Pair — Analytical and Critical Thinking × Analyzing"@en ;
      dcterms:identifier "C18-KS4"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with analyzing the adequacy of a proposed formal model, justifying abstraction choices and exclusions, and identifying structural limitations of the representation. It supports disciplined reflection on whether the model captures the intended formal properties without conflating structural correctness with semantic completeness."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:evaluate ,
                                             bloom:justify .

  ontoksd:Knowledge_C18_LanguageTheory a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Language Theory"@en ;
      skos:prefLabel "Language Theory"@en ;
      skos:definition "Computing-specific knowledge concerning alphabets, strings, and languages as foundational constructs for formally representing structured aspects of real-world domains."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C18 because the competence requires a compact foundational unit that links core language-theoretic notions to real-world abstraction and formal representation."@en ;
      dcterms:identifier "C18-K-LanguageTheory"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  ontoksd:Knowledge_C18_FormalLanguages a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Formal Languages"@en ;
      skos:prefLabel "Formal Languages"@en ;
      skos:definition "Computing-specific knowledge concerning the modeling of collections as sets of strings and the treatment of their structural properties independently of domain semantics."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C18 because the competence centers on using formal languages as representational artifacts for domain modeling, not merely on isolated theoretical facts about languages."@en ;
      dcterms:identifier "C18-K-FormalLanguages"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  ontoksd:Knowledge_C18_HomomorphismsAndCodifications a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Homomorphisms and Codifications"@en ;
      skos:prefLabel "Homomorphisms and Codifications"@en ;
      skos:definition "Computing-specific knowledge concerning conceptual mappings between domain entities and symbolic representations, including the role of encoding choices in preserving or losing structural information."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C18 because the competence uses homomorphism and codification only at a conceptual modeling level, as support for explicit mapping decisions and for reflection on representational limits."@en ;
      dcterms:identifier "C18-K-HomomorphismsAndCodifications"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
