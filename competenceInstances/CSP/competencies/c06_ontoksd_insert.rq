PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C06 a ontoksd:Competence ;
      rdfs:label "Develop Problem-Solving Solutions Using Finite State Machines"@en ;
      dcterms:identifier "C06"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with designing and implementing computational solutions using finite state machines as formal models grounded in system requirements, correctness constraints, and structured problem-solving reasoning."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C06_FiniteStateMachines_Applying ,
                                ontoksd:KS_C06_RequirementsEngineering_Applying ,
                                ontoksd:KS_C06_AnalyticalThinking_Applying ;
      ontoksd:hasDisposition ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive .

  ontoksd:KS_C06_FiniteStateMachines_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C06 KS Pair — Finite State Machines × Applying"@en ;
      dcterms:identifier "C06-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying finite-state-machine knowledge to design, construct, model, and validate formal state-transition representations that solve structured problems."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SF_Foundations_5 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SF_Foundations_5 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:design ,
                                             bloom:construct ,
                                             bloom:model ,
                                             bloom:validate .

  ontoksd:KS_C06_RequirementsEngineering_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C06 KS Pair — Requirements Engineering × Applying"@en ;
      dcterms:identifier "C06-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying requirements-engineering knowledge to interpret, specify, and translate system requirements into formal specifications that guide finite-state-machine construction."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SE_Requirements_3 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SE_Requirements_3 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:interpret ,
                                             bloom:specify ,
                                             bloom:translate .

  ontoksd:KS_C06_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C06 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C06-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying analytical and critical thinking to analyze constraints, evaluate alternatives, and justify modeling decisions based on correctness, feasibility, and logical consistency."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:analyze ,
                                             bloom:evaluate ,
                                             bloom:justify .

  cs2023k:Knowledge_SF_Foundations_5
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_SE_Requirements_3
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
