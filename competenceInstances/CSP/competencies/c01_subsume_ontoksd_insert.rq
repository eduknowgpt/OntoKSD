PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013: <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom: <http://purl.org/edu/bloom#>


#####"Develop problem solutions using Automata"




############# INSERÇÃO DA COMPETÊNCIA PROJECT_C01 ################

INSERT DATA {
  ontoksd:competence_PROJECT_C01_ABS a ontoksd:Competence ;
   	ontoksd:hasStructureType	ontoksd:Atomic ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain ;
    dcterms:title "Develop problem solutions using Automata (Abstract)"@en ;
    dcterms:description "Abstract (non-aggregating) competence used as a conceptual umbrella for automata-based problem solving. It generalizes the family of competences specialized to finite automata (FA), pushdown automata (PDA), and Turing machines (TM). This node supports taxonomy, curriculum mapping, and navigation; it does not by itself entail mastery of any particular automaton class."@en ;
    dcterms:source "PROJECT Competence Project"@en ;
    skos:notation "PROJECT Abstract Competence - C01"@en ;
    ontoksd:hasCompetenceElement ontoksd:collaborative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive ,
                                 ontoksd:creative ;

	ontoksd:hasSpecialization 	ontoksd:competence_PROJECT_C06,
								ontoksd:competence_PROJECT_C07,
								ontoksd:competence_PROJECT_C12 ;
								
	ontoksd:hasStructureType	ontoksd:Abstract ;
	ontoksd:hasCompetenceType	ontoksd:ComputingDomain .

}


