PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C09_01 a ontoksd:Competence ;
      rdfs:label "Apply and Coordinate Turing Machine Variants in Integrated Architectures"@en ;
      dcterms:identifier "C09.01"^^xsd:string ;
      rdfs:comment "Atomic specialized competence concerned with selecting, adapting, and coordinating Turing Machine variants within integrated and multi-agent computational architectures, based on system-level requirements and justified architectural reasoning."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:isSpecializationOf ontoksd:C09_ApplyTuringMachineVariants ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C09_01_TuringMachineVariants_Applying ,
                                ontoksd:KS_C09_01_RequirementsEngineering_Applying ,
                                ontoksd:KS_C09_01_AnalyticalThinking_Analyzing ;
      ontoksd:hasDisposition ontoksd:inventive ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:collaborative ,
                             ontoksd:creative .

  ontoksd:KS_C09_01_TuringMachineVariants_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C09.01 KS Pair — Turing Machine Variants × Applying"@en ;
      dcterms:identifier "C09.01-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying Turing Machine variants by selecting, assigning, adapting, and coordinating appropriate models across subsystems within an integrated architecture."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C08_TuringMachineVariants ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:select ,
                                             bloom:adapt ,
                                             bloom:coordinate .

  ontoksd:KS_C09_01_RequirementsEngineering_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C09.01 KS Pair — Requirements Engineering × Applying"@en ;
      dcterms:identifier "C09.01-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying system-level requirements engineering to interpret, align, and constrain global requirements that guide variant selection and coordination decisions in an integrated system."@en ;
      ontoksd:hasKnowledgeComponent cs2023:Knowledge_SE_Requirements_3 ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SE_Requirements_3 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:interpret ,
                                             bloom:align ,
                                             bloom:constrain .

  ontoksd:KS_C09_01_AnalyticalThinking_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C09.01 KS Pair — Analytical and Critical Thinking × Analyzing"@en ;
      dcterms:identifier "C09.01-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with analyzing subsystem interactions, coordination consequences, and architectural trade-offs in order to justify and assess the adequacy of coordinated Turing Machine variant use."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:examine ,
                                             bloom:evaluate ,
                                             bloom:justify .

}
