PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C21 a ontoksd:Competence ;
      rdfs:label "Analyze Computational Complexity and the Implications of NP-Hardness"@en ;
      dcterms:identifier "C21"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with analyzing computational complexity and interpreting the implications of NP-hardness for the performance, scalability, and practical viability of algorithmic solutions. Demonstration of this competence requires relating input size, algorithmic strategy, and problem class to computational cost under time and resource constraints; distinguishing limitations caused by inefficient algorithms from those caused by inherent computational difficulty; and justifying conclusions about feasibility by articulating theoretical complexity results with practical execution constraints. The competence is primarily analytical and justificatory: it does not require implementing algorithms, proving hardness results formally, or constructing reductions as independent performance artifacts."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C21_ComputationalComplexity_Analyzing ,
                                ontoksd:KS_C21_ComplexityClassesAndIntractability_Understanding ,
                                ontoksd:KS_C21_AlgorithmicScalability_Understanding ,
                                ontoksd:KS_C21_AnalyticalThinking_Analyzing ;
      ontoksd:hasDisposition ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:creative .

  ontoksd:KS_C21_ComputationalComplexity_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C21 KS Pair — Computational Complexity × Analyzing"@en ;
      dcterms:identifier "C21-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with analyzing computational complexity in order to decompose and relate the effects of input size, algorithmic strategy, and complexity growth on execution cost and feasibility. In this competence, complexity analysis supports reasoned judgments about performance limits rather than low-level implementation concerns."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C21_ComputationalComplexity ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasBloomLevelJustificationVerb bloom:decompose ,
                                             bloom:relate ,
                                             bloom:interpret .

  ontoksd:KS_C21_ComplexityClassesAndIntractability_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C21 KS Pair — Complexity Classes and Intractability × Understanding"@en ;
      dcterms:identifier "C21-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding complexity classes and intractability notions, including P, NP, NP-hard, and NP-complete, in order to explain inherent computational difficulty and justify why some problems are unlikely to admit efficient general solutions."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C21_ComplexityClassesAndIntractability ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasBloomLevelJustificationVerb bloom:explain ,
                                             bloom:justify ,
                                             bloom:distinguish .

  ontoksd:KS_C21_AlgorithmicScalability_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C21 KS Pair — Algorithmic Scalability × Understanding"@en ;
      dcterms:identifier "C21-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding algorithmic scalability at a conceptual level in order to relate growth in input size to changes in running time and practical executability. Its role in this competence is to connect abstract complexity behavior with observable constraints of time and computational resources."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C21_AlgorithmicScalability ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasBloomLevelJustificationVerb bloom:relate ,
                                             bloom:interpret ,
                                             bloom:explain .

  ontoksd:KS_C21_AnalyticalThinking_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C21 KS Pair — Analytical and Critical Thinking × Analyzing"@en ;
      dcterms:identifier "C21-KS4"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with analyzing performance claims, structuring coherent justifications, and arguing for conclusions that connect theoretical complexity results with empirical or practical execution constraints."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:evaluate ,
                                             bloom:structure ,
                                             bloom:argue .

  ontoksd:Knowledge_C21_ComputationalComplexity a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Computational Complexity"@en ;
      skos:prefLabel "Computational Complexity"@en ;
      skos:definition "Computing-specific knowledge concerning the analysis of algorithmic cost in terms of growth of time or resources as input size increases, including its implications for performance and feasibility."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C21 because the competence centers explicitly on complexity as an analytical object rather than only on a broader curricular area."@en ;
      dcterms:identifier "C21-K-ComputationalComplexity"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  ontoksd:Knowledge_C21_ComplexityClassesAndIntractability a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Complexity Classes and Intractability (P, NP, NP-hard, NP-complete)"@en ;
      skos:prefLabel "Complexity Classes and Intractability (P, NP, NP-hard, NP-complete)"@en ;
      skos:definition "Computing-specific knowledge concerning major complexity classes and intractability notions used to characterize inherent computational difficulty and to reason about the practical infeasibility of efficient general solutions."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C21 because the competence requires an explicit conceptual unit relating class-based reasoning about tractability and intractability to the interpretation of practical feasibility."@en ;
      dcterms:identifier "C21-K-ComplexityClassesAndIntractability"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  ontoksd:Knowledge_C21_AlgorithmicScalability a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Algorithmic Scalability"@en ;
      skos:prefLabel "Algorithmic Scalability"@en ;
      skos:definition "Computing-specific knowledge concerning the conceptual relation between input growth and changes in algorithmic running time, resource consumption, and practical execution limits."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C21 because scalability is treated here as an explicit interpretive bridge between theoretical complexity results and practical feasibility constraints."@en ;
      dcterms:identifier "C21-K-AlgorithmicScalability"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}