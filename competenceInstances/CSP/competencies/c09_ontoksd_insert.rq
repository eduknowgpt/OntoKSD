PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C09 a ontoksd:Competence ;
      rdfs:label "Apply Turing Machine Variants"@en ;
      dcterms:identifier "C09"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with selecting and applying appropriate variants of Turing Machines to represent and solve formal problems in ways that are tailored to explicit requirements, modeling convenience, and structural clarity, without requiring metatheoretical discussion."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C09_TuringMachineVariants_Applying ,
                                ontoksd:KS_C09_AnalyticalThinking_Applying ;
      ontoksd:hasDisposition ontoksd:investigative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:collaborative ,
                             ontoksd:creative .

  ontoksd:KS_C09_TuringMachineVariants_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C09 KS Pair — Turing Machine Variants × Applying"@en ;
      dcterms:identifier "C09-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying knowledge of Turing Machine variants to select, adapt, and use an appropriate formal model according to explicit problem requirements, organizational clarity, and adequacy of representation."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C08_TuringMachineVariants ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:select ,
                                             bloom:adapt ,
                                             bloom:use .

  ontoksd:KS_C09_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C09 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C09-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying analytical and critical thinking to analyze explicit requirements, evaluate alternative modeling strategies, and decide which Turing Machine model is more adequate for the given problem context."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:analyze ,
                                             bloom:evaluate ,
                                             bloom:decide .

}
