PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C15 a ontoksd:Competence ;
      rdfs:label "Understand the Halting Problem and its Implications"@en ;
      dcterms:identifier "C15"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with conceptually understanding and clearly explaining the Halting Problem and its implications for the limits of algorithmic analysis, including undecidability, computability distinctions, and the role of Turing Machines as a conceptual reference model."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C15_HaltingProblem_Understanding ,
                                ontoksd:KS_C15_Computability_Understanding ,
                                ontoksd:KS_C15_TuringMachines_Understanding ,
                                ontoksd:KS_C15_AnalyticalThinking_Applying ;
      ontoksd:hasDisposition ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive ,
                             ontoksd:creative .

  ontoksd:KS_C15_HaltingProblem_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C15 KS Pair — Halting Problem × Understanding"@en ;
      dcterms:identifier "C15-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding the Halting Problem in order to describe, explain, and justify why no general-purpose procedure can decide termination for all programs and inputs."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C15_HaltingProblem ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasBloomLevelJustificationVerb bloom:describe ,
                                             bloom:explain ,
                                             bloom:justify .

  ontoksd:KS_C15_Computability_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C15 KS Pair — Computability × Understanding"@en ;
      dcterms:identifier "C15-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding computability at a conceptual level in order to classify problems as decidable, semi-decidable, or undecidable and to recognize the boundaries of algorithmic solvability."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C15_Computability ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasBloomLevelJustificationVerb bloom:classify ,
                                             bloom:recognize ,
                                             bloom:explain .

  ontoksd:KS_C15_TuringMachines_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C15 KS Pair — Turing Machines × Understanding"@en ;
      dcterms:identifier "C15-KS3"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding the conceptual role of Turing Machines as a reference model for general computation and as a basis for explaining undecidability arguments."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_AL_Models_8 ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:explain ,
                                             bloom:relate .

  ontoksd:KS_C15_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C15 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C15-KS4"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying analytical and critical thinking to evaluate theoretical implications, structure coherent arguments, and justify conclusions connecting undecidability theory to observable computational behavior."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:evaluate ,
                                             bloom:structure ,
                                             bloom:argue .

  ontoksd:Knowledge_C15_HaltingProblem a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Halting Problem"@en ;
      skos:prefLabel "Halting Problem"@en ;
      skos:definition "Computing-specific knowledge concerning the undecidability of determining, in general, whether an arbitrary program halts on a given input, and the implications of this result for the limits of algorithmic analysis."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C15 because the competency centers on a specific conceptual result in Computation Theory rather than on a generic BoK topic alone."@en ;
      dcterms:identifier "C15-K-HaltingProblem"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  ontoksd:Knowledge_C15_Computability a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Computability"@en ;
      skos:prefLabel "Computability"@en ;
      skos:definition "Computing-specific knowledge concerning the conceptual distinction among decidable, semi-decidable, and undecidable problems, and the resulting limits of algorithmic solvability."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C15 to represent the conceptual computability framework explicitly required by the competency."@en ;
      dcterms:identifier "C15-K-Computability"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

  cs2023k:Knowledge_AL_Models_8
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
