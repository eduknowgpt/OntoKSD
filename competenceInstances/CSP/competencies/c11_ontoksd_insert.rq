PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C11 a ontoksd:Competence ;
      rdfs:label "Identify Patterns in Finite State Machines"@en ;
      dcterms:identifier "C11"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with analyzing the structure and behavior of Finite State Machines in order to identify recurring patterns, regularities, and redundancies that affect model complexity, efficiency, and expressiveness, and to support justified refinement or abstraction decisions."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C11_FiniteStateMachines_Analyzing ,
                                ontoksd:KS_C11_AnalyticalThinking_Applying ;
      ontoksd:hasDisposition ontoksd:meticulous ,
                             ontoksd:creative ,
                             ontoksd:inventive .

  ontoksd:KS_C11_FiniteStateMachines_Analyzing a ontoksd:KnowledgeSkill ;
      rdfs:label "C11 KS Pair — Finite State Machines × Analyzing"@en ;
      dcterms:identifier "C11-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with analyzing Finite State Machine structures to examine state architectures, compare transition patterns, and evaluate how input classifications and redundancies affect model structure, complexity, and opportunities for abstraction."@en ;
      ontoksd:hasKnowledgeComponent cs2023k:Knowledge_SF_Foundations_5 ;
      ontoksd:hasBloomCognitiveLevel bloom:Analyzing ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_SF_Foundations_5 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:examine ,
                                             bloom:evaluate ,
                                             bloom:compare .

  ontoksd:KS_C11_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C11 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C11-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying analytical and critical thinking to infer structural regularities, interpret behavioral implications, and justify refinement or simplification decisions grounded in formal reasoning about Finite State Machines."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:infer ,
                                             bloom:interpret ,
                                             bloom:justify .

  cs2023k:Knowledge_SF_Foundations_5
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType .

}
