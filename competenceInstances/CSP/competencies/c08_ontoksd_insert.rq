PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <http://purl.org/cs2023#>
PREFIX cs2023k:   <http://purl.org/cs2023/knowledge#>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  ontoksd:C08 a ontoksd:Competence ;
      rdfs:label "Identify  and Compare Turing Machine Variants"@en ;
      dcterms:identifier "C08"^^xsd:string ;
      rdfs:comment "Atomic competence concerned with conceptually identifying, differentiating, and comparing Turing Machine variants in relation to their structural characteristics, computational properties, and adequacy for given problem requirements, without requiring implementation or metatheoretical discussion."@en ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
      ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
      ontoksd:hasKnowledgeSkill ontoksd:KS_C08_TuringMachineVariants_Understanding ,
                                ontoksd:KS_C08_AnalyticalThinking_Applying ;
      ontoksd:hasDisposition ontoksd:investigative ,
                             ontoksd:collaborative ,
                             ontoksd:responsible ,
                             ontoksd:proactive .

  ontoksd:KS_C08_TuringMachineVariants_Understanding a ontoksd:KnowledgeSkill ;
      rdfs:label "C08 KS Pair — Turing Machine Variants × Understanding"@en ;
      dcterms:identifier "C08-KS1"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with understanding the defining characteristics of Turing Machine variants, including their structural differences, conceptual limitations, and comparative modeling implications relative to the standard model."@en ;
      ontoksd:hasKnowledgeComponent ontoksd:Knowledge_C08_TuringMachineVariants ;
      ontoksd:hasBloomCognitiveLevel bloom:Understanding ;
      ontoksd:hasCurricularKnowledgeReference cs2023:Topic_AL_Models_8 ;
      ontoksd:hasBloomLevelJustificationVerb bloom:recognize ,
                                             bloom:differentiate ,
                                             bloom:explain .

  ontoksd:KS_C08_AnalyticalThinking_Applying a ontoksd:KnowledgeSkill ;
      rdfs:label "C08 KS Pair — Analytical and Critical Thinking × Applying"@en ;
      dcterms:identifier "C08-KS2"^^xsd:string ;
      rdfs:comment "Knowledge-skill pairing concerned with applying analytical and critical thinking to analyze requirements, compare alternative Turing Machine models, and justify conceptual judgments about the adequacy of standard and variant models."@en ;
      ontoksd:hasKnowledgeComponent cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomCognitiveLevel bloom:Applying ;
      ontoksd:hasCurricularKnowledgeReference cc2020found:AnalyticalThinking ;
      ontoksd:hasBloomLevelJustificationVerb bloom:analyze ,
                                             bloom:evaluate ,
                                             bloom:justify .

  ontoksd:Knowledge_C08_TuringMachineVariants a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Turing Machine Variants"@en ;
      skos:prefLabel "Turing Machine Variants"@en ;
      skos:definition "Computing-specific knowledge concerned with the recognition and conceptual differentiation of main variants of the standard Turing Machine model, such as multi-tape and non-deterministic Turing Machines, with emphasis on their defining characteristics and modeling implications."@en ;
      skos:scopeNote "Local OntoKSD knowledge individual created for C08 because the final competency refers to a comparative family of Turing Machine variants rather than to a single standard Turing Machine topic. The competence remains curricularly anchored in the CS2023 area on Turing machines."@en ;
      dcterms:identifier "C08-K-TuringMachineVariants"^^xsd:string ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      ontoksd:isCurricularlyRepresentedBy cs2023:Topic_AL_Models_8 .

}
