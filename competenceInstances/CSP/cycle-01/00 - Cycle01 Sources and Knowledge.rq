ontoksd:Knowledge_CSP_ContextFreeGrammars a ontoksd:Knowledge ;
    rdfs:label "Context-Free Grammars"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Context-free production rules, nonterminal and terminal symbols, derivations, generated symbol sequences, and their relation to pushdown computation."@en ;
    skos:scopeNote "Locally curated semantic content from cycle-01 records. Curricular links, when present on a pairing, are alignment anchors and do not identify a broader curricular concept with this knowledge instance."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task04-TheReturnFarmingRobot/Task04-CSP-Adjustments.md> .

ontoksd:Knowledge_CSP_DeterministicFiniteAutomata a ontoksd:Knowledge ;
    rdfs:label "Deterministic Finite Automata"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Finite-state models with exactly one applicable transition for each state/input-symbol pair, including states, alphabets, transition functions, acceptance and deterministic behavior."@en ;
    skos:scopeNote "Locally curated semantic content from cycle-01 records. Curricular links, when present on a pairing, are alignment anchors and do not identify a broader curricular concept with this knowledge instance."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task01-TheVendingMachine/Review2/Task01-CSP-Report-v2.md> .

