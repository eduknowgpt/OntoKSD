ontoksd:CSPRecordedActionVerbType a bloom:ActionVerbType ;
    rdfs:label "CSP-recorded justification verb"@en ;
    skos:definition "An action verb recorded in a reviewed CSP knowledge-level assignment. Its documented use supports that contextual assignment and does not assert an official Bloom verb-list classification."@en .
