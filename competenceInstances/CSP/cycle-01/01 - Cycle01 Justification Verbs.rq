# Supplemental declarations for recorded CSP action verbs not populated in the external vocabulary.
# INSERT-only cycle-01 dataset; load as a coherent snapshot (see README.md).
PREFIX bloom: <http://purl.org/edu/bloom#>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {
bloom:align a bloom:ActionVerb,
        owl:NamedIndividual ;
    rdfs:label "align"@en ;
    bloom:hasActionVerbType ontoksd:CSPRecordedActionVerbType ;
    bloom:isActionVerbFor bloom:Applying ;
    skos:scopeNote "Supplemental verb declaration grounded in reviewed CSP records. The level association records a use in this dataset; it is not an official or exclusive taxonomic placement. Pair-specific justification is expressed with hasBloomLevelJustificationVerb."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task05-TheFarmingRobotAndFeedingRobot/TASK05-CSP-Adjustments.md> .

bloom:constrain a bloom:ActionVerb,
