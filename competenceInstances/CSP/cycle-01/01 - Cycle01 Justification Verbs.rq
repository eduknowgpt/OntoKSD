bloom:relate a bloom:ActionVerb,
        owl:NamedIndividual ;
    rdfs:label "relate"@en ;
    bloom:hasActionVerbType ontoksd:CSPRecordedActionVerbType ;
    bloom:isActionVerbFor bloom:Analyzing,
        bloom:Applying,
