ns1:AC_Task01_VendingMachine_PBLContext a ns1:AcquisitionContext ;
    rdfs:label "Task01 Acquisition Context — PBL Automata Modeling and Evaluation"@en ;
    dcterms:identifier "Task01-AC"^^xsd:string ;
    rdfs:comment "Pedagogically relevant context for Task01, characterized by problem-based learning, collaborative work, use of JFLAP or equivalent simulator, documentation through whiteboard and logbook, and evaluation based on submitted formal artifacts and technical documentation."@en .

ns1:AC_Task02_TrafficControl a ns1:AcquisitionContext ;
    rdfs:label "Task02 Acquisition Context — Traffic Control"@en ;
    dcterms:identifier "Task02-AC"^^xsd:string ;
    rdfs:comment "Acquisition context associated with Task02. It represents the pedagogical setting in which learners engage in a problem-based learning activity centered on the modeling, simulation, and documentation of a Turing-Machine-based traffic-control solution. This context includes collaborative work, use of simulation tools such as JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

ns1:AC_Task03_FarmerRobot a ns1:AcquisitionContext ;
    rdfs:label "Task03 Acquisition Context — The Farmer Robot"@en ;
    dcterms:identifier "Task03-AC"^^xsd:string ;
    rdfs:comment "Acquisition context associated with Task03. It represents the pedagogical setting in which learners engage in a problem-based learning activity focused on the modeling, simulation, analysis, and documentation of a herd-identification module using Finite State Machines and Regular Expressions. This context includes collaborative work, use of JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

ns1:AC_Task04_ReturnFarmerRobot a ns1:AcquisitionContext ;
    rdfs:label "Task04 Acquisition Context — The Return of the Farmer Robot"@en ;
    dcterms:identifier "Task04-AC"^^xsd:string ;
    rdfs:comment "Acquisition context associated with Task04. It represents the pedagogical setting in which learners engage in a problem-based learning activity focused on the modeling, simulation, analysis, and documentation of a robot navigation module based on Pushdown Automata and context-free formalisms. This context includes collaborative work, use of JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

ns1:AC_Task05_FarmerRobotAndFeederRobot a ns1:AcquisitionContext ;
    rdfs:label "Task05 Acquisition Context — The Farmer Robot and the Feeder Robot"@en ;
    dcterms:identifier "Task05-AC"^^xsd:string ;
    rdfs:comment "Acquisition context associated with Task05. It represents the pedagogical setting in which learners engage in a problem-based learning activity focused on the integrated modeling, simulation, coordination, and documentation of Farmer Robot and Feeder Robot modules using Turing Machines as a unified formalism. This context includes collaborative work, use of JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

