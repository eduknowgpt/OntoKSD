ns1:Knowledge_CSP_ContextFreeGrammars a ns1:Knowledge ;
    rdfs:label "Context-Free Grammars"@en ;
    ns1:hasKnowledgeType ns1:computingSpecificKnowledgeType ;
    skos:definition "Context-free production rules, nonterminal and terminal symbols, derivations, generated symbol sequences, and their relation to pushdown computation."@en ;
    skos:scopeNote "Locally curated semantic content from cycle-01 records. Curricular links, when present on a pairing, are alignment anchors and do not identify a broader curricular concept with this knowledge instance."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task04-TheReturnFarmingRobot/Task04-CSP-Adjustments.md> .

ns1:Knowledge_CSP_DeterministicFiniteAutomata a ns1:Knowledge ;
    rdfs:label "Deterministic Finite Automata"@en ;
    ns1:hasKnowledgeType ns1:computingSpecificKnowledgeType ;
    skos:definition "Finite-state models with exactly one applicable transition for each state/input-symbol pair, including states, alphabets, transition functions, acceptance and deterministic behavior."@en ;
    skos:scopeNote "Locally curated semantic content from cycle-01 records. Curricular links, when present on a pairing, are alignment anchors and do not identify a broader curricular concept with this knowledge instance."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task01-TheVendingMachine/Review2/Task01-CSP-Report-v2.md> .

ns1:TA_Task02_ModelAndValidateTrafficControlTM a ns1:TaskActivity ;
    rdfs:label "Model, simulate, validate, and document a traffic-control solution using Turing Machines"@en ;
    rdfs:comment "Core task activity of Task02. It represents the central activity through which learners analyze requirements, construct a formal Turing Machine solution, test it using simulation tools, and document the resulting design."@en .

ns1:TA_Task03_ModelAnalyzeAndValidateFSM a ns1:TaskActivity ;
    rdfs:label "Model, analyze, simulate, validate, and document a herd-identification module using Finite State Machines"@en ;
    rdfs:comment "Core task activity of Task03. It represents the central activity through which learners analyze requirements, model a herd-identification module, generate corresponding regular expressions, investigate structural patterns, validate the solution through simulation, and document the results."@en .

ns1:TA_Task04_ModelAndValidatePDANavigation a ns1:TaskActivity ;
    rdfs:label "Model, simulate, validate, and document a return-navigation solution using Pushdown Automata"@en ;
    rdfs:comment "Core task activity of Task04. It represents the central activity through which learners analyze navigation requirements, model a Pushdown Automaton with stack-based memory, interpret or define rule-based notation for location sequences, validate the solution through simulation, and document the resulting design."@en .

ns1:TA_Task05_ModelIntegrateAndValidateTMMultiAgentSystem a ns1:TaskActivity ;
    rdfs:label "Model, integrate, simulate, validate, and document a multi-agent system using Turing Machines"@en ;
    rdfs:comment "Core task activity of Task05. It represents the central activity through which learners analyze inter-robot requirements, revise previous modules, design an integrated Turing-Machine-based architecture, simulate the coordinated behavior, and document the resulting system."@en .

ns1:TC_Task02_SensorDataProcessing a ns1:TaskComponent ;
    rdfs:label "Sensor data processing"@en ;
    rdfs:comment "Task component representing the processing of sensor-derived traffic data used as input to the computational model."@en .

ns1:TC_Task02_TechnicalReport a ns1:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Task component representing the structured technical report required as a deliverable for documenting the formal solution, design decisions, and simulation outcomes."@en .

ns1:TC_Task02_TrafficClassificationSystem a ns1:TaskComponent ;
    rdfs:label "Traffic classification and counting system"@en ;
    rdfs:comment "Task component representing the target computational system to be modeled. It includes vehicle classification, counting of occurrences per category, and identification of the most frequent category."@en .

ns1:TC_Task02_TuringMachineArtifact a ns1:TaskComponent ;
    rdfs:label "Turing Machine artifact"@en ;
    rdfs:comment "Task component representing one or more Turing Machine models that formalize the proposed solution to the traffic-control problem."@en .

ns1:TC_Task03_ComplexityAndCostAnalysis a ns1:TaskComponent ;
    rdfs:label "FSM complexity and cost analysis"@en ;
    rdfs:comment "Task component representing the analysis of state and transition complexity and its relation to prototype cost estimation."@en .

ns1:TC_Task03_FSMArtifact a ns1:TaskComponent ;
    rdfs:label "Finite State Machine artifact"@en ;
    rdfs:comment "Task component representing the formal Finite State Machine model of the herd-identification module."@en .

ns1:TC_Task03_HerdIdentificationModule a ns1:TaskComponent ;
    rdfs:label "Herd-identification module"@en ;
    rdfs:comment "Task component representing the computational module responsible for recognizing herd categories and supporting feed-request decisions."@en .

ns1:TC_Task03_RegularExpressionSet a ns1:TaskComponent ;
    rdfs:label "Regular expression set"@en ;
    rdfs:comment "Task component representing the regular expressions used to document or formalize behaviors corresponding to the FSM solution."@en .

ns1:TC_Task03_TechnicalReport a ns1:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Task component representing the structured report required to explain design decisions, examples of operation, documentation rationale, and budgeting implications."@en .

ns1:TC_Task04_ModuleIntegrationAnalysis a ns1:TaskComponent ;
    rdfs:label "Module integration or parallel-operation analysis"@en ;
    rdfs:comment "Task component representing the analysis of whether the navigation module should extend the food-delivery module or operate in parallel with inter-module communication."@en .

ns1:TC_Task04_NavigationModule a ns1:TaskComponent ;
    rdfs:label "Robot return-navigation module"@en ;
    rdfs:comment "Task component representing the computational module responsible for guiding the robot back to its starting point."@en .

ns1:TC_Task04_PDAArtifact a ns1:TaskComponent ;
    rdfs:label "Pushdown Automaton artifact"@en ;
    rdfs:comment "Task component representing the formal Pushdown Automaton model of the robot navigation module."@en .

ns1:TC_Task04_RuleBasedNotation a ns1:TaskComponent ;
    rdfs:label "Rule-based notation for location sequences"@en ;
    rdfs:comment "Task component representing formal notation, such as grammars or transition rules, used to specify valid location sequences and navigation behavior."@en .

ns1:TC_Task04_TechnicalReport a ns1:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Task component representing the structured report required to explain design decisions, formal notation, stack behavior, and examples of operation."@en .

ns1:TC_Task05_FarmerRobotIdentificationModule a ns1:TaskComponent ;
    rdfs:label "Farmer Robot identification and signaling module"@en ;
    rdfs:comment "Task component representing the enhanced Farmer Robot module responsible for herd-related identification and food-delivery signaling, including threshold input logic."@en .

ns1:TC_Task05_FarmerRobotNavigationModule a ns1:TaskComponent ;
    rdfs:label "Farmer Robot navigation module"@en ;
    rdfs:comment "Task component representing the Farmer Robot navigation behavior within the integrated system."@en .

ns1:TC_Task05_FeederRobotNavigationModule a ns1:TaskComponent ;
    rdfs:label "Feeder Robot navigation module"@en ;
    rdfs:comment "Task component representing the Feeder Robot navigation behavior driven by communicated path information."@en .

ns1:TC_Task05_IntegratedTuringMachineArtifact a ns1:TaskComponent ;
    rdfs:label "Integrated Turing Machine artifact"@en ;
    rdfs:comment "Task component representing the unified Turing-Machine-based computational artifact covering integrated multi-agent behavior."@en .

ns1:TC_Task05_PathEncodingAndCommunication a ns1:TaskComponent ;
    rdfs:label "Path encoding and inter-robot communication"@en ;
    rdfs:comment "Task component representing the encoding and communication of path information from the Farmer Robot to the Feeder Robot."@en .

ns1:TC_Task05_TechnicalReport a ns1:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Task component representing the structured technical report required to explain module interaction, tape and state design, coordination logic, and justification of design choices."@en .

ns1:TCons_Task02_MostFrequentCategoryIdentification a ns1:TaskConstraint ;
    rdfs:label "Identify the most frequent vehicle category"@en ;
    rdfs:comment "Constraint stating that the solution must determine which vehicle category was the most frequent in the analyzed time period."@en .

ns1:TCons_Task02_NightTrafficCounting a ns1:TaskConstraint ;
    rdfs:label "Count category frequencies from the previous night"@en ;
    rdfs:comment "Constraint stating that the solution must count how many vehicles of each category traveled during the previous night."@en .

ns1:TCons_Task02_OptionalVariantComparison a ns1:TaskConstraint ;
    rdfs:label "Evaluate whether a provided Turing Machine variant is needed for this solution"@en ;
    rdfs:comment "The source requires considering the need for variants. Applying a particular variant is conditional on the chosen solution. This does not require a broader theoretical comparison of computational power."@en .

ns1:TCons_Task02_ProcessDocumentation a ns1:TaskConstraint ;
    rdfs:label "Document the process through whiteboard and logbook"@en ;
    rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

ns1:TCons_Task02_SimulatorExecution a ns1:TaskConstraint ;
    rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
    rdfs:comment "Constraint stating that the Turing Machine artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

ns1:TCons_Task02_VehicleClassification a ns1:TaskConstraint ;
    rdfs:label "Classify vehicles into light, heavy, and very heavy categories"@en ;
    rdfs:comment "Constraint stating that the solution must classify vehicles according to the weight ranges defined in the task specification."@en .

ns1:TCons_Task03_AnimalClassification a ns1:TaskConstraint ;
    rdfs:label "Identify bovines, caprines, and swine"@en ;
    rdfs:comment "Constraint stating that the solution must identify animal categories relevant to herd management."@en .

ns1:TCons_Task03_FeedRequestTrigger a ns1:TaskConstraint ;
    rdfs:label "Trigger feed requests based on herd thresholds"@en ;
    rdfs:comment "Constraint stating that the identification module must support feed-request generation when threshold conditions are satisfied."@en .

ns1:TCons_Task03_LowCostConstraint a ns1:TaskConstraint ;
    rdfs:label "Consider low-cost prototype requirements"@en ;
    rdfs:comment "Constraint stating that the proposed solution should support low-cost prototyping, including analysis of structural complexity for budgeting purposes."@en .

ns1:TCons_Task03_ProcessDocumentation a ns1:TaskConstraint ;
    rdfs:label "Document the process through whiteboard and logbook"@en ;
    rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

ns1:TCons_Task03_RegularExpressionDocumentation a ns1:TaskConstraint ;
    rdfs:label "Provide regular expressions as part of documentation"@en ;
    rdfs:comment "Constraint stating that the solution should include regular expressions supporting formal documentation of the FSM behavior."@en .

ns1:TCons_Task03_SimulatorExecution a ns1:TaskConstraint ;
    rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
    rdfs:comment "Constraint stating that the FSM artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

ns1:TCons_Task03_StateAndTransitionAnalysis a ns1:TaskConstraint ;
    rdfs:label "Analyze minimum states and transitions"@en ;
    rdfs:comment "Constraint stating that the task includes analysis of relationships between herd thresholds and the minimum number of states and transitions required in the FSM."@en .

ns1:TCons_Task03_ThresholdDetection a ns1:TaskConstraint ;
    rdfs:label "Detect herd thresholds"@en ;
    rdfs:comment "Constraint stating that the solution must detect when predefined minimum herd quantities are reached."@en .

ns1:TCons_Task04_FoodDeliveryModuleIntegration a ns1:TaskConstraint ;
    rdfs:label "Consider extension or parallel operation with the food-delivery module"@en ;
    rdfs:comment "Constraint stating that the solution should analyze whether the navigation module extends the previous food-delivery module or operates in parallel with it."@en .

ns1:TCons_Task04_PathReversal a ns1:TaskConstraint ;
    rdfs:label "Support reversal of the navigation path"@en ;
    rdfs:comment "Constraint stating that the module must support reverse navigation based on previously recorded path information."@en .

ns1:TCons_Task04_ProcessDocumentation a ns1:TaskConstraint ;
    rdfs:label "Document the process through whiteboard and logbook"@en ;
    rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

ns1:TCons_Task04_ReturnToOrigin a ns1:TaskConstraint ;
    rdfs:label "Return the robot to its starting point"@en ;
    rdfs:comment "Constraint stating that the solution must enable the robot to return to its initial location after completing the outbound task."@en .

ns1:TCons_Task04_RuleNotationSupport a ns1:TaskConstraint ;
    rdfs:label "Support formal rule-based notation for location sequences"@en ;
    rdfs:comment "Constraint stating that the solution should support or interpret rule-based notation for generating and documenting location sequences."@en .

ns1:TCons_Task04_SimulatorExecution a ns1:TaskConstraint ;
    rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
    rdfs:comment "Constraint stating that the Pushdown Automaton artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

ns1:TCons_Task04_StackBasedMemory a ns1:TaskConstraint ;
    rdfs:label "Use stack-based memory"@en ;
    rdfs:comment "Constraint stating that the solution must rely on auxiliary memory to support path tracking and return behavior."@en .

ns1:TCons_Task05_CommunicatePathToFeederRobot a ns1:TaskConstraint ;
    rdfs:label "Communicate the path to the Feeder Robot"@en ;
    rdfs:comment "Constraint stating that the Farmer Robot must communicate the path that the Feeder Robot should follow."@en .

ns1:TCons_Task05_CoordinateMultipleAgents a ns1:TaskConstraint ;
    rdfs:label "Coordinate Farmer Robot and Feeder Robot behaviors"@en ;
    rdfs:comment "Constraint stating that the solution must coordinate the behavior of two interacting robotic agents."@en .

ns1:TCons_Task05_ProcessDocumentation a ns1:TaskConstraint ;
    rdfs:label "Document the process through whiteboard and logbook"@en ;
    rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

ns1:TCons_Task05_ReviseHerdThresholdInput a ns1:TaskConstraint ;
    rdfs:label "Allow herd-threshold quantities as input"@en ;
    rdfs:comment "Constraint stating that the previous signaling logic must be revised so that minimum herd quantities can be provided as machine inputs."@en .

ns1:TCons_Task05_SimulatorExecution a ns1:TaskConstraint ;
    rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
    rdfs:comment "Constraint stating that the integrated Turing Machine artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

ns1:TCons_Task05_StandardizeDocumentationAndTraining a ns1:TaskConstraint ;
    rdfs:label "Support standardization of documentation and training"@en ;
    rdfs:comment "Constraint stating that the solution should support standardization goals related to system documentation and maintenance-team training."@en .

ns1:TCons_Task05_UseUnifiedTuringMachineFormalism a ns1:TaskConstraint ;
    rdfs:label "Use a unified Turing Machine formalism"@en ;
    rdfs:comment "Constraint stating that the same abstract machine model must be used to implement the integrated robot modules."@en .

ns1:TaskActivity_Task01_ModelAndValidateFSM a ns1:TaskActivity ;
    rdfs:label "Model, simulate, validate, and document a vending-machine FSM solution"@en ;
    rdfs:comment "Central task activity of Task01, involving formal modeling, simulation-based validation, and technical documentation."@en .

ns1:TaskComponent_Task01_FSMArtifact a ns1:TaskComponent ;
    rdfs:label "Finite-state-machine artifact"@en ;
    rdfs:comment "Formal automaton artifact representing the vending machine behavior."@en .

ns1:TaskComponent_Task01_RegexFragment a ns1:TaskComponent ;
    rdfs:label "Regular-expression fragment"@en ;
    rdfs:comment "Optional or conditional representational component relating a portion of the automaton to a regular expression."@en .

ns1:TaskComponent_Task01_TechnicalReport a ns1:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Structured report describing design decisions, formal representation, validation results, and system behavior."@en .

ns1:TaskComponent_Task01_VendingMachineSystem a ns1:TaskComponent ;
    rdfs:label "Vending machine computational system"@en ;
    rdfs:comment "Domain object to be modeled, including product selection, payment processing, change calculation, and dispensing behavior."@en .

ns1:TaskConstraint_Task01_OptionalBonusChange a ns1:TaskConstraint ;
    rdfs:label "Optional bonus-change behavior"@en ;
    rdfs:comment "Optional challenge requiring random bonus change of R$1.00 under exact-payment conditions."@en .

ns1:TaskConstraint_Task01_PaymentAndChange a ns1:TaskConstraint ;
    rdfs:label "Accept R$1.00 and R$2.00 and provide change"@en ;
    rdfs:comment "The modeled machine must process specified payments and return change correctly."@en .

ns1:TaskConstraint_Task01_ProcessDocumentation a ns1:TaskConstraint ;
    rdfs:label "Document the PBL process using whiteboard versions and a shared logbook"@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task01-TheVendingMachine/Task01-TheVendingMachine.md> .

ns1:TaskConstraint_Task01_SimulatorSupport a ns1:TaskConstraint ;
    rdfs:label "Be testable in JFLAP or equivalent"@en ;
    rdfs:comment "The automaton artifact must be suitable for simulation and testing in JFLAP or equivalent tool."@en .

ns1:TaskConstraint_Task01_ThreeProductsMinimum a ns1:TaskConstraint ;
    rdfs:label "Support at least three products"@en ;
    rdfs:comment "The solution must represent a machine configured to sell at least three products."@en .

