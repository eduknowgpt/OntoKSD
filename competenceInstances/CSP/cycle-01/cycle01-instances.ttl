ns1:Task02_TrafficControl a ns1:Task ;
    rdfs:label "Task02 — Traffic Control"@en ;
    dcterms:identifier "Task02-TASK"^^xsd:string ;
    ns1:hasTaskActivity ns1:TA_Task02_ModelAndValidateTrafficControlTM ;
    ns1:hasTaskComponent ns1:TC_Task02_SensorDataProcessing,
        ns1:TC_Task02_TechnicalReport,
        ns1:TC_Task02_TrafficClassificationSystem,
        ns1:TC_Task02_TuringMachineArtifact ;
    ns1:hasTaskConstraint ns1:TCons_Task02_MostFrequentCategoryIdentification,
        ns1:TCons_Task02_NightTrafficCounting,
        ns1:TCons_Task02_OptionalVariantComparison,
        ns1:TCons_Task02_ProcessDocumentation,
        ns1:TCons_Task02_SimulatorExecution,
        ns1:TCons_Task02_VehicleClassification ;
    ns1:hasTaskStatement "Design, simulate, validate, and document a Turing-Machine-based computational solution capable of processing sensor data, classifying vehicles into light, heavy, and very heavy categories, counting category frequencies from the previous night, and identifying the most frequent category."@en ;
    ns1:isTaskOf ns1:C05,
        ns1:C07,
        ns1:C08,
        ns1:C09,
        ns1:C10 ;
    rdfs:comment "Specification-level task corresponding to the Traffic Control PBL case. It represents the computational problem to be addressed, namely the design of a formal solution capable of processing traffic data, classifying vehicles into weight-based categories, counting category frequencies, and identifying the most frequent category."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task02-TrafficControl/Task02-CSP-Adjustments.md>,
        <http://purl.org/ontoksd/source/csp/cycle-01/Task02-TrafficControl/Task02-TrafficControl.md> .

ns1:Task03_FarmerRobot a ns1:Task ;
    rdfs:label "Task03 — The Farmer Robot"@en ;
    dcterms:identifier "Task03-TASK"^^xsd:string ;
    ns1:hasTaskActivity ns1:TA_Task03_ModelAnalyzeAndValidateFSM ;
    ns1:hasTaskComponent ns1:TC_Task03_ComplexityAndCostAnalysis,
        ns1:TC_Task03_FSMArtifact,
        ns1:TC_Task03_HerdIdentificationModule,
        ns1:TC_Task03_RegularExpressionSet,
        ns1:TC_Task03_TechnicalReport ;
    ns1:hasTaskConstraint ns1:TCons_Task03_AnimalClassification,
        ns1:TCons_Task03_FeedRequestTrigger,
        ns1:TCons_Task03_LowCostConstraint,
        ns1:TCons_Task03_ProcessDocumentation,
        ns1:TCons_Task03_RegularExpressionDocumentation,
        ns1:TCons_Task03_SimulatorExecution,
        ns1:TCons_Task03_StateAndTransitionAnalysis,
        ns1:TCons_Task03_ThresholdDetection ;
    ns1:hasTaskStatement "Design, simulate, validate, analyze, and document a herd-identification module using Finite State Machines and Regular Expressions, capable of identifying animal classes, detecting threshold conditions for feed requests, and supporting complexity-based cost estimation."@en ;
    ns1:isTaskOf ns1:C03,
        ns1:C04,
        ns1:C05,
        ns1:C06,
        ns1:C11 ;
    rdfs:comment "Specification-level task corresponding to the Farmer Robot PBL case. It represents the problem of designing a low-cost herd-identification module capable of recognizing bovines, caprines, and swine, triggering feed requests according to predefined thresholds, and supporting documentation and budgeting analysis based on FSM structure."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task03-FarmingRobot/Task03-CSP-Adjustments.md>,
        <http://purl.org/ontoksd/source/csp/cycle-01/Task03-FarmingRobot/Task03-FarmingRobot.md> .

ns1:Task04_ReturnFarmerRobot a ns1:Task ;
    rdfs:label "Task04 — The Return of the Farmer Robot"@en ;
    dcterms:identifier "Task04-TASK"^^xsd:string ;
    ns1:hasTaskActivity ns1:TA_Task04_ModelAndValidatePDANavigation ;
    ns1:hasTaskComponent ns1:TC_Task04_ModuleIntegrationAnalysis,
        ns1:TC_Task04_NavigationModule,
        ns1:TC_Task04_PDAArtifact,
        ns1:TC_Task04_RuleBasedNotation,
        ns1:TC_Task04_TechnicalReport ;
    ns1:hasTaskConstraint ns1:TCons_Task04_FoodDeliveryModuleIntegration,
        ns1:TCons_Task04_PathReversal,
        ns1:TCons_Task04_ProcessDocumentation,
        ns1:TCons_Task04_ReturnToOrigin,
        ns1:TCons_Task04_RuleNotationSupport,
        ns1:TCons_Task04_SimulatorExecution,
        ns1:TCons_Task04_StackBasedMemory ;
    ns1:hasTaskStatement "Design, simulate, validate, and document a navigation module using Pushdown Automata and, where appropriate, context-free rule-based notation, so that the robot can return to its starting point after completing a food-delivery alert path."@en ;
    ns1:isTaskOf ns1:C03,
        ns1:C05,
        ns1:C12,
        ns1:C13,
        ns1:C14 ;
    rdfs:comment "Specification-level task corresponding to the Return of the Farmer Robot PBL case. It represents the problem of designing a navigation module that enables the robot to return to its starting point after food-delivery signaling, using memory-dependent control, formal rule-based notation, and simulation-supported validation."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task04-TheReturnFarmingRobot/Task04-CSP-Adjustments.md>,
        <http://purl.org/ontoksd/source/csp/cycle-01/Task04-TheReturnFarmingRobot/Task04-TheReturnFarmingRobot.md> .

ns1:Task05_FarmerRobotAndFeederRobot a ns1:Task ;
    rdfs:label "Task05 — The Farmer Robot and the Feeder Robot"@en ;
    dcterms:identifier "Task05-TASK"^^xsd:string ;
    ns1:hasTaskActivity ns1:TA_Task05_ModelIntegrateAndValidateTMMultiAgentSystem ;
    ns1:hasTaskComponent ns1:TC_Task05_FarmerRobotIdentificationModule,
