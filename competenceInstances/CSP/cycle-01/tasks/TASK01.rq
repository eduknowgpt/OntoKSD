ontoksd:PS_Task01_0_10 a ontoksd:ProficiencyScheme ;
    rdfs:label "Task01 proficiency scheme"@en ;
    dcterms:identifier "Task01-PS"^^xsd:string ;
    ontoksd:definesInterval ontoksd:Interval_Task01_Advanced,
        ontoksd:Interval_Task01_Competent,
        ontoksd:Interval_Task01_Novice ;
    ontoksd:definesLevel ontoksd:PL_Task01_Advanced,
        ontoksd:PL_Task01_Competent,
        ontoksd:PL_Task01_Novice ;
    ontoksd:usesScale ontoksd:Scale_Task01_0_10 ;
    skos:scopeNote "Specification-level interpretive assumption recorded in the CSP report, not an observed result or a grading rule contained in the original task statement. The assessment references this planned scheme documentarily; usesProficiencyScheme is reserved for AssessmentOccurrence."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task01-TheVendingMachine/Task01-CSP-Report.md> .

ontoksd:Scale_Task01_0_10 a ontoksd:Scale ;
    rdfs:label "Task01 proficiency scale 0–10"@en ;
    dcterms:identifier "Task01-SCALE"^^xsd:string ;
    ontoksd:hasInterval ontoksd:Interval_Task01_Advanced,
        ontoksd:Interval_Task01_Competent,
        ontoksd:Interval_Task01_Novice ;
    ontoksd:maxValue 10.0 ;
    ontoksd:minValue 0.0 ;
    ontoksd:step 0.1 ;
    rdfs:comment "Decimal scoring range from 0 to 10 with a selected granularity of 0.1. For Task04, the reported 5.1/9.1 starts are interpreted on this one-decimal domain. Numeric validation of step adherence is external to OWL."@en .

ontoksd:AS_Task01_VendingMachineAssessment a ontoksd:Assessment ;
    rdfs:label "Assessment — Task01 Vending Machine Solution"@en ;
    dcterms:description "Assessment specification based on the Task01 PBL case, intended to evaluate learners through the submitted vending-machine automaton, simulation-supported validation, and technical report."@en ;
    dcterms:identifier "Task01-AS"^^xsd:string ;
    dcterms:references ontoksd:PS_Task01_0_10 ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task01_VendingMachine_PBLContext ;
    ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType,
        ontoksd:WrittenAssessmentModalityType ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task01_C01,
        ontoksd:CA_Task01_C02,
        ontoksd:CA_Task01_C03,
        ontoksd:CA_Task01_C04,
        ontoksd:CA_Task01_C05,
        ontoksd:CA_Task01_C06 ;
    ontoksd:hasInstructionalStatement "Assess the submitted model, technical report and documented PBL process against the task requirements. Individual participation is an assessment design concern; this specification does not assert an assessment occurrence or an individual result."@en ;
    ontoksd:isBasedOnActivity ontoksd:LT_Task01_VendingMachine ;
    ontoksd:usesResource ontoksd:ER_Task01_JFLAP,
        ontoksd:ER_Task01_ProblemStatement,
        ontoksd:ER_Task01_SBCReportTemplate ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task01-TheVendingMachine/Review2/Task01-CSP-Report-v2.md>,
        <http://purl.org/ontoksd/source/csp/cycle-01/Task01-TheVendingMachine/Task01-TheVendingMachine.md> .

