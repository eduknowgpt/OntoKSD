    dcterms:description "Collaborative whiteboard structure used to document questions, facts, ideas/hypotheses, and actions during the PBL process."@en ;
    dcterms:identifier "Task01-ER3"^^xsd:string ;
    ontoksd:intendedUse "Process documentation and collaborative reasoning support."^^xsd:string .

ontoksd:TaskActivity_Task01_ModelAndValidateFSM a ontoksd:TaskActivity ;
    rdfs:label "Model, simulate, validate, and document a vending-machine FSM solution"@en ;
    rdfs:comment "Central task activity of Task01, involving formal modeling, simulation-based validation, and technical documentation."@en .

ontoksd:TaskComponent_Task01_FSMArtifact a ontoksd:TaskComponent ;
    rdfs:label "Finite-state-machine artifact"@en ;
    rdfs:comment "Formal automaton artifact representing the vending machine behavior."@en .

ontoksd:TaskComponent_Task01_RegexFragment a ontoksd:TaskComponent ;
    rdfs:label "Regular-expression fragment"@en ;
    rdfs:comment "Optional or conditional representational component relating a portion of the automaton to a regular expression."@en .

ontoksd:TaskComponent_Task01_TechnicalReport a ontoksd:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Structured report describing design decisions, formal representation, validation results, and system behavior."@en .

ontoksd:TaskComponent_Task01_VendingMachineSystem a ontoksd:TaskComponent ;
    rdfs:label "Vending machine computational system"@en ;
    rdfs:comment "Domain object to be modeled, including product selection, payment processing, change calculation, and dispensing behavior."@en .

ontoksd:TaskConstraint_Task01_OptionalBonusChange a ontoksd:TaskConstraint ;
    rdfs:label "Optional bonus-change behavior"@en ;
    rdfs:comment "Optional challenge requiring random bonus change of R$1.00 under exact-payment conditions."@en .

ontoksd:TaskConstraint_Task01_PaymentAndChange a ontoksd:TaskConstraint ;
    rdfs:label "Accept R$1.00 and R$2.00 and provide change"@en ;
    rdfs:comment "The modeled machine must process specified payments and return change correctly."@en .

ontoksd:TaskConstraint_Task01_ProcessDocumentation a ontoksd:TaskConstraint ;
    rdfs:label "Document the PBL process using whiteboard versions and a shared logbook"@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task01-TheVendingMachine/Task01-TheVendingMachine.md> .

ontoksd:TaskConstraint_Task01_SimulatorSupport a ontoksd:TaskConstraint ;
    rdfs:label "Be testable in JFLAP or equivalent"@en ;
    rdfs:comment "The automaton artifact must be suitable for simulation and testing in JFLAP or equivalent tool."@en .

ontoksd:TaskConstraint_Task01_ThreeProductsMinimum a ontoksd:TaskConstraint ;
    rdfs:label "Support at least three products"@en ;
    rdfs:comment "The solution must represent a machine configured to sell at least three products."@en .

ontoksd:AC_Task01_VendingMachine_PBLContext a ontoksd:AcquisitionContext ;
    rdfs:label "Task01 Acquisition Context — PBL Automata Modeling and Evaluation"@en ;
    dcterms:identifier "Task01-AC"^^xsd:string ;
    rdfs:comment "Pedagogically relevant context for Task01, characterized by problem-based learning, collaborative work, use of JFLAP or equivalent simulator, documentation through whiteboard and logbook, and evaluation based on submitted formal artifacts and technical documentation."@en .

ontoksd:ER_Task01_JFLAP a ontoksd:EducationalResource ;
    rdfs:label "JFLAP simulator"@en ;
    dcterms:description "Automata simulator used to test, inspect, and validate finite-state-machine behavior."@en ;
    dcterms:identifier "Task01-ER2"^^xsd:string ;
    ontoksd:intendedUse "Simulation, execution, debugging, and validation of finite-state-machine artifacts."^^xsd:string .

ontoksd:ER_Task01_ProblemStatement a ontoksd:EducationalResource ;
