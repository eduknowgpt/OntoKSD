ontoksd:PS_Task02_ProficiencyScheme a ontoksd:ProficiencyScheme ;
    rdfs:label "Task02 proficiency scheme"@en ;
    dcterms:identifier "Task02-PS"^^xsd:string ;
    ontoksd:definesInterval ontoksd:Interval_Task02_Advanced,
        ontoksd:Interval_Task02_Competent,
        ontoksd:Interval_Task02_Novice ;
    ontoksd:definesLevel ontoksd:PL_Task02_Advanced,
        ontoksd:PL_Task02_Competent,
        ontoksd:PL_Task02_Novice ;
    ontoksd:usesScale ontoksd:Scale_Task02_0_10 ;
    rdfs:comment "Proficiency scheme associated with Task02, defining how intervals in the numeric scale are interpreted as proficiency levels."@en ;
    skos:scopeNote "Specification-level interpretive assumption recorded in the CSP report, not an observed result or a grading rule contained in the original task statement. The assessment references this planned scheme documentarily; usesProficiencyScheme is reserved for AssessmentOccurrence."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task02-TrafficControl/Task02-CSP-Report.md> .

ontoksd:Scale_Task02_0_10 a ontoksd:Scale ;
    rdfs:label "Task02 proficiency scale 0–10"@en ;
    dcterms:identifier "Task02-SCALE"^^xsd:string ;
    ontoksd:hasInterval ontoksd:Interval_Task02_Advanced,
        ontoksd:Interval_Task02_Competent,
        ontoksd:Interval_Task02_Novice ;
    ontoksd:maxValue 10.0 ;
    ontoksd:minValue 0.0 ;
    ontoksd:step 0.1 ;
    rdfs:comment "Decimal scoring range from 0 to 10 with a selected granularity of 0.1. For Task04, the reported 5.1/9.1 starts are interpreted on this one-decimal domain. Numeric validation of step adherence is external to OWL."@en .

ontoksd:AS_Task02_TrafficControl a ontoksd:Assessment ;
    rdfs:label "Assessment — Task02 Traffic Control"@en ;
    dcterms:description "Assessment specification based on Task02, intended to evaluate learners through submitted Turing Machine artifacts, simulation-supported validation, and technical report."@en ;
    dcterms:identifier "Task02-AS"^^xsd:string ;
    dcterms:references ontoksd:PS_Task02_ProficiencyScheme ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task02_TrafficControl ;
    ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType,
        ontoksd:WrittenAssessmentModalityType ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task02_C05,
        ontoksd:CA_Task02_C07,
        ontoksd:CA_Task02_C08,
        ontoksd:CA_Task02_C09,
        ontoksd:CA_Task02_C10 ;
    ontoksd:hasInstructionalStatement "Assess the submitted model, technical report and documented PBL process against the task requirements. Individual participation is an assessment design concern; this specification does not assert an assessment occurrence or an individual result."@en ;
    ontoksd:isBasedOnActivity ontoksd:LT_Task02_TrafficControl ;
    ontoksd:usesResource ontoksd:ER_Task02_JFLAP,
        ontoksd:ER_Task02_ProblemStatement,
        ontoksd:ER_Task02_SBCReportTemplate ;
    rdfs:comment "Assessment specification associated with Task02. It represents the evaluative use of the learning task as a basis for judging learner performance through the submitted formal artifacts and technical documentation."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task02-TrafficControl/Task02-CSP-Adjustments.md>,
        <http://purl.org/ontoksd/source/csp/cycle-01/Task02-TrafficControl/Task02-TrafficControl.md> .

ontoksd:Task02_TrafficControl a ontoksd:Task ;
    rdfs:label "Task02 — Traffic Control"@en ;
    dcterms:identifier "Task02-TASK"^^xsd:string ;
    ontoksd:hasTaskActivity ontoksd:TA_Task02_ModelAndValidateTrafficControlTM ;
    ontoksd:hasTaskComponent ontoksd:TC_Task02_SensorDataProcessing,
        ontoksd:TC_Task02_TechnicalReport,
        ontoksd:TC_Task02_TrafficClassificationSystem,
        ontoksd:TC_Task02_TuringMachineArtifact ;
