ontoksd:LT_Task02_TrafficControl a ontoksd:LearningTask ;
    rdfs:label "Learning Task — Traffic Control"@en ;
    dcterms:description "Concrete instructional unit in which learners analyze the traffic-control problem, model a Turing-Machine-based solution, test it using a simulator, and document the result."@en ;
