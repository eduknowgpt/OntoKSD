ontoksd:ER_Task02_Logbook a ontoksd:EducationalResource ;
    rdfs:label "Task02 logbook"@en ;
    dcterms:description "Shared document used to record progress, meeting notes, decisions, and challenges encountered during the task."@en ;
    dcterms:identifier "Task02-ER4"^^xsd:string ;
    ontoksd:intendedUse "Traceability of collaborative work and process recording."^^xsd:string ;
    rdfs:comment "Educational resource used to maintain traceability of the development process and collaborative work performed during Task02."@en .

ontoksd:ER_Task02_PBLWhiteboard a ontoksd:EducationalResource ;
    rdfs:label "PBL whiteboard"@en ;
    dcterms:description "Collaborative whiteboard used to document questions, facts, ideas or hypotheses, and actions throughout the PBL process."@en ;
    dcterms:identifier "Task02-ER3"^^xsd:string ;
    ontoksd:intendedUse "Process documentation and collaborative reasoning support."^^xsd:string ;
    rdfs:comment "Educational resource used to structure and document collaborative reasoning during the development of the solution."@en .

ontoksd:TA_Task02_ModelAndValidateTrafficControlTM a ontoksd:TaskActivity ;
    rdfs:label "Model, simulate, validate, and document a traffic-control solution using Turing Machines"@en ;
    rdfs:comment "Core task activity of Task02. It represents the central activity through which learners analyze requirements, construct a formal Turing Machine solution, test it using simulation tools, and document the resulting design."@en .

ontoksd:TC_Task02_SensorDataProcessing a ontoksd:TaskComponent ;
    rdfs:label "Sensor data processing"@en ;
    rdfs:comment "Task component representing the processing of sensor-derived traffic data used as input to the computational model."@en .

ontoksd:TC_Task02_TechnicalReport a ontoksd:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Task component representing the structured technical report required as a deliverable for documenting the formal solution, design decisions, and simulation outcomes."@en .

ontoksd:TC_Task02_TrafficClassificationSystem a ontoksd:TaskComponent ;
    rdfs:label "Traffic classification and counting system"@en ;
    rdfs:comment "Task component representing the target computational system to be modeled. It includes vehicle classification, counting of occurrences per category, and identification of the most frequent category."@en .

ontoksd:TC_Task02_TuringMachineArtifact a ontoksd:TaskComponent ;
    rdfs:label "Turing Machine artifact"@en ;
    rdfs:comment "Task component representing one or more Turing Machine models that formalize the proposed solution to the traffic-control problem."@en .

ontoksd:TCons_Task02_MostFrequentCategoryIdentification a ontoksd:TaskConstraint ;
    rdfs:label "Identify the most frequent vehicle category"@en ;
    rdfs:comment "Constraint stating that the solution must determine which vehicle category was the most frequent in the analyzed time period."@en .

ontoksd:TCons_Task02_NightTrafficCounting a ontoksd:TaskConstraint ;
    rdfs:label "Count category frequencies from the previous night"@en ;
    rdfs:comment "Constraint stating that the solution must count how many vehicles of each category traveled during the previous night."@en .

ontoksd:TCons_Task02_OptionalVariantComparison a ontoksd:TaskConstraint ;
    rdfs:label "Evaluate whether a provided Turing Machine variant is needed for this solution"@en ;
    rdfs:comment "The source requires considering the need for variants. Applying a particular variant is conditional on the chosen solution. This does not require a broader theoretical comparison of computational power."@en .

ontoksd:TCons_Task02_ProcessDocumentation a ontoksd:TaskConstraint ;
    rdfs:label "Document the process through whiteboard and logbook"@en ;
    rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

ontoksd:TCons_Task02_SimulatorExecution a ontoksd:TaskConstraint ;
    rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
    rdfs:comment "Constraint stating that the Turing Machine artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

ontoksd:TCons_Task02_VehicleClassification a ontoksd:TaskConstraint ;
    rdfs:label "Classify vehicles into light, heavy, and very heavy categories"@en ;
    rdfs:comment "Constraint stating that the solution must classify vehicles according to the weight ranges defined in the task specification."@en .

ontoksd:AC_Task02_TrafficControl a ontoksd:AcquisitionContext ;
    rdfs:label "Task02 Acquisition Context — Traffic Control"@en ;
    dcterms:identifier "Task02-AC"^^xsd:string ;
    rdfs:comment "Acquisition context associated with Task02. It represents the pedagogical setting in which learners engage in a problem-based learning activity centered on the modeling, simulation, and documentation of a Turing-Machine-based traffic-control solution. This context includes collaborative work, use of simulation tools such as JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

ontoksd:ER_Task02_JFLAP a ontoksd:EducationalResource ;
    rdfs:label "JFLAP simulator"@en ;
    dcterms:description "Simulation environment used to test, inspect, and validate Turing Machine behavior."@en ;
    dcterms:identifier "Task02-ER2"^^xsd:string ;
    ontoksd:intendedUse "Simulation, execution, debugging, and validation of Turing Machine artifacts."^^xsd:string ;
    rdfs:comment "Educational resource corresponding to the simulator used for the operational validation of Turing Machine models developed in Task02."@en .

ontoksd:ER_Task02_ProblemStatement a ontoksd:EducationalResource ;
    rdfs:label "Task02 problem statement"@en ;
    dcterms:description "Problem statement describing the Traffic Control scenario, its requirements, and expected deliverables."@en ;
    dcterms:identifier "Task02-ER1"^^xsd:string ;
    ontoksd:intendedUse "Instructional framing and requirement interpretation for the learning task and the assessment."^^xsd:string ;
    rdfs:comment "Educational resource corresponding to the formal statement of Task02. It frames the problem, constraints, and deliverables that guide both instructional execution and assessment."@en .

ontoksd:ER_Task02_SBCReportTemplate a ontoksd:EducationalResource ;
    rdfs:label "SBC article-format report template"@en ;
    dcterms:description "Template or normative reference for preparing the technical report required as a deliverable."@en ;
    dcterms:identifier "Task02-ER5"^^xsd:string ;
    ontoksd:intendedUse "Support for technical writing and report standardization."^^xsd:string ;
    rdfs:comment "Educational resource supporting the preparation and standardization of the technical report associated with Task02."@en .

ontoksd:Interval_Task02_Advanced a ontoksd:ScaleInterval ;
    rdfs:label "Task02 interval — Advanced"@en ;
    ontoksd:correspondsToLevel ontoksd:PL_Task02_Advanced ;
    ontoksd:includesLower false ;
    ontoksd:includesUpper true ;
    ontoksd:intervalDefinedInScheme ontoksd:PS_Task02_ProficiencyScheme ;
    ontoksd:isIntervalOf ontoksd:Scale_Task02_0_10 ;
    ontoksd:lowerBound 9.0 ;
    ontoksd:upperBound 10.0 ;
    rdfs:comment "Interval corresponding to the Advanced proficiency level in Task02."@en .

ontoksd:Interval_Task02_Competent a ontoksd:ScaleInterval ;
    rdfs:label "Task02 interval — Competent"@en ;
    ontoksd:correspondsToLevel ontoksd:PL_Task02_Competent ;
    ontoksd:includesLower false ;
    ontoksd:includesUpper true ;
    ontoksd:intervalDefinedInScheme ontoksd:PS_Task02_ProficiencyScheme ;
    ontoksd:isIntervalOf ontoksd:Scale_Task02_0_10 ;
    ontoksd:lowerBound 5.0 ;
    ontoksd:upperBound 9.0 ;
    rdfs:comment "Interval corresponding to the Competent proficiency level in Task02."@en .

ontoksd:Interval_Task02_Novice a ontoksd:ScaleInterval ;
    rdfs:label "Task02 interval — Novice"@en ;
    ontoksd:correspondsToLevel ontoksd:PL_Task02_Novice ;
    ontoksd:includesLower true ;
    ontoksd:includesUpper true ;
    ontoksd:intervalDefinedInScheme ontoksd:PS_Task02_ProficiencyScheme ;
    ontoksd:isIntervalOf ontoksd:Scale_Task02_0_10 ;
    ontoksd:lowerBound 0.0 ;
    ontoksd:upperBound 5.0 ;
    rdfs:comment "Interval corresponding to the Novice proficiency level in Task02."@en .

ontoksd:PL_Task02_Advanced a ontoksd:ProficiencyLevel ;
    rdfs:label "Advanced"@en ;
    dcterms:identifier "Task02-PL3"^^xsd:string ;
    ontoksd:hasOrdinalPosition "3"^^xsd:int ;
    rdfs:comment "Proficiency level representing performance beyond baseline expectations, including more elaborate or analytically enriched solutions in Task02."@en .

ontoksd:PL_Task02_Competent a ontoksd:ProficiencyLevel ;
    rdfs:label "Competent"@en ;
    dcterms:identifier "Task02-PL2"^^xsd:string ;
    ontoksd:hasOrdinalPosition "2"^^xsd:int ;
    rdfs:comment "Proficiency level representing adequate and coherent performance in the competencies associated with Task02."@en .

ontoksd:PL_Task02_Novice a ontoksd:ProficiencyLevel ;
    rdfs:label "Novice"@en ;
    dcterms:identifier "Task02-PL1"^^xsd:string ;
    ontoksd:hasOrdinalPosition "1"^^xsd:int ;
    rdfs:comment "Proficiency level representing initial or insufficient performance in the competencies associated with Task02."@en .

ontoksd:C05 ontoksd:hasTask ontoksd:Task02_TrafficControl .

ontoksd:C07 ontoksd:hasTask ontoksd:Task02_TrafficControl .

ontoksd:C08 ontoksd:hasTask ontoksd:Task02_TrafficControl .

ontoksd:C09 ontoksd:hasTask ontoksd:Task02_TrafficControl .

