        ontoksd:TCons_Task02_VehicleClassification ;
    ontoksd:hasTaskStatement "Design, simulate, validate, and document a Turing-Machine-based computational solution capable of processing sensor data, classifying vehicles into light, heavy, and very heavy categories, counting category frequencies from the previous night, and identifying the most frequent category."@en ;
    ontoksd:isTaskOf ontoksd:C05,
