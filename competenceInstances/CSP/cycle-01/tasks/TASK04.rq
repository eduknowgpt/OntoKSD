ontoksd:PS_Task04_ProficiencyScheme a ontoksd:ProficiencyScheme ;
    rdfs:label "Task04 proficiency scheme"@en ;
    dcterms:identifier "Task04-PS"^^xsd:string ;
    ontoksd:definesInterval ontoksd:Interval_Task04_Advanced,
        ontoksd:Interval_Task04_Competent,
        ontoksd:Interval_Task04_Novice ;
    ontoksd:definesLevel ontoksd:PL_Task04_Advanced,
        ontoksd:PL_Task04_Competent,
        ontoksd:PL_Task04_Novice ;
    ontoksd:usesScale ontoksd:Scale_Task04_0_10 ;
    rdfs:comment "Proficiency scheme associated with Task04, defining how intervals in the numeric scale are interpreted as proficiency levels."@en ;
    skos:scopeNote "Specification-level interpretive assumption recorded in the CSP report, not an observed result or a grading rule contained in the original task statement. The assessment references this planned scheme documentarily; usesProficiencyScheme is reserved for AssessmentOccurrence."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task04-TheReturnFarmingRobot/Task04-CSP-Report.md> .

ontoksd:Scale_Task04_0_10 a ontoksd:Scale ;
    rdfs:label "Task04 proficiency scale 0–10"@en ;
    dcterms:identifier "Task04-SCALE"^^xsd:string ;
    ontoksd:hasInterval ontoksd:Interval_Task04_Advanced,
        ontoksd:Interval_Task04_Competent,
        ontoksd:Interval_Task04_Novice ;
    ontoksd:maxValue 10.0 ;
    ontoksd:minValue 0.0 ;
    ontoksd:step 0.1 ;
    rdfs:comment "Decimal scoring range from 0 to 10 with a selected granularity of 0.1. For Task04, the reported 5.1/9.1 starts are interpreted on this one-decimal domain. Numeric validation of step adherence is external to OWL."@en .

ontoksd:AS_Task04_ReturnFarmerRobot a ontoksd:Assessment ;
    rdfs:label "Assessment — Task04 Return of the Farmer Robot"@en ;
    dcterms:description "Assessment specification based on Task04, intended to evaluate learners through the submitted Pushdown Automaton artifact, rule-based notation, simulation-supported validation, and technical report."@en ;
    dcterms:identifier "Task04-AS"^^xsd:string ;
    dcterms:references ontoksd:PS_Task04_ProficiencyScheme ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task04_ReturnFarmerRobot ;
    ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType,
        ontoksd:WrittenAssessmentModalityType ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task04_C03,
        ontoksd:CA_Task04_C05,
        ontoksd:CA_Task04_C12,
        ontoksd:CA_Task04_C13,
        ontoksd:CA_Task04_C14 ;
    ontoksd:hasInstructionalStatement "Assess the submitted model, technical report and documented PBL process against the task requirements. Individual participation is an assessment design concern; this specification does not assert an assessment occurrence or an individual result."@en ;
    ontoksd:isBasedOnActivity ontoksd:LT_Task04_ReturnFarmerRobot ;
