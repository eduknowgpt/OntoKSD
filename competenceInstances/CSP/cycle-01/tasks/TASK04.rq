ontoksd:LT_Task04_ReturnFarmerRobot a ontoksd:LearningTask ;
    rdfs:label "Learning Task — The Return of the Farmer Robot"@en ;
    dcterms:description "Concrete instructional unit in which learners analyze navigation requirements, model a Pushdown Automaton with stack-based memory, interpret or define rule-based notation for location sequences, test the model in JFLAP, and document the result."@en ;
    dcterms:identifier "Task04-LT"^^xsd:string ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task04_ReturnFarmerRobot ;
