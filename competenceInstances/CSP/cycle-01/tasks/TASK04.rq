ontoksd:ER_Task04_Logbook a ontoksd:EducationalResource ;
    rdfs:label "Task04 logbook"@en ;
    dcterms:description "Shared document used to record progress, meeting notes, decisions, and challenges encountered during the task."@en ;
    dcterms:identifier "Task04-ER4"^^xsd:string ;
    ontoksd:intendedUse "Traceability of collaborative work and process recording."^^xsd:string ;
    rdfs:comment "Educational resource used to maintain traceability of the development process and collaborative work performed during Task04."@en .

ontoksd:ER_Task04_PBLWhiteboard a ontoksd:EducationalResource ;
    rdfs:label "PBL whiteboard"@en ;
    dcterms:description "Collaborative whiteboard used to document questions, facts, ideas or hypotheses, and actions throughout the PBL process."@en ;
    dcterms:identifier "Task04-ER3"^^xsd:string ;
    ontoksd:intendedUse "Process documentation and collaborative reasoning support."^^xsd:string ;
    rdfs:comment "Educational resource used to structure and document collaborative reasoning during the development of the solution."@en .

ontoksd:TA_Task04_ModelAndValidatePDANavigation a ontoksd:TaskActivity ;
    rdfs:label "Model, simulate, validate, and document a return-navigation solution using Pushdown Automata"@en ;
    rdfs:comment "Core task activity of Task04. It represents the central activity through which learners analyze navigation requirements, model a Pushdown Automaton with stack-based memory, interpret or define rule-based notation for location sequences, validate the solution through simulation, and document the resulting design."@en .

ontoksd:TC_Task04_ModuleIntegrationAnalysis a ontoksd:TaskComponent ;
    rdfs:label "Module integration or parallel-operation analysis"@en ;
    rdfs:comment "Task component representing the analysis of whether the navigation module should extend the food-delivery module or operate in parallel with inter-module communication."@en .

ontoksd:TC_Task04_NavigationModule a ontoksd:TaskComponent ;
    rdfs:label "Robot return-navigation module"@en ;
    rdfs:comment "Task component representing the computational module responsible for guiding the robot back to its starting point."@en .

ontoksd:TC_Task04_PDAArtifact a ontoksd:TaskComponent ;
    rdfs:label "Pushdown Automaton artifact"@en ;
    rdfs:comment "Task component representing the formal Pushdown Automaton model of the robot navigation module."@en .

ontoksd:TC_Task04_RuleBasedNotation a ontoksd:TaskComponent ;
    rdfs:label "Rule-based notation for location sequences"@en ;
    rdfs:comment "Task component representing formal notation, such as grammars or transition rules, used to specify valid location sequences and navigation behavior."@en .

ontoksd:TC_Task04_TechnicalReport a ontoksd:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Task component representing the structured report required to explain design decisions, formal notation, stack behavior, and examples of operation."@en .

ontoksd:TCons_Task04_FoodDeliveryModuleIntegration a ontoksd:TaskConstraint ;
    rdfs:label "Consider extension or parallel operation with the food-delivery module"@en ;
    rdfs:comment "Constraint stating that the solution should analyze whether the navigation module extends the previous food-delivery module or operates in parallel with it."@en .

ontoksd:TCons_Task04_PathReversal a ontoksd:TaskConstraint ;
    rdfs:label "Support reversal of the navigation path"@en ;
    rdfs:comment "Constraint stating that the module must support reverse navigation based on previously recorded path information."@en .

ontoksd:TCons_Task04_ProcessDocumentation a ontoksd:TaskConstraint ;
    rdfs:label "Document the process through whiteboard and logbook"@en ;
    rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

ontoksd:TCons_Task04_ReturnToOrigin a ontoksd:TaskConstraint ;
    rdfs:label "Return the robot to its starting point"@en ;
    rdfs:comment "Constraint stating that the solution must enable the robot to return to its initial location after completing the outbound task."@en .

ontoksd:TCons_Task04_RuleNotationSupport a ontoksd:TaskConstraint ;
    rdfs:label "Support formal rule-based notation for location sequences"@en ;
    rdfs:comment "Constraint stating that the solution should support or interpret rule-based notation for generating and documenting location sequences."@en .

ontoksd:TCons_Task04_SimulatorExecution a ontoksd:TaskConstraint ;
    rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
    rdfs:comment "Constraint stating that the Pushdown Automaton artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

ontoksd:TCons_Task04_StackBasedMemory a ontoksd:TaskConstraint ;
    rdfs:label "Use stack-based memory"@en ;
    rdfs:comment "Constraint stating that the solution must rely on auxiliary memory to support path tracking and return behavior."@en .

ontoksd:AC_Task04_ReturnFarmerRobot a ontoksd:AcquisitionContext ;
    rdfs:label "Task04 Acquisition Context — The Return of the Farmer Robot"@en ;
    dcterms:identifier "Task04-AC"^^xsd:string ;
    rdfs:comment "Acquisition context associated with Task04. It represents the pedagogical setting in which learners engage in a problem-based learning activity focused on the modeling, simulation, analysis, and documentation of a robot navigation module based on Pushdown Automata and context-free formalisms. This context includes collaborative work, use of JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

ontoksd:ER_Task04_JFLAP a ontoksd:EducationalResource ;
    rdfs:label "JFLAP simulator"@en ;
    dcterms:description "Simulation environment used to test, inspect, and validate Pushdown Automaton behavior."@en ;
    dcterms:identifier "Task04-ER2"^^xsd:string ;
    ontoksd:intendedUse "Simulation, execution, debugging, and validation of PDA artifacts."^^xsd:string ;
    rdfs:comment "Educational resource corresponding to the simulator used for operational validation of PDA models developed in Task04."@en .

ontoksd:ER_Task04_ProblemStatement a ontoksd:EducationalResource ;
    rdfs:label "Task04 problem statement"@en ;
    dcterms:description "Problem statement describing the Return of the Farmer Robot scenario, its requirements, and expected deliverables."@en ;
    dcterms:identifier "Task04-ER1"^^xsd:string ;
    ontoksd:intendedUse "Instructional framing and requirement interpretation for the learning task and the assessment."^^xsd:string ;
    rdfs:comment "Educational resource corresponding to the formal statement of Task04. It frames the problem, constraints, and deliverables guiding both instructional execution and assessment."@en .

ontoksd:ER_Task04_SBCReportTemplate a ontoksd:EducationalResource ;
    rdfs:label "SBC article-format report template"@en ;
    dcterms:description "Template or normative reference for preparing the technical report required as a deliverable."@en ;
    dcterms:identifier "Task04-ER5"^^xsd:string ;
    ontoksd:intendedUse "Support for technical writing and report standardization."^^xsd:string ;
    rdfs:comment "Educational resource supporting the preparation and standardization of the technical report associated with Task04."@en .

ontoksd:Interval_Task04_Advanced a ontoksd:ScaleInterval ;
    rdfs:label "Task04 interval — Advanced"@en ;
    ontoksd:correspondsToLevel ontoksd:PL_Task04_Advanced ;
    ontoksd:includesLower false ;
    ontoksd:includesUpper true ;
    ontoksd:intervalDefinedInScheme ontoksd:PS_Task04_ProficiencyScheme ;
    ontoksd:isIntervalOf ontoksd:Scale_Task04_0_10 ;
    ontoksd:lowerBound 9.0 ;
    ontoksd:upperBound 10.0 ;
    rdfs:comment "Interval corresponding to the Advanced proficiency level in Task04."@en .

ontoksd:Interval_Task04_Competent a ontoksd:ScaleInterval ;
    rdfs:label "Task04 interval — Competent"@en ;
    ontoksd:correspondsToLevel ontoksd:PL_Task04_Competent ;
    ontoksd:includesLower false ;
    ontoksd:includesUpper true ;
    ontoksd:intervalDefinedInScheme ontoksd:PS_Task04_ProficiencyScheme ;
    ontoksd:isIntervalOf ontoksd:Scale_Task04_0_10 ;
    ontoksd:lowerBound 5.0 ;
    ontoksd:upperBound 9.0 ;
    rdfs:comment "Interval corresponding to the Competent proficiency level in Task04."@en .

ontoksd:Interval_Task04_Novice a ontoksd:ScaleInterval ;
    rdfs:label "Task04 interval — Novice"@en ;
    ontoksd:correspondsToLevel ontoksd:PL_Task04_Novice ;
    ontoksd:includesLower true ;
    ontoksd:includesUpper true ;
    ontoksd:intervalDefinedInScheme ontoksd:PS_Task04_ProficiencyScheme ;
    ontoksd:isIntervalOf ontoksd:Scale_Task04_0_10 ;
    ontoksd:lowerBound 0.0 ;
    ontoksd:upperBound 5.0 ;
    rdfs:comment "Interval corresponding to the Novice proficiency level in Task04."@en .

ontoksd:PL_Task04_Advanced a ontoksd:ProficiencyLevel ;
    rdfs:label "Advanced"@en ;
    dcterms:identifier "Task04-PL3"^^xsd:string ;
    ontoksd:hasOrdinalPosition "3"^^xsd:int ;
    rdfs:comment "Proficiency level representing structurally stronger or conceptually enriched performance beyond baseline expectations in Task04."@en .

ontoksd:PL_Task04_Competent a ontoksd:ProficiencyLevel ;
    rdfs:label "Competent"@en ;
    dcterms:identifier "Task04-PL2"^^xsd:string ;
    ontoksd:hasOrdinalPosition "2"^^xsd:int ;
    rdfs:comment "Proficiency level representing accurate and coherent performance in the competencies associated with Task04."@en .

ontoksd:PL_Task04_Novice a ontoksd:ProficiencyLevel ;
    rdfs:label "Novice"@en ;
    dcterms:identifier "Task04-PL1"^^xsd:string ;
    ontoksd:hasOrdinalPosition "1"^^xsd:int ;
    rdfs:comment "Proficiency level representing incomplete or incorrect performance in the competencies associated with Task04."@en .

ontoksd:C03 ontoksd:hasTask ontoksd:Task04_ReturnFarmerRobot .

ontoksd:C05 ontoksd:hasTask ontoksd:Task04_ReturnFarmerRobot .

ontoksd:C12 ontoksd:hasTask ontoksd:Task04_ReturnFarmerRobot .

