ontoksd:PL_Task05_Advanced a ontoksd:ProficiencyLevel ;
    rdfs:label "Advanced"@en ;
    dcterms:identifier "Task05-PL3"^^xsd:string ;
    ontoksd:hasOrdinalPosition "3"^^xsd:int ;
    rdfs:comment "Proficiency level representing integrated, analytically justified, or structurally enriched performance beyond baseline expectations in Task05."@en .

ontoksd:PL_Task05_Competent a ontoksd:ProficiencyLevel ;
