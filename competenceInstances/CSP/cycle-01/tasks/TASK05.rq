ontoksd:ER_Task05_Logbook a ontoksd:EducationalResource ;
    rdfs:label "Task05 logbook"@en ;
    dcterms:description "Shared document used to record progress, meeting notes, decisions, and challenges encountered during the task."@en ;
    dcterms:identifier "Task05-ER4"^^xsd:string ;
    ontoksd:intendedUse "Traceability of collaborative work and process recording."^^xsd:string ;
    rdfs:comment "Educational resource used to maintain traceability of the development process and collaborative work performed during Task05."@en .

ontoksd:ER_Task05_PBLWhiteboard a ontoksd:EducationalResource ;
    rdfs:label "PBL whiteboard"@en ;
    dcterms:description "Collaborative whiteboard used to document questions, facts, ideas or hypotheses, and actions throughout the PBL process."@en ;
    dcterms:identifier "Task05-ER3"^^xsd:string ;
    ontoksd:intendedUse "Process documentation and collaborative reasoning support."^^xsd:string ;
    rdfs:comment "Educational resource used to structure and document collaborative reasoning during the development of the solution."@en .

ontoksd:TA_Task05_ModelIntegrateAndValidateTMMultiAgentSystem a ontoksd:TaskActivity ;
    rdfs:label "Model, integrate, simulate, validate, and document a multi-agent system using Turing Machines"@en ;
    rdfs:comment "Core task activity of Task05. It represents the central activity through which learners analyze inter-robot requirements, revise previous modules, design an integrated Turing-Machine-based architecture, simulate the coordinated behavior, and document the resulting system."@en .

ontoksd:TC_Task05_FarmerRobotIdentificationModule a ontoksd:TaskComponent ;
    rdfs:label "Farmer Robot identification and signaling module"@en ;
    rdfs:comment "Task component representing the enhanced Farmer Robot module responsible for herd-related identification and food-delivery signaling, including threshold input logic."@en .

ontoksd:TC_Task05_FarmerRobotNavigationModule a ontoksd:TaskComponent ;
    rdfs:label "Farmer Robot navigation module"@en ;
    rdfs:comment "Task component representing the Farmer Robot navigation behavior within the integrated system."@en .

ontoksd:TC_Task05_FeederRobotNavigationModule a ontoksd:TaskComponent ;
    rdfs:label "Feeder Robot navigation module"@en ;
    rdfs:comment "Task component representing the Feeder Robot navigation behavior driven by communicated path information."@en .

ontoksd:TC_Task05_IntegratedTuringMachineArtifact a ontoksd:TaskComponent ;
    rdfs:label "Integrated Turing Machine artifact"@en ;
    rdfs:comment "Task component representing the unified Turing-Machine-based computational artifact covering integrated multi-agent behavior."@en .

ontoksd:TC_Task05_PathEncodingAndCommunication a ontoksd:TaskComponent ;
    rdfs:label "Path encoding and inter-robot communication"@en ;
    rdfs:comment "Task component representing the encoding and communication of path information from the Farmer Robot to the Feeder Robot."@en .

ontoksd:TC_Task05_TechnicalReport a ontoksd:TaskComponent ;
    rdfs:label "Technical report"@en ;
    rdfs:comment "Task component representing the structured technical report required to explain module interaction, tape and state design, coordination logic, and justification of design choices."@en .

ontoksd:TCons_Task05_CommunicatePathToFeederRobot a ontoksd:TaskConstraint ;
    rdfs:label "Communicate the path to the Feeder Robot"@en ;
    rdfs:comment "Constraint stating that the Farmer Robot must communicate the path that the Feeder Robot should follow."@en .

ontoksd:TCons_Task05_CoordinateMultipleAgents a ontoksd:TaskConstraint ;
    rdfs:label "Coordinate Farmer Robot and Feeder Robot behaviors"@en ;
    rdfs:comment "Constraint stating that the solution must coordinate the behavior of two interacting robotic agents."@en .

ontoksd:TCons_Task05_ProcessDocumentation a ontoksd:TaskConstraint ;
    rdfs:label "Document the process through whiteboard and logbook"@en ;
    rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

ontoksd:TCons_Task05_ReviseHerdThresholdInput a ontoksd:TaskConstraint ;
    rdfs:label "Allow herd-threshold quantities as input"@en ;
    rdfs:comment "Constraint stating that the previous signaling logic must be revised so that minimum herd quantities can be provided as machine inputs."@en .

ontoksd:TCons_Task05_SimulatorExecution a ontoksd:TaskConstraint ;
    rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
    rdfs:comment "Constraint stating that the integrated Turing Machine artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

ontoksd:TCons_Task05_StandardizeDocumentationAndTraining a ontoksd:TaskConstraint ;
    rdfs:label "Support standardization of documentation and training"@en ;
    rdfs:comment "Constraint stating that the solution should support standardization goals related to system documentation and maintenance-team training."@en .

ontoksd:TCons_Task05_UseUnifiedTuringMachineFormalism a ontoksd:TaskConstraint ;
    rdfs:label "Use a unified Turing Machine formalism"@en ;
    rdfs:comment "Constraint stating that the same abstract machine model must be used to implement the integrated robot modules."@en .

ontoksd:AC_Task05_FarmerRobotAndFeederRobot a ontoksd:AcquisitionContext ;
    rdfs:label "Task05 Acquisition Context — The Farmer Robot and the Feeder Robot"@en ;
    dcterms:identifier "Task05-AC"^^xsd:string ;
    rdfs:comment "Acquisition context associated with Task05. It represents the pedagogical setting in which learners engage in a problem-based learning activity focused on the integrated modeling, simulation, coordination, and documentation of Farmer Robot and Feeder Robot modules using Turing Machines as a unified formalism. This context includes collaborative work, use of JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

ontoksd:ER_Task05_JFLAP a ontoksd:EducationalResource ;
    rdfs:label "JFLAP simulator"@en ;
    dcterms:description "Simulation environment used to test, inspect, and validate Turing Machine behavior."@en ;
    dcterms:identifier "Task05-ER2"^^xsd:string ;
    ontoksd:intendedUse "Simulation, execution, debugging, and validation of Turing Machine artifacts."^^xsd:string ;
    rdfs:comment "Educational resource corresponding to the simulator used for operational validation of integrated Turing-Machine models developed in Task05."@en .

ontoksd:ER_Task05_ProblemStatement a ontoksd:EducationalResource ;
    rdfs:label "Task05 problem statement"@en ;
    dcterms:description "Problem statement describing the Farmer Robot and the Feeder Robot scenario, its requirements, and expected deliverables."@en ;
    dcterms:identifier "Task05-ER1"^^xsd:string ;
    ontoksd:intendedUse "Instructional framing and requirement interpretation for the learning task and the assessment."^^xsd:string ;
    rdfs:comment "Educational resource corresponding to the formal statement of Task05. It frames the problem, constraints, and deliverables guiding both instructional execution and assessment."@en .

ontoksd:ER_Task05_SBCReportTemplate a ontoksd:EducationalResource ;
    rdfs:label "SBC article-format report template"@en ;
    dcterms:description "Template or normative reference for preparing the technical report required as a deliverable."@en ;
    dcterms:identifier "Task05-ER5"^^xsd:string ;
    ontoksd:intendedUse "Support for technical writing and report standardization."^^xsd:string ;
    rdfs:comment "Educational resource supporting the preparation and standardization of the technical report associated with Task05."@en .

