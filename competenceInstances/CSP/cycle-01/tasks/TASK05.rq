ontoksd:PS_Task05_ProficiencyScheme a ontoksd:ProficiencyScheme ;
    rdfs:label "Task05 proficiency scheme"@en ;
    dcterms:identifier "Task05-PS"^^xsd:string ;
    ontoksd:definesInterval ontoksd:Interval_Task05_Advanced,
        ontoksd:Interval_Task05_Competent,
        ontoksd:Interval_Task05_Novice ;
    ontoksd:definesLevel ontoksd:PL_Task05_Advanced,
        ontoksd:PL_Task05_Competent,
        ontoksd:PL_Task05_Novice ;
    ontoksd:usesScale ontoksd:Scale_Task05_0_10 ;
    rdfs:comment "Proficiency scheme associated with Task05, defining how intervals in the numeric scale are interpreted as proficiency levels."@en ;
    skos:scopeNote "Specification-level interpretive assumption recorded in the CSP report, not an observed result or a grading rule contained in the original task statement. The assessment references this planned scheme documentarily; usesProficiencyScheme is reserved for AssessmentOccurrence."@en ;
    prov:wasDerivedFrom <http://purl.org/ontoksd/source/csp/cycle-01/Task05-TheFarmingRobotAndFeedingRobot/Task05-CSP-Report.md> .

ontoksd:Scale_Task05_0_10 a ontoksd:Scale ;
    rdfs:label "Task05 proficiency scale 0–10"@en ;
    dcterms:identifier "Task05-SCALE"^^xsd:string ;
    ontoksd:hasInterval ontoksd:Interval_Task05_Advanced,
        ontoksd:Interval_Task05_Competent,
        ontoksd:Interval_Task05_Novice ;
    ontoksd:maxValue 10.0 ;
    ontoksd:minValue 0.0 ;
    ontoksd:step 0.1 ;
    rdfs:comment "Decimal scoring range from 0 to 10 with a selected granularity of 0.1. For Task04, the reported 5.1/9.1 starts are interpreted on this one-decimal domain. Numeric validation of step adherence is external to OWL."@en .

