    rdfs:label "estimate"@en .

ontoksd:TA_Task201_model a ontoksd:TaskActivity ;
    rdfs:label "model"@en .

ontoksd:TA_Task201_simulate a ontoksd:TaskActivity ;
    rdfs:label "simulate"@en .

ontoksd:TA_Task201_validate a ontoksd:TaskActivity ;
    rdfs:label "validate"@en .

ontoksd:TC_Task201_1 a ontoksd:TaskComponent ;
    rdfs:label "Drone surveillance module"@en .

ontoksd:TC_Task201_2 a ontoksd:TaskComponent ;
    rdfs:label "Finite-state representation"@en .

ontoksd:TC_Task201_3 a ontoksd:TaskComponent ;
    rdfs:label "State/transition estimation rule"@en .

ontoksd:TCons_Task201_1 a ontoksd:TaskConstraint ;
    rdfs:label "Represent deforestation, river siltation and fires, including sensing, transmission and base-issued control commands."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .

ontoksd:TCons_Task201_2 a ontoksd:TaskConstraint ;
    rdfs:label "Preserve transmitted geolocation, altitude, speed, barometric and temperature information; account for the specified photo/video and repositioning controls."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .

ontoksd:TCons_Task201_3 a ontoksd:TaskConstraint ;
    rdfs:label "Investigate state/transition estimation as part of the expected work, not only as an Advanced-level bonus."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .

ontoksd:TCons_Task201_4 a ontoksd:TaskConstraint ;
    rdfs:label "Provide a JFLAP model and an SBC-format report with at least two execution examples and the requested documentation and budgeting discussion."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .

ontoksd:AC_Task201 a ontoksd:AcquisitionContext ;
    rdfs:label "Surveillance Drone Prototype pedagogical setting"@en ;
    dcterms:identifier "Task201-AcquisitionContext" ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .

ontoksd:Interval_Task201_Advanced a ontoksd:ScaleInterval ;
    ontoksd:correspondsToLevel ontoksd:PL_Task201_Advanced ;
    ontoksd:includesLower false ;
    ontoksd:includesUpper true ;
    ontoksd:isIntervalOf ontoksd:Scale_Task201_0_10 ;
    ontoksd:lowerBound 9.0 ;
    ontoksd:upperBound 10.0 .

ontoksd:Interval_Task201_Competent a ontoksd:ScaleInterval ;
    ontoksd:correspondsToLevel ontoksd:PL_Task201_Competent ;
    ontoksd:includesLower false ;
    ontoksd:includesUpper true ;
    ontoksd:isIntervalOf ontoksd:Scale_Task201_0_10 ;
    ontoksd:lowerBound 5.0 ;
    ontoksd:upperBound 9.0 .

ontoksd:Interval_Task201_Novice a ontoksd:ScaleInterval ;
    ontoksd:correspondsToLevel ontoksd:PL_Task201_Novice ;
    ontoksd:includesLower true ;
    ontoksd:includesUpper true ;
    ontoksd:isIntervalOf ontoksd:Scale_Task201_0_10 ;
    ontoksd:lowerBound 0.0 ;
    ontoksd:upperBound 5.0 .

ontoksd:PL_Task201_Advanced a ontoksd:ProficiencyLevel ;
    rdfs:label "Advanced"@en ;
    ontoksd:hasOrdinalPosition "3"^^xsd:int .

ontoksd:PL_Task201_Competent a ontoksd:ProficiencyLevel ;
    rdfs:label "Competent"@en ;
    ontoksd:hasOrdinalPosition "2"^^xsd:int .

ontoksd:PL_Task201_Novice a ontoksd:ProficiencyLevel ;
    rdfs:label "Novice"@en ;
    ontoksd:hasOrdinalPosition "1"^^xsd:int .

ontoksd:C02 ontoksd:hasTask ontoksd:Task201_Reference .

ontoksd:C03 ontoksd:hasTask ontoksd:Task201_Reference .

ontoksd:C04 ontoksd:hasTask ontoksd:Task201_Reference .

