ontoksd:C11 ontoksd:hasTask ontoksd:Task201_Reference .

ontoksd:Scale_Task201_0_10 a ontoksd:Scale ;
    ontoksd:hasInterval ontoksd:Interval_Task201_Advanced,
        ontoksd:Interval_Task201_Competent,
        ontoksd:Interval_Task201_Novice ;
    ontoksd:maxValue 10.0 ;
    ontoksd:minValue 0.0 .

ontoksd:AS_Task201 a ontoksd:Assessment ;
    rdfs:label "Surveillance Drone Prototype assessment specification"@en ;
    dcterms:identifier "Task201-Assessment" ;
    dcterms:references ontoksd:PS_Task201 ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task201 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task201_C02_Assessment,
        ontoksd:CA_Task201_C03_Assessment,
        ontoksd:CA_Task201_C04_Assessment,
        ontoksd:CA_Task201_C05_Assessment,
        ontoksd:CA_Task201_C06_Assessment,
        ontoksd:CA_Task201_C11_Assessment ;
    ontoksd:hasInstructionalStatement "Interpret the submitted report, model and documented reasoning against the task requirements and the adjusted activation configuration. No actual assessment event, score, evidence production or individual attainment is asserted."@en ;
    ontoksd:isBasedOnActivity ontoksd:LT_Task201 ;
    ontoksd:usesResource ontoksd:CSPResource_JFLAP,
        ontoksd:CSPResource_SBC ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .

ontoksd:Task201_Reference a ontoksd:Task ;
    rdfs:label "Surveillance Drone Prototype reference performance"@en ;
    dcterms:identifier "Task201-Task" ;
    ontoksd:hasTaskActivity ontoksd:TA_Task201_document,
        ontoksd:TA_Task201_estimate,
        ontoksd:TA_Task201_model,
        ontoksd:TA_Task201_simulate,
        ontoksd:TA_Task201_validate ;
    ontoksd:hasTaskComponent ontoksd:TC_Task201_1,
        ontoksd:TC_Task201_2,
        ontoksd:TC_Task201_3 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task201_1,
        ontoksd:TCons_Task201_2,
        ontoksd:TCons_Task201_3,
        ontoksd:TCons_Task201_4 ;
    ontoksd:hasTaskStatement "Model, simulate and document the surveillance drone module with finite-state machines, and investigate a rule for estimating state and transition requirements from the monitored events."@en ;
    ontoksd:isTaskOf ontoksd:C02,
        ontoksd:C03,
        ontoksd:C04,
        ontoksd:C05,
        ontoksd:C06,
        ontoksd:C11 ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .

ontoksd:LT_Task201 a ontoksd:LearningTask ;
    rdfs:label "Surveillance Drone Prototype learning task"@en ;
    dcterms:identifier "Task201-LearningTask" ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task201 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task201_C02_Learning,
        ontoksd:CA_Task201_C03_Learning,
        ontoksd:CA_Task201_C04_Learning,
        ontoksd:CA_Task201_C05_Learning,
        ontoksd:CA_Task201_C06_Learning,
        ontoksd:CA_Task201_C11_Learning ;
    ontoksd:hasInstructionalStatement "Address symbolic behavior documentation and the estimation of states and transitions required as the monitored event set changes. The adjusted C04 activation does not require a separate regular-expression artifact."@en,
        "Model drone surveillance events and control actions with an FSM; justify the adopted abstraction."@en,
        "Prepare an SBC-format report containing operations, at least two execution examples, and documentation/budgeting analysis."@en,
        "Simulate and validate the FSM with JFLAP across representative scenarios."@en,
        "Use PBL teamwork and document the process with whiteboard updates and a shared logbook."@en ;
    ontoksd:isTeamBased true ;
    ontoksd:usesResource ontoksd:CSPResource_JFLAP,
        ontoksd:CSPResource_Logbook,
        ontoksd:CSPResource_SBC,
        ontoksd:CSPResource_Whiteboard ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-DroneMonitoring.md> .
