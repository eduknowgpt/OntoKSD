ontoksd:PS_Task201 a ontoksd:ProficiencyScheme ;
    ontoksd:definesInterval ontoksd:Interval_Task201_Advanced,
        ontoksd:Interval_Task201_Competent,
        ontoksd:Interval_Task201_Novice ;
    ontoksd:definesLevel ontoksd:PL_Task201_Advanced,
        ontoksd:PL_Task201_Competent,
        ontoksd:PL_Task201_Novice ;
    ontoksd:usesScale ontoksd:Scale_Task201_0_10 ;
    skos:scopeNote "Proficiency specification from the Task201 report only. No step size or learner score is inferred; the Advanced descriptor does not remove structural estimation from minimum task requirements."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/Task201-CSP-Report.md> .

