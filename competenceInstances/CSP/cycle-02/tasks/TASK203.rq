ontoksd:AS_Task203 a ontoksd:Assessment ;
    rdfs:label "Parking Control assessment specification"@en ;
    dcterms:identifier "Task203-Assessment" ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task203 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task203_C05_Assessment,
        ontoksd:CA_Task203_C07_Assessment,
        ontoksd:CA_Task203_C08_Assessment,
        ontoksd:CA_Task203_C09_Assessment,
        ontoksd:CA_Task203_C10_Assessment ;
    ontoksd:hasInstructionalStatement "Interpret the submitted report, model and documented reasoning against the task requirements and the adjusted activation configuration. No actual assessment event, score, evidence production or individual attainment is asserted."@en ;
    ontoksd:isBasedOnActivity ontoksd:LT_Task203 ;
    ontoksd:usesResource ontoksd:CSPResource_JFLAP,
        ontoksd:CSPResource_SBC ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task203-ParkingControl/Task203-ParkingControl.md> .

ontoksd:Task203_Reference a ontoksd:Task ;
    rdfs:label "Parking Control reference performance"@en ;
    dcterms:identifier "Task203-Task" ;
    ontoksd:hasTaskActivity ontoksd:TA_Task203_design,
        ontoksd:TA_Task203_document,
        ontoksd:TA_Task203_implement,
        ontoksd:TA_Task203_justify,
        ontoksd:TA_Task203_simulate ;
    ontoksd:hasTaskComponent ontoksd:TC_Task203_1,
        ontoksd:TC_Task203_2,
        ontoksd:TC_Task203_3 ;
    ontoksd:hasTaskConstraint ontoksd:TCons_Task203_1,
        ontoksd:TCons_Task203_2,
        ontoksd:TCons_Task203_3,
        ontoksd:TCons_Task203_4 ;
    ontoksd:hasTaskStatement "Design, simulate and document the adopted Turing-Machine-based parking control model, updating category occupancy on arrivals/departures and daily denied-request counters while continuing service after rejection."@en ;
    ontoksd:isTaskOf ontoksd:C05,
        ontoksd:C07,
        ontoksd:C08,
        ontoksd:C09,
        ontoksd:C10 ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task203-ParkingControl/Task203-ParkingControl.md> .

ontoksd:LT_Task203 a ontoksd:LearningTask ;
    rdfs:label "Parking Control learning task"@en ;
    dcterms:identifier "Task203-LearningTask" ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task203 ;
    ontoksd:hasCompetenceActivation ontoksd:CA_Task203_C05_Learning,
        ontoksd:CA_Task203_C07_Learning,
        ontoksd:CA_Task203_C08_Learning,
        ontoksd:CA_Task203_C09_Learning,
        ontoksd:CA_Task203_C10_Learning ;
    ontoksd:hasInstructionalStatement "Account for arrivals and departures, freeing occupied spaces on exit."@en,
        "Continue servicing later customers after a rejected request."@en,
        "Develop and simulate the adopted machine model with JFLAP and justify the machine or variant choice."@en,
        "Manage category-specific parking availability for daily users, monthly subscribers and rotating customers."@en,
        "Reject requests when the relevant category has no space; maintain daily denied-request counters independently by category."@en,
        "Submit the machine-model file and an SBC-format report containing operations, examples, daily rejection information and theoretical justification."@en,
        "Use PBL teamwork and document project progress."@en ;
    ontoksd:isTeamBased true ;
    ontoksd:usesResource ontoksd:CSPResource_JFLAP,
        ontoksd:CSPResource_SBC ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task203-ParkingControl/Task203-ParkingControl.md> .
