PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT DISTINCT ?competence ?pair ?knowledge ?level ?verb
WHERE {
 VALUES ?competence { ontoksd:C13_01 ontoksd:C15 ontoksd:C16 }
 ?competence ontoksd:hasKnowledgeSkill ?pair .
 ?pair ontoksd:hasKnowledgeComponent ?knowledge ; ontoksd:hasSkillLevel ?level .
 OPTIONAL { ?pair ontoksd:hasBloomLevelJustificationVerb ?verb }
} ORDER BY ?competence ?pair ?verb
