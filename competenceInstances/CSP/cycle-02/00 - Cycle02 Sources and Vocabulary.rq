ontoksd:Course_FormalLanguagesAndTheoryOfComputation a ontoksd:Course ;
    rdfs:label "Introduction to Formal Languages and Theory of Computation"@en ;
    dcterms:description "Curricular component documented by the UFBA syllabus. The selected cycle-02 instructional units are aggregated here; this does not assert complete course coverage or a semester-specific course offering."@en ;
    ontoksd:hasInstructionalUnit ontoksd:AS_Task201,
        ontoksd:AS_Task202,
        ontoksd:AS_Task203,
        ontoksd:AS_Task204,
        ontoksd:LT_Task201,
        ontoksd:LT_Task202,
        ontoksd:LT_Task203,
        ontoksd:LT_Task204 ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/syllabus/theoryOfComputation.md> .

ontoksd:Knowledge_C13_01_FormalReasoningInComputationTheory a ontoksd:Knowledge ;
    rdfs:label "Formal Reasoning in Computation Theory"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Grammatical derivations, symbolic rules and automaton transitions as a basis for explaining, specifying and checking structured computational behavior."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task202-TeamControl/TASK202-CSP-Adustments.md> .

ontoksd:Knowledge_C15_Computability a ontoksd:Knowledge ;
    rdfs:label "Computability"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Conceptual distinctions among decidable, semi-decidable and undecidable problems, and limits on algorithmic automation."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task204-OnlineJudges/TASK204-CSP-Adjustments.md> .

ontoksd:Knowledge_C15_HaltingProblem a ontoksd:Knowledge ;
    rdfs:label "Halting Problem"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "The impossibility of a general algorithm that decides whether an arbitrary program halts on a given input, and its implications for automated program analysis."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task204-OnlineJudges/TASK204-CSP-Adjustments.md> .

ontoksd:Knowledge_C16_ComputabilityTheory a ontoksd:Knowledge ;
    rdfs:label "Computability Theory"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "Conceptual foundations for interpreting decidability, semi-decidability and computational-system limitations without requiring formal proofs."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task204-OnlineJudges/TASK204-CSP-Adjustments.md> .

ontoksd:Knowledge_C16_UniversalTuringMachine a ontoksd:Knowledge ;
    rdfs:label "Universal Turing Machine"@en ;
    ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
    skos:definition "The conceptual notion of programmable universal computation and simulation of other machines, used as explanatory background for system capabilities and limitations."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task204-OnlineJudges/TASK204-CSP-Adjustments.md> .

ontoksd:amConceptual a ontoksd:ActivationMode,
        owl:NamedIndividual ;
    rdfs:label "conceptual"@en ;
    skos:definition "A contextual activation mode emphasizing interpretation of concepts and symbolic/structural relationships without requiring a separate constructed artifact."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task201-DroneMonitoring/TASK201-CSP-Adjustment.md> .

ontoksd:cspAnalyticalRigor a ontoksd:Disposition ;
    rdfs:label "Analytical Rigor"@en ;
    skos:definition "An orientation toward precision and correctness when interpreting formal grammatical descriptions, as specified for C13.01."@en ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task202-TeamControl/TASK202-CSP-Adustments.md> .

