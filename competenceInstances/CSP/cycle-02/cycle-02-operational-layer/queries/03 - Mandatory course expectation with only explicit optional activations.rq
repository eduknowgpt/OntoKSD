PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?competence
WHERE {
 ?spec a ontoksd:CourseCompetenceSpecification ;
  ontoksd:hasSpecifiedCourse ontoksd:Course_FormalLanguagesAndTheoryOfComputation ;
  ontoksd:hasSpecifiedCompetence ?competence ; ontoksd:isMandatory true .
 ontoksd:Course_FormalLanguagesAndTheoryOfComputation ontoksd:hasInstructionalUnit ?someUnit .
 ?someActivation ontoksd:hasActivationInstructionalUnit ?someUnit ; ontoksd:hasActivationCompetence ?competence ;
  ontoksd:hasActivationConstraint/ontoksd:hasActivationConstraintType ontoksd:acOptional .
 FILTER NOT EXISTS {
  ontoksd:Course_FormalLanguagesAndTheoryOfComputation ontoksd:hasInstructionalUnit ?unit .
  ?activation ontoksd:hasActivationInstructionalUnit ?unit ; ontoksd:hasActivationCompetence ?competence .
  FILTER NOT EXISTS {
   ?activation ontoksd:hasActivationConstraint/ontoksd:hasActivationConstraintType ontoksd:acOptional .
  }
 }
 FILTER NOT EXISTS {
  ontoksd:Course_FormalLanguagesAndTheoryOfComputation ontoksd:hasInstructionalUnit ?otherUnit .
  ?otherActivation ontoksd:hasActivationInstructionalUnit ?otherUnit ;
   ontoksd:hasActivationCompetence ?competence ;
   ontoksd:hasActivationConstraint/ontoksd:hasActivationConstraintType ?otherStatus .
  FILTER(?otherStatus != ontoksd:acOptional)
 }
} ORDER BY ?competence
