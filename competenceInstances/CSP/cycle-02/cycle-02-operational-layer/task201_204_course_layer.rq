ontoksd:Course_FormalLanguagesAndTheoryOfComputation a ontoksd:Course ;
    rdfs:label "Introduction to Formal Languages and Theory of Computation"@en ;
    dcterms:identifier "TOC"^^xsd:string ;
    ontoksd:hasInstructionalUnit ontoksd:AS_Task201,
        ontoksd:AS_Task202,
        ontoksd:AS_Task203,
        ontoksd:AS_Task204,
        ontoksd:LT_Task201,
        ontoksd:LT_Task202,
        ontoksd:LT_Task203,
        ontoksd:LT_Task204 ;
    rdfs:comment "The curricular component already used by the cycle-02 dataset. This optional layer adds the user-defined expectations for the selected competence subset; it does not define a new course offering or establish full curriculum coverage."@en .
