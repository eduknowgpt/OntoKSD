ontoksd:TOC_C02_JustifyUseOfDFA_CourseCompetenceSpecification a ontoksd:CourseCompetenceSpecification ;
    rdfs:label "TOC course specification for C02 - justify use of deterministic finite automata"@en ;
    dcterms:references ontoksd:SecondCycle_ProficiencyScheme ;
    ontoksd:isMandatory true ;
    ontoksd:mediatesCourse ontoksd:Course_FormalLanguagesAndTheoryOfComputation ;
    ontoksd:mediatesCourseCompetence ontoksd:C02 ;
    ontoksd:requiresMinimumProficiencyLevel ontoksd:SecondCycle_CompetentLevel ;
    rdfs:comment "Operational scenario expectation: this competence is mandatory within the selected course scope, with Competent as the minimum expected proficiency under SecondCycle_ProficiencyScheme. It is not a source-derived obligation, an admission prerequisite, a learner result or a course approval rule."@en ;
    prov:wasDerivedFrom ontoksd:SecondCycle_OperationalScenario .

