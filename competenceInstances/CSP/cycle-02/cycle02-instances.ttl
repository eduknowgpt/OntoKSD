ns1:LT_Task204 a ns1:LearningTask ;
    rdfs:label "Online Judges at Logistic Solutions learning task"@en ;
    dcterms:identifier "Task204-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task204 ;
    ns1:hasCompetenceActivation ns1:CA_Task204_C02_Learning,
        ns1:CA_Task204_C03_Learning,
        ns1:CA_Task204_C05_Learning,
        ns1:CA_Task204_C06_Learning,
        ns1:CA_Task204_C14_Learning,
        ns1:CA_Task204_C15_Learning,
        ns1:CA_Task204_C16_Learning ;
    ns1:hasInstructionalStatement "Analyze the TSP scenario and possible causes of TLE outcomes; discuss the computational difficulty without conflating timeouts with undecidability."@en,
        "Construct an FSM for observable AC, WA, TLE, CE and RE outcomes and explain its operation."@en,
        "Explain why no general algorithm can decide termination for every arbitrary program/input and relate this to Online Judge limitations."@en,
        "Implement and simulate the FSM in JFLAP, retaining the task statement objective despite conditional C03 activation metadata."@en,
        "Prepare an SBC-format report with hypotheses, responses to the managers, theoretical explanations, the FSM and concrete examples."@en,
        "Relate model behavior to relevant language/model classifications, retaining the Chomsky-Hierarchy objective despite optional C14 activation metadata."@en,
        "Use collaborative PBL and document progress with whiteboards/diagrams."@en ;
    ns1:isTeamBased true ;
    ns1:usesResource ns1:CSPResource_JFLAP,
        ns1:CSPResource_SBC,
        ns1:CSPResource_Whiteboard ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task204-OnlineJudges/Task204-OnlineJudges.md> .

