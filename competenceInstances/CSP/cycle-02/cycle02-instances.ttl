ns1:LT_Task202 a ns1:LearningTask ;
    rdfs:label "Team Control learning task"@en ;
    dcterms:identifier "Task202-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task202 ;
    ns1:hasCompetenceActivation ns1:CA_Task202_C03_Learning,
        ns1:CA_Task202_C05_Learning,
        ns1:CA_Task202_C12_Learning,
        ns1:CA_Task202_C13_01_Learning,
        ns1:CA_Task202_C14_Learning ;
    ns1:hasInstructionalStatement "Check the event-specific team-composition regulation Vi >= ni * NVi, with ni > 0; issue an alert when it is violated."@en,
        "Consider extension of the surveillance module or communicating parallel modules, and justify representation/design choices."@en,
        "Develop and simulate the memory-based control model in JFLAP, explaining its grammar/PDA relationships and model adequacy."@en,
        "Provide JFLAP modules and an SBC-format report with all operations, at least two examples and the requested documentation and budgeting analysis."@en,
        "Use PBL, whiteboard versions and a shared logbook to document the team process."@en,
        "Use the members location, unique identification and volunteer/non-volunteer signals as model inputs."@en ;
    ns1:isTeamBased true ;
    ns1:usesResource ns1:CSPResource_JFLAP,
        ns1:CSPResource_Logbook,
        ns1:CSPResource_SBC,
        ns1:CSPResource_Whiteboard ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task202-TeamControl/Task202-TeamControl.md> .

ns1:LT_Task203 a ns1:LearningTask ;
    rdfs:label "Parking Control learning task"@en ;
    dcterms:identifier "Task203-LearningTask" ;
    ns1:hasAcquisitionContext ns1:AC_Task203 ;
    ns1:hasCompetenceActivation ns1:CA_Task203_C05_Learning,
        ns1:CA_Task203_C07_Learning,
        ns1:CA_Task203_C08_Learning,
        ns1:CA_Task203_C09_Learning,
        ns1:CA_Task203_C10_Learning ;
    ns1:hasInstructionalStatement "Account for arrivals and departures, freeing occupied spaces on exit."@en,
        "Continue servicing later customers after a rejected request."@en,
        "Develop and simulate the adopted machine model with JFLAP and justify the machine or variant choice."@en,
        "Manage category-specific parking availability for daily users, monthly subscribers and rotating customers."@en,
        "Reject requests when the relevant category has no space; maintain daily denied-request counters independently by category."@en,
        "Submit the machine-model file and an SBC-format report containing operations, examples, daily rejection information and theoretical justification."@en,
        "Use PBL teamwork and document project progress."@en ;
    ns1:isTeamBased true ;
    ns1:usesResource ns1:CSPResource_JFLAP,
        ns1:CSPResource_SBC ;
    prov:wasDerivedFrom <https://github.com/eduknowgpt/OCSP/blob/main/CSP/cycles/cycle-02/en/Task203-ParkingControl/Task203-ParkingControl.md> .

