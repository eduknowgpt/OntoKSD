PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Expected: no rows in the historical layer alone.
SELECT ?judgment ?type WHERE { VALUES ?type { ontoksd:EvidencedCompetence ontoksd:EvidencedCompetenceConstituent } ?judgment a ?type . }
