ontoksd:Task202_HistoricalAcquisitionContext a ontoksd:AcquisitionContext ;
    dcterms:description "Historical tutoring and assessment setting for Task202 in MATC94 in 2022. No exact boundaries, attendance at planned sessions or semester-specific Course identity is inferred."@en .

ontoksd:Task201_G02_ProcessEvidence a ontoksd:Evidence ;
    rdfs:label "Task201 G02 process review evidence"@en ;
    dcterms:description "Evidence view of the historical process assessment. The numeric summary does not assign a score to each Knowledge or Disposition. Supporting documents retain their own origin; an evaluation record does not imply that the reviewed artifact was produced by evaluation."@en,
        "Qualitative process-review evidence concerning knowledge mobilization and dispositions, as clarified by the author. Any numeric summary in a review document or grade spreadsheet is distinct from the textual observations; it is not a constituent-level score. This record references the existing group review document and does not substitute for individual provenance links to the original tutoring-session notes."@en ;
    ontoksd:evidenceBasedOn ontoksd:Task201_ProcessAssessmentOccurrence ;
    ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
    ontoksd:hasSupportDocument ontoksd:Task201_G02_ReviewSource .

