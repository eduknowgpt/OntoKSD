# Historical Task202 records
# Execute this SPARQL Update OR import the equivalent .ttl file.
# Prefixes, values and grouped individuals match the Turtle representation.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {

# Historical learning task
# -----------------------------------------------------------------

ontoksd:Task202_HistoricalLearningTask
    a ontoksd:LearningTask ;
    rdfs:label "Task202 historical team-control learning task"@en ;
    dcterms:relation ontoksd:LT_Task202 ;
    ontoksd:hasAcquisitionContext ontoksd:Task202_HistoricalAcquisitionContext ;
    prov:wasDerivedFrom ontoksd:Task202_HistoricalProblemSource ;
    dcterms:description "Historical 2022 learning-task reference, related to the adjusted CSP planning specification without identity equivalence or automatic inheritance of its competence activations."@en,
        "The historical problem statement requests surveillance and team-control modules, whiteboard process documentation and an explanatory report. The adjusted Task202 planning reference focuses on team control; no identity equivalence is asserted."@en .

# Assessment specifications
# -----------------------------------------------------------------

ontoksd:Task202_FinalAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task202 historical final assessment"@en ;
    dcterms:relation ontoksd:AS_Task202 ;
    ontoksd:isBasedOnActivity ontoksd:Task202_HistoricalLearningTask ;
    dcterms:description "Recorded consolidation of process and product scores using their arithmetic mean; no additional performance observation is implied."@en .

ontoksd:Task202_ProcessAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task202 historical process assessment"@en ;
    dcterms:relation ontoksd:AS_Task202 ;
    ontoksd:isBasedOnActivity ontoksd:Task202_HistoricalLearningTask ;
    dcterms:description "Tutor assessment of knowledge mobilization and dispositions, documented qualitatively and summarized by an official process score."@en .

ontoksd:Task202_ProductAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task202 historical product assessment"@en ;
    dcterms:relation ontoksd:AS_Task202 ;
    ontoksd:isBasedOnActivity ontoksd:Task202_HistoricalLearningTask ;
    dcterms:description "Assessment of submitted artifacts, summarized by an official product score. Review views are distinct from the original artifact production."@en .

ontoksd:Task202_QuestionnaireAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task202 historical questionnaire assessment"@en ;
    dcterms:relation ontoksd:AS_Task202 ;
    ontoksd:isBasedOnActivity ontoksd:Task202_HistoricalLearningTask ;
    dcterms:description "Complementary peer-assessment, self-reported learning and educational-feedback instrument; no numeric competence score is assigned."@en .

# Acquisition context
# -----------------------------------------------------------------

ontoksd:Task202_HistoricalAcquisitionContext
    a ontoksd:AcquisitionContext ;
    dcterms:description "Historical tutoring and assessment setting for Task202 in MATC94 in 2022. No exact boundaries, attendance at planned sessions or semester-specific Course identity is inferred."@en .

