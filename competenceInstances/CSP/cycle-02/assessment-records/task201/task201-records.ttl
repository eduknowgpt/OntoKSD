@prefix ontoksd: <http://purl.org/ontoksd#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Historical learning task
# -----------------------------------------------------------------

ontoksd:Task201_DroneMonitoring
    a ontoksd:LearningTask ;
    rdfs:label "Task201 – Drone Monitoring"@en ;
    dcterms:identifier "Task201"^^xsd:string ;
    dcterms:relation ontoksd:LT_Task201 ;
    ontoksd:hasAcquisitionContext ontoksd:Task201_HistoricalAcquisitionContext ;
    dcterms:description "Historical instructional reference retained separately from the adjusted CSP planning specification; no identity equivalence is asserted."@en .

# Assessment specifications
# -----------------------------------------------------------------

ontoksd:Task201_GroupAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task201 official group assessment"@en ;
    dcterms:identifier "Task201-OfficialAssessment"^^xsd:string ;
    dcterms:relation ontoksd:AS_Task201 ;
    ontoksd:isBasedOnActivity ontoksd:Task201_DroneMonitoring ;
    dcterms:description "Historical final task-result consolidation. The official score is the arithmetic mean of process and product scores. This consolidation is not a third independent observation of competence."@en .

ontoksd:Task201_ProcessAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task201 historical process assessment"@en ;
    dcterms:relation ontoksd:AS_Task201 ;
    ontoksd:isBasedOnActivity ontoksd:Task201_DroneMonitoring ;
    dcterms:description "Qualitative tutoring observations summarized numerically."@en .

ontoksd:Task201_ProductAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task201 historical product assessment"@en ;
    dcterms:relation ontoksd:AS_Task201 ;
    ontoksd:isBasedOnActivity ontoksd:Task201_DroneMonitoring ;
    dcterms:description "Evaluation of submitted artifacts, summarized numerically."@en .

ontoksd:Task201_SelfAssessment
    a ontoksd:Assessment ;
    rdfs:label "Task201 complementary individual questionnaire"@en ;
    dcterms:identifier "Task201-SelfAssessment"^^xsd:string ;
    dcterms:relation ontoksd:AS_Task201 ;
    ontoksd:isBasedOnActivity ontoksd:Task201_DroneMonitoring ;
    dcterms:description "Historical questionnaire combining peer assessment, self-reported learning and feedback about the problem and tutoring; it is not a constituent-level competence judgment."@en .

# Acquisition context
# -----------------------------------------------------------------

ontoksd:Task201_HistoricalAcquisitionContext
    a ontoksd:AcquisitionContext ;
    dcterms:description "Historical tutoring and assessment setting for Task201 in MATC94 in 2022. No exact boundaries, attendance at planned sessions or semester-specific Course identity is inferred."@en .

# Assessment occurrences
# -----------------------------------------------------------------

ontoksd:Task201_GroupAssessmentOccurrence
    a ontoksd:AssessmentOccurrence ;
    ontoksd:occursInAcquisitionContext ontoksd:Task201_HistoricalAcquisitionContext ;
    ontoksd:realizes ontoksd:Task201_GroupAssessment ;
    dcterms:description "Historical aggregate assessment occurrence reconstructed from the legacy records. No common synchronous session date is inferred."@en .

