ontoksd:Task201_G01_ProcessEvidence
    a ontoksd:Evidence ;
    rdfs:label "Task201 G01 process review evidence"@en ;
    ontoksd:evidenceBasedOn ontoksd:Task201_ProcessAssessmentOccurrence ;
    ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
    ontoksd:hasSupportDocument ontoksd:Task201_G01_ReviewSource ;
