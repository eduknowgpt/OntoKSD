# Read-only historical assessment check. Task-level scores do not establish competence attainment.
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?participation ?learner ?score WHERE { ?participation ontoksd:occursInAssessmentOccurrence ontoksd:Task201_GroupAssessmentOccurrence ; ontoksd:hasLearner ?learner ; ontoksd:hasScore ?score . } ORDER BY ?learner
