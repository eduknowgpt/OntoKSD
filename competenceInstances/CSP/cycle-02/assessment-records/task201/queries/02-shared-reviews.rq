# Read-only historical assessment check. Task-level scores do not establish competence attainment.
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?evidence ?dimension ?document WHERE { VALUES (?occurrence ?dimension) { (ontoksd:Task201_ProcessAssessmentOccurrence "process") (ontoksd:Task201_ProductAssessmentOccurrence "product") } ?evidence ontoksd:evidenceBasedOn ?occurrence ; ontoksd:hasSupportDocument ?document . } ORDER BY ?dimension ?evidence ?document
