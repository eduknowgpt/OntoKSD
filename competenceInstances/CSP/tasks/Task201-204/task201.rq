PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {

  #################################################################
  # Task201 materialization (anonymized learners)
  # Official scores come from the institutional grade CSV.
  # Group composition and qualitative process/product analyses come
  # from the PBL 01 group review text file.
  # Self-assessment evidence is represented only as complementary
  # individual evidence, without projecting questionnaire items into
  # constituent-level knowledge/disposition records, because the
  # provided files do not state an explicit item-to-constituent map.
  # Proficiency intervals below are an operational assumption for
  # Shared second-cycle scheme: [0.0,6.0) Novice; [6.0,9.0) Competent; [9.0,10.0] Advanced.
  #################################################################

  #################################################################
  # Evidence Type
  # Defines the types of evidence used in Task201. In this file,
  # instructor reviews are split into process-oriented and
  # product-oriented evidence to preserve the two assessment
  # dimensions described in the source material.
  #################################################################

  ontoksd:InstructorProcessReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Process Review"@en .

  ontoksd:InstructorProductReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Product Review"@en .

  #################################################################
  # Shared Proficiency Scheme Reference
  # This task reuses the shared second-cycle proficiency scheme
  # defined externally in the companion insert file.
  #################################################################

  #################################################################
  # Learning Task
  # Materializes Task201 as the instructional entity that grounds
  # both the official group assessment and the complementary
  # self-assessment modeled below.
  #################################################################

  ontoksd:Task201_DroneMonitoring a ontoksd:LearningTask ;
      rdfs:label "Task201 – Drone Monitoring"@en ;
      dcterms:identifier "Task201"^^xsd:string ;
      rdfs:comment "PBL learning task focused on modeling the surveillance logic of a forest-monitoring drone through Finite State Machines, supported by JFLAP simulation and SBC-style technical documentation."@en .

  #################################################################
  # Assessor
  # Represents the instructional actor responsible for the official
  # assessment participations and the registration of group-derived
  # grades in Task201.
  #################################################################

  ontoksd:Task201_Instructor a ontoksd:Assessor ;
      rdfs:label "Task201 instructor-assessor"@en .

  #################################################################
  # Assessments and Assessment Occurrences
  # Creates the official group assessment and the complementary
  # self-assessment, together with their corresponding occurrences.
  # The official occurrence is used for the group-derived grade
  # recorded for each learner; the self-assessment occurrence is
  # used only as complementary individual evidence.
  #################################################################

  ontoksd:Task201_GroupAssessment a ontoksd:Assessment ;
      rdfs:label "Task201 official group assessment"@en ;
      dcterms:identifier "Task201-OfficialAssessment"^^xsd:string ;
      rdfs:comment "Official task assessment based on two group-level dimensions: process review and product review. The arithmetic mean is then recorded individually for every member of the corresponding group."@en ;
      ontoksd:isBasedOnActivity ontoksd:Task201_DroneMonitoring ;
      ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType .

  ontoksd:Task201_GroupAssessmentOccurrence a ontoksd:AssessmentOccurrence ;
      rdfs:label "Task201 official group assessment occurrence"@en ;
      ontoksd:realizes ontoksd:Task201_GroupAssessment ;
      ontoksd:usesProficiencyScheme ontoksd:SecondCycle_ProficiencyScheme ;
      ontoksd:hasScore "0.0"^^xsd:double .

  ontoksd:Task201_SelfAssessment a ontoksd:Assessment ;
      rdfs:label "Task201 complementary self-assessment"@en ;
      dcterms:identifier "Task201-SelfAssessment"^^xsd:string ;
      rdfs:comment "Complementary self-assessment used to document individual evidence about the learner perspective on participation, learning, and task performance. It does not override the official group-derived grade."@en ;
      ontoksd:isBasedOnActivity ontoksd:Task201_DroneMonitoring ;
      ontoksd:hasAssessmentTypeConcept ontoksd:SelfAssessmentAgentType .

  ontoksd:Task201_SelfAssessmentOccurrence a ontoksd:AssessmentOccurrence ;
      rdfs:label "Task201 self-assessment occurrence"@en ;
      ontoksd:realizes ontoksd:Task201_SelfAssessment ;
      ontoksd:usesProficiencyScheme ontoksd:SecondCycle_ProficiencyScheme ;
      ontoksd:hasScore "0.0"^^xsd:double .

  #################################################################
  # Competence Relators / Activation Records
  # Registers how the reused competencies are activated in Task201,
  # including their instructional role, activation function, and
  # activation modes identified in the CSP and CSRP reports.
  #################################################################

  ontoksd:Task201_C06Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task201_DroneMonitoring ;
      ontoksd:mediatesCompetence ontoksd:C06 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amConstructive , ontoksd:amAnalytical .

  ontoksd:Task201_C02Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task201_DroneMonitoring ;
      ontoksd:mediatesCompetence ontoksd:C02 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amJustificatory , ontoksd:amAnalytical .

  ontoksd:Task201_C03Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task201_DroneMonitoring ;
      ontoksd:mediatesCompetence ontoksd:C03 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented .

  ontoksd:Task201_C04Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task201_DroneMonitoring ;
      ontoksd:mediatesCompetence ontoksd:C04 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical .

  ontoksd:Task201_C05Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task201_DroneMonitoring ;
      ontoksd:mediatesCompetence ontoksd:C05 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arTransversal ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented , ontoksd:amJustificatory .

  ontoksd:Task201_C11Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task201_DroneMonitoring ;
      ontoksd:mediatesCompetence ontoksd:C11 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical .

  ontoksd:Task201_DroneMonitoring
      ontoksd:hasCompetenceRelator ontoksd:Task201_C06Activation , ontoksd:Task201_C02Activation , ontoksd:Task201_C03Activation , ontoksd:Task201_C04Activation , ontoksd:Task201_C05Activation , ontoksd:Task201_C11Activation .

  #################################################################
  # Group-Level Review Documents and Shared Evidence
  # For each group, the official instructor review is represented
  # through two support documents and two shared evidence records:
  # one for the development process and one for the produced
  # artifact(s). These evidence instances are reused by all
  # learners belonging to the same group.
  #################################################################

  #################################################################
  # Group G01 - Shared review documents and evidence
  #################################################################

  ontoksd:Task201_G01_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G01 process review document"@en ;
      rdfs:comment "Low tutorial participation; the team initially over-focused on the physical drone instead of state-based logic; documentation did not adequately follow the SBC format."@en .

  ontoksd:Task201_G01_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G01 product review document"@en ;
      rdfs:comment "The final product lacked adequate formal explanation of the automaton, examples, tests, and a regular expression; the delivered solution remained underexplained."@en .

  ontoksd:Task201_G01_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G01 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G01_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G01_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G01 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G01_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .


  #################################################################
  # Group G02 - Shared review documents and evidence
  #################################################################

  ontoksd:Task201_G02_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G02 process review document"@en ;
      rdfs:comment "Slow progress across tutorials; the team reached the final stage with an incipient solution and limited documentation of incremental development."@en .

  ontoksd:Task201_G02_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G02 product review document"@en ;
      rdfs:comment "The product remained superficial, with weak requirements treatment, no clear transition logic, and no regular expression."@en .

  ontoksd:Task201_G02_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G02 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G02_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G02_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G02 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G02_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .


  #################################################################
  # Group G03 - Shared review documents and evidence
  #################################################################

  ontoksd:Task201_G03_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G03 process review document"@en ;
      rdfs:comment "Highly participative group with strong collaborative dynamics and detailed incremental documentation of prototypes and whiteboard evolution."@en .

  ontoksd:Task201_G03_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G03 product review document"@en ;
      rdfs:comment "The product showed strong understanding of automata concepts, clear prototype evolution, and correct tested automata behavior, although no regular expression was delivered."@en .

  ontoksd:Task201_G03_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G03 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G03_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G03_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G03 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G03_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .


  #################################################################
  # Group G04 - Shared review documents and evidence
  #################################################################

  ontoksd:Task201_G04_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G04 process review document"@en ;
      rdfs:comment "Participative and collaborative group with good tutorial discussions, but the delivered document underrepresented the actual incremental process."@en .

  ontoksd:Task201_G04_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G04 product review document"@en ;
      rdfs:comment "The solution appears conceptually sound and detailed at the machine level, but the report insufficiently explains process decisions and some transition constraints."@en .

  ontoksd:Task201_G04_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G04 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G04_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G04_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G04 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G04_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .


  #################################################################
  # Group G05 - Shared review documents and evidence
  #################################################################

  ontoksd:Task201_G05_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G05 process review document"@en ;
      rdfs:comment "Motivated group with clear progress, although the documentation should better detail roles and whiteboard evolution."@en .

  ontoksd:Task201_G05_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G05 product review document"@en ;
      rdfs:comment "The automaton solution is clear and addresses requirements well, but some state descriptions are repetitive and the regular-expression justification remained weak."@en .

  ontoksd:Task201_G05_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G05 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G05_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G05_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G05 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G05_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .


  #################################################################
  # Group G06 - Shared review documents and evidence
  #################################################################

  ontoksd:Task201_G06_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G06 process review document"@en ;
      rdfs:comment "Excellent cooperation and very precise documentation of the incremental process, with strong tutorial engagement."@en .

  ontoksd:Task201_G06_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G06 product review document"@en ;
      rdfs:comment "The final product is clear and well detailed, with correct tested behavior; minor issues concern example detail and presentation, and no regular expression was produced."@en .

  ontoksd:Task201_G06_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G06 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G06_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G06_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G06 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G06_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .


  #################################################################
  # Group G07 - Shared review documents and evidence
  #################################################################

  ontoksd:Task201_G07_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G07 process review document"@en ;
      rdfs:comment "Active and collaborative participation, with evidence of incremental work, although report coherence and integration of figures and tables should improve."@en .

  ontoksd:Task201_G07_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task201 G07 product review document"@en ;
      rdfs:comment "The automaton behaved correctly in the reported tests, but the report should better explain the evolution of the solution and clarify that the regular expression covered only a restricted subset."@en .

  ontoksd:Task201_G07_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G07 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G07_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G07_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task201 G07 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task201_G07_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .


  #################################################################
  # Learner 01 of Group G01
  # Declares the anonymized learner, profile, official assessment
  # participation, evidenced competences derived from the group
  # result, and, when available, complementary self-assessment
  # participation and evidence.
  #################################################################

  ontoksd:Task201_G01_L01 a ontoksd:Learner ;
      rdfs:label "Task201_G01_L01"@en ;
      ontoksd:hasProfile ontoksd:Task201_G01_L01_Profile ;
      ontoksd:participatesIn ontoksd:Task201_G01_L01_OfficialParticipation , ontoksd:Task201_G01_L01_SelfParticipation .

  ontoksd:Task201_G01_L01_Profile a ontoksd:Profile ;
      rdfs:label "Profile of Task201_G01_L01"@en ;
      ontoksd:isProfileOf ontoksd:Task201_G01_L01 ;
      ontoksd:hasEvidencedCompetence ontoksd:Task201_G01_L01_C02_EC , ontoksd:Task201_G01_L01_C03_EC , ontoksd:Task201_G01_L01_C04_EC , ontoksd:Task201_G01_L01_C05_EC , ontoksd:Task201_G01_L01_C06_EC , ontoksd:Task201_G01_L01_C11_EC .

  ontoksd:Task201_G01_L01_OfficialParticipation a ontoksd:AssessmentParticipation ;
      rdfs:label "Official participation of Task201_G01_L01 in Task201"@en ;
      ontoksd:hasAssessor ontoksd:Task201_Instructor ;
      ontoksd:hasLearner ontoksd:Task201_G01_L01 ;
      ontoksd:occursInAssessmentOccurrence ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:hasScore "7.00"^^xsd:double .

  ontoksd:Task201_GroupAssessmentOccurrence
      ontoksd:involvesAssessmentParticipation ontoksd:Task201_G01_L01_OfficialParticipation .

  ontoksd:Task201_G01_L01_C02_EC a ontoksd:EvidencedCompetence ;
      rdfs:label "C02 evidenced for Task201_G01_L01 in Task201"@en ;
      rdfs:comment "Justification-oriented task-level evidence record derived from the uniform group result. The same task-level group score is recorded uniformly for all members of the group and is used here as a contextual proficiency proxy, not as an independently differentiated per-competency judgment."@en ;
      ontoksd:refersToCompetence ontoksd:C02 ;
      ontoksd:isEvidencedCompetenceOf ontoksd:Task201_G01_L01_Profile ;
      ontoksd:derivedFromParticipation ontoksd:Task201_G01_L01_OfficialParticipation ;
      ontoksd:isEvidencedInAssessmentOccurrence ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:supportedByEvidence ontoksd:Task201_G01_ProcessEvidence , ontoksd:Task201_G01_ProductEvidence ;
      ontoksd:hasProficiencyLevel ontoksd:SecondCycle_CompetentLevel ;
      ontoksd:evidencedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G01_ProcessEvidence ontoksd:evidencesCompetence ontoksd:Task201_G01_L01_C02_EC .
  ontoksd:Task201_G01_ProductEvidence ontoksd:evidencesCompetence ontoksd:Task201_G01_L01_C02_EC .

  ontoksd:Task201_G01_L01_C03_EC a ontoksd:EvidencedCompetence ;
      rdfs:label "C03 evidenced for Task201_G01_L01 in Task201"@en ;
      rdfs:comment "Simulation-oriented task-level evidence record derived from the uniform group result. The same task-level group score is recorded uniformly for all members of the group and is used here as a contextual proficiency proxy, not as an independently differentiated per-competency judgment."@en ;
      ontoksd:refersToCompetence ontoksd:C03 ;
      ontoksd:isEvidencedCompetenceOf ontoksd:Task201_G01_L01_Profile ;
      ontoksd:derivedFromParticipation ontoksd:Task201_G01_L01_OfficialParticipation ;
      ontoksd:isEvidencedInAssessmentOccurrence ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:supportedByEvidence ontoksd:Task201_G01_ProcessEvidence , ontoksd:Task201_G01_ProductEvidence ;
      ontoksd:hasProficiencyLevel ontoksd:SecondCycle_CompetentLevel ;
      ontoksd:evidencedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G01_ProcessEvidence ontoksd:evidencesCompetence ontoksd:Task201_G01_L01_C03_EC .
  ontoksd:Task201_G01_ProductEvidence ontoksd:evidencesCompetence ontoksd:Task201_G01_L01_C03_EC .

  ontoksd:Task201_G01_L01_C04_EC a ontoksd:EvidencedCompetence ;
      rdfs:label "C04 evidenced for Task201_G01_L01 in Task201"@en ;
      rdfs:comment "Analytical-symbolic task-level evidence record derived from the uniform group result. The same task-level group score is recorded uniformly for all members of the group and is used here as a contextual proficiency proxy, not as an independently differentiated per-competency judgment."@en ;
      ontoksd:refersToCompetence ontoksd:C04 ;
      ontoksd:isEvidencedCompetenceOf ontoksd:Task201_G01_L01_Profile ;
      ontoksd:derivedFromParticipation ontoksd:Task201_G01_L01_OfficialParticipation ;
      ontoksd:isEvidencedInAssessmentOccurrence ontoksd:Task201_GroupAssessmentOccurrence ;
      ontoksd:supportedByEvidence ontoksd:Task201_G01_ProcessEvidence , ontoksd:Task201_G01_ProductEvidence ;
      ontoksd:hasProficiencyLevel ontoksd:SecondCycle_CompetentLevel ;
      ontoksd:evidencedAt "2022-04-03T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task201_G01_ProcessEvidence ontoksd:evidencesCompetence ontoksd:Task201_G01_L01_C04_EC .
  ontoksd:Task201_G01_ProductEvidence ontoksd:evidencesCompetence ontoksd:Task201_G01_L01_C04_EC .

  ontoksd:Task201_G01_L01_C05_EC a ontoksd:EvidencedCompetence ;
      rdfs:label "C05 evidenced for Task201_G01_L01 in Task201"@en ;
      rdfs:comment "Technical-documentation task-level evidence record derived from the uniform group result. The same task-level group score is recorded uniformly for all members of the group and is used here as a contextual proficiency proxy, not as an independently differentiated per-competency judgment."@en ;
      ontoksd:refersToCompetence ontoksd:C05 ;
