PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {

  #################################################################
  # Task204 materialization (representative anonymized learners)
  # This insert operationalizes Task204 using one anonymized learner
  # per group only. This reduction is intentional: the official grade
  # is group-derived and uniformly recorded for all group members, so
  # full learner-by-learner replication would not add new ontological
  # structures for the intended demonstration.
  #
  # Official scores come from the group review file for Problem 4.
  # Task semantics, deliverables, and competency configuration come
  # from the Task204 problem and CSP/CSRP reports.
  #
  # No self-assessment instances are materialized in this reduced file.
  # Proficiency intervals below are an operational assumption for
  # Shared second-cycle scheme: [0.0,6.0) Novice; [6.0,9.0) Competent; [9.0,10.0] Advanced.
  #################################################################

  #################################################################
  # Evidence Type
  #################################################################

  ontoksd:InstructorProcessReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Process Review"@en .

  ontoksd:InstructorProductReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Product Review"@en .

  #################################################################
  # Shared Proficiency Scheme Reference
  # This task reuses the shared second-cycle proficiency scheme
  # defined externally in the companion insert file.
  #################################################################

  #################################################################
  # Learning Task
  #################################################################

  ontoksd:Task204_OnlineJudgesAtLogisticSolutions a ontoksd:LearningTask ;
      rdfs:label "Task204 – Online Judges at Logistic Solutions"@en ;
      dcterms:identifier "Task204"^^xsd:string ;
      rdfs:comment "PBL learning task focused on explaining the limits of automated program evaluation through the Halting Problem, analyzing TLE in Online Judges, modeling observable system behavior with Finite State Machines, and documenting the analysis in SBC-style technical reporting."@en .

  #################################################################
  # Assessor
  #################################################################

  ontoksd:Task204_Instructor a ontoksd:Assessor ;
      rdfs:label "Task204 instructor-assessor"@en .

  #################################################################
  # Official Assessment
  #################################################################

  ontoksd:Task204_OfficialGroupAssessment a ontoksd:Assessment ;
      rdfs:label "Task204 official group assessment"@en ;
      dcterms:identifier "Task204-OfficialAssessment"^^xsd:string ;
      rdfs:comment "Task assessment based on two group-level dimensions: process review and product review. The arithmetic mean is then recorded individually and uniformly for every member of the corresponding group."@en ;
      ontoksd:isBasedOnActivity ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType .

  ontoksd:Task204_OfficialGroupAssessmentOccurrence a ontoksd:AssessmentOccurrence ;
      rdfs:label "Task204 official group assessment occurrence"@en ;
      ontoksd:realizes ontoksd:Task204_OfficialGroupAssessment ;
      ontoksd:usesProficiencyScheme ontoksd:SecondCycle_ProficiencyScheme ;
      ontoksd:hasScore "0.0"^^xsd:double .

  #################################################################
  # Competence Relator
  #################################################################

  ontoksd:Task204_C15Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:mediatesCompetence ontoksd:C15 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amAnalytical , ontoksd:amJustificatory .

  ontoksd:Task204_C16Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:mediatesCompetence ontoksd:C16 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amInterpretative .

  ontoksd:Task204_C06Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:mediatesCompetence ontoksd:C06 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amConstructive .

  ontoksd:Task204_C03Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:mediatesCompetence ontoksd:C03 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented .

  ontoksd:Task204_C02Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:mediatesCompetence ontoksd:C02 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arExtension ;
      ontoksd:hasActivationMode ontoksd:amJustificatory .

  ontoksd:Task204_C14Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:mediatesCompetence ontoksd:C14 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arExtension ;
      ontoksd:hasActivationMode ontoksd:amAnalytical .

  ontoksd:Task204_C05Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task204_OnlineJudgesAtLogisticSolutions ;
      ontoksd:mediatesCompetence ontoksd:C05 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arTransversal ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented .

  ontoksd:Task204_OnlineJudgesAtLogisticSolutions
      ontoksd:hasCompetenceRelator ontoksd:Task204_C15Activation , ontoksd:Task204_C16Activation , ontoksd:Task204_C06Activation , ontoksd:Task204_C03Activation , ontoksd:Task204_C02Activation , ontoksd:Task204_C14Activation , ontoksd:Task204_C05Activation .

