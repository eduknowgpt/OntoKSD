PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {

  #################################################################
  # Second CSP Task Cycle Shared Proficiency Scheme
  # This shared scheme is reused across Task201, Task202, Task203,
  # and Task204 because the four tasks were interpreted under the
  # same 0-10 evaluative scheme and the same qualitative levels.
  # The interval cutoffs remain an explicit operational assumption:
  # [0.0,6.0) Novice; [6.0,9.0) Competent; [9.0,10.0] Advanced.
  #################################################################

  ontoksd:SecondCycle_TenPointScale a ontoksd:Scale ;
      rdfs:label "Second CSP task cycle ten-point scale"@en .

  ontoksd:SecondCycle_NoviceLevel a ontoksd:ProficiencyLevel ;
      rdfs:label "Novice"@en ;
      ontoksd:hasOrdinalPosition 1 .

  ontoksd:SecondCycle_CompetentLevel a ontoksd:ProficiencyLevel ;
      rdfs:label "Competent"@en ;
      ontoksd:hasOrdinalPosition 2 .

  ontoksd:SecondCycle_AdvancedLevel a ontoksd:ProficiencyLevel ;
      rdfs:label "Advanced"@en ;
      ontoksd:hasOrdinalPosition 3 .

  ontoksd:SecondCycle_Interval_Novice a ontoksd:ScaleInterval ;
      ontoksd:isIntervalOf ontoksd:SecondCycle_TenPointScale ;
      ontoksd:lowerBound "0.00"^^xsd:double ;
      ontoksd:upperBound "7.00"^^xsd:double ;
      ontoksd:includesLower true ;
      ontoksd:includesUpper false ;
      ontoksd:correspondsToLevel ontoksd:SecondCycle_NoviceLevel .

  ontoksd:SecondCycle_Interval_Competent a ontoksd:ScaleInterval ;
      ontoksd:isIntervalOf ontoksd:SecondCycle_TenPointScale ;
      ontoksd:lowerBound "7.00"^^xsd:double ;
      ontoksd:upperBound "9.00"^^xsd:double ;
      ontoksd:includesLower true ;
      ontoksd:includesUpper false ;
      ontoksd:correspondsToLevel ontoksd:SecondCycle_CompetentLevel .

  ontoksd:SecondCycle_Interval_Advanced a ontoksd:ScaleInterval ;
      ontoksd:isIntervalOf ontoksd:SecondCycle_TenPointScale ;
      ontoksd:lowerBound "9.00"^^xsd:double ;
      ontoksd:upperBound "10.00"^^xsd:double ;
      ontoksd:includesLower true ;
      ontoksd:includesUpper true ;
      ontoksd:correspondsToLevel ontoksd:SecondCycle_AdvancedLevel .

  ontoksd:SecondCycle_ProficiencyScheme a ontoksd:ProficiencyScheme ;
      rdfs:label "Second CSP task cycle shared proficiency scheme"@en ;
      rdfs:comment "Shared operational interpretation of the 0-10 grades used across Task201-Task204. The source files do not define numeric cutoffs for Novice, Competent, and Advanced, so the intervals adopted here are an explicit modeling assumption for operationalization."@en ;
      ontoksd:usesScale ontoksd:SecondCycle_TenPointScale ;
      ontoksd:definesInterval ontoksd:SecondCycle_Interval_Novice , ontoksd:SecondCycle_Interval_Competent , ontoksd:SecondCycle_Interval_Advanced ;
      ontoksd:definesLevel ontoksd:SecondCycle_NoviceLevel , ontoksd:SecondCycle_CompetentLevel , ontoksd:SecondCycle_AdvancedLevel .

}
