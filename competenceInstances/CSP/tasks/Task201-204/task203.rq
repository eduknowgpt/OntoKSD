  ontoksd:Task203_G06_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G06 product review document"@en ;
      rdfs:comment "The solution is correct in the reported tests and well explained, but denied-request counts are not implemented as unary or binary values and results depend on event ordering."@en .

