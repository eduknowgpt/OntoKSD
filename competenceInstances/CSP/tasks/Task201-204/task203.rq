PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {

  #################################################################
  # Task203 materialization (representative anonymized learners)
  # This insert operationalizes Task203 using one anonymized learner
  # per group only. This reduction is intentional: the official grade
  # is group-derived and uniformly recorded for all group members, so
  # full learner-by-learner replication would not add new ontological
  # structures for the intended demonstration.
  #
  # Official scores come from the group review file for Problem 3.
  # Task semantics, deliverables, and competency configuration come
  # from the Task203 problem and CSP/CSRP reports.
  #
  # No self-assessment instances are materialized in this reduced file.
  # Proficiency intervals below are an operational assumption for
  # Shared second-cycle scheme: [0.0,6.0) Novice; [6.0,9.0) Competent; [9.0,10.0] Advanced.
  #################################################################

  #################################################################
  # Evidence Type
  #################################################################

  ontoksd:InstructorProcessReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Process Review"@en .

  ontoksd:InstructorProductReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Product Review"@en .

  #################################################################
  # Shared Proficiency Scheme Reference
  # This task reuses the shared second-cycle proficiency scheme
  # defined externally in the companion insert file.
  #################################################################

  #################################################################
  # Learning Task
  #################################################################

  ontoksd:Task203_ParkingControl a ontoksd:LearningTask ;
      rdfs:label "Task203 – Parking Control"@en ;
      dcterms:identifier "Task203"^^xsd:string ;
      rdfs:comment "PBL learning task focused on designing and justifying a Turing Machine-based parking control solution with category-specific availability management, denied-request counting, JFLAP simulation, and SBC-style technical documentation."@en .

  #################################################################
  # Assessor
  #################################################################

  ontoksd:Task203_Instructor a ontoksd:Assessor ;
      rdfs:label "Task203 instructor-assessor"@en .

  #################################################################
  # Official Assessment
  #################################################################

  ontoksd:Task203_OfficialGroupAssessment a ontoksd:Assessment ;
      rdfs:label "Task203 official group assessment"@en ;
      dcterms:identifier "Task203-OfficialAssessment"^^xsd:string ;
      rdfs:comment "Task assessment based on two group-level dimensions: process review and product review. The arithmetic mean is then recorded individually and uniformly for every member of the corresponding group."@en ;
      ontoksd:isBasedOnActivity ontoksd:Task203_ParkingControl ;
      ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType .

  ontoksd:Task203_OfficialGroupAssessmentOccurrence a ontoksd:AssessmentOccurrence ;
      rdfs:label "Task203 official group assessment occurrence"@en ;
      ontoksd:realizes ontoksd:Task203_OfficialGroupAssessment ;
      ontoksd:usesProficiencyScheme ontoksd:SecondCycle_ProficiencyScheme ;
      ontoksd:hasScore "0.0"^^xsd:double .

  #################################################################
  # Competence Relator
  #################################################################

  ontoksd:Task203_C07Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task203_ParkingControl ;
      ontoksd:mediatesCompetence ontoksd:C07 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amConstructive , ontoksd:amAnalytical .

  ontoksd:Task203_C08Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task203_ParkingControl ;
      ontoksd:mediatesCompetence ontoksd:C08 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical , ontoksd:amJustificatory .

  ontoksd:Task203_C09Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task203_ParkingControl ;
      ontoksd:mediatesCompetence ontoksd:C09 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical .

  ontoksd:Task203_C10Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task203_ParkingControl ;
      ontoksd:mediatesCompetence ontoksd:C10 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented .

  ontoksd:Task203_C05Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task203_ParkingControl ;
      ontoksd:mediatesCompetence ontoksd:C05 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arTransversal ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented , ontoksd:amJustificatory .

  ontoksd:Task203_ParkingControl
      ontoksd:hasCompetenceRelator ontoksd:Task203_C07Activation , ontoksd:Task203_C08Activation , ontoksd:Task203_C09Activation , ontoksd:Task203_C10Activation , ontoksd:Task203_C05Activation .

  #################################################################
  # Evidence x Document
  #################################################################

  ontoksd:Task203_G01_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G01 process review document"@en ;
      rdfs:comment "The group participated in tutorials and documented development incrementally, but left important details for the end and only partially justified the choice of machine."@en .

  ontoksd:Task203_G01_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G01 product review document"@en ;
      rdfs:comment "The solution shows good understanding and detailed prototyping, but it does not actually perform the required counting and the report lacks some requested details and conclusion."@en .

  ontoksd:Task203_G01_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task203 G01 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task203_G01_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task203_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task203_G01_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task203 G01 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task203_G01_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task203_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task203_G03_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G03 process review document"@en ;
      rdfs:comment "The documentation is clear and detailed, with strong tutorial participation and complete incremental development."@en .

  ontoksd:Task203_G03_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G03 product review document"@en ;
      rdfs:comment "The product demonstrates strong mastery of the problem and the Turing Machine solution, though the report should justify the choice of machine more explicitly and clarify some textual responsibilities."@en .

  ontoksd:Task203_G03_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task203 G03 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task203_G03_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task203_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task203_G03_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task203 G03 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task203_G03_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task203_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task203_G04_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G04 process review document"@en ;
      rdfs:comment "The group participated actively and documented a complete solution, but the report underrepresents the actual intermediate development steps and needs clearer theoretical framing."@en .

  ontoksd:Task203_G04_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G04 product review document"@en ;
      rdfs:comment "The solution satisfies the main requirements and shows good understanding, although the report should better explain the Turing Machine choice and improve introductory and concluding sections."@en .

  ontoksd:Task203_G04_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task203 G04 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task203_G04_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task203_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task203_G04_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task203 G04 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task203_G04_ProductReviewDocument ;
