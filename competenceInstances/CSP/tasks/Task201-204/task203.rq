      ontoksd:validatedAt "2022-06-06T23:59:00-03:00"^^xsd:dateTime .

  ontoksd:Task203_G05_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G05 process review document"@en ;
      rdfs:comment "The documentation is clear and precise, with active participation and a well-described solution strategy, including explicit discussion of nondeterminism."@en .

  ontoksd:Task203_G05_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task203 G05 product review document"@en ;
      rdfs:comment "The solution behaves correctly in the reported tests and the machine structure is detailed, but denied-request counting is not formalized as unary or binary counts and some acceptance concepts remain unclear."@en .

  ontoksd:Task203_G05_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task203 G05 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
