      ontoksd:generatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime .

  ontoksd:Task202_G04_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G04 process review document"@en ;
      rdfs:comment "Collaborative group with relevant tutorial participation and documented meetings, but the report insufficiently explains incremental construction and needs clearer technical writing."@en .

  ontoksd:Task202_G04_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G04 product review document"@en ;
      rdfs:comment "The team understood the problem and produced three automata variants, but the tested PDAs fail important requirements and the expected grammar was confused with the automaton definition."@en .

  ontoksd:Task202_G04_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task202 G04 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task202_G04_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task202_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime .

  ontoksd:Task202_G04_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task202 G04 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
