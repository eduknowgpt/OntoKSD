      ontoksd:validatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime .

  ontoksd:Task202_G05_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G05 process review document"@en ;
