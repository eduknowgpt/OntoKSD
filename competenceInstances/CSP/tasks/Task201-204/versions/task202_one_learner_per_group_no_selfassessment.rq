PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {

  #################################################################
  # Task202 materialization (representative anonymized learners)
  # This insert operationalizes Task202 using one anonymized learner
  # per group only. This reduction is intentional: the official grade
  # is group-derived and uniformly recorded for all group members, so
  # full learner-by-learner replication would not add new ontological
  # structures for the intended demonstration.
  #
  # Official scores come from the group review file for Problem 2.
  # Task semantics, deliverables, and timeline come from the Task202
  # problem and CSP/CSRP reports.
  #
  # No self-assessment instances are materialized in this reduced file.
  # Proficiency intervals below are an operational assumption for
  # Task202: [0.0,6.0) Novice; [6.0,9.0) Competent; [9.0,10.0] Advanced.
  #################################################################

  #################################################################
  # Evidence Type
  #################################################################

  ontoksd:InstructorProcessReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Process Review"@en .

  ontoksd:InstructorProductReview a ontoksd:EvidenceType ;
      rdfs:label "Instructor Product Review"@en .

  #################################################################
  # Proficiency
  #################################################################

  ontoksd:Task202_TenPointScale a ontoksd:Scale ;
      rdfs:label "Task202 ten-point scale"@en .

  ontoksd:Task202_NoviceLevel a ontoksd:ProficiencyLevel ;
      rdfs:label "Novice"@en ;
      ontoksd:hasOrdinalPosition 1 .

  ontoksd:Task202_CompetentLevel a ontoksd:ProficiencyLevel ;
      rdfs:label "Competent"@en ;
      ontoksd:hasOrdinalPosition 2 .

  ontoksd:Task202_AdvancedLevel a ontoksd:ProficiencyLevel ;
      rdfs:label "Advanced"@en ;
      ontoksd:hasOrdinalPosition 3 .

  ontoksd:Task202_Interval_Novice a ontoksd:ScaleInterval ;
      ontoksd:isIntervalOf ontoksd:Task202_TenPointScale ;
      ontoksd:lowerBound "0.00"^^xsd:double ;
      ontoksd:upperBound "6.00"^^xsd:double ;
      ontoksd:includesLower true ;
      ontoksd:includesUpper false ;
      ontoksd:correspondsToLevel ontoksd:Task202_NoviceLevel .

  ontoksd:Task202_Interval_Competent a ontoksd:ScaleInterval ;
      ontoksd:isIntervalOf ontoksd:Task202_TenPointScale ;
      ontoksd:lowerBound "6.00"^^xsd:double ;
      ontoksd:upperBound "9.00"^^xsd:double ;
      ontoksd:includesLower true ;
      ontoksd:includesUpper false ;
      ontoksd:correspondsToLevel ontoksd:Task202_CompetentLevel .

  ontoksd:Task202_Interval_Advanced a ontoksd:ScaleInterval ;
      ontoksd:isIntervalOf ontoksd:Task202_TenPointScale ;
      ontoksd:lowerBound "9.00"^^xsd:double ;
      ontoksd:upperBound "10.00"^^xsd:double ;
      ontoksd:includesLower true ;
      ontoksd:includesUpper true ;
      ontoksd:correspondsToLevel ontoksd:Task202_AdvancedLevel .

  ontoksd:Task202_ProficiencyScheme a ontoksd:ProficiencyScheme ;
      rdfs:label "Task202 operational proficiency scheme"@en ;
      rdfs:comment "Operational interpretation of the 0-10 grades used in Task202. The source files do not define numeric cutoffs for Novice, Competent, and Advanced, so the intervals adopted here are an explicit modeling assumption for operationalization."@en ;
      ontoksd:usesScale ontoksd:Task202_TenPointScale ;
      ontoksd:definesInterval ontoksd:Task202_Interval_Novice , ontoksd:Task202_Interval_Competent , ontoksd:Task202_Interval_Advanced ;
      ontoksd:definesLevel ontoksd:Task202_NoviceLevel , ontoksd:Task202_CompetentLevel , ontoksd:Task202_AdvancedLevel .

  #################################################################
  # Learning Task
  #################################################################

  ontoksd:Task202_TeamControl a ontoksd:LearningTask ;
      rdfs:label "Task202 – Team Control"@en ;
      dcterms:identifier "Task202"^^xsd:string ;
      rdfs:comment "PBL learning task focused on recognizing the expressive limits of finite-state models and developing a team-control solution using Pushdown Automata, JFLAP simulation, and SBC-style technical documentation."@en .

  #################################################################
  # Assessor
  #################################################################

  ontoksd:Task202_Instructor a ontoksd:Assessor ;
      rdfs:label "Task202 instructor-assessor"@en .

  #################################################################
  # Official Assessment
  #################################################################

  ontoksd:Task202_OfficialGroupAssessment a ontoksd:Assessment ;
      rdfs:label "Task202 official group assessment"@en ;
      dcterms:identifier "Task202-OfficialAssessment"^^xsd:string ;
      rdfs:comment "Task assessment based on two group-level dimensions: process review and product review. The arithmetic mean is then recorded individually and uniformly for every member of the corresponding group."@en ;
      ontoksd:isBasedOnActivity ontoksd:Task202_TeamControl ;
      ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType .

  ontoksd:Task202_OfficialGroupAssessmentOccurrence a ontoksd:AssessmentOccurrence ;
      rdfs:label "Task202 official group assessment occurrence"@en ;
      ontoksd:realizes ontoksd:Task202_OfficialGroupAssessment ;
      ontoksd:usesProficiencyScheme ontoksd:Task202_ProficiencyScheme ;
      ontoksd:hasScore "0.0"^^xsd:double .

  #################################################################
  # Competence Relator
  #################################################################

  ontoksd:Task202_C12Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task202_TeamControl ;
      ontoksd:mediatesCompetence ontoksd:C12_DevelopProblemSolvingSolutionsUsingPushdownAutomata ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amConstructive , ontoksd:amAnalytical .

  ontoksd:Task202_C03Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task202_TeamControl ;
      ontoksd:mediatesCompetence ontoksd:C03_TestAutomataUsingSimulators ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented .

  ontoksd:Task202_C1301Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task202_TeamControl ;
      ontoksd:mediatesCompetence ontoksd:C13_01_InterpretFormalGrammarBasedRules ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical , ontoksd:amJustificatory .

  ontoksd:Task202_C05Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task202_TeamControl ;
      ontoksd:mediatesCompetence ontoksd:C05_WriteATechnicalReport ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arTransversal ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented , ontoksd:amJustificatory .

  ontoksd:Task202_C14Activation a ontoksd:CompetenceRelator ;
      ontoksd:mediatesInstructionalUnit ontoksd:Task202_TeamControl ;
      ontoksd:mediatesCompetence ontoksd:C14_DifferentiateClassificationsOfFormalGrammars ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical , ontoksd:amJustificatory .

  ontoksd:Task202_TeamControl
      ontoksd:hasCompetenceRelator ontoksd:Task202_C12Activation , ontoksd:Task202_C03Activation , ontoksd:Task202_C1301Activation , ontoksd:Task202_C05Activation , ontoksd:Task202_C14Activation .

  #################################################################
  # Evidence x Document
  #################################################################

  ontoksd:Task202_G01_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G01 process review document"@en ;
      rdfs:comment "The group did not participate in tutorial sessions, making the process difficult to follow; the delivered work remained incipient despite a minimally clear introduction."@en .

  ontoksd:Task202_G01_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G01 product review document"@en ;
      rdfs:comment "The proposed solution remained far from the requirements, with little treatment of Pushdown Automata concepts, no examples of use, and no grammar."@en .

  ontoksd:Task202_G01_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task202 G01 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task202_G01_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task202_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime .

  ontoksd:Task202_G01_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task202 G01 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task202_G01_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task202_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime .

  ontoksd:Task202_G02_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G02 process review document"@en ;
      rdfs:comment "The source review file records the process and product grades for this group but provides no detailed qualitative process analysis."@en .

  ontoksd:Task202_G02_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G02 product review document"@en ;
      rdfs:comment "The source review file records the process and product grades for this group but provides no detailed qualitative product analysis."@en .

  ontoksd:Task202_G02_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task202 G02 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task202_G02_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task202_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime .

  ontoksd:Task202_G02_ProductEvidence a ontoksd:Evidence ;
      rdfs:label "Task202 G02 product evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProductReview ;
      ontoksd:hasSupportDocument ontoksd:Task202_G02_ProductReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task202_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime ;
      ontoksd:validatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime .

  ontoksd:Task202_G03_ProcessReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G03 process review document"@en ;
      rdfs:comment "Highly participative group with growing integration, well-documented incremental development, and detailed description of member participation."@en .

  ontoksd:Task202_G03_ProductReviewDocument a ontoksd:Document ;
      rdfs:label "Task202 G03 product review document"@en ;
      rdfs:comment "The PDA prototype is well developed and the team demonstrated strong understanding, although the solution did not cover all three requested cases and grammar generation remained conceptually weak."@en .

  ontoksd:Task202_G03_ProcessEvidence a ontoksd:Evidence ;
      rdfs:label "Task202 G03 process evidence"@en ;
      ontoksd:hasEvidenceType ontoksd:InstructorProcessReview ;
      ontoksd:hasSupportDocument ontoksd:Task202_G03_ProcessReviewDocument ;
      ontoksd:evidenceBasedOn ontoksd:Task202_OfficialGroupAssessmentOccurrence ;
      ontoksd:generatedAt "2022-05-02T18:00:00-03:00"^^xsd:dateTime ;
