  #################################################################
  # Assessment and evidence specification
  #################################################################

  ontoksd:Assessment_Task25.25 a ontoksd:Assessment ;
    rdfs:label "Assessment specification for Task25.25"@en ;
    dcterms:title "Assessment specification for Task25.25"@en ;
    dc:description "Assessment specification for the source code, function implementation, execution outputs, test cases, and explanation of the factorial computation program associated with Task25.25."@en ;
    ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentType ;
    rdfs:comment "The assessment design distinguishes artifact-level evidence from performance-level execution evidence and learner-level explanation. The factorial concept acts as prerequisite support, while the competence evidence concerns modularization, iteration, validation, integration, testing, and explanation."@en .

  ontoksd:AssessmentOccurrence_Task25.25 a ontoksd:AssessmentOccurrence ;
    rdfs:label "Assessment occurrence for Task25.25"@en ;
    ontoksd:realizes ontoksd:Assessment_Task25.25 ;
    ontoksd:occursInAcquisitionContext ontoksd:AC_Task25.25 ;
    ontoksd:producesEvidence ontoksd:Evidence_Task25.25_SourceCode ,
                             ontoksd:Evidence_Task25.25_FunctionImplementation ,
                             ontoksd:Evidence_Task25.25_ExecutionOutputs ,
                             ontoksd:Evidence_Task25.25_TestCases ,
                             ontoksd:Evidence_Task25.25_Explanation ;
    rdfs:comment "Concrete assessment occurrence that produces evidence from source code, the factorial function implementation, execution results, test cases, validation behavior, and learner explanation of computational logic and modular program structure."@en .

  ontoksd:Evidence_Task25.25_SourceCode a ontoksd:Evidence ;
    rdfs:label "Task25.25 source code evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:SourceCode ;
    rdfs:comment "Artifact-level evidence consisting of the implemented program, including input reading, iteration, validation, function calls, and formatted output."@en .

  ontoksd:Evidence_Task25.25_FunctionImplementation a ontoksd:Evidence ;
    rdfs:label "Task25.25 factorial function implementation evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:SourceCode ;
    rdfs:comment "Artifact-level evidence consisting specifically of the dedicated factorial function, including its parameter, return behavior, repeated multiplication logic, and reuse across multiple inputs."@en .

  ontoksd:Evidence_Task25.25_ExecutionOutputs a ontoksd:Evidence ;
    rdfs:label "Task25.25 execution outputs evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:ProgramExecution ;
    rdfs:comment "Performance-level evidence showing correct factorial computation, correct iteration over multiple inputs, correct validation behavior, and formatted output."@en .

  ontoksd:Evidence_Task25.25_TestCases a ontoksd:Evidence ;
    rdfs:label "Task25.25 test cases evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:TestCaseSet ;
    rdfs:comment "Artifact-level and performance-oriented evidence consisting of test cases including valid and invalid inputs, expected factorial results, and validation cases such as negative values."@en .

  ontoksd:Evidence_Task25.25_Explanation a ontoksd:Evidence ;
    rdfs:label "Task25.25 explanation of computational logic evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:OralExplanation ;
    rdfs:comment "Learner-level evidence consisting of the learner's explanation and justification of the factorial function, function calls, loop behavior, validation rules, output formatting, and modular program structure."@en .

}
