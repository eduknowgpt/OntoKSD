INSERT DATA {


  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.25 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.25 — Factorial Computation Using Functions and Iteration Structures"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.25 in an introductory programming course within an Integrated Technical Program in Informatics. The task is typically used after initial exposure to variables, conditionals, loops, and functions."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.25 a ontoksd:LearningTask ;
    rdfs:label "Task25.25 — Factorial Computation Using Functions and Iteration Structures"@en ;
    dcterms:title "Task25.25 — Factorial Computation Using Functions and Iteration Structures"@en ;
    dc:description "Learning task in which learners develop a program that reads a number of inputs, processes multiple integer values, computes the factorial of each value using a dedicated function, validates input values, and displays formatted results."@en ;
    rdfs:comment "Although the uploaded CSP-Report internally refers to TASK25.7, this materialization follows the user's request for Task25.25. The mathematical concept of factorial is represented as prerequisite support, while the target competencies focus on computational structure, functions, iteration, validation, testing, and explanation."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.25 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.25_CT25.25.1 ,
                                 ontoksd:CA_Task25.25_CT25.25.2 ,
                                 ontoksd:CA_Task25.25_CT25.25.3 ,
                                 ontoksd:CA_Task25.25_CT25.25.4 ,
                                 ontoksd:CA_Task25.25_CT25.25.5 ,
                                 ontoksd:CA_Task25.25_CT25.25.6 .

  #################################################################
  # Prerequisite knowledge base
  #################################################################

  ontoksd:PrerequisiteKnowledge_Task25.25_Factorial a ontoksd:Knowledge ;
    rdfs:label "Prerequisite knowledge for Task25.25 — Factorial"@en ;
    skos:prefLabel "Factorial as prerequisite knowledge"@en ;
    rdfs:comment "Prerequisite knowledge used to support the task context: concept of factorial, multiplicative sequences, and basic arithmetic operations. This knowledge is not modeled as a target competence in Task25.25 because the CSP-Report explicitly states that the competency specification focuses on computational structure and implementation."@en .

  #################################################################
  # Competence specifications
  #################################################################

  ontoksd:CT25.25.1 a ontoksd:Competence ;
    rdfs:label "CT25.25.1 — Implement mathematical procedures as reusable functions"@en ;
    dcterms:title "Implement mathematical procedures as reusable functions"@en ;
    dc:description "This competence involves implementing a computational procedure as a reusable function with defined inputs and outputs."@en ;
    rdfs:comment "In Task25.25, this competence is demonstrated when learners implement a factorial function that receives a value and returns the computed result."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:systematic , ontoksd:meticulous ;
    ontoksd:hasPrerequisiteKnowledge ontoksd:PrerequisiteKnowledge_Task25.25_Factorial ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.25.1_Functions_Applying ,
                              ontoksd:KS_CT25.25.1_ParametersReturn_Applying ,
                              ontoksd:KS_CT25.25.1_Modularization_Analyzing .

  ontoksd:CT25.25.2 a ontoksd:Competence ;
    rdfs:label "CT25.25.2 — Process multiple inputs using iterative control structures"@en ;
    dcterms:title "Process multiple inputs using iterative control structures"@en ;
    dc:description "This competence involves processing collections of input values using loop structures."@en ;
    rdfs:comment "In Task25.25, this competence is demonstrated when learners iterate over n inputs and apply the factorial function to each value."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:persistent ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.25.2_Loops_Applying ,
                              ontoksd:KS_CT25.25.2_SequentialExecution_Applying ,
                              ontoksd:KS_CT25.25.2_InputProcessing_Applying .

  ontoksd:CT25.25.3 a ontoksd:Competence ;
    rdfs:label "CT25.25.3 — Validate input data using conditional logic"@en ;
    dcterms:title "Validate input data using conditional logic"@en ;
    dc:description "This competence involves verifying that input values satisfy constraints and handling invalid inputs appropriately."@en ;
    rdfs:comment "In Task25.25, this competence is demonstrated when learners ensure that factorial is computed only for non-negative integers and invalid values are rejected or handled."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:responsible , ontoksd:meticulous ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.25.3_Conditionals_Applying ,
                              ontoksd:KS_CT25.25.3_InputValidation_Applying ,
                              ontoksd:KS_CT25.25.3_ErrorHandling_Analyzing .

  ontoksd:CT25.25.4 a ontoksd:Competence ;
    rdfs:label "CT25.25.4 — Integrate functions and control flow in a complete program"@en ;
    dcterms:title "Integrate functions and control flow in a complete program"@en ;
    dc:description "This competence involves coordinating multiple program components — input, processing, function calls, and output — into a coherent solution."@en ;
    rdfs:comment "In Task25.25, this competence is demonstrated when learners coordinate input reading, iteration over values, validation, function calls, factorial computation, and formatted output in a complete program."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.25.4_ProgramStructure_Applying ,
                              ontoksd:KS_CT25.25.4_FunctionCalls_Applying ,
                              ontoksd:KS_CT25.25.4_ControlFlow_Analyzing .

  ontoksd:CT25.25.5 a ontoksd:Competence ;
    rdfs:label "CT25.25.5 — Test and verify program correctness across input scenarios"@en ;
    dcterms:title "Test and verify program correctness across input scenarios"@en ;
    dc:description "This competence involves executing the program with different inputs and verifying correctness."@en ;
    rdfs:comment "In Task25.25, this competence is demonstrated when learners test valid and invalid inputs, verify factorial results, and inspect output formatting and validation behavior."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.25.5_Testing_Applying ,
                              ontoksd:KS_CT25.25.5_CaseAnalysis_Analyzing ,
                              ontoksd:KS_CT25.25.5_OutputValidation_Applying .

  ontoksd:CT25.25.6 a ontoksd:Competence ;
    rdfs:label "CT25.25.6 — Explain computational logic and program structure"@en ;
    dcterms:title "Explain computational logic and program structure"@en ;
    dc:description "This competence involves explaining how the program works, including function behavior and execution flow."@en ;
    rdfs:comment "In Task25.25, this competence is demonstrated when learners explain the factorial function, the loop over multiple inputs, validation rules, function calls, and the overall modular organization of the program."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:professionalCompetenceScope ;
    ontoksd:hasDisposition ontoksd:communicative , ontoksd:reflective ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.25.6_AlgorithmExplanation_Understanding ,
                              ontoksd:KS_CT25.25.6_ProgramStructure_Applying ,
                              ontoksd:KS_CT25.25.6_LogicalReasoning_Applying .

