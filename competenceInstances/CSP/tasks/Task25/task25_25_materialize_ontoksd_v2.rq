    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.25.1 is activated as a mandatory core constructive competence because learners must implement the factorial calculation as a dedicated reusable function."@en .

