  ontoksd:CA_Task25.25_CT25.25.1 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.25.1 in Task25.25"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.25 ;
