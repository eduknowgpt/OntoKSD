PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ontoksd: <http://purl.org/ontoksd#>

INSERT DATA {

  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.03 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.03 — Controle de Tráfego"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.03 in ILFTC – Introdução às Linguagens Formais e Teoria da Computação. This context frames a problem-based learning task centered on Turing Machines, computability, symbolic input processing from traffic sensors, execution and validation in JFLAP, and mathematically rigorous technical justification."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.03 a ontoksd:LearningTask ;
    rdfs:label "Task25.03 — Controle de Tráfego"@pt ;
    dcterms:title "Task25.03 — Controle de Tráfego"@pt ;
    dc:description "Learning task in which learners model, analyze, simulate, and justify a traffic-monitoring system using Turing Machines, based on symbolic inputs produced by road sensors, in order to count vehicle categories and determine the predominant one."@en ;
    rdfs:comment "Task25.03 is a formal modeling and computational analysis task in which learners reinterpret traffic-sensor readings as symbolic input strings and design a Turing Machine capable of processing them to count vehicle categories and decide which category is predominant. The task requires symbolic abstraction of sensor data, structural treatment of input strings, construction of a Turing Machine solution, execution and validation in JFLAP, justification of computability through the Church–Turing thesis, and a mathematically rigorous technical report explaining correctness, behavior, and modeling decisions."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.03 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.03_C18 ,
                                 ontoksd:CA_Task25.03_C17 ,
                                 ontoksd:CA_Task25.03_C07 ,
                                 ontoksd:CA_Task25.03_C23 ,
                                 ontoksd:CA_Task25.03_C05.01 ,
                                 ontoksd:CA_Task25.03_C16 ,
                                 ontoksd:CA_Task25.03_C10 ,
                                 ontoksd:CA_Task25.03_C09 .

  #################################################################
  # Competence activations
  #################################################################

  ontoksd:CA_Task25.03_C18 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C18 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C18 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C18 is activated in Task25.03 as a core constructive competence because learners must abstract traffic-sensor readings and vehicle categories as symbols, strings, and formal input structures before the computational solution can be specified."@en .

  ontoksd:CA_Task25.03_C17 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C17 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C17 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C17 is activated in Task25.03 as a core analytical competence because learners must structurally treat symbolic strings through scanning, marking, segmentation, and comparison in order to support the later counting and decision procedures implemented by the Turing Machine."@en .

  ontoksd:CA_Task25.03_C07 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C07 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C07 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C07 is activated in Task25.03 as a core constructive competence because the task explicitly requires learners to design and implement a Turing Machine capable of counting category occurrences, comparing quantities, and deciding which vehicle category is predominant."@en .

  ontoksd:CA_Task25.03_C23 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C23 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C23 ;
    ontoksd:hasActivationRole ontoksd:arTransversal ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C23 is activated in Task25.03 as a transversal analytical competence because learners must use formal symbolic notation to describe input strings, tape symbols, configurations, and language-related aspects of the Turing Machine model."@en .

  ontoksd:CA_Task25.03_C05.01 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C05.01 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C05_01 ;
    ontoksd:hasActivationRole ontoksd:arTransversal ;
    ontoksd:hasActivationMode ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C05.01 is activated in Task25.03 as a transversal justificatory competence because the task requires mathematically rigorous answers and report sections explaining correctness, computability, behavior, and modeling rationale through explicit definitions, examples, and formal arguments."@en .

  ontoksd:CA_Task25.03_C16 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C16 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C16 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C16 is activated in Task25.03 as a mandatory supporting competence because learners must interpret Turing Machine concepts and analyze why this computational formalism is adequate for the traffic-control problem in light of computability and system-processing capabilities."@en .

  ontoksd:CA_Task25.03_C10 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C10 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C10 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amArtifactOriented ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C10 is activated in Task25.03 as a mandatory supporting competence because the task explicitly requires JFLAP-based execution and validation of the Turing Machine against different traffic-input strings and observed outcomes."@en .

  ontoksd:CA_Task25.03_C09 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C09 in Task25.03"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.03 ;
    ontoksd:mediatesCompetence ontoksd:C09 ;
    ontoksd:hasActivationRole ontoksd:arExtension ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acConditional ;
    rdfs:comment "C09 is activated in Task25.03 as a conditional extension competence when learners explicitly examine whether variants or extensions of Turing Machines would provide a clearer or more efficient representation of the required processing."@en .

}
