  #################################################################
  # Assessment and evidence specification
  #################################################################

  ontoksd:Assessment_Task25.23 a ontoksd:Assessment ;
    rdfs:label "Assessment specification for Task25.23"@en ;
    dcterms:title "Assessment specification for Task25.23"@en ;
    dc:description "Assessment specification for the Kahoot interactive quiz, scenario-based responses, oral justifications, and feedback-cycle participation associated with Task25.23."@en ;
    ontoksd:hasAssessmentTypeConcept ontoksd:QuizAssessmentType ;
    rdfs:comment "The assessment design distinguishes quiz performance records from learner reasoning and feedback-based conceptual revision. This prevents quiz scores alone from being treated as sufficient evidence of competence and allows oral justification and feedback participation to support richer competence interpretation."@en .

  ontoksd:AssessmentOccurrence_Task25.23 a ontoksd:AssessmentOccurrence ;
    rdfs:label "Assessment occurrence for Task25.23"@en ;
    ontoksd:realizes ontoksd:Assessment_Task25.23 ;
    ontoksd:occursInAcquisitionContext ontoksd:AC_Task25.23 ;
    ontoksd:producesEvidence ontoksd:Evidence_Task25.23_QuizPerformanceRecords ,
                             ontoksd:Evidence_Task25.23_ScenarioBasedResponses ,
                             ontoksd:Evidence_Task25.23_OralJustifications ,
                             ontoksd:Evidence_Task25.23_FeedbackCycleParticipation ;
    rdfs:comment "Concrete assessment occurrence that produces evidence from quiz performance records, scenario-based answers, oral justifications during guided discussion, and participation in feedback cycles."@en .

  ontoksd:Evidence_Task25.23_QuizPerformanceRecords a ontoksd:Evidence ;
    rdfs:label "Task25.23 quiz performance records"@en ;
    ontoksd:hasEvidenceType ontoksd:AssessmentRecord ;
    rdfs:comment "Artifact-level evidence generated by Kahoot, including selected answers, correctness, and response time across the 15 quiz questions."@en .

  ontoksd:Evidence_Task25.23_ScenarioBasedResponses a ontoksd:Evidence ;
    rdfs:label "Task25.23 scenario-based responses"@en ;
    ontoksd:hasEvidenceType ontoksd:AssessmentResponse ;
    rdfs:comment "Performance-level evidence from answers to problem-based questions, showing conceptual application of hardware, software, operating-system, and computer-architecture concepts in contextualized situations."@en .

  ontoksd:Evidence_Task25.23_OralJustifications a ontoksd:Evidence ;
    rdfs:label "Task25.23 oral justifications during guided discussion"@en ;
    ontoksd:hasEvidenceType ontoksd:OralExplanation ;
    rdfs:comment "Learner-level evidence consisting of oral explanations and justifications during post-question discussion, showing reasoning, technical vocabulary, and ability to explain why answers are correct or incorrect."@en .

  ontoksd:Evidence_Task25.23_FeedbackCycleParticipation a ontoksd:Evidence ;
    rdfs:label "Task25.23 participation in feedback cycles"@en ;
    ontoksd:hasEvidenceType ontoksd:ParticipationRecord ;
    rdfs:comment "Performance-level evidence showing learner engagement in immediate feedback cycles, correction of misconceptions, and revision of conceptual understanding after quiz questions."@en .

}
