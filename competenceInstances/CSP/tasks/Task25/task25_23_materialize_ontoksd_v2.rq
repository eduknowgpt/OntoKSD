INSERT DATA {


  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.23 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.23 — Interactive Quiz: Fundamental Concepts of Hardware and Software"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.23 in the Computer Architecture unit of the first-year Integrated Technical Program in Informatics at .... The task is conducted after the theoretical block on computer architecture, hardware, software, and organization of computational systems, in a computer laboratory using mobile phones and institutional computers with internet access."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.23 a ontoksd:LearningTask ;
    rdfs:label "Task25.23 — Interactive Quiz: Fundamental Concepts of Hardware and Software"@en ;
    dcterms:title "Task25.23 — Interactive Quiz: Fundamental Concepts of Hardware and Software"@en ;
    dc:description "Learning task in which learners participate in a 15-question interactive quiz about hardware, software, and basic computer architecture. Questions address identification and function of hardware components, differences between system software and application software, relations between hardware and performance, and problem-based scenarios involving real computational systems. After each question, guided discussion is used to explain the correct answer, clarify misunderstandings, and relate the topic to previous theoretical lessons."@en ;
    rdfs:comment "Although the uploaded report text internally refers to TASK25.5, this materialization follows the file and user request identifier TASK25.23. The task is modeled as an interactive formative LearningTask rather than only as a quiz score, because evidence includes quiz performance records, scenario-based answers, oral justifications, and participation in feedback cycles."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.23 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.23_CT25.23.1 ,
                                 ontoksd:CA_Task25.23_CT25.23.2 ,
                                 ontoksd:CA_Task25.23_CT25.23.3 ,
                                 ontoksd:CA_Task25.23_CT25.23.4 ,
                                 ontoksd:CA_Task25.23_CT25.23.5 ,
                                 ontoksd:CA_Task25.23_CT25.23.6 .

  #################################################################
  # Competence specifications
  #################################################################

  ontoksd:CT25.23.1 a ontoksd:Competence ;
    rdfs:label "CT25.23.1 — Identify hardware components and their functions"@en ;
    dcterms:title "Identify hardware components and their functions"@en ;
    dc:description "This competence involves recognizing basic computer hardware components and describing their primary functions within a computational system."@en ;
    rdfs:comment "In Task25.23, this competence is demonstrated when learners identify components such as CPU, memory, storage devices, and input/output devices in multiple-choice questions and guided discussions. It focuses on conceptual identification and functional recognition rather than broader system diagnosis."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:curious ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.23.1_HardwareComponents_Understanding ,
                              ontoksd:KS_CT25.23.1_HardwareFunctions_Understanding ,
                              ontoksd:KS_CT25.23.1_InputOutputDevices_Understanding .

  ontoksd:CT25.23.2 a ontoksd:Competence ;
    rdfs:label "CT25.23.2 — Distinguish system software from application software"@en ;
    dcterms:title "Distinguish system software from application software"@en ;
    dc:description "This competence involves distinguishing software categories according to their role in a computational system."@en ;
    rdfs:comment "In Task25.23, this competence is demonstrated when learners classify examples of software as system software or application software and explain the difference between software that manages the system and software used by users to perform tasks."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:analytical ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.23.2_SystemSoftware_Understanding ,
                              ontoksd:KS_CT25.23.2_ApplicationSoftware_Understanding ,
                              ontoksd:KS_CT25.23.2_SoftwareCategories_Analyzing .

  ontoksd:CT25.23.3 a ontoksd:Competence ;
    rdfs:label "CT25.23.3 — Explain hardware–software interaction in basic computer systems"@en ;
    dcterms:title "Explain hardware–software interaction in basic computer systems"@en ;
    dc:description "This competence involves explaining how hardware and software interact in the operation of a computer system."@en ;
    rdfs:comment "In Task25.23, this competence is demonstrated when learners reason about how the operating system, applications, processors, memory, storage, and input/output devices contribute to system behavior and performance. It is distinct from component identification because it requires relating components and explaining their interaction."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:analytical , ontoksd:critical ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.23.3_HardwareSoftwareInteraction_Understanding ,
                              ontoksd:KS_CT25.23.3_OperatingSystemResourceManagement_Understanding ,
                              ontoksd:KS_CT25.23.3_SystemPerformanceFactors_Analyzing .

  ontoksd:CT25.23.4 a ontoksd:Competence ;
    rdfs:label "CT25.23.4 — Analyze computer system scenarios using foundational architecture concepts"@en ;
    dcterms:title "Analyze computer system scenarios using foundational architecture concepts"@en ;
    dc:description "This competence involves analyzing short scenarios about computer assembly, operation, configuration, or performance using foundational computer architecture concepts."@en ;
    rdfs:comment "In Task25.23, this competence is demonstrated when learners answer problem-based quiz questions involving real computational systems and justify why a given answer is correct or incorrect. It is more advanced than simple recall because it requires applying concepts to contextualized situations."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:critical , ontoksd:meticulous , ontoksd:investigative ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.23.4_BasicComputerArchitecture_Applying ,
                              ontoksd:KS_CT25.23.4_ScenarioInterpretation_Analyzing ,
                              ontoksd:KS_CT25.23.4_ConceptualDiagnosis_Analyzing .

  ontoksd:CT25.23.5 a ontoksd:Competence ;
    rdfs:label "CT25.23.5 — Revise conceptual understanding through immediate feedback"@en ;
    dcterms:title "Revise conceptual understanding through immediate feedback"@en ;
    dc:description "This competence involves using feedback to identify misconceptions, revise explanations, and improve conceptual understanding."@en ;
    rdfs:comment "In Task25.23, this competence is demonstrated when learners receive immediate feedback after each quiz question and participate in guided discussions that clarify correct answers and address misunderstandings. It captures the formative nature of the task beyond quiz scoring."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:professionalCompetenceScope ;
    ontoksd:hasDisposition ontoksd:reflective , ontoksd:receptive , ontoksd:persistent ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.23.5_FeedbackInterpretation_Understanding ,
                              ontoksd:KS_CT25.23.5_MisconceptionIdentification_Analyzing ,
                              ontoksd:KS_CT25.23.5_ConceptualRevision_Applying .

  ontoksd:CT25.23.6 a ontoksd:Competence ;
    rdfs:label "CT25.23.6 — Communicate and justify answers using computing vocabulary"@en ;
    dcterms:title "Communicate and justify answers using computing vocabulary"@en ;
    dc:description "This competence involves explaining and justifying quiz answers using appropriate computing vocabulary and coherent reasoning."@en ;
    rdfs:comment "In Task25.23, this competence is demonstrated when learners participate in post-question discussions, explain why a selected answer is correct or incorrect, and relate answers to concepts such as hardware, software, operating systems, performance, and system organization."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:professionalCompetenceScope ;
    ontoksd:hasDisposition ontoksd:communicative , ontoksd:respectful , ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.23.6_TechnicalVocabulary_Understanding ,
                              ontoksd:KS_CT25.23.6_LogicalJustification_Applying ,
                              ontoksd:KS_CT25.23.6_OralCommunication_Applying .

