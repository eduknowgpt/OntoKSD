    ontoksd:mediatesCompetence ontoksd:CT25.23.3 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.23.3 is activated as a mandatory core analytical competence because learners must relate hardware and software elements and explain how these elements contribute to system behavior and performance."@en .

  ontoksd:CA_Task25.23_CT25.23.4 a ontoksd:CompetenceActivation ;
