  ontoksd:CA_Task25.23_CT25.23.1 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.23.1 in Task25.23"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.23 ;
    ontoksd:mediatesCompetence ontoksd:CT25.23.1 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amInterpretative ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.23.1 is activated as a mandatory core interpretative competence because the task requires learners to identify hardware components and recognize their functions in quiz questions and guided discussion."@en .

  ontoksd:CA_Task25.23_CT25.23.2 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.23.2 in Task25.23"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.23 ;
    ontoksd:mediatesCompetence ontoksd:CT25.23.2 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amInterpretativeAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.23.2 is activated as a mandatory core interpretative-analytical competence because learners must classify and distinguish software categories, including system software and application software."@en .

  ontoksd:CA_Task25.23_CT25.23.3 a ontoksd:CompetenceActivation ;
