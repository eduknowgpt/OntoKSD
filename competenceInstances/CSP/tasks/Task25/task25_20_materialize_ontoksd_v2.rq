  #################################################################
  # Competence activations
  #################################################################

  ontoksd:CA_Task25.20_CT25.20.1 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.20.1 in Task25.20"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.20 ;
    ontoksd:mediatesCompetence ontoksd:CT25.20.1 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.20.1 is activated as a mandatory supporting analytical competence because the implementation depends on identifying rules, constraints, expected behaviors, and termination criteria before coding decisions can be made."@en .

  ontoksd:CA_Task25.20_CT25.20.2 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.20.2 in Task25.20"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.20 ;
    ontoksd:mediatesCompetence ontoksd:CT25.20.2 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.20.2 is activated as a mandatory core constructive competence because the program requires an explicit structured representation of the board and its evolving state."@en .

  ontoksd:CA_Task25.20_CT25.20.3 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.20.3 in Task25.20"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.20 ;
    ontoksd:mediatesCompetence ontoksd:CT25.20.3 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.20.3 is activated as a mandatory core constructive competence because turn alternation, input validation, game-loop control, and termination conditions are central to the executable behavior of the solution."@en .

  ontoksd:CA_Task25.20_CT25.20.4 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.20.4 in Task25.20"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.20 ;
    ontoksd:mediatesCompetence ontoksd:CT25.20.4 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.20.4 is activated as a mandatory core constructive competence because the expected solution must be decomposed into cohesive functions with delimited responsibilities."@en .

  ontoksd:CA_Task25.20_CT25.20.5 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.20.5 in Task25.20"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.20 ;
    ontoksd:mediatesCompetence ontoksd:CT25.20.5 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.20.5 is activated as a mandatory core analytical competence because the task requires learners to verify behavior, identify faults, and trace execution under representative game scenarios."@en .

  ontoksd:CA_Task25.20_CT25.20.6 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.20.6 in Task25.20"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.20 ;
    ontoksd:mediatesCompetence ontoksd:CT25.20.6 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.20.6 is activated as a mandatory supporting justificatory competence because each learner must individually explain, justify, and trace the implemented solution, supporting learner-specific authorship and understanding despite collaborative artifact production."@en .

