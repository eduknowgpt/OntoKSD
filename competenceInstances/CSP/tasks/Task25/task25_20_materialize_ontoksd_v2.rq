  ontoksd:EA_CT25.20.1_BNCC_CG1 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.1 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_1 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence supports the broader BNCC goal of understanding and analyzing computational solutions." .
  ontoksd:EA_CT25.20.1_BNCC_CG5 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.1 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_5 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence contributes to project-based solution development in collaborative contexts." .
  ontoksd:EA_CT25.20.1_BNCC_EM13CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.1 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO02 ; ontoksd:hasAlignmentType ontoksd:CloseAlignment ; ontoksd:hasAlignmentJustification "The competence directly supports refinement from specification to implementation." .
  ontoksd:EA_CT25.20.1_BNCC_EM13CO01 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.1 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO01 ; ontoksd:hasAlignmentType ontoksd:PartialAlignment ; ontoksd:hasAlignmentJustification "Reuse or adaptation may occur, but it is not central to the task." .

  ontoksd:EA_CT25.20.2_BNCC_CG1 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.2 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_1 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence supports the broader construction and analysis of computational solutions." .
  ontoksd:EA_CT25.20.2_BNCC_CG4 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.2 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_4 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence contributes to producing computational artifacts using appropriate techniques." .
  ontoksd:EA_CT25.20.2_BNCC_EM13CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.2 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO02 ; ontoksd:hasAlignmentType ontoksd:NarrowerThanExternalAlignment ; ontoksd:hasAlignmentJustification "This competence addresses a specific part of the broader BNCC refinement process: data and state representation." .
  ontoksd:EA_CT25.20.2_BNCC_EF04CO01 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.2 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EF04CO01 ; ontoksd:hasAlignmentType ontoksd:CurricularContinuityAlignment ; ontoksd:hasAlignmentJustification "Matrix-based board representation continues prior curricular work with coordinate-based matrix structures." .
  ontoksd:EA_CT25.20.2_BNCC_EF15CO01 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.2 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EF15CO01 ; ontoksd:hasAlignmentType ontoksd:CurricularContinuityAlignment ; ontoksd:hasAlignmentJustification "Structured information representation is a prior-stage foundation for this competence." .

  ontoksd:EA_CT25.20.3_BNCC_CG1 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.3 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_1 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence contributes to building computational solutions." .
  ontoksd:EA_CT25.20.3_BNCC_EM13CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.3 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO02 ; ontoksd:hasAlignmentType ontoksd:NarrowerThanExternalAlignment ; ontoksd:hasAlignmentJustification "This competence represents a specific implementation-level aspect of solution refinement." .
  ontoksd:EA_CT25.20.3_BNCC_EF69CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.3 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EF69CO02 ; ontoksd:hasAlignmentType ontoksd:CurricularContinuityAlignment ; ontoksd:hasAlignmentJustification "It continues prior curricular work with sequence, repetition, and selection in programming languages." .
  ontoksd:EA_CT25.20.3_BNCC_EF15CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.3 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EF15CO02 ; ontoksd:hasAlignmentType ontoksd:CurricularContinuityAlignment ; ontoksd:hasAlignmentJustification "It builds on earlier construction and simulation of algorithms with selections and repetitions." .

  ontoksd:EA_CT25.20.4_BNCC_CG4 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.4 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_4 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "Modularization supports production of computational artifacts with organization and quality." .
  ontoksd:EA_CT25.20.4_BNCC_CG5 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.4 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_5 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "Modular decomposition supports collaborative project development." .
  ontoksd:EA_CT25.20.4_BNCC_EM13CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.4 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO02 ; ontoksd:hasAlignmentType ontoksd:NarrowerThanExternalAlignment ; ontoksd:hasAlignmentJustification "This competence captures one specific aspect of refinement from specification to implementation." .
  ontoksd:EA_CT25.20.4_BNCC_EF15CO04 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.4 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EF15CO04 ; ontoksd:hasAlignmentType ontoksd:CurricularContinuityAlignment ; ontoksd:hasAlignmentJustification "It continues prior curricular work on decomposition of complex problems." .

  ontoksd:EA_CT25.20.5_BNCC_CG1 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.5 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_1 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "Testing and debugging support the construction and analysis of computational solutions." .
  ontoksd:EA_CT25.20.5_BNCC_CG4 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.5 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_4 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "Program verification contributes to artifact quality." .
  ontoksd:EA_CT25.20.5_BNCC_EM13CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.5 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO02 ; ontoksd:hasAlignmentType ontoksd:NarrowerThanExternalAlignment ; ontoksd:hasAlignmentJustification "Testing and debugging are specific refinement practices within the broader specification-to-implementation process." .
  ontoksd:EA_CT25.20.5_BNCC_EF07CO02 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.5 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EF07CO02 ; ontoksd:hasAlignmentType ontoksd:CurricularContinuityAlignment ; ontoksd:hasAlignmentJustification "This is a strong prior-stage reference for analyzing programs to detect and remove errors." .

  ontoksd:EA_CT25.20.6_BNCC_CG4 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.6 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_4 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence supports responsible production and explanation of computational artifacts." .
  ontoksd:EA_CT25.20.6_BNCC_CG6 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.6 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_6 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence supports expression and sharing of computational ideas and solutions." .
  ontoksd:EA_CT25.20.6_BNCC_CG7 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.6 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM_GeneralCompetence_7 ; ontoksd:hasAlignmentType ontoksd:GeneralFrameworkAlignment ; ontoksd:hasAlignmentJustification "The competence supports ethical and responsible action." .
  ontoksd:EA_CT25.20.6_BNCC_EM13CO19 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.6 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO19 ; ontoksd:hasAlignmentType ontoksd:CloseAlignment ; ontoksd:hasAlignmentJustification "The oral explanation directly involves exposing and arguing about a computational product." .
  ontoksd:EA_CT25.20.6_BNCC_EM13CO21 a ontoksd:ExternalCompetenceAlignment ; ontoksd:mediatesInternalCompetence ontoksd:CT25.20.6 ; ontoksd:mediatesExternalCompetence ontoksd:BNCC_EM13CO21 ; ontoksd:hasAlignmentType ontoksd:PartialAlignment ; ontoksd:hasAlignmentJustification "The competence partially overlaps with clear communication of complex ideas, although the task does not require the specific digital objects mentioned by BNCC." .

  #################################################################
  # Assessment and evidence specification
  #################################################################

  ontoksd:Assessment_Task25.20 a ontoksd:Assessment ;
    rdfs:label "Assessment specification for Task25.20"@en ;
    dcterms:title "Assessment specification for Task25.20"@en ;
    dc:description "Assessment specification for the collaborative implementation, program execution, and individual oral explanation associated with Task25.20."@en ;
    ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentType ;
    rdfs:comment "The assessment design distinguishes artifact-level evidence, performance-level evidence, and learner-level oral explanation. This preserves the distinction between collaboratively produced source code and learner-specific evidence of conceptual understanding and authorship."@en .

  ontoksd:AssessmentOccurrence_Task25.20 a ontoksd:AssessmentOccurrence ;
    rdfs:label "Assessment occurrence for Task25.20"@en ;
    ontoksd:realizes ontoksd:Assessment_Task25.20 ;
    ontoksd:occursInAcquisitionContext ontoksd:AC_Task25.20 ;
    ontoksd:producesEvidence ontoksd:Evidence_Task25.20_SourceCode ,
                             ontoksd:Evidence_Task25.20_ProgramExecution ,
                             ontoksd:Evidence_Task25.20_IndividualOralExplanation ;
    rdfs:comment "Concrete assessment occurrence that produces evidence from the source-code artifact, execution of the program, and each learner's individual oral explanation."@en .

  ontoksd:Evidence_Task25.20_SourceCode a ontoksd:Evidence ;
    rdfs:label "Task25.20 source-code evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:Project_Artifact ;
    rdfs:comment "Artifact-level evidence consisting of the source code of the implemented Tic-Tac-Toe game. It may be collaboratively produced and therefore should not, by itself, be treated as sufficient learner-specific evidence of conceptual understanding or authorship."@en .

  ontoksd:Evidence_Task25.20_ProgramExecution a ontoksd:Evidence ;
    rdfs:label "Task25.20 program-execution evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:evSimulationResult ;
    rdfs:comment "Performance-level evidence consisting of program execution under representative scenarios, including valid moves, invalid inputs, victory cases, draw cases, and termination behavior."@en .

  ontoksd:Evidence_Task25.20_IndividualOralExplanation a ontoksd:Evidence ;
    rdfs:label "Task25.20 individual oral-explanation evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:SelfReported ;
    rdfs:comment "Learner-level evidence consisting of each learner's oral explanation, justification, and execution tracing of the implemented solution. This evidence supports learner-specific interpretation of understanding, authorship, and ethical accountability."@en .

}
