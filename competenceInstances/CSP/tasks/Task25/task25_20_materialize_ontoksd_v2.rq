PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX dc:        <http://purl.org/dc/elements/1.1/>
PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <https://csed.acm.org/knowledge-area/>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.20 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.20 — Tic-Tac-Toe Implementation"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.20 in the Programming Logic course of the Integrated Technical Program in Informatics at IFBA — Valença Campus. This context frames an introductory programming task in which learners collaboratively implement a complete 3x3 Tic-Tac-Toe game and individually explain the implemented solution through an oral defense, making visible both artifact-level and learner-specific evidence of competence."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.20 a ontoksd:LearningTask ;
    rdfs:label "Task25.20 — Tic-Tac-Toe Implementation (3x3)"@en ;
    dcterms:title "Task25.20 — Tic-Tac-Toe Implementation (3x3)"@en ;
    dc:description "Learning task in which learners design, implement, test, debug, and orally explain a complete 3x3 Tic-Tac-Toe game using structured programming concepts such as board representation, conditionals, loops, functions, input validation, state consistency, and execution tracing."@en ;
    rdfs:comment "Task25.20 is an introductory structured-programming learning task. Learners must implement a complete Tic-Tac-Toe game for two human players, represent the board, validate inputs, enforce legal moves, alternate turns, detect victory and draw situations, display the board state, test and debug the implementation, and individually explain the structure, decisions, and execution flow of the solution. The task is collaborative at the artifact-production level, but includes individual oral explanation as learner-level evidence of conceptual understanding, authorship, and accountability."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.20 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.20_CT25.20.1 ,
                                 ontoksd:CA_Task25.20_CT25.20.2 ,
                                 ontoksd:CA_Task25.20_CT25.20.3 ,
                                 ontoksd:CA_Task25.20_CT25.20.4 ,
                                 ontoksd:CA_Task25.20_CT25.20.5 ,
                                 ontoksd:CA_Task25.20_CT25.20.6 .

  #################################################################
  # Competence specifications
  #################################################################

  ontoksd:CT25.20.1 a ontoksd:Competence ;
    rdfs:label "CT25.20.1 — Analyze a programming problem and derive implementable requirements"@en ;
    dcterms:title "Analyze a programming problem and derive implementable requirements"@en ;
    dc:description "This competence involves analyzing a concrete computational problem in order to identify relevant rules, constraints, and expected behaviors, transforming them into implementable requirements that guide design and coding decisions."@en ;
    rdfs:comment "In Task25.20, this competence is demonstrated when the learner identifies valid moves, turn alternation, victory conditions, draw situations, and termination criteria for the Tic-Tac-Toe program."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:investigative ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.20.1_AlgorithmicReasoning_Analyzing ,
                              ontoksd:KS_CT25.20.1_ProblemDecomposition_Analyzing .

  ontoksd:CT25.20.2 a ontoksd:Competence ;
    rdfs:label "CT25.20.2 — Represent information and program state using structured data formats"@en ;
    dcterms:title "Represent information and program state using structured data formats"@en ;
    dc:description "This competence involves modeling relevant elements of a problem domain using appropriate structured data representations, so that program information can be stored, accessed, updated, and interpreted consistently."@en ;
    rdfs:comment "In Task25.20, this competence is demonstrated when the learner represents the Tic-Tac-Toe board and its evolving state through lists, nested lists, matrices, or equivalent indexed structures."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:collaborative ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.20.2_DataStructures_Applying ,
                              ontoksd:KS_CT25.20.2_StateRepresentation_Applying ,
                              ontoksd:KS_CT25.20.2_AnalyticalThinking_Analyzing .

  ontoksd:CT25.20.3 a ontoksd:Competence ;
    rdfs:label "CT25.20.3 — Control program execution using conditional and repetition structures"@en ;
    dcterms:title "Control program execution using conditional and repetition structures"@en ;
    dc:description "This competence involves controlling the dynamic behavior of a program by applying conditional and repetition structures that govern decisions, iteration, and termination."@en ;
    rdfs:comment "In Task25.20, this competence is demonstrated when the learner uses conditionals and loops to alternate turns, validate whether actions can proceed, maintain the game cycle, and terminate execution when a winning or draw condition is reached."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:persistent , ontoksd:collaborative ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.20.3_ControlAbstraction_Applying ,
                              ontoksd:KS_CT25.20.3_Iteration_Applying ,
                              ontoksd:KS_CT25.20.3_LogicalReasoning_Applying .

  ontoksd:CT25.20.4 a ontoksd:Competence ;
    rdfs:label "CT25.20.4 — Decompose programs into cohesive and independent functions"@en ;
    dcterms:title "Decompose programs into cohesive and independent functions"@en ;
    dc:description "This competence involves structuring a program modularly by decomposing a computational solution into coherent functions with clearly delimited responsibilities."@en ;
    rdfs:comment "In Task25.20, this competence is demonstrated through functions for displaying the board, reading moves, validating actions, checking outcomes, and coordinating the main game loop."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:collaborative ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.20.4_SoftwareDesign_Creating ,
                              ontoksd:KS_CT25.20.4_ProblemDecomposition_Applying ,
                              ontoksd:KS_CT25.20.4_VariableScope_Applying .

  ontoksd:CT25.20.5 a ontoksd:Competence ;
    rdfs:label "CT25.20.5 — Test and debug programs using representative scenarios and execution tracing"@en ;
    dcterms:title "Test and debug programs using representative scenarios and execution tracing"@en ;
    dc:description "This competence involves verifying program behavior systematically, identifying faults, and refining the implementation through testing, debugging, and execution tracing."@en ;
    rdfs:comment "In Task25.20, this competence is demonstrated when the learner tests valid moves, invalid inputs, victory conditions, draw situations, and unexpected behaviors, correcting logical or runtime problems when found."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:persistent , ontoksd:meticulous ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.20.5_Testing_Applying ,
                              ontoksd:KS_CT25.20.5_Debugging_Applying ,
                              ontoksd:KS_CT25.20.5_ExecutionTracing_Analyzing .

  ontoksd:CT25.20.6 a ontoksd:Competence ;
    rdfs:label "CT25.20.6 — Explain and justify computational solutions with ethical authorship"@en ;
    dcterms:title "Explain and justify computational solutions with ethical authorship"@en ;
    dc:description "This competence involves explaining, justifying, and defending a computational solution, demonstrating conceptual understanding, clear communication, and ethical responsibility for the produced artifact."@en ;
    rdfs:comment "In Task25.20, this competence is demonstrated when each learner orally explains the structure and behavior of the implemented program, justifies implementation decisions, traces execution flow, and accounts honestly for their own contribution to the collaborative work."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:professionalCompetenceScope ;
    ontoksd:hasDisposition ontoksd:ethical , ontoksd:communicative , ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.20.6_TechnicalProgrammingVocabulary_Understanding ,
                              ontoksd:KS_CT25.20.6_LogicalExplanation_Applying ,
                              ontoksd:KS_CT25.20.6_OralCommunication_Applying ,
                              ontoksd:KS_CT25.20.6_EthicalAuthorship_Applying .

