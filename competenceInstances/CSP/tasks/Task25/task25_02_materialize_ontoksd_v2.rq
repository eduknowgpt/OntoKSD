PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ontoksd: <http://purl.org/ontoksd#>

INSERT DATA {

  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.02 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.02 — Labirinto do Minotauro"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.02 in MATC94 – Introdução às Linguagens Formais e Teoria da Computação. This context frames a problem-based learning task centered on formal navigation with return, expressive limits of finite automata, pushdown automata, context-free grammars, and validation with JFLAP."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.02 a ontoksd:LearningTask ;
    rdfs:label "Task25.02 — Labirinto do Minotauro"@pt ;
    dcterms:title "Task25.02 — Labirinto do Minotauro"@pt ;
    dc:description "Learning task in which learners formally model navigation in a labyrinth where an agent must reach a destination and return to the origin, demonstrate the insufficiency of finite automata, construct a pushdown automaton, specify an equivalent context-free grammar, validate the models in JFLAP, and document the solution through mathematically rigorous argumentation."@en ;
    rdfs:comment "Task25.02 is a formal-language and automata-oriented learning task in which learners model the navigation of Theseus in the labyrinth as a language problem requiring memory of the route taken. The task requires symbolic abstraction of movements and routes, formal characterization of valid and invalid navigation strings, justification of the expressive limits of finite automata, construction of a pushdown automaton using stack memory, specification of an equivalent context-free grammar, simulation-based validation in JFLAP, and a technically rigorous report explaining correctness, expressive power, and equivalence of models."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.02 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.02_C18 ,
                                 ontoksd:CA_Task25.02_C17 ,
                                 ontoksd:CA_Task25.02_C02 ,
                                 ontoksd:CA_Task25.02_C14 ,
                                 ontoksd:CA_Task25.02_C22 ,
                                 ontoksd:CA_Task25.02_C13.01 ,
                                 ontoksd:CA_Task25.02_C05.01 ,
                                 ontoksd:CA_Task25.02_C03 ,
                                 ontoksd:CA_Task25.02_C19 .

  #################################################################
  # Competence activations
  #################################################################

  ontoksd:CA_Task25.02_C18 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C18 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C18 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C18 is activated in Task25.02 as a core constructive competence because learners must map positions, movements, and routes in the labyrinth to symbols, strings, and languages in order to establish the formal representation of the navigation problem."@en .

  ontoksd:CA_Task25.02_C17 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C17 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C17 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C17 is activated in Task25.02 as a core analytical competence because the task requires navigation strings to be analyzed through concatenation, decomposition, prefixes, suffixes, and recursive structure in order to distinguish valid and invalid go-and-return paths."@en .

  ontoksd:CA_Task25.02_C02 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C02 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C02 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C02 is activated in Task25.02 as a mandatory supporting competence because learners must formally demonstrate the insufficiency of finite automata for arbitrary return navigation and justify, by contrast, the need for a model with structured memory."@en .

  ontoksd:CA_Task25.02_C14 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C14 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C14 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C14 is activated in Task25.02 as a mandatory supporting competence because the task requires learners to differentiate regular and context-free expressive classes and justify why navigation with return must be treated through a context-free grammar and a recognizer with memory."@en .

  ontoksd:CA_Task25.02_C22 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C22 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C22 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C22 is activated in Task25.02 as a mandatory supporting competence because learners must construct a context-free grammar equivalent to the pushdown automaton and formalize the generative specification of valid navigation routes."@en .

  ontoksd:CA_Task25.02_C13.01 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C13.01 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C13.01 ;
    ontoksd:hasActivationRole ontoksd:arTransversal ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C13.01 is activated in Task25.02 as a transversal analytical competence because learners must interpret context-free grammars, nonterminals, production rules, and formal derivations in order to specify the navigation language and explain its relation to the pushdown automaton."@en .

  ontoksd:CA_Task25.02_C05.01 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C05.01 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C05_01 ;
    ontoksd:hasActivationRole ontoksd:arTransversal ;
    ontoksd:hasActivationMode ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C05.01 is activated in Task25.02 as a transversal justificatory competence because the task requires a mathematically rigorous report explaining the limits of finite automata, the correctness of the pushdown automaton, the equivalence with the context-free grammar, and the expressive status of the models used."@en .

  ontoksd:CA_Task25.02_C03 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C03 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C03 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amArtifactOriented ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C03 is activated in Task25.02 as a mandatory supporting competence because the task explicitly requires JFLAP-based validation of the pushdown automaton and simulation-supported analysis of the formal models against selected test strings."@en .

  ontoksd:CA_Task25.02_C19 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C19 in Task25.02"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.02 ;
    ontoksd:mediatesCompetence ontoksd:C19 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acConditional ;
    rdfs:comment "C19 is activated in Task25.02 as a conditional supporting competence when learners explicitly formalize the codification between spatial movement in the labyrinth and symbolic route strings, although such codification does not constitute the core of the task."@en .

}
