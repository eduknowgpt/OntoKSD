  #################################################################
  # Assessment and evidence specification
  #################################################################

  ontoksd:Assessment_Task25.22 a ontoksd:Assessment ;
    rdfs:label "Assessment specification for Task25.22"@en ;
    dcterms:title "Assessment specification for Task25.22"@en ;
    dc:description "Assessment specification for the written natural-language algorithm descriptions, progressive refinement notes, and oral explanation associated with Task25.22."@en ;
    ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentType ;
    rdfs:comment "The assessment design distinguishes artifact-level evidence, performance-level evidence, and learner-level oral explanation. This preserves the distinction between written algorithmic artifacts that may be collaboratively produced and learner-specific evidence of understanding, reasoning, and authorship."@en .

  ontoksd:AssessmentOccurrence_Task25.22 a ontoksd:AssessmentOccurrence ;
    rdfs:label "Assessment occurrence for Task25.22"@en ;
    ontoksd:realizes ontoksd:Assessment_Task25.22 ;
    ontoksd:occursInAcquisitionContext ontoksd:AC_Task25.22 ;
    ontoksd:producesEvidence ontoksd:Evidence_Task25.22_WrittenAlgorithmDescriptions ,
                             ontoksd:Evidence_Task25.22_ProgressiveRefinementNotes ,
                             ontoksd:Evidence_Task25.22_OralExplanation ;
    rdfs:comment "Concrete assessment occurrence that produces evidence from written natural-language algorithms, progressive refinement notes, and each learner's oral explanation of record processing, counters, conditions, aggregations, and solution improvements."@en .

  ontoksd:Evidence_Task25.22_WrittenAlgorithmDescriptions a ontoksd:Evidence ;
    rdfs:label "Task25.22 written natural-language algorithm descriptions"@en ;
    ontoksd:hasEvidenceType ontoksd:Project_Artifact ;
    rdfs:comment "Artifact-level evidence consisting of the written solution for each challenge, including the organization of steps, counters, conditions, calculations, and final outputs in natural language."@en .

  ontoksd:Evidence_Task25.22_ProgressiveRefinementNotes a ontoksd:Evidence ;
    rdfs:label "Task25.22 progressive refinement notes"@en ;
    ontoksd:hasEvidenceType ontoksd:Project_Artifact ;
    rdfs:comment "Performance-level evidence showing how learners reuse, adapt, extend, and improve previous algorithmic descriptions as new fields, conditions, and expected outputs are introduced across the progressive challenges."@en .

  ontoksd:Evidence_Task25.22_OralExplanation a ontoksd:Evidence ;
    rdfs:label "Task25.22 oral explanation evidence"@en ;
    ontoksd:hasEvidenceType ontoksd:SelfReported ;
    rdfs:comment "Learner-level evidence consisting of each learner's oral explanation and justification of the written algorithm, including counters, conditions, calculations, potential errors, and improvements. This evidence supports learner-specific interpretation of understanding, especially when written artifacts are collaborative or supported by tools."@en .

}
