PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX dc:        <http://purl.org/dc/elements/1.1/>
PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX bloom:     <http://purl.org/edu/bloom#>
PREFIX cs2023:    <https://csed.acm.org/knowledge-area/>
PREFIX cc2020found: <http://purl.org/cc2020/foundational#>

INSERT DATA {

  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.22 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.22 — School Census and Computational Thinking in Natural Language"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.22 in an introductory computing context of the Integrated Technical Program in Informatics. The context frames a natural-language computational-thinking task in which learners describe algorithms for processing school census records, progressively refine solutions, and orally explain record fields, counters, conditions, aggregations, and algorithmic reasoning."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.22 a ontoksd:LearningTask ;
    rdfs:label "Task25.22 — School Census and Computational Thinking in Natural Language"@en ;
    dcterms:title "Task25.22 — School Census and Computational Thinking in Natural Language"@en ;
    dc:description "Learning task in which learners describe, in natural language, algorithms for processing a school census dataset containing student records with fields such as name, sex, myopia, hypermetropia, and astigmatism. Learners specify ordered steps for reading records, updating counters, applying simple and composite conditions, calculating totals, averages, and proportions, and progressively refining previous solutions."@en ;
    rdfs:comment "Task25.22 is an introductory computational-thinking and algorithms learning task without code implementation. It emphasizes algorithmic description before programming, using natural language to make visible how a computer could process records one by one, classify information, update counters, aggregate results, reuse and adapt previous solutions, review logical correctness, and explain reasoning orally. The written artifact may be individual or collaborative, while the oral explanation supports learner-specific evidence of understanding."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.22 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.22_CT25.22.1 ,
                                 ontoksd:CA_Task25.22_CT25.22.2 ,
                                 ontoksd:CA_Task25.22_CT25.22.3 ,
                                 ontoksd:CA_Task25.22_CT25.22.4 ,
                                 ontoksd:CA_Task25.22_CT25.22.5 ,
                                 ontoksd:CA_Task25.22_CT25.22.6 .

  #################################################################
  # Competence specifications
  #################################################################

  ontoksd:CT25.22.1 a ontoksd:Competence ;
    rdfs:label "CT25.22.1 — Identify and structure data records for algorithmic processing"@en ;
    dcterms:title "Identify and structure data records for algorithmic processing"@en ;
    dc:description "This competence involves recognizing that information can be organized as structured records composed of fields and values, and identifying which fields are required to solve a computational problem."@en ;
    rdfs:comment "In Task25.22, this competence is demonstrated when learners identify and structure fields such as Name, Sex, Myopia, Hypermetropia, and Astigmatism before describing the algorithmic processing of the school census."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:investigative ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.22.1_DataRecords_Understanding ,
                              ontoksd:KS_CT25.22.1_FieldsAndValues_Applying ,
                              ontoksd:KS_CT25.22.1_StructuredInformation_Applying .

  ontoksd:CT25.22.2 a ontoksd:Competence ;
    rdfs:label "CT25.22.2 — Describe algorithms in natural language using ordered steps"@en ;
    dcterms:title "Describe algorithms in natural language using ordered steps"@en ;
    dc:description "This competence involves describing an algorithm clearly in natural language, organizing actions in a logical sequence that can be understood by another person and later translated into code."@en ;
    rdfs:comment "In Task25.22, this competence is demonstrated when learners explain how to initialize counters, process student records one by one, check fields, update results, and present final outputs using clear ordered steps."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:communicative , ontoksd:systematic ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.22.2_NaturalLanguageAlgorithmDescription_Understanding ,
                              ontoksd:KS_CT25.22.2_SequentialProcessing_Applying ,
                              ontoksd:KS_CT25.22.2_StepByStepReasoning_Applying .

  ontoksd:CT25.22.3 a ontoksd:Competence ;
    rdfs:label "CT25.22.3 — Count and aggregate information from structured records"@en ;
    dcterms:title "Count and aggregate information from structured records"@en ;
    dc:description "This competence involves using counters and accumulators to compute totals, averages, or proportions from structured data records."@en ;
    rdfs:comment "In Task25.22, this competence is demonstrated when learners describe how to count students by sex and visual condition, update accumulators, and calculate proportions for groups and subgroups."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:responsible ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.22.3_Counters_Applying ,
                              ontoksd:KS_CT25.22.3_Accumulators_Applying ,
                              ontoksd:KS_CT25.22.3_AveragesAndProportions_Applying .

  ontoksd:CT25.22.4 a ontoksd:Competence ;
    rdfs:label "CT25.22.4 — Classify records using simple and composite conditions"@en ;
    dcterms:title "Classify records using simple and composite conditions"@en ;
    dc:description "This competence involves applying simple and composite logical conditions to classify records and decide which counters or results must be updated."@en ;
    rdfs:comment "In Task25.22, this competence is demonstrated when learners distinguish students with myopia, hypermetropia, at least one visual condition, or combined conditions using if, else, AND, and OR."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:meticulous , ontoksd:analytical ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.22.4_SimpleConditions_Applying ,
                              ontoksd:KS_CT25.22.4_CompositeConditions_Applying ,
                              ontoksd:KS_CT25.22.4_LogicalOperators_Applying .

  ontoksd:CT25.22.5 a ontoksd:Competence ;
    rdfs:label "CT25.22.5 — Adapt and generalize natural-language algorithms across progressive requirements"@en ;
    dcterms:title "Adapt and generalize natural-language algorithms across progressive requirements"@en ;
    dc:description "This competence involves reusing and adapting an existing algorithmic description as new fields, conditions, and expected outputs are added."@en ;
    rdfs:comment "In Task25.22, this competence is demonstrated when learners progressively extend the algorithm from sex-based counting to classification by one, two, and three visual conditions, refining the structure instead of restarting from zero."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:computingSpecificCompetenceScope ;
    ontoksd:hasDisposition ontoksd:reflective , ontoksd:persistent , ontoksd:systematic ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.22.5_SolutionReuse_Applying ,
                              ontoksd:KS_CT25.22.5_Generalization_Analyzing ,
                              ontoksd:KS_CT25.22.5_SolutionRefinement_Analyzing .

  ontoksd:CT25.22.6 a ontoksd:Competence ;
    rdfs:label "CT25.22.6 — Review and explain algorithmic solutions with technical clarity"@en ;
    dcterms:title "Review and explain algorithmic solutions with technical clarity"@en ;
    dc:description "This competence involves reviewing an algorithmic solution to identify logical errors, unnecessary repetitions, or opportunities for simplification, and explaining the solution clearly using appropriate technical vocabulary."@en ;
    rdfs:comment "In Task25.22, this competence is demonstrated when learners orally explain written algorithms, justify counters and conditions, answer questions about the solution logic, and identify possible errors or improvements."@en ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    ontoksd:hasSpecificationPattern ontoksd:CC2020SpecificationPattern ;
    ontoksd:hasCompetenceScope ontoksd:professionalCompetenceScope ;
    ontoksd:hasDisposition ontoksd:communicative , ontoksd:responsible , ontoksd:reflective ;
    ontoksd:hasKnowledgeSkill ontoksd:KS_CT25.22.6_AlgorithmReview_Analyzing ,
                              ontoksd:KS_CT25.22.6_TechnicalVocabulary_Understanding ,
                              ontoksd:KS_CT25.22.6_OralExplanation_Applying .

