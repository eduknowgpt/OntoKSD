  #################################################################
  # Competence activations
  #################################################################

  ontoksd:CA_Task25.22_CT25.22.1 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.22.1 in Task25.22"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.22 ;
    ontoksd:mediatesCompetence ontoksd:CT25.22.1 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amInterpretative ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.22.1 is activated as a mandatory core interpretative competence because the task begins with identifying which fields and values are required in each student record before any algorithmic processing can be described."@en .

  ontoksd:CA_Task25.22_CT25.22.2 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.22.2 in Task25.22"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.22 ;
    ontoksd:mediatesCompetence ontoksd:CT25.22.2 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amDescriptive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.22.2 is activated as a mandatory core descriptive competence because the task requires learners to express algorithms in natural language through clear ordered steps rather than code."@en .

  ontoksd:CA_Task25.22_CT25.22.3 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.22.3 in Task25.22"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.22 ;
    ontoksd:mediatesCompetence ontoksd:CT25.22.3 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.22.3 is activated as a mandatory core constructive competence because learners must construct a counting and aggregation strategy using counters, accumulators, totals, averages, and proportions."@en .

  ontoksd:CA_Task25.22_CT25.22.4 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.22.4 in Task25.22"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.22 ;
    ontoksd:mediatesCompetence ontoksd:CT25.22.4 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.22.4 is activated as a mandatory core analytical competence because learners must classify records using simple and composite conditions and reason about how each condition affects counters and results."@en .

  ontoksd:CA_Task25.22_CT25.22.5 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.22.5 in Task25.22"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.22 ;
    ontoksd:mediatesCompetence ontoksd:CT25.22.5 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructiveAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.22.5 is activated as a mandatory core constructive-analytical competence because each challenge extends previous requirements, requiring reuse, adaptation, generalization, and refinement of the natural-language algorithm."@en .

  ontoksd:CA_Task25.22_CT25.22.6 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of CT25.22.6 in Task25.22"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.22 ;
    ontoksd:mediatesCompetence ontoksd:CT25.22.6 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "CT25.22.6 is activated as a mandatory supporting justificatory competence because learners must orally explain the written algorithm, justify counters and conditions, and answer questions about possible errors or improvements."@en .

