PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ontoksd: <http://purl.org/ontoksd#>

INSERT DATA {

  #################################################################
  # Acquisition context
  #################################################################

  ontoksd:AC_Task25.00 a ontoksd:AcquisitionContext ;
    rdfs:label "Acquisition context for Task25.00 — Coleção de Músicas"@en ;
    rdfs:comment "Pedagogically relevant situation for Task25.00 in ILFTC – Introdução às Linguagens Formais e Teoria da Computação. This context frames a theoretical and concept-oriented learning task focused on formal abstraction, algebraic notation for strings and languages, structural analysis of formal languages, conceptual use of regular expressions and recognizers, codification analysis, and mathematically rigorous justification through written answers."@en .

  #################################################################
  # Learning task
  #################################################################

  ontoksd:Task25.00 a ontoksd:LearningTask ;
    rdfs:label "Task25.00 — Coleção de Músicas"@pt ;
    dcterms:title "Task25.00 — Coleção de Músicas"@pt ;
    dc:description "Learning task in which learners abstract musical artefacts as formal representations, model songs as strings and collections of songs as formal languages, apply operations over strings and languages, characterize structural properties, discuss codifications between score and recording, and justify all answers mathematically."@en ;
    rdfs:comment "Task25.00 is a theoretical and concept-oriented learning task in which learners reinterpret musical scores, recordings, and collections of songs through the conceptual framework of formal languages. The task requires explicit formalization of alphabets, strings, and languages; algebraic treatment of operations such as concatenation, reversal, union, intersection, complement, and Kleene closure; conceptual use of regular expressions and finite automata as justificatory tools; analysis of codifications and homomorphisms between symbolic representations; and mathematically rigorous written answers supported by definitions, examples, arguments, and counterexamples. The task does not require implementation, simulation, or operational construction of recognizers."@en ;
    ontoksd:hasAcquisitionContext ontoksd:AC_Task25.00 ;
    ontoksd:hasCompetenceRelator ontoksd:CA_Task25.00_C17 ,
                                 ontoksd:CA_Task25.00_C18 ,
                                 ontoksd:CA_Task25.00_C19 ,
                                 ontoksd:CA_Task25.00_C04 ,
                                 ontoksd:CA_Task25.00_C23 ,
                                 ontoksd:CA_Task25.00_C05.01 ,
                                 ontoksd:CA_Task25.00_C14 ,
                                 ontoksd:CA_Task25.00_C20 .

  #################################################################
  # Competence activations
  #################################################################

  ontoksd:CA_Task25.00_C17 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C17 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C17 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C17 is activated in Task25.00 as a core analytical competence because the task centrally requires the application and analysis of formal operations over strings and languages, including concatenation, reversal, set-theoretic operations, and Kleene closure, together with formal justification of their structural consequences."@en .

  ontoksd:CA_Task25.00_C18 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C18 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C18 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amConstructive ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C18 is activated in Task25.00 as a core constructive competence because learners must abstract a real-world musical domain and construct a formal representation based on alphabets, strings, languages, and explicit modeling assumptions before further formal analysis becomes possible."@en .

  ontoksd:CA_Task25.00_C19 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C19 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C19 ;
    ontoksd:hasActivationRole ontoksd:arSupporting ;
    ontoksd:hasActivationMode ontoksd:amInterpretative ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C19 is activated in Task25.00 as a mandatory supporting competence because the task includes explicit analysis of codification and interchangeability between score and recording representations, requiring conceptual treatment of homomorphisms, preserved structure, and the formal limits of representational equivalence."@en .

  ontoksd:CA_Task25.00_C04 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C04 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C04 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amArtifactOriented ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C04 is activated in Task25.00 as a core artifact-oriented competence because learners may need to specify some collections of songs intentionally through regular expressions. In this task the activation is restricted to conceptual and algebraic use, without requiring the operational construction of automata."@en .

  ontoksd:CA_Task25.00_C23 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C23 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C23 ;
    ontoksd:hasActivationRole ontoksd:arTransversal ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C23 is activated in Task25.00 as a transversal analytical competence because algebraic notation for strings and languages underlies the expression of definitions, operations, closure, symbolic relations, and formal properties across nearly all parts of the task."@en .

  ontoksd:CA_Task25.00_C05.01 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C05.01 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C05_01 ;
    ontoksd:hasActivationRole ontoksd:arTransversal ;
    ontoksd:hasActivationMode ontoksd:amJustificatory ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C05.01 is activated in Task25.00 as a transversal justificatory competence because the task requires mathematically rigorous written answers supported by explicit definitions, examples, counterexamples, and logically structured formal reasoning."@en .

  ontoksd:CA_Task25.00_C14 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C14 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C14 ;
    ontoksd:hasActivationRole ontoksd:arExtension ;
    ontoksd:hasActivationMode ontoksd:amAnalytical ;
    ontoksd:hasActivationConstraint ontoksd:acOptional ;
    rdfs:comment "C14 is activated in Task25.00 as an optional extension competence when learners discuss expressive limits and conceptual distinctions between regular languages and more expressive grammar-based language classes."@en .

  ontoksd:CA_Task25.00_C20 a ontoksd:CompetenceActivation ;
    rdfs:label "Competence activation of C20 in Task25.00"@en ;
    ontoksd:mediatesInstructionalUnit ontoksd:Task25.00 ;
    ontoksd:mediatesCompetence ontoksd:C20 ;
    ontoksd:hasActivationRole ontoksd:arCore ;
    ontoksd:hasActivationMode ontoksd:amIntegrative ;
    ontoksd:hasActivationConstraint ontoksd:acMandatory ;
    rdfs:comment "C20 is activated in Task25.00 as the core integrative competence because the task requires the coordinated integration of formal modeling, algebraic notation, operations over languages, codification analysis, regular-expression-based specification, and mathematically rigorous justification into a coherent treatment of musical collections as formal languages."@en .

}
