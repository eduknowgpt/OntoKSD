PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:   <http://purl.org/dc/terms/>

INSERT DATA {

  #################################################################
  # Task05 — The Farmer Robot and the Feeder Robot
  # Specification-level instructional and assessment structures
  #################################################################

  #################################################################
  # 1. Acquisition Context
  #################################################################

  ontoksd:AC_Task05_FarmerRobotAndFeederRobot a ontoksd:AcquisitionContext ;
      rdfs:label "Task05 Acquisition Context — The Farmer Robot and the Feeder Robot"@en ;
      dcterms:identifier "Task05-AC"^^xsd:string ;
      rdfs:comment "Acquisition context associated with Task05. It represents the pedagogical setting in which learners engage in a problem-based learning activity focused on the integrated modeling, simulation, coordination, and documentation of Farmer Robot and Feeder Robot modules using Turing Machines as a unified formalism. This context includes collaborative work, use of JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

  #################################################################
  # 2. Task
  #################################################################

  ontoksd:Task05_FarmerRobotAndFeederRobot a ontoksd:Task ;
      rdfs:label "Task05 — The Farmer Robot and the Feeder Robot"@en ;
      dcterms:identifier "Task05-TASK"^^xsd:string ;
      rdfs:comment "Specification-level task corresponding to the Farmer Robot and the Feeder Robot PBL case. It represents the problem of integrating identification, signaling, path encoding, and feeder navigation under a unified Turing Machine formalism, with attention to multi-agent coordination, threshold logic, and system-level documentation."@en ;
      ontoksd:hasTaskStatement "Design, simulate, validate, integrate, and document Farmer Robot and Feeder Robot modules using Turing Machines as a unified computational model, including herd-threshold input logic, path communication, and coordinated multi-agent behavior."@en ;
      ontoksd:hasTaskActivity ontoksd:TA_Task05_ModelIntegrateAndValidateTMMultiAgentSystem ;
      ontoksd:hasTaskComponent ontoksd:TC_Task05_FarmerRobotIdentificationModule ,
                               ontoksd:TC_Task05_FarmerRobotNavigationModule ,
                               ontoksd:TC_Task05_FeederRobotNavigationModule ,
                               ontoksd:TC_Task05_PathEncodingAndCommunication ,
                               ontoksd:TC_Task05_IntegratedTuringMachineArtifact ,
                               ontoksd:TC_Task05_TechnicalReport ;
      ontoksd:hasTaskConstraint ontoksd:TCons_Task05_UseUnifiedTuringMachineFormalism ,
                                ontoksd:TCons_Task05_CoordinateMultipleAgents ,
                                ontoksd:TCons_Task05_CommunicatePathToFeederRobot ,
                                ontoksd:TCons_Task05_ReviseHerdThresholdInput ,
                                ontoksd:TCons_Task05_SimulatorExecution ,
                                ontoksd:TCons_Task05_ProcessDocumentation ,
                                ontoksd:TCons_Task05_StandardizeDocumentationAndTraining .

  ontoksd:TA_Task05_ModelIntegrateAndValidateTMMultiAgentSystem a ontoksd:TaskActivity ;
      rdfs:label "Model, integrate, simulate, validate, and document a multi-agent system using Turing Machines"@en ;
      rdfs:comment "Core task activity of Task05. It represents the central activity through which learners analyze inter-robot requirements, revise previous modules, design an integrated Turing-Machine-based architecture, simulate the coordinated behavior, and document the resulting system."@en .

  ontoksd:TC_Task05_FarmerRobotIdentificationModule a ontoksd:TaskComponent ;
      rdfs:label "Farmer Robot identification and signaling module"@en ;
      rdfs:comment "Task component representing the enhanced Farmer Robot module responsible for herd-related identification and food-delivery signaling, including threshold input logic."@en .

  ontoksd:TC_Task05_FarmerRobotNavigationModule a ontoksd:TaskComponent ;
      rdfs:label "Farmer Robot navigation module"@en ;
      rdfs:comment "Task component representing the Farmer Robot navigation behavior within the integrated system."@en .

  ontoksd:TC_Task05_FeederRobotNavigationModule a ontoksd:TaskComponent ;
      rdfs:label "Feeder Robot navigation module"@en ;
      rdfs:comment "Task component representing the Feeder Robot navigation behavior driven by communicated path information."@en .

  ontoksd:TC_Task05_PathEncodingAndCommunication a ontoksd:TaskComponent ;
      rdfs:label "Path encoding and inter-robot communication"@en ;
      rdfs:comment "Task component representing the encoding and communication of path information from the Farmer Robot to the Feeder Robot."@en .

  ontoksd:TC_Task05_IntegratedTuringMachineArtifact a ontoksd:TaskComponent ;
      rdfs:label "Integrated Turing Machine artifact"@en ;
      rdfs:comment "Task component representing the unified Turing-Machine-based computational artifact covering integrated multi-agent behavior."@en .

  ontoksd:TC_Task05_TechnicalReport a ontoksd:TaskComponent ;
      rdfs:label "Technical report"@en ;
      rdfs:comment "Task component representing the structured technical report required to explain module interaction, tape and state design, coordination logic, and justification of design choices."@en .

  ontoksd:TCons_Task05_UseUnifiedTuringMachineFormalism a ontoksd:TaskConstraint ;
      rdfs:label "Use a unified Turing Machine formalism"@en ;
      rdfs:comment "Constraint stating that the same abstract machine model must be used to implement the integrated robot modules."@en .

  ontoksd:TCons_Task05_CoordinateMultipleAgents a ontoksd:TaskConstraint ;
      rdfs:label "Coordinate Farmer Robot and Feeder Robot behaviors"@en ;
      rdfs:comment "Constraint stating that the solution must coordinate the behavior of two interacting robotic agents."@en .

  ontoksd:TCons_Task05_CommunicatePathToFeederRobot a ontoksd:TaskConstraint ;
      rdfs:label "Communicate the path to the Feeder Robot"@en ;
      rdfs:comment "Constraint stating that the Farmer Robot must communicate the path that the Feeder Robot should follow."@en .

  ontoksd:TCons_Task05_ReviseHerdThresholdInput a ontoksd:TaskConstraint ;
      rdfs:label "Allow herd-threshold quantities as input"@en ;
      rdfs:comment "Constraint stating that the previous signaling logic must be revised so that minimum herd quantities can be provided as machine inputs."@en .

  ontoksd:TCons_Task05_SimulatorExecution a ontoksd:TaskConstraint ;
      rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
      rdfs:comment "Constraint stating that the integrated Turing Machine artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

  ontoksd:TCons_Task05_ProcessDocumentation a ontoksd:TaskConstraint ;
      rdfs:label "Document the process through whiteboard and logbook"@en ;
      rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

  ontoksd:TCons_Task05_StandardizeDocumentationAndTraining a ontoksd:TaskConstraint ;
      rdfs:label "Support standardization of documentation and training"@en ;
      rdfs:comment "Constraint stating that the solution should support standardization goals related to system documentation and maintenance-team training."@en .

  #################################################################
  # 3. Learning Task
  #################################################################

  ontoksd:LT_Task05_FarmerRobotAndFeederRobot a ontoksd:LearningTask ;
      rdfs:label "Learning Task — The Farmer Robot and the Feeder Robot"@en ;
      dcterms:identifier "Task05-LT"^^xsd:string ;
      dcterms:description "Concrete instructional unit in which learners analyze multi-agent requirements, revise previous modules, integrate Farmer Robot and Feeder Robot behaviors under a unified Turing Machine formalism, test the system in JFLAP, and document the result."@en ;
      rdfs:comment "Learning task corresponding to Task05. It captures the executable instructional dimension of the Farmer Robot and Feeder Robot case, in which learners perform a bounded but system-level activity oriented toward competence development and demonstration."@en ;
      ontoksd:hasAcquisitionContext ontoksd:AC_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:usesResource ontoksd:ER_Task05_ProblemStatement ,
                           ontoksd:ER_Task05_JFLAP ,
                           ontoksd:ER_Task05_PBLWhiteboard ,
                           ontoksd:ER_Task05_Logbook ,
                           ontoksd:ER_Task05_SBCReportTemplate .

  #################################################################
  # 4. Assessment
  #################################################################

  ontoksd:AS_Task05_FarmerRobotAndFeederRobot a ontoksd:Assessment ;
      rdfs:label "Assessment — Task05 Farmer Robot and Feeder Robot"@en ;
      dcterms:identifier "Task05-AS"^^xsd:string ;
      dcterms:description "Assessment specification based on Task05, intended to evaluate learners through the submitted integrated Turing Machine artifact, simulation-supported validation, and technical report."@en ;
      rdfs:comment "Assessment specification associated with Task05. It represents the evaluative use of the learning task as a basis for judging learner performance through integrated Turing-Machine modeling, multi-agent coordination, simulation, and technical documentation."@en ;
      ontoksd:isBasedOnActivity ontoksd:LT_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:hasAcquisitionContext ontoksd:AC_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType ,
                                       ontoksd:WrittenAssessmentModalityType ;
      ontoksd:usesResource ontoksd:ER_Task05_ProblemStatement ,
                           ontoksd:ER_Task05_JFLAP ,
                           ontoksd:ER_Task05_SBCReportTemplate .

  #################################################################
  # 5. Educational Resources
  #################################################################

  ontoksd:ER_Task05_ProblemStatement a ontoksd:EducationalResource ;
      rdfs:label "Task05 problem statement"@en ;
      dcterms:identifier "Task05-ER1"^^xsd:string ;
      dcterms:description "Problem statement describing the Farmer Robot and the Feeder Robot scenario, its requirements, and expected deliverables."@en ;
      rdfs:comment "Educational resource corresponding to the formal statement of Task05. It frames the problem, constraints, and deliverables guiding both instructional execution and assessment."@en ;
      ontoksd:intendedUse "Instructional framing and requirement interpretation for the learning task and the assessment."^^xsd:string .

  ontoksd:ER_Task05_JFLAP a ontoksd:EducationalResource ;
      rdfs:label "JFLAP simulator"@en ;
      dcterms:identifier "Task05-ER2"^^xsd:string ;
      dcterms:description "Simulation environment used to test, inspect, and validate Turing Machine behavior."@en ;
      rdfs:comment "Educational resource corresponding to the simulator used for operational validation of integrated Turing-Machine models developed in Task05."@en ;
      ontoksd:intendedUse "Simulation, execution, debugging, and validation of Turing Machine artifacts."^^xsd:string .

  ontoksd:ER_Task05_PBLWhiteboard a ontoksd:EducationalResource ;
      rdfs:label "PBL whiteboard"@en ;
      dcterms:identifier "Task05-ER3"^^xsd:string ;
      dcterms:description "Collaborative whiteboard used to document questions, facts, ideas or hypotheses, and actions throughout the PBL process."@en ;
      rdfs:comment "Educational resource used to structure and document collaborative reasoning during the development of the solution."@en ;
      ontoksd:intendedUse "Process documentation and collaborative reasoning support."^^xsd:string .

  ontoksd:ER_Task05_Logbook a ontoksd:EducationalResource ;
      rdfs:label "Task05 logbook"@en ;
      dcterms:identifier "Task05-ER4"^^xsd:string ;
      dcterms:description "Shared document used to record progress, meeting notes, decisions, and challenges encountered during the task."@en ;
      rdfs:comment "Educational resource used to maintain traceability of the development process and collaborative work performed during Task05."@en ;
      ontoksd:intendedUse "Traceability of collaborative work and process recording."^^xsd:string .

  ontoksd:ER_Task05_SBCReportTemplate a ontoksd:EducationalResource ;
      rdfs:label "SBC article-format report template"@en ;
      dcterms:identifier "Task05-ER5"^^xsd:string ;
      dcterms:description "Template or normative reference for preparing the technical report required as a deliverable."@en ;
      rdfs:comment "Educational resource supporting the preparation and standardization of the technical report associated with Task05."@en ;
      ontoksd:intendedUse "Support for technical writing and report standardization."^^xsd:string .

  #################################################################
  # 6. Competence-to-Task Associations
  #################################################################

  ontoksd:C07_01  ontoksd:hasTask ontoksd:Task05_FarmerRobotAndFeederRobot .

  ontoksd:C08_01  ontoksd:hasTask ontoksd:Task05_FarmerRobotAndFeederRobot .

  ontoksd:C09_01  ontoksd:hasTask ontoksd:Task05_FarmerRobotAndFeederRobot .

  ontoksd:C10     ontoksd:hasTask ontoksd:Task05_FarmerRobotAndFeederRobot .

  ontoksd:C05     ontoksd:hasTask ontoksd:Task05_FarmerRobotAndFeederRobot .

  #################################################################
  # 7. Competence Activations
  #################################################################

  ontoksd:CA_Task05_C07_01 a ontoksd:CompetenceRelator ;
      rdfs:label "Task05 Competence Activation — C07.01"@en ;
      rdfs:comment "Competence activation linking Task05 assessment to competence C07.01. It indicates that developing integrated multi-agent solutions using Turing Machines is a core and mandatory target of the assessment."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:mediatesCompetence ontoksd:C07_01 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amConstructive ,
                                ontoksd:amArtifactOriented ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task05_C08_01 a ontoksd:CompetenceRelator ;
      rdfs:label "Task05 Competence Activation — C08.01"@en ;
      rdfs:comment "Competence activation linking Task05 assessment to competence C08.01. It indicates that analyzing the system-level adequacy of Turing Machine variants is a supporting but mandatory target for informed design decisions in the integrated architecture."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:mediatesCompetence ontoksd:C08_01 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical ,
                                ontoksd:amJustificatory ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task05_C09_01 a ontoksd:CompetenceRelator ;
      rdfs:label "Task05 Competence Activation — C09.01"@en ;
      rdfs:comment "Competence activation linking Task05 assessment to competence C09.01. It indicates that applying and coordinating Turing Machine variants in integrated architectures is a core and mandatory target in the architectural configuration of the system."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:mediatesCompetence ontoksd:C09_01 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amConstructive ,
                                ontoksd:amAnalytical ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task05_C10 a ontoksd:CompetenceRelator ;
      rdfs:label "Task05 Competence Activation — C10"@en ;
      rdfs:comment "Competence activation linking Task05 assessment to competence C10. It indicates that testing Turing Machines using simulators is a core and mandatory target of the task."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:mediatesCompetence ontoksd:C10 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amAnalytical ,
                                ontoksd:amArtifactOriented ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task05_C05 a ontoksd:CompetenceRelator ;
      rdfs:label "Task05 Competence Activation — C05"@en ;
      rdfs:comment "Competence activation linking Task05 assessment to competence C05. It indicates that writing a technical report is a core and mandatory target in the evaluative structure of Task05."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task05_FarmerRobotAndFeederRobot ;
      ontoksd:mediatesCompetence ontoksd:C05 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:AS_Task05_FarmerRobotAndFeederRobot
      ontoksd:hasCompetenceActivation ontoksd:CA_Task05_C07_01 ,
                                      ontoksd:CA_Task05_C08_01 ,
                                      ontoksd:CA_Task05_C09_01 ,
                                      ontoksd:CA_Task05_C10 ,
                                      ontoksd:CA_Task05_C05 .

  #################################################################
  # 8. Proficiency Scale, Levels, and Scheme
  #################################################################

  ontoksd:Scale_Task05_0_10 a ontoksd:Scale ;
      rdfs:label "Task05 proficiency scale 0–10"@en ;
      dcterms:identifier "Task05-SCALE"^^xsd:string ;
      rdfs:comment "Continuous numeric scale used in the evaluative interpretation of Task05 performance, ranging from 0.0 to 10.0 with increments of 0.1."@en ;
      ontoksd:minValue "0.0"^^xsd:decimal ;
      ontoksd:maxValue "10.0"^^xsd:decimal ;
      ontoksd:step "0.1"^^xsd:decimal ;
      ontoksd:hasInterval ontoksd:Interval_Task05_Novice ,
                          ontoksd:Interval_Task05_Competent ,
                          ontoksd:Interval_Task05_Advanced .

  ontoksd:PL_Task05_Novice a ontoksd:ProficiencyLevel ;
      rdfs:label "Novice"@en ;
      dcterms:identifier "Task05-PL1"^^xsd:string ;
      rdfs:comment "Proficiency level representing partial, inconsistent, or incorrect performance in the competencies associated with Task05."@en ;
      ontoksd:hasOrdinalPosition "1"^^xsd:int .

  ontoksd:PL_Task05_Competent a ontoksd:ProficiencyLevel ;
      rdfs:label "Competent"@en ;
      dcterms:identifier "Task05-PL2"^^xsd:string ;
      rdfs:comment "Proficiency level representing correct and coherent performance in the competencies associated with Task05."@en ;
      ontoksd:hasOrdinalPosition "2"^^xsd:int .

  ontoksd:PL_Task05_Advanced a ontoksd:ProficiencyLevel ;
      rdfs:label "Advanced"@en ;
      dcterms:identifier "Task05-PL3"^^xsd:string ;
      rdfs:comment "Proficiency level representing integrated, analytically justified, or structurally enriched performance beyond baseline expectations in Task05."@en ;
      ontoksd:hasOrdinalPosition "3"^^xsd:int .

  ontoksd:PS_Task05_ProficiencyScheme a ontoksd:ProficiencyScheme ;
      rdfs:label "Task05 proficiency scheme"@en ;
      dcterms:identifier "Task05-PS"^^xsd:string ;
      rdfs:comment "Proficiency scheme associated with Task05, defining how intervals in the numeric scale are interpreted as proficiency levels."@en ;
      ontoksd:usesScale ontoksd:Scale_Task05_0_10 ;
      ontoksd:definesLevel ontoksd:PL_Task05_Novice ,
                           ontoksd:PL_Task05_Competent ,
                           ontoksd:PL_Task05_Advanced ;
      ontoksd:definesInterval ontoksd:Interval_Task05_Novice ,
                              ontoksd:Interval_Task05_Competent ,
                              ontoksd:Interval_Task05_Advanced .

  ontoksd:Interval_Task05_Novice a ontoksd:ScaleInterval ;
      rdfs:label "Task05 interval — Novice"@en ;
      rdfs:comment "Interval corresponding to the Novice proficiency level in Task05."@en ;
      ontoksd:isIntervalOf ontoksd:Scale_Task05_0_10 ;
      ontoksd:intervalDefinedInScheme ontoksd:PS_Task05_ProficiencyScheme ;
      ontoksd:correspondsToLevel ontoksd:PL_Task05_Novice ;
      ontoksd:lowerBound "0.0"^^xsd:decimal ;
      ontoksd:upperBound "5.0"^^xsd:decimal ;
      ontoksd:includesLower "true"^^xsd:boolean ;
      ontoksd:includesUpper "true"^^xsd:boolean .

  ontoksd:Interval_Task05_Competent a ontoksd:ScaleInterval ;
      rdfs:label "Task05 interval — Competent"@en ;
      rdfs:comment "Interval corresponding to the Competent proficiency level in Task05."@en ;
      ontoksd:isIntervalOf ontoksd:Scale_Task05_0_10 ;
      ontoksd:intervalDefinedInScheme ontoksd:PS_Task05_ProficiencyScheme ;
      ontoksd:correspondsToLevel ontoksd:PL_Task05_Competent ;
      ontoksd:lowerBound "5.0"^^xsd:decimal ;
      ontoksd:upperBound "9.0"^^xsd:decimal ;
      ontoksd:includesLower "false"^^xsd:boolean ;
      ontoksd:includesUpper "true"^^xsd:boolean .

  ontoksd:Interval_Task05_Advanced a ontoksd:ScaleInterval ;
      rdfs:label "Task05 interval — Advanced"@en ;
      rdfs:comment "Interval corresponding to the Advanced proficiency level in Task05."@en ;
      ontoksd:isIntervalOf ontoksd:Scale_Task05_0_10 ;
      ontoksd:intervalDefinedInScheme ontoksd:PS_Task05_ProficiencyScheme ;
      ontoksd:correspondsToLevel ontoksd:PL_Task05_Advanced ;
      ontoksd:lowerBound "9.0"^^xsd:decimal ;
      ontoksd:upperBound "10.0"^^xsd:decimal ;
      ontoksd:includesLower "false"^^xsd:boolean ;
      ontoksd:includesUpper "true"^^xsd:boolean .

}