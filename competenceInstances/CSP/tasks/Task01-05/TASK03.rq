PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:   <http://purl.org/dc/terms/>

INSERT DATA {

  #################################################################
  # Task03 — The Farmer Robot
  # Specification-level instructional and assessment structures
  #################################################################

  #################################################################
  # 1. Acquisition Context
  #################################################################

  ontoksd:AC_Task03_FarmerRobot a ontoksd:AcquisitionContext ;
      rdfs:label "Task03 Acquisition Context — The Farmer Robot"@en ;
      dcterms:identifier "Task03-AC"^^xsd:string ;
      rdfs:comment "Acquisition context associated with Task03. It represents the pedagogical setting in which learners engage in a problem-based learning activity focused on the modeling, simulation, analysis, and documentation of a herd-identification module using Finite State Machines and Regular Expressions. This context includes collaborative work, use of JFLAP, and process documentation through whiteboard and logbook artifacts."@en .

  #################################################################
  # 2. Task
  #################################################################

  ontoksd:Task03_FarmerRobot a ontoksd:Task ;
      rdfs:label "Task03 — The Farmer Robot"@en ;
      dcterms:identifier "Task03-TASK"^^xsd:string ;
      rdfs:comment "Specification-level task corresponding to the Farmer Robot PBL case. It represents the problem of designing a low-cost herd-identification module capable of recognizing bovines, caprines, and swine, triggering feed requests according to predefined thresholds, and supporting documentation and budgeting analysis based on FSM structure."@en ;
      ontoksd:hasTaskStatement "Design, simulate, validate, analyze, and document a herd-identification module using Finite State Machines and Regular Expressions, capable of identifying animal classes, detecting threshold conditions for feed requests, and supporting complexity-based cost estimation."@en ;
      ontoksd:hasTaskActivity ontoksd:TA_Task03_ModelAnalyzeAndValidateFSM ;
      ontoksd:hasTaskComponent ontoksd:TC_Task03_HerdIdentificationModule ,
                               ontoksd:TC_Task03_FSMArtifact ,
                               ontoksd:TC_Task03_RegularExpressionSet ,
                               ontoksd:TC_Task03_TechnicalReport ,
                               ontoksd:TC_Task03_ComplexityAndCostAnalysis ;
      ontoksd:hasTaskConstraint ontoksd:TCons_Task03_AnimalClassification ,
                                ontoksd:TCons_Task03_ThresholdDetection ,
                                ontoksd:TCons_Task03_FeedRequestTrigger ,
                                ontoksd:TCons_Task03_RegularExpressionDocumentation ,
                                ontoksd:TCons_Task03_StateAndTransitionAnalysis ,
                                ontoksd:TCons_Task03_SimulatorExecution ,
                                ontoksd:TCons_Task03_ProcessDocumentation ,
                                ontoksd:TCons_Task03_LowCostConstraint .

  ontoksd:TA_Task03_ModelAnalyzeAndValidateFSM a ontoksd:TaskActivity ;
      rdfs:label "Model, analyze, simulate, validate, and document a herd-identification module using Finite State Machines"@en ;
      rdfs:comment "Core task activity of Task03. It represents the central activity through which learners analyze requirements, model a herd-identification module, generate corresponding regular expressions, investigate structural patterns, validate the solution through simulation, and document the results."@en .

  ontoksd:TC_Task03_HerdIdentificationModule a ontoksd:TaskComponent ;
      rdfs:label "Herd-identification module"@en ;
      rdfs:comment "Task component representing the computational module responsible for recognizing herd categories and supporting feed-request decisions."@en .

  ontoksd:TC_Task03_FSMArtifact a ontoksd:TaskComponent ;
      rdfs:label "Finite State Machine artifact"@en ;
      rdfs:comment "Task component representing the formal Finite State Machine model of the herd-identification module."@en .

  ontoksd:TC_Task03_RegularExpressionSet a ontoksd:TaskComponent ;
      rdfs:label "Regular expression set"@en ;
      rdfs:comment "Task component representing the regular expressions used to document or formalize behaviors corresponding to the FSM solution."@en .

  ontoksd:TC_Task03_TechnicalReport a ontoksd:TaskComponent ;
      rdfs:label "Technical report"@en ;
      rdfs:comment "Task component representing the structured report required to explain design decisions, examples of operation, documentation rationale, and budgeting implications."@en .

  ontoksd:TC_Task03_ComplexityAndCostAnalysis a ontoksd:TaskComponent ;
      rdfs:label "FSM complexity and cost analysis"@en ;
      rdfs:comment "Task component representing the analysis of state and transition complexity and its relation to prototype cost estimation."@en .

  ontoksd:TCons_Task03_AnimalClassification a ontoksd:TaskConstraint ;
      rdfs:label "Identify bovines, caprines, and swine"@en ;
      rdfs:comment "Constraint stating that the solution must identify animal categories relevant to herd management."@en .

  ontoksd:TCons_Task03_ThresholdDetection a ontoksd:TaskConstraint ;
      rdfs:label "Detect herd thresholds"@en ;
      rdfs:comment "Constraint stating that the solution must detect when predefined minimum herd quantities are reached."@en .

  ontoksd:TCons_Task03_FeedRequestTrigger a ontoksd:TaskConstraint ;
      rdfs:label "Trigger feed requests based on herd thresholds"@en ;
      rdfs:comment "Constraint stating that the identification module must support feed-request generation when threshold conditions are satisfied."@en .

  ontoksd:TCons_Task03_RegularExpressionDocumentation a ontoksd:TaskConstraint ;
      rdfs:label "Provide regular expressions as part of documentation"@en ;
      rdfs:comment "Constraint stating that the solution should include regular expressions supporting formal documentation of the FSM behavior."@en .

  ontoksd:TCons_Task03_StateAndTransitionAnalysis a ontoksd:TaskConstraint ;
      rdfs:label "Analyze minimum states and transitions"@en ;
      rdfs:comment "Constraint stating that the task includes analysis of relationships between herd thresholds and the minimum number of states and transitions required in the FSM."@en .

  ontoksd:TCons_Task03_SimulatorExecution a ontoksd:TaskConstraint ;
      rdfs:label "Be executable in JFLAP or equivalent simulator"@en ;
      rdfs:comment "Constraint stating that the FSM artifact must be representable and executable in JFLAP or an equivalent simulation environment."@en .

  ontoksd:TCons_Task03_ProcessDocumentation a ontoksd:TaskConstraint ;
      rdfs:label "Document the process through whiteboard and logbook"@en ;
      rdfs:comment "Constraint stating that the development process must be documented through PBL whiteboard versions and a shared logbook."@en .

  ontoksd:TCons_Task03_LowCostConstraint a ontoksd:TaskConstraint ;
      rdfs:label "Consider low-cost prototype requirements"@en ;
      rdfs:comment "Constraint stating that the proposed solution should support low-cost prototyping, including analysis of structural complexity for budgeting purposes."@en .

  #################################################################
  # 3. Learning Task
  #################################################################

  ontoksd:LT_Task03_FarmerRobot a ontoksd:LearningTask ;
      rdfs:label "Learning Task — The Farmer Robot"@en ;
      dcterms:identifier "Task03-LT"^^xsd:string ;
      dcterms:description "Concrete instructional unit in which learners analyze requirements, model a herd-identification solution using Finite State Machines, derive regular expressions, investigate structural patterns, test the solution in JFLAP, and document the result."@en ;
      rdfs:comment "Learning task corresponding to Task03. It captures the executable instructional dimension of the Farmer Robot case, in which learners are expected to perform a bounded and goal-directed activity oriented toward competence development and demonstration."@en ;
      ontoksd:hasAcquisitionContext ontoksd:AC_Task03_FarmerRobot ;
      ontoksd:usesResource ontoksd:ER_Task03_ProblemStatement ,
                           ontoksd:ER_Task03_JFLAP ,
                           ontoksd:ER_Task03_PBLWhiteboard ,
                           ontoksd:ER_Task03_Logbook ,
                           ontoksd:ER_Task03_SBCReportTemplate .

  #################################################################
  # 4. Assessment
  #################################################################

  ontoksd:AS_Task03_FarmerRobot a ontoksd:Assessment ;
      rdfs:label "Assessment — Task03 Farmer Robot"@en ;
      dcterms:identifier "Task03-AS"^^xsd:string ;
      dcterms:description "Assessment specification based on Task03, intended to evaluate learners through the submitted FSM artifact, corresponding regular expressions, simulation-supported validation, structural analysis, and technical report."@en ;
      rdfs:comment "Assessment specification associated with Task03. It represents the evaluative use of the learning task as a basis for judging learner performance through formal artifacts, structural analysis, and technical documentation."@en ;
      ontoksd:isBasedOnActivity ontoksd:LT_Task03_FarmerRobot ;
      ontoksd:hasAcquisitionContext ontoksd:AC_Task03_FarmerRobot ;
      ontoksd:hasAssessmentTypeConcept ontoksd:ProjectAssessmentStrategyType ,
                                       ontoksd:WrittenAssessmentModalityType ;
      ontoksd:usesResource ontoksd:ER_Task03_ProblemStatement ,
                           ontoksd:ER_Task03_JFLAP ,
                           ontoksd:ER_Task03_SBCReportTemplate .

  #################################################################
  # 5. Educational Resources
  #################################################################

  ontoksd:ER_Task03_ProblemStatement a ontoksd:EducationalResource ;
      rdfs:label "Task03 problem statement"@en ;
      dcterms:identifier "Task03-ER1"^^xsd:string ;
      dcterms:description "Problem statement describing the Farmer Robot scenario, its requirements, and expected deliverables."@en ;
      rdfs:comment "Educational resource corresponding to the formal statement of Task03. It frames the problem, constraints, and deliverables guiding both instructional execution and assessment."@en ;
      ontoksd:intendedUse "Instructional framing and requirement interpretation for the learning task and the assessment."^^xsd:string .

  ontoksd:ER_Task03_JFLAP a ontoksd:EducationalResource ;
      rdfs:label "JFLAP simulator"@en ;
      dcterms:identifier "Task03-ER2"^^xsd:string ;
      dcterms:description "Simulation environment used to test, inspect, and validate Finite State Machine behavior."@en ;
      rdfs:comment "Educational resource corresponding to the simulator used for operational validation of FSM models developed in Task03."@en ;
      ontoksd:intendedUse "Simulation, execution, debugging, and validation of FSM artifacts."^^xsd:string .

  ontoksd:ER_Task03_PBLWhiteboard a ontoksd:EducationalResource ;
      rdfs:label "PBL whiteboard"@en ;
      dcterms:identifier "Task03-ER3"^^xsd:string ;
      dcterms:description "Collaborative whiteboard used to document questions, facts, ideas or hypotheses, and actions throughout the PBL process."@en ;
      rdfs:comment "Educational resource used to structure and document collaborative reasoning during the development of the solution."@en ;
      ontoksd:intendedUse "Process documentation and collaborative reasoning support."^^xsd:string .

  ontoksd:ER_Task03_Logbook a ontoksd:EducationalResource ;
      rdfs:label "Task03 logbook"@en ;
      dcterms:identifier "Task03-ER4"^^xsd:string ;
      dcterms:description "Shared document used to record progress, meeting notes, decisions, and challenges encountered during the task."@en ;
      rdfs:comment "Educational resource used to maintain traceability of the development process and collaborative work performed during Task03."@en ;
      ontoksd:intendedUse "Traceability of collaborative work and process recording."^^xsd:string .

  ontoksd:ER_Task03_SBCReportTemplate a ontoksd:EducationalResource ;
      rdfs:label "SBC article-format report template"@en ;
      dcterms:identifier "Task03-ER5"^^xsd:string ;
      dcterms:description "Template or normative reference for preparing the technical report required as a deliverable."@en ;
      rdfs:comment "Educational resource supporting the preparation and standardization of the technical report associated with Task03."@en ;
      ontoksd:intendedUse "Support for technical writing and report standardization."^^xsd:string .

  #################################################################
  # 6. Competence-to-Task Associations
  #################################################################

  ontoksd:C06  ontoksd:hasTask ontoksd:Task03_FarmerRobot .

  ontoksd:C11  ontoksd:hasTask ontoksd:Task03_FarmerRobot .

  ontoksd:C03  ontoksd:hasTask ontoksd:Task03_FarmerRobot .

  ontoksd:C04  ontoksd:hasTask ontoksd:Task03_FarmerRobot .

  ontoksd:C05  ontoksd:hasTask ontoksd:Task03_FarmerRobot .

  #################################################################
  # 7. Competence Activations
  #################################################################

  ontoksd:CA_Task03_C06 a ontoksd:CompetenceRelator ;
      rdfs:label "Task03 Competence Activation — C06"@en ;
      rdfs:comment "Competence activation linking Task03 assessment to competence C06. It indicates that developing problem-solving solutions using Finite State Machines is a core and mandatory target of the assessment."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task03_FarmerRobot ;
      ontoksd:mediatesCompetence ontoksd:C06 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amConstructive ,
                                ontoksd:amArtifactOriented ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task03_C11 a ontoksd:CompetenceRelator ;
      rdfs:label "Task03 Competence Activation — C11"@en ;
      rdfs:comment "Competence activation linking Task03 assessment to competence C11. It indicates that identifying patterns in Finite State Machines is a supporting but instructionally relevant target, especially for structural analysis, optimization, and budgeting interpretation."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task03_FarmerRobot ;
      ontoksd:mediatesCompetence ontoksd:C11 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arSupporting ;
      ontoksd:hasActivationMode ontoksd:amAnalytical ,
                                ontoksd:amInterpretative ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task03_C03 a ontoksd:CompetenceRelator ;
      rdfs:label "Task03 Competence Activation — C03"@en ;
      rdfs:comment "Competence activation linking Task03 assessment to competence C03. It indicates that testing automata using simulators is a core and mandatory target of the task."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task03_FarmerRobot ;
      ontoksd:mediatesCompetence ontoksd:C03 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amAnalytical ,
                                ontoksd:amArtifactOriented ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task03_C04 a ontoksd:CompetenceRelator ;
      rdfs:label "Task03 Competence Activation — C04"@en ;
      rdfs:comment "Competence activation linking Task03 assessment to competence C04. It indicates that defining regular expressions for finite automata is a core and mandatory target in this task because regular-expression formulation is part of the expected deliverables and documentation."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task03_FarmerRobot ;
      ontoksd:mediatesCompetence ontoksd:C04 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amConstructive ,
                                ontoksd:amJustificatory ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:CA_Task03_C05 a ontoksd:CompetenceRelator ;
      rdfs:label "Task03 Competence Activation — C05"@en ;
      rdfs:comment "Competence activation linking Task03 assessment to competence C05. It indicates that writing a technical report is a core and mandatory target in the evaluative structure of Task03."@en ;
      ontoksd:mediatesInstructionalUnit ontoksd:AS_Task03_FarmerRobot ;
      ontoksd:mediatesCompetence ontoksd:C05 ;
      ontoksd:hasActivationFunction ontoksd:targetFunction ;
      ontoksd:hasActivationRole ontoksd:arCore ;
      ontoksd:hasActivationMode ontoksd:amArtifactOriented ;
      ontoksd:hasActivationConstraint ontoksd:acMandatory .

  ontoksd:AS_Task03_FarmerRobot
      ontoksd:hasCompetenceActivation ontoksd:CA_Task03_C06 ,
                                      ontoksd:CA_Task03_C11 ,
                                      ontoksd:CA_Task03_C03 ,
                                      ontoksd:CA_Task03_C04 ,
                                      ontoksd:CA_Task03_C05 .

  #################################################################
  # 8. Proficiency Scale, Levels, and Scheme
  #################################################################

  ontoksd:Scale_Task03_0_10 a ontoksd:Scale ;
      rdfs:label "Task03 proficiency scale 0–10"@en ;
      dcterms:identifier "Task03-SCALE"^^xsd:string ;
      rdfs:comment "Continuous numeric scale used in the evaluative interpretation of Task03 performance, ranging from 0.0 to 10.0 with increments of 0.1."@en ;
      ontoksd:minValue "0.0"^^xsd:decimal ;
      ontoksd:maxValue "10.0"^^xsd:decimal ;
      ontoksd:step "0.1"^^xsd:decimal ;
      ontoksd:hasInterval ontoksd:Interval_Task03_Novice ,
                          ontoksd:Interval_Task03_Competent ,
                          ontoksd:Interval_Task03_Advanced .

  ontoksd:PL_Task03_Novice a ontoksd:ProficiencyLevel ;
      rdfs:label "Novice"@en ;
      dcterms:identifier "Task03-PL1"^^xsd:string ;
      rdfs:comment "Proficiency level representing incomplete or incorrect performance in the competencies associated with Task03."@en ;
      ontoksd:hasOrdinalPosition "1"^^xsd:int .

  ontoksd:PL_Task03_Competent a ontoksd:ProficiencyLevel ;
      rdfs:label "Competent"@en ;
      dcterms:identifier "Task03-PL2"^^xsd:string ;
      rdfs:comment "Proficiency level representing accurate and coherent performance in the competencies associated with Task03."@en ;
      ontoksd:hasOrdinalPosition "2"^^xsd:int .

  ontoksd:PL_Task03_Advanced a ontoksd:ProficiencyLevel ;
      rdfs:label "Advanced"@en ;
      dcterms:identifier "Task03-PL3"^^xsd:string ;
      rdfs:comment "Proficiency level representing optimized or analytically enriched performance beyond baseline expectations in Task03."@en ;
      ontoksd:hasOrdinalPosition "3"^^xsd:int .

  ontoksd:PS_Task03_ProficiencyScheme a ontoksd:ProficiencyScheme ;
      rdfs:label "Task03 proficiency scheme"@en ;
      dcterms:identifier "Task03-PS"^^xsd:string ;
      rdfs:comment "Proficiency scheme associated with Task03, defining how intervals in the numeric scale are interpreted as proficiency levels."@en ;
      ontoksd:usesScale ontoksd:Scale_Task03_0_10 ;
      ontoksd:definesLevel ontoksd:PL_Task03_Novice ,
                           ontoksd:PL_Task03_Competent ,
                           ontoksd:PL_Task03_Advanced ;
      ontoksd:definesInterval ontoksd:Interval_Task03_Novice ,
                              ontoksd:Interval_Task03_Competent ,
                              ontoksd:Interval_Task03_Advanced .

  ontoksd:Interval_Task03_Novice a ontoksd:ScaleInterval ;
      rdfs:label "Task03 interval — Novice"@en ;
      rdfs:comment "Interval corresponding to the Novice proficiency level in Task03."@en ;
      ontoksd:isIntervalOf ontoksd:Scale_Task03_0_10 ;
      ontoksd:intervalDefinedInScheme ontoksd:PS_Task03_ProficiencyScheme ;
      ontoksd:correspondsToLevel ontoksd:PL_Task03_Novice ;
      ontoksd:lowerBound "0.0"^^xsd:decimal ;
      ontoksd:upperBound "5.0"^^xsd:decimal ;
      ontoksd:includesLower "true"^^xsd:boolean ;
      ontoksd:includesUpper "true"^^xsd:boolean .

  ontoksd:Interval_Task03_Competent a ontoksd:ScaleInterval ;
      rdfs:label "Task03 interval — Competent"@en ;
      rdfs:comment "Interval corresponding to the Competent proficiency level in Task03."@en ;
      ontoksd:isIntervalOf ontoksd:Scale_Task03_0_10 ;
      ontoksd:intervalDefinedInScheme ontoksd:PS_Task03_ProficiencyScheme ;
      ontoksd:correspondsToLevel ontoksd:PL_Task03_Competent ;
      ontoksd:lowerBound "5.0"^^xsd:decimal ;
      ontoksd:upperBound "9.0"^^xsd:decimal ;
      ontoksd:includesLower "false"^^xsd:boolean ;
      ontoksd:includesUpper "true"^^xsd:boolean .

  ontoksd:Interval_Task03_Advanced a ontoksd:ScaleInterval ;
      rdfs:label "Task03 interval — Advanced"@en ;
      rdfs:comment "Interval corresponding to the Advanced proficiency level in Task03."@en ;
      ontoksd:isIntervalOf ontoksd:Scale_Task03_0_10 ;
      ontoksd:intervalDefinedInScheme ontoksd:PS_Task03_ProficiencyScheme ;
      ontoksd:correspondsToLevel ontoksd:PL_Task03_Advanced ;
      ontoksd:lowerBound "9.0"^^xsd:decimal ;
      ontoksd:upperBound "10.0"^^xsd:decimal ;
      ontoksd:includesLower "false"^^xsd:boolean ;
      ontoksd:includesUpper "true"^^xsd:boolean .

}