      ontoksd:hasKnowledge
          is2020k:TypesOfProtocols ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:responsible , ontoksd:proactive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISITI_5_01 .

  is2020c:Competence_ISITI_6
      a ontoksd:Competence ;
      rdfs:label "Explain security principles as they pertain to networks"@en ;
      skos:prefLabel "IS IT infrastructure Competency 6"@en ;
      skos:definition "Explain security principles as they pertain to networks."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.1 IT infrastructure."@en ;
      dcterms:identifier "ISITI-6"^^xsd:string ;
