          is2020c:KS_ISITI_6_06 ,
          is2020c:KS_ISITI_6_07 ,
          is2020c:KS_ISITI_6_08 .

  is2020c:Competence_ISITI_7
      a ontoksd:Competence ;
      rdfs:label "Examine and critique IT infrastructure for organizations"@en ;
      skos:prefLabel "IS IT infrastructure Competency 7"@en ;
      skos:definition "Examine and critique IT infrastructure for organizations."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.1 IT infrastructure."@en ;
      dcterms:identifier "ISITI-7"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-it-infrastructure-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:InfrastructureComponents ,
          is2020k:InfrastructurePlanning ,
          is2020k:ContinuityPlanning ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:responsible , ontoksd:purposeDriven ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISITI_7_01 ,
          is2020c:KS_ISITI_7_02 ,
          is2020c:KS_ISITI_7_03 .

  is2020c:Competence_ISITI_8
      a ontoksd:Competence ;
      rdfs:label "Examine and critique IT server architecture (both physical or cloud-based)"@en ;
