PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Source markers and scheme
  #################################################################

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Emerging Technologies competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.3.3 Competency Area – Emerging Technologies."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020EmergingTechnologiesKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 Emerging Technologies Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 Emerging Technologies Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 Emerging Technologies competency area."@en ;
      dcterms:source is2020:IS2020Document .

  #################################################################
  # Knowledge elements
  #################################################################

  is2020k:ResearchMethodsAndTheories
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Research methods and theories"@en ;
      skos:prefLabel "Research methods and theories"@en ;
      skos:definition "Knowledge of research methods and theories used to investigate current and emerging technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EmergingTechnologyTypesFeaturesAndImpact
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Emerging technology types, features, and impact"@en ;
      skos:prefLabel "Emerging technology types, features, and impact"@en ;
      skos:definition "Knowledge of types of emerging technologies, their features, and their potential impact."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BusinessRequirementsAnalysis
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Business requirements analysis"@en ;
      skos:prefLabel "Business requirements analysis"@en ;
      skos:definition "Knowledge of business requirements analysis for evaluating technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EmergingTechnologyTypes
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Emerging technology types"@en ;
      skos:prefLabel "Emerging technology types"@en ;
      skos:definition "Knowledge of different types of emerging technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EvaluationMethods
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Evaluation methods"@en ;
      skos:prefLabel "Evaluation methods"@en ;
      skos:definition "Knowledge of methods used to evaluate technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BusinessNeedsClassification
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Business needs classification"@en ;
      skos:prefLabel "Business needs classification"@en ;
      skos:definition "Knowledge of business needs classification for technology evaluation and selection."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:RecommenderFrameworks
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Recommender frameworks"@en ;
      skos:prefLabel "Recommender frameworks"@en ;
      skos:definition "Knowledge of recommender frameworks used to support recommendations about technology usage."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DecisionMaking
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Decision making"@en ;
      skos:prefLabel "Decision making"@en ;
      skos:definition "Knowledge of decision making processes relevant to recommending technology usage."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:Simulations
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Simulations"@en ;
      skos:prefLabel "Simulations"@en ;
      skos:definition "Knowledge of simulations used to analyze or evaluate technology usage scenarios."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AppropriateTheoriesRelatedToTechnologyImplementationAndUse
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Appropriate theories related to technology implementation and use"@en ;
      skos:prefLabel "Appropriate theories related to technology implementation and use"@en ;
      skos:definition "Knowledge of relevant theories for investigating technologies through a theoretical lens, including implementation and use."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EvaluationFrameworks
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Evaluation frameworks"@en ;
      skos:prefLabel "Evaluation frameworks"@en ;
      skos:definition "Knowledge of evaluation frameworks used in the theoretical investigation of technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EthicsFundamentals
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Ethics fundamentals"@en ;
      skos:prefLabel "Ethics fundamentals"@en ;
      skos:definition "Knowledge of ethics fundamentals used to evaluate technologies from an ethical perspective."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SustainabilityFundamentals
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Sustainability fundamentals"@en ;
      skos:prefLabel "Sustainability fundamentals"@en ;
      skos:definition "Knowledge of sustainability fundamentals used to evaluate technologies from a sustainability perspective."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:OrganizationalBehavior
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Organizational behavior"@en ;
      skos:prefLabel "Organizational behavior"@en ;
      skos:definition "Knowledge of organizational behavior relevant to identifying the impact of technologies on society and business."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BusinessImpactOfTechnology
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Business impact of technology"@en ;
      skos:prefLabel "Business impact of technology"@en ;
      skos:definition "Knowledge of the business impact of technology."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ImpactIdentification
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Impact identification"@en ;
      skos:prefLabel "Impact identification"@en ;
      skos:definition "Knowledge of methods for identifying technological impact on society and business."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DesignMethods
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Design methods"@en ;
      skos:prefLabel "Design methods"@en ;
      skos:definition "Knowledge of design methods used to apply technologies to business problems."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:Prototyping
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Prototyping"@en ;
      skos:prefLabel "Prototyping"@en ;
      skos:definition "Knowledge of prototyping for practical technology design and application."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AnalysisMethods
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Analysis methods"@en ;
      skos:prefLabel "Analysis methods"@en ;
      skos:definition "Knowledge of analysis methods used in technology design and application."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BusinessProblemAnalysis
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Business problem analysis"@en ;
      skos:prefLabel "Business problem analysis"@en ;
      skos:definition "Knowledge of business problem analysis for applying technologies to business contexts."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SolutionCreation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Solution creation"@en ;
      skos:prefLabel "Solution creation"@en ;
      skos:definition "Knowledge of creating solutions through the practical design and application of technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:Communication
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Communication"@en ;
      skos:prefLabel "Communication"@en ;
      skos:definition "Knowledge of communication in teamwork scenarios involving emerging technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TeamWorking
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Team working"@en ;
      skos:prefLabel "Team working"@en ;
      skos:definition "Knowledge of team working in collaborative scenarios involving emerging technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:Timekeeping
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Timekeeping"@en ;
      skos:prefLabel "Timekeeping"@en ;
      skos:definition "Knowledge of timekeeping in teamwork scenarios involving emerging technologies."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:NoteTaking
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Note-taking"@en ;
      skos:prefLabel "Note-taking"@en ;
      skos:definition "Knowledge of note-taking in collaborative technology application scenarios."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ProjectManagement
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Project management"@en ;
      skos:prefLabel "Project management"@en ;
      skos:definition "Knowledge of project management for applying emerging technologies in teamwork scenarios."@en ;
      skos:inScheme is2020k:IS2020EmergingTechnologiesKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  #################################################################
  # Competencies
  #################################################################

  is2020c:Competence_ISET_1
      a ontoksd:Competence ;
      rdfs:label "Research and identify a selection of current and emerging technologies"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 1"@en ;
      skos:definition "Research and identify a selection of current and emerging technologies."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies. It is represented through explicit dispositions and KnowledgeSkill relations."@en ;
      dcterms:identifier "ISET-1"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:ResearchMethodsAndTheories ,
          is2020k:EmergingTechnologyTypesFeaturesAndImpact ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_1_01 ,
          is2020c:KS_ISET_1_02 .

  is2020c:Competence_ISET_2
      a ontoksd:Competence ;
      rdfs:label "Evaluate technologies based on a range of business requirements"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 2"@en ;
      skos:definition "Evaluate technologies based on a range of business requirements."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies."@en ;
      dcterms:identifier "ISET-2"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:BusinessRequirementsAnalysis ,
          is2020k:EmergingTechnologyTypes ,
          is2020k:EvaluationMethods ,
          is2020k:BusinessNeedsClassification ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_2_01 ,
          is2020c:KS_ISET_2_02 ,
          is2020c:KS_ISET_2_03 ,
          is2020c:KS_ISET_2_04 .

  is2020c:Competence_ISET_3
      a ontoksd:Competence ;
      rdfs:label "Make recommendations about the usage of technologies"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 3"@en ;
      skos:definition "Make recommendations about the usage of technologies."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies."@en ;
      dcterms:identifier "ISET-3"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:RecommenderFrameworks ,
          is2020k:DecisionMaking ,
          is2020k:Simulations ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_3_01 ,
          is2020c:KS_ISET_3_02 ,
          is2020c:KS_ISET_3_03 .

  is2020c:Competence_ISET_4
      a ontoksd:Competence ;
      rdfs:label "Investigate technologies through a theoretical lens"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 4"@en ;
      skos:definition "Investigate technologies through a theoretical lens."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies."@en ;
      dcterms:identifier "ISET-4"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:AppropriateTheoriesRelatedToTechnologyImplementationAndUse ,
          is2020k:EvaluationFrameworks ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_4_01 ,
          is2020c:KS_ISET_4_02 .

  is2020c:Competence_ISET_5
      a ontoksd:Competence ;
      rdfs:label "Evaluate technologies from an ethical and sustainability perspective"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 5"@en ;
      skos:definition "Evaluate technologies from an ethical and sustainability perspective."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies."@en ;
      dcterms:identifier "ISET-5"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:EthicsFundamentals ,
          is2020k:SustainabilityFundamentals ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_5_01 ,
          is2020c:KS_ISET_5_02 .

  is2020c:Competence_ISET_6
      a ontoksd:Competence ;
      rdfs:label "Identify the impact of technologies on society and business"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 6"@en ;
      skos:definition "Identify the impact of technologies on society and business."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies."@en ;
      dcterms:identifier "ISET-6"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:OrganizationalBehavior ,
          is2020k:BusinessImpactOfTechnology ,
          is2020k:ImpactIdentification ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_6_01 ,
          is2020c:KS_ISET_6_02 ,
          is2020c:KS_ISET_6_03 .

  is2020c:Competence_ISET_7
      a ontoksd:Competence ;
      rdfs:label "Practically design and apply technologies to a business problem"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 7"@en ;
      skos:definition "Practically design and apply technologies to a business problem."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies."@en ;
      dcterms:identifier "ISET-7"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
