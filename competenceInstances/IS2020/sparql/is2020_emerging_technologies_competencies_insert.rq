          is2020k:BusinessProblemAnalysis ,
          is2020k:SolutionCreation ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_7_01 ,
          is2020c:KS_ISET_7_02 ,
          is2020c:KS_ISET_7_03 ,
          is2020c:KS_ISET_7_04 ,
          is2020c:KS_ISET_7_05 .

  is2020c:Competence_ISET_8
      a ontoksd:Competence ;
      rdfs:label "Apply emerging technologies in a teamwork scenario"@en ;
      skos:prefLabel "IS Emerging Technologies Competency 8"@en ;
      skos:definition "Apply emerging technologies in a teamwork scenario."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.3 Emerging Technologies."@en ;
      dcterms:identifier "ISET-8"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-emerging-technologies-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:Communication ,
          is2020k:TeamWorking ,
          is2020k:Timekeeping ,
          is2020k:NoteTaking ,
          is2020k:ProjectManagement ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISET_8_01 ,
