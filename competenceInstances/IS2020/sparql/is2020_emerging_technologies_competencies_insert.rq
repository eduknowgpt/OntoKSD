          is2020c:KS_ISET_8_03 ,
          is2020c:KS_ISET_8_04 ,
          is2020c:KS_ISET_8_05 .

  #################################################################
  # KnowledgeSkill relators
  #################################################################

  is2020c:KS_ISET_1_01 a ontoksd:KnowledgeSkill ;
      rdfs:label "Research methods and theories × Analyzing"@en ;
      skos:prefLabel "Research methods and theories × Analyzing"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Emerging Technologies Competency 1 linking research methods and theories to the required Bloom level Analyzing."@en ;
      ontoksd:hasKnowledgeComponent is2020k:ResearchMethodsAndTheories ;
      ontoksd:hasRequiredSkillLevel bloom:Analyzing ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISET_1 .

  is2020c:KS_ISET_1_02 a ontoksd:KnowledgeSkill ;
      rdfs:label "Emerging technology types, features, and impact × Evaluating"@en ;
      skos:prefLabel "Emerging technology types, features, and impact × Evaluating"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Emerging Technologies Competency 1 linking emerging technology types, features, and impact to the required Bloom level Evaluating."@en ;
      ontoksd:hasKnowledgeComponent is2020k:EmergingTechnologyTypesFeaturesAndImpact ;
      ontoksd:hasRequiredSkillLevel bloom:Evaluating ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISET_1 .

  is2020c:KS_ISET_2_01 a ontoksd:KnowledgeSkill ;
      rdfs:label "Business requirements analysis × Analyzing"@en ;
      skos:prefLabel "Business requirements analysis × Analyzing"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Emerging Technologies Competency 2 linking business requirements analysis to the required Bloom level Analyzing."@en ;
      ontoksd:hasKnowledgeComponent is2020k:BusinessRequirementsAnalysis ;
      ontoksd:hasRequiredSkillLevel bloom:Analyzing ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISET_2 .

  is2020c:KS_ISET_2_02 a ontoksd:KnowledgeSkill ;
      rdfs:label "Emerging technology types × Evaluating"@en ;
      skos:prefLabel "Emerging technology types × Evaluating"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Emerging Technologies Competency 2 linking emerging technology types to the required Bloom level Evaluating."@en ;
      ontoksd:hasKnowledgeComponent is2020k:EmergingTechnologyTypes ;
      ontoksd:hasRequiredSkillLevel bloom:Evaluating ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISET_2 .

  is2020c:KS_ISET_2_03 a ontoksd:KnowledgeSkill ;
      rdfs:label "Evaluation methods × Evaluating"@en ;
      skos:prefLabel "Evaluation methods × Evaluating"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Emerging Technologies Competency 2 linking evaluation methods to the required Bloom level Evaluating."@en ;
      ontoksd:hasKnowledgeComponent is2020k:EvaluationMethods ;
      ontoksd:hasRequiredSkillLevel bloom:Evaluating ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISET_2 .

  is2020c:KS_ISET_2_04 a ontoksd:KnowledgeSkill ;
      rdfs:label "Business needs classification × Analyzing"@en ;
      skos:prefLabel "Business needs classification × Analyzing"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Emerging Technologies Competency 2 linking business needs classification to the required Bloom level Analyzing."@en ;
      ontoksd:hasKnowledgeComponent is2020k:BusinessNeedsClassification ;
      ontoksd:hasRequiredSkillLevel bloom:Analyzing ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISET_2 .

  is2020c:KS_ISET_3_01 a ontoksd:KnowledgeSkill ;
      rdfs:label "Recommender frameworks × Evaluating"@en ;
      skos:prefLabel "Recommender frameworks × Evaluating"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Emerging Technologies Competency 3 linking recommender frameworks to the required Bloom level Evaluating."@en ;
