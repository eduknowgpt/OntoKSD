    dcterms:title "Competency A3.3.1-C9: Explain concepts of Enterprise Architecture"@en ;
    dcterms:description "Students should be able to explain concepts of Enterprise Architecture"@en ;
    skos:notation "A3.3.1-C9" ;
    ontoksd:hasCompetenceElement ontoksd:SelfDirected , ontoksd:Responsible , ontoksd:PurposeDriven ;
    ontoksd:hasKnowledgeSkill ?ks ;
    skos:broader is2020:A331CompetencyAreaITinfrastructure ;
    skos:inScheme is2020:A33TechnologyCompetencyRealm .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
  VALUES (?k ?s) {
    (is2020:k_FoundationsTogaf ontoksd:understandingSkill)
    (is2020:k_FoundationsItil ontoksd:understandingSkill)
  }
}

;

