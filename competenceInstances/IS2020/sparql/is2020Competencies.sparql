INSERT DATA {
  is2020:k_ComponentsIsTechnologyHardware a ontoksd:Knowledge ;
    rdfs:label "Components of IS - technology (hardware, software, communication media), data, people, and procedures/processes."@en ;
    dcterms:description "Components of IS - technology (hardware, software, communication media), data, people, and procedures/processes."@en .

  is2020:k_OperationsIsProcessingCycle a ontoksd:Knowledge ;
    rdfs:label "Operations of IS (the processing cycle of input, processing, storage, output, control)"@en ;
    dcterms:description "Operations of IS (the processing cycle of input, processing, storage, output, control)"@en .

  is2020:k_WaysWhichIsHelps a ontoksd:Knowledge ;
    rdfs:label "The ways in which IS helps us deal with information"@en ;
    dcterms:description "The ways in which IS helps us deal with information"@en .

  is2020:k_FunctionsOperationsIsTheir a ontoksd:Knowledge ;
    rdfs:label "Functions (and operations) of IS and their impact on facilitating organizational change"@en ;
    dcterms:description "Functions (and operations) of IS and their impact on facilitating organizational change"@en .

  is2020:k_CommonTypesIsEg a ontoksd:Knowledge ;
    rdfs:label "Common types of IS (e.g., Transaction Processing Systems, Enterprise Systems)"@en ;
    dcterms:description "Common types of IS (e.g., Transaction Processing Systems, Enterprise Systems)"@en .

}

;

############# INSERÇÃO DOS PARES KNOWLEDGE-SKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (is2020:k_ComponentsIsTechnologyHardware ontoksd:understandingSkill)
    (is2020:k_OperationsIsProcessingCycle ontoksd:applyingSkill)
    (is2020:k_WaysWhichIsHelps ontoksd:applyingSkill)
    (is2020:k_FunctionsOperationsIsTheir ontoksd:applyingSkill)
    (is2020:k_CommonTypesIsEg ontoksd:understandingSkill)
  }
  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }
  BIND(IRI(CONCAT("http://example.org/is2020#ks_", STRUUID())) AS ?ks)
}

;

