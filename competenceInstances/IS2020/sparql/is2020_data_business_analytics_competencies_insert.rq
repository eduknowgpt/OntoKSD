      rdfs:label "Classification × Analyzing"@en ;
      skos:prefLabel "Classification × Analyzing"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Data / Business Analytics Competency 5 linking classification to the required Bloom level Analyzing."@en ;
      ontoksd:hasKnowledgeComponent is2020k:Classification ;
      ontoksd:hasRequiredSkillLevel bloom:Analyzing ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISDBA_5 .

  is2020c:KS_ISDBA_5_02 a ontoksd:KnowledgeSkill ;
      rdfs:label "Clustering × Analyzing"@en ;
