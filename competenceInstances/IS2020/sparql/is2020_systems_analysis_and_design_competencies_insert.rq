      skos:prefLabel "Project definition and attributes"@en ;
      skos:definition "Knowledge of project definition and key project attributes in the SDLC context."@en ;
      skos:inScheme is2020k:IS2020SystemsAnalysisAndDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SystemsRequest
      a ontoksd:Knowledge , skos:Concept ;
