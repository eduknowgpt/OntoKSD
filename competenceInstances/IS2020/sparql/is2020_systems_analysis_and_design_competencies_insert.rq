PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Source markers and scheme
  #################################################################

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-systems-analysis-and-design-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Systems Analysis and Design competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.4.1 Competency Area – Systems Analysis and Design."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020SystemsAnalysisAndDesignKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 Systems Analysis and Design Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 Systems Analysis and Design Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 Systems Analysis and Design competency area."@en ;
      dcterms:source is2020:IS2020Document .

  #################################################################
  # Knowledge elements
  #################################################################

  is2020k:PurposeOfSystemsAnalysis
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Purpose of systems analysis"@en ;
      skos:prefLabel "Purpose of systems analysis"@en ;
      skos:definition "Knowledge of the purpose of systems analysis, including what the system should do."@en ;
      skos:inScheme is2020k:IS2020SystemsAnalysisAndDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:PurposeOfDesign
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Purpose of design"@en ;
      skos:prefLabel "Purpose of design"@en ;
      skos:definition "Knowledge of the purpose of design, including how to accomplish the objective of the system."@en ;
      skos:inScheme is2020k:IS2020SystemsAnalysisAndDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:WhatIsASystem
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "What is a system"@en ;
      skos:prefLabel "What is a system"@en ;
      skos:definition "Knowledge of what a system is in the context of systems analysis and design."@en ;
      skos:inScheme is2020k:IS2020SystemsAnalysisAndDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ValueOfFormalizedStepByStepApproach
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Need for and value of a formalized step-by-step approach to analysis, design, and implementation"@en ;
      skos:prefLabel "Need for and value of a formalized step-by-step approach to analysis, design, and implementation"@en ;
      skos:definition "Knowledge of the need for and value of a formalized step-by-step approach to the analysis, design, and implementation of computer information systems."@en ;
      skos:inScheme is2020k:IS2020SystemsAnalysisAndDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ProjectDefinitionAndAttributes
      a ontoksd:Knowledge , skos:Concept ;
