  is2020c:Competence_ISSAD_1
      a ontoksd:Competence ;
      rdfs:label "Explain what systems are and how they are developed"@en ;
      skos:prefLabel "IS Systems Analysis and Design Competency 1"@en ;
      skos:definition "Explain what systems are and how they are developed."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.4.1 Systems Analysis and Design. It is represented through explicit dispositions and KnowledgeSkill relations."@en ;
      dcterms:identifier "ISSAD-1"^^xsd:string ;
