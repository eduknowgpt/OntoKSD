is2020c:Competence_ISSC_6 a ontoksd:AtomicCompetence,
        ontoksd:Competence,
        owl:NamedIndividual ;
    rdfs:label "Illustrate how cyberattacks work, how to avoid them and how to counteract their malicious consequences"@en ;
    dcterms:identifier "ISSC-6"^^xsd:string ;
    dcterms:references <http://purl.org/ontoksd/source/is2020-secure-computing-competency-area> ;
    dcterms:source is2020:IS2020Document ;
    ontoksd:hasDisposition ontoksd:inventive,
        ontoksd:purposeDriven,
        ontoksd:selfDirected ;
    ontoksd:hasKnowledge is2020k:AnatomyOfCyberattacks,
        is2020k:CyberattacksMitigationMechanisms,
        is2020k:TypesOfCyberattacks ;
    ontoksd:hasKnowledgeSkill is2020c:KS_ISSC_6_01,
        is2020c:KS_ISSC_6_02,
        is2020c:KS_ISSC_6_03 ;
    ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
    ontoksd:hasStructureType ontoksd:Atomic ;
    rdfs:comment "Competence derived from IS2020 Appendix 3, A3.3.2 Secure Computing."@en ;
    skos:definition "Illustrate how cyberattacks work, how to avoid them and how to counteract their malicious consequences"@en ;
    skos:prefLabel "IS Secure Computing Competency 6"@en ;
    prov:wasDerivedFrom is2020:IS2020Document,
        is2020c:Source_ISSC_6 .

