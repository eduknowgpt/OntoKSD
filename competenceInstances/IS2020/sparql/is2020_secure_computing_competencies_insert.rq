      rdfs:comment "KnowledgeSkill relation for IS Secure Computing Competency 2 linking authorization to the required Bloom level Understanding."@en ;
      ontoksd:hasKnowledgeComponent is2020k:Authorization ;
      ontoksd:hasRequiredSkillLevel bloom:Understanding ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISSC_2 .

  is2020c:KS_ISSC_2_03 a ontoksd:KnowledgeSkill ;
      rdfs:label "Access control × Understanding"@en ;
      skos:prefLabel "Access control × Understanding"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Secure Computing Competency 2 linking access control to the required Bloom level Understanding."@en ;
      ontoksd:hasKnowledgeComponent is2020k:AccessControl ;
      ontoksd:hasRequiredSkillLevel bloom:Understanding ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISSC_2 .

  is2020c:KS_ISSC_2_04 a ontoksd:KnowledgeSkill ;
      rdfs:label "Data integrity × Understanding"@en ;
      skos:prefLabel "Data integrity × Understanding"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Secure Computing Competency 2 linking data integrity to the required Bloom level Understanding."@en ;
      ontoksd:hasKnowledgeComponent is2020k:DataIntegrity ;
      ontoksd:hasRequiredSkillLevel bloom:Understanding ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISSC_2 .

  is2020c:KS_ISSC_3_01 a ontoksd:KnowledgeSkill ;
      rdfs:label "Security-by-design × Understanding"@en ;
      skos:prefLabel "Security-by-design × Understanding"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Secure Computing Competency 3 linking security-by-design to the required Bloom level Understanding."@en ;
      ontoksd:hasKnowledgeComponent is2020k:SecurityByDesign ;
      ontoksd:hasRequiredSkillLevel bloom:Understanding ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISSC_3 .

  is2020c:KS_ISSC_3_02 a ontoksd:KnowledgeSkill ;
      rdfs:label "Data sanitization × Understanding"@en ;
      skos:prefLabel "Data sanitization × Understanding"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Secure Computing Competency 3 linking data sanitization to the required Bloom level Understanding."@en ;
      ontoksd:hasKnowledgeComponent is2020k:DataSanitization ;
      ontoksd:hasRequiredSkillLevel bloom:Understanding ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISSC_3 .

  is2020c:KS_ISSC_3_03 a ontoksd:KnowledgeSkill ;
      rdfs:label "Input validation and data sanitization × Understanding"@en ;
      skos:prefLabel "Input validation and data sanitization × Understanding"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Secure Computing Competency 3 linking input validation and data sanitization to the required Bloom level Understanding."@en ;
      ontoksd:hasKnowledgeComponent is2020k:InputValidationAndDataSanitization ;
      ontoksd:hasRequiredSkillLevel bloom:Understanding ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISSC_3 .

  is2020c:KS_ISSC_3_04 a ontoksd:KnowledgeSkill ;
      rdfs:label "Security vulnerability × Understanding"@en ;
      skos:prefLabel "Security vulnerability × Understanding"@en ;
      rdfs:comment "KnowledgeSkill relation for IS Secure Computing Competency 3 linking security vulnerability to the required Bloom level Understanding."@en ;
      ontoksd:hasKnowledgeComponent is2020k:SecurityVulnerability ;
      ontoksd:hasRequiredSkillLevel bloom:Understanding ;
      ontoksd:isKnowledgeSkillOf is2020c:Competence_ISSC_3 .

  is2020c:KS_ISSC_4_01 a ontoksd:KnowledgeSkill ;
      rdfs:label "Identification × Analyzing"@en ;
      skos:prefLabel "Identification × Analyzing"@en ;
