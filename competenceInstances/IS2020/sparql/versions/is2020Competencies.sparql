############# INSERÇÃO DOS PARES KNOWLEDGE-SKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (is2020:k_DefineTrackUserinteractiveAcceptance ontoksd:understandingSkill)
    (is2020:k_ManageFeaturesPersonasUse ontoksd:understandingSkill)
    (is2020:k_ProvisionsTestValidationDeployments ontoksd:understandingSkill)
  }
  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }
  BIND(IRI(CONCAT("http://example.org/is2020#ks_", STRUUID())) AS ?ks)
}

;

