    dcterms:description "Manage features, personas, use cases, or user stories as they related to system modules, information flows, and user experience flows"@en .

  is2020:k_ProvisionsTestValidationDeployments a ontoksd:Knowledge ;
    rdfs:label "Provisions for test and validation deployments"@en ;
