    ontoksd:hasCompetenceElement ontoksd:PurposeDriven , ontoksd:Meticulous , ontoksd:Inventive ;
    ontoksd:hasKnowledgeSkill ?ks ;
    skos:broader is2020:A342CompetencyAreaApplicationDevelopmentandProgramming ;
    skos:inScheme is2020:A34SystemsDevelopmentCompetencyRealm .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
  VALUES (?k ?s) {
    (is2020:k_UtilizeContinuousIntegrationDeployment ontoksd:evaluatingSkill)
    (is2020:k_UtilizeASoftwareProcess ontoksd:evaluatingSkill)
  }
}

