      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (is2020:k_VersionControlSystemsVcs ontoksd:understandingSkill)
    (is2020:k_AtomicOperationsEnablePrecise ontoksd:understandingSkill)
    (is2020:k_BranchingMergingFeatureEvolution ontoksd:understandingSkill)
    (is2020:k_TaggingLabelingAlignCode ontoksd:understandingSkill)
    (is2020:k_VersionControlActsAs ontoksd:understandingSkill)
    (is2020:k_UseFamiliarityLeastOne ontoksd:applyingSkill)
  }
  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }
  BIND(IRI(CONCAT("http://example.org/is2020#ks_", STRUUID())) AS ?ks)
