    (is2020:k_RootCauseAnalysis ontoksd:applyingSkill)
    (is2020:k_UseCases ontoksd:creatingSkill)
    (is2020:k_WorkBreakdownStructure ontoksd:evaluatingSkill)
    (is2020:k_WorkScheduleCriticalPath ontoksd:applyingSkill)
    (is2020:k_RiskManagementItsRole ontoksd:understandingSkill)
    (is2020:k_SystemsMigrationPlan ontoksd:understandingSkill)
    (is2020:k_SystemsMaintenanceProgram ontoksd:understandingSkill)
    (is2020:k_ItInfrastructureDesign ontoksd:understandingSkill)
    (is2020:k_UserInterfaces ontoksd:creatingSkill)
    (is2020:k_DataModelsEntityRelationship ontoksd:creatingSkill)
    (is2020:k_ProcessModelingDiagrams ontoksd:creatingSkill)
    (is2020:k_DataFlowDiagrams ontoksd:creatingSkill)
    (is2020:k_DatabaseCreation ontoksd:creatingSkill)
    (is2020:k_TestingPlanPerformanceSecurity ontoksd:applyingSkill)
    (is2020:k_DeploymentPlan ontoksd:applyingSkill)
    (is2020:k_TerminatingAProject ontoksd:understandingSkill)
    (is2020:k_SystemMaintenancePlan ontoksd:applyingSkill)
    (is2020:k_ChangeRequestDocument ontoksd:applyingSkill)
