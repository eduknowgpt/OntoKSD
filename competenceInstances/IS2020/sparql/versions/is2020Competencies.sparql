    dcterms:description "Students should be able to choose appropriate process discovery techniques for different business scenarios"@en ;
    skos:notation "A3.5.4-C3" ;
    ontoksd:hasCompetenceElement ontoksd:SelfDirected , ontoksd:PurposeDriven , ontoksd:Meticulous ;
    ontoksd:hasKnowledgeSkill ?ks ;
    skos:broader is2020:A354CompetencyAreaBusinessProcessManagement ;
    skos:inScheme is2020:A35OrganizationalDomainCompetencyRealm .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
  VALUES (?k ?s) {
    (is2020:k_BusinessScenarios ontoksd:applyingSkill)
    (is2020:k_ProcessDiscoveryTechniquesEvidencebased ontoksd:evaluatingSkill)
  }
}

