  is2020:competence_A3.2.2-C2 a ontoksd:Competence ;  	ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
	ontoksd:hasStructureType ontoksd:Atomic ;
	dcterms:source "ACM/AIS IS2020" ;
    dcterms:title "Competency A3.2.2-C2: Analyze data science problems with a CT framework"@en ;
    dcterms:description "Students should be able to analyze data science problems with a CT framework"@en ;
    skos:notation "A3.2.2-C2" ;
    ontoksd:hasCompetenceElement ontoksd:SelfDirected , ontoksd:PurposeDriven , ontoksd:Meticulous ;
    ontoksd:hasKnowledgeSkill ?ks ;
    skos:broader is2020:A322CompetencyAreaDataBusinessAnalytics ;
    skos:inScheme is2020:A32DataInformationCompetencyRealm .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
  VALUES (?k ?s) {
    (is2020:k_DataScienceProblems ontoksd:understandingSkill)
    (is2020:k_FrameworkThinkingAboutCt ontoksd:applyingSkill)
  }
}

;

