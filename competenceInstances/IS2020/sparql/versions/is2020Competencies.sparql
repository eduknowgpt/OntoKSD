  is2020:competence_A3.6.2-C5 a ontoksd:Competence ;  	ontoksd:hasCompetenceType ontoksd:ComputingDomain ;
	ontoksd:hasStructureType ontoksd:Atomic ;
	dcterms:source "ACM/AIS IS2020" ;
    dcterms:title "Competency A3.6.2-C5: Utilize tools for team collaboration and communication"@en ;
    dcterms:description "Students should be able to utilize tools for team collaboration and communication"@en ;
    skos:notation "A3.6.2-C5" ;
    ontoksd:hasCompetenceElement ontoksd:Meticulous , ontoksd:Collaborative , ontoksd:SelfDirected ;
    ontoksd:hasKnowledgeSkill ?ks ;
    skos:broader is2020:A362CompetencyAreaISPracticum ;
    skos:inScheme is2020:A36IntegrationCompetencyRealm .
}
WHERE {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
  VALUES (?k ?s) {
    (is2020:k_RealtimeCommunicationThatIs ontoksd:understandingSkill)
    (is2020:k_LinksVersionControlCommits ontoksd:understandingSkill)
    (is2020:k_ExposureLeastOneTool ontoksd:applyingSkill)
  }
}

;

