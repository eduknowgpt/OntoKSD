    dcterms:description "Integration with version control systems and features management"@en .

  is2020:k_ALinkedIntegrativePyramid a ontoksd:Knowledge ;
    rdfs:label "A linked and integrative “pyramid” of testing that cascades from manual testing to integration testing, to unit testing"@en ;
    dcterms:description "A linked and integrative “pyramid” of testing that cascades from manual testing to integration testing, to unit testing"@en .

  is2020:k_RegressionTestingSafeguardAgainst a ontoksd:Knowledge ;
