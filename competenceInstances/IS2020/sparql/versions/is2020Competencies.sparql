############# INSERÇÃO DOS PARES KNOWLEDGE-SKILL ################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent ?s .
}
WHERE {
  VALUES (?k ?s) {
    (is2020:k_IsValueInformation ontoksd:understandingSkill)
    (is2020:k_MethodsStoringOrganizingInformation ontoksd:applyingSkill)
    (is2020:k_RoleInformationDecisionMaking ontoksd:understandingSkill)
    (is2020:k_TypesDecisionsTechniquesDecision ontoksd:applyingSkill)
    (is2020:k_StagesDecisionMakingAppropriate ontoksd:applyingSkill)
    (is2020:k_KeyItIssuesTrends ontoksd:understandingSkill)
    (is2020:k_IsStrategicPlanningProcess ontoksd:understandingSkill)
    (is2020:k_InformationKnowledgeBusinessDecision ontoksd:understandingSkill)
    (is2020:k_DecisionSupportSystems ontoksd:understandingSkill)
  }
  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent ?s .
  }
  BIND(IRI(CONCAT("http://example.org/is2020#ks_", STRUUID())) AS ?ks)
}

;

