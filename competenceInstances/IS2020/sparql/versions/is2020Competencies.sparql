    (is2020:k_TechnicalFeasibility ontoksd:evaluatingSkill)
    (is2020:k_CostbenefitAnalysis ontoksd:understandingSkill)
    (is2020:k_EconomicFeasibility ontoksd:understandingSkill)
    (is2020:k_BusinessRequirementDocumentation ontoksd:understandingSkill)
