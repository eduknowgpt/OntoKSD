  is2020k:UnitTestingLibraryOrHarness
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Use and familiarity with at least one unit testing library or harness"@en ;
      skos:prefLabel "Use and familiarity with at least one unit testing library or harness"@en ;
      skos:definition "Knowledge and use of at least one unit testing library or harness."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
