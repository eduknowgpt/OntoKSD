  is2020k:PersistenceStrategies
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Persistence strategies, such as RDBMS and their role in system execution"@en ;
      skos:prefLabel "Persistence strategies, such as RDBMS and their role in system execution"@en ;
      skos:definition "Knowledge of persistence strategies such as RDBMS and their role in system execution."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
