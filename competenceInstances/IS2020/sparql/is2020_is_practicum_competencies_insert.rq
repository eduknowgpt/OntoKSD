  is2020k:UMLStructuralDiagrams
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Use UML structural diagrams to realize and validate object-oriented module and library design"@en ;
      skos:prefLabel "Use UML structural diagrams to realize and validate object-oriented module and library design"@en ;
      skos:definition "Knowledge of using UML structural diagrams to realize and validate object-oriented module and library design."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
