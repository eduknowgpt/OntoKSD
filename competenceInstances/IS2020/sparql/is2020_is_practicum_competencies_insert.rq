      ontoksd:hasDisposition ontoksd:professional , ontoksd:collaborative , ontoksd:responsible ;
      ontoksd:hasKnowledgeSkill is2020c:KS_ISPRA_1_01 , is2020c:KS_ISPRA_1_02 , is2020c:KS_ISPRA_1_03 .

