PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-is-practicum-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 IS Practicum competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.6.2 Competency Area – IS Practicum."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020ISPracticumKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 IS Practicum Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 IS Practicum Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 IS Practicum competency area."@en ;
      dcterms:source is2020:IS2020Document .

  is2020k:PhasesOfTheSDLC
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Phases of the SDLC abstract the principal concerns of software systems development"@en ;
      skos:prefLabel "Phases of the SDLC abstract the principal concerns of software systems development"@en ;
      skos:definition "Knowledge that the phases of the SDLC abstract the principal concerns of software systems development."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SequentialNatureOfTheSDLC
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Appreciation for the implicit sequential nature of the cycle in terms of predicates and flow"@en ;
      skos:prefLabel "Appreciation for the implicit sequential nature of the cycle in terms of predicates and flow"@en ;
      skos:definition "Knowledge of the implicit sequential nature of the SDLC in terms of predicates and flow."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:VarietyOfSDLCModels
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Appreciation for the variety of models that describe the flow and evolution of the SDLC in practice"@en ;
      skos:prefLabel "Appreciation for the variety of models that describe the flow and evolution of the SDLC in practice"@en ;
      skos:definition "Knowledge of the variety of models that describe the flow and evolution of the SDLC in practice."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:WaterfallModel
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Articulate and implement a Waterfall model understanding the assumptions, advantages, and disadvantages of utilizing this model methodologically"@en ;
      skos:prefLabel "Articulate and implement a Waterfall model understanding the assumptions, advantages, and disadvantages of utilizing this model methodologically"@en ;
      skos:definition "Knowledge of articulating and implementing a Waterfall model, including its assumptions, advantages, and disadvantages."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:IterativeWaterfallModel
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Articulate and implement an Iterative Waterfall model as a set of sequential waterfall processes. Be familiar with the assumptions, advantages, and disadvantages of utilizing this model methodologically."@en ;
      skos:prefLabel "Articulate and implement an Iterative Waterfall model as a set of sequential waterfall processes"@en ;
      skos:definition "Knowledge of articulating and implementing an Iterative Waterfall model, including its assumptions, advantages, and disadvantages."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SpiralModel
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Articulate and implement a Spiral model as a phased abstraction of both the Iterative and Waterfall models. Be familiar with the assumptions, advantages, and disadvantages of utilizing this model methodologically."@en ;
      skos:prefLabel "Articulate and implement a Spiral model as a phased abstraction of both the Iterative and Waterfall models"@en ;
      skos:definition "Knowledge of articulating and implementing a Spiral model, including its assumptions, advantages, and disadvantages."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:RapidApplicationDevelopmentModel
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Articulate and implement a Rapid Application Development/Prototyping model as an iterative approach that utilizes frequent empirical validation. Be familiar with the assumptions, advantages, and disadvantages of utilizing this model methodologically."@en ;
      skos:prefLabel "Articulate and implement a Rapid Application Development/Prototyping model"@en ;
      skos:definition "Knowledge of articulating and implementing a Rapid Application Development or Prototyping model, including its assumptions, advantages, and disadvantages."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AgileModel
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Articulate and implement an Agile model as an iterative and incremental approach that utilizes frequent empirical validation and customer collaboration. Be familiar with the assumptions, advantages, and disadvantages of utilizing this model methodologically."@en ;
      skos:prefLabel "Articulate and implement an Agile model"@en ;
      skos:definition "Knowledge of articulating and implementing an Agile model, including its assumptions, advantages, and disadvantages."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SoftwareProcessManagementTools
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Knowledge of tools that track and manage software projects with respect to resources, features, deadlines, conflicts, and impediments"@en ;
      skos:prefLabel "Knowledge of tools that track and manage software projects with respect to resources, features, deadlines, conflicts, and impediments"@en ;
      skos:definition "Knowledge of software process management tools used to track and manage projects with respect to resources, features, deadlines, conflicts, and impediments."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EstimationValidationVelocity
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Estimation, validation, and velocity as they pertain to productivity"@en ;
      skos:prefLabel "Estimation, validation, and velocity as they pertain to productivity"@en ;
      skos:definition "Knowledge of estimation, validation, and velocity as they pertain to productivity."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ExampleSoftwareProcessTools
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Exposure to at least one tool, such as Jira, Azure DevOps for Teams, TeamCity, etc."@en ;
      skos:prefLabel "Exposure to at least one tool, such as Jira, Azure DevOps for Teams, TeamCity, etc."@en ;
      skos:definition "Knowledge of at least one software process management tool such as Jira, Azure DevOps for Teams, or TeamCity."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:VersionControlSystemsGraphStructure
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Version Control Systems (VCS) represent a graph structure of the changes, permutations, and state of the software codebase that constitutes the necessary instructions for system realization"@en ;
      skos:prefLabel "Version Control Systems (VCS) represent a graph structure of the changes, permutations, and state of the software codebase"@en ;
      skos:definition "Knowledge that version control systems represent a graph structure of changes, permutations, and state of the software codebase."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AtomicOperationsInVCS
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Atomic operations enable precise change tracking and responsibility"@en ;
      skos:prefLabel "Atomic operations enable precise change tracking and responsibility"@en ;
      skos:definition "Knowledge that atomic operations in version control enable precise change tracking and responsibility."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BranchingAndMerging
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Branching and merging for feature evolution, defect management, and team coordination"@en ;
      skos:prefLabel "Branching and merging for feature evolution, defect management, and team coordination"@en ;
      skos:definition "Knowledge of branching and merging for feature evolution, defect management, and team coordination."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TaggingAndLabeling
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Tagging and labeling to align code changes with features"@en ;
      skos:prefLabel "Tagging and labeling to align code changes with features"@en ;
      skos:definition "Knowledge of tagging and labeling to align code changes with features."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:VCSAsTransactionSystem
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Version control acts as a transaction system with ACID properties"@en ;
      skos:prefLabel "Version control acts as a transaction system with ACID properties"@en ;
      skos:definition "Knowledge that version control acts as a transaction system with ACID properties."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:UseOfAtLeastOneVCS
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Use and familiarity with at least one VCS such as Git, SVN, Mercurial, CVS, etc."@en ;
      skos:prefLabel "Use and familiarity with at least one VCS such as Git, SVN, Mercurial, CVS, etc."@en ;
      skos:definition "Knowledge and use of at least one version control system such as Git, SVN, Mercurial, or CVS."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:RealTimeCommunicationLinkedToManagement
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Real-time communication that is also linked to features management, code management, and defect tracking"@en ;
      skos:prefLabel "Real-time communication linked to features management, code management, and defect tracking"@en ;
      skos:definition "Knowledge of real-time communication linked to features management, code management, and defect tracking."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:LinksToVersionControlCommits
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Links to version control commits and collaborative code development"@en ;
      skos:prefLabel "Links to version control commits and collaborative code development"@en ;
      skos:definition "Knowledge of links to version control commits and collaborative code development."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ExampleTeamCollaborationTool
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Exposure to at least one tool, such as Jira, Trello, TeamCity, BandCamp, etc."@en ;
      skos:prefLabel "Exposure to at least one tool, such as Jira, Trello, TeamCity, BandCamp, etc."@en ;
      skos:definition "Knowledge of at least one team collaboration and communication tool such as Jira, Trello, TeamCity, or BandCamp."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:UserInteractiveAcceptanceTesting
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Define and track user-interactive acceptance testing"@en ;
      skos:prefLabel "Define and track user-interactive acceptance testing"@en ;
      skos:definition "Knowledge of defining and tracking user-interactive acceptance testing."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ManageFeaturesPersonasUseCasesStories
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Manage features, personas, use cases, or user stories as they related to system modules, information flows, and user experience flows"@en ;
      skos:prefLabel "Manage features, personas, use cases, or user stories as they relate to system modules, information flows, and user experience flows"@en ;
      skos:definition "Knowledge of managing features, personas, use cases, or user stories as they relate to system modules, information flows, and user experience flows."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ProvisionsForTestAndValidationDeployments
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Provisions for test and validation deployments"@en ;
      skos:prefLabel "Provisions for test and validation deployments"@en ;
      skos:definition "Knowledge of provisions for test and validation deployments."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SystemForIdentifyingSoftwareDefects
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "A system for developers and end users to identify software defects"@en ;
      skos:prefLabel "A system for developers and end users to identify software defects"@en ;
      skos:definition "Knowledge of systems that allow developers and end users to identify software defects."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SystemForTrackingDefectStatus
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "A system for developers and end users to track the status of defects"@en ;
      skos:prefLabel "A system for developers and end users to track the status of defects"@en ;
      skos:definition "Knowledge of systems that allow developers and end users to track the status of defects."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:IntegrationWithVCSAndFeaturesManagement
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Integration with version control systems and features management"@en ;
      skos:prefLabel "Integration with version control systems and features management"@en ;
      skos:definition "Knowledge of integration between testing tools, version control systems, and features management."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TestingPyramid
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "A linked and integrative 'pyramid' of testing that cascades from manual testing to integration testing, to unit testing"@en ;
      skos:prefLabel "A linked and integrative pyramid of testing"@en ;
      skos:definition "Knowledge of a linked and integrative testing pyramid from manual to integration to unit testing."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
