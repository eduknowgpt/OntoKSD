  is2020k:DesignForModularityForReuse
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Design for modularity for reuse"@en ;
      skos:prefLabel "Design for modularity for reuse"@en ;
      skos:definition "Knowledge of designing for modularity and reuse."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
