  is2020k:DataAndObjectStructuresInRuntimeMemory
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Data and object structures housed in runtime-execution and resident in volatile memory"@en ;
      skos:prefLabel "Data and object structures housed in runtime-execution and resident in volatile memory"@en ;
      skos:definition "Knowledge of data and object structures housed in runtime execution and resident in volatile memory."@en ;
      skos:inScheme is2020k:IS2020ISPracticumKnowledgeScheme ;
