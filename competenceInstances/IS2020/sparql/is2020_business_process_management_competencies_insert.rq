PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-business-process-management-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Business Process Management competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.5.4 Competency Area – Business Process Management."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020BusinessProcessManagementKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 Business Process Management Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 Business Process Management Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 Business Process Management competency area."@en ;
      dcterms:source is2020:IS2020Document .

  is2020k:CharacteristicsOfProcess
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Characteristics of process (e.g., actions, events/tasks, decision points, outcomes, and value)"@en ;
      skos:prefLabel "Characteristics of process (e.g., actions, events/tasks, decision points, outcomes, and value)"@en ;
      skos:definition "Knowledge of process characteristics such as actions, events or tasks, decision points, outcomes, and value."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:PerspectivesOfModelling
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Perspectives of modelling (control flow, functional, data, organization perspective)"@en ;
      skos:prefLabel "Perspectives of modelling (control flow, functional, data, organization perspective)"@en ;
      skos:definition "Knowledge of modelling perspectives including control flow, functional, data, and organizational perspectives."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ElementsOfBPMNModel
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Elements of a BPMN model (branching and merging, rework and repetition, information artifacts and resources)"@en ;
      skos:prefLabel "Elements of a BPMN model (branching and merging, rework and repetition, information artifacts and resources)"@en ;
      skos:definition "Knowledge of BPMN model elements including branching and merging, rework and repetition, and information artifacts and resources."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:OrganizationalElementsInBPMN
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Organizational (or resource) elements in BPMN (Pools and Lanes)"@en ;
      skos:prefLabel "Organizational (or resource) elements in BPMN (Pools and Lanes)"@en ;
      skos:definition "Knowledge of organizational or resource elements in BPMN such as pools and lanes."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TypesOfResources
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Types of resources (process participant, software system, equipment)"@en ;
      skos:prefLabel "Types of resources (process participant, software system, equipment)"@en ;
      skos:definition "Knowledge of process resources such as process participants, software systems, and equipment."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ExampleBPMTools
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Example BPM tools - ARIS, Visio or System Architect"@en ;
      skos:prefLabel "Example BPM tools - ARIS, Visio or System Architect"@en ;
      skos:definition "Knowledge of example BPM tools such as ARIS, Visio, and System Architect."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BusinessScenarios
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Business Scenarios"@en ;
      skos:prefLabel "Business Scenarios"@en ;
      skos:definition "Knowledge of business scenarios relevant to process discovery."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ProcessDiscoveryTechniques
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Process Discovery techniques (evidence-based, interview-based, workshop based)"@en ;
      skos:prefLabel "Process Discovery techniques (evidence-based, interview-based, workshop based)"@en ;
      skos:definition "Knowledge of process discovery techniques including evidence-based, interview-based, and workshop-based approaches."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ProcessArchitectureAndPortfolios
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Process Architecture and process portfolios"@en ;
      skos:prefLabel "Process Architecture and process portfolios"@en ;
      skos:definition "Knowledge of process architecture and process portfolios."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TypesOfProcesses
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Types of processes (management, core and supporting)"@en ;
      skos:prefLabel "Types of processes (management, core and supporting)"@en ;
      skos:definition "Knowledge of process types such as management, core, and supporting processes."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:RelationshipsBetweenProcesses
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Relationships between processes: sequence, decomposition, and specialization"@en ;
      skos:prefLabel "Relationships between processes: sequence, decomposition, and specialization"@en ;
      skos:definition "Knowledge of relationships between processes including sequence, decomposition, and specialization."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TechniquesForCollectingAndAnalyzingIssues
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Techniques for collecting and analyzing issues in a process"@en ;
      skos:prefLabel "Techniques for collecting and analyzing issues in a process"@en ;
      skos:definition "Knowledge of techniques for collecting and analyzing issues in a process."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:IssueRootCauseAnalysisAndDocumentation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Issue root cause analysis (e.g., Pareto chart) and documentation"@en ;
      skos:prefLabel "Issue root cause analysis (e.g., Pareto chart) and documentation"@en ;
      skos:definition "Knowledge of issue root cause analysis, such as Pareto charts, and related documentation."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MethodsForProcessImprovement
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Methods for process improvement redesign and reengineering"@en ;
      skos:prefLabel "Methods for process improvement redesign and reengineering"@en ;
      skos:definition "Knowledge of methods for process improvement, redesign, and reengineering."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TechnologySolutions
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Technology solutions (AI, IoT, Blockchain, etc.)"@en ;
      skos:prefLabel "Technology solutions (AI, IoT, Blockchain, etc.)"@en ;
      skos:definition "Knowledge of technology solutions such as AI, IoT, Blockchain, and related technologies for process improvement."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CostBenefitsAnalysisAndROI
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Cost-benefits analysis and Return on investment"@en ;
      skos:prefLabel "Cost-benefits analysis and Return on investment"@en ;
      skos:definition "Knowledge of cost-benefit analysis and return on investment."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ChangeManagementAndImplementation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Change management and implementation"@en ;
      skos:prefLabel "Change management and implementation"@en ;
      skos:definition "Knowledge of change management and implementation in process improvement."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TechniquesAndToolsForBPM
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Techniques and tools that support the planning, design, analysis, operation, and monitoring of business processes"@en ;
      skos:prefLabel "Techniques and tools that support the planning, design, analysis, operation, and monitoring of business processes"@en ;
      skos:definition "Knowledge of techniques and tools that support the planning, design, analysis, operation, and monitoring of business processes, such as BPMS, BPM suites, BPEL, XML, XPDL, SOA, and web services."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:RoboticProcessAutomationAndTools
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Robotic Process Automation and tools available (e.g., UIPath Developer)"@en ;
      skos:prefLabel "Robotic Process Automation and tools available (e.g., UIPath Developer)"@en ;
      skos:definition "Knowledge of robotic process automation and available tools such as UIPath Developer."@en ;
      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:PerformanceMeasures
      a ontoksd:Knowledge , skos:Concept ;
