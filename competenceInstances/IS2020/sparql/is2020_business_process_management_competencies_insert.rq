      skos:inScheme is2020k:IS2020BusinessProcessManagementKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020c:Competence_ISBPM_1
      a ontoksd:Competence ;
      rdfs:label "Explain the characteristics of a process and the different perspectives of a process model"@en ;
      skos:prefLabel "IS Business Process Management Competency 1"@en ;
      skos:definition "Explain the characteristics of a process and the different perspectives of a process model."@en ;
      dcterms:identifier "ISBPM-1"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-business-process-management-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge is2020k:CharacteristicsOfProcess , is2020k:PerspectivesOfModelling ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:meticulous ;
      ontoksd:hasKnowledgeSkill is2020c:KS_ISBPM_1_01 , is2020c:KS_ISBPM_1_02 .

  is2020c:Competence_ISBPM_2
      a ontoksd:Competence ;
