      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:meticulous ;
      ontoksd:hasKnowledgeSkill is2020c:KS_ISBPM_3_01 , is2020c:KS_ISBPM_3_02 .

  is2020c:Competence_ISBPM_4
