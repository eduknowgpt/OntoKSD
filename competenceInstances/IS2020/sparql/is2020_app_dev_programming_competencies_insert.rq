PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Source markers and scheme
  #################################################################

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-application-development-and-programming-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Application Development and Programming competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.4.2 Competency Area – Application Development and Programming."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020ApplicationDevelopmentAndProgrammingKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 Application Development and Programming Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 Application Development and Programming Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 Application Development and Programming competency area."@en ;
      dcterms:source is2020:IS2020Document .

  #################################################################
  # Knowledge elements
  #################################################################

  is2020k:AppropriatePrimitiveDataTypes
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Select appropriate primitive data types to store and recall numeric, string/character, and Boolean data"@en ;
      skos:prefLabel "Select appropriate primitive data types to store and recall numeric, string/character, and Boolean data"@en ;
      skos:definition "Knowledge of selecting appropriate primitive data types to store and recall numeric, string or character, and Boolean data."@en ;
      skos:inScheme is2020k:IS2020ApplicationDevelopmentAndProgrammingKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DerivativeDataTypes
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Define new derivative data types used to compose complex types from primitive types"@en ;
      skos:prefLabel "Define new derivative data types used to compose complex types from primitive types"@en ;
      skos:definition "Knowledge of defining derivative data types to compose complex types from primitive data types."@en ;
      skos:inScheme is2020k:IS2020ApplicationDevelopmentAndProgrammingKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:PrimitiveTypesForFractionalPrecision
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Select from primitive data types according to the precision in the storage of fractional numeric information"@en ;
      skos:prefLabel "Select from primitive data types according to the precision in the storage of fractional numeric information"@en ;
      skos:definition "Knowledge of selecting primitive data types according to the precision required for storing fractional numeric information."@en ;
      skos:inScheme is2020k:IS2020ApplicationDevelopmentAndProgrammingKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:PrimitiveTypesForIntegralMagnitude
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Select from primitive data types according to the magnitude of the integral value relative to available volatile memory"@en ;
      skos:prefLabel "Select from primitive data types according to the magnitude of the integral value relative to available volatile memory"@en ;
      skos:definition "Knowledge of selecting primitive data types according to the magnitude of integral values relative to available volatile memory."@en ;
      skos:inScheme is2020k:IS2020ApplicationDevelopmentAndProgrammingKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:NumericBaseExpressions
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Define the relationship between binary, octal, decimal, and hexadecimal expressions of numeric values"@en ;
