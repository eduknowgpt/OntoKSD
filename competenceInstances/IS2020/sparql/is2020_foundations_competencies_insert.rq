  #################################################################
  # Competencies
  #################################################################

  is2020c:Competence_ISF_1
      a ontoksd:Competence ;
      rdfs:label "Classify the components, elements, operations, and impact of IS"@en ;
      skos:prefLabel "IS Foundations Competency 1"@en ;
      skos:definition "Classify the components, elements, operations, and impact of IS."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.1.1 Foundations of Information Systems. It is represented through explicit dispositions and KnowledgeSkill relations."@en ;
      dcterms:identifier "ISF-1"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-foundations-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:ComponentsOfISTechnologyDataPeopleProcedures ,
          is2020k:OperationsOfISProcessingCycle ,
          is2020k:HowISHelpsDealWithInformation ,
          is2020k:FunctionsOperationsImpactOfISOnOrganizationalChange ,
          is2020k:CommonTypesOfIS ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:inventive , ontoksd:purposeDriven ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISF_1_01 ,
          is2020c:KS_ISF_1_02 ,
          is2020c:KS_ISF_1_03 ,
          is2020c:KS_ISF_1_04 ,
          is2020c:KS_ISF_1_05 .

  is2020c:Competence_ISF_2
      a ontoksd:Competence ;
      rdfs:label "Interpret the dimensions, characteristics, and value of quality information"@en ;
      skos:prefLabel "IS Foundations Competency 2"@en ;
      skos:definition "Interpret the dimensions, characteristics, and value of quality information."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.1.1 Foundations of Information Systems."@en ;
      dcterms:identifier "ISF-2"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-foundations-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:DimensionsOfInformationQualityAndEvaluationMethods ,
          is2020k:VirtualValueChain ;
      ontoksd:hasDisposition ontoksd:purposeDriven , ontoksd:selfDirected , ontoksd:responsive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISF_2_01 ,
          is2020c:KS_ISF_2_02 .

  is2020c:Competence_ISF_3
      a ontoksd:Competence ;
      rdfs:label "Explain the roles, responsibilities, and characteristics of the IS professional"@en ;
      skos:prefLabel "IS Foundations Competency 3"@en ;
      skos:definition "Explain the roles, responsibilities, and characteristics of the IS professional."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.1.1 Foundations of Information Systems."@en ;
      dcterms:identifier "ISF-3"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-foundations-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:RolesAndResponsibilitiesOfISProfessional ,
          is2020k:CharacteristicsOfISProfessional ,
          is2020k:EthicalStandardsForISProfessional ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:inventive , ontoksd:purposeDriven ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISF_3_01 ,
          is2020c:KS_ISF_3_02 ,
          is2020c:KS_ISF_3_03 .

  is2020c:Competence_ISF_4
      a ontoksd:Competence ;
      rdfs:label "Recommend techniques for using information and knowledge for business decision making and strategic value"@en ;
      skos:prefLabel "IS Foundations Competency 4"@en ;
      skos:definition "Recommend techniques for using information and knowledge for business decision making and strategic value."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.1.1 Foundations of Information Systems."@en ;
      dcterms:identifier "ISF-4"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-foundations-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:ISAndValueOfInformation ,
          is2020k:MethodsForStoringAndOrganizingInformation ,
          is2020k:RoleOfInformationInDecisionMaking ,
          is2020k:TypesOfDecisionsAndDecisionMakingTechniques ,
          is2020k:StagesOfDecisionMakingAndISTools ,
          is2020k:KeyITIssuesTrendsAndBusinessAlignment ,
          is2020k:ISStrategicPlanningProcess ,
          is2020k:InformationAndKnowledgeForBusinessDecisionMakingAndStrategicValue ,
          is2020k:DecisionSupportSystems ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:professional ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISF_4_01 ,
          is2020c:KS_ISF_4_02 ,
          is2020c:KS_ISF_4_03 ,
          is2020c:KS_ISF_4_04 ,
          is2020c:KS_ISF_4_05 ,
          is2020c:KS_ISF_4_06 ,
          is2020c:KS_ISF_4_07 ,
          is2020c:KS_ISF_4_08 ,
