PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Source markers and scheme
  #################################################################

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-foundations-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Foundations of Information Systems competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.1.1 Competency Area – Foundations of Information Systems."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020FoundationsKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 Foundations of Information Systems Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 Foundations Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 Foundations of Information Systems competency area."@en ;
      dcterms:source is2020:IS2020Document .

  #################################################################
  # Knowledge elements
  #################################################################

  is2020k:ComponentsOfISTechnologyDataPeopleProcedures
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Components of IS: technology, data, people, and procedures/processes"@en ;
      skos:prefLabel "Components of IS: technology, data, people, and procedures/processes"@en ;
      skos:definition "Knowledge of the main components of information systems, including hardware, software, communication media, data, people, and procedures or processes."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:OperationsOfISProcessingCycle
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Operations of IS and the information processing cycle"@en ;
      skos:prefLabel "Operations of IS and the information processing cycle"@en ;
      skos:definition "Knowledge of the operations of information systems, including input, processing, storage, output, and control."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:HowISHelpsDealWithInformation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Ways in which IS helps deal with information"@en ;
      skos:prefLabel "Ways in which IS helps deal with information"@en ;
      skos:definition "Knowledge of how information systems support the acquisition, processing, organization, and use of information."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:FunctionsOperationsImpactOfISOnOrganizationalChange
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Functions and operations of IS and their impact on organizational change"@en ;
      skos:prefLabel "Functions and operations of IS and their impact on organizational change"@en ;
      skos:definition "Knowledge of the functions and operations of information systems and their impact in facilitating organizational change."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CommonTypesOfIS
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Common types of information systems"@en ;
      skos:prefLabel "Common types of information systems"@en ;
      skos:definition "Knowledge of common types of information systems, such as transaction processing systems and enterprise systems."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DimensionsOfInformationQualityAndEvaluationMethods
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Dimensions of information quality and information evaluation methods"@en ;
      skos:prefLabel "Dimensions of information quality and information evaluation methods"@en ;
      skos:definition "Knowledge of dimensions of information quality and methods used to evaluate information."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:VirtualValueChain
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Virtual value chain"@en ;
      skos:prefLabel "Virtual value chain"@en ;
      skos:definition "Knowledge of the virtual value chain and its relevance to information value creation."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:RolesAndResponsibilitiesOfISProfessional
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Roles and responsibilities of the IS professional"@en ;
      skos:prefLabel "Roles and responsibilities of the IS professional"@en ;
      skos:definition "Knowledge of the roles and responsibilities associated with professional practice in information systems."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CharacteristicsOfISProfessional
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Characteristics of the IS professional"@en ;
      skos:prefLabel "Characteristics of the IS professional"@en ;
      skos:definition "Knowledge of the characteristics expected of an information systems professional."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EthicalStandardsForISProfessional
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Ethical standards for the IS professional"@en ;
      skos:prefLabel "Ethical standards for the IS professional"@en ;
      skos:definition "Knowledge of ethical standards relevant to information systems professional practice."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ISAndValueOfInformation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "IS and the value of information"@en ;
      skos:prefLabel "IS and the value of information"@en ;
      skos:definition "Knowledge of the role of information systems in generating, supporting, and leveraging the value of information."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MethodsForStoringAndOrganizingInformation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Methods for storing and organizing information"@en ;
      skos:prefLabel "Methods for storing and organizing information"@en ;
      skos:definition "Knowledge of methods used to store and organize information for business use."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:RoleOfInformationInDecisionMaking
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Role of information in decision making"@en ;
      skos:prefLabel "Role of information in decision making"@en ;
      skos:definition "Knowledge of how information supports business decision making."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TypesOfDecisionsAndDecisionMakingTechniques
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Types of decisions and techniques for decision making"@en ;
      skos:prefLabel "Types of decisions and techniques for decision making"@en ;
      skos:definition "Knowledge of different types of decisions and the techniques used to support decision making."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:StagesOfDecisionMakingAndISTools
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Stages of decision making and appropriate IS tools"@en ;
      skos:prefLabel "Stages of decision making and appropriate IS tools"@en ;
      skos:definition "Knowledge of the stages of decision making and the information system tools appropriate to each stage."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:KeyITIssuesTrendsAndBusinessAlignment
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Key IT issues, trends, and alignment of IT with business"@en ;
      skos:prefLabel "Key IT issues, trends, and alignment of IT with business"@en ;
      skos:definition "Knowledge of major information technology issues and trends and of alignment between IT and business strategy."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ISStrategicPlanningProcess
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "IS strategic planning process"@en ;
      skos:prefLabel "IS strategic planning process"@en ;
      skos:definition "Knowledge of the strategic planning process for information systems."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:InformationAndKnowledgeForBusinessDecisionMakingAndStrategicValue
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Information and knowledge for business decision making and strategic value"@en ;
      skos:prefLabel "Information and knowledge for business decision making and strategic value"@en ;
      skos:definition "Knowledge of how information and knowledge contribute to business decision making and strategic value creation."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DecisionSupportSystems
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Decision support systems"@en ;
      skos:prefLabel "Decision support systems"@en ;
      skos:definition "Knowledge of decision support systems and their role in organizational decision processes."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ComponentsOfIS
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Components of IS"@en ;
      skos:prefLabel "Components of IS"@en ;
      skos:definition "Knowledge of the components that constitute an information system."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ElementsOfIS
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Elements of IS"@en ;
      skos:prefLabel "Elements of IS"@en ;
      skos:definition "Knowledge of the elements of information systems, including data, hardware, software, communication, and processes."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TypesAndUtilityOfIS
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Types and utility of IS"@en ;
      skos:prefLabel "Types and utility of IS"@en ;
      skos:definition "Knowledge of types of information systems and their utility in business contexts."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ISSolutionsAndToolsForBusinessContextsAndProcesses
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "IS solutions and tools for different business contexts and processes"@en ;
      skos:prefLabel "IS solutions and tools for different business contexts and processes"@en ;
      skos:definition "Knowledge of information system solutions and tools suitable for different business contexts and processes."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BusinessProcessModellingAndOptimization
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Business processes modelling and optimization"@en ;
      skos:prefLabel "Business processes modelling and optimization"@en ;
      skos:definition "Knowledge of modelling and optimization of business processes."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ComponentsOfEnterpriseSystem
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Components of an enterprise system"@en ;
      skos:prefLabel "Components of an enterprise system"@en ;
      skos:definition "Knowledge of the components that make up an enterprise system."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TypesAndFunctionsOfEnterpriseSystems
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Types and functions of enterprise systems"@en ;
      skos:prefLabel "Types and functions of enterprise systems"@en ;
      skos:definition "Knowledge of types and functions of enterprise systems, including ERP and BI."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MethodsForTransmittingInformationUsingNetworks
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Methods for transmitting information using networks"@en ;
      skos:prefLabel "Methods for transmitting information using networks"@en ;
      skos:definition "Knowledge of methods for transmitting information using networks, including communication applications, Web 2.0 and Web 3.0 applications, IoT, and crowdsourcing."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:KeyComponentsOfNetworks
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Key components of networks"@en ;
      skos:prefLabel "Key components of networks"@en ;
      skos:definition "Knowledge of the key components of computer and communication networks."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TypesOfInformationSecurityThreats
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Types of information security threats"@en ;
      skos:prefLabel "Types of information security threats"@en ;
      skos:definition "Knowledge of different types of threats to information security."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SecurityTechnologiesAndSolutions
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Security technologies and solutions"@en ;
      skos:prefLabel "Security technologies and solutions"@en ;
      skos:definition "Knowledge of technologies and solutions used to secure information."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TypesOfInformationPrivacyThreats
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Types of information privacy threats"@en ;
      skos:prefLabel "Types of information privacy threats"@en ;
      skos:definition "Knowledge of different threats to information privacy."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ConsequencesOfInformationPrivacyViolations
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Consequences of information privacy violations"@en ;
      skos:prefLabel "Consequences of information privacy violations"@en ;
      skos:definition "Knowledge of the consequences of information privacy violations."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:TechnologiesAndSolutionsForInformationPrivacy
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Technologies and solutions for information privacy"@en ;
      skos:prefLabel "Technologies and solutions for information privacy"@en ;
      skos:definition "Knowledge of technologies and solutions for protecting information privacy."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:FairInformationPracticesAndPrivacyPolicies
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Fair information practices and privacy policies"@en ;
      skos:prefLabel "Fair information practices and privacy policies"@en ;
      skos:definition "Knowledge of fair information practices and organizational privacy policies."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:GovernmentInformationPrivacyRegulations
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Government information privacy regulations"@en ;
      skos:prefLabel "Government information privacy regulations"@en ;
      skos:definition "Knowledge of government regulations related to information privacy."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MethodsAndToolsForUsingInformation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Methods and tools for using information"@en ;
      skos:prefLabel "Methods and tools for using information"@en ;
      skos:definition "Knowledge of methods and tools for using information in IS development and problem solving."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BuyVersusBuildDecision
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Buy versus build decision"@en ;
      skos:prefLabel "Buy versus build decision"@en ;
      skos:definition "Knowledge of the decision between buying and building an information systems solution."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:OutsourcingPossibilitiesAndModelsForIS
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Outsourcing possibilities and models for IS"@en ;
      skos:prefLabel "Outsourcing possibilities and models for IS"@en ;
      skos:definition "Knowledge of outsourcing possibilities and models relevant to information systems."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ComputationalMethods
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Computational methods"@en ;
      skos:prefLabel "Computational methods"@en ;
      skos:definition "Knowledge of computational methods used to solve basic computational and design problems."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SoftwareToolsAndComputationalMethods
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Software tools and computational methods"@en ;
      skos:prefLabel "Software tools and computational methods"@en ;
      skos:definition "Knowledge of software tools and computational methods used in IS development."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SoftwareDevelopmentMethodologies
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Software development methodologies"@en ;
      skos:prefLabel "Software development methodologies"@en ;
      skos:definition "Knowledge of software development methodologies relevant to IS development."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SystemsDevelopmentLifecycle
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Systems development lifecycle"@en ;
      skos:prefLabel "Systems development lifecycle"@en ;
      skos:definition "Knowledge of the systems development lifecycle and its phases."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:InnovationAndDesignTechniques
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Innovation and design techniques"@en ;
      skos:prefLabel "Innovation and design techniques"@en ;
      skos:definition "Knowledge of innovation and design techniques for improving processes and organizational change."@en ;
      skos:inScheme is2020k:IS2020FoundationsKnowledgeScheme ;
