INSERT DATA {

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-web-development-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Web Development competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.4.4 Competency Area – Web Development."@en ;
