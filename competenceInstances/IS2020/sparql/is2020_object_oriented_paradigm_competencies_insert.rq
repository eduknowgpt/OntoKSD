PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  #################################################################
  # Source markers and scheme
  #################################################################

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-object-oriented-paradigm-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Object-Oriented Paradigm competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.4.3 Competency Area – Object-Oriented Paradigm."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 Object-Oriented Paradigm Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 Object-Oriented Paradigm Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 Object-Oriented Paradigm competency area."@en ;
      dcterms:source is2020:IS2020Document .

  #################################################################
  # Knowledge elements
  #################################################################

  is2020k:ModelPropertiesWithinClassDefinitionCreating
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Model the properties of an entity using data types and variables within a class definition"@en ;
      skos:prefLabel "Model the properties of an entity using data types and variables within a class definition"@en ;
      skos:definition "Knowledge of modeling the properties of an entity using data types and variables within a class definition."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ModelBehaviorsWithinClassDefinition
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Model the behaviors of an entity using procedures within a class definition"@en ;
      skos:prefLabel "Model the behaviors of an entity using procedures within a class definition"@en ;
      skos:definition "Knowledge of modeling the behaviors of an entity using procedures within a class definition."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DistinctionBetweenInstanceAndClassMembers
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Distinction between instance and class members"@en ;
      skos:prefLabel "Distinction between instance and class members"@en ;
      skos:definition "Knowledge of the distinction between instance members and class members."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ModelPropertiesWithinClassDefinitionApplying
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Model the properties of an entity using data types and variables within a class definition (applied level)"@en ;
      skos:prefLabel "Model the properties of an entity using data types and variables within a class definition (applied level)"@en ;
      skos:definition "Knowledge of applying class-based modeling of entity properties using data types and variables."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ObjectInstantiationOperations
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Object instantiation operations"@en ;
      skos:prefLabel "Object instantiation operations"@en ;
      skos:definition "Knowledge of object instantiation operations in object-oriented programming."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ClassBasisForObjectInstantiation
      a ontoksd:Knowledge , skos:Concept ;
