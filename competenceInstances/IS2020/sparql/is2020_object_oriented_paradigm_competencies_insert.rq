      skos:prefLabel "Relationship to modeling notations"@en ;
      skos:definition "Knowledge of the relationship between design patterns and modeling notations."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
