      skos:prefLabel "Single and multiple inheritance"@en ;
      skos:definition "Knowledge of single and multiple inheritance."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CompositionHasA
      a ontoksd:Knowledge , skos:Concept ;
