  is2020k:DependenciesAndConstructors
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Dependencies and constructors"@en ;
      skos:prefLabel "Dependencies and constructors"@en ;
      skos:definition "Knowledge of dependencies and constructors."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DependencyInjectionAndIoC
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Dependency injection and inversion of control"@en ;
      skos:prefLabel "Dependency injection and inversion of control"@en ;
      skos:definition "Knowledge of dependency injection and inversion of control."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
