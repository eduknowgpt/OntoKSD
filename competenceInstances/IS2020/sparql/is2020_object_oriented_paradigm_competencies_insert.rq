      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISOOP_2_01 ,
          is2020c:KS_ISOOP_2_02 ,
          is2020c:KS_ISOOP_2_03 ,
          is2020c:KS_ISOOP_2_04 ,
          is2020c:KS_ISOOP_2_05 .

  is2020c:Competence_ISOOP_3
      a ontoksd:Competence ;
      rdfs:label "Utilize intra-entity communication and messaging"@en ;
      skos:prefLabel "IS Object-Oriented Paradigm Competency 3"@en ;
      skos:definition "Utilize intra-entity communication and messaging."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.4.3 Object-Oriented Paradigm."@en ;
