      skos:prefLabel "Prototype basis for object instantiation"@en ;
      skos:definition "Knowledge of prototypes as a basis for object instantiation."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
