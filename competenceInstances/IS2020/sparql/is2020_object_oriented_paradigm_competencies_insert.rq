          is2020k:RefactoringForEncapsulation ,
          is2020k:DecouplingUsingEncapsulation ;
      ontoksd:hasDisposition ontoksd:purposeDriven , ontoksd:meticulous , ontoksd:inventive ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISOOP_4_01 ,
          is2020c:KS_ISOOP_4_02 ,
          is2020c:KS_ISOOP_4_03 ,
          is2020c:KS_ISOOP_4_04 .

  is2020c:Competence_ISOOP_5
