      skos:prefLabel "Creational, Structural, and Behavioral patterns"@en ;
      skos:definition "Knowledge of creational, structural, and behavioral design patterns."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
