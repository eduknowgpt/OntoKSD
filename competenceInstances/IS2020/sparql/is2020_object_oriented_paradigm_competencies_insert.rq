      skos:definition "Knowledge of decoupling using encapsulation."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:InheritanceIsAKindOf
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Object extensibility and reuse through inheritance (is a kind of)"@en ;
      skos:prefLabel "Object extensibility and reuse through inheritance (is a kind of)"@en ;
      skos:definition "Knowledge of object extensibility and reuse through inheritance."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:SingleAndMultipleInheritance
      a ontoksd:Knowledge , skos:Concept ;
