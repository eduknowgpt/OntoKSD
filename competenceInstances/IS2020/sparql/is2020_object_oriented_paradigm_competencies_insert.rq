      skos:prefLabel "Interfaces and mixins as an alternative to multiple inheritance"@en ;
      skos:definition "Knowledge of interfaces and mixins as alternatives to multiple inheritance."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
