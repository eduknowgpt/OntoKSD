  #################################################################
  # Competencies
  #################################################################

  is2020c:Competence_ISOOP_1
      a ontoksd:Competence ;
      rdfs:label "Apply fundamental elements of objects and classes"@en ;
      skos:prefLabel "IS Object-Oriented Paradigm Competency 1"@en ;
      skos:definition "Apply fundamental elements of objects and classes."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.4.3 Object-Oriented Paradigm."@en ;
      dcterms:identifier "ISOOP-1"^^xsd:string ;
      dcterms:source is2020:IS2020Document ;
      dcterms:references <http://purl.org/ontoksd/source/is2020-object-oriented-paradigm-competency-area> ;
      prov:wasDerivedFrom is2020:IS2020Document ;
      ontoksd:hasStructureType ontoksd:Atomic ;
      ontoksd:hasSpecificationPattern is2020:IS2020SpecificationPattern ;
      ontoksd:hasKnowledge
          is2020k:ModelPropertiesWithinClassDefinitionCreating ,
          is2020k:ModelBehaviorsWithinClassDefinition ,
          is2020k:DistinctionBetweenInstanceAndClassMembers ,
          is2020k:ModelPropertiesWithinClassDefinitionApplying ;
      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:meticulous ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISOOP_1_01 ,
          is2020c:KS_ISOOP_1_02 ,
          is2020c:KS_ISOOP_1_03 ,
          is2020c:KS_ISOOP_1_04 .

  is2020c:Competence_ISOOP_2
      a ontoksd:Competence ;
      rdfs:label "Utilize instantiation modalities"@en ;
      skos:prefLabel "IS Object-Oriented Paradigm Competency 2"@en ;
