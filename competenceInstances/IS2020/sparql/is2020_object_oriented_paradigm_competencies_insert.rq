      ontoksd:hasDisposition ontoksd:selfDirected , ontoksd:purposeDriven , ontoksd:meticulous ;
      ontoksd:hasKnowledgeSkill
          is2020c:KS_ISOOP_3_01 ,
          is2020c:KS_ISOOP_3_02 ,
          is2020c:KS_ISOOP_3_03 ,
          is2020c:KS_ISOOP_3_04 ,
          is2020c:KS_ISOOP_3_05 .

  is2020c:Competence_ISOOP_4
      a ontoksd:Competence ;
      rdfs:label "Design for encapsulation"@en ;
      skos:prefLabel "IS Object-Oriented Paradigm Competency 4"@en ;
      skos:definition "Design for encapsulation."@en ;
      rdfs:comment "Competence derived from IS2020 Appendix 3, A3.4.3 Object-Oriented Paradigm."@en ;
