  is2020k:ObjectInstantiationUsingConstructors
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Object instantiation using constructors and related operators"@en ;
      skos:prefLabel "Object instantiation using constructors and related operators"@en ;
      skos:definition "Knowledge of object instantiation using constructors and related operators."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MemoryManagementFeatures
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Implementing language features related to memory management (unmanaged vs. managed)"@en ;
      skos:prefLabel "Implementing language features related to memory management (unmanaged vs. managed)"@en ;
      skos:definition "Knowledge of language features related to memory management, including unmanaged and managed approaches."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MethodDeclarationAndUse
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Method declaration and use"@en ;
      skos:prefLabel "Method declaration and use"@en ;
      skos:definition "Knowledge of method declaration and use in object-oriented programming."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CallsByReferenceAndValue
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Calls by reference and value"@en ;
      skos:prefLabel "Calls by reference and value"@en ;
      skos:definition "Knowledge of calls by reference and by value."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MemberVisibilityAndAccessModification
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Member visibility and language-specific access modification"@en ;
      skos:prefLabel "Member visibility and language-specific access modification"@en ;
      skos:definition "Knowledge of member visibility and language-specific access modification."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ClassPackagingForReuse
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Class packaging for reuse (namespaces, packages, libraries)"@en ;
      skos:prefLabel "Class packaging for reuse (namespaces, packages, libraries)"@en ;
      skos:definition "Knowledge of class packaging for reuse, including namespaces, packages, and libraries."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AccessingPackagedClasses
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Accessing packaged classes"@en ;
      skos:prefLabel "Accessing packaged classes"@en ;
      skos:definition "Knowledge of accessing packaged classes."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:LanguageFeaturesForVisibility
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Language features to stratify and organize member visibility and accessibility within a class"@en ;
      skos:prefLabel "Language features to stratify and organize member visibility and accessibility within a class"@en ;
      skos:definition "Knowledge of language features that stratify and organize member visibility and accessibility within a class."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EncapsulationForAutonomyAndIntegrity
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Design for object autonomy and integrity using encapsulation techniques"@en ;
      skos:prefLabel "Design for object autonomy and integrity using encapsulation techniques"@en ;
      skos:definition "Knowledge of designing for object autonomy and integrity using encapsulation techniques."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
