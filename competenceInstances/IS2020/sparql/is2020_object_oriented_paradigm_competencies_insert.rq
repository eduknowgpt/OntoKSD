  is2020k:DelegationKnowsA
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Object extensibility and reuse through delegation (knows a)"@en ;
      skos:prefLabel "Object extensibility and reuse through delegation (knows a)"@en ;
      skos:definition "Knowledge of object extensibility and reuse through delegation."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AbstractClassLanguageFeatures
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Language features that identify a class as abstract - the source of inheritance without instantiability"@en ;
      skos:prefLabel "Language features that identify a class as abstract - the source of inheritance without instantiability"@en ;
      skos:definition "Knowledge of language features that identify a class as abstract and support inheritance without instantiation."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AbstractInheritanceHierarchies
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Refactoring or design of abstract inheritance hierarchies"@en ;
      skos:prefLabel "Refactoring or design of abstract inheritance hierarchies"@en ;
      skos:definition "Knowledge of refactoring or designing abstract inheritance hierarchies."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AbstractionVersusInterfaces
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "abstraction vs. interfaces (virtual members)"@en ;
      skos:prefLabel "abstraction vs. interfaces (virtual members)"@en ;
      skos:definition "Knowledge of abstraction versus interfaces, including virtual members."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AbstractReferencesForDataStructuring
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Data structuring of related data types through abstract references"@en ;
      skos:prefLabel "Data structuring of related data types through abstract references"@en ;
      skos:definition "Knowledge of structuring related data types through abstract references."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:BaseReferencesAndDerivedInstances
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Relationship between base/parent class references and derived/child class instances"@en ;
      skos:prefLabel "Relationship between base/parent class references and derived/child class instances"@en ;
      skos:definition "Knowledge of the relationship between base or parent class references and derived or child class instances."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:OverrideBaseBehaviorsAndAttributes
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Override base/parent class behaviors and attributes in derived/child classes"@en ;
      skos:prefLabel "Override base/parent class behaviors and attributes in derived/child classes"@en ;
      skos:definition "Knowledge of overriding base or parent class behaviors and attributes in derived or child classes."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:UniqueResponsesToInheritedCalls
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Behaviors that respond uniquely to commonly inherited method calls"@en ;
      skos:prefLabel "Behaviors that respond uniquely to commonly inherited method calls"@en ;
      skos:definition "Knowledge of behaviors that respond uniquely to commonly inherited method calls."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
