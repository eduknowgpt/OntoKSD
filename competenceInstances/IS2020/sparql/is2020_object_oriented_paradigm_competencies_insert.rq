  is2020k:SeparationOfConcerns
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Separation of concerns"@en ;
      skos:prefLabel "Separation of concerns"@en ;
      skos:definition "Knowledge of separation of concerns in object-oriented design."@en ;
      skos:inScheme is2020k:IS2020ObjectOrientedParadigmKnowledgeScheme ;
