      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AnalysisToolsAndTechniques
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Analysis tools and techniques such as Personas, Scenarios, Use Cases, User Stories, Storyboards, and Wireframes"@en ;
      skos:prefLabel "Analysis tools and techniques such as Personas, Scenarios, Use Cases, User Stories, Storyboards, and Wireframes"@en ;
      skos:definition "Knowledge of analysis tools and techniques such as personas, scenarios, use cases, user stories, storyboards, and wireframes."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
