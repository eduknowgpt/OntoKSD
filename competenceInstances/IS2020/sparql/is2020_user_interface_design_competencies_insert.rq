  is2020k:EstablishUxPurposeAudienceContextHistory
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Establish UX purpose, audience, context, and history"@en ;
      skos:prefLabel "Establish UX purpose, audience, context, and history"@en ;
