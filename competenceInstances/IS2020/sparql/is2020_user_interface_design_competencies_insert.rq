PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX is2020:   <http://purl.org/is2020#>
PREFIX is2020k:  <http://purl.org/is2020/knowledge#>
PREFIX is2020c:  <http://purl.org/is2020/competency#>
PREFIX bloom:    <http://purl.org/edu/bloom#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>

INSERT DATA {

  is2020:IS2020Document
      a owl:NamedIndividual ;
      rdfs:label "IS2020 report"@en ;
      rdfs:comment "Source marker for competencies instantiated from the IS2020 report."@en .

  <http://purl.org/ontoksd/source/is2020-user-interface-design-competency-area>
      a owl:NamedIndividual ;
      rdfs:label "IS2020 User Interface Design competency area"@en ;
      rdfs:comment "Source marker for competencies instantiated from Appendix 3, A3.4.6 Competency Area – User Interface Design."@en ;
      dcterms:source is2020:IS2020Document .

  is2020:IS2020SpecificationPattern
      a owl:NamedIndividual ;
      rdfs:label "IS2020 Specification Pattern"@en ;
      rdfs:comment "Specification pattern used for competencies derived from the IS2020 curriculum report and represented in OntoKSD through explicit dispositions and KnowledgeSkill relations."@en .

  is2020k:IS2020UserInterfaceDesignKnowledgeScheme
      a skos:ConceptScheme ;
      rdfs:label "IS2020 User Interface Design Knowledge Scheme"@en ;
      skos:prefLabel "IS2020 User Interface Design Knowledge Scheme"@en ;
      rdfs:comment "Concept scheme containing knowledge elements curated from the textual competency descriptions of the IS2020 User Interface Design competency area."@en ;
      dcterms:source is2020:IS2020Document .

  is2020k:UnderstandingOfUsersTasksAndEnvironments
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Understanding of users, tasks, and environments"@en ;
      skos:prefLabel "Understanding of users, tasks, and environments"@en ;
      skos:definition "Knowledge of users, their tasks, and the environments in which interaction occurs."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:GatheringUserFeedbackForRequirementsAndDesign
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Gathering user feedback to define requirements and design"@en ;
      skos:prefLabel "Gathering user feedback to define requirements and design"@en ;
      skos:definition "Knowledge of gathering user feedback to define requirements and design decisions."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:InvolveUserInDesignProcess
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Involve user in the design process"@en ;
      skos:prefLabel "Involve user in the design process"@en ;
      skos:definition "Knowledge of involving users directly in the design process."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ImplementIterativeUserDesignProcess
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Implement an iterative user design process"@en ;
      skos:prefLabel "Implement an iterative user design process"@en ;
      skos:definition "Knowledge of iterative user-centered design processes."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:EssentialElementsOfUserCenteredDesign
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Essential elements of user centered design"@en ;
      skos:prefLabel "Essential elements of user centered design"@en ;
      skos:definition "Knowledge of the essential elements of user-centered design."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:HumanCapabilitiesMotorSkillsAttentionHumanError
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Human capabilities that motivate them, including motor skills, attention, and human error"@en ;
      skos:prefLabel "Human capabilities that motivate them, including motor skills, attention, and human error"@en ;
      skos:definition "Knowledge of human capabilities relevant to interaction, including motor skills, attention, and human error."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DirectManipulation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Direct manipulation objects of interest in the UI are visible and can be acted upon"@en ;
      skos:prefLabel "Direct manipulation objects of interest in the UI are visible and can be acted upon"@en ;
      skos:definition "Knowledge of direct manipulation interaction where UI objects are visible and can be acted upon."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:MenuBasedSystems
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Menu based systems where users work their way through a series of screens or menus"@en ;
      skos:prefLabel "Menu based systems where users work their way through a series of screens or menus"@en ;
      skos:definition "Knowledge of menu-based systems in which users navigate through screens or menus."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:FormFillInInteraction
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Form fill-in where a user needs to enter the necessary information in order to complete a specific task or requirement"@en ;
      skos:prefLabel "Form fill-in where a user needs to enter the necessary information in order to complete a specific task or requirement"@en ;
      skos:definition "Knowledge of form fill-in interaction where users enter information to complete tasks."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CommandLineInteraction
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Command line interaction with operating systems"@en ;
      skos:prefLabel "Command line interaction with operating systems"@en ;
      skos:definition "Knowledge of command line interaction with operating systems."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:NaturalLanguageInteraction
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Natural language allowing a user to interact with the computer using a human language"@en ;
      skos:prefLabel "Natural language allowing a user to interact with the computer using a human language"@en ;
      skos:definition "Knowledge of natural language interaction in which users interact with computers using human language."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ConstructNavigation
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Construct navigation enabling users to easily accomplish tasks"@en ;
      skos:prefLabel "Construct navigation enabling users to easily accomplish tasks"@en ;
      skos:definition "Knowledge of constructing navigation that enables users to accomplish tasks easily."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CreateIntuitiveForms
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Create intuitive forms used for gathering required data"@en ;
      skos:prefLabel "Create intuitive forms used for gathering required data"@en ;
      skos:definition "Knowledge of creating intuitive forms for gathering required data."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CreateWorkingApplicationOrTemplateMobileFirst
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Create a working application or web page template appropriate for various devices using mobile-first design principles"@en ;
      skos:prefLabel "Create a working application or web page template appropriate for various devices using mobile-first design principles"@en ;
      skos:definition "Knowledge of creating a working application or web page template for various devices using mobile-first design principles."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:IdentifyTargetAudienceAndAudienceAppropriateDesign
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Identify an application's target audience and create an audience-appropriate design"@en ;
      skos:prefLabel "Identify an application's target audience and create an audience-appropriate design"@en ;
      skos:definition "Knowledge of identifying an application's target audience and producing an appropriate design for that audience."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:ReviseApplicationBasedOnFeedback
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Use critical thinking skills to revise application based on feedback"@en ;
      skos:prefLabel "Use critical thinking skills to revise application based on feedback"@en ;
      skos:definition "Knowledge of critically revising an application based on feedback."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:StudyPerceptionSimplicityClarityConsistencyHierarchy
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Study perception, simplicity, clarity, consistency, hierarchy (visual and temporal)"@en ;
      skos:prefLabel "Study perception, simplicity, clarity, consistency, hierarchy (visual and temporal)"@en ;
      skos:definition "Knowledge of perception, simplicity, clarity, consistency, and hierarchy, both visual and temporal."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:AchievePersonalizedExperience
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Achieve a personalized experience"@en ;
      skos:prefLabel "Achieve a personalized experience"@en ;
      skos:definition "Knowledge of achieving a personalized user experience."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DesignAndAlignInformationArchitecture
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Design and align the information architecture of the application environment to support usability, comprehensibility, and search"@en ;
      skos:prefLabel "Design and align the information architecture of the application environment to support usability, comprehensibility, and search"@en ;
      skos:definition "Knowledge of designing and aligning information architecture to support usability, comprehensibility, and search."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:HumanComputerInterfacePrinciplesAndIssues
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Familiarity with human-computer interface principles and issues"@en ;
      skos:prefLabel "Familiarity with human-computer interface principles and issues"@en ;
      skos:definition "Knowledge of human-computer interface principles and issues."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:DesignAndImplementUserTestingStrategies
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Design and implement user testing strategies to include usability testing, A/B testing, and user flow validation"@en ;
      skos:prefLabel "Design and implement user testing strategies to include usability testing, A/B testing, and user flow validation"@en ;
      skos:definition "Knowledge of designing and implementing user testing strategies including usability testing, A/B testing, and user flow validation."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
      dcterms:source is2020:IS2020Document .

  is2020k:CooperativeAndParticipatoryDesign
      a ontoksd:Knowledge , skos:Concept ;
      rdfs:label "Cooperative and Participatory design to align designer and users in a partnership"@en ;
      skos:prefLabel "Cooperative and Participatory design to align designer and users in a partnership"@en ;
      skos:definition "Knowledge of cooperative and participatory design that aligns designers and users in a partnership."@en ;
      skos:inScheme is2020k:IS2020UserInterfaceDesignKnowledgeScheme ;
