                                             <http://purl.org/cs2013/KU/Event_Driven_and_Reactive_Programming> ,
                                             <http://purl.org/cs2013/KU/Formal_Semantics> ,
                                             <http://purl.org/cs2013/KU/Functional_Programming> ,
                                             <http://purl.org/cs2013/KU/Language_Pragmatics> ,
                                             <http://purl.org/cs2013/KU/Language_Translation_and_Execution> ,
                                             <http://purl.org/cs2013/KU/Logic_Programming> ,
                                             <http://purl.org/cs2013/KU/Object_Oriented_Programming> ,
                                             <http://purl.org/cs2013/KU/Program_Representation> ,
