@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:  <http://www.w3.org/XML/1998/namespace#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bloom: <http://purl.org/edu/bloom#> .
@base <http://purl.org/edu/bloom#> .

<http://purl.org/edu/bloom> rdf:type owl:Ontology .

### Classe
bloom:CognitiveProcessLevel rdf:type owl:Class .

### Propriedades diretas (não transitivas)
bloom:directFollows rdf:type owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf bloom:directPrecedes ;
    rdfs:domain bloom:CognitiveProcessLevel ;
    rdfs:range bloom:CognitiveProcessLevel .

bloom:directPrecedes rdf:type owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain bloom:CognitiveProcessLevel ;
    rdfs:range bloom:CognitiveProcessLevel .

### Propriedades transitivas corretamente tipadas e encadeadas
bloom:follows rdf:type owl:ObjectProperty, owl:TransitiveProperty ;
    owl:inverseOf bloom:precedes ;
    owl:propertyChainAxiom (bloom:directFollows bloom:follows) ;
    rdfs:domain bloom:CognitiveProcessLevel ;
    rdfs:range bloom:CognitiveProcessLevel ;
    rdfs:label "follows"@en .

bloom:precedes rdf:type owl:ObjectProperty, owl:TransitiveProperty ;
    owl:inverseOf bloom:follows ;
    owl:propertyChainAxiom (bloom:directPrecedes bloom:precedes) ;
    rdfs:domain bloom:CognitiveProcessLevel ;
    rdfs:range bloom:CognitiveProcessLevel ;
    rdfs:label "precedes"@en .

### Instâncias conectadas em cadeia linear
bloom:Remember rdf:type owl:NamedIndividual, bloom:CognitiveProcessLevel ;
    bloom:directPrecedes bloom:Understand ;
    rdfs:label "Remember"@en .

bloom:Understand rdf:type owl:NamedIndividual, bloom:CognitiveProcessLevel ;
    bloom:directPrecedes bloom:Apply ;
    rdfs:label "Understand"@en .

bloom:Apply rdf:type owl:NamedIndividual, bloom:CognitiveProcessLevel ;
    bloom:directPrecedes bloom:Analyze ;
    rdfs:label "Apply"@en .

bloom:Analyze rdf:type owl:NamedIndividual, bloom:CognitiveProcessLevel ;
    bloom:directPrecedes bloom:Evaluate ;
    rdfs:label "Analyze"@en .

bloom:Evaluate rdf:type owl:NamedIndividual, bloom:CognitiveProcessLevel ;
    bloom:directPrecedes bloom:Create ;
    rdfs:label "Evaluate"@en .

bloom:Create rdf:type owl:NamedIndividual, bloom:CognitiveProcessLevel ;
    rdfs:label "Create"@en .
