    rdfs:label "assess"@en ;
    skos:prefLabel "assess"@en ;
    skos:definition "Evaluate the nature, ability, or quality of something."@en ;
    skos:related bloom:Appraise, bloom:Judge ;
    skos:example "Assess the clarity of a student's explanation."@en ;
    skos:note "Widely used in educational, technical, and clinical assessments."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Assessment> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Evaluating the nature or quality of something."@en .

### http://example.org/bloom#Check
bloom:Check a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "check"@en ;
    skos:prefLabel "check"@en ;
    skos:definition "Examine something to determine its accuracy, validity, or condition."@en ;
    skos:related bloom:Verify, bloom:Inspect ;
    skos:example "Check the correctness of the calculated result."@en ;
    skos:note "Common in troubleshooting, debugging, and validation."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Check_(check_mark)> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Assessing the validity of statements or arguments."@en .

### http://example.org/bloom#Defend
bloom:Defend a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "defend"@en ;
    skos:prefLabel "defend"@en ;
    skos:definition "Support a claim or position with logical reasoning and evidence."@en ;
    skos:related bloom:Justify, bloom:Argue ;
    skos:example "Defend your choice of algorithm in terms of efficiency."@en ;
    skos:note "Often appears in debates, essays, and oral defenses."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Defense_(argument)> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Supporting a position with evidence."@en .

### http://example.org/bloom#Rate
bloom:Rate a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "rate"@en ;
    skos:prefLabel "rate"@en ;
    skos:definition "Assign a score or level to something based on criteria."@en ;
    skos:related bloom:Appraise, bloom:Score ;
    skos:example "Rate the usability of a software interface."@en ;
    skos:note "Used in grading rubrics and quality evaluations."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Rating> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Assigning a value or ranking to something."@en .

### http://example.org/bloom#Judge
bloom:Judge a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "judge"@en ;
    skos:prefLabel "judge"@en ;
    skos:definition "Form an opinion or conclusion based on analysis and standards."@en ;
    skos:related bloom:Evaluating, bloom:Assess ;
    skos:example "Judge the relevance of a cited source in a research paper."@en ;
    skos:note "Encourages critical evaluation and ethical reasoning."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Judgment> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Forming an opinion based on criteria."@en .

### http://example.org/bloom#Argue
bloom:Argue a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "argue"@en ;
    skos:prefLabel "argue"@en ;
    skos:definition "Present reasons or evidence to support or oppose a point of view."@en ;
    skos:related bloom:Justify, bloom:Defend ;
    skos:example "Argue for the adoption of open-source software in government."@en ;
    skos:note "Develops logical structure and persuasive writing skills."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Argument> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Presenting reasons for or against something."@en .

### http://example.org/bloom#Critique
bloom:Critique a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "critique"@en ;
    skos:prefLabel "critique"@en ;
    skos:definition "Evaluate something in detail by identifying strengths, weaknesses, and areas for improvement."@en ;
    skos:related bloom:Review, bloom:Evaluating ;
    skos:example "Critique a peer’s essay using the assessment rubric."@en ;
    skos:note "Fosters analytical thinking and constructive feedback."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Critique> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Providing feedback based on criteria and standards."@en .

### http://example.org/bloom#Justify
bloom:Justify a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "justify"@en ;
    skos:prefLabel "justify"@en ;
    skos:definition "Provide reasons, evidence, or rationale to support a decision, action, or viewpoint."@en ;
    skos:related bloom:Defend, bloom:Argue ;
    skos:example "Justify the selection of a user interface layout based on usability heuristics."@en ;
    skos:note "Develops structured argumentation and reasoning abilities."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Justification> ;
    bloom:isActionVerbFor bloom:Evaluating ;
    rdfs:comment "Providing reasons or evidence to support a conclusion."@en .
