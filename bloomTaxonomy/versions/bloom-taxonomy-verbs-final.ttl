###            #####    Verbos de Análise (Analyzing)    #####
bloom:Trace a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "trace"@en ;
    skos:prefLabel "trace"@en ;
    skos:definition "Follow and examine the sequence of execution or data flow in a system"@en ;
    skos:related bloom:Monitor, bloom:Debug, bloom:Investigate ;
    skos:example "Trace variable values through a recursive function"@en ;
    skos:example "Trace network packets to identify security breaches"@en ;
    skos:note "Essential for debugging and security analysis"@en ;
    dcterms:references <https://doi.org/10.1145/3184594> ;
    owl:sameAs <http://dbpedia.org/page/Tracing_(software)> ;
    bloom:isActionVerbFor bloom:Analyzing ;
    rdfs:comment "Following the execution path or data flow." .
	


### http://example.org/bloom#Attribute
bloom:Attribute a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "attribute"@en ;
    skos:prefLabel "attribute"@en ;
    skos:definition "Identify the source, cause, or origin of something."@en ;
    skos:related bloom:Infer, bloom:Determine ;
    skos:example "Attribute a bug to a misconfigured variable."@en ;
    skos:note "Essential in tracing causality or authorship in academic and technical contexts."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Attribution_(disambiguation)> ;
    bloom:isActionVerbFor bloom:Analyzing ;
    rdfs:comment "Determining the source or cause of something."@en .

### http://example.org/bloom#Compare
bloom:Compare a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "compare"@en ;
