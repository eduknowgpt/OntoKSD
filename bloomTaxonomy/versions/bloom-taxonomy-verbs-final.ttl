@prefix bloom: <http://example.org/bloom#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .



###        #####       Verbos de Lembrar (Remembering)     #####

### http://example.org/bloom#Define
bloom:Define a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "define"@en ;
    skos:prefLabel "define"@en ;
    skos:definition "State or identify the precise meaning of a term or concept"@en ;
    skos:related bloom:Identify, bloom:State ;
    skos:example "Define the term 'object-oriented programming'"@en ;
    skos:note "Fundamental verb for establishing shared vocabulary"@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Definition> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Stating the meaning of a term or concept." .
	

### http://example.org/bloom#Describe
bloom:Describe a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "describe"@en ;
    skos:prefLabel "describe"@en ;
    skos:definition "Give a detailed account or representation of something, including its properties or actions."@en ;
    skos:related bloom:Label, bloom:Identify ;
    skos:example "Describe the process of compiling a Java program."@en ;
    skos:note "Frequently used in introductory contexts and procedural descriptions."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Description> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Giving a detailed account of something."@en .

### http://example.org/bloom#Label
bloom:Label a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "label"@en ;
    skos:prefLabel "label"@en ;
    skos:definition "Assign a descriptive or identifying name or symbol to something."@en ;
    skos:related bloom:Name, bloom:Identify ;
    skos:example "Label the parts of a neuron."@en ;
    skos:note "Common in anatomy, diagrams, and classification activities."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Label> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Assigning a label to something."@en .

### http://example.org/bloom#Locate
bloom:Locate a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "locate"@en ;
    skos:prefLabel "locate"@en ;
    skos:definition "Find or identify the position or location of an item or concept."@en ;
    skos:related bloom:Identify, bloom:Retrieve ;
    skos:example "Locate the function definition in the source code."@en ;
    skos:note "Often used in navigation, search, or retrieval tasks."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Location_(geography)> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Finding the position or place of something."@en .

### http://example.org/bloom#Name
bloom:Name a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "name"@en ;
    skos:prefLabel "name"@en ;
    skos:definition "State or specify the name of a person, object, concept, or phenomenon."@en ;
    skos:related bloom:Label, bloom:List ;
    skos:example "Name the primary data types in Python."@en ;
    skos:note "Used frequently in taxonomy, nomenclature, and listings."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Name> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Specifying the name of something."@en .

### http://example.org/bloom#Recognize
bloom:Recognize a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "recognize"@en ;
    skos:prefLabel "recognize"@en ;
    skos:definition "Identify something previously learned when it is presented again."@en ;
    skos:related bloom:Recall, bloom:Identify ;
    skos:example "Recognize the structure of a for loop."@en ;
    skos:note "Essential in pattern recognition and memorization tasks."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Recognition_(memory)> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Identifying something previously learned."@en .

### http://example.org/bloom#Recall
bloom:Recall a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "recall"@en ;
    skos:prefLabel "recall"@en ;
    skos:definition "Retrieve relevant knowledge from memory without a cue."@en ;
    skos:related bloom:Retrieve, bloom:Recognize ;
    skos:example "Recall the syntax for declaring a variable in JavaScript."@en ;
    skos:note "Common in open-ended questions and oral assessments."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Recall_(memory)> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Retrieving relevant knowledge from long-term memory."@en .

### http://example.org/bloom#Retrieve
bloom:Retrieve a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "retrieve"@en ;
    skos:prefLabel "retrieve"@en ;
    skos:definition "Access or recover information from memory or storage."@en ;
    skos:related bloom:Recall, bloom:Recognize ;
    skos:example "Retrieve the formula for calculating standard deviation."@en ;
    skos:note "Used in both human memory and information systems."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Information_retrieval> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Recalling information from memory."@en .

### http://example.org/bloom#Identify
bloom:Identify a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "identify"@en ;
    skos:prefLabel "identify"@en ;
    skos:definition "Determine or establish the identity of someone or something."@en ;
    skos:related bloom:Recognize, bloom:Define ;
    skos:example "Identify the main components of a CPU."@en ;
    skos:note "Fundamental in classification and diagnostic tasks."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Identification_(biology)> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Determining the identity of a subject or object."@en .

### http://example.org/bloom#List
bloom:List a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "list"@en ;
    skos:prefLabel "list"@en ;
    skos:definition "Provide a series of items, facts, or elements in order."@en ;
    skos:related bloom:Name, bloom:Label ;
    skos:example "List the steps of the software development lifecycle."@en ;
    skos:note "Often used in enumerations, outlines, and structured recall."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/List> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Providing a series of related items."@en .

### http://example.org/bloom#Enumerate
bloom:Enumerate a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "enumerate"@en ;
    skos:prefLabel "enumerate"@en ;
    skos:definition "List or count distinct items, often in a specific order."@en ;
    skos:example "Enumerate the layers of the OSI model."@en ;
    skos:note "Useful for recalling sets of technical components or concepts."@en ;
    dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
    owl:sameAs <http://dbpedia.org/page/Enumeration> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Listing items or concepts in a structured format."@en .

### http://example.org/bloom#Reference
bloom:Reference a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "reference"@en ;
    skos:prefLabel "reference"@en ;
    skos:definition "Point to or cite an external source of knowledge or documentation."@en ;
    skos:example "Reference the Python documentation to clarify syntax."@en ;
    skos:note "Develops habits of consulting documentation and standards."@en ;
    dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
    owl:sameAs <http://dbpedia.org/page/Citation> ;
    bloom:isActionVerbFor bloom:Remembering ;
    rdfs:comment "Citing or consulting known sources of information."@en .






###           #####      Verbos de Compreensão (Understanding)     #####
	
### http://example.org/bloom#Discuss
bloom:Discuss a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "discuss"@en ;
    skos:prefLabel "discuss"@en ;
    skos:definition "Talk about a topic in detail, considering various points of view or aspects."@en ;
    skos:related bloom:Explain, bloom:Compare ;
    skos:example "Discuss the advantages and disadvantages of open source software."@en ;
    skos:note "Promotes deeper engagement and articulation of ideas in dialogue or writing."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Discussion> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Talking about a topic in detail."@en .

### http://example.org/bloom#Exemplify
bloom:Exemplify a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "exemplify"@en ;
    skos:prefLabel "exemplify"@en ;
    skos:definition "Provide one or more examples to clarify or support a concept or statement."@en ;
    skos:related bloom:Illustrate, bloom:Explain ;
    skos:example "Exemplify the use of recursion with the factorial function."@en ;
    skos:note "Helps bridge abstract concepts to concrete understanding."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Example> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Giving examples to illustrate a concept."@en .

### http://example.org/bloom#Infer
bloom:Infer a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "infer"@en ;
    skos:prefLabel "infer"@en ;
    skos:definition "Draw conclusions or make assumptions based on available evidence and reasoning."@en ;
    skos:related bloom:Predict, bloom:Interpret ;
    skos:example "Infer the user’s intent based on their search behavior."@en ;
    skos:note "Important for developing reasoning and critical thinking skills."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Inference> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Drawing conclusions from evidence and reasoning."@en .

### http://example.org/bloom#Interpret
bloom:Interpret a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "interpret"@en ;
    skos:prefLabel "interpret"@en ;
    skos:definition "Explain or make sense of information, often translating it from one form to another."@en ;
    skos:related bloom:Translate, bloom:Paraphrase ;
    skos:example "Interpret the meaning of a metaphor in a poem."@en ;
    skos:note "Useful for making content accessible across different media or forms."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Interpretation> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Explaining the meaning of information."@en .

### http://example.org/bloom#Paraphrase
bloom:Paraphrase a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "paraphrase"@en ;
    skos:prefLabel "paraphrase"@en ;
    skos:definition "Restate information in one’s own words while preserving meaning."@en ;
    skos:related bloom:Summarize, bloom:Interpret ;
    skos:example "Paraphrase the thesis statement of an essay."@en ;
    skos:note "Develops comprehension and ability to reformulate ideas."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Paraphrase> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Restating information in one's own words."@en .

### http://example.org/bloom#Predict
bloom:Predict a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "predict"@en ;
    skos:prefLabel "predict"@en ;
    skos:definition "State or estimate what will happen in the future based on current knowledge or evidence."@en ;
    skos:related bloom:Infer, bloom:Hypothesize ;
    skos:example "Predict the output of an algorithm for a given input."@en ;
    skos:note "Encourages anticipation and forward-thinking strategies."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Prediction> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Stating what will happen in the future based on current information."@en .

### http://example.org/bloom#Classify
bloom:Classify a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "classify"@en ;
    skos:prefLabel "classify"@en ;
    skos:definition "Arrange or organize items into groups based on shared properties or criteria."@en ;
    skos:related bloom:Group, bloom:Categorize ;
    skos:example "Classify programming languages according to paradigm."@en ;
    skos:note "Supports logical organization and taxonomy development."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Classification> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Grouping items into categories based on shared characteristics."@en .

### http://example.org/bloom#Compare
bloom:Compare a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "compare"@en ;
    skos:prefLabel "compare"@en ;
    skos:definition "Identify similarities and/or differences between two or more elements."@en ;
    skos:related bloom:Contrast, bloom:Analyzing ;
    skos:example "Compare bubble sort and merge sort algorithms."@en ;
    skos:note "Promotes analytical thinking and evaluation."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Comparison> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Identifying similarities and differences."@en .

### http://example.org/bloom#Explain
bloom:Explain a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "explain"@en ;
    skos:prefLabel "explain"@en ;
    skos:definition "Make something clear by describing it in detail, including relevant facts or ideas."@en ;
    skos:related bloom:Discuss, bloom:Describe ;
    skos:example "Explain how a neural network functions."@en ;
    skos:note "Often used in knowledge checks and explanatory writing."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Explanation> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Making something clear by describing it in detail."@en .

### http://example.org/bloom#Summarize
bloom:Summarize a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "summarize"@en ;
    skos:prefLabel "summarize"@en ;
    skos:definition "Give a brief statement of the main points of a concept, text, or discussion."@en ;
    skos:related bloom:Paraphrase, bloom:Abstract ;
    skos:example "Summarize the main ideas of a research paper."@en ;
    skos:note "Develops the ability to focus on key information."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Summary> ;
    bloom:isActionVerbFor bloom:Understanding ;
    rdfs:comment "Giving a brief statement of the main points."@en .







###         #####   Verbos de Aplicação (Applying) - Exemplo Técnico    #####
bloom:Code a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "code"@en ;
    skos:prefLabel "code"@en ;
    skos:definition "Write instructions in a programming language to create software"@en ;
    skos:related bloom:Program, bloom:Script, bloom:Debug ;
    skos:example "Code a Python function to calculate Fibonacci sequence"@en ;
    skos:note "Distinct from higher-level 'program' or 'design'"@en ;
    dcterms:references <https://doi.org/10.1145/3453538> ;
    owl:sameAs <http://dbpedia.org/page/Computer_programming> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Writing computer programs or scripts." .
	


### http://example.org/bloom#Calculate
bloom:Calculate a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "calculate"@en ;
    skos:prefLabel "calculate"@en ;
    skos:definition "Determine a numerical result using mathematical procedures or formulas."@en ;
    skos:related bloom:Compute, bloom:Solve ;
    skos:example "Calculate the area of a circle with radius 5."@en ;
    skos:note "Common in STEM disciplines where quantitative reasoning is applied."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Calculation> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Determining a numerical result."@en .

### http://example.org/bloom#Demonstrate
bloom:Demonstrate a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "demonstrate"@en ;
    skos:prefLabel "demonstrate"@en ;
    skos:definition "Show clearly and deliberately how something works or is done."@en ;
    skos:related bloom:Perform, bloom:Illustrate ;
    skos:example "Demonstrate how to solve a quadratic equation."@en ;
    skos:note "Useful in lab, training, and skill-based learning environments."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Demonstration_(teaching)> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Showing how to do something."@en .

### http://example.org/bloom#Solve
bloom:Solve a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "solve"@en ;
    skos:prefLabel "solve"@en ;
    skos:definition "Find an answer or explanation for a problem or question."@en ;
    skos:related bloom:Calculate, bloom:Execute ;
    skos:example "Solve a system of linear equations."@en ;
    skos:note "Central to problem-based learning activities."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Solution_(mathematics)> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Finding a solution to a problem."@en .
	

### http://example.org/bloom#Perform
bloom:Perform a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "perform"@en ;
    skos:prefLabel "perform"@en ;
    skos:definition "Carry out an action, task, or function, especially one involving skill."@en ;
    skos:related bloom:Execute, bloom:Demonstrate ;
    skos:example "Perform a security audit of a web application."@en ;
    skos:note "Common in vocational, medical, and technical training."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Performance> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Carrying out an action or task."@en .

### http://example.org/bloom#Operate
bloom:Operate a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "operate"@en ;
    skos:prefLabel "operate"@en ;
    skos:definition "Control or manage the functioning of a system, machine, or process."@en ;
    skos:related bloom:Use, bloom:Perform ;
    skos:example "Operate a CNC machine to manufacture a component."@en ;
    skos:note "Used in mechanical, technical, and systems contexts."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Operation> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Performing a function or action."@en .

### http://example.org/bloom#Illustrate
bloom:Illustrate a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "illustrate"@en ;
    skos:prefLabel "illustrate"@en ;
    skos:definition "Use examples, diagrams, or other visual elements to clarify a concept."@en ;
    skos:related bloom:Exemplify, bloom:Demonstrate ;
    skos:example "Illustrate the flow of control in a for loop with a diagram."@en ;
    skos:note "Supports visual learning and concept reinforcement."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Illustration> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Providing visual or concrete examples."@en .

### http://example.org/bloom#Execute
bloom:Execute a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "execute"@en ;
    skos:prefLabel "execute"@en ;
    skos:definition "Carry out a pre-defined procedure or plan of action."@en ;
    skos:related bloom:Perform, bloom:Implement ;
    skos:example "Execute the instructions in a programming script."@en ;
    skos:note "Often associated with automation, procedures, and algorithms."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Execution_(computing)> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Carrying out a procedure."@en .

### http://example.org/bloom#Use
bloom:Use a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "use"@en ;
    skos:prefLabel "use"@en ;
    skos:definition "Employ knowledge, tools, or methods to complete a task or solve a problem."@en ;
    skos:related bloom:Applying, bloom:Operate ;
    skos:example "Use a debugger to identify syntax errors."@en ;
    skos:note "Foundational to task-oriented and experiential learning."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Usage> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Employing knowledge or skills in a practical situation."@en .

### http://example.org/bloom#Implement
bloom:Implement a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "implement"@en ;
    skos:prefLabel "implement"@en ;
    skos:definition "Put a plan, method, or idea into effect in a new context."@en ;
    skos:related bloom:Applying, bloom:Execute ;
    skos:example "Implement a sorting algorithm in Python."@en ;
    skos:note "Bridges theoretical knowledge with practical application."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Implementation> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Using a procedure in a new situation."@en .

	
	
### http://example.org/bloom#Install
bloom:Install a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "install"@en ;
    skos:prefLabel "install"@en ;
    skos:definition "Set up software or hardware so that it is ready for use in a given system or environment."@en ;
    skos:example "Install a Linux distribution on a virtual machine."@en ;
    skos:note "Crucial for configuring environments in computing practice."@en ;
    dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
    owl:sameAs <http://dbpedia.org/page/Installation_(computer_programs)> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Setting up systems or tools for use."@en .

### http://example.org/bloom#Run
bloom:Run a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "run"@en ;
    skos:prefLabel "run"@en ;
    skos:definition "Execute a program, script, or command in a computing environment."@en ;
    skos:example "Run a simulation script in Python."@en ;
    skos:note "Typically used to test or observe system behavior in real time."@en ;
    dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
    owl:sameAs <http://dbpedia.org/page/Execution_(computing)> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Executing code or commands."@en .

### http://example.org/bloom#Compile
bloom:Compile a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "compile"@en ;
    skos:prefLabel "compile"@en ;
    skos:definition "Translate source code written in a high-level language into machine code or an intermediate form."@en ;
    skos:example "Compile a Java program using javac."@en ;
    skos:note "Essential in software development involving compiled languages."@en ;
    dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
    owl:sameAs <http://dbpedia.org/page/Compiler> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Transforming source code into executable format."@en .

### http://example.org/bloom#Encrypt
bloom:Encrypt a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "encrypt"@en ;
    skos:prefLabel "encrypt"@en ;
    skos:definition "Convert data into a coded format to prevent unauthorized access."@en ;
    skos:example "Encrypt a file using a public key."@en ;
    skos:note "Fundamental in cybersecurity practices."@en ;
    dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
    owl:sameAs <http://dbpedia.org/page/Encryption> ;
    bloom:isActionVerbFor bloom:Applying ;
    rdfs:comment "Securing data using cryptographic methods."@en .

### http://example.org/bloom#Decrypt
bloom:Decrypt a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "decrypt"@en ;
    skos:prefLabel "decrypt"@en ;
    skos:definition "Convert encrypted data back into its original readable form."@en ;
