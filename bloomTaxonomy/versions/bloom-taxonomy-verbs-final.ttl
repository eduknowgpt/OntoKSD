    skos:definition "Examine two or more elements to identify similarities and differences."@en ;
    skos:related bloom:Contrast, bloom:Differentiate ;
    skos:example "Compare two sorting algorithms in terms of time complexity."@en ;
    skos:note "Widely used in contrastive analysis and decision making."@en ;
    dcterms:references <https://doi.org/10.1145/3467967> ;
    owl:sameAs <http://dbpedia.org/page/Comparison> ;
    bloom:isActionVerbFor bloom:Analyzing ;
    rdfs:comment "Examining the similarities and differences."@en .

### http://example.org/bloom#Contrast
bloom:Contrast a bloom:ActionVerb, owl:NamedIndividual ;
    rdfs:label "contrast"@en ;
