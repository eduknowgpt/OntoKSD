###  http://purl.org/edu/bloom#test
bloom:test rdf:type owl:NamedIndividual ,
                    bloom:ActionVerb ;
           bloom:hasActionVerbType bloom:CS2023Verb ,
                                   bloom:StandardVerb ;
           bloom:isActionVerbFor bloom:Evaluating ,
                                 cs2023:Apply ;
           rdfs:comment "A verb categorized under 'Evaluating' in Bloom's Revised Taxonomy."@en ;
           rdfs:label "test"@en ;
           skos:definition "Assess or examine against criteria to determine validity or reliability."@en ;
           skos:example "Test the effectiveness of a machine learning model."@en ;
           skos:note "Part of the standard cognitive process level: Evaluate."@en ;
           skos:prefLabel "test"@en .


###  http://purl.org/edu/bloom#trace
bloom:trace rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ,
                               <https://doi.org/10.1145/3184594> ;
            bloom:hasActionVerbType bloom:CS2023Verb ,
                                    bloom:ComputingVerb ;
            bloom:isActionVerbFor bloom:Analyzing ,
                                  cs2023:Apply ;
            rdfs:comment "Follow the execution path or data flow to diagnose system behavior."@en ;
            rdfs:label "trace"@en ;
            skos:definition "Track the sequence of execution or data propagation within a system."@en ;
            skos:example "Trace a linked list of unauthorized users in the system."@en ,
                         "Trace a variable's value across code module execution."@en ,
                         "Trace activity to detect a deadlock condition."@en ;
            skos:note "Vital for debugging, security analysis, and system understanding."@en ;
            skos:prefLabel "trace"@en ;
            skos:related bloom:debug ,
                         bloom:investigate ,
                         bloom:monitor .


###  http://purl.org/edu/bloom#train
bloom:train rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            dcterms:references <https://doi.org/10.1145/3573260> ;
            bloom:hasActionVerbType bloom:CS2023Verb ,
                                    bloom:ComputingVerb ;
            bloom:isActionVerbFor bloom:Applying ,
                                  cs2023:Apply ;
            rdfs:comment "Use data to adjust and optimize models or systems for improved output."@en ;
            rdfs:label "train"@en ;
            skos:definition "Iteratively improve a model or system by feeding it data for performance tuning."@en ;
            skos:example "Train a neural network to recognize handwritten digits."@en ,
                         "Train an ML model on stored datasets to enhance accuracy."@en ,
                         "Train users to identify phishing emails."@en ;
            skos:note "Common in machine learning, AI, and user education processes."@en ;
            skos:prefLabel "train"@en ;
            skos:related bloom:evaluate ,
                         bloom:teach .


###  http://purl.org/edu/bloom#translate
bloom:translate rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
                bloom:hasActionVerbType bloom:CS2023Verb ,
                                        bloom:ComputingVerb ;
                bloom:isActionVerbFor bloom:Analyzing ,
                                      cs2023:Explain ;
                rdfs:comment "Convert data or designs between representations or abstraction levels."@en ;
                rdfs:label "translate"@en ;
                skos:definition "Convert information from one form or notation to another such that the meaning is preserved."@en ;
                skos:example "Translate a business problem into a data science solution."@en ,
                             "Translate system design specifications into implementation code."@en ,
                             "Translate written communication into effective oral delivery."@en ;
                skos:note "Crucial for abstraction, interoperability, and cross-domain implementation."@en ;
                skos:prefLabel "translate"@en ;
                skos:related bloom:implement ,
                             bloom:model .


###  http://purl.org/edu/bloom#update
bloom:update rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:hasActionVerbType bloom:ComputingVerb ;
             bloom:isActionVerbFor bloom:Analyzing ;
             rdfs:comment "Modify system components in response to new requirements or data."@en ;
             rdfs:label "update"@en ;
             skos:definition "Alter or enhance parts of a system based on evolving information or objectives."@en ;
             skos:example "Update a data-driven model for a given scenario."@en ,
                          "Update software to include additional features."@en ,
                          "Update website resources to meet evolving organizational needs."@en ;
             skos:note "Reflects iterative design and maintenance in computing workflows."@en ;
             skos:prefLabel "update"@en ;
             skos:related bloom:maintain ,
                          bloom:refactor .


###  http://purl.org/edu/bloom#use
bloom:use rdf:type owl:NamedIndividual ,
                   bloom:ActionVerb ;
