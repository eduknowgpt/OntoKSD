          bloom:hasActionVerbType bloom:StandardVerb ;
          bloom:isActionVerbFor bloom:Applying ;
          rdfs:comment "Employing knowledge or skills in a practical situation."@en ;
          rdfs:label "use"@en ;
          skos:definition "Employ knowledge, tools, or methods to complete a task or solve a problem."@en ;
          skos:example "Use a debugger to identify syntax errors."@en ;
          skos:note "Foundational to task-oriented and experiential learning."@en ;
          skos:prefLabel "use"@en ;
          skos:related bloom:applying ,
                       bloom:operate .


###  http://purl.org/edu/bloom#validate
bloom:validate rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ,
                                  <https://doi.org/10.1145/3453538> ;
               bloom:hasActionVerbType bloom:ComputingVerb ;
               bloom:isActionVerbFor bloom:Evaluating ;
               rdfs:comment "Confirm that systems or components meet required criteria."@en ,
                            "Assessing correctness and effectiveness." ;
               rdfs:label "validate"@en ;
               skos:definition "Check or prove the accuracy, quality, or effectiveness of a system or model"@en ,
                               "Verify that a component or system behaves as expected under specified conditions."@en ;
               skos:example "Validate a machine learning model using test datasets"@en ,
                            "Validate security of software using a defined test plan."@en ,
                            "Validate server cluster functionality using appropriate tools."@en ;
               skos:note "Critical for acceptance testing, compliance, and system assurance."@en ,
                         "Critical phase in software development and data science"@en ;
               skos:prefLabel "validate"@en ;
               skos:related bloom:debug ,
                            bloom:prove ,
                            bloom:test ,
                            bloom:verify .


