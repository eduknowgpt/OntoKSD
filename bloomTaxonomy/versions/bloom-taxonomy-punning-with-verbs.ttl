<http://dbpedia.org/wiki/Verification_and_validation> rdf:type owl:NamedIndividual ;
                                                      owl:sameAs bloom:Validate .


###  http://example.org/bloom#Analyze
bloom:Analyze rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Analyzing ;
              <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
              rdfs:comment "Breaking down a system or idea into constituent parts to understand it better."@en ;
              rdfs:label "analyze"@en ;
              skos:definition "Break down a system, process, or dataset into its components to understand structure, function, or behavior."@en ;
              skos:example "Analyze a sorting algorithm to determine its time complexity."@en ;
              skos:note "Core cognitive action in computing tasks such as algorithm analysis, systems evaluation, and data inspection."@en ;
              skos:prefLabel "analyze"@en .


###  http://example.org/bloom#Analyzing
bloom:Analyzing rdf:type owl:NamedIndividual ,
                         bloom:CognitiveProcessLevel ;
                bloom:precedes bloom:Evaluating ;
                bloom:hasComplexityLevel 4 .


###  http://example.org/bloom#Applying
bloom:Applying rdf:type owl:NamedIndividual ,
                        bloom:CognitiveProcessLevel ;
               bloom:precedes bloom:Analyzing ;
               bloom:hasComplexityLevel 3 .


###  http://example.org/bloom#Appraise
bloom:Appraise rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Evaluating ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Assessing the value or quality of something."@en ;
               rdfs:label "appraise"@en ;
               skos:definition "Assess the value, significance, or quality of something."@en ;
               skos:example "Appraise the effectiveness of a marketing strategy."@en ;
               skos:note "Common in evaluations of performance or proposals."@en ;
               skos:prefLabel "appraise"@en ;
               skos:related bloom:Assess ,
                            bloom:Rate .


###  http://example.org/bloom#Argue
bloom:Argue rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            bloom:isActionVerbFor bloom:Evaluating ;
            <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
            rdfs:comment "Presenting reasons for or against something."@en ;
            rdfs:label "argue"@en ;
            skos:definition "Present reasons or evidence to support or oppose a point of view."@en ;
            skos:example "Argue for the adoption of open-source software in government."@en ;
            skos:note "Develops logical structure and persuasive writing skills."@en ;
            skos:prefLabel "argue"@en ;
            skos:related bloom:Defend ,
                         bloom:Justify .


###  http://example.org/bloom#Assemble
bloom:Assemble rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Creating ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Putting together various elements."@en ;
               rdfs:label "assemble"@en ;
               skos:definition "Put together separate components or elements into a functional whole."@en ;
               skos:example "Assemble a presentation from multiple sources."@en ;
               skos:note "Frequently used in prototyping, documentation, and synthesis tasks."@en ;
               skos:prefLabel "assemble"@en ;
               skos:related bloom:Build ,
                            bloom:Construct .


###  http://example.org/bloom#Assess
bloom:Assess rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:isActionVerbFor bloom:Evaluating ;
             <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
             rdfs:comment "Evaluating the nature or quality of something."@en ;
             rdfs:label "assess"@en ;
             skos:definition "Evaluate the nature, ability, or quality of something."@en ;
             skos:example "Assess the clarity of a student's explanation."@en ;
             skos:note "Widely used in educational, technical, and clinical assessments."@en ;
             skos:prefLabel "assess"@en ;
             skos:related bloom:Appraise ,
                          bloom:Judge .


###  http://example.org/bloom#Attribute
bloom:Attribute rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Analyzing ;
                <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                rdfs:comment "Determining the source or cause of something."@en ;
                rdfs:label "attribute"@en ;
                skos:definition "Identify the source, cause, or origin of something."@en ;
                skos:example "Attribute a bug to a misconfigured variable."@en ;
                skos:note "Essential in tracing causality or authorship in academic and technical contexts."@en ;
                skos:prefLabel "attribute"@en ;
                skos:related bloom:Determine ,
                             bloom:Infer .


###  http://example.org/bloom#Backup
bloom:Backup rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:isActionVerbFor bloom:Applying ;
             <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
             rdfs:comment "Creating redundant copies for recovery."@en ;
             rdfs:label "backup"@en ;
             skos:definition "Create copies of data or systems to prevent loss and ensure recoverability."@en ;
             skos:example "Backup system files to a remote server."@en ;
             skos:note "Essential for data integrity and business continuity."@en ;
             skos:prefLabel "backup"@en .


###  http://example.org/bloom#Calculate
bloom:Calculate rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Applying ;
                <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                rdfs:comment "Determining a numerical result."@en ;
                rdfs:label "calculate"@en ;
                skos:definition "Determine a numerical result using mathematical procedures or formulas."@en ;
                skos:example "Calculate the area of a circle with radius 5."@en ;
                skos:note "Common in STEM disciplines where quantitative reasoning is applied."@en ;
                skos:prefLabel "calculate"@en ;
                skos:related bloom:Compute ,
                             bloom:Solve .


###  http://example.org/bloom#Check
bloom:Check rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            bloom:isActionVerbFor bloom:Evaluating ;
            <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
            rdfs:comment "Assessing the validity of statements or arguments."@en ;
            rdfs:label "check"@en ;
            skos:definition "Examine something to determine its accuracy, validity, or condition."@en ;
            skos:example "Check the correctness of the calculated result."@en ;
            skos:note "Common in troubleshooting, debugging, and validation."@en ;
            skos:prefLabel "check"@en ;
            skos:related bloom:Inspect ,
                         bloom:Verify .


###  http://example.org/bloom#Classify
bloom:Classify rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Understanding ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Grouping items into categories based on shared characteristics."@en ;
               rdfs:label "classify"@en ;
               skos:definition "Arrange or organize items into groups based on shared properties or criteria."@en ;
               skos:example "Classify programming languages according to paradigm."@en ;
               skos:note "Supports logical organization and taxonomy development."@en ;
               skos:prefLabel "classify"@en ;
               skos:related bloom:Categorize ,
                            bloom:Group .


###  http://example.org/bloom#Code
bloom:Code rdf:type owl:NamedIndividual ,
                    bloom:ActionVerb ;
           bloom:isActionVerbFor bloom:Applying ;
           <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3453538> ;
           rdfs:comment "Writing computer programs or scripts." ;
           rdfs:label "code"@en ;
           skos:definition "Write instructions in a programming language to create software"@en ;
           skos:example "Code a Python function to calculate Fibonacci sequence"@en ;
           skos:note "Distinct from higher-level 'program' or 'design'"@en ;
           skos:prefLabel "code"@en ;
           skos:related bloom:Debug ,
                        bloom:Program ,
                        bloom:Script .


###  http://example.org/bloom#Compare
bloom:Compare rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Analyzing ,
                                    bloom:Understanding ;
              <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
              rdfs:comment "Examining the similarities and differences."@en ,
                           "Identifying similarities and differences."@en ;
              rdfs:label "compare"@en ;
              skos:definition "Examine two or more elements to identify similarities and differences."@en ,
                              "Identify similarities and/or differences between two or more elements."@en ;
              skos:example "Compare bubble sort and merge sort algorithms."@en ,
                           "Compare two sorting algorithms in terms of time complexity."@en ;
              skos:note "Promotes analytical thinking and evaluation."@en ,
                        "Widely used in contrastive analysis and decision making."@en ;
              skos:prefLabel "compare"@en ;
              skos:related bloom:Analyzing ,
                           bloom:Contrast ,
                           bloom:Differentiate .


###  http://example.org/bloom#Compile
bloom:Compile rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Applying ;
              <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
              rdfs:comment "Transforming source code into executable format."@en ;
              rdfs:label "compile"@en ;
              skos:definition "Translate source code written in a high-level language into machine code or an intermediate form."@en ;
              skos:example "Compile a Java program using javac."@en ;
              skos:note "Essential in software development involving compiled languages."@en ;
              skos:prefLabel "compile"@en .


###  http://example.org/bloom#Compose
bloom:Compose rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Creating ;
              <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
              rdfs:comment "Creating a work of art or text."@en ;
              rdfs:label "compose"@en ;
              skos:definition "Create a written, musical, or visual work by combining elements into a structured whole."@en ;
              skos:example "Compose a poem about technology and society."@en ;
              skos:note "Emphasizes artistic or linguistic creation."@en ;
              skos:prefLabel "compose"@en ;
              skos:related bloom:Creating ,
                           bloom:Develop .


###  http://example.org/bloom#Construct
bloom:Construct rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Creating ;
                <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                rdfs:comment "Building something."@en ;
                rdfs:label "construct"@en ;
                skos:definition "Build or assemble a tangible or conceptual object using components or ideas."@en ;
                skos:example "Construct a mind map to represent research findings."@en ;
                skos:note "Can apply to physical, digital, or abstract domains."@en ;
                skos:prefLabel "construct"@en ;
                skos:related bloom:Assemble ,
                             bloom:Develop .


###  http://example.org/bloom#Contextualize
bloom:Contextualize rdf:type owl:NamedIndividual ,
                             bloom:ActionVerb ;
                    bloom:isActionVerbFor bloom:Analyzing ;
                    <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
                    rdfs:comment "Relating information or problems to broader contexts."@en ;
                    rdfs:label "contextualize"@en ;
                    skos:definition "Place an element, process, or result in its broader technical, social, or ethical context."@en ;
                    skos:example "Contextualize the use of facial recognition in surveillance systems."@en ;
                    skos:note "Important for responsible computing and systems analysis."@en ;
                    skos:prefLabel "contextualize"@en .


###  http://example.org/bloom#Contrast
bloom:Contrast rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Analyzing ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Highlighting the differences between things."@en ;
               rdfs:label "contrast"@en ;
               skos:definition "Emphasize the differences between two or more elements."@en ;
               skos:example "Contrast imperative and declarative programming paradigms."@en ;
               skos:note "Supports analytical judgment and model evaluation."@en ;
               skos:prefLabel "contrast"@en ;
               skos:related bloom:CompareAnalyze ,
                            bloom:Differentiate .


###  http://example.org/bloom#Creating
bloom:Creating rdf:type owl:NamedIndividual ,
                        bloom:CognitiveProcessLevel ;
               bloom:hasComplexityLevel 6 .


###  http://example.org/bloom#Critique
bloom:Critique rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Evaluating ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Providing feedback based on criteria and standards."@en ;
               rdfs:label "critique"@en ;
               skos:definition "Evaluate something in detail by identifying strengths, weaknesses, and areas for improvement."@en ;
               skos:example "Critique a peer’s essay using the assessment rubric."@en ;
               skos:note "Fosters analytical thinking and constructive feedback."@en ;
               skos:prefLabel "critique"@en ;
               skos:related bloom:Evaluating ,
                            bloom:Review .


###  http://example.org/bloom#Decrypt
bloom:Decrypt rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Applying ;
              <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
              rdfs:comment "Restoring encrypted information to readable form."@en ;
              rdfs:label "decrypt"@en ;
              skos:definition "Convert encrypted data back into its original readable form."@en ;
              skos:example "Decrypt an email message using a private key."@en ;
              skos:note "Complements encryption in secure communication."@en ;
              skos:prefLabel "decrypt"@en .


###  http://example.org/bloom#Defend
bloom:Defend rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:isActionVerbFor bloom:Evaluating ;
             <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
             rdfs:comment "Supporting a position with evidence."@en ;
             rdfs:label "defend"@en ;
             skos:definition "Support a claim or position with logical reasoning and evidence."@en ;
             skos:example "Defend your choice of algorithm in terms of efficiency."@en ;
             skos:note "Often appears in debates, essays, and oral defenses."@en ;
             skos:prefLabel "defend"@en ;
             skos:related bloom:Argue ,
                          bloom:Justify .


###  http://example.org/bloom#Define
bloom:Define rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:isActionVerbFor bloom:Remembering ;
             <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
             rdfs:comment "Stating the meaning of a term or concept." ;
             rdfs:label "define"@en ;
             skos:definition "State or identify the precise meaning of a term or concept"@en ;
             skos:example "Define the term 'object-oriented programming'"@en ;
             skos:note "Fundamental verb for establishing shared vocabulary"@en ;
             skos:prefLabel "define"@en ;
             skos:related bloom:Identify ,
                          bloom:State .


###  http://example.org/bloom#Demonstrate
bloom:Demonstrate rdf:type owl:NamedIndividual ,
                           bloom:ActionVerb ;
                  bloom:isActionVerbFor bloom:Applying ;
                  <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                  rdfs:comment "Showing how to do something."@en ;
                  rdfs:label "demonstrate"@en ;
                  skos:definition "Show clearly and deliberately how something works or is done."@en ;
                  skos:example "Demonstrate how to solve a quadratic equation."@en ;
                  skos:note "Useful in lab, training, and skill-based learning environments."@en ;
                  skos:prefLabel "demonstrate"@en ;
                  skos:related bloom:Illustrate ,
                               bloom:Perform .


###  http://example.org/bloom#Deploy
bloom:Deploy rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:isActionVerbFor bloom:Applying ;
             <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
             rdfs:comment "Making systems or services available for use."@en ;
             rdfs:label "deploy"@en ;
             skos:definition "Release software or systems into an operational environment for use."@en ;
             skos:example "Deploy a web application to a cloud platform."@en ;
             skos:note "Key in DevOps and software release lifecycles."@en ;
             skos:prefLabel "deploy"@en .


###  http://example.org/bloom#Describe
bloom:Describe rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Remembering ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Giving a detailed account of something."@en ;
               rdfs:label "describe"@en ;
               skos:definition "Give a detailed account or representation of something, including its properties or actions."@en ;
               skos:example "Describe the process of compiling a Java program."@en ;
               skos:note "Frequently used in introductory contexts and procedural descriptions."@en ;
               skos:prefLabel "describe"@en ;
               skos:related bloom:Identify ,
                            bloom:Label .


###  http://example.org/bloom#Design
bloom:Design rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:isActionVerbFor bloom:Creating ;
             <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
             rdfs:comment "Developing a detailed plan or concept."@en ;
             rdfs:label "design"@en ;
             skos:definition "Create a detailed plan or blueprint for something to be constructed or executed."@en ;
             skos:example "Design a database schema for an online store."@en ;
             skos:note "Core activity in engineering, computing, and instructional development."@en ;
             skos:prefLabel "design"@en ;
             skos:related bloom:Develop ,
                          bloom:Plan .


###  http://example.org/bloom#Detect
bloom:Detect rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:isActionVerbFor bloom:Analyzing ;
             <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
             rdfs:comment "Identifying relevant events, anomalies, or signals."@en ;
             rdfs:label "detect"@en ;
             skos:definition "Identify the presence of a specific event, condition, or anomaly within a system."@en ;
             skos:example "Detect unauthorized login attempts in a system log."@en ;
             skos:note "Widely used in cybersecurity, diagnostics, and analytics."@en ;
             skos:prefLabel "detect"@en .


###  http://example.org/bloom#Develop
bloom:Develop rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Creating ;
              <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
              rdfs:comment "Elaborating on an idea or project."@en ;
              rdfs:label "develop"@en ;
              skos:definition "Advance or expand an idea, product, or process from conception to implementation."@en ;
              skos:example "Develop a software prototype based on user requirements."@en ;
              skos:note "Often represents the full lifecycle from design to testable version."@en ;
              skos:prefLabel "develop"@en ;
              skos:related bloom:Design ,
                           bloom:Produce .


###  http://example.org/bloom#Differentiate
bloom:Differentiate rdf:type owl:NamedIndividual ,
                             bloom:ActionVerb ;
                    bloom:isActionVerbFor bloom:Analyzing ;
                    <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                    rdfs:comment "Distinguishing relevant from irrelevant parts."@en ;
                    rdfs:label "differentiate"@en ;
                    skos:definition "Distinguish between elements based on characteristics, relevance, or importance."@en ;
                    skos:example "Differentiate critical from non-critical errors in a log file."@en ;
                    skos:note "Key to prioritization and evidence-based decision making."@en ;
                    skos:prefLabel "differentiate"@en ;
                    skos:related bloom:CompareAnalyze ,
                                 bloom:Discriminate .


###  http://example.org/bloom#Discuss
bloom:Discuss rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Understanding ;
              <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
              rdfs:comment "Talking about a topic in detail."@en ;
              rdfs:label "discuss"@en ;
              skos:definition "Talk about a topic in detail, considering various points of view or aspects."@en ;
              skos:example "Discuss the advantages and disadvantages of open source software."@en ;
              skos:note "Promotes deeper engagement and articulation of ideas in dialogue or writing."@en ;
              skos:prefLabel "discuss"@en ;
              skos:related bloom:Compare ,
                           bloom:Explain .


###  http://example.org/bloom#Encrypt
bloom:Encrypt rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Applying ;
              <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
              rdfs:comment "Securing data using cryptographic methods."@en ;
              rdfs:label "encrypt"@en ;
              skos:definition "Convert data into a coded format to prevent unauthorized access."@en ;
              skos:example "Encrypt a file using a public key."@en ;
              skos:note "Fundamental in cybersecurity practices."@en ;
              skos:prefLabel "encrypt"@en .


###  http://example.org/bloom#Enumerate
bloom:Enumerate rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Remembering ;
                <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
                rdfs:comment "Listing items or concepts in a structured format."@en ;
                rdfs:label "enumerate"@en ;
                skos:definition "List or count distinct items, often in a specific order."@en ;
                skos:example "Enumerate the layers of the OSI model."@en ;
                skos:note "Useful for recalling sets of technical components or concepts."@en ;
                skos:prefLabel "enumerate"@en .


###  http://example.org/bloom#Evaluating
bloom:Evaluating rdf:type owl:NamedIndividual ,
                          bloom:CognitiveProcessLevel ;
                 bloom:precedes bloom:Creating ;
                 bloom:hasComplexityLevel 5 .


###  http://example.org/bloom#Examine
bloom:Examine rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Analyzing ;
              <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
              rdfs:comment "Inspecting something in detail."@en ;
              rdfs:label "examine"@en ;
              skos:definition "Inspect something carefully to determine its nature or condition."@en ;
              skos:example "Examine the structure of a linked list implementation."@en ;
              skos:note "Important in exploratory and observational learning."@en ;
              skos:prefLabel "examine"@en ;
              skos:related bloom:Analyzing ,
                           bloom:Investigate .


###  http://example.org/bloom#Execute
bloom:Execute rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Applying ;
              <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
              rdfs:comment "Carrying out a procedure."@en ;
              rdfs:label "execute"@en ;
              skos:definition "Carry out a pre-defined procedure or plan of action."@en ;
              skos:example "Execute the instructions in a programming script."@en ;
              skos:note "Often associated with automation, procedures, and algorithms."@en ;
              skos:prefLabel "execute"@en ;
              skos:related bloom:Implement ,
                           bloom:Perform .


###  http://example.org/bloom#Exemplify
bloom:Exemplify rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Understanding ;
                <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                rdfs:comment "Giving examples to illustrate a concept."@en ;
                rdfs:label "exemplify"@en ;
                skos:definition "Provide one or more examples to clarify or support a concept or statement."@en ;
                skos:example "Exemplify the use of recursion with the factorial function."@en ;
                skos:note "Helps bridge abstract concepts to concrete understanding."@en ;
                skos:prefLabel "exemplify"@en ;
                skos:related bloom:Explain ,
                             bloom:Illustrate .


###  http://example.org/bloom#Explain
bloom:Explain rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Understanding ;
              <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
              rdfs:comment "Making something clear by describing it in detail."@en ;
              rdfs:label "explain"@en ;
              skos:definition "Make something clear by describing it in detail, including relevant facts or ideas."@en ;
              skos:example "Explain how a neural network functions."@en ;
              skos:note "Often used in knowledge checks and explanatory writing."@en ;
              skos:prefLabel "explain"@en ;
              skos:related bloom:Describe ,
                           bloom:Discuss .


###  http://example.org/bloom#Formulate
bloom:Formulate rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Creating ;
                <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                rdfs:comment "Creating a strategy or proposal."@en ;
                rdfs:label "formulate"@en ;
                skos:definition "Devise a strategy, plan, or expression in a clear and organized manner."@en ;
                skos:example "Formulate a set of usability principles for mobile apps."@en ;
                skos:note "Supports abstraction and structured design."@en ;
                skos:prefLabel "formulate"@en ;
                skos:related bloom:Plan ,
                             bloom:Propose .


###  http://example.org/bloom#Generate
bloom:Generate rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Creating ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Producing new ideas or solutions."@en ;
               rdfs:label "generate"@en ;
               skos:definition "Produce ideas, options, or possibilities based on given input or criteria."@en ;
               skos:example "Generate hypotheses for a science experiment."@en ;
               skos:note "Often the first step in divergent thinking and ideation."@en ;
               skos:prefLabel "generate"@en ;
               skos:related bloom:Creating ,
                            bloom:Invent .


###  http://example.org/bloom#Identify
bloom:Identify rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:isActionVerbFor bloom:Remembering ;
               <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
               rdfs:comment "Determining the identity of a subject or object."@en ;
               rdfs:label "identify"@en ;
               skos:definition "Determine or establish the identity of someone or something."@en ;
               skos:example "Identify the main components of a CPU."@en ;
               skos:note "Fundamental in classification and diagnostic tasks."@en ;
               skos:prefLabel "identify"@en ;
               skos:related bloom:Define ,
                            bloom:Recognize .


###  http://example.org/bloom#Illustrate
bloom:Illustrate rdf:type owl:NamedIndividual ,
                          bloom:ActionVerb ;
                 bloom:isActionVerbFor bloom:Applying ;
                 <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                 rdfs:comment "Providing visual or concrete examples."@en ;
                 rdfs:label "illustrate"@en ;
                 skos:definition "Use examples, diagrams, or other visual elements to clarify a concept."@en ;
                 skos:example "Illustrate the flow of control in a for loop with a diagram."@en ;
                 skos:note "Supports visual learning and concept reinforcement."@en ;
                 skos:prefLabel "illustrate"@en ;
                 skos:related bloom:Demonstrate ,
                              bloom:Exemplify .


###  http://example.org/bloom#Implement
bloom:Implement rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Applying ;
                <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                rdfs:comment "Using a procedure in a new situation."@en ;
                rdfs:label "implement"@en ;
                skos:definition "Put a plan, method, or idea into effect in a new context."@en ;
                skos:example "Implement a sorting algorithm in Python."@en ;
                skos:note "Bridges theoretical knowledge with practical application."@en ;
                skos:prefLabel "implement"@en ;
                skos:related bloom:Applying ,
                             bloom:Execute .


###  http://example.org/bloom#Infer
bloom:Infer rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            bloom:isActionVerbFor bloom:Understanding ;
            <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
            rdfs:comment "Drawing conclusions from evidence and reasoning."@en ;
            rdfs:label "infer"@en ;
            skos:definition "Draw conclusions or make assumptions based on available evidence and reasoning."@en ;
            skos:example "Infer the user’s intent based on their search behavior."@en ;
            skos:note "Important for developing reasoning and critical thinking skills."@en ;
            skos:prefLabel "infer"@en ;
            skos:related bloom:Interpret ,
                         bloom:Predict .


###  http://example.org/bloom#Install
bloom:Install rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:isActionVerbFor bloom:Applying ;
              <http://purl.org/dc/terms/references> <https://dl.acm.org/doi/10.1145/3573260> ;
              rdfs:comment "Setting up systems or tools for use."@en ;
              rdfs:label "install"@en ;
              skos:definition "Set up software or hardware so that it is ready for use in a given system or environment."@en ;
              skos:example "Install a Linux distribution on a virtual machine."@en ;
              skos:note "Crucial for configuring environments in computing practice."@en ;
              skos:prefLabel "install"@en .


###  http://example.org/bloom#Interpret
bloom:Interpret rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:isActionVerbFor bloom:Understanding ;
                <http://purl.org/dc/terms/references> <https://doi.org/10.1145/3467967> ;
                rdfs:comment "Explaining the meaning of information."@en ;
                rdfs:label "interpret"@en ;
                skos:definition "Explain or make sense of information, often translating it from one form to another."@en ;
                skos:example "Interpret the meaning of a metaphor in a poem."@en ;
                skos:note "Useful for making content accessible across different media or forms."@en ;
                skos:prefLabel "interpret"@en ;
                skos:related bloom:Paraphrase ,
                             bloom:Translate .


###  http://example.org/bloom#Invent
bloom:Invent rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
