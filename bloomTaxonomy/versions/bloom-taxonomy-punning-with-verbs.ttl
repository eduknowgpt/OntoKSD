@prefix : <http://example.org/bloom#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bloom: <http://example.org/bloom#> .
@base <http://example.org/bloom> .

<http://example.org/bloom> rdf:type owl:Ontology ;
                            rdfs:comment "This ontology uses OWL 2 punning to represent cognitive levels as both classes and individuals."@en ;
                            rdfs:label "Bloom's Revised Taxonomy Ontology (with Punning)"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/references
<http://purl.org/dc/terms/references> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#related
skos:related rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/bloom#follows
bloom:follows rdf:type owl:ObjectProperty ;
              owl:inverseOf bloom:precedes ;
              rdfs:comment "The inverse of precedes."@en ;
              rdfs:label "follows"@en .


###  http://example.org/bloom#hasActionVerb
bloom:hasActionVerb rdf:type owl:ObjectProperty ;
                    owl:inverseOf bloom:isActionVerbFor ;
                    rdfs:domain bloom:CognitiveProcessLevel ;
                    rdfs:range bloom:ActionVerb ;
                    rdfs:comment "Associates a cognitive process level with one or more verbs."@en ;
                    rdfs:label "hasActionVerb"@en .


###  http://example.org/bloom#isActionVerbFor
bloom:isActionVerbFor rdf:type owl:ObjectProperty ;
                      rdfs:domain bloom:ActionVerb ;
                      rdfs:range bloom:CognitiveProcessLevel ;
                      rdfs:comment "isActionVerbFor" .


###  http://example.org/bloom#precedes
bloom:precedes rdf:type owl:ObjectProperty ;
               rdfs:domain bloom:CognitiveProcessLevel ;
               rdfs:range bloom:CognitiveProcessLevel ;
               rdfs:comment "Indicates that one cognitive level precedes another."@en ;
               rdfs:label "precedes"@en .


#################################################################
#    Data properties
#################################################################

###  http://example.org/bloom#hasComplexityLevel
bloom:hasComplexityLevel rdf:type owl:DatatypeProperty ;
                         rdfs:domain bloom:CognitiveProcessLevel ;
                         rdfs:range xsd:int ;
                         rdfs:comment """\"Indicates the ascending cognitive complexity of this level.\"@en .
Numeric indicator of complexity (1 to 6)."""@en ;
                         rdfs:label "hasComplexityLevel"@en .


#################################################################
#    Classes
#################################################################

###  http://example.org/bloom#ActionVerb
bloom:ActionVerb rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty bloom:isActionVerbFor ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass bloom:CognitiveProcessLevel
                                 ] ;
                 rdfs:comment "An action verb commonly used to describe learning objectives."@en ;
                 rdfs:label "ActionVerb"@en .


###  http://example.org/bloom#Analyzing
bloom:Analyzing rdf:type owl:Class ;
                rdfs:subClassOf bloom:CognitiveProcessLevel .


###  http://example.org/bloom#Applying
bloom:Applying rdf:type owl:Class ;
               rdfs:subClassOf bloom:CognitiveProcessLevel .


###  http://example.org/bloom#CognitiveProcessLevel
bloom:CognitiveProcessLevel rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty bloom:hasComplexityLevel ;
                                                  owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                                      owl:oneOf [ rdf:type rdf:List ;
                                                                                  rdf:first 1 ;
                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                             rdf:first 2 ;
                                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                                        rdf:first 3 ;
                                                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                                                   rdf:first 4 ;
                                                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                                                              rdf:first 5 ;
                                                                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                                                                         rdf:first 6 ;
                                                                                                                                         rdf:rest rdf:nil
                                                                                                                                       ]
                                                                                                                            ]
                                                                                                                 ]
                                                                                                      ]
                                                                                           ]
                                                                                ]
                                                                    ]
                                                ] ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty bloom:hasComplexityLevel ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:int
                                            ] ;
                            rdfs:comment "A cognitive level in Bloom's Revised Taxonomy."@en ;
                            rdfs:label "CognitiveProcessLevel"@en .


###  http://example.org/bloom#Creating
bloom:Creating rdf:type owl:Class ;
               rdfs:subClassOf bloom:CognitiveProcessLevel .


###  http://example.org/bloom#Evaluating
bloom:Evaluating rdf:type owl:Class ;
                 rdfs:subClassOf bloom:CognitiveProcessLevel .


###  http://example.org/bloom#Remembering
bloom:Remembering rdf:type owl:Class ;
                  rdfs:subClassOf bloom:CognitiveProcessLevel .


###  http://example.org/bloom#Understanding
bloom:Understanding rdf:type owl:Class ;
                    rdfs:subClassOf bloom:CognitiveProcessLevel .


