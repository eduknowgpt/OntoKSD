@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bloom: <http://example.org/bloom#> .

<http://example.org/bloom>
    a owl:Ontology ;
    rdfs:label "Bloom's Revised Taxonomy Ontology"@en ;
    rdfs:comment "An ontology to represent the cognitive process levels of Bloom's Revised Taxonomy, including associated verbs and hierarchical complexity relations."@en .

# Classes

bloom:CognitiveProcessLevel a owl:Class ;
    rdfs:label "Cognitive Process Level"@en ;
    rdfs:comment "A cognitive level in Bloom's Revised Taxonomy, representing a stage in cognitive complexity from remembering to creating."@en .

bloom:Verb a owl:Class ;
    rdfs:label "Educational Verb"@en ;
    rdfs:comment "An action verb commonly used to describe learning objectives at a specific cognitive process level."@en .

# Object Properties

bloom:hasVerb a owl:ObjectProperty ;
    rdfs:label "has verb"@en ;
    rdfs:domain bloom:CognitiveProcessLevel ;
    rdfs:range bloom:Verb ;
    rdfs:comment "Associates a cognitive process level with one or more representative educational verbs."@en .

bloom:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    rdfs:domain bloom:CognitiveProcessLevel ;
    rdfs:range bloom:CognitiveProcessLevel ;
    rdfs:comment "Indicates that one cognitive process level precedes another in terms of cognitive complexity."@en .

bloom:follows a owl:ObjectProperty ;
    owl:inverseOf bloom:precedes ;
    rdfs:label "follows"@en ;
    rdfs:comment "The inverse of 'precedes'. Indicates that one level follows another in complexity."@en .

# Datatype Property

bloom:hasComplexityLevel a owl:DatatypeProperty ;
    rdfs:label "has complexity level"@en ;
    rdfs:domain bloom:CognitiveProcessLevel ;
    rdfs:range xsd:int ;
    rdfs:comment "Defines the ordinal position of a cognitive level in terms of complexity, where 1 is the simplest and 6 is the most complex."@en .

# Cognitive Levels

bloom:Remember a bloom:CognitiveProcessLevel ;
    rdfs:label "Remember"@en ;
    rdfs:comment "Recall or recognize facts, terms, and basic concepts."@en ;
    bloom:hasVerb bloom:List , bloom:Identify , bloom:Recall ;
    bloom:hasComplexityLevel 1 ;
    bloom:precedes bloom:Understand .

bloom:Understand a bloom:CognitiveProcessLevel ;
    rdfs:label "Understand"@en ;
    rdfs:comment "Comprehend meaning, interpret facts, compare, contrast, order, group, infer causes, predict consequences."@en ;
    bloom:hasVerb bloom:Explain , bloom:Summarize , bloom:Classify ;
    bloom:hasComplexityLevel 2 ;
    bloom:precedes bloom:Apply .

bloom:Apply a bloom:CognitiveProcessLevel ;
    rdfs:label "Apply"@en ;
    rdfs:comment "Use knowledge in new situations or apply what was learned in the classroom to novel situations."@en ;
    bloom:hasVerb bloom:Implement , bloom:Use , bloom:Execute ;
    bloom:hasComplexityLevel 3 ;
    bloom:precedes bloom:Analyze .

bloom:Analyze a bloom:CognitiveProcessLevel ;
    rdfs:label "Analyze"@en ;
    rdfs:comment "Examine and break information into parts by identifying motives or causes; make inferences and find evidence to support generalizations."@en ;
    bloom:hasVerb bloom:Differentiate , bloom:Organize , bloom:Compare ;
    bloom:hasComplexityLevel 4 ;
    bloom:precedes bloom:Evaluate .

bloom:Evaluate a bloom:CognitiveProcessLevel ;
    rdfs:label "Evaluate"@en ;
    rdfs:comment "Present and defend opinions by making judgments about information, validity of ideas, or quality of work based on a set of criteria."@en ;
    bloom:hasVerb bloom:Critique , bloom:Justify , bloom:Argue ;
    bloom:hasComplexityLevel 5 ;
    bloom:precedes bloom:Create .

bloom:Create a bloom:CognitiveProcessLevel ;
    rdfs:label "Create"@en ;
    rdfs:comment "Compile information together in a different way by combining elements in a new pattern or proposing alternative solutions."@en ;
    bloom:hasVerb bloom:Design , bloom:Construct , bloom:Compose ;
    bloom:hasComplexityLevel 6 .

# Verbs

bloom:List a bloom:Verb ; rdfs:label "list"@en ; rdfs:comment "Enumerate items or facts."@en .
bloom:Identify a bloom:Verb ; rdfs:label "identify"@en ; rdfs:comment "Recognize and correctly name or label an object or concept."@en .
bloom:Recall a bloom:Verb ; rdfs:label "recall"@en ; rdfs:comment "Retrieve relevant knowledge from long-term memory."@en .

bloom:Explain a bloom:Verb ; rdfs:label "explain"@en ; rdfs:comment "Make an idea, situation, or problem clear to someone by describing it in more detail."@en .
bloom:Summarize a bloom:Verb ; rdfs:label "summarize"@en ; rdfs:comment "Give a brief statement of the main points."@en .
bloom:Classify a bloom:Verb ; rdfs:label "classify"@en ; rdfs:comment "Arrange or organize by classes or categories."@en .

bloom:Implement a bloom:Verb ; rdfs:label "implement"@en ; rdfs:comment "Put (a decision, plan, agreement, etc.) into effect."@en .
bloom:Use a bloom:Verb ; rdfs:label "use"@en ; rdfs:comment "Employ for a particular purpose."@en .
bloom:Execute a bloom:Verb ; rdfs:label "execute"@en ; rdfs:comment "Carry out or put into effect a plan, order, or course of action."@en .

bloom:Differentiate a bloom:Verb ; rdfs:label "differentiate"@en ; rdfs:comment "Recognize or ascertain what makes something different."@en .
bloom:Organize a bloom:Verb ; rdfs:label "organize"@en ; rdfs:comment "Arrange into a structured whole; order."@en .
bloom:Compare a bloom:Verb ; rdfs:label "compare"@en ; rdfs:comment "Estimate, measure, or note the similarity or dissimilarity between."@en .

bloom:Critique a bloom:Verb ; rdfs:label "critique"@en ; rdfs:comment "Evaluate in a detailed and analytical way."@en .
bloom:Justify a bloom:Verb ; rdfs:label "justify"@en ; rdfs:comment "Show or prove to be right or reasonable."@en .
bloom:Argue a bloom:Verb ; rdfs:label "argue"@en ; rdfs:comment "Give reasons or cite evidence in support of an idea, action, or theory."@en .

bloom:Design a bloom:Verb ; rdfs:label "design"@en ; rdfs:comment "Plan and make decisions about something that is being built or created."@en .
bloom:Construct a bloom:Verb ; rdfs:label "construct"@en ; rdfs:comment "Build or form by putting together parts."@en .
bloom:Compose a bloom:Verb ; rdfs:label "compose"@en ; rdfs:comment "Write or create a work of art, especially music or poetry."@en .
