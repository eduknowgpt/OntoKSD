Id: custom_property_chain
  a x:CustomRule ;
  x:description "Handle property chain axioms" ;
  x:pattern """
    PREFIX bloom: <http://purl.org/edu/bloom#>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    INSERT {
      ?x bloom:precedes ?z .
    }
    WHERE {
      ?x bloom:directPrecedes ?y .
      ?y bloom:precedes ?z .
    }
  """ .