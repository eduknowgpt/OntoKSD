@prefix : <http://purl.org/edu/bloom#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bloom: <http://purl.org/edu/bloom#> .
@prefix cs2023: <http://purl.org/edu/cs2023#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://purl.org/edu/bloom#> .

<http://purl.org/edu/bloom> rdf:type owl:Ontology ;
                             rdfs:comment "This ontology uses OWL 2 punning to represent cognitive levels as both classes and individuals."@en ;
                             rdfs:label "Bloom's Revised Taxonomy Ontology (with Punning)"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/references
dcterms:references rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/edu/bloom#directFollows
bloom:directFollows rdf:type owl:ObjectProperty ;
                    owl:inverseOf bloom:directPrecedes ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:domain bloom:SkillLevel ;
                    rdfs:range bloom:SkillLevel ;
                    rdfs:comment "Inverse of directPrecedes; captures explicit local predecessor relations among skill levels." ;
                    rdfs:label "directly follows" .


###  http://purl.org/edu/bloom#directPrecedes
bloom:directPrecedes rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain bloom:SkillLevel ;
                     rdfs:range bloom:SkillLevel ;
                     rdfs:comment "Relates a skill level to its immediate successor in the pedagogical sequence." ;
                     rdfs:label "directly precedes" ;
                     skos:definition "directPrecedes captures local adjacency among levels and is used in OntoKSD to represent immediate pedagogical progression without relying on transitive closure axioms." .


###  http://purl.org/edu/bloom#hasActionVerb
bloom:hasActionVerb rdf:type owl:ObjectProperty ;
                    owl:inverseOf bloom:isActionVerbFor ;
                    rdfs:domain bloom:SkillLevel ;
                    rdfs:range bloom:ActionVerb ;
                    rdfs:comment "Associates a skill level with one or more action verbs that operationalize its expected performance." ;
                    rdfs:label "hasActionVerb"@en .


###  http://purl.org/edu/bloom#hasActionVerbType
bloom:hasActionVerbType rdf:type owl:ObjectProperty ;
                        owl:inverseOf bloom:isActionVerbTypeFor ;
                        rdfs:domain bloom:ActionVerb ;
                        rdfs:range bloom:ActionVerbType .


###  http://purl.org/edu/bloom#isActionVerbFor
bloom:isActionVerbFor rdf:type owl:ObjectProperty ;
                      rdfs:domain bloom:ActionVerb ;
                      rdfs:range bloom:SkillLevel ;
                      rdfs:comment "isActionVerbFor" .


###  http://purl.org/edu/bloom#isActionVerbTypeFor
bloom:isActionVerbTypeFor rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain bloom:ActionVerbType ;
                          rdfs:range bloom:ActionVerb .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/edu/bloom#hasComplexityLevel
bloom:hasComplexityLevel rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain bloom:SkillLevel ;
                         rdfs:range xsd:int ;
                         rdfs:comment "Associates a skill level with a numeric indicator of relative cognitive complexity"@en ,
                                      "hasComplexityLevel provides a lightweight quantitative representation of progression among skill levels. It is intended to support sorting, filtering, and computational analysis, without replacing the richer qualitative semantics captured by the taxonomy itself." .


#################################################################
#    Classes
#################################################################

###  http://purl.org/edu/bloom#ActionVerb
bloom:ActionVerb rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty bloom:hasActionVerbType ;
                                   owl:someValuesFrom bloom:ActionVerbType
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty bloom:isActionVerbFor ;
                                   owl:someValuesFrom bloom:SkillLevel
                                 ] ;
                 owl:disjointWith bloom:ActionVerbType ,
                                  bloom:SkillLevel ;
                 rdfs:comment "ActionVerb represents verbs such as analyze, design, explain, debug, or compare that make the expected performance associated with a skill level more explicit. In OntoKSD, verbs are modeled as semantic entities rather than as mere labels, so that they can be typed, documented, queried, and linked to curricular or pedagogical frameworks." ;
                 rdfs:label "ActionVerb"@en ;
                 skos:definition "A lexicalized action expression used to operationalize a skill level in competence specification." .


###  http://purl.org/edu/bloom#ActionVerbType
bloom:ActionVerbType rdf:type owl:Class ;
                     owl:disjointWith bloom:SkillLevel ;
                     rdfs:comment "ActionVerbType enables action verbs to be differentiated according to their pedagogical or disciplinary status, such as standard Bloom verbs, computing-enhanced verbs, or framework-specific verbs. This supports reuse, filtering, and contextualized competence specification." ;
                     rdfs:label "ActionVerbType" ;
                     skos:definition "A classificatory category used to distinguish different kinds of action verbs." .


###  http://purl.org/edu/bloom#Analyzing
bloom:Analyzing rdf:type owl:Class ;
                rdfs:subClassOf bloom:CC2020SkillLevel .


###  http://purl.org/edu/bloom#Applying
bloom:Applying rdf:type owl:Class ;
               rdfs:subClassOf bloom:CC2020SkillLevel .


###  http://purl.org/edu/bloom#CC2020SkillLevel
bloom:CC2020SkillLevel rdf:type owl:Class ;
                       rdfs:subClassOf bloom:SkillLevel ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty bloom:hasComplexityLevel ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:int
                                       ] ;
                       owl:disjointWith cs2023:CS2023SkillLevel ;
                       rdfs:comment "CognitiveProcessLevel represents the six levels of the revised Bloom taxonomy—Remembering, Understanding, Applying, Analyzing, Evaluating, and Creating. These levels are modeled as distinct pedagogical categories that express increasing cognitive demand. They are not intended to form a subclass hierarchy of conceptual containment, but rather an ordered set of alternative levels within the same classificatory scheme." ;
                       skos:definition "A skill level defined according to Bloom’s Revised Taxonomy." .


###  http://purl.org/edu/bloom#Creating
bloom:Creating rdf:type owl:Class ;
               rdfs:subClassOf bloom:CC2020SkillLevel .


###  http://purl.org/edu/bloom#Evaluating
bloom:Evaluating rdf:type owl:Class ;
                 rdfs:subClassOf bloom:CC2020SkillLevel .


###  http://purl.org/edu/bloom#Remembering
bloom:Remembering rdf:type owl:Class ;
                  rdfs:subClassOf bloom:CC2020SkillLevel .


###  http://purl.org/edu/bloom#SkillLevel
bloom:SkillLevel rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty bloom:directFollows ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass bloom:SkillLevel
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty bloom:directPrecedes ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass bloom:SkillLevel
                                 ] ;
                 rdfs:comment """SkillLevel

A classificatory abstraction that represents a level, type, or degree of expected performance associated with the skill dimension of a competency specification.

In the integrated use of OntoKSD with external educational taxonomies, SkillLevel functions as a common semantic superclass for alternative level schemes used to qualify expected performance, such as Bloom cognitive process levels and CS2023 skill levels.

SkillLevel does not denote a skill constituent in itself. Rather, it denotes a classificatory category used to specify the required level or mode of performance associated with a knowledge component, a skill constituent, or another competence-related element, depending on the modeling context.

This distinction allows OntoKSD to separate:

Skill, understood as a capability or know-how constituent of competence; and

SkillLevel, understood as a taxonomic or classificatory qualification of expected performance.

Accordingly, Bloom levels and CS2023 skill levels are modeled as subclasses of SkillLevel rather than as subclasses of Skill. This enables interoperability across curricular frameworks while preserving ontological clarity between performative capability and classificatory level.

Typical specializations include:

Bloom CognitiveProcessLevel

CS2023SkillLevel

Ontological rationale:
SkillLevel is modeled as a classificatory abstraction because curricular and pedagogical frameworks frequently express the skill dimension through ordered taxonomic levels. Representing such levels under a common superclass supports reuse, interoperability, and unified querying without conflating levels with skills themselves.""" ;
                 rdfs:label "SkillLevel" ;
                 skos:definition "An abstract class that generalizes taxonomic levels used to qualify the expected degree of skillfulness in competence specification." .


###  http://purl.org/edu/bloom#Understanding
bloom:Understanding rdf:type owl:Class ;
                    rdfs:subClassOf bloom:CC2020SkillLevel .


###  http://purl.org/edu/cs2023#Apply
cs2023:Apply rdf:type owl:Class ;
             rdfs:subClassOf cs2023:CS2023SkillLevel .


###  http://purl.org/edu/cs2023#CS2023SkillLevel
cs2023:CS2023SkillLevel rdf:type owl:Class ;
                        rdfs:subClassOf bloom:SkillLevel ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty bloom:hasComplexityLevel ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:int
                                        ] ;
                        rdfs:comment "CS2023SkillLevel" ,
                                     "CS2023SkillLevel represents the four levels Explain, Apply, Evaluate, and Develop, as adopted in CS2023. These levels provide a curricular reinterpretation of graded skillfulness using action-oriented descriptors. In OntoKSD, they are modeled under the common abstraction SkillLevel so that Bloom-based and CS2023-based formulations can coexist and be comparatively represented." ;
                        skos:definition "A skill level defined according to the action-oriented taxonomy adopted in CS2023." .


###  http://purl.org/edu/cs2023#Develop
cs2023:Develop rdf:type owl:Class ;
               rdfs:subClassOf cs2023:CS2023SkillLevel .


###  http://purl.org/edu/cs2023#Evaluate
cs2023:Evaluate rdf:type owl:Class ;
                rdfs:subClassOf cs2023:CS2023SkillLevel .


###  http://purl.org/edu/cs2023#Explain
cs2023:Explain rdf:type owl:Class ;
               rdfs:subClassOf cs2023:CS2023SkillLevel .


#################################################################
#    Individuals
#################################################################

###  http://purl.org/edu/bloom#Analyzing
bloom:Analyzing rdf:type owl:NamedIndividual ,
                         bloom:CC2020SkillLevel ;
                bloom:directPrecedes bloom:Evaluating ;
                bloom:hasComplexityLevel 4 .


###  http://purl.org/edu/bloom#Applying
bloom:Applying rdf:type owl:NamedIndividual ,
                        bloom:CC2020SkillLevel ;
               bloom:directPrecedes bloom:Analyzing ;
               bloom:hasComplexityLevel 3 .


###  http://purl.org/edu/bloom#Creating
bloom:Creating rdf:type owl:NamedIndividual ,
                        bloom:CC2020SkillLevel ;
               bloom:hasComplexityLevel 6 .


###  http://purl.org/edu/bloom#Evaluating
bloom:Evaluating rdf:type owl:NamedIndividual ,
                          bloom:CC2020SkillLevel ;
                 bloom:directPrecedes bloom:Creating ;
                 bloom:hasComplexityLevel 5 .


###  http://purl.org/edu/bloom#Remembering
bloom:Remembering rdf:type owl:NamedIndividual ,
                           bloom:CC2020SkillLevel ;
                  bloom:directPrecedes bloom:Understanding ;
                  bloom:hasComplexityLevel 1 .


###  http://purl.org/edu/bloom#Understanding
bloom:Understanding rdf:type owl:NamedIndividual ,
                             bloom:CC2020SkillLevel ;
                    bloom:directPrecedes bloom:Applying ;
                    bloom:hasComplexityLevel 2 .


###  http://purl.org/edu/cs2023#Apply
cs2023:Apply rdf:type owl:NamedIndividual ,
                      cs2023:CS2023SkillLevel ;
             bloom:directPrecedes cs2023:Evaluate ;
             bloom:hasComplexityLevel 2 .


###  http://purl.org/edu/cs2023#Develop
cs2023:Develop rdf:type owl:NamedIndividual ,
                        cs2023:CS2023SkillLevel ;
               bloom:hasComplexityLevel 4 .


###  http://purl.org/edu/cs2023#Evaluate
cs2023:Evaluate rdf:type owl:NamedIndividual ,
                         cs2023:CS2023SkillLevel ;
                bloom:directPrecedes cs2023:Develop ;
                bloom:hasComplexityLevel 3 .


###  http://purl.org/edu/cs2023#Explain
cs2023:Explain rdf:type owl:NamedIndividual ,
                        cs2023:CS2023SkillLevel ;
               bloom:directPrecedes cs2023:Apply ;
               bloom:hasComplexityLevel 1 .


#################################################################
#    Annotations
#################################################################

bloom:Analyzing rdfs:comment """Analyze: the ability to break material into its constituent parts and determine how those parts relate to one another and to the overall structure or purpose. This level involves critical examination and understanding of organizational principles.


Subskills include:
- Differentiating, discriminating, distinguishing, focusing, selecting: Discriminating or selecting relevant from irrelevant information, or important from less important elements in the material presented. 

- Organizing, finding coherence, integrating, outlining, parsing, structuring: Identifying how elements fit within a structure by finding coherence, outlining, parsing, or integrating parts into a logical arrangement. 

- Attributing, deconstructing: Deconstructing material to identify underlying assumptions, motives, perspectives, or bias; recognizing the values and intentions embedded in the content. 

Typical activities: outlining the argument of a text, comparing different points of view, dissecting logical structures, identifying fallacies, or analyzing the role of each component in a system or model."""@en .


bloom:Applying rdfs:comment """Apply: the ability to use learned knowledge and procedures in concrete situations. This level involves carrying out or adapting a known method to solve problems, complete tasks, or respond to situations that may be familiar or slightly new.

Subskills include:

- Executing: Carrying out a procedure in a familiar context. Often associated with using known algorithms, techniques, or routines that have been practiced.

- Implementing, using: Applying procedures in slightly unfamiliar or new situations, which may require adaptation or interpretation of the method. Understanding the underlying concepts is essential for successful implementation.

Typical activities: solving textbook problems using a known formula, using a software tool to perform a task, following a lab procedure, applying learned techniques to a real-world scenario."""@en .


bloom:Creating rdfs:comment """Create: the ability to put elements together to form a coherent, functional whole or to produce something original. This level involves synthesizing information, designing solutions, and generating new ideas or products.

Subskills include:

- Generating: Proposing new ideas, perspectives, or hypotheses based on criteria. This may involve divergent thinking or imagining multiple solutions to a problem.

- Planning: Developing a structured plan or approach to solve a problem or accomplish a goal, integrating different components purposefully.

- Producing: Constructing a new product, idea, or performance that demonstrates originality and coherence.

Typical activities: writing an essay or story, designing an experiment, creating a prototype, composing music, developing a new process or model."""@en .


bloom:Evaluating rdfs:comment """
Evaluate: the ability to make judgments based on criteria and standards. This level involves assessing the quality, credibility, or effectiveness of materials, processes, or solutions.

Subskills include:

- Checking: Testing for internal consistency or identifying fallacies and logic flaws within a procedure, method, or argument.

- Critiquing: Judging materials or actions based on external standards, such as quality benchmarks, ethical principles, or disciplinary norms. This includes evaluating the appropriateness or effectiveness of a method for a specific context.

Typical activities: reviewing a peer’s essay using a rubric, evaluating the reliability of a source, comparing solutions to a problem, critiquing artistic or scientific work based on established criteria."""@en .


bloom:Remembering rdfs:comment """
Remember: the ability to recognize or recall relevant knowledge from long-term memory. This is the most fundamental level of cognition and serves as the basis for all higher-order thinking.

Subskills include:

- Recognizing: Identifying previously learned information when it is presented, such as matching terms to definitions or recognizing correct answers in a multiple-choice question.

- Recalling: Retrieving knowledge from memory without cues, such as remembering key dates, formulas, or facts.

Typical activities: listing components, recalling historical events, identifying vocabulary terms, recognizing key definitions or concepts."""@en .


bloom:Understanding rdfs:comment """
Understand: the ability to construct meaning from instructional messages, including spoken, written, and visual communication. At this level, learners make sense of material by organizing, interpreting, or comparing it to their existing knowledge.

Subskills include:

- Interpreting: Translating information from one form to another, such as turning a graph into a verbal explanation or paraphrasing a text.

- Exemplifying: Giving specific examples that illustrate a concept or principle.

- Classifying: Identifying that something belongs to a particular category based on its characteristics.

- Summarizing: Distilling key points from information; creating concise restatements of content.

- Inferring: Drawing logical conclusions or predictions from data or observations.

- Comparing: Identifying similarities and differences between concepts, situations, or items.

- Explaining: Building and applying models of cause-and-effect relationships, such as reasoning through problems, troubleshooting, or hypothesizing mechanisms.

Typical activities: paraphrasing a paragraph, summarizing a lesson, identifying types of ecosystems, comparing theories, interpreting diagrams, explaining a process in one's own words."""@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( bloom:Analyzing
                bloom:Applying
                bloom:Creating
                bloom:Evaluating
                bloom:Remembering
                bloom:Understanding
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( cs2023:Apply
                cs2023:Develop
                cs2023:Evaluate
                cs2023:Explain
              )
] .


