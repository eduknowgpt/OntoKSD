
###  http://purl.org/edu/bloom#StandardVerb
bloom:StandardVerb rdf:type owl:NamedIndividual ,
                           bloom:ActionVerbType ;
    rdfs:label "Standard Bloom Verb"@en ;
    skos:definition "An action verb traditionally associated with Bloom’s Revised Taxonomy and used in general educational objective specification."@en .

###  http://purl.org/edu/bloom#ComputingVerb
bloom:ComputingVerb rdf:type owl:NamedIndividual ,
                            bloom:ActionVerbType ;
    rdfs:label "Computing-Enhanced Verb"@en ;
    skos:definition "An action verb adapted or emphasized for competence specification in computing education contexts."@en .

###  http://purl.org/edu/bloom#CS2023Verb
bloom:CS2023Verb rdf:type owl:NamedIndividual ,
                         bloom:ActionVerbType ;
    rdfs:label "CS2023 Verb"@en ;
    skos:definition "An action verb explicitly associated with the skill-level formulation adopted in CS2023."@en .