# Optional DBpedia informational links for the reviewed OntoKSD verb vocabulary.
# Reviewed using DBpedia RDF descriptions, redirects, and disambiguation flags.
# Links provide additional information about a relevant sense, process, tool, or product.
# They do not express identity, exact lexical equivalence, or evidence for a SkillLevel.
# No link is required for every verb. No owl:Axiom blocks or additional entities are inserted.
# Existing links are not removed by INSERT DATA; replace the old link graph if appropriate.

PREFIX bloom: <http://purl.org/edu/bloom#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT DATA {
  bloom:analyze rdfs:seeAlso <http://dbpedia.org/resource/Analysis> .
  bloom:appraise rdfs:seeAlso <http://dbpedia.org/resource/Evaluation> .
  bloom:argue rdfs:seeAlso <http://dbpedia.org/resource/Argument> .
  bloom:assess rdfs:seeAlso <http://dbpedia.org/resource/Evaluation> .
  bloom:backup rdfs:seeAlso <http://dbpedia.org/resource/Backup> .
  bloom:calculate rdfs:seeAlso <http://dbpedia.org/resource/Calculation> .
  bloom:classify rdfs:seeAlso <http://dbpedia.org/resource/Classification> .
  bloom:code rdfs:seeAlso <http://dbpedia.org/resource/Computer_programming> .
  bloom:compare rdfs:seeAlso <http://dbpedia.org/resource/Comparison> .
  # Compiler is the tool associated with the compilation sense, not the verb itself.
  bloom:compile rdfs:seeAlso <http://dbpedia.org/resource/Compiler> .
  bloom:contrast rdfs:seeAlso <http://dbpedia.org/resource/Comparison> .
  bloom:critique rdfs:seeAlso <http://dbpedia.org/resource/Critique> .
  # The Encryption article also covers decryption; this is an informational link.
  bloom:decrypt rdfs:seeAlso <http://dbpedia.org/resource/Encryption> .
  bloom:define rdfs:seeAlso <http://dbpedia.org/resource/Definition> .
  bloom:deploy rdfs:seeAlso <http://dbpedia.org/resource/Software_deployment> .
  bloom:design rdfs:seeAlso <http://dbpedia.org/resource/Design> .
  bloom:discuss rdfs:seeAlso <http://dbpedia.org/resource/Conversation> .
  bloom:encrypt rdfs:seeAlso <http://dbpedia.org/resource/Encryption> .
  bloom:enumerate rdfs:seeAlso <http://dbpedia.org/resource/Enumeration> .
  bloom:execute rdfs:seeAlso <http://dbpedia.org/resource/Execution_(computing)> .
  bloom:explain rdfs:seeAlso <http://dbpedia.org/resource/Explanation> .
  bloom:illustrate rdfs:seeAlso <http://dbpedia.org/resource/Illustration> .
  bloom:implement rdfs:seeAlso <http://dbpedia.org/resource/Implementation> .
  bloom:infer rdfs:seeAlso <http://dbpedia.org/resource/Inference> .
  bloom:install rdfs:seeAlso <http://dbpedia.org/resource/Installation_(computer_programs)> .
  bloom:invent rdfs:seeAlso <http://dbpedia.org/resource/Invention> .
  bloom:judge rdfs:seeAlso <http://dbpedia.org/resource/Judgement> .
  bloom:model rdfs:seeAlso <http://dbpedia.org/resource/Model> .
  bloom:name rdfs:seeAlso <http://dbpedia.org/resource/Name> .
  bloom:paraphrase rdfs:seeAlso <http://dbpedia.org/resource/Paraphrase> .
  bloom:plan rdfs:seeAlso <http://dbpedia.org/resource/Planning> .
  bloom:predict rdfs:seeAlso <http://dbpedia.org/resource/Prediction> .
  bloom:recall rdfs:seeAlso <http://dbpedia.org/resource/Recall_(memory)> .
  bloom:recognize rdfs:seeAlso <http://dbpedia.org/resource/Recognition_memory> .
  bloom:reference rdfs:seeAlso <http://dbpedia.org/resource/Citation> .
  bloom:retrieve rdfs:seeAlso <http://dbpedia.org/resource/Information_retrieval> .
  bloom:simulate rdfs:seeAlso <http://dbpedia.org/resource/Simulation> .
  bloom:solve rdfs:seeAlso <http://dbpedia.org/resource/Problem_solving> .
  bloom:trace rdfs:seeAlso <http://dbpedia.org/resource/Tracing_(software)> .
  # Relevant to the natural-language translation sense only.
  bloom:translate rdfs:seeAlso <http://dbpedia.org/resource/Translation> .
  bloom:validate rdfs:seeAlso <http://dbpedia.org/resource/Verification_and_validation> .
  bloom:virtualize rdfs:seeAlso <http://dbpedia.org/resource/Virtualization> .
}
