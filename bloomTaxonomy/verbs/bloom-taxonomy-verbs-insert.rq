               skos:example "Critique a peer’s design proposal using explicit evaluation criteria."@en ;
               skos:note "A prototypical evaluative verb involving criteria-based judgment."@en ;
               skos:prefLabel "critique"@en ;
               skos:related bloom:review .


###  http://purl.org/edu/bloom#debate
bloom:debate rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:hasActionVerbType bloom:StandardVerb ;
