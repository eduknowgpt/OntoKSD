              bloom:isActionVerbFor bloom:Understanding ,
                                    bloom:Analyzing ,
                                    cs2023:Evaluate ;
              rdfs:comment "Examine two or more elements to identify similarities, differences, and relevant implications."@en ;
              rdfs:label "compare"@en ;
              skos:definition "Examine two or more elements to identify similarities, differences, and relevant implications."@en ;
              skos:example "Compare two sorting algorithms in terms of time complexity and practical trade-offs."@en ;
              skos:note "A context-sensitive verb that may support understanding, analysis, or evaluative comparison."@en ;
              skos:prefLabel "compare"@en ;
              skos:related bloom:contrast ,
                           bloom:differentiate .


