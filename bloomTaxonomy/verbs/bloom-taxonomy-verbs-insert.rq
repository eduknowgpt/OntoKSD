PREFIX bloom:   <http://purl.org/edu/bloom#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2023:  <http://purl.org/edu/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>

INSERT DATA {

#################################################################
#    Individuals
#################################################################

###  http://purl.org/edu/bloom#apply
bloom:apply rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            dcterms:references <https://doi.org/10.1145/3467967> ;
            bloom:hasActionVerbType bloom:StandardVerb ;
            bloom:isActionVerbFor bloom:Applying ;
            rdfs:comment "Use learned knowledge, methods, or procedures in a concrete situation."@en ;
            rdfs:label "apply"@en ;
            skos:definition "Use learned knowledge, methods, or procedures in a concrete situation or task."@en ;
            skos:example "Apply a sorting algorithm to organize a dataset."@en ;
            skos:note "Typically associated with carrying out a known procedure in a practical context."@en ;
            skos:prefLabel "apply"@en .


###  http://purl.org/edu/bloom#carryout
bloom:carryout rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               dcterms:references <https://doi.org/10.1145/3467967> ;
               bloom:hasActionVerbType bloom:StandardVerb ;
               bloom:isActionVerbFor bloom:Applying ;
               rdfs:comment "Execute a procedure, instruction, or plan in order to complete a task."@en ;
               rdfs:label "carry out"@en ;
               skos:definition "Execute a procedure, instruction, or plan in order to complete a task or solve a problem."@en ;
               skos:example "Carry out the steps of a testing procedure for a software module."@en ;
               skos:note "Emphasizes procedural execution in a defined context."@en ;
               skos:prefLabel "carry out"@en .


###  http://purl.org/edu/bloom#categorize
bloom:categorize rdf:type owl:NamedIndividual ,
                          bloom:ActionVerb ;
                 dcterms:references <https://doi.org/10.1145/3467967> ;
                 bloom:hasActionVerbType bloom:StandardVerb ;
                 bloom:isActionVerbFor bloom:Analyzing ;
                 rdfs:comment "Classify concepts, elements, or cases into meaningful groups based on relevant criteria."@en ;
                 rdfs:label "categorize"@en ;
                 skos:definition "Classify concepts, elements, or cases into meaningful groups based on shared characteristics or criteria."@en ;
                 skos:example "Categorize software requirements into functional and non-functional groups."@en ;
                 skos:note "Supports analytical differentiation and structural interpretation."@en ;
                 skos:prefLabel "categorize"@en .


###  http://purl.org/edu/bloom#convert
bloom:convert rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              bloom:hasActionVerbType bloom:StandardVerb ;
              bloom:isActionVerbFor bloom:Understanding ;
              rdfs:comment "Transform information, representations, or expressions from one form into another."@en ;
              rdfs:label "convert"@en ;
              skos:definition "Transform information, representations, or expressions from one form into another while preserving meaning."@en ;
              skos:example "Convert pseudocode into a flowchart representation."@en ;
              skos:note "Often indicates interpretive understanding across representational formats."@en ;
              skos:prefLabel "convert"@en .


###  http://purl.org/edu/bloom#create
bloom:create rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             dcterms:references <https://doi.org/10.1145/3467967> ;
             bloom:hasActionVerbType bloom:CS2023Verb ,
                                     bloom:StandardVerb ;
             bloom:isActionVerbFor bloom:Creating ,
                                   cs2023:Develop ;
             rdfs:comment "Produce something new by synthesizing knowledge, techniques, or ideas into an original whole."@en ;
             rdfs:label "create"@en ;
             skos:definition "Produce something new by synthesizing knowledge, techniques, or ideas into an original artifact, solution, or expression."@en ;
             skos:example "Create a prototype application to address a specific user need."@en ;
             skos:note "Bridges Bloom’s Creating level and the CS2023 Develop formulation."@en ;
             skos:prefLabel "create"@en .


###  http://purl.org/edu/bloom#decompose
bloom:decompose rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                dcterms:references <https://doi.org/10.1145/3467967> ;
                bloom:hasActionVerbType bloom:StandardVerb ;
                bloom:isActionVerbFor bloom:Analyzing ;
                rdfs:comment "Break down a complex structure, system, or problem into constituent parts for examination."@en ;
                rdfs:label "decompose"@en ;
                skos:definition "Break down a complex structure, system, or problem into constituent parts in order to examine its organization or behavior."@en ;
                skos:example "Decompose a software system into modules and interfaces."@en ;
                skos:note "A core analytical action in computing, especially in systems, algorithms, and architecture."@en ;
                skos:prefLabel "decompose"@en .


###  http://purl.org/edu/bloom#deconstruct
bloom:deconstruct rdf:type owl:NamedIndividual ,
                           bloom:ActionVerb ;
                  dcterms:references <https://doi.org/10.1145/3467967> ;
                  bloom:hasActionVerbType bloom:StandardVerb ;
                  bloom:isActionVerbFor bloom:Analyzing ;
                  rdfs:comment "Break down the internal structure of a concept, argument, or system for critical examination."@en ;
                  rdfs:label "deconstruct"@en ;
                  skos:definition "Break down the internal structure of a concept, argument, or system in order to examine how its parts relate and function."@en ;
                  skos:example "Deconstruct a software architecture into components, dependencies, and interaction flows."@en ;
                  skos:note "Strongly associated with analytical examination of structure and organization."@en ;
                  skos:prefLabel "deconstruct"@en .


###  http://purl.org/edu/bloom#deduce
bloom:deduce rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             dcterms:references <https://doi.org/10.1145/3467967> ;
             bloom:hasActionVerbType bloom:StandardVerb ;
             bloom:isActionVerbFor bloom:Analyzing ;
             rdfs:comment "Infer a conclusion from evidence, patterns, or previously established premises."@en ;
             rdfs:label "deduce"@en ;
             skos:definition "Infer a conclusion from evidence, patterns, or previously established premises."@en ;
             skos:example "Deduce the cause of a bug from execution traces and error logs."@en ;
             skos:note "Useful in analytical reasoning, debugging, and evidence-based interpretation."@en ;
             skos:prefLabel "deduce"@en .


###  http://purl.org/edu/bloom#demonstrate
bloom:demonstrate rdf:type owl:NamedIndividual ,
                           bloom:ActionVerb ;
                  bloom:hasActionVerbType bloom:StandardVerb ;
                  bloom:isActionVerbFor bloom:Understanding ;
                  rdfs:comment "Show understanding through explanation, illustration, or guided performance."@en ;
                  rdfs:label "demonstrate"@en ;
                  skos:definition "Show understanding through explanation, illustration, or guided performance."@en ;
                  skos:example "Demonstrate how a sorting algorithm processes an input list step by step."@en ;
                  skos:note "Often used when conceptual understanding is made visible through action or explanation."@en ;
                  skos:prefLabel "demonstrate"@en .


###  http://purl.org/edu/bloom#describe
bloom:describe rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:hasActionVerbType bloom:StandardVerb ;
               bloom:isActionVerbFor bloom:Understanding ;
               rdfs:comment "Provide a clear account of a concept, process, or structure."@en ;
               rdfs:label "describe"@en ;
               skos:definition "Provide a clear and organized account of a concept, process, or structure."@en ;
               skos:example "Describe the stages involved in compiling source code."@en ;
               skos:note "Commonly used to assess conceptual understanding and explanatory clarity."@en ;
               skos:prefLabel "describe"@en .


###  http://purl.org/edu/bloom#devise
bloom:devise rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:hasActionVerbType bloom:StandardVerb ;
             bloom:isActionVerbFor bloom:Creating ;
             rdfs:comment "Formulate an original plan, strategy, or solution through creative thinking."@en ;
             rdfs:label "devise"@en ;
             skos:definition "Formulate an original plan, strategy, or solution through creative thinking."@en ;
             skos:example "Devise a plan to strengthen the security of an institutional network."@en ;
             skos:note "Strongly associated with creative planning and solution design."@en ;
             skos:prefLabel "devise"@en .


###  http://purl.org/edu/bloom#diagram
bloom:diagram rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              dcterms:references <https://doi.org/10.1145/3467967> ;
              bloom:hasActionVerbType bloom:StandardVerb ;
              bloom:isActionVerbFor bloom:Applying ;
              rdfs:comment "Represent a process, structure, or solution visually."@en ;
              rdfs:label "diagram"@en ;
              skos:definition "Represent a process, structure, or solution visually using a diagrammatic form."@en ;
              skos:example "Diagram the control flow of an authentication routine."@en ;
              skos:note "Useful when applying known concepts through visual procedural representation."@en ;
              skos:prefLabel "diagram"@en .


###  http://purl.org/edu/bloom#differentiate
bloom:differentiate rdf:type owl:NamedIndividual ,
                             bloom:ActionVerb ;
                    bloom:hasActionVerbType bloom:StandardVerb ;
                    bloom:isActionVerbFor bloom:Understanding ;
                    rdfs:comment "Identify differences between similar concepts, structures, or cases."@en ;
                    rdfs:label "differentiate"@en ;
                    skos:definition "Identify differences between similar concepts, structures, or cases."@en ;
                    skos:example "Differentiate between stack and queue data structures."@en ;
                    skos:note "Supports conceptual discrimination and comparative understanding."@en ;
                    skos:prefLabel "differentiate"@en .


###  http://purl.org/edu/bloom#discriminate
bloom:discriminate rdf:type owl:NamedIndividual ,
                            bloom:ActionVerb ;
                   dcterms:references <https://doi.org/10.1145/3467967> ;
                   bloom:hasActionVerbType bloom:StandardVerb ;
                   bloom:isActionVerbFor bloom:Analyzing ;
                   rdfs:comment "Identify relevant differences, distinctions, or boundaries among elements."@en ;
                   rdfs:label "discriminate"@en ;
                   skos:definition "Identify relevant differences, distinctions, or boundaries among elements, cases, or categories."@en ;
                   skos:example "Discriminate between functional and non-functional defects in a software review."@en ;
                   skos:note "Supports analytical distinction based on criteria or structural relevance."@en ;
                   skos:prefLabel "discriminate"@en .


###  http://purl.org/edu/bloom#distinguish
bloom:distinguish rdf:type owl:NamedIndividual ,
                           bloom:ActionVerb ;
                  dcterms:references <https://doi.org/10.1145/3467967> ;
                  bloom:hasActionVerbType bloom:StandardVerb ;
                  bloom:isActionVerbFor bloom:Analyzing ,
                                        cs2023:Evaluate ;
                  rdfs:comment "Identify and articulate relevant differences between similar items, alternatives, or situations."@en ;
                  rdfs:label "distinguish"@en ;
                  skos:definition "Identify and articulate relevant differences between similar items, alternatives, or situations."@en ;
                  skos:example "Distinguish efficient from inefficient algorithmic solutions for the same problem."@en ;
                  skos:note "Can support both analytical differentiation and evaluative comparison, depending on context."@en ;
                  skos:prefLabel "distinguish"@en .


###  http://purl.org/edu/bloom#duplicate
bloom:duplicate rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:hasActionVerbType bloom:StandardVerb ;
                bloom:isActionVerbFor bloom:Remembering ;
                rdfs:comment "Reproduce information exactly as it was originally presented."@en ;
                rdfs:label "duplicate"@en ;
                skos:definition "Reproduce information exactly as it was originally presented or learned."@en ;
                skos:example "Duplicate a formal definition exactly as given in lecture notes."@en ;
                skos:note "Typical of recall-oriented activities with minimal transformation."@en ;
                skos:prefLabel "duplicate"@en ;
                skos:related bloom:Remembering .


###  http://purl.org/edu/bloom#edit
bloom:edit rdf:type owl:NamedIndividual ,
                    bloom:ActionVerb ;
           dcterms:references <https://doi.org/10.1145/3467967> ;
           bloom:hasActionVerbType bloom:StandardVerb ;
           bloom:isActionVerbFor bloom:Applying ;
           rdfs:comment "Revise existing content, code, or artifacts for improvement or correction."@en ;
           rdfs:label "edit"@en ;
           skos:definition "Revise existing content, code, or artifacts for improvement, correction, or adaptation."@en ;
           skos:example "Edit a source-code file to correct syntax and formatting issues."@en ;
           skos:note "Usually involves applying known conventions or procedures to improve an existing artifact."@en ;
           skos:prefLabel "edit"@en .


###  http://purl.org/edu/bloom#execute
bloom:execute rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              dcterms:references <https://doi.org/10.1145/3467967> ;
              bloom:hasActionVerbType bloom:StandardVerb ;
              bloom:isActionVerbFor bloom:Applying ;
              rdfs:comment "Run a plan, algorithm, or process in order to accomplish a task."@en ;
              rdfs:label "execute"@en ;
              skos:definition "Run a plan, algorithm, or process in order to accomplish a task or obtain a result."@en ;
              skos:example "Execute a search algorithm on a given input instance."@en ;
              skos:note "Strongly associated with procedural application in computing and technical contexts."@en ;
              skos:prefLabel "execute"@en .


###  http://purl.org/edu/bloom#find
bloom:find rdf:type owl:NamedIndividual ,
                    bloom:ActionVerb ;
           bloom:hasActionVerbType bloom:StandardVerb ;
           bloom:isActionVerbFor bloom:Remembering ;
           rdfs:comment "Locate previously learned information or identify a known element."@en ;
           rdfs:label "find"@en ;
           skos:definition "Locate previously learned information or identify a known element in a familiar context."@en ;
           skos:example "Find the role of a loop variable in a given code fragment."@en ;
           skos:note "Often supports retrieval-oriented tasks grounded in prior knowledge."@en ;
           skos:prefLabel "find"@en ;
           skos:related bloom:Remembering .


###  http://purl.org/edu/bloom#hypothesize
bloom:hypothesize rdf:type owl:NamedIndividual ,
                           bloom:ActionVerb ;
                  bloom:hasActionVerbType bloom:StandardVerb ;
                  bloom:isActionVerbFor bloom:Creating ;
                  rdfs:comment "Propose a tentative explanation, prediction, or solution."@en ;
                  rdfs:label "hypothesize"@en ;
                  skos:definition "Propose a tentative explanation, prediction, or solution on the basis of available information."@en ;
                  skos:example "Hypothesize the performance impact of replacing one data structure with another."@en ;
                  skos:note "Supports generative reasoning and exploratory problem solving."@en ;
                  skos:prefLabel "hypothesize"@en .


###  http://purl.org/edu/bloom#integrate
bloom:integrate rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                dcterms:references <https://doi.org/10.1145/3467967> ;
                bloom:hasActionVerbType bloom:StandardVerb ;
                bloom:isActionVerbFor bloom:Analyzing ,
                                      cs2023:Develop ;
                rdfs:comment "Combine elements into a coherent whole while attending to their structural relations."@en ;
                rdfs:label "integrate"@en ;
                skos:definition "Combine elements into a coherent whole while attending to their structural relations and functional compatibility."@en ;
                skos:example "Integrate authentication, logging, and validation modules into a single application workflow."@en ;
                skos:note "May support analysis when emphasizing structural relation, and development when emphasizing constructive composition."@en ;
                skos:prefLabel "integrate"@en .


###  http://purl.org/edu/bloom#investigate
bloom:investigate rdf:type owl:NamedIndividual ,
                           bloom:ActionVerb ;
                  dcterms:references <https://doi.org/10.1145/3467967> ;
                  bloom:hasActionVerbType bloom:StandardVerb ;
                  bloom:isActionVerbFor bloom:Applying ;
                  rdfs:comment "Examine a case or problem in detail in order to discover relevant facts or explanations."@en ;
                  rdfs:label "investigate"@en ;
                  skos:definition "Examine a case or problem in detail in order to discover relevant facts, causes, or explanations."@en ;
                  skos:example "Investigate the source of a recurring failure in a software deployment."@en ;
                  skos:note "Can border on analysis, but here is kept in Applying when focused on guided examination in context."@en ;
                  skos:prefLabel "investigate"@en .


###  http://purl.org/edu/bloom#make
bloom:make rdf:type owl:NamedIndividual ,
                    bloom:ActionVerb ;
           bloom:hasActionVerbType bloom:StandardVerb ;
           bloom:isActionVerbFor bloom:Creating ;
           rdfs:comment "Construct or assemble something by combining parts or materials."@en ;
           rdfs:label "make"@en ;
           skos:definition "Construct or assemble something by combining parts, materials, or ideas into a whole."@en ;
           skos:example "Make a prototype interface for a mobile application."@en ;
           skos:note "Represents a broad productive action associated with creation."@en ;
           skos:prefLabel "make"@en .


###  http://purl.org/edu/bloom#manipulate
bloom:manipulate rdf:type owl:NamedIndividual ,
                          bloom:ActionVerb ;
                 dcterms:references <https://doi.org/10.1145/3467967> ;
                 bloom:hasActionVerbType bloom:StandardVerb ;
                 bloom:isActionVerbFor bloom:Applying ,
                                       cs2023:Apply ;
                 rdfs:comment "Handle or control data, tools, or structures in order to perform a task."@en ;
                 rdfs:label "manipulate"@en ;
                 skos:definition "Handle or control data, tools, or structures in order to perform a task or achieve a specified outcome."@en ;
                 skos:example "Manipulate a dataset using filtering and transformation operations."@en ;
                 skos:note "Strongly aligned with procedural and task-oriented application."@en ;
                 skos:prefLabel "manipulate"@en .


###  http://purl.org/edu/bloom#memorize
bloom:memorize rdf:type owl:NamedIndividual ,
                        bloom:ActionVerb ;
               bloom:hasActionVerbType bloom:StandardVerb ;
               bloom:isActionVerbFor bloom:Remembering ;
               rdfs:comment "Commit information to memory for later recall."@en ;
               rdfs:label "memorize"@en ;
               skos:definition "Commit information to memory for later recall."@en ;
               skos:example "Memorize a set of programming keywords and their meanings."@en ;
               skos:note "Typical of foundational recall-oriented learning tasks."@en ;
               skos:prefLabel "memorize"@en ;
               skos:related bloom:Remembering .


###  http://purl.org/edu/bloom#modify
bloom:modify rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             dcterms:references <https://doi.org/10.1145/3467967> ;
             bloom:hasActionVerbType bloom:StandardVerb ;
             bloom:isActionVerbFor bloom:Applying ,
                                   cs2023:Develop ;
             rdfs:comment "Change an existing artifact, design, or system in order to improve or adapt it."@en ;
             rdfs:label "modify"@en ;
             skos:definition "Change an existing artifact, design, or system in order to improve, refine, or adapt it."@en ;
             skos:example "Modify a user-interface layout to improve accessibility."@en ;
             skos:note "Can express procedural application or constructive refinement depending on the task context."@en ;
             skos:prefLabel "modify"@en .


###  http://purl.org/edu/bloom#outline
bloom:outline rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              dcterms:references <https://doi.org/10.1145/3467967> ;
              bloom:hasActionVerbType bloom:StandardVerb ;
              bloom:isActionVerbFor bloom:Analyzing ;
              rdfs:comment "Present the main structural elements or relations of something in simplified form."@en ;
              rdfs:label "outline"@en ;
              skos:definition "Present the main structural elements or relations of something in simplified form."@en ;
              skos:example "Outline the major components and interactions in a client-server architecture."@en ;
              skos:note "Supports analytical abstraction of structure and organization."@en ;
              skos:prefLabel "outline"@en .
			  
			  

###  http://purl.org/edu/bloom#produce
bloom:produce rdf:type owl:NamedIndividual ,
                       bloom:ActionVerb ;
              dcterms:references <https://doi.org/10.1145/3467967> ;
              bloom:hasActionVerbType bloom:StandardVerb ;
              bloom:isActionVerbFor bloom:Creating ;
              rdfs:comment "Generate or bring into existence an artifact, output, or result."@en ;
              rdfs:label "produce"@en ;
              skos:definition "Generate or bring into existence an artifact, output, or result through the organization of knowledge and resources."@en ;
              skos:example "Produce a working prototype that addresses a specified user requirement."@en ;
              skos:note "More strongly aligned with productive creation than with procedural application."@en ;
              skos:prefLabel "produce"@en .


###  http://purl.org/edu/bloom#report
bloom:report rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:hasActionVerbType bloom:StandardVerb ;
             bloom:isActionVerbFor bloom:Understanding ;
             rdfs:comment "Communicate findings, observations, or results in an organized form."@en ;
             rdfs:label "report"@en ;
             skos:definition "Communicate findings, observations, or results from a task or activity in an organized form."@en ;
             skos:example "Report the results of a usability evaluation for a prototype interface."@en ;
             skos:note "Typically reflects explanatory understanding rather than evaluative judgment or creative production."@en ;
             skos:prefLabel "report"@en .


###  http://purl.org/edu/bloom#select
bloom:select rdf:type owl:NamedIndividual ,
                      bloom:ActionVerb ;
             bloom:hasActionVerbType bloom:StandardVerb ;
             bloom:isActionVerbFor bloom:Remembering ;
             rdfs:comment "Choose a relevant item, fact, or option from known information."@en ;
             rdfs:label "select"@en ;
             skos:definition "Choose a relevant item, fact, or option from known information or from a familiar set of alternatives."@en ;
             skos:example "Select the correct syntax for a for loop from a set of alternatives."@en ;
             skos:note "Here treated conservatively as a remembering-oriented verb, especially in recognition and recall contexts."@en ;
             skos:prefLabel "select"@en ;
             skos:related bloom:Remembering .


###  http://purl.org/edu/bloom#state
bloom:state rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            bloom:hasActionVerbType bloom:StandardVerb ,
                                    bloom:CS2023Verb ;
            bloom:isActionVerbFor bloom:Remembering ,
                                  cs2023:Explain ;
            rdfs:comment "Express a fact, concept, or rule clearly in spoken or written form."@en ;
            rdfs:label "state"@en ;
            skos:definition "Express a fact, concept, or rule clearly in spoken or written form."@en ;
            skos:example "State the definition of a variable and its role in a program."@en ;
            skos:note "Can support both factual recall and explicit verbal explanation, depending on context."@en ;
            skos:prefLabel "state"@en ;
            skos:related bloom:Remembering .


###  http://purl.org/edu/bloom#structure
bloom:structure rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                dcterms:references <https://doi.org/10.1145/3467967> ;
                bloom:hasActionVerbType bloom:StandardVerb ;
                bloom:isActionVerbFor bloom:Analyzing ;
                rdfs:comment "Organize elements into a meaningful arrangement that reveals their relations."@en ;
                rdfs:label "structure"@en ;
                skos:definition "Organize elements into a meaningful arrangement that reveals their relations, dependencies, or hierarchy."@en ;
                skos:example "Structure the main components and interactions of a software architecture."@en ;
                skos:note "Supports analytical representation of organization and internal relations."@en ;
                skos:prefLabel "structure"@en .


###  http://purl.org/edu/bloom#translate
bloom:translate rdf:type owl:NamedIndividual ,
                         bloom:ActionVerb ;
                bloom:hasActionVerbType bloom:StandardVerb ;
                bloom:isActionVerbFor bloom:Understanding ;
                rdfs:comment "Express information from one representational form in another while preserving meaning."@en ;
                rdfs:label "translate"@en ;
                skos:definition "Express information from one representational form in another while preserving meaning."@en ;
                skos:example "Translate a mathematical expression into executable code."@en ;
                skos:note "Closely associated with interpretive understanding across representations."@en ;
                skos:prefLabel "translate"@en .


###  http://purl.org/edu/bloom#write
bloom:write rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            dcterms:references <https://doi.org/10.1145/3467967> ;
            bloom:hasActionVerbType bloom:StandardVerb ;
            bloom:isActionVerbFor bloom:Applying ;
            rdfs:comment "Compose textual or symbolic content to express a solution, procedure, or idea."@en ;
            rdfs:label "write"@en ;
            skos:definition "Compose textual or symbolic content to express a solution, procedure, or idea in an appropriate form."@en ;
            skos:example "Write a function that implements a specified algorithm."@en ;
            skos:note "Here treated as an applying-oriented verb when emphasis falls on producing a correct procedural or formal expression."@en ;
            skos:prefLabel "write"@en .
			
			

###  http://purl.org/edu/bloom#adapt
bloom:adapt rdf:type owl:NamedIndividual ,
                     bloom:ActionVerb ;
            dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
            bloom:hasActionVerbType bloom:ComputingVerb ;
            bloom:isActionVerbFor cs2023:Develop ;
            rdfs:comment "Modify an existing system, script, or strategy to fit new requirements or operational contexts."@en ;
            rdfs:label "adapt"@en ;
            skos:definition "Modify an existing system, script, or strategy so that it fits new requirements, constraints, or operational contexts."@en ;
            skos:example "Adapt a network defense strategy to a new network configuration."@en ,
                         "Adapt a script to satisfy a specific operational requirement."@en ,
                         "Adapt software to comply with updated industry standards."@en ;
            skos:note "Best treated as development-oriented when the emphasis falls on constructive modification for a new context."@en ;
            skos:prefLabel "adapt"@en ;
            skos:related bloom:configure ,
                         bloom:customize .


###  http://purl.org/edu/bloom#administer
bloom:administer rdf:type owl:NamedIndividual ,
                          bloom:ActionVerb ;
                 dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
                 bloom:hasActionVerbType bloom:ComputingVerb ;
                 bloom:isActionVerbFor cs2023:Evaluate ;
