               bloom:hasActionVerbType bloom:StandardVerb ;
               bloom:isActionVerbFor bloom:Evaluating ;
               rdfs:comment "Evaluate something critically by identifying strengths, weaknesses, and possible improvements."@en ;
               rdfs:label "critique"@en ;
