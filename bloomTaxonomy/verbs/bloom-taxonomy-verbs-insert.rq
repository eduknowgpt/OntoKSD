# Sources: DOI 10.1145/3587276, Tables 1-2; CS2023 Table 1 lists supplied by the author.
# Load ActionVerbType individuals separately before this script.
# No classes, level individuals, or verb-type individuals are created here.
# Definitions/examples are project glosses, not source quotations or validated task classifications.
# Categories indicate exact list membership; association provenance is recorded on named owl:Axiom resources.
# Run on a fresh graph. INSERT DATA does not remove old mappings/types/references.
# Named annotation IRIs avoid blank-node duplication on repeated insertion.

PREFIX bloom: <http://purl.org/edu/bloom#>
PREFIX cs2023: <http://purl.org/edu/cs2023#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {

bloom:adapt a bloom:ActionVerb,
        owl:NamedIndividual ;
    rdfs:label "adapt"@en ;
    dcterms:references <https://doi.org/10.1145/3587276> ;
    bloom:hasActionVerbType bloom:ComputingVerb ;
    bloom:isActionVerbFor bloom:Evaluating ;
    skos:definition "Adjust an approach or artifact in response to changed conditions or requirements."@en ;
    skos:example "Adapt a network defense strategy to a new network configuration."@en,
        "Adapt a script to satisfy a specific operational requirement."@en,
        "Adapt software to comply with updated industry standards."@en ;
    skos:prefLabel "adapt"@en .

