             bloom:hasActionVerbType bloom:StandardVerb ,
                                     bloom:CS2023Verb ,
                                     bloom:ComputingVerb ;
             bloom:isActionVerbFor bloom:Evaluating ,
                                   cs2023:Evaluate ;
             rdfs:comment "Choose the most appropriate option on the basis of informed judgment."@en ;
             rdfs:label "decide"@en ;
