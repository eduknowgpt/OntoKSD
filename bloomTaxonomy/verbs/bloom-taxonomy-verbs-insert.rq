            skos:example "Build a machine learning model to detect network intrusions."@en ,
                         "Build a multi-router network using an automation script."@en ,
                         "Build and deploy a containerized web application."@en ;
            skos:note "Better aligned with productive construction and development than with simple procedural application."@en ;
            skos:prefLabel "build"@en ;
