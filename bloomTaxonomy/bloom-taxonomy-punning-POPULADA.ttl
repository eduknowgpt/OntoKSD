@prefix : <http://purl.org/edu/bloom#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://purl.org/edu/bloom> a owl:Ontology ;
	rdfs:comment "This ontology uses OWL 2 punning to represent cognitive levels as both classes and individuals."@en ;
	rdfs:label "Bloom's Revised Taxonomy Ontology (with Punning)"@en .
# 
# 
# #################################################################
# #
# #    Annotation properties
# #
# #################################################################
# 
# 
# http://purl.org/dc/terms/references

dcterms:references a owl:AnnotationProperty .
# 
# http://www.w3.org/2004/02/skos/core#altLabel

skos:altLabel a owl:AnnotationProperty .
# 
# http://www.w3.org/2004/02/skos/core#broader

skos:broader a owl:AnnotationProperty .
# 
# http://www.w3.org/2004/02/skos/core#definition

skos:definition a owl:AnnotationProperty .
# 
# http://www.w3.org/2004/02/skos/core#example

skos:example a owl:AnnotationProperty .
# 
# http://www.w3.org/2004/02/skos/core#note

skos:note a owl:AnnotationProperty .
# 
# http://www.w3.org/2004/02/skos/core#prefLabel

skos:prefLabel a owl:AnnotationProperty .
# 
# http://www.w3.org/2004/02/skos/core#related

skos:related a owl:AnnotationProperty .
# 
# 
# 
# #################################################################
# #
# #    Object Properties
# #
# #################################################################
# 
# 
# http://purl.org/edu/bloom#follows

:follows a owl:ObjectProperty ;
	owl:inverseOf :precedes ;
	rdfs:comment "The inverse of precedes."@en ;
	rdfs:label "follows"@en .
# 
# http://purl.org/edu/bloom#hasActionVerb

:hasActionVerb a owl:ObjectProperty ;
	owl:inverseOf :isActionVerbFor ;
	rdfs:domain :CognitiveProcessLevel ;
	rdfs:range :ActionVerb ;
	rdfs:comment "Associates a cognitive process level with one or more verbs."@en ;
	rdfs:label "hasActionVerb"@en .
# 
# http://purl.org/edu/bloom#hasActionVerbType

:hasActionVerbType a owl:ObjectProperty ;
	owl:inverseOf :isActionVerbTypeFor ;
	rdfs:domain :ActionVerb ;
	rdfs:range :ActionVerbType .
# 
# http://purl.org/edu/bloom#isActionVerbFor

:isActionVerbFor a owl:ObjectProperty ;
	rdfs:domain :ActionVerb ;
	rdfs:range :CognitiveProcessLevel ;
	rdfs:comment "isActionVerbFor" .
# 
# http://purl.org/edu/bloom#isActionVerbTypeFor

:isActionVerbTypeFor a owl:ObjectProperty ;
	rdfs:subPropertyOf owl:topObjectProperty ;
	rdfs:domain :ActionVerbType ;
	rdfs:range :ActionVerb .
# 
# http://purl.org/edu/bloom#precedes

:precedes a owl:ObjectProperty ;
	rdfs:domain :CognitiveProcessLevel ;
	rdfs:range :CognitiveProcessLevel ;
	rdfs:comment "Indicates that one cognitive level precedes another."@en ;
	rdfs:label "precedes"@en .
# 
# 
# 
# #################################################################
# #
# #    Data properties
# #
# #################################################################
# 
# 
# http://purl.org/edu/bloom#hasComplexityLevel

:hasComplexityLevel a owl:DatatypeProperty ;
	rdfs:domain :CognitiveProcessLevel ;
	rdfs:range xsd:int ;
	rdfs:comment """\"Indicates the ascending cognitive complexity of this level.\"@en .
Numeric indicator of complexity (1 to 6)."""@en ;
	rdfs:label "hasComplexityLevel"@en .
# 
# 
# 
# #################################################################
# #
# #    Classes
# #
# #################################################################
# 
# 
# http://purl.org/edu/bloom#ActionVerb

:ActionVerb a owl:Class ;
	rdfs:subClassOf _:genid1 .

_:genid1 a owl:Restriction ;
	owl:onProperty :hasActionVerbType ;
	owl:someValuesFrom :ActionVerbType .

:ActionVerb rdfs:subClassOf _:genid2 .

_:genid2 a owl:Restriction ;
	owl:onProperty :isActionVerbFor ;
	owl:someValuesFrom :CognitiveProcessLevel .

:ActionVerb rdfs:comment "An action verb commonly used to describe learning objectives."@en ;
	rdfs:label "ActionVerb"@en .
# 
# http://purl.org/edu/bloom#ActionVerbType

:ActionVerbType a owl:Class ;
	rdfs:comment "Classifies verbs as standard, computing-enhanced, technical, dispositional, or general-purpose." .
# 
# http://purl.org/edu/bloom#Analyzing

:Analyzing a owl:Class ;
	rdfs:subClassOf :CognitiveProcessLevel .
# 
# http://purl.org/edu/bloom#Applying

:Applying a owl:Class ;
	rdfs:subClassOf :CognitiveProcessLevel .
# 
# http://purl.org/edu/bloom#CognitiveProcessLevel

:CognitiveProcessLevel a owl:Class ;
	owl:equivalentClass _:genid3 .

_:genid3 a owl:Restriction ;
	owl:onProperty :hasComplexityLevel ;
	owl:allValuesFrom _:genid4 .

_:genid4 a rdfs:Datatype ;
	owl:oneOf _:genid10 .

_:genid10 a rdf:List ;
	rdf:first "1"^^xsd:integer ;
	rdf:rest _:genid9 .

_:genid9 a rdf:List ;
	rdf:first "2"^^xsd:integer ;
	rdf:rest _:genid8 .

_:genid8 a rdf:List ;
	rdf:first "3"^^xsd:integer ;
	rdf:rest _:genid7 .

_:genid7 a rdf:List ;
	rdf:first "4"^^xsd:integer ;
	rdf:rest _:genid6 .

_:genid6 a rdf:List ;
	rdf:first "5"^^xsd:integer ;
	rdf:rest _:genid5 .

_:genid5 a rdf:List ;
	rdf:first "6"^^xsd:integer ;
	rdf:rest rdf:nil .

:CognitiveProcessLevel rdfs:subClassOf _:genid11 .

_:genid11 a owl:Restriction ;
	owl:onProperty :follows ;
	owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
	owl:onClass :CognitiveProcessLevel .

:CognitiveProcessLevel rdfs:subClassOf _:genid12 .

_:genid12 a owl:Restriction ;
	owl:onProperty :precedes ;
	owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
	owl:onClass :CognitiveProcessLevel .

:CognitiveProcessLevel rdfs:subClassOf _:genid13 .

_:genid13 a owl:Restriction ;
	owl:onProperty :hasComplexityLevel ;
	owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
	owl:onDataRange xsd:int .

:CognitiveProcessLevel rdfs:comment """A cognitive level in Bloom's Revised Taxonomy.

The subclasses of CognitiveProcessLevel are mutually disjoint because the levels of Bloom's Taxonomy—Remembering, Understanding, Applying, Analyzing, Evaluating, and Creating—are conceptually exclusive: an instance of a cognitive activity belongs to only one of these levels at a time.

Justifications:
1. Educational semantics: Each level represents a distinct degree of cognitive complexity and does not conceptually overlap with the others.

2. OWL inference: Declaring the subclasses as disjoint allows the reasoner to detect inconsistencies (e.g., if an activity is simultaneously classified as Applying and Evaluating).

3. Good modeling practice: In well-formalized ontologies, it is common to explicitly state disjunctions between conceptually exclusive subclasses."""@en ;
	rdfs:label "CognitiveProcessLevel"@en .
# 
# http://purl.org/edu/bloom#Creating

:Creating a owl:Class ;
	rdfs:subClassOf :CognitiveProcessLevel .
# 
# http://purl.org/edu/bloom#Evaluating

:Evaluating a owl:Class ;
	rdfs:subClassOf :CognitiveProcessLevel .
# 
# http://purl.org/edu/bloom#Remembering

:Remembering a owl:Class ;
	rdfs:subClassOf :CognitiveProcessLevel .
# 
# http://purl.org/edu/bloom#Understanding

:Understanding a owl:Class ;
	rdfs:subClassOf :CognitiveProcessLevel .
