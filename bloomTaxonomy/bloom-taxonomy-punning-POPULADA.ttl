# 
# http://purl.org/edu/bloom#Adapt

:Adapt a owl:NamedIndividual , :ActionVerb ;
	:hasActionVerbType :ComputingVerb ;
	:isActionVerbFor :Evaluating ;
	rdfs:comment "Common task in computing disciplines."@en ;
	rdfs:label "adapt"@en ;
	skos:definition "Modify an existing solution or system to suit a new context or requirements."@en ;
	skos:example "Adapt a network defense strategy to a new configuration."@en , "Adapt a script functionality to meet a specific task."@en , "Adapt software to constantly changing industry standards."@en ;
	skos:prefLabel "adapt"@en .
# 
# http://purl.org/edu/bloom#Administer

:Administer a owl:NamedIndividual , :ActionVerb ;
	:hasActionVerbType :ComputingVerb ;
	:isActionVerbFor :Evaluating ;
	rdfs:comment "Common in information systems, networks, and security."@en ;
	rdfs:label "administer"@en ;
	skos:definition "Manage and oversee computing systems, services, or infrastructure."@en ;
	skos:example "Administer a web server."@en , "Administer an information system for a local business."@en , "Administer tools and techniques to design and implement a system solution."@en , "Administer virtual machines serving a large user base."@en ;
	skos:prefLabel "administer"@en .
# 
# http://purl.org/edu/bloom#Analyze

:Analyze a owl:NamedIndividual , :ActionVerb ;
	:isActionVerbFor :Analyzing ;
	dcterms:references <https://dl.acm.org/doi/10.1145/3573260> ;
	rdfs:comment "Breaking down a system or idea into constituent parts to understand it better."@en ;
	rdfs:label "analyze"@en ;
	skos:definition "Break down a system, process, or dataset into its components to understand structure, function, or behavior."@en ;
	skos:example "Analyze a sorting algorithm to determine its time complexity."@en ;
	skos:note "Core cognitive action in computing tasks such as algorithm analysis, systems evaluation, and data inspection."@en ;
	skos:prefLabel "analyze"@en .
# 
# http://purl.org/edu/bloom#Analyzing

:Analyzing a owl:NamedIndividual , :CognitiveProcessLevel ;
	:precedes :Evaluating ;
	:hasComplexityLevel "4"^^xsd:integer .
# 
# http://purl.org/edu/bloom#Annotate

:Annotate a owl:NamedIndividual , :ActionVerb ;
	:hasActionVerbType :ComputingVerb ;
	:isActionVerbFor :Understanding ;
	dcterms:references <https://doi.org/10.1145/3587276> ;
	rdfs:comment "Clearly label or mark elements in diagrams, graphs, or system schematics as part of computing practices."@en ;
	rdfs:label "annotate"@en ;
	skos:definition "Add clarifying information or labels to diagrams, code, or other artifacts to improve understanding and communication."@en ;
	skos:example "Annotate a network diagram with the names of components or annotate a threat model graph."@en ;
	skos:note "Essential for conveying system architecture or analysis results in computing fields."@en ;
	skos:prefLabel "annotate"@en ;
	skos:related :Diagram , :Label .
# 
# http://purl.org/edu/bloom#Apply

:Apply a owl:NamedIndividual , :ActionVerb ;
	:hasActionVerbType :StandardVerb ;
	:isActionVerbFor :Applying ;
	dcterms:references <https://doi.org/10.1145/3467967> ;
	rdfs:comment "Use knowledge in new situations or contexts."@en ;
	rdfs:label "apply"@en ;
	skos:definition "Use knowledge in new situations or contexts."@en ;
	skos:example "Apply a solution in a real-world scenario."@en ;
	skos:prefLabel "apply"@en .
# 
# http://purl.org/edu/bloom#Applying

:Applying a owl:NamedIndividual , :CognitiveProcessLevel ;
	:precedes :Analyzing ;
	:hasComplexityLevel "3"^^xsd:integer .
# 
# http://purl.org/edu/bloom#Appraise

:Appraise a owl:NamedIndividual , :ActionVerb ;
	:hasActionVerbType :StandardVerb ;
	:isActionVerbFor :Evaluating ;
	dcterms:references <https://doi.org/10.1145/3467967> ;
	rdfs:comment "Assessing the value or quality of something."@en ;
	rdfs:label "appraise"@en ;
	skos:definition "Assess the value, significance, or quality of something."@en ;
	skos:example "Appraise the effectiveness of a marketing strategy."@en ;
	skos:note "Common in evaluations of performance or proposals."@en ;
	skos:prefLabel "appraise"@en ;
	skos:related :Assess , :Rate .
# 
# http://purl.org/edu/bloom#Argue

:Argue a owl:NamedIndividual , :ActionVerb ;
	:isActionVerbFor :Evaluating ;
