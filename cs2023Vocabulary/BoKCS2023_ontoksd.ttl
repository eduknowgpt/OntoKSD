cs2023:Topic_PDC_Programs_1_a a cs2023:KnowledgeElement,
        cs2023:Topic,
        skos:Concept ;
    cs2023:hasCoreStatus cs2023:CSCore ;
    cs2023:hasCurationStatus cs2023:Revised ;
