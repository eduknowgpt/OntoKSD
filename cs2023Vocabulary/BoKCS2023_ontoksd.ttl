cs2023:Topic_PDC_Communication_5_h_i a cs2023:KnowledgeElement,
        cs2023:Topic,
        skos:Concept ;
    cs2023:hasCoreStatus cs2023:KACore ;
    cs2023:hasCurationStatus cs2023:Revised ;
