cs2023:KnowledgeUnit a owl:Class ;
    rdfs:label "Knowledge Unit"@en ;
    rdfs:subClassOf cs2023:KnowledgeElement ;
    skos:definition "A curricular unit within a Knowledge Area in the CS2023 Body of Knowledge."@en .

cs2023:NonCore a skos:Concept ;
    skos:inScheme cs2023:BoKCS2023Scheme,
        cs2023:CoreStatusScheme ;
    skos:notation "NonCore" ;
    skos:prefLabel "Non-core"@en .

cs2023:CSCore a skos:Concept ;
    skos:inScheme cs2023:BoKCS2023Scheme,
        cs2023:CoreStatusScheme ;
    skos:notation "CSCore" ;
    skos:prefLabel "CS Core"@en .

cs2023:KACore a skos:Concept ;
    skos:inScheme cs2023:BoKCS2023Scheme,
        cs2023:CoreStatusScheme ;
    skos:notation "KACore" ;
    skos:prefLabel "KA Core"@en .

cs2023:Topic a owl:Class ;
    rdfs:label "Topic"@en ;
    rdfs:subClassOf cs2023:KnowledgeElement ;
    skos:definition "A topic or subtopic within a Knowledge Unit in the CS2023 Body of Knowledge."@en .

cs2023:Revised a skos:Concept ;
    skos:inScheme cs2023:CurationStatusScheme ;
    skos:prefLabel "Revised"@en .

cs2023:KnowledgeElement a owl:Class ;
    rdfs:label "Knowledge Element"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A conceptual element of the CS2023 Body of Knowledge used to organize curriculum content at different levels of granularity."@en .

cs2023:BoKCS2023Scheme a skos:ConceptScheme ;
    dcterms:source <https://csed.acm.org/wp-content/uploads/2024/01/Body-of-Knowledge-v1-bookmarksv2.pdf> ;
    dcterms:title "CS2023 Body of Knowledge Scheme"@en ;
    skos:definition "SKOS concept scheme representing the knowledge areas, knowledge units, and topics of the CS2023 Body of Knowledge."@en ;
    skos:hasTopConcept cs2023:AI,
        cs2023:AL,
        cs2023:AR,
        cs2023:DM,
        cs2023:FPL,
        cs2023:GIT,
        cs2023:HCI,
        cs2023:MSF,
        cs2023:NC,
        cs2023:OS,
        cs2023:PDC,
        cs2023:SDF,
        cs2023:SE,
        cs2023:SEC,
        cs2023:SEP,
        cs2023:SF,
        cs2023:SPD ;
    skos:prefLabel "CS2023 Body of Knowledge"@en .

cs2023:CS2023Document a prov:Entity ;
    dcterms:source <https://csed.acm.org/wp-content/uploads/2023/09/Version-Gamma.pdf> ;
    dcterms:title "Computer Science Curricula 2023"@en .

cs2023:CS2023BoKDocument a prov:Entity ;
    dcterms:source <https://csed.acm.org/wp-content/uploads/2024/01/Body-of-Knowledge-v1-bookmarksv2.pdf> ;
