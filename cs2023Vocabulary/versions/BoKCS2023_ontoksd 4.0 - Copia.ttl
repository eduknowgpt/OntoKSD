    skos:inScheme cs2023:BoKCS2023Scheme ;
    skos:notation "SEP-Sustainability.1"^^xsd:string ;
    skos:prefLabel "Environmental, social, and cultural impacts of implementation decisions (e.g., sustainability goals, algorithmic bias/outcomes, economic viability, and resource consumption)"@en ;
