cs2023:curationStatus a owl:DatatypeProperty ;
    rdfs:label "curation status"@en ;
    skos:definition "Indicates the curation status of an extracted CS2023 knowledge element."@en .

cs2023:hasCoreStatus a owl:ObjectProperty ;
    rdfs:label "has core status"@en ;
    rdfs:domain cs2023:Topic ;
    rdfs:range skos:Concept ;
    skos:definition "Associates a topic with its curricular status in CS2023, such as CS Core, KA Core, or Non-core."@en .

cs2023:hasCurationStatus a owl:ObjectProperty ;
    rdfs:label "has curation status"@en ;
    rdfs:domain cs2023:KnowledgeElement ;
    rdfs:range skos:Concept ;
    skos:definition "Associates a CS2023 knowledge element with a controlled curation-status value."@en .

cs2023:hasKnowledgeUnit a owl:ObjectProperty ;
    rdfs:label "has knowledge unit"@en ;
    rdfs:domain cs2023:KnowledgeArea ;
    rdfs:range cs2023:KnowledgeUnit ;
    skos:definition "Associates a knowledge area with a knowledge unit that belongs to it."@en .

cs2023:hasTopic a owl:ObjectProperty ;
    rdfs:label "has topic"@en ;
    rdfs:domain cs2023:KnowledgeUnit ;
    rdfs:range cs2023:Topic ;
    skos:definition "Associates a knowledge unit with a topic that belongs to it."@en .

cs2023:inKnowledgeArea a owl:ObjectProperty ;
    rdfs:label "in knowledge area"@en ;
    rdfs:domain cs2023:KnowledgeUnit ;
    rdfs:range cs2023:KnowledgeArea ;
    skos:definition "Associates a Knowledge Unit with the Knowledge Area to which it belongs."@en .

cs2023:inKnowledgeUnit a owl:ObjectProperty ;
    rdfs:label "in knowledge unit"@en ;
    rdfs:domain cs2023:Topic ;
    rdfs:range cs2023:KnowledgeUnit ;
    skos:definition "Associates a topic with the knowledge unit to which it belongs."@en .

