cs2023:Topic/SEC-Governance_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Governance 2" ;
    skos:definition "Security governance: organizational objectives and general risk assessment" ;
    skos:broader cs2023:KU/SEC-Governance ;
