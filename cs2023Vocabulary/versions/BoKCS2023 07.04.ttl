    skos:definition "Avoiding locks: replication, read-only, ownership, and non-blocking constructions" ;
    skos:broader cs2023:Topic/PDC-Coordination_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 4" ;
    skos:definition "One or more of the following properties and extensions" ;
