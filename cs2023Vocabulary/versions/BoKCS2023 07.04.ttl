    skos:broader cs2023:Topic/OS-SEP_1 ;
    skos:altLabel "KA Core" .

cs2023:Topic/OS-SEP_1_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-SEP 1.d" ;
    skos:definition "Changes in monetization (paid vs free upgrades)." ;
    skos:broader cs2023:Topic/OS-SEP_1 ;
    skos:altLabel "KA Core" .

cs2023:Topic/OS-SEP_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-SEP 2" ;
    skos:definition "End-of-life issues with sunsetting operating systems. Example concept:  Privacy implications of using proprietary operating systems/operating environments, including telemetry, automated scanning of personal data, built-in advertising, and automatic cloud integration." ;
    skos:broader cs2023:KU/OS-SEP ;
    skos:altLabel "KA Core" .

cs2023:KU/PDC-Programs a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "PDC-Programs" ;
    skos:prefLabel "Programs" .

cs2023:Topic/PDC-Programs_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 1" ;
    skos:definition "Parallelism" ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_1_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 1.a" ;
    skos:definition "Declarative parallelism: Determining which actions may, or must not, be performed in parallel, at the level of instructions, functions, closures, composite actions, sessions, tasks, and services is the main idea underlying PDC algorithms; failing to do so is the main source of errors. (See also: PDC-Algorithms)" ;
    skos:broader cs2023:Topic/PDC-Programs_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_1_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 1.b" ;
    skos:definition "Defining order: for example, using happens-before relations or series/parallel directed acyclic graphs representing programs." ;
    skos:broader cs2023:Topic/PDC-Programs_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_1_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 1.c" ;
    skos:definition "Independence: determining when ordering does not matter, in terms of commutativity, dependencies, preconditions." ;
    skos:broader cs2023:Topic/PDC-Programs_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_1_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 1.d" ;
    skos:definition "Ensuring ordering among otherwise parallel actions when necessary, including locking, safe publication; and imposing communication sending a message happens before receiving it; conversely relaxing when unnecessary." ;
    skos:broader cs2023:Topic/PDC-Programs_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 2" ;
    skos:definition "Distribution" ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_2_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 2.a" ;
    skos:definition "Defining places, as devices executing actions, including hardware components, remote hosts, may also include external, uncontrolled devices, hosts, and users. (See also: AR-IO)" ;
    skos:broader cs2023:Topic/PDC-Programs_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_2_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 2.b" ;
    skos:definition "One device may time-slice or otherwise emulate multiple parallel actions by fewer processors by scheduling and virtualization. (See also: OS-Scheduling)" ;
    skos:broader cs2023:Topic/PDC-Programs_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_2_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 2.c" ;
    skos:definition "Naming or identifying places (e.g., device IDs) and actions as parties (e.g., thread IDs)." ;
    skos:broader cs2023:Topic/PDC-Programs_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_2_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 2.d" ;
    skos:definition "Activities across places may communicate across media. (See also: PDC-Communication)" ;
    skos:broader cs2023:Topic/PDC-Programs_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 3" ;
    skos:definition "Starting activities" ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_3_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 3.a" ;
    skos:definition "Options that enable actions to be performed (eventually) at places range from hardwiring to configuration scripts; also establishing communication and resource management; these are expressed differently across languages and contexts, usually relying on automated provisioning and management by platforms (See also: SF-Resources)" ;
    skos:broader cs2023:Topic/PDC-Programs_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_3_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 3.b" ;
    skos:definition "Procedural: Enabling multiple actions to start at a given program point; for example, starting new threads, possibly scoping, or otherwise organizing them in hierarchical groups" ;
    skos:broader cs2023:Topic/PDC-Programs_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_3_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 3.c" ;
    skos:definition "Reactive: Enabling upon an event by installing an event handler, with less control of when actions begin or end, and may apply even on uniprocessors" ;
    skos:broader cs2023:Topic/PDC-Programs_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_3_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 3.d" ;
    skos:definition "Dependent: Enabling upon completion of others; for example, sequencing sets of parallel actions (See also: PDC-Coordination)" ;
    skos:broader cs2023:Topic/PDC-Programs_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_3_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 3.e" ;
    skos:definition "Granularity: Execution cost of action bodies should outweigh the overhead of arranging them" ;
    skos:broader cs2023:Topic/PDC-Programs_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 4" ;
    skos:definition "Execution Properties" ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_4_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 4.a" ;
    skos:definition "Nondeterministic execution of unordered actions" ;
    skos:broader cs2023:Topic/PDC-Programs_4 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_4_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 4.b" ;
    skos:definition "Consistency: Ensuring agreement among parties about values and predicates when necessary to avoid races, maintain safety and atomicity, or arrive at consensus" ;
    skos:broader cs2023:Topic/PDC-Programs_4 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_4_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 4.c" ;
    skos:definition "Fault tolerance: Handling failures in parties or communication, including (Byzantine) misbehavior due to untrusted parties and protocols, when necessary to maintain progress or availability (See also: SF-Reliability)" ;
    skos:broader cs2023:Topic/PDC-Programs_4 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_4_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 4.d" ;
    skos:definition "Tradeoffs are one focus of evaluation (See also: PDC-Evaluation)" ;
    skos:broader cs2023:Topic/PDC-Programs_4 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5" ;
    skos:definition "One or more of the following mappings and mechanisms across layered systems:" ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_5_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5.a" ;
    skos:definition "CPU data- and instruction-level-parallelism (See also: AR-Organization)" ;
    skos:broader cs2023:Topic/PDC-Programs_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_5_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5.b" ;
    skos:definition "SIMD and heterogeneous data parallelism (See also: AR-Heterogeneity)" ;
    skos:broader cs2023:Topic/PDC-Programs_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_5_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5.c" ;
    skos:definition "Multicore scheduled concurrency, tasks, actors (See also: OS-Scheduling)" ;
    skos:broader cs2023:Topic/PDC-Programs_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_5_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5.d" ;
    skos:definition "Clusters, clouds; elastic provisioning. (See also: SPD-Common)" ;
    skos:broader cs2023:Topic/PDC-Programs_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_5_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5.e" ;
    skos:definition "Networked distributed systems (See also: NC-Applications)" ;
    skos:broader cs2023:Topic/PDC-Programs_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_5_f a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5.f" ;
    skos:definition "Emerging technologies such as quantum computing and molecular computing Illustrative Learning Outcomes;" ;
    skos:broader cs2023:Topic/PDC-Programs_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 1" ;
    skos:definition "Graphically show (as a Directed Acyclic Graph (DAG)) how to parallelize a compound numerical expression; for example, a = (b + c) * (d + e)." ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 2" ;
    skos:definition "Explain why the concepts of consistency and fault tolerance do not arise in purely sequential programs." ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Programs_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 3" ;
    skos:definition "Write a function that efficiently counts events such as networking packet receptions." ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 4" ;
    skos:definition "Write a filter/map/reduce program in multiple styles." ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Programs_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Programs 5" ;
    skos:definition "Write a service that creates a thread (or other procedural form of activation) to return a requested web page to each new client." ;
    skos:broader cs2023:KU/PDC-Programs ;
    skos:altLabel "KA Core" .

cs2023:KU/PDC-Communication a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "PDC-Communication" ;
    skos:prefLabel "Communication" .

cs2023:Topic/PDC-Communication_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 1" ;
    skos:definition "Media" ;
    skos:broader cs2023:KU/PDC-Communication ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_1_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 1.a" ;
    skos:definition "Varieties: channels (message passing or I/O), shared memory, heterogeneous, data stores" ;
    skos:broader cs2023:Topic/PDC-Communication_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_1_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 1.b" ;
    skos:definition "Reliance on the availability and nature of underlying hardware, connectivity, and protocols; language support, emulation (See also: AR-IO)" ;
    skos:broader cs2023:Topic/PDC-Communication_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 2" ;
    skos:definition "Channels" ;
    skos:broader cs2023:KU/PDC-Communication ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_2_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 2.a" ;
    skos:definition "Explicit (usually named) party-to-party communication media" ;
    skos:broader cs2023:Topic/PDC-Communication_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_2_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 2.b" ;
    skos:definition "APIs: Sockets, architectural, language-based, and toolkit constructs, such as Message Passing Interface (MPI), and layered constructs such as Remote Procedure Call (RPC) (See also: NC-Fundamentals)" ;
    skos:broader cs2023:Topic/PDC-Communication_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_2_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 2.c" ;
    skos:definition "I/O channel APIs" ;
    skos:broader cs2023:Topic/PDC-Communication_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 3" ;
    skos:definition "Memory" ;
    skos:broader cs2023:KU/PDC-Communication ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_3_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 3.a" ;
    skos:definition "Shared memory architectures in which parties directly communicate only with memory at given addresses, with extensions to heterogeneous memory supporting multiple memory stores with explicit data transfer across them; for example, GPU local and shared memory, Direct Memory Access (DMA)" ;
    skos:broader cs2023:Topic/PDC-Communication_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_3_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 3.b" ;
    skos:definition "Memory hierarchies: Multiple layers of sharing domains, scopes, and caches; locality: latency, false-sharing" ;
    skos:broader cs2023:Topic/PDC-Communication_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_3_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 3.c" ;
    skos:definition "Consistency properties: Bitwise atomicity limits, coherence, local ordering" ;
    skos:broader cs2023:Topic/PDC-Communication_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 4" ;
    skos:definition "Data Stores" ;
    skos:broader cs2023:KU/PDC-Communication ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_4_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 4.a" ;
    skos:definition "Cooperatively maintained data structures implementing maps and related ADTs" ;
    skos:broader cs2023:Topic/PDC-Communication_4 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_4_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 4.b" ;
    skos:definition "Varieties: Owned, shared, sharded, replicated, immutable, versioned" ;
    skos:broader cs2023:Topic/PDC-Communication_4 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Communication_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5" ;
    skos:definition "One or more of the following properties and extensions" ;
    skos:broader cs2023:KU/PDC-Communication ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.a" ;
    skos:definition "Topologies: Unicast, Multicast, Mailboxes, Switches; Routing via hardware and software interconnection networks" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.b" ;
    skos:definition "Media concurrency properties: Ordering, consistency, idempotency, overlapping communication with computation" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.c" ;
    skos:definition "Media performance: Latency, bandwidth (throughput) contention (congestion), responsiveness (liveness), reliability (error and drop rates), protocol-based progress (acks, timeouts, mediation)" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.d" ;
    skos:definition "Media security properties: integrity, privacy, authentication, authorization (See also: SEC- Secure Coding)" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.e" ;
    skos:definition "Data formats: Marshaling, validation, encryption, compression" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_f a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.f" ;
    skos:definition "Channel policies: Endpoints, sessions, buffering, saturation response (waiting vs dropping), rate control" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_g a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.g" ;
    skos:definition "Multiplexing and demultiplexing many relatively slow I/O devices or parties; completion- based and scheduler-based techniques; async-await, select and polling APIs" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_h a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.h" ;
    skos:definition "Formalization and analysis of channel communication; for example, CSP" ;
    skos:broader cs2023:Topic/PDC-Communication_5 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Communication_5_h_i a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Communication 5.h.i" ;
    skos:definition "Applications of queuing theory to model and predict performance. j. Memory models: sequential and release/acquire consistency k. Memory management; including reclamation of shared data; reference counts and alternatives l. Bulk data placement and transfer; reducing message traffic and improving locality; overlapping data transfer and computation; impact of data layout such as array-of-structs vs struct-of-arrays m. Emulating shared memory: distributed shared memory, Remote Direct Memory Access (RDMA) n. Data store consistency: Atomicity, linearizability, transactionality, coherence, causal ordering, conflict resolution, eventual consistency, blockchains o. Faults, partitioning, and partial failures; voting; protocols such as Paxos and Raft. p. Design tradeoffs among consistency, availability, partition (fault) tolerance; impossibility of meeting all at once q. Security and trust: Byzantine failures, proof of work and alternatives" ;
    skos:broader cs2023:Topic/PDC-Communication_5_h ;
    skos:altLabel "KA Core" .

cs2023:KU/PDC-Coordination a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "PDC-Coordination" ;
    skos:prefLabel "Coordination" .

cs2023:Topic/PDC-Coordination_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 1" ;
    skos:definition "Dependencies" ;
    skos:broader cs2023:KU/PDC-Coordination ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_1_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 1.a" ;
    skos:definition "Initiation or progress of one activity may be dependent on other activities, so as to avoid race conditions, ensure termination, or meet other requirements" ;
    skos:broader cs2023:Topic/PDC-Coordination_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_1_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 1.b" ;
    skos:definition "Ensuring progress by avoiding dependency cycles, using monotonic conditions, removing inessential dependencies" ;
    skos:broader cs2023:Topic/PDC-Coordination_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 2" ;
    skos:definition "Control constructs and design patterns" ;
    skos:broader cs2023:KU/PDC-Coordination ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_2_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 2.a" ;
    skos:definition "Completion-based: Barriers, joins, including termination control" ;
    skos:broader cs2023:Topic/PDC-Coordination_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_2_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 2.b" ;
    skos:definition "Data-enabled: Queues, producer-consumer designs" ;
