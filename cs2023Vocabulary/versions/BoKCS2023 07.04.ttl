    skos:definition "Incident handling processes" ;
    skos:broader cs2023:KU/SEC-Forensics ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Forensics_6 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Forensics 6" ;
    skos:definition "Rules of evidence general concepts and differences between jurisdictions (See also: SEP- Security)" ;
    skos:broader cs2023:KU/SEC-Forensics ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Forensics_7 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Forensics 7" ;
    skos:definition "Legal issues: digital evidence protection and management, chains of custody, reporting, serving as an expert witness (See also: SEP-Security)" ;
