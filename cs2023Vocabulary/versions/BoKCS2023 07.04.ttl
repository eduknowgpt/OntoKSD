    skos:altLabel "CS Core" .

cs2023:Topic/OS-Principles_5_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Principles 5.a" ;
    skos:definition "Applications cannot arbitrarily access memory locations or file storage device addresses." ;
    skos:broader cs2023:Topic/OS-Principles_5 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Principles_5_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Principles 5.b" ;
    skos:definition "Protection of coprocessors and network devices" ;
