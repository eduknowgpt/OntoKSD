    skos:definition "Distributed locking: reliability" ;
    skos:broader cs2023:Topic/PDC-Coordination_4 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Coordination_4_h a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 4.h" ;
