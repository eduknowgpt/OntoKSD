    skos:altLabel "CS Core" .

cs2023:Topic/OS-Principles_6_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Principles 6.a" ;
    skos:definition "Timer interrupts for implementing time slices" ;
    skos:broader cs2023:Topic/OS-Principles_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Principles_6_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Principles 6.b" ;
    skos:definition "I/O interrupts for putting blocking threads to sleep without polling" ;
    skos:broader cs2023:Topic/OS-Principles_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Principles_7 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Principles 7" ;
    skos:definition "Concept of user/system state and protection, transition to kernel mode using system calls (See also: AR-Assembly)" ;
    skos:broader cs2023:KU/OS-Principles ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Principles_8 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Principles 8" ;
    skos:definition "Mechanism for invoking system calls, the corresponding mode and context switch and return from interrupt (See also: AR-Assembly)" ;
    skos:broader cs2023:KU/OS-Principles ;
    skos:altLabel "CS Core" .

