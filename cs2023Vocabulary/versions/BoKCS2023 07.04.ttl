    skos:definition "One of more of the following algorithmic domains. (See also: AL-Strategies):" ;
    skos:broader cs2023:KU/PDC-Algorithms ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Algorithms_3_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Algorithms 3.a" ;
    skos:definition "Linear algebra: Vector and matrix operations, numerical precision/stability, applications in data analytics and machine learning." ;
    skos:broader cs2023:Topic/PDC-Algorithms_3 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Algorithms_3_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Algorithms 3.b" ;
    skos:definition "Data processing: sorting, searching and retrieval, concurrent data structures." ;
    skos:broader cs2023:Topic/PDC-Algorithms_3 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Algorithms_3_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Algorithms 3.c" ;
    skos:definition "Graphs, search, and combinatorics: Marking, edge-parallelization, bounding, speculation, network-based analytics." ;
    skos:broader cs2023:Topic/PDC-Algorithms_3 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Algorithms_3_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Algorithms 3.d" ;
    skos:definition "Modeling and simulation: differential equations; randomization, N-body problems, genetic algorithms." ;
    skos:broader cs2023:Topic/PDC-Algorithms_3 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Algorithms_3_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Algorithms 3.e" ;
    skos:definition "Computational logic: satisfiability (SAT), concurrent logic programming." ;
    skos:broader cs2023:Topic/PDC-Algorithms_3 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Algorithms_3_f a cs2023:Topic,  ontoksd:Knowledge ;
