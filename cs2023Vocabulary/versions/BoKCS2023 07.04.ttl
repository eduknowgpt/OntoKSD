cs2023:Topic/PDC-Coordination_4_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 4.a" ;
    skos:definition "Progress properties including lock-free, wait-free, fairness, priority scheduling, interactions with consistency, reliability" ;
    skos:broader cs2023:Topic/PDC-Coordination_4 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Coordination_4_b a cs2023:Topic,  ontoksd:Knowledge ;
