    skos:definition "Using locks in a specific language; maintaining liveness without introducing races" ;
    skos:broader cs2023:Topic/PDC-Coordination_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_3_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 3.d" ;
    skos:definition "Deadlock avoidance: Ordering, coarsening, randomized retries; backoffs, encapsulation via lock managers" ;
