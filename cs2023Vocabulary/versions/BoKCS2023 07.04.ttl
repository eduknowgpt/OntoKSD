    skos:definition "Non-blocking data structures and algorithms" ;
    skos:broader cs2023:Topic/PDC-Coordination_4 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Coordination_4_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 4.d" ;
    skos:definition "Ownership and resource control" ;
    skos:broader cs2023:Topic/PDC-Coordination_4 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Coordination_4_e a cs2023:Topic,  ontoksd:Knowledge ;
