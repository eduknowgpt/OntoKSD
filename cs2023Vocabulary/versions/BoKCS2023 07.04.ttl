cs2023:Topic/SEP-Professional-Ethics_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Professional-Ethics 3" ;
    skos:definition "Keeping up to date as a computing professional in terms of familiarity, tools, skills, legal and professional frameworks as well as the ability and responsibility to self-assess and progress in the computing field" ;
    skos:broader cs2023:KU/SEP-Professional-Ethics ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Professional-Ethics_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Professional-Ethics 4" ;
