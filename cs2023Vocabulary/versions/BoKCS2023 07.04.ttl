    skos:notation "cs2023:Topic/SEC-Crypto 10" ;
    skos:definition "Public-key cryptosystems: Diffie-Hellman and RSA (See also: MSF-Discrete)" ;
    skos:broader cs2023:KU/SEC-Crypto ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Crypto_11 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Crypto 11" ;
    skos:definition "Data integrity and authentication: hashing, and digital signatures (See also: MSF-Discrete, DM- Security)" ;
    skos:broader cs2023:KU/SEC-Crypto ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Crypto_12 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Crypto 12" ;
    skos:definition "Cryptographic protocols: challenge-response authentication, zero-knowledge protocols, commitment, oblivious transfer, secure two- or multi-party computation, hash functions, secret sharing, and applications (See also: MSF-Discrete)" ;
    skos:broader cs2023:KU/SEC-Crypto ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Crypto_13 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Crypto 13" ;
    skos:definition "Attacker capabilities: chosen-message attack (for signatures), birthday attacks, side channel attacks, and fault injection attacks (See also: NC-Security)" ;
    skos:broader cs2023:KU/SEC-Crypto ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Crypto_14 a cs2023:Topic,  ontoksd:Knowledge ;
