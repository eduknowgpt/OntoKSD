cs2023:Topic/SE-Construction_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 1" ;
    skos:definition "Practical small-scale testing (See also: SDF-Practices)" ;
    skos:broader cs2023:KU/SE-Construction ;
    skos:altLabel "CS Core" .

cs2023:Topic/SE-Construction_1_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 1.a" ;
    skos:definition "Unit testing" ;
    skos:broader cs2023:Topic/SE-Construction_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/SE-Construction_1_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 1.b" ;
    skos:definition "Test-driven development This is particularly valuable for students psychologically, as it is far easier to engage constructively with the challenge of identifying challenging inputs for a given API (edge cases, corner cases) a priori. If they implement first, the instinct is often to avoid trying to crash their new creation, while a test-first approach gives them the intellectual satisfaction of spotting the problem cases and then watching as more tests pass during the development process." ;
    skos:broader cs2023:Topic/SE-Construction_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/SE-Construction_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 2" ;
    skos:definition "Documentation (See also: SDF-Practices)" ;
    skos:broader cs2023:KU/SE-Construction ;
    skos:altLabel "CS Core" .

cs2023:Topic/SE-Construction_2_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 2.a" ;
    skos:definition "Interface documentation describe interface requirements, potentially including (formal or informal) contracts, pre and post conditions, invariants." ;
    skos:broader cs2023:Topic/SE-Construction_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/SE-Construction_2_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 2.b" ;
    skos:definition "Implementation documentation should focus on tricky and non-obvious pieces of code, whether because the code is using advanced language features, or the behavior of the code is complex. (Do not add comments that re-state common/obvious operations and simple language features.)" ;
    skos:broader cs2023:Topic/SE-Construction_2 ;
    skos:altLabel "CS Core" .

cs2023:Topic/SE-Construction_2_b_i a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 2.b.i" ;
    skos:definition "Clarify dataflow, computation, etc., focusing on what the code is." ;
    skos:broader cs2023:Topic/SE-Construction_2_b ;
    skos:altLabel "CS Core" .

cs2023:Topic/SE-Construction_2_b_ii a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SE-Construction 2.b.ii" ;
    skos:definition "Identify subtle/tricky pieces of code and refactor to be self-explanatory if possible or provide appropriate comments to clarify." ;
    skos:broader cs2023:Topic/SE-Construction_2_b ;
    skos:altLabel "CS Core" .

