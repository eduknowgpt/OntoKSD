    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_3_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 3.e" ;
    skos:definition "Common errors: Failing to lock or unlock when necessary, holding locks while invoking unknown operations" ;
