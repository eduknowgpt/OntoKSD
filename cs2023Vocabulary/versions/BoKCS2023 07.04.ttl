    skos:definition "Atomicity" ;
    skos:broader cs2023:KU/PDC-Coordination ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_3_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 3.a" ;
    skos:definition "Atomic instructions, enforced local access orderings" ;
    skos:broader cs2023:Topic/PDC-Coordination_3 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Coordination_3_b a cs2023:Topic,  ontoksd:Knowledge ;
