    skos:notation "cs2023:Topic/PDC-Algorithms 1.b" ;
    skos:definition "Using channel, socket, and/or RPC APIs in a given language, with program control for sending (usually procedural) vs receiving. (usually reactive or RPC-based)." ;
    skos:broader cs2023:Topic/PDC-Algorithms_1 ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Algorithms_1_c a cs2023:Topic,  ontoksd:Knowledge ;
