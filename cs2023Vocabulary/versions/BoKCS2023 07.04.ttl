    skos:broader cs2023:Topic/SPD-Game_1 ;
    skos:altLabel "KA Core" .

cs2023:Topic/SPD-Game_1_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SPD-Game 1.e" ;
