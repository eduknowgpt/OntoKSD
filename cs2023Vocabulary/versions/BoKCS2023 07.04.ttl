cs2023:KU/SEP-Sustainability a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "SEP-Sustainability" ;
    skos:prefLabel "Sustainability" .

cs2023:Topic/SEP-Sustainability_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Sustainability 1" ;
    skos:definition "Environmental, social, and cultural impacts of implementation decisions (e.g., sustainability goals, algorithmic bias/outcomes, economic viability, and resource consumption)" ;
    skos:broader cs2023:KU/SEP-Sustainability ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Sustainability_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Sustainability 2" ;
    skos:definition "Local/regional/global social and environmental impacts of computing systems and their use (e.g., carbon footprints, resource usage, e-waste) due to hardware (e.g., e-waste, data centers, rare element and resource utilization, recycling) and software (e.g., cloud-based services, blockchain, AI model training and use). This includes everyday use of hardware (cheap hardware replaced frequently) and software (web-browsing, email, and other services with hidden/remote computational demands)." ;
    skos:broader cs2023:KU/SEP-Sustainability ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Sustainability_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Sustainability 3" ;
    skos:definition "Guidelines for sustainable design standards." ;
    skos:broader cs2023:KU/SEP-Sustainability ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Sustainability_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Sustainability 4" ;
    skos:definition "Systemic effects of complex computing technologies and phenomena (e.g., generative AI, data centers, social media, offshoring, remote work)." ;
    skos:broader cs2023:KU/SEP-Sustainability ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-Sustainability_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Sustainability 5" ;
    skos:definition "Pervasive computing: Information processing that has been integrated into everyday objects and activities, such as smart energy systems, social networking, and feedback systems to promote sustainable behavior, transportation, environmental monitoring, citizen science and activism." ;
    skos:broader cs2023:KU/SEP-Sustainability ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-Sustainability_6 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Sustainability 6" ;
    skos:definition "How the sustainability of software systems is interdependent with social systems, including the knowledge and skills of its users, organizational processes and policies, and its societal context (e.g., market forces, government policies)." ;
    skos:broader cs2023:KU/SEP-Sustainability ;
    skos:altLabel "KA Core" .

cs2023:KU/SEP-History a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "SEP-History" ;
    skos:prefLabel "Computing History" .

cs2023:Topic/SEP-History_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-History 1" ;
    skos:definition "The history of computing: hardware, software, and human/organizational." ;
    skos:broader cs2023:KU/SEP-History ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-History_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-History 2" ;
    skos:definition "The role of history in the present including within different social contexts, and the relevance of this history on the future." ;
    skos:broader cs2023:KU/SEP-History ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-History_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-History 3" ;
    skos:definition "Age I (Pre-digital): Ancient analog computing (Stonehenge, Antikythera mechanism, Salisbury Cathedral clock, etc.), human-calculated number tables, Euclid, Lovelace, Babbage, Gödel, Church, Turing, pre-electronic (electro-mechanical and mechanical) hardware" ;
    skos:broader cs2023:KU/SEP-History ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-History_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-History 4" ;
    skos:definition "Age II (Early modern computing): ENIAC, UNIVAC, Bombes (Bletchley Park and codebreakers), computer companies (e.g., IBM), mainframes, etc. 5." ;
    skos:broader cs2023:KU/SEP-History ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-History_6 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-History 6" ;
    skos:definition "Age IV (Internet): Networking, internet architecture, browsers and their evolution, standards, born- on-the-internet companies, and services (e.g., Google, Amazon, Microsoft, etc.), distributed computing" ;
    skos:broader cs2023:KU/SEP-History ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-History_7 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-History 7" ;
    skos:definition "Age V (Mobile & Cloud): Mobile computing and smartphones, cloud computing and models thereof (e.g., SaaS), remote servers, security and privacy, social media" ;
    skos:broader cs2023:KU/SEP-History ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-History_8 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-History 8" ;
    skos:definition "Age VI (AI): Decision making systems, recommender systems, generative AI and other machine learning driven tools and technologies" ;
    skos:broader cs2023:KU/SEP-History ;
    skos:altLabel "KA Core" .

