cs2023:KU/OS-Purpose a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "OS-Purpose" ;
    skos:prefLabel "Role and Purpose of Operating Systems" .

cs2023:Topic/OS-Purpose_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 1" ;
    skos:definition "Operating systems mediate between general purpose hardware and application-specific software." ;
    skos:broader cs2023:KU/OS-Purpose ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 2" ;
    skos:definition "Universal operating system functions (e.g., process, user and device interfaces, persistence of data)" ;
    skos:broader cs2023:KU/OS-Purpose ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 3" ;
    skos:definition "Extended and/or specialized operating system functions (e.g., embedded systems, server types such as file, web, multimedia, boot loaders and boot security)" ;
    skos:broader cs2023:KU/OS-Purpose ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 4" ;
    skos:definition "Design issues (e.g., efficiency, robustness, flexibility, portability, security, compatibility, power, safety, tradeoffs between error checking and performance, flexibility and performance, and security and performance) (See also: SEC-Engineering)" ;
    skos:broader cs2023:KU/OS-Purpose ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 5" ;
    skos:definition "Influences of security, networking, multimedia, parallel and distributed computing" ;
    skos:broader cs2023:KU/OS-Purpose ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_6 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 6" ;
    skos:definition "Overarching concern of security/protection: Neglecting to consider security at every layer creates an opportunity to inappropriately access resources. Example concepts:" ;
    skos:broader cs2023:KU/OS-Purpose ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_6_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 6.a" ;
    skos:definition "Unauthorized access to files on an unencrypted drive can be achieved by moving the media to another computer." ;
    skos:broader cs2023:Topic/OS-Purpose_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_6_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 6.b" ;
    skos:definition "Operating systems enforced security can be defeated by infiltrating the boot layer before the operating system is loaded." ;
    skos:broader cs2023:Topic/OS-Purpose_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_6_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 6.c" ;
    skos:definition "Process isolation can be subverted by inadequate authorization checking at API boundaries." ;
    skos:broader cs2023:Topic/OS-Purpose_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_6_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 6.d" ;
    skos:definition "Vulnerabilities in system firmware can provide attack vectors that bypass the operating system entirely." ;
    skos:broader cs2023:Topic/OS-Purpose_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_6_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 6.e" ;
    skos:definition "Improper isolation of virtual machine memory, computing, and hardware can expose the host system to attacks from guest systems." ;
    skos:broader cs2023:Topic/OS-Purpose_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_6_f a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 6.f" ;
    skos:definition "The operating system may need to mitigate exploitation of hardware and firmware vulnerabilities, leading to potential performance reductions (e.g., Spectre and Meltdown mitigations)." ;
    skos:broader cs2023:Topic/OS-Purpose_6 ;
    skos:altLabel "CS Core" .

cs2023:Topic/OS-Purpose_7 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Purpose 7" ;
    skos:definition "Exposure of operating systems functions in shells and systems programming. (See also: FPL- Scripting)" ;
    skos:broader cs2023:KU/OS-Purpose ;
    skos:altLabel "CS Core" .

