    skos:broader cs2023:Topic/PDC-Coordination_4 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Coordination_4_h_i a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Coordination 4.h.i" ;
    skos:definition "Speculation, selection, cancellation; observability and security consequences j. Resource control using semaphores and condition variables k. Control flow: Scheduling computations, series-parallel loops with (possibly elected) leaders, pipelines and streams, nested parallelism l. Exceptions and failures. Handlers, detection, timeouts, fault tolerance, voting" ;
    skos:broader cs2023:Topic/PDC-Coordination_4_h ;
    skos:altLabel "KA Core" .

cs2023:KU/PDC-Evaluation a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "PDC-Evaluation" ;
    skos:prefLabel "Evaluation" .

cs2023:Topic/PDC-Evaluation_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 2" ;
    skos:definition "Identifying, testing for, and repairing violations, including common forms of errors such as failure to ensure necessary ordering (race errors), atomicity (including check-then-act errors), and termination (livelock)" ;
    skos:broader cs2023:KU/PDC-Evaluation ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Evaluation_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 3" ;
    skos:definition "Performance requirements metrics for throughput, responsiveness, latency, availability, energy consumption, scalability, resource usage, communication costs, waiting and rate control, fairness; service level agreements (See also: SF-Performance)" ;
    skos:broader cs2023:KU/PDC-Evaluation ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Evaluation_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 4" ;
    skos:definition "Performance impact of design and implementation choices, including granularity, overhead, consensus costs, and energy consumption (See also: SEP-Sustainability)" ;
    skos:broader cs2023:KU/PDC-Evaluation ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Evaluation_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 5" ;
    skos:definition "Estimating scalability limitati also: SF-Evaluation)" ;
    skos:broader cs2023:KU/PDC-Evaluation ;
    skos:altLabel "CS Core" .

cs2023:Topic/PDC-Evaluation_6 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6" ;
    skos:definition "One or more of the following methods and tools:" ;
    skos:broader cs2023:KU/PDC-Evaluation ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.a" ;
    skos:definition "Extensions to formal sequential requirements such as linearizability" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.b" ;
    skos:definition "Protocol, session, and transactional specifications" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.c" ;
    skos:definition "Use of tools such as Unified Modelling Language (UML), Temporal Logic of Actions (TLA), program logics" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.d" ;
    skos:definition "Security analysis: safety and liveness in the presence of hostile or buggy behaviors by other parties; required properties of communication mechanisms (for example lack of cross-layer leakage), input screening, rate limiting (See also: SEC-Foundations)" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_e a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.e" ;
    skos:definition "Static analysis applied to correctness, throughput, latency, resources, energy (See also: SEP-Sustainability)" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_f a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.f" ;
    skos:definition "Directed Acyclic Graph (DAG) model analysis of algorithmic efficiency (work, span, critical paths)" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_g a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.g" ;
    skos:definition "Testing and debugging; tools such as race detectors, fuzzers, lock dependency checkers, unit/stress/torture tests, visualizations, continuous integration, continuous deployment, and test generators" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_h a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/PDC-Evaluation 6.h" ;
    skos:definition "Measuring and comparing throughput, overhead, waiting, contention, communication, data movement, locality, resource usage, behavior in the presence of excessive numbers of events, clients, or threads (See also: SF-Evaluation)" ;
    skos:broader cs2023:Topic/PDC-Evaluation_6 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Evaluation_6_h_i a cs2023:Topic,  ontoksd:Knowledge ;
