    skos:definition "Introduction to ethical frameworks (e.g., consequentialism such as utilitarianism, non- consequentialism such as duty, rights, or justice, agent-centered such as virtue or feminism, contractarianism, ethics of care) and their use for analyzing an ethical dilemma" ;
    skos:broader cs2023:KU/SEP-Ethical-Analysis ;
    skos:altLabel "KA Core" .

cs2023:KU/SEP-Professional-Ethics a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "SEP-Professional-Ethics" ;
    skos:prefLabel "Professional Ethics" .

cs2023:Topic/SEP-Professional-Ethics_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Professional-Ethics 1" ;
    skos:definition "Community values and the laws by which we live" ;
    skos:broader cs2023:KU/SEP-Professional-Ethics ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Professional-Ethics_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Professional-Ethics 2" ;
    skos:definition "The nature of being a professional including care, attention, discipline, fiduciary responsibility, and mentoring" ;
    skos:broader cs2023:KU/SEP-Professional-Ethics ;
