cs2023:KU/SEC-Engineering a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "SEC-Engineering" ;
    skos:prefLabel "Security Analysis, Design, and Engineering" .

cs2023:Topic/SEC-Engineering_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 1" ;
    skos:definition "Security engineering goals: building systems that remain dependable despite errors, accidents, or malicious adversaries (See also: SE-Construction, SE-Validation, SEP-Security)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEC-Engineering_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 2" ;
    skos:definition "Privacy engineering goals: building systems that design, implement, and deploy privacy features and controls (See also: SEP-Privacy)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEC-Engineering_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 3" ;
    skos:definition "Problem analysis and situational analysis to address system security (See also: SE-Validation)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEC-Engineering_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 4" ;
    skos:definition "Engineering tradeoff analysis based on time, cost, risk tolerance, risk acceptance, return on investment, and so on (See also: PDC-Evaluation, SE-Validation)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEC-Engineering_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 5" ;
    skos:definition "Security design and engineering, including functional requirements, security subsystems, information protection, security testing, security assessment, and evaluation (See also: PDC- Evaluation, SE-Requirements, SE-Validation)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Engineering_6 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 6" ;
    skos:definition "Security analysis, covering security requirements analysis; security controls analysis; threat analysis; and vulnerability analysis (See also: FPL-Analysis, PDC-Evaluation)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Engineering_7 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 7" ;
    skos:definition "Security attack domains and attack surfaces, e.g., communications and networking, hardware, physical, social engineering, software, and supply chain (See also: NC-Security)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Engineering_8 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 8" ;
    skos:definition "Security attack modes, techniques, and tactics, e.g., authentication abuse; brute force; buffer manipulation; code injection; content insertion; denial of service; eavesdropping; function bypass; impersonation; integrity attack; interception; phishing; protocol analysis; privilege abuse; spoofing; and traffic injection (See also: NC-Security, OS-Protection, SE-Validation)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Engineering_9 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 9" ;
    skos:definition "Attestation of software products with respect to their specification and adaptiveness (See also: SE- Requirements, SE-Validation)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Engineering_10 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 10" ;
    skos:definition "Design and development of cyber-physical systems" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEC-Engineering_11 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEC-Engineering 11" ;
    skos:definition "Considerations for trustworthy computing, e.g., tamper resistant packaging, trusted boot, trusted kernel, hardware root of trust, software signing and verification, hardware-based cryptography, virtualization, and containers (See also: SE-Construction, SE-Validation)" ;
    skos:broader cs2023:KU/SEC-Engineering ;
    skos:altLabel "KA Core" .

