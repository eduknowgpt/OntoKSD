    skos:definition "Performance with respect to contention, granularity, convoying, scaling" ;
    skos:broader cs2023:Topic/PDC-Coordination_4 ;
    skos:altLabel "KA Core" .

cs2023:Topic/PDC-Coordination_4_c a cs2023:Topic,  ontoksd:Knowledge ;
