cs2023:Topic/NC-Security_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/NC-Security 1" ;
    skos:definition "General intro about security (Threats, vulnerabilities, and countermeasures) (See also: SEP- Security, SEC-Foundations, SEC-Engineering)" ;
    skos:broader cs2023:KU/NC-Security ;
    skos:altLabel "KA Core" .

cs2023:Topic/NC-Security_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/NC-Security 2" ;
    skos:definition "Network specific threats and attack types (e.g., denial of service, spoofing, sniffing and traffic redirection, attacker-in-the-middle, message integrity attacks, routing attacks, ransomware, and traffic analysis) (See also: SEC-Foundations, SEC-Engineering)" ;
    skos:broader cs2023:KU/NC-Security ;
    skos:altLabel "KA Core" .

cs2023:Topic/NC-Security_3 a cs2023:Topic,  ontoksd:Knowledge ;
