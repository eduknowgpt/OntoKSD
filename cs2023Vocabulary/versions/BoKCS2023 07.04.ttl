    skos:altLabel "CS Core" .

cs2023:Topic/OS-Principles_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/OS-Principles 5" ;
    skos:definition "Protection of resources means protecting some machine instructions/functions (See also: AR- Assembly) Example concepts:" ;
