cs2023:Topic/SPD-Game_1_a a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SPD-Game 1.a" ;
    skos:definition "Evolution of Game Platforms (e.g., Brown Box to Metaverse and beyond; Improvement in Computing Architectures (CPU and GPU); Platform Convergence and Mobility)" ;
    skos:broader cs2023:Topic/SPD-Game_1 ;
    skos:altLabel "KA Core" .

cs2023:Topic/SPD-Game_1_b a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SPD-Game 1.b" ;
    skos:definition "Typical Game Platforms (e.g., Personal Computer; Home Console; Handheld Console; Arcade Machine; Interactive Television; Mobile Phone; Tablet; Integrated Head-Mounted Display; Immersive Installations and Simulators; Internet of Things enabled Devices; CAVE Systems; Web Browsers; Cloud-based Streaming Systems)" ;
    skos:broader cs2023:Topic/SPD-Game_1 ;
    skos:altLabel "KA Core" .

cs2023:Topic/SPD-Game_1_c a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SPD-Game 1.c" ;
    skos:definition "Characteristics and Constraints of Different Game Platforms (e.g., Features (local storage, internetworking, peripherals); Run-time performance (GPU/CPU frequency, number of cores); Chipsets (physics processing units, vector co-processors); Expansion Bandwidth (PCIe); Network throughput (Ethernet); Memory types and capacities (DDR/GDDR); Maximum stack depth; Power consumption; Thermal design; Endian)" ;
    skos:broader cs2023:Topic/SPD-Game_1 ;
    skos:altLabel "KA Core" .

cs2023:Topic/SPD-Game_1_d a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SPD-Game 1.d" ;
