cs2023:KU/SEP-Context a cs2023:KnowledgeUnit,  ontoksd:Knowledge ;
    skos:altLabel "SEP-Context" ;
    skos:prefLabel "Social Context" .

cs2023:Topic/SEP-Context_1 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 1" ;
    skos:definition "Social implications (e.g., political and cultural ideologies) in a hyper-networked world where the capabilities and impact of social media, artificial intelligence, and computing in general are rapidly evolving." ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Context_2 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 2" ;
    skos:definition "Impact of computing applications (e.g., social media, artificial intelligence applications) on individual well-being, and safety of all kinds (e.g., physical, emotional, economic)." ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Context_3 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 3" ;
    skos:definition "Consequences of involving computing technologies, particularly artificial intelligence, biometric technologies, and algorithmic decision-making systems, in civic life (e.g., facial recognition technology, biometric tags, resource distribution algorithms, policing software) and how human agency and oversight is crucial." ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Context_4 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 4" ;
    skos:definition "How deficits in diversity and accessibility in computing affect society and what steps can be taken to improve equity in computing." ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "CS Core" .

cs2023:Topic/SEP-Context_5 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 5" ;
    skos:definition "Growth and control of the internet, data, computing, and artificial intelligence" ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-Context_6 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 6" ;
    skos:definition "Often referred to as the digital divide, differences in access to digital technology resources and its resulting ramifications for gender, class, ethnicity, geography, and/or developing countries, including consideration of responsibility to those who might be less wealthy, under threat, or who would struggle to have their voices heard." ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-Context_7 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 7" ;
    skos:definition "Accessibility issues, including legal requirements such as Web Content Accessibility Guidelines (www.w3.org/TR/WCAG21)" ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "KA Core" .

cs2023:Topic/SEP-Context_8 a cs2023:Topic,  ontoksd:Knowledge ;
    skos:notation "cs2023:Topic/SEP-Context 8" ;
    skos:definition "Context-aware computing" ;
    skos:broader cs2023:KU/SEP-Context ;
    skos:altLabel "KA Core" .

