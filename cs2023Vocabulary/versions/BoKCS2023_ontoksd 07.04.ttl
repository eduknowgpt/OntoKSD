cs2023:Topic_OS_Purpose_6_b
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Operating systems enforced security can be defeated by infiltrating the boot layer before the operating system is loaded"@en ;
    skos:notation "OS-Purpose.6.b"^^xsd:string ;
    dcterms:identifier "OS-Purpose_6_b"^^xsd:string ;
