    skos:broader cs2023:KU_PDC_Programs ;
    cs2023:hasCoreStatus cs2023:CSCore .

cs2023:Topic_PDC_Programs_1_a
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Declarative parallelism: Determining which actions may, or must not, be performed in parallel, at the level of instructions, functions, closures, composite actions, sessions, tasks, and services is the main idea underlying PDC algorithms; failing to do so is the main source of errors"@en ;
    skos:notation "PDC-Programs.1.a"^^xsd:string ;
    dcterms:identifier "PDC-Programs_1_a"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_PDC_Programs_1 ;
    skos:definition "Declarative parallelism: Determining which actions may, or must not, be performed in parallel, at the level of instructions, functions, closures, composite actions, sessions, tasks, and services is the main idea underlying PDC algorithms; failing to do so is the main source of errors. (See also: PDC-Algorithms)"@en ;
    cs2023:hasCoreStatus cs2023:CSCore ;
    skos:related cs2023:KU_PDC_Algorithms .

cs2023:Topic_PDC_Programs_1_b
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Defining order: for example, using happens-before relations or series/parallel directed acyclic graphs representing programs"@en ;
    skos:notation "PDC-Programs.1.b"^^xsd:string ;
    dcterms:identifier "PDC-Programs_1_b"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_PDC_Programs_1 ;
    skos:definition "Defining order: for example, using happens-before relations or series/parallel directed acyclic graphs representing programs."@en ;
    cs2023:hasCoreStatus cs2023:CSCore .

cs2023:Topic_PDC_Programs_1_c
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Independence: determining when ordering does not matter, in terms of commutativity, dependencies, preconditions"@en ;
    skos:notation "PDC-Programs.1.c"^^xsd:string ;
    dcterms:identifier "PDC-Programs_1_c"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_PDC_Programs_1 ;
    skos:definition "Independence: determining when ordering does not matter, in terms of commutativity, dependencies, preconditions."@en ;
    cs2023:hasCoreStatus cs2023:CSCore .

cs2023:Topic_PDC_Programs_1_d
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Ensuring ordering among otherwise parallel actions when necessary, including locking, safe publication; and imposing communication sending a message happens before receiving it; conversely relaxing when unnecessary"@en ;
    skos:notation "PDC-Programs.1.d"^^xsd:string ;
    dcterms:identifier "PDC-Programs_1_d"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_PDC_Programs_1 ;
    skos:definition "Ensuring ordering among otherwise parallel actions when necessary, including locking, safe publication; and imposing communication sending a message happens before receiving it; conversely relaxing when unnecessary."@en ;
    cs2023:hasCoreStatus cs2023:CSCore .

