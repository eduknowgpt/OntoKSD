cs2023:Topic_OS_Purpose_6_a
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Unauthorized access to files on an unencrypted drive can be achieved by moving the media to another computer"@en ;
    skos:notation "OS-Purpose.6.a"^^xsd:string ;
    dcterms:identifier "OS-Purpose_6_a"^^xsd:string ;
