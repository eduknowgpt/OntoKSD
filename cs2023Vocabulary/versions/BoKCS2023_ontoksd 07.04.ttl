@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix ontoksd: <http://purl.org/ontoksd#> .
@prefix cs2023:  <http://purl.org/cs2023#> .

cs2023:BoKCS2023
    a owl:Ontology, skos:ConceptScheme ;
    dcterms:title "Body of Knowledge of CS2023"@en ;
    dcterms:source "Computer Science Curricula 2023 (CS2023)"@en ;
    dcterms:description "Refined SKOS-based representation of the CS2023 Body of Knowledge, with explicit Knowledge Areas, Knowledge Units, Topics, curricular status, and basic provenance annotations."@en ;
    skos:prefLabel "CS2023 Body of Knowledge"@en .

cs2023:CS2023Document
    a prov:Entity ;
    dcterms:title "Computer Science Curricula 2023"@en ;
    dcterms:source "ACM/IEEE-CS/AAAI Computer Science Curricula 2023"@en .

cs2023:KnowledgeElement
    a owl:Class ;
    rdfs:label "Knowledge Element"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A conceptual element of the CS2023 Body of Knowledge used to organize curriculum content at different levels of granularity."@en .

cs2023:KnowledgeArea
    a owl:Class ;
    rdfs:label "Knowledge Area"@en ;
    rdfs:subClassOf cs2023:KnowledgeElement ;
    skos:definition "A major thematic area of the CS2023 Body of Knowledge that groups related knowledge units."@en .

cs2023:KnowledgeUnit
    a owl:Class ;
    rdfs:label "Knowledge Unit"@en ;
    rdfs:subClassOf cs2023:KnowledgeElement ;
    skos:definition "A curricular unit within a Knowledge Area in the CS2023 Body of Knowledge."@en .

cs2023:Topic
    a owl:Class ;
    rdfs:label "Topic"@en ;
    rdfs:subClassOf cs2023:KnowledgeElement ;
    skos:definition "A topic or subtopic within a Knowledge Unit in the CS2023 Body of Knowledge."@en .

cs2023:hasCoreStatus
    a owl:ObjectProperty ;
    rdfs:label "has core status"@en ;
    rdfs:domain cs2023:Topic ;
    rdfs:range skos:Concept ;
    skos:definition "Associates a topic with its curricular status in CS2023, such as CS Core, KA Core, or Non-core."@en .

cs2023:inKnowledgeArea
    a owl:ObjectProperty ;
    rdfs:label "in knowledge area"@en ;
    rdfs:domain cs2023:KnowledgeUnit ;
    rdfs:range cs2023:KnowledgeArea ;
    skos:definition "Associates a Knowledge Unit with the Knowledge Area to which it belongs."@en .

cs2023:curationStatus
    a owl:DatatypeProperty ;
    rdfs:label "curation status"@en ;
    skos:definition "Indicates the curation status of an extracted CS2023 knowledge element."@en .

cs2023:CSCore
    a skos:Concept ;
    skos:prefLabel "CS Core"@en ;
    skos:inScheme cs2023:BoKCS2023 .

cs2023:KACore
    a skos:Concept ;
    skos:prefLabel "KA Core"@en ;
    skos:inScheme cs2023:BoKCS2023 .

cs2023:NonCore
    a skos:Concept ;
    skos:prefLabel "Non-core"@en ;
    skos:inScheme cs2023:BoKCS2023 .

cs2023:AI
    a cs2023:KnowledgeArea ;
    skos:prefLabel "Artificial Intelligence"@en ;
    skos:notation "AI"^^xsd:string ;
    dcterms:identifier "AI"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    skos:topConceptOf cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "curated"^^xsd:string .

