    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Process isolation can be subverted by inadequate authorization checking at API boundaries"@en ;
    skos:notation "OS-Purpose.6.c"^^xsd:string ;
