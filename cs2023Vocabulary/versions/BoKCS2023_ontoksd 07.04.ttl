cs2023:Topic_PDC_Programs_3_a
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Options that enable actions to be performed (eventually) at places range from hardwiring to configuration scripts; also establishing communication and resource management; these are expressed differently across languages and contexts, usually relying on automated provisioning and management by platforms"@en ;
    skos:notation "PDC-Programs.3.a"^^xsd:string ;
    dcterms:identifier "PDC-Programs_3_a"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_PDC_Programs_3 ;
    skos:definition "Options that enable actions to be performed (eventually) at places range from hardwiring to configuration scripts; also establishing communication and resource management; these are expressed differently across languages and contexts, usually relying on automated provisioning and management by platforms (See also: SF-Resources)"@en ;
    cs2023:hasCoreStatus cs2023:CSCore .

cs2023:Topic_PDC_Programs_3_b
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Procedural: Enabling multiple actions to start at a given program point; for example, starting new threads, possibly scoping, or otherwise organizing them in hierarchical groups"@en ;
    skos:notation "PDC-Programs.3.b"^^xsd:string ;
    dcterms:identifier "PDC-Programs_3_b"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_PDC_Programs_3 ;
    skos:definition "Procedural: Enabling multiple actions to start at a given program point; for example, starting new threads, possibly scoping, or otherwise organizing them in hierarchical groups"@en ;
    cs2023:hasCoreStatus cs2023:CSCore .

cs2023:Topic_PDC_Programs_3_c
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Reactive: Enabling upon an event by installing an event handler, with less control of when actions begin or end, and may apply even on uniprocessors"@en ;
    skos:notation "PDC-Programs.3.c"^^xsd:string ;
    dcterms:identifier "PDC-Programs_3_c"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_PDC_Programs_3 ;
    skos:definition "Reactive: Enabling upon an event by installing an event handler, with less control of when actions begin or end, and may apply even on uniprocessors"@en ;
    cs2023:hasCoreStatus cs2023:CSCore .

cs2023:Topic_PDC_Programs_3_d
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Dependent: Enabling upon completion of others; for example, sequencing sets of parallel actions"@en ;
    skos:notation "PDC-Programs.3.d"^^xsd:string ;
    dcterms:identifier "PDC-Programs_3_d"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
