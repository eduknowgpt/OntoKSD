cs2023:Topic_PDC_Programs_1
    a cs2023:Topic, cs2023:KnowledgeElement, skos:Concept, ontoksd:Knowledge ;
    skos:prefLabel "Parallelism"@en ;
    skos:notation "PDC-Programs.1"^^xsd:string ;
    dcterms:identifier "PDC-Programs_1"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    prov:wasDerivedFrom cs2023:CS2023Document ;
