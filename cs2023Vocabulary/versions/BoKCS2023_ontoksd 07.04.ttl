    cs2023:curationStatus "semi-curated"^^xsd:string ;
    skos:broader cs2023:Topic_OS_Purpose_6 ;
    skos:definition "Operating systems enforced security can be defeated by infiltrating the boot layer before the operating system is loaded."@en ;
    cs2023:hasCoreStatus cs2023:CSCore .

