@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cs2023:  <http://purl.org/cs2023#> .

cs2023:BoKCS2023
    a skos:ConceptScheme ;
    dcterms:title "Body of Knowledge of CS2023"@en ;
    dcterms:source "Computer Science Curricula 2023 (CS2023)"@en ;
    dcterms:description "Concept scheme for the CS2023 Body of Knowledge, including its Knowledge Areas and intended hierarchical organization."@en ;
    skos:prefLabel "CS2023 Body of Knowledge"@en .

cs2023:KnowledgeElement
    a owl:Class ;
    rdfs:label "Knowledge Element"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A conceptual element of the CS2023 Body of Knowledge used to organize curriculum content at different levels of granularity."@en .

cs2023:KnowledgeArea
    a owl:Class ;
    rdfs:label "Knowledge Area"@en ;
    rdfs:subClassOf cs2023:KnowledgeElement ;
    skos:definition "A major thematic area of the CS2023 Body of Knowledge that groups related knowledge units."@en .

cs2023:AI
    a cs2023:KnowledgeArea ;
    skos:prefLabel "Artificial Intelligence"@en ;
    skos:notation "AI"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    skos:topConceptOf cs2023:BoKCS2023 .

cs2023:AL
    a cs2023:KnowledgeArea ;
    skos:prefLabel "Algorithmic Foundations"@en ;
    skos:notation "AL"^^xsd:string ;
    skos:inScheme cs2023:BoKCS2023 ;
    skos:topConceptOf cs2023:BoKCS2023 .

