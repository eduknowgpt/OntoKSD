cs2023:BoKCS2023
    skos:hasTopConcept
        cs2023:AI,
        cs2023:AL,
        cs2023:AR,
        cs2023:DM,
        cs2023:FPL,
        cs2023:GIT,
        cs2023:HCI,
        cs2023:MSF,
        cs2023:NC,
        cs2023:OS,
        cs2023:PDC,
        cs2023:SDF,
        cs2023:SE,
        cs2023:SEC,
        cs2023:SEP,
        cs2023:SF,
        cs2023:SPD .
