@prefix : <http://purl.org/ontoksd/rcd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rcd: <http://purl.org/ontoksd/rcd#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://purl.org/ontoksd/rcd> .

<http://purl.org/ontoksd/rcd> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://purl.org/ontoksd/rcd#hasDefinition
rcd:hasDefinition rdf:type owl:ObjectProperty ;
                  rdfs:domain rcd:RCD ;
                  rdfs:range rcd:Definition .


###  http://purl.org/ontoksd/rcd#hasIdentifier
rcd:hasIdentifier rdf:type owl:ObjectProperty ;
                  rdfs:domain rcd:RCD ;
                  rdfs:range rcd:LongIdentifier .


###  http://purl.org/ontoksd/rcd#hasMetadata
rcd:hasMetadata rdf:type owl:ObjectProperty ;
                rdfs:domain rcd:RCD ;
                rdfs:range rcd:Metadata .


###  http://purl.org/ontoksd/rcd#hasStatement
rcd:hasStatement rdf:type owl:ObjectProperty ;
                 rdfs:domain rcd:Definition ;
                 rdfs:range rcd:Statement .


###  http://purl.org/ontoksd/rcd#hasStatementID
rcd:hasStatementID rdf:type owl:ObjectProperty ;
                   rdfs:domain rcd:Statement ;
                   rdfs:range rcd:LongIdentifier .


###  http://purl.org/ontoksd/rcd#hasStatementToken
rcd:hasStatementToken rdf:type owl:ObjectProperty ;
                      rdfs:domain rcd:Statement ;
                      rdfs:range rcd:Vocabulary .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/ontoksd/rcd#additionalMetadata
rcd:additionalMetadata rdf:type owl:DatatypeProperty ;
                       rdfs:domain rcd:Metadata ;
                       rdfs:range xsd:anyURI .


###  http://purl.org/ontoksd/rcd#catalog
rcd:catalog rdf:type owl:DatatypeProperty ;
            rdfs:domain rcd:LongIdentifier ;
            rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#entry
rcd:entry rdf:type owl:DatatypeProperty ;
          rdfs:domain rcd:LongIdentifier ;
          rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#modelSource
rcd:modelSource rdf:type owl:DatatypeProperty ;
                rdfs:domain rcd:Definition ;
                rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#rcdSchema
rcd:rcdSchema rdf:type owl:DatatypeProperty ;
              rdfs:domain rcd:Metadata ;
              rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#rcdSchemaVersion
rcd:rcdSchemaVersion rdf:type owl:DatatypeProperty ;
                     rdfs:domain rcd:Metadata ;
                     rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#statementName
rcd:statementName rdf:type owl:DatatypeProperty ;
                  rdfs:domain rcd:Statement ;
                  rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#statementText
rcd:statementText rdf:type owl:DatatypeProperty ;
                  rdfs:domain rcd:Statement ;
                  rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#vocabularySource
rcd:vocabularySource rdf:type owl:DatatypeProperty ;
                     rdfs:domain rcd:Vocabulary ;
                     rdfs:range xsd:string .


###  http://purl.org/ontoksd/rcd#vocabularyValue
rcd:vocabularyValue rdf:type owl:DatatypeProperty ;
                    rdfs:domain rcd:Vocabulary ;
                    rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://purl.org/ontoksd/rcd#Definition
rcd:Definition rdf:type owl:Class .


###  http://purl.org/ontoksd/rcd#LongIdentifier
rcd:LongIdentifier rdf:type owl:Class .


###  http://purl.org/ontoksd/rcd#Metadata
rcd:Metadata rdf:type owl:Class .


###  http://purl.org/ontoksd/rcd#RCD
rcd:RCD rdf:type owl:Class .


###  http://purl.org/ontoksd/rcd#Statement
rcd:Statement rdf:type owl:Class .


###  http://purl.org/ontoksd/rcd#Vocabulary
rcd:Vocabulary rdf:type owl:Class .


