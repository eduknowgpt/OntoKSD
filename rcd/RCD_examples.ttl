ex:RCD_Invalid_03 a rcd:RCD ;
    rcd:title "Explain stack operations"@en ;
    rcd:hasIdentifier ex:ID_RCD_Invalid_03 ;
    rcd:hasDefinition ex:DEF_RCD_Invalid_03 .

ex:ID_RCD_Invalid_03 a rcd:LongIdentifier ;
    rcd:catalog "urn:uuid" ;
    rcd:entry "f8e66f7c-b3ef-445a-b611-f3a294ca3003" .

ex:DEF_RCD_Invalid_03 a rcd:Definition .

# Empty statement from the SHACL point of view
ex:RCD_Invalid_04 a rcd:RCD ;
    rcd:title "Use recursion to solve problems"@en ;
    rcd:hasIdentifier ex:ID_RCD_Invalid_04 ;
    rcd:hasDefinition ex:DEF_RCD_Invalid_04 .

ex:ID_RCD_Invalid_04 a rcd:LongIdentifier ;
    rcd:catalog "urn:uuid" ;
    rcd:entry "a9d7f5ea-b7ff-4980-9e54-38d0db580004" .

ex:DEF_RCD_Invalid_04 a rcd:Definition ;
    rcd:hasStatement ex:STMT_RCD_Invalid_04 .

ex:STMT_RCD_Invalid_04 a rcd:Statement .

# Vocabulary missing source
ex:RCD_Invalid_05 a rcd:RCD ;
    rcd:title "Apply normalization rules in databases"@en ;
    rcd:hasIdentifier ex:ID_RCD_Invalid_05 ;
    rcd:hasDefinition ex:DEF_RCD_Invalid_05 .

ex:ID_RCD_Invalid_05 a rcd:LongIdentifier ;
    rcd:catalog "urn:uuid" ;
    rcd:entry "b5ea2614-2c1f-4717-a1fc-5d5d66385005" .

ex:DEF_RCD_Invalid_05 a rcd:Definition ;
    rcd:hasStatement ex:STMT_RCD_Invalid_05 .

ex:STMT_RCD_Invalid_05 a rcd:Statement ;
    rcd:statementName "criterion" ;
    rcd:hasStatementToken ex:VOC_RCD_Invalid_05 .

ex:VOC_RCD_Invalid_05 a rcd:Vocabulary ;
