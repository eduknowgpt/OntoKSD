@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://purl.org/ontoksd/rcd/examples#> .
@prefix ontoksd: <http://purl.org/ontoksd#> .
@prefix rcd: <http://purl.org/ontoksd/rcd#> .

ex:RCD_Valid_01 a rcd:RCD ;
    rcd:description "Ability to construct a DFA that recognizes a formally specified regular language."@en ;
    rcd:hasDefinition ex:DEF_RCD_Valid_01 ;
    rcd:hasIdentifier ex:ID_RCD_Valid_01 ;
    rcd:hasMetadata ex:META_RCD_Valid_01 ;
    rcd:title "Design deterministic finite automata"@en,
        "Projetar autômatos finitos determinísticos"@pt-BR .

ex:RCD_Valid_02 a rcd:RCD ;
    rcd:hasIdentifier ex:ID_RCD_Valid_02 ;
    rcd:title "Explain finite-state recognition"@en .

ex:RCD_Valid_04 a rcd:RCD ;
    rcd:hasDefinition ex:DEF_RCD_Valid_04 ;
    rcd:hasIdentifier ex:ID_RCD_Valid_04 ;
    rcd:title "Classify regular languages"@en .

ex:Competence_DFADesign a ontoksd:Competence ;
    dcterms:title "Design deterministic finite automata"@en ;
    ontoksd:hasRCD ex:RCD_Valid_03 .

ex:DEF_RCD_Valid_01 a rcd:Definition ;
    rcd:hasStatement ex:STMT_RCD_Valid_01_A,
        ex:STMT_RCD_Valid_01_B ;
    rcd:modelSource "http://example.org/models/ksd" .

ex:DEF_RCD_Valid_04 a rcd:Definition ;
    rcd:hasStatement ex:STMT_RCD_Valid_04 .

ex:ID_RCD_Valid_01 a rcd:LongIdentifier ;
    rcd:catalog "urn:uuid" ;
    rcd:entry "f3f83a0b-0f70-4f23-a2dc-0a4d8d0d1001" .

ex:ID_RCD_Valid_02 a rcd:LongIdentifier ;
    rcd:catalog "URI" ;
    rcd:entry "https://example.org/rcd/minimal-dfa" .

ex:ID_RCD_Valid_03 a rcd:LongIdentifier ;
    rcd:catalog "URI" ;
    rcd:entry "https://example.org/rcd/dfa-design" .

ex:ID_RCD_Valid_04 a rcd:LongIdentifier ;
    rcd:catalog "URI" ;
    rcd:entry "https://example.org/rcd/regular-language-classification" .

ex:META_RCD_Valid_01 a rcd:Metadata ;
    rcd:additionalMetadata "Example metadata literal for testing." ;
    rcd:rcdSchema "OntoKSD RCD RDF/OWL Profile" ;
    rcd:rcdSchemaVersion "1.0" .

ex:RCD_Valid_03 a ontoksd:OntoKSDRCD,
        rcd:RCD ;
    ontoksd:representsCompetence ex:Competence_DFADesign ;
    rcd:hasIdentifier ex:ID_RCD_Valid_03 ;
    rcd:title "Design deterministic finite automata"@en .

ex:STMT_RCD_Valid_01_A a rcd:Statement ;
    rcd:statementName "performance" ;
    rcd:statementText "Construct a deterministic finite automaton for a target regular language."@en .

ex:STMT_RCD_Valid_01_B a rcd:Statement ;
    rcd:hasStatementToken ex:VOC_RCD_Valid_01_B ;
    rcd:statementName "criterion" ;
    rcd:statementText "The automaton correctly accepts all strings in the language and rejects those outside it."@en .

ex:STMT_RCD_Valid_04 a rcd:Statement ;
    rcd:statementName "scope" .

ex:VOC_RCD_Valid_01_B a rcd:Vocabulary ;
    rcd:vocabularySource "http://example.org/vocab/criterion" ;
    rcd:vocabularyValue "correctness" .

