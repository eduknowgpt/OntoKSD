# CQ1: Which direct constituents specify the selected competence, including explicit K/S/D and KnowledgeSkill pairings?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: The knowledge/level columns describe a pairing when present; do not multiply pairings by dispositions.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.
# Parameter: replace ontoksd:C02 in VALUES with the intended competence IRI.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?constituent ?constituentLabel ?constituentType ?knowledge ?skillLevel
WHERE {
VALUES ?competence { ontoksd:C02 }
?competence (ontoksd:hasCompetenceConstituent|ontoksd:hasKnowledge|ontoksd:hasSkill|ontoksd:hasDisposition|ontoksd:hasAttitude|ontoksd:hasKnowledgeSkill|^ontoksd:isCompetenceConstituentOf|^ontoksd:isKnowledgeOf|^ontoksd:isSkillOf|^ontoksd:isDispositionOf|^ontoksd:isAttitudeOf|^ontoksd:isKnowledgeSkillOf) ?constituent .
BIND(IF(EXISTS { ?constituent a ontoksd:Attitude }, ontoksd:Attitude,
 IF(EXISTS { ?constituent a ontoksd:KnowledgeSkill }, ontoksd:KnowledgeSkill,
 IF(EXISTS { ?constituent a ontoksd:Knowledge }, ontoksd:Knowledge,
 IF(EXISTS { ?constituent a ontoksd:Skill }, ontoksd:Skill,
 IF(EXISTS { ?constituent a ontoksd:Disposition }, ontoksd:Disposition, ontoksd:CompetenceConstituent))))) AS ?constituentType)
OPTIONAL { ?constituent ontoksd:hasKnowledgeComponent ?knowledge . }
OPTIONAL { ?constituent ontoksd:hasSkillLevel ?skillLevel . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?constituent (rdfs:label|skos:prefLabel|dcterms:title) ?constituentLabel . }
}
ORDER BY ?competence ?competenceLabel ?constituentLabel
