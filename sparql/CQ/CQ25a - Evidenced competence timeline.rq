# CQ25a: Which dated whole-competence judgments are recorded for profiles and competences?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: A chronological record is not proof of learning progress; undated judgments are outside this view.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?profile ?competence ?competenceLabel ?evidencedCompetence ?evidencedCompetenceLabel ?evidencedAt ?evidence
WHERE {
?evidencedCompetence a ontoksd:EvidencedCompetence ; ontoksd:refersToCompetence ?competence ; ontoksd:evidencedAt ?evidencedAt .
OPTIONAL { ?evidencedCompetence (ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile . }
OPTIONAL { ?evidencedCompetence (ontoksd:supportedByEvidence|^ontoksd:evidencesCompetence) ?evidence . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?evidencedCompetence (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedCompetenceLabel . }
}
ORDER BY ?profile ?competence ?evidencedAt ?evidencedCompetence
