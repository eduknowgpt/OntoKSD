# CQ39b: Optionally materialize learning-need candidates under the explicit comparison policy.
# Operation: UPDATE. Target: GraphDB / SPARQL 1.1.
# Scope: UPDATE: modifies data. Preview CQ39a first; execute only intentionally, preferably in a dedicated snapshot repository. Repeated execution is idempotent for the same basis. Previously created records are not automatically withdrawn after new evidence.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.
# Parameters: replace Profile_Example and Course_Example; no enrollment is inferred.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT {
 ?learningNeed a ontoksd:LearningNeed ; rdfs:label ?learningNeedLabel ;
  ontoksd:identifiedIn ?profile ; ontoksd:targetsCompetence ?competence ;
  dcterms:type "Rule-derived learning-need candidate" ;
  dcterms:references ?courseSpecification, ?evidencedCompetence, ?proficiencyScheme ;
  dcterms:relation ?course ;
  dcterms:description "Candidate produced by the documented latest-record, same-scheme comparison policy. Educational interpretation remains necessary; this is not a confirmed diagnosis."@en .
 ?profile ontoksd:hasLearningNeed ?learningNeed .
}
WHERE {
VALUES (?profile ?course) { (ontoksd:Profile_Example ontoksd:Course_Example) }
?profile a ontoksd:Profile .
?courseSpecification a ontoksd:CourseCompetenceSpecification ;
 ontoksd:mediatesCourse ?course ; ontoksd:mediatesCourseCompetence ?competence ;
 ontoksd:isMandatory true ; ontoksd:requiresMinimumProficiencyLevel ?requiredLevel ;
 dcterms:references ?proficiencyScheme .
?proficiencyScheme a ontoksd:ProficiencyScheme ; ontoksd:definesLevel ?requiredLevel .
?evidencedCompetence a ontoksd:EvidencedCompetence ; (ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile ; ontoksd:refersToCompetence ?competence ;
 ontoksd:hasProficiencyLevel ?evidencedLevel ; ontoksd:interpretedUsingScheme ?proficiencyScheme ; ontoksd:evidencedAt ?evidencedAt .
?proficiencyScheme ontoksd:definesLevel ?evidencedLevel .
?evidencedLevel ontoksd:hasOrdinalPosition ?evidencedOrdinal .
?requiredLevel ontoksd:hasOrdinalPosition ?requiredOrdinal .
BIND(NOW() AS ?asOf)
FILTER(?evidencedAt <= ?asOf)
FILTER NOT EXISTS { ?evidencedCompetence ontoksd:validUntil ?expired . FILTER(?expired <= ?asOf) }
# Comparison requires a unique scheme, level, timestamp and ordinal value.
FILTER NOT EXISTS { ?evidencedCompetence ontoksd:interpretedUsingScheme ?otherScheme . FILTER(?otherScheme != ?proficiencyScheme) }
FILTER NOT EXISTS { ?evidencedCompetence ontoksd:hasProficiencyLevel ?otherLevel . FILTER(?otherLevel != ?evidencedLevel) }
FILTER NOT EXISTS { ?evidencedCompetence ontoksd:evidencedAt ?otherTime . FILTER(?otherTime != ?evidencedAt) }
FILTER NOT EXISTS { ?courseSpecification dcterms:references ?otherRequiredScheme . ?otherRequiredScheme a ontoksd:ProficiencyScheme . FILTER(?otherRequiredScheme != ?proficiencyScheme) }
FILTER NOT EXISTS { ?courseSpecification ontoksd:requiresMinimumProficiencyLevel ?otherRequiredLevel . FILTER(?otherRequiredLevel != ?requiredLevel) }
FILTER NOT EXISTS { ?evidencedLevel ontoksd:hasOrdinalPosition ?otherOrdinal . FILTER(?otherOrdinal != ?evidencedOrdinal) }
FILTER NOT EXISTS { ?requiredLevel ontoksd:hasOrdinalPosition ?otherRequiredOrdinal . FILTER(?otherRequiredOrdinal != ?requiredOrdinal) }
# A newer, non-expired record blocks an older result, even if the newer record has no level.
FILTER NOT EXISTS {
 ?newer a ontoksd:EvidencedCompetence ; (ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile ; ontoksd:refersToCompetence ?competence ; ontoksd:interpretedUsingScheme ?proficiencyScheme ; ontoksd:evidencedAt ?newerTime .
 FILTER(?newerTime > ?evidencedAt && ?newerTime <= ?asOf)
 FILTER NOT EXISTS { ?newer ontoksd:validUntil ?newerExpiry . FILTER(?newerExpiry <= ?asOf) }
}
# Equal-date conflicting levels are ambiguous, not a reason to select the lower record.
FILTER NOT EXISTS {
 ?tied a ontoksd:EvidencedCompetence ; (ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile ; ontoksd:refersToCompetence ?competence ; ontoksd:interpretedUsingScheme ?proficiencyScheme ; ontoksd:evidencedAt ?evidencedAt ; ontoksd:hasProficiencyLevel ?tiedLevel .
 FILTER(?tiedLevel != ?evidencedLevel)
 FILTER NOT EXISTS { ?tied ontoksd:validUntil ?tiedExpiry . FILTER(?tiedExpiry <= ?asOf) }
}
FILTER(isNumeric(?evidencedOrdinal) && isNumeric(?requiredOrdinal))
# Ordinal positions must identify distinct categories unambiguously within this scheme.
FILTER NOT EXISTS { ?proficiencyScheme ontoksd:definesLevel ?sameCurrentRank . ?sameCurrentRank ontoksd:hasOrdinalPosition ?evidencedOrdinal . FILTER(?sameCurrentRank != ?evidencedLevel) }
FILTER NOT EXISTS { ?proficiencyScheme ontoksd:definesLevel ?sameRequiredRank . ?sameRequiredRank ontoksd:hasOrdinalPosition ?requiredOrdinal . FILTER(?sameRequiredRank != ?requiredLevel) }
FILTER(?evidencedOrdinal < ?requiredOrdinal)

BIND(IRI(CONCAT("http://purl.org/ontoksd#CQ_LearningNeed_", SHA256(CONCAT(
 STR(?profile), "|", STR(?courseSpecification), "|", STR(?evidencedCompetence), "|", STR(?proficiencyScheme), "|", STR(?requiredLevel)
)))) AS ?learningNeed)
FILTER NOT EXISTS { ?learningNeed a ontoksd:LearningNeed . }
BIND(CONCAT("Rule-derived learning-need candidate for ", STR(?competence)) AS ?learningNeedLabel)
}
