# CQ4: Which specification-pattern value is declared for each competence?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Pattern identifiers classify the adopted representation; constituent presence alone is insufficient.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?pattern ?patternLabel
WHERE {
?competence ontoksd:hasSpecificationPattern ?pattern .
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?pattern (rdfs:label|skos:prefLabel|dcterms:title) ?patternLabel . }
}
ORDER BY ?competence ?competenceLabel ?patternLabel
