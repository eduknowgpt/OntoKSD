# This query retrieves the SpecificationPattern used to describe a selected competence. It identifies the specification structure adopted by the competence, such as CC2020-based KnowledgeSkill patterns, CS2023 task-oriented patterns, or other supported competence specification models. Thus, the query demonstrates that OntoKSD can explicitly represent the modeling pattern underlying competence specifications.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT
  ?competence
  ?competenceLabel
  ?pattern
  ?patternLabel
WHERE {
   ?competence a ontoksd:Competence ;
              rdfs:label ?competenceLabel ;
              ontoksd:hasSpecificationPattern ?pattern .

  OPTIONAL { ?pattern rdfs:label ?patternRdfsLabel . }
  OPTIONAL { ?pattern skos:prefLabel ?patternSkosLabel . }

  BIND(
    COALESCE(
      ?patternRdfsLabel,
      ?patternSkosLabel,
      STR(?pattern)
    ) AS ?patternLabel
  )
}
ORDER BY ?patternLabel