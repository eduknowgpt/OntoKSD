# CQ40a: Which mandatory competences have no judgment record in the selected profile?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Absence of a record at any date in the queried dataset is a documentation/assessment gap, not proof of incompetence. A minimum level is optional.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.
# Parameters: replace Profile_Example and Course_Example; no enrollment is inferred.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?profile ?profileLabel ?course ?courseLabel ?courseSpecification ?competence ?competenceLabel ?requiredLevel
WHERE {
VALUES (?profile ?course) { (ontoksd:Profile_Example ontoksd:Course_Example) }
?profile a ontoksd:Profile .
?courseSpecification a ontoksd:CourseCompetenceSpecification ; ontoksd:mediatesCourse ?course ; ontoksd:mediatesCourseCompetence ?competence ; ontoksd:isMandatory true .
OPTIONAL { ?courseSpecification ontoksd:requiresMinimumProficiencyLevel ?requiredLevel . }
FILTER NOT EXISTS { ?judgment a ontoksd:EvidencedCompetence ; (ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile ; ontoksd:refersToCompetence ?competence . }
OPTIONAL { ?profile (rdfs:label|skos:prefLabel|dcterms:title) ?profileLabel . }
OPTIONAL { ?course (rdfs:label|skos:prefLabel|dcterms:title) ?courseLabel . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
}
ORDER BY ?profile ?profileLabel ?courseLabel ?competenceLabel
