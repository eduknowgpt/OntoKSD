# CQ40d: Under an explicitly enabled policy, which constituents fall below the whole-competence threshold?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Default result is empty by design. Setting the policy flag to true is an external analytical assumption, not an OntoKSD axiom; no constituent-specific curricular minimum exists in the current model.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.
# Parameters: default is the synthetic proficiency example (Profile_Learner_01, Course_FormalLanguages).
# Replace both IRIs for another case. The selection does not assert enrollment.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?profile ?profileLabel ?course ?courseLabel ?courseSpecification ?competence ?competenceLabel ?constituent ?constituentLabel ?evidencedConstituent ?evidencedAt ?proficiencyScheme ?evidencedLevel ?evidencedOrdinal ?requiredLevel ?requiredOrdinal
WHERE {
# Disabled by default: the ontology does not assign the competence threshold to every constituent.
VALUES ?applyWholeCompetenceThresholdToConstituents { false }
FILTER(?applyWholeCompetenceThresholdToConstituents = true)
VALUES (?profile ?course) { (ontoksd:Profile_Learner_01 ontoksd:Course_FormalLanguages) }
?profile a ontoksd:Profile .
?courseSpecification a ontoksd:CourseCompetenceSpecification ;
 ontoksd:hasSpecifiedCourse ?course ; ontoksd:hasSpecifiedCompetence ?competence ;
 ontoksd:isMandatory true ; ontoksd:requiresMinimumProficiencyLevel ?requiredLevel ;
 dcterms:references ?proficiencyScheme .
?proficiencyScheme a ontoksd:ProficiencyScheme ; ontoksd:definesLevel ?requiredLevel .
?competence (ontoksd:hasCompetenceConstituent|ontoksd:hasKnowledge|ontoksd:hasSkill|ontoksd:hasDisposition|ontoksd:hasAttitude|ontoksd:hasKnowledgeSkill|^ontoksd:isCompetenceConstituentOf|^ontoksd:isKnowledgeOf|^ontoksd:isSkillOf|^ontoksd:isDispositionOf|^ontoksd:isAttitudeOf|^ontoksd:isKnowledgeSkillOf) ?constituent .
?evidencedConstituent a ontoksd:EvidencedCompetenceConstituent ; ontoksd:derivedFromParticipation/(ontoksd:hasLearner|^ontoksd:participatesIn)/(ontoksd:hasProfile|^ontoksd:isProfileOf) ?profile ; ontoksd:refersToCompetenceConstituent ?constituent ;
 ontoksd:hasProficiencyLevel ?evidencedLevel ; ontoksd:interpretedUsingScheme ?proficiencyScheme ; ontoksd:evidencedAt ?evidencedAt .
?proficiencyScheme ontoksd:definesLevel ?evidencedLevel .
?evidencedLevel ontoksd:hasOrdinalPosition ?evidencedOrdinal .
?requiredLevel ontoksd:hasOrdinalPosition ?requiredOrdinal .
BIND(NOW() AS ?asOf)
FILTER(?evidencedAt <= ?asOf)
FILTER NOT EXISTS { ?evidencedConstituent ontoksd:validUntil ?expired . FILTER(?expired <= ?asOf) }
# Comparison requires a unique scheme, level, timestamp and ordinal value.
FILTER NOT EXISTS { ?evidencedConstituent ontoksd:interpretedUsingScheme ?otherScheme . FILTER(?otherScheme != ?proficiencyScheme) }
FILTER NOT EXISTS { ?evidencedConstituent ontoksd:hasProficiencyLevel ?otherLevel . FILTER(?otherLevel != ?evidencedLevel) }
FILTER NOT EXISTS { ?evidencedConstituent ontoksd:evidencedAt ?otherTime . FILTER(?otherTime != ?evidencedAt) }
FILTER NOT EXISTS { ?courseSpecification dcterms:references ?otherRequiredScheme . ?otherRequiredScheme a ontoksd:ProficiencyScheme . FILTER(?otherRequiredScheme != ?proficiencyScheme) }
FILTER NOT EXISTS { ?courseSpecification ontoksd:requiresMinimumProficiencyLevel ?otherRequiredLevel . FILTER(?otherRequiredLevel != ?requiredLevel) }
FILTER NOT EXISTS { ?evidencedLevel ontoksd:hasOrdinalPosition ?otherOrdinal . FILTER(?otherOrdinal != ?evidencedOrdinal) }
FILTER NOT EXISTS { ?requiredLevel ontoksd:hasOrdinalPosition ?otherRequiredOrdinal . FILTER(?otherRequiredOrdinal != ?requiredOrdinal) }
# A newer, non-expired record blocks an older result, even if the newer record has no level.
FILTER NOT EXISTS {
 ?newer a ontoksd:EvidencedCompetenceConstituent ; ontoksd:derivedFromParticipation/(ontoksd:hasLearner|^ontoksd:participatesIn)/(ontoksd:hasProfile|^ontoksd:isProfileOf) ?profile ; ontoksd:refersToCompetenceConstituent ?constituent ; ontoksd:interpretedUsingScheme ?proficiencyScheme ; ontoksd:evidencedAt ?newerTime .
 FILTER(?newerTime > ?evidencedAt && ?newerTime <= ?asOf)
 FILTER NOT EXISTS { ?newer ontoksd:validUntil ?newerExpiry . FILTER(?newerExpiry <= ?asOf) }
}
# Equal-date conflicting levels are ambiguous, not a reason to select the lower record.
FILTER NOT EXISTS {
 ?tied a ontoksd:EvidencedCompetenceConstituent ; ontoksd:derivedFromParticipation/(ontoksd:hasLearner|^ontoksd:participatesIn)/(ontoksd:hasProfile|^ontoksd:isProfileOf) ?profile ; ontoksd:refersToCompetenceConstituent ?constituent ; ontoksd:interpretedUsingScheme ?proficiencyScheme ; ontoksd:evidencedAt ?evidencedAt ; ontoksd:hasProficiencyLevel ?tiedLevel .
 FILTER(?tiedLevel != ?evidencedLevel)
 FILTER NOT EXISTS { ?tied ontoksd:validUntil ?tiedExpiry . FILTER(?tiedExpiry <= ?asOf) }
}
FILTER(isNumeric(?evidencedOrdinal) && isNumeric(?requiredOrdinal))
# Ordinal positions must identify distinct categories unambiguously within this scheme.
FILTER NOT EXISTS { ?proficiencyScheme ontoksd:definesLevel ?sameCurrentRank . ?sameCurrentRank ontoksd:hasOrdinalPosition ?evidencedOrdinal . FILTER(?sameCurrentRank != ?evidencedLevel) }
FILTER NOT EXISTS { ?proficiencyScheme ontoksd:definesLevel ?sameRequiredRank . ?sameRequiredRank ontoksd:hasOrdinalPosition ?requiredOrdinal . FILTER(?sameRequiredRank != ?requiredLevel) }
FILTER(?evidencedOrdinal < ?requiredOrdinal)
OPTIONAL { ?profile (rdfs:label|skos:prefLabel|dcterms:title) ?profileLabel . }
OPTIONAL { ?course (rdfs:label|skos:prefLabel|dcterms:title) ?courseLabel . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?constituent (rdfs:label|skos:prefLabel|dcterms:title) ?constituentLabel . }
}
ORDER BY ?profile ?profileLabel ?courseLabel ?competenceLabel ?constituentLabel
