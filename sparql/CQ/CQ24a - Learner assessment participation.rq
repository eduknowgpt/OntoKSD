# CQ24a: Which learner participates in which assessment occurrence, with which score and assessor?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: No score is taken directly from AssessmentOccurrence.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?learner ?learnerLabel ?assessmentParticipation ?assessmentParticipationLabel ?assessmentOccurrence ?assessmentOccurrenceLabel ?score ?assessor
WHERE {
?assessmentParticipation (ontoksd:hasLearner|^ontoksd:participatesIn) ?learner ;
 (ontoksd:occursInAssessmentOccurrence|^ontoksd:involvesAssessmentParticipation) ?assessmentOccurrence .
OPTIONAL { ?assessmentParticipation ontoksd:hasScore ?score . }
OPTIONAL { ?assessmentParticipation ontoksd:hasAssessor ?assessor . }
OPTIONAL { ?learner (rdfs:label|skos:prefLabel|dcterms:title) ?learnerLabel . }
OPTIONAL { ?assessmentParticipation (rdfs:label|skos:prefLabel|dcterms:title) ?assessmentParticipationLabel . }
OPTIONAL { ?assessmentOccurrence (rdfs:label|skos:prefLabel|dcterms:title) ?assessmentOccurrenceLabel . }
}
ORDER BY ?learner ?learnerLabel ?assessmentParticipationLabel ?assessmentOccurrenceLabel
