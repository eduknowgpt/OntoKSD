# CQ12: Which competences are explicitly positioned as instructional targets?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: A function is a planned instructional qualification, not proof of learner possession or attainment.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT
    ?instructionalUnit
    ?instructionalUnitLabel
    ?competence
    ?competenceLabel
    ?competenceActivation
WHERE {
    ?competenceActivation
        a ontoksd:CompetenceActivation ;
        ontoksd:hasActivationCompetence ?competence ;
        ontoksd:hasActivationFunction ontoksd:targetFunction ;
        (ontoksd:hasActivationInstructionalUnit |
         ^ontoksd:hasCompetenceActivation) ?instructionalUnit .

    OPTIONAL {
        ?instructionalUnit
            (rdfs:label | skos:prefLabel | dcterms:title)
            ?instructionalUnitLabel .
    }

    OPTIONAL {
        ?competence
            (rdfs:label | skos:prefLabel | dcterms:title)
            ?competenceLabel .
    }
}
ORDER BY
    ?instructionalUnit
    ?instructionalUnitLabel
    ?competenceLabel
