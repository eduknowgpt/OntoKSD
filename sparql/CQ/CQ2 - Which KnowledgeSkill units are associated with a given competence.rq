# CQ2: Which knowledge-level pairings and justification verbs specify the selected competence?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: One row per pairing and verb; a verb does not infer the level.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.
# Parameter: replace ontoksd:C02 in VALUES with the intended competence IRI.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?knowledgeSkill ?knowledgeSkillLabel ?knowledge ?knowledgeLabel ?skillLevel ?skillLevelLabel ?justificationVerb
WHERE {
VALUES ?competence { ontoksd:C02 }
?competence (ontoksd:hasKnowledgeSkill|^ontoksd:isKnowledgeSkillOf) ?knowledgeSkill .
?knowledgeSkill ontoksd:hasKnowledgeComponent ?knowledge ; ontoksd:hasSkillLevel ?skillLevel .
OPTIONAL { ?knowledgeSkill ontoksd:hasBloomLevelJustificationVerb ?justificationVerb . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?knowledgeSkill (rdfs:label|skos:prefLabel|dcterms:title) ?knowledgeSkillLabel . }
OPTIONAL { ?knowledge (rdfs:label|skos:prefLabel|dcterms:title) ?knowledgeLabel . }
OPTIONAL { ?skillLevel (rdfs:label|skos:prefLabel|dcterms:title) ?skillLevelLabel . }
}
ORDER BY ?competence ?competenceLabel ?knowledgeSkillLabel ?knowledgeLabel ?skillLevelLabel
