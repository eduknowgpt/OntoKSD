# CQ37: Which whole-competence judgments, levels and schemes are associated with each profile?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: No automatic profile-wide aggregation or latest-record selection is applied.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?profile ?profileLabel ?evidencedCompetence ?evidencedCompetenceLabel ?competence ?competenceLabel ?proficiencyLevel ?proficiencyScheme
WHERE {
?evidencedCompetence a ontoksd:EvidencedCompetence ; (ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile ; ontoksd:refersToCompetence ?competence .
OPTIONAL { ?evidencedCompetence ontoksd:hasProficiencyLevel ?proficiencyLevel . }
OPTIONAL { ?evidencedCompetence ontoksd:interpretedUsingScheme ?proficiencyScheme . }
OPTIONAL { ?profile (rdfs:label|skos:prefLabel|dcterms:title) ?profileLabel . }
OPTIONAL { ?evidencedCompetence (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedCompetenceLabel . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
}
ORDER BY ?profile ?profileLabel ?evidencedCompetenceLabel ?competenceLabel
