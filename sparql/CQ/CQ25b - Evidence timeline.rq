# CQ25b: When was supporting evidence generated or validated?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Undated evidence remains visible; dates alone establish neither progress nor validity.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?evidencedCompetence ?evidencedCompetenceLabel ?competence ?competenceLabel ?evidence ?evidenceLabel ?generatedAt ?validatedAt
WHERE {
?evidencedCompetence a ontoksd:EvidencedCompetence ; ontoksd:refersToCompetence ?competence ; (ontoksd:supportedByEvidence|^ontoksd:evidencesCompetence) ?evidence .
OPTIONAL { ?evidence ontoksd:generatedAt ?generatedAt . }
OPTIONAL { ?evidence ontoksd:validatedAt ?validatedAt . }
OPTIONAL { ?evidencedCompetence (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedCompetenceLabel . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?evidence (rdfs:label|skos:prefLabel|dcterms:title) ?evidenceLabel . }
}
ORDER BY ?competence ?generatedAt ?validatedAt ?evidence
