# CQ28: In which participation occurrence was each proficiency judgment grounded?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: An occurrence scheme and an individual interpretation scheme are distinct assertions.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?evidencedRecord ?evidencedRecordLabel ?recordType ?proficiencyLevel ?proficiencyLevelLabel ?proficiencyScheme ?assessmentParticipation ?assessmentOccurrence ?assessmentOccurrenceLabel
WHERE {
VALUES (?recordType ?referenceProperty) { (ontoksd:EvidencedCompetence ontoksd:refersToCompetence) (ontoksd:EvidencedCompetenceConstituent ontoksd:refersToCompetenceConstituent) }
?evidencedRecord a ?recordType .
?evidencedRecord ontoksd:hasProficiencyLevel ?proficiencyLevel ; ontoksd:derivedFromParticipation ?assessmentParticipation .
?assessmentParticipation (ontoksd:occursInAssessmentOccurrence|^ontoksd:involvesAssessmentParticipation) ?assessmentOccurrence .
OPTIONAL { ?evidencedRecord ontoksd:interpretedUsingScheme ?proficiencyScheme . }
OPTIONAL { ?evidencedRecord (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedRecordLabel . }
OPTIONAL { ?proficiencyLevel (rdfs:label|skos:prefLabel|dcterms:title) ?proficiencyLevelLabel . }
OPTIONAL { ?assessmentOccurrence (rdfs:label|skos:prefLabel|dcterms:title) ?assessmentOccurrenceLabel . }
}
ORDER BY ?evidencedRecord ?evidencedRecordLabel ?proficiencyLevelLabel ?assessmentOccurrenceLabel
