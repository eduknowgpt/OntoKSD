# CQ6: What are the direct composition relationships and integration descriptions?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Both directions are normalized without inverse materialization. Composition is irreflexive because no competence is its own component and asymmetric because a component cannot reciprocally contain its whole. Transitivity is not declared because the property records direct parts; longer cycles need separate checks.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?relation ?relatedCompetence ?relatedCompetenceLabel ?integrationDescription
WHERE {
{ ?competence (ontoksd:hasComponentCompetence|^ontoksd:isComponentOfCompetence) ?relatedCompetence .
  BIND("hasComponentCompetence" AS ?relation)
  OPTIONAL { ?competence ontoksd:hasIntegrationDescription ?integrationDescription . } }
UNION
{ ?competence (ontoksd:isComponentOfCompetence|^ontoksd:hasComponentCompetence) ?relatedCompetence .
  BIND("isComponentOfCompetence" AS ?relation)
  OPTIONAL { ?relatedCompetence ontoksd:hasIntegrationDescription ?integrationDescription . } }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?relatedCompetence (rdfs:label|skos:prefLabel|dcterms:title) ?relatedCompetenceLabel . }
}
ORDER BY ?competence ?competenceLabel ?relatedCompetenceLabel
