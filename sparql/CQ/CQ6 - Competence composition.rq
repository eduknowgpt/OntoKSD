# This query retrieves compositional relations between competences. It identifies which competences compose a composite competence and also in which composite competences a competence is included as a component. Thus, the query demonstrates that OntoKSD can explicitly represent competence composition through direct and inverse inter-competence structural relations.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT
  ?competence
  ?competenceLabel
  ?structureTypeLabel
  ?relation
  ?relatedCompetence
  ?relatedCompetenceLabel
WHERE {

  ?competence a ontoksd:Competence .

  OPTIONAL {
    ?competence ontoksd:hasStructureType ?structureType .

    OPTIONAL { ?structureType rdfs:label ?structureTypeRdfsLabel . }
    OPTIONAL { ?structureType skos:prefLabel ?structureTypeSkosLabel . }

    BIND(
      COALESCE(
        ?structureTypeRdfsLabel,
        ?structureTypeSkosLabel,
        STR(?structureType)
      ) AS ?structureTypeLabel
    )
  }

  {
    ?competence ontoksd:hasComponent ?relatedCompetence .
    BIND("hasComponent" AS ?relation)
  }
  UNION
  {
    ?competence ontoksd:isCompetenceOf ?relatedCompetence .
    BIND("isCompetenceOf" AS ?relation)
  }

  OPTIONAL { ?competence rdfs:label ?competenceRdfsLabel . }
  OPTIONAL { ?competence skos:prefLabel ?competenceSkosLabel . }

  BIND(
    COALESCE(
      ?competenceRdfsLabel,
      ?competenceSkosLabel,
      STR(?competence)
    ) AS ?competenceLabel
  )

  OPTIONAL { ?relatedCompetence rdfs:label ?relatedCompetenceRdfsLabel . }
  OPTIONAL { ?relatedCompetence skos:prefLabel ?relatedCompetenceSkosLabel . }

  BIND(
    COALESCE(
      ?relatedCompetenceRdfsLabel,
      ?relatedCompetenceSkosLabel,
      STR(?relatedCompetence)
    ) AS ?relatedCompetenceLabel
  )
}
ORDER BY ?competenceLabel ?relation ?relatedCompetenceLabel