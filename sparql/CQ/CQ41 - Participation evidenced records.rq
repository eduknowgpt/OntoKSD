# CQ41: Which judgment targets and proficiency interpretations derive from each participation?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Whole-competence and constituent judgments remain distinct; no automatic aggregation is inferred.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?assessmentParticipation ?assessmentParticipationLabel ?evidencedRecord ?evidencedRecordLabel ?recordType ?referencedEntity ?referencedEntityLabel ?proficiencyLevel ?proficiencyScheme
WHERE {
VALUES (?recordType ?referenceProperty) { (ontoksd:EvidencedCompetence ontoksd:refersToCompetence) (ontoksd:EvidencedCompetenceConstituent ontoksd:refersToCompetenceConstituent) }
?evidencedRecord a ?recordType .
?evidencedRecord ontoksd:derivedFromParticipation ?assessmentParticipation ; ?referenceProperty ?referencedEntity .
OPTIONAL { ?evidencedRecord ontoksd:hasProficiencyLevel ?proficiencyLevel . }
OPTIONAL { ?evidencedRecord ontoksd:interpretedUsingScheme ?proficiencyScheme . }
OPTIONAL { ?assessmentParticipation (rdfs:label|skos:prefLabel|dcterms:title) ?assessmentParticipationLabel . }
OPTIONAL { ?evidencedRecord (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedRecordLabel . }
OPTIONAL { ?referencedEntity (rdfs:label|skos:prefLabel|dcterms:title) ?referencedEntityLabel . }
}
ORDER BY ?assessmentParticipation ?assessmentParticipationLabel ?evidencedRecordLabel ?referencedEntityLabel
