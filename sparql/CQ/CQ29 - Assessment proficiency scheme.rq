# CQ29: Which proficiency schemes are explicitly used by assessment occurrences?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Does not apply usesProficiencyScheme to an Assessment specification.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?assessmentOccurrence ?assessmentOccurrenceLabel ?proficiencyScheme ?proficiencySchemeLabel
WHERE {
?assessmentOccurrence ontoksd:usesProficiencyScheme ?proficiencyScheme .
OPTIONAL { ?assessmentOccurrence (rdfs:label|skos:prefLabel|dcterms:title) ?assessmentOccurrenceLabel . }
OPTIONAL { ?proficiencyScheme (rdfs:label|skos:prefLabel|dcterms:title) ?proficiencySchemeLabel . }
}
ORDER BY ?assessmentOccurrence ?assessmentOccurrenceLabel ?proficiencySchemeLabel
