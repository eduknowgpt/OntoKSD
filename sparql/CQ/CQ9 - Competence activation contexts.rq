# CQ9: Which instructional units are associated through competence activation?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Course-level expectations are queried separately by CQ33. Inference can add type rows.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?competenceActivation ?instructionalUnit ?instructionalUnitLabel ?instructionalUnitType
WHERE {
?competenceActivation a ontoksd:CompetenceActivation ; ontoksd:hasActivationCompetence ?competence ;
 (ontoksd:hasActivationInstructionalUnit|^ontoksd:hasCompetenceActivation) ?instructionalUnit .
OPTIONAL { ?instructionalUnit a ?instructionalUnitType . VALUES ?instructionalUnitType { ontoksd:InstructionalUnit ontoksd:LearningActivity ontoksd:LearningTask ontoksd:Assessment } }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?instructionalUnit (rdfs:label|skos:prefLabel|dcterms:title) ?instructionalUnitLabel . }
}
ORDER BY ?competence ?competenceLabel ?instructionalUnitLabel
