# CQ20c: Which assessment and acquisition context are associated with each occurrence?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Optional columns expose missing links; CQ20c1/20c2 provide separate focused views.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?assessmentOccurrence ?assessmentOccurrenceLabel ?assessment ?acquisitionContext
WHERE {
?assessmentOccurrence a ontoksd:AssessmentOccurrence .
OPTIONAL { ?assessmentOccurrence (ontoksd:realizes|^ontoksd:isRealizedBy) ?assessment . }
OPTIONAL { ?assessmentOccurrence (ontoksd:occursInAcquisitionContext|^ontoksd:isContextOfAssessmentOccurrence) ?acquisitionContext . }
OPTIONAL { ?assessmentOccurrence (rdfs:label|skos:prefLabel|dcterms:title) ?assessmentOccurrenceLabel . }
}
ORDER BY ?assessmentOccurrence ?assessmentOccurrenceLabel
