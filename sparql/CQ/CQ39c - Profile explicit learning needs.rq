# CQ39c: Which explicit learning needs target competences or constituents in each profile?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Includes explicitly recorded needs and rule-derived candidates; not every need is a proficiency gap.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?profile ?profileLabel ?learningNeed ?learningNeedLabel ?target ?targetLabel ?targetKind ?basis
WHERE {
?learningNeed a ontoksd:LearningNeed ; (ontoksd:identifiedIn|^ontoksd:hasLearningNeed) ?profile .
{ ?learningNeed ontoksd:targetsCompetence ?target . BIND("Competence" AS ?targetKind) }
UNION
{ ?learningNeed ontoksd:targetsCompetenceConstituent ?target . BIND("CompetenceConstituent" AS ?targetKind) }
OPTIONAL { ?learningNeed dcterms:references ?basis . }
OPTIONAL { ?profile (rdfs:label|skos:prefLabel|dcterms:title) ?profileLabel . }
OPTIONAL { ?learningNeed (rdfs:label|skos:prefLabel|dcterms:title) ?learningNeedLabel . }
OPTIONAL { ?target (rdfs:label|skos:prefLabel|dcterms:title) ?targetLabel . }
}
ORDER BY ?profile ?profileLabel ?learningNeedLabel ?targetLabel
