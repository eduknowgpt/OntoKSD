# CQ22: How does each whole-competence judgment connect specification, profile, evidence and participation occurrence?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Different asserted/participation occurrences are visible, not silently equated.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?evidencedCompetence ?evidencedCompetenceLabel ?evidence ?evidenceLabel ?profile ?assessmentParticipation ?assessmentOccurrence ?assertedOccurrence
WHERE {
?evidencedCompetence a ontoksd:EvidencedCompetence ; ontoksd:refersToCompetence ?competence ; (ontoksd:supportedByEvidence|^ontoksd:evidencesCompetence) ?evidence .
OPTIONAL { ?evidencedCompetence (ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile . }
OPTIONAL { ?evidencedCompetence ontoksd:derivedFromParticipation ?assessmentParticipation .
 OPTIONAL { ?assessmentParticipation (ontoksd:occursInAssessmentOccurrence|^ontoksd:involvesAssessmentParticipation) ?assessmentOccurrence . } }
OPTIONAL { ?evidencedCompetence ontoksd:isEvidencedInAssessmentOccurrence ?assertedOccurrence . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?evidencedCompetence (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedCompetenceLabel . }
OPTIONAL { ?evidence (rdfs:label|skos:prefLabel|dcterms:title) ?evidenceLabel . }
}
ORDER BY ?competence ?competenceLabel ?evidencedCompetenceLabel ?evidenceLabel
