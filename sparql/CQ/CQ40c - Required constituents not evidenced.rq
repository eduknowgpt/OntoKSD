# CQ40c: Which direct constituents of mandatory competences have no judgment in the selected profile?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: A Knowledge nested inside KnowledgeSkill is not automatically a separately declared direct constituent; missing constituent evidence is not a diagnosed LearningNeed.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.
# Parameters: default is the synthetic proficiency example (Profile_Learner_01, Course_FormalLanguages).
# Replace both IRIs for another case. The selection does not assert enrollment.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?profile ?profileLabel ?course ?courseLabel ?courseSpecification ?competence ?competenceLabel ?constituent ?constituentLabel
WHERE {
VALUES (?profile ?course) { (ontoksd:Profile_Learner_01 ontoksd:Course_FormalLanguages) }
?profile a ontoksd:Profile .
?courseSpecification a ontoksd:CourseCompetenceSpecification ; ontoksd:hasSpecifiedCourse ?course ; ontoksd:hasSpecifiedCompetence ?competence ; ontoksd:isMandatory true .
?competence (ontoksd:hasCompetenceConstituent|ontoksd:hasKnowledge|ontoksd:hasSkill|ontoksd:hasDisposition|ontoksd:hasAttitude|ontoksd:hasKnowledgeSkill|^ontoksd:isCompetenceConstituentOf|^ontoksd:isKnowledgeOf|^ontoksd:isSkillOf|^ontoksd:isDispositionOf|^ontoksd:isAttitudeOf|^ontoksd:isKnowledgeSkillOf) ?constituent .
FILTER NOT EXISTS { ?judgment a ontoksd:EvidencedCompetenceConstituent ; ontoksd:refersToCompetenceConstituent ?constituent .
 { ?judgment ontoksd:derivedFromParticipation/(ontoksd:hasLearner|^ontoksd:participatesIn)/(ontoksd:hasProfile|^ontoksd:isProfileOf) ?profile . } UNION { ?judgment (ontoksd:isEvidencedCompetenceConstituentOf|^ontoksd:hasEvidencedConstituent)/(ontoksd:isEvidencedCompetenceOf|^ontoksd:hasEvidencedCompetence) ?profile . }
}
OPTIONAL { ?profile (rdfs:label|skos:prefLabel|dcterms:title) ?profileLabel . }
OPTIONAL { ?course (rdfs:label|skos:prefLabel|dcterms:title) ?courseLabel . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?constituent (rdfs:label|skos:prefLabel|dcterms:title) ?constituentLabel . }
}
ORDER BY ?profile ?profileLabel ?courseLabel ?competenceLabel ?constituentLabel
