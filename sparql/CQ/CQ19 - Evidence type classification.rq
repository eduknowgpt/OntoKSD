# CQ19: How is each evidence item classified?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Classification does not establish reliability, validity or sufficiency.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?evidence ?evidenceLabel ?evidenceType ?evidenceTypeLabel
WHERE {
?evidence ontoksd:hasEvidenceType ?evidenceType .
OPTIONAL { ?evidence (rdfs:label|skos:prefLabel|dcterms:title) ?evidenceLabel . }
OPTIONAL { ?evidenceType (rdfs:label|skos:prefLabel|dcterms:title) ?evidenceTypeLabel . }
}
ORDER BY ?evidence ?evidenceLabel ?evidenceTypeLabel
