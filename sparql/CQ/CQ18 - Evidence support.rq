# CQ18: Which evidence supports each whole or constituent judgment?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Shared evidence can support several records; support is not proof of validity or sufficiency.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?evidencedRecord ?evidencedRecordLabel ?recordType ?referencedEntity ?evidence ?evidenceLabel
WHERE {
VALUES (?recordType ?referenceProperty) { (ontoksd:EvidencedCompetence ontoksd:refersToCompetence) (ontoksd:EvidencedCompetenceConstituent ontoksd:refersToCompetenceConstituent) }
?evidencedRecord a ?recordType .
?evidencedRecord (ontoksd:supportedByEvidence|^ontoksd:evidencesCompetence) ?evidence .
OPTIONAL { ?evidencedRecord ?referenceProperty ?referencedEntity . }
OPTIONAL { ?evidencedRecord (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedRecordLabel . }
OPTIONAL { ?evidence (rdfs:label|skos:prefLabel|dcterms:title) ?evidenceLabel . }
}
ORDER BY ?evidencedRecord ?evidencedRecordLabel ?evidenceLabel
