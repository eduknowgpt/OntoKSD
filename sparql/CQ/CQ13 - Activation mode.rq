# CQ13: Which modes qualify each competence activation?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Modes may coexist and do not redefine the competence.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?competenceActivation ?instructionalUnit ?instructionalUnitLabel ?activationMode ?activationModeLabel
WHERE {
?competenceActivation a ontoksd:CompetenceActivation ; ontoksd:hasActivationCompetence ?competence ;
 (ontoksd:hasActivationInstructionalUnit|^ontoksd:hasCompetenceActivation) ?instructionalUnit .
?competenceActivation ontoksd:hasActivationMode ?activationMode .
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?instructionalUnit (rdfs:label|skos:prefLabel|dcterms:title) ?instructionalUnitLabel . }
OPTIONAL { ?activationMode (rdfs:label|skos:prefLabel|dcterms:title) ?activationModeLabel . }
}
ORDER BY ?competence ?competenceLabel ?instructionalUnitLabel ?activationModeLabel
