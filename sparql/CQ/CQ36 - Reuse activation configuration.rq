# CQ36: How do activation qualifications vary across units reusing the same competence?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Independent modes, roles and constraints can multiply rows; row count is not activation count.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?instructionalUnit ?instructionalUnitLabel ?competenceActivation ?activationFunction ?activationMode ?activationRole ?activationConstraint ?constraintType ?constraintDescription
WHERE {
{ SELECT ?competence WHERE { ?a ontoksd:hasActivationCompetence ?competence ; (ontoksd:hasActivationInstructionalUnit|^ontoksd:hasCompetenceActivation) ?unit . } GROUP BY ?competence HAVING(COUNT(DISTINCT ?unit) > 1) }
?competenceActivation a ontoksd:CompetenceActivation ; ontoksd:hasActivationCompetence ?competence ;
 (ontoksd:hasActivationInstructionalUnit|^ontoksd:hasCompetenceActivation) ?instructionalUnit .
OPTIONAL { ?competenceActivation ontoksd:hasActivationFunction ?activationFunction . }
OPTIONAL { ?competenceActivation ontoksd:hasActivationMode ?activationMode . }
OPTIONAL { ?competenceActivation ontoksd:hasActivationRole ?activationRole . }
OPTIONAL { ?competenceActivation ontoksd:hasActivationConstraint ?activationConstraint .
 OPTIONAL { ?activationConstraint ontoksd:hasActivationConstraintType ?constraintType . }
 OPTIONAL { ?activationConstraint ontoksd:hasActivationConstraintDescription ?constraintDescription . } }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?instructionalUnit (rdfs:label|skos:prefLabel|dcterms:title) ?instructionalUnitLabel . }
}
ORDER BY ?competence ?competenceLabel ?instructionalUnitLabel
