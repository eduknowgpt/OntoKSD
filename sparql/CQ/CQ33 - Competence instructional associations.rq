# CQ33: Which curricular expectations and instructional activations associate each competence?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Curricular inclusion does not prove instructional coverage or delivered instruction.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?associationType ?associationRecord ?associatedEntity ?associatedEntityLabel ?isMandatory ?minimumLevel
WHERE {
{ ?associationRecord a ontoksd:CourseCompetenceSpecification ; ontoksd:hasSpecifiedCompetence ?competence ; ontoksd:hasSpecifiedCourse ?associatedEntity .
 BIND("CourseCompetenceSpecification" AS ?associationType)
 OPTIONAL { ?associationRecord ontoksd:isMandatory ?isMandatory . }
 OPTIONAL { ?associationRecord ontoksd:requiresMinimumProficiencyLevel ?minimumLevel . } }
UNION
{ ?associationRecord a ontoksd:CompetenceActivation ; ontoksd:hasActivationCompetence ?competence ; (ontoksd:hasActivationInstructionalUnit|^ontoksd:hasCompetenceActivation) ?associatedEntity .
 BIND("CompetenceActivation" AS ?associationType) }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?associatedEntity (rdfs:label|skos:prefLabel|dcterms:title) ?associatedEntityLabel . }
}
ORDER BY ?competence ?competenceLabel ?associatedEntityLabel
