# CQ32a: Which proficiency level and interpretive scheme are assigned to each whole-competence judgment?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: CQ32a is the whole-competence view also available in CQ26; it does not aggregate constituent levels.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?evidencedRecord ?evidencedRecordLabel ?competence ?competenceLabel ?proficiencyLevel ?proficiencyLevelLabel ?proficiencyScheme
WHERE {
?evidencedRecord a ontoksd:EvidencedCompetence ; ontoksd:refersToCompetence ?competence ; ontoksd:hasProficiencyLevel ?proficiencyLevel .
OPTIONAL { ?evidencedRecord ontoksd:interpretedUsingScheme ?proficiencyScheme . }
OPTIONAL { ?evidencedRecord (rdfs:label|skos:prefLabel|dcterms:title) ?evidencedRecordLabel . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?proficiencyLevel (rdfs:label|skos:prefLabel|dcterms:title) ?proficiencyLevelLabel . }
}
ORDER BY ?evidencedRecord ?evidencedRecordLabel ?competenceLabel ?proficiencyLevelLabel
