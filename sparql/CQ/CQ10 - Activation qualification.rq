# This query retrieves how competence activation relations are qualified. It returns each competence, the instructional unit associated with it through a CompetenceRelator, and the activation qualifiers that specify the pedagogical role, mode, constraint, or function of the association. Thus, the query demonstrates that OntoKSD can represent not only that a competence is associated with an instructional structure, but also how this association is pedagogically qualified.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT
  ?competence
  ?competenceLabel
  ?competenceRelator
  ?instructionalUnit
  ?instructionalUnitLabel
  ?qualificationProperty
  ?qualifier
  ?qualifierLabel
WHERE {
  ?competenceRelator a ontoksd:CompetenceRelator ;
                     ontoksd:mediatesCompetence ?competence ;
                     ontoksd:mediatesInstructionalUnit ?instructionalUnit .

  VALUES ?qualificationProperty {
    ontoksd:hasActivationFunction
    ontoksd:hasActivationMode
    ontoksd:hasActivationRole
    ontoksd:hasActivationConstraint
    ontoksd:hasActivationQualifier
  }

  ?competenceRelator ?qualificationProperty ?qualifier .

  OPTIONAL { ?competence rdfs:label ?competenceRdfsLabel . }
  OPTIONAL { ?competence skos:prefLabel ?competenceSkosLabel . }
  BIND(COALESCE(?competenceRdfsLabel, ?competenceSkosLabel, STR(?competence)) AS ?competenceLabel)

  OPTIONAL { ?instructionalUnit rdfs:label ?instructionalUnitRdfsLabel . }
  OPTIONAL { ?instructionalUnit skos:prefLabel ?instructionalUnitSkosLabel . }
  BIND(COALESCE(?instructionalUnitRdfsLabel, ?instructionalUnitSkosLabel, STR(?instructionalUnit)) AS ?instructionalUnitLabel)

  OPTIONAL { ?qualifier rdfs:label ?qualifierRdfsLabel . }
  OPTIONAL { ?qualifier skos:prefLabel ?qualifierSkosLabel . }
  BIND(COALESCE(?qualifierRdfsLabel, ?qualifierSkosLabel, STR(?qualifier)) AS ?qualifierLabel)
}
ORDER BY ?competenceLabel ?instructionalUnitLabel ?qualificationProperty ?qualifierLabel