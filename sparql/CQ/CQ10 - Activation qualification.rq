# CQ10: How is each activation qualified by function, role, mode or constraint?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: ActivationFunction remains separate from ActivationQualifier. Only populated qualifications are returned.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?competenceActivation ?instructionalUnit ?instructionalUnitLabel ?qualificationProperty ?qualifier ?qualifierLabel ?constraintType ?constraintDescription
WHERE {
?competenceActivation a ontoksd:CompetenceActivation ; ontoksd:mediatesCompetence ?competence ;
 (ontoksd:mediatesInstructionalUnit|^ontoksd:hasCompetenceActivation) ?instructionalUnit .
{ ?competenceActivation ontoksd:hasActivationFunction ?qualifier . BIND(ontoksd:hasActivationFunction AS ?qualificationProperty) }
UNION { ?competenceActivation ontoksd:hasActivationRole ?qualifier . BIND(ontoksd:hasActivationRole AS ?qualificationProperty) }
UNION { ?competenceActivation ontoksd:hasActivationMode ?qualifier . BIND(ontoksd:hasActivationMode AS ?qualificationProperty) }
UNION { ?competenceActivation ontoksd:hasActivationConstraint ?qualifier . BIND(ontoksd:hasActivationConstraint AS ?qualificationProperty) }
UNION { ?competenceActivation ontoksd:hasActivationQualifier ?qualifier . BIND(ontoksd:hasActivationQualifier AS ?qualificationProperty)
 FILTER NOT EXISTS { ?competenceActivation (ontoksd:hasActivationRole|ontoksd:hasActivationMode|ontoksd:hasActivationConstraint) ?qualifier . }
}
OPTIONAL { ?qualifier ontoksd:hasActivationConstraintType ?constraintType . }
OPTIONAL { ?qualifier ontoksd:hasActivationConstraintDescription ?constraintDescription . }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?instructionalUnit (rdfs:label|skos:prefLabel|dcterms:title) ?instructionalUnitLabel . }
OPTIONAL { ?qualifier (rdfs:label|skos:prefLabel|dcterms:title) ?qualifierLabel . }
}
ORDER BY ?competence ?competenceLabel ?instructionalUnitLabel ?qualifierLabel
