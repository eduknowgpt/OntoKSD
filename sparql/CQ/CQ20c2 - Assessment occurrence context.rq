# CQ20c2: In which acquisition context does each occurrence take place?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: One SPARQL operation per file; acquisition context specializes Context, not conversely.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?assessmentOccurrence ?assessmentOccurrenceLabel ?acquisitionContext ?acquisitionContextLabel
WHERE {
?assessmentOccurrence (ontoksd:occursInAcquisitionContext|^ontoksd:isContextOfAssessmentOccurrence) ?acquisitionContext .
OPTIONAL { ?assessmentOccurrence (rdfs:label|skos:prefLabel|dcterms:title) ?assessmentOccurrenceLabel . }
OPTIONAL { ?acquisitionContext (rdfs:label|skos:prefLabel|dcterms:title) ?acquisitionContextLabel . }
}
ORDER BY ?assessmentOccurrence ?assessmentOccurrenceLabel ?acquisitionContextLabel
