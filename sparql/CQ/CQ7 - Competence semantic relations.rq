# CQ7: What direct specialization relationships and narrower-scope descriptions exist?
# Operation: SELECT. Target: GraphDB / SPARQL 1.1.
# Scope: Irreflexive means no self-specialization; asymmetric means the base is not reciprocally narrower. Non-transitivity preserves direct bases. No prerequisite, subclass inheritance or composition is implied.
# Blank labels do not imply missing entities; multiple languages may produce multiple rows.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?competence ?competenceLabel ?relation ?relatedCompetence ?relatedCompetenceLabel ?specializationDescription
WHERE {
{ ?competence (ontoksd:isSpecializationOf|^ontoksd:hasSpecialization) ?relatedCompetence .
  BIND("isSpecializationOf" AS ?relation)
  OPTIONAL { ?competence ontoksd:hasSpecializationDescription ?specializationDescription . } }
UNION
{ ?competence (ontoksd:hasSpecialization|^ontoksd:isSpecializationOf) ?relatedCompetence .
  BIND("hasSpecialization" AS ?relation)
  OPTIONAL { ?relatedCompetence ontoksd:hasSpecializationDescription ?specializationDescription . } }
OPTIONAL { ?competence (rdfs:label|skos:prefLabel|dcterms:title) ?competenceLabel . }
OPTIONAL { ?relatedCompetence (rdfs:label|skos:prefLabel|dcterms:title) ?relatedCompetenceLabel . }
}
ORDER BY ?competence ?competenceLabel ?relatedCompetenceLabel
