# Which explicit skills, dimensions and applied knowledge are available?
# Read-only SELECT; GraphDB / SPARQL 1.1.
# Skill is distinct from SkillLevel. No hasCognitiveLevel or hasSkillLevel relation is assumed on Skill.

PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX bloom: <http://purl.org/edu/bloom#>
PREFIX cs2023level: <http://purl.org/edu/cs2023#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?skill ?skillLabel ?dimension ?knowledge
WHERE {
?skill a/rdfs:subClassOf* ontoksd:Skill .
OPTIONAL { ?skill ontoksd:hasSkillDimension ?dimension . }
OPTIONAL { ?skill ontoksd:appliesKnowledge ?knowledge . }
OPTIONAL { ?skill (rdfs:label|skos:prefLabel|dcterms:title) ?skillLabel . }
}
ORDER BY ?skill ?skillLabel
