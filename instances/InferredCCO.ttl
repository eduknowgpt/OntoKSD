###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementID
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementID> rdf:type owl:ObjectProperty ;
                                                                     rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Statement> ;
                                                                     rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LongIdentifierType> ;
                                                                     rdfs:comment """This conditionally mandatory data element is a label for the statement. This label shall be unique at least within the scope of the definition.

The RCD Standard does not specify how IDs are created, assigned, or resolved."""@en ;
                                                                     rdfs:label "statementID"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementText
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementText> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Statement> ;
                                                                       rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                       rdfs:comment """This conditionally mandatory data element is an unstructured, textual description of those aspects of the RCD referred to by the Statement name element.

A competency free-form statement represents the competency in terms that are familiar and comprehensible to a wide audience, typically using a vocabulary familiar to, and that resonates with, the audience. The competency statement is then structurally augmented and amplified in the enumeration of knowledge, skills, and dispositions that complete the competency specification"""@en ;
                                                                       rdfs:label "statementText"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementToken
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementToken> rdf:type owl:ObjectProperty ;
                                                                        rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Statement> ;
                                                                        rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Vocabulary> ;
                                                                        rdfs:comment """This conditionally mandatory data element consists of a vocabulary token, along with an identifier of the token�s source, which allows the use of controlled terms (vocabularies) instead of, or along with, free-form statement text.

A record of type vocabulary shall contain both a Source element and a Value element. 

The Source element indicates the source of the token value. The Source element may be a URI that identifies a formal vocabulary definition. """@en ;
                                                                        rdfs:label "statementToken"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#taskDescription
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#taskDescription> rdf:type owl:ObjectProperty ;
                                                                         rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task> ;
                                                                         rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                         rdfs:label "taskDescription"@en .


###  http://www.w3.org/2004/02/skos/core#broadMatch
<http://www.w3.org/2004/02/skos/core#broadMatch> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#broader> ,
                                                                    <http://www.w3.org/2004/02/skos/core#mappingRelation> ;
                                                 owl:inverseOf <http://www.w3.org/2004/02/skos/core#narrowMatch> ;
                                                 rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                 rdfs:label "has broader match"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "skos:broadMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .


###  http://www.w3.org/2004/02/skos/core#broader
<http://www.w3.org/2004/02/skos/core#broader> rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#broaderTransitive> ;
                                              owl:inverseOf <http://www.w3.org/2004/02/skos/core#narrower> ;
                                              rdfs:comment "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@en ;
                                              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                              rdfs:label "has broader"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Relates a concept to a concept that is more general in meaning."@en ;
                                              <http://www.w3.org/2004/02/skos/core#scopeNote> "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .


###  http://www.w3.org/2004/02/skos/core#broaderTransitive
<http://www.w3.org/2004/02/skos/core#broaderTransitive> rdf:type owl:ObjectProperty ;
                                                        rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#semanticRelation> ;
                                                        owl:inverseOf <http://www.w3.org/2004/02/skos/core#narrowerTransitive> ;
                                                        rdf:type owl:TransitiveProperty ;
                                                        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                        rdfs:label "has broader transitive"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "skos:broaderTransitive is a transitive superproperty of skos:broader." ;
                                                        <http://www.w3.org/2004/02/skos/core#scopeNote> "By convention, skos:broaderTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#mappingRelation> ;
                                                 owl:inverseOf <http://www.w3.org/2004/02/skos/core#closeMatch> ;
                                                 rdf:type owl:SymmetricProperty ;
                                                 rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                 rdfs:label "has close match"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property."@en .


###  http://www.w3.org/2004/02/skos/core#exactMatch
<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#closeMatch> ;
                                                 owl:inverseOf <http://www.w3.org/2004/02/skos/core#exactMatch> ;
                                                 rdf:type owl:SymmetricProperty ,
                                                          owl:TransitiveProperty ;
                                                 rdfs:comment "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch."@en ;
                                                 rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                 rdfs:label "has exact match"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch."@en .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
<http://www.w3.org/2004/02/skos/core#hasTopConcept> rdf:type owl:ObjectProperty ;
                                                    owl:inverseOf <http://www.w3.org/2004/02/skos/core#topConceptOf> ;
                                                    rdfs:domain <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                                    rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                    rdfs:label "has top concept"@en ;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty ;
                                               rdfs:range <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                               rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                               rdfs:label "is in scheme"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Relates a resource (for example a concept) to a concept scheme in which it is included."@en ;
                                               <http://www.w3.org/2004/02/skos/core#scopeNote> "A concept may be a member of more than one concept scheme."@en .


###  http://www.w3.org/2004/02/skos/core#mappingRelation
<http://www.w3.org/2004/02/skos/core#mappingRelation> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#semanticRelation> ;
                                                      rdfs:comment "These concept mapping relations mirror semantic relations, and the data model defined below is similar (with the exception of skos:exactMatch) to the data model defined for semantic relations. A distinct vocabulary is provided for concept mapping relations, to provide a convenient way to differentiate links within a concept scheme from links between concept schemes. However, this pattern of usage is not a formal requirement of the SKOS data model, and relies on informal definitions of best practice."@en ;
                                                      rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                      rdfs:label "is in mapping relation with"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Relates two concepts coming, by convention, from different schemes, and that have comparable meanings"@en .


###  http://www.w3.org/2004/02/skos/core#member
<http://www.w3.org/2004/02/skos/core#member> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://www.w3.org/2004/02/skos/core#Collection> ;
                                             rdfs:range [ rdf:type owl:Class ;
                                                          owl:unionOf ( <http://www.w3.org/2004/02/skos/core#Collection>
                                                                        <http://www.w3.org/2004/02/skos/core#Concept>
                                                                      )
                                                        ] ;
                                             rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                             rdfs:label "has member"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Relates a collection to one of its members."@en .


###  http://www.w3.org/2004/02/skos/core#memberList
<http://www.w3.org/2004/02/skos/core#memberList> rdf:type owl:ObjectProperty ,
                                                          owl:FunctionalProperty ;
                                                 rdfs:domain <http://www.w3.org/2004/02/skos/core#OrderedCollection> ;
                                                 rdfs:range rdf:List ;
                                                 rdfs:comment """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@en ;
                                                 rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                 rdfs:label "has member list"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Relates an ordered collection to the RDF list containing its members."@en .


###  http://www.w3.org/2004/02/skos/core#narrowMatch
<http://www.w3.org/2004/02/skos/core#narrowMatch> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#mappingRelation> ,
                                                                     <http://www.w3.org/2004/02/skos/core#narrower> ;
                                                  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                  rdfs:label "has narrower match"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "skos:narrowMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .


###  http://www.w3.org/2004/02/skos/core#narrower
<http://www.w3.org/2004/02/skos/core#narrower> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#narrowerTransitive> ;
                                               rdfs:comment "Narrower concepts are typically rendered as children in a concept hierarchy (tree)."@en ;
                                               rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                               rdfs:label "has narrower"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Relates a concept to a concept that is more specific in meaning."@en ;
                                               <http://www.w3.org/2004/02/skos/core#scopeNote> "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .


###  http://www.w3.org/2004/02/skos/core#narrowerTransitive
<http://www.w3.org/2004/02/skos/core#narrowerTransitive> rdf:type owl:ObjectProperty ;
                                                         rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#semanticRelation> ;
                                                         rdf:type owl:TransitiveProperty ;
                                                         rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                         rdfs:label "has narrower transitive"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "skos:narrowerTransitive is a transitive superproperty of skos:narrower." ;
                                                         <http://www.w3.org/2004/02/skos/core#scopeNote> "By convention, skos:narrowerTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .


###  http://www.w3.org/2004/02/skos/core#related
<http://www.w3.org/2004/02/skos/core#related> rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#semanticRelation> ;
                                              owl:inverseOf <http://www.w3.org/2004/02/skos/core#related> ;
                                              rdf:type owl:SymmetricProperty ;
                                              rdfs:comment "skos:related is disjoint with skos:broaderTransitive"@en ;
                                              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                              rdfs:label "has related"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Relates a concept to a concept with which there is an associative semantic relationship."@en .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
<http://www.w3.org/2004/02/skos/core#relatedMatch> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#mappingRelation> ,
                                                                      <http://www.w3.org/2004/02/skos/core#related> ;
                                                   owl:inverseOf <http://www.w3.org/2004/02/skos/core#relatedMatch> ;
                                                   rdf:type owl:SymmetricProperty ;
                                                   rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                   rdfs:label "has related match"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "skos:relatedMatch is used to state an associative mapping link between two conceptual resources in different concept schemes."@en .


###  http://www.w3.org/2004/02/skos/core#semanticRelation
<http://www.w3.org/2004/02/skos/core#semanticRelation> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                       rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                       rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                       rdfs:label "is in semantic relation with"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Links a concept to a concept related by meaning."@en ;
                                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts."@en .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
<http://www.w3.org/2004/02/skos/core#topConceptOf> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                   rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                   rdfs:range <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                                   rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                   rdfs:label "is top concept in scheme"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a concept to the concept scheme that it is a top level concept of."@en .


#################################################################
#    Data properties
#################################################################

###  _TOP_OBJECT_PROPERTY_
<_TOP_OBJECT_PROPERTY_> rdf:type owl:DatatypeProperty .


###  http://purl.org/nemo/gufo#hasQualityValue
<http://purl.org/nemo/gufo#hasQualityValue> rdf:type owl:DatatypeProperty .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#additionalMetadata
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#additionalMetadata> rdf:type owl:DatatypeProperty ;
                                                                            rdfs:subPropertyOf <_TOP_OBJECT_PROPERTY_> ,
                                                                                               <http://purl.org/nemo/gufo#hasQualityValue> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#assessmentDate
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#assessmentDate> rdf:type owl:DatatypeProperty ;
                                                                        rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                        rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment> ;
                                                                        rdfs:range xsd:string ;
                                                                        rdfs:label "assessmentDate"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#definitionModelSource
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#definitionModelSource> rdf:type owl:DatatypeProperty ;
                                                                               rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                               rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Definition> ;
                                                                               rdfs:range xsd:string ;
                                                                               rdfs:comment """This optional data element is the source of the model used for the competency definition.

The value of this data element should be sufficiently specific to avoid conflict with other source names; therefore, the value should be a Uniform Resource Identifier (URI). If the value of this data element is a URI, it may point to an actual document that defines the source formally.

Typically, the models that underlie this data element define competencies in terms of \"statement, conditions, criteria,\" \"proficiency, criteria, indicators,\" \"standards, performance indicators, outcomes,\" \"abilities, basic skills, content, process,\" and similar sets of statements."""@en ;
                                                                               rdfs:label "definitionModelSource"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#description
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#description> rdf:type owl:DatatypeProperty ;
                                                                     rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                     rdfs:range xsd:string ;
                                                                     rdfs:label "description"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#level
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#level> rdf:type owl:DatatypeProperty ;
                                                               rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                               rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#BloomCognitiveSkill> ;
                                                               rdfs:range xsd:int .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#levelValue
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#levelValue> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                    rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ProficiencyLevel> ;
                                                                    rdfs:range xsd:int .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#litCatalog
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#litCatalog> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                    rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LongIdentifierType> ;
                                                                    rdfs:range xsd:string ;
                                                                    rdfs:label "litCatalog"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#litEntry
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#litEntry> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LongIdentifierType> ;
                                                                  rdfs:range xsd:string ;
                                                                  rdfs:label "litEntry"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#lsLanguage
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#lsLanguage> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                    rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                    rdfs:range xsd:string ;
                                                                    rdfs:comment """This data element shall be a character string consisting of a required language code followed by multiple, optional, hyphen-prefixed subcodes.

The following constraints apply to the language code part of the character string:
- Two-letter codes are defined by ISO 639-1.
- Three-letter codes are defined by ISO 639-2.
- The value prefix \"i\" is reserved for registrations defined by the Internet Assigned Numbers Authority (IANA).
- The value prefix \"x\" is reserved for private use.

The following constraints apply to the first subcode part of the character string:
- Two-letter subcodes are ISO 3166-1 alpha-2 country codes.
- Subcodes of from three to eight letters are registered with IANA.

Constraints for additional subcodes are unspecified.
The character string shall conform to the syntax defined for a valid language code by the XML Schema derived data type language (see W3C Recommendation XML Schema, Part 2 [28 October 2004]).

ISO 639-2 specifies two code sets, one for bibliographic applications (ISO 639-2/B) and one for terminology applications (ISO 639-2/T). Either code set may be used."""@en ;
                                                                    rdfs:label "lsLanguage"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#lsString
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#lsString> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                  rdfs:range xsd:string ;
                                                                  rdfs:label "lsString"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#maxValue
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#maxValue> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                  rdfs:range xsd:int ;
                                                                  rdfs:label "maxValue"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#minValue
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#minValue> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                  rdfs:range xsd:int ;
                                                                  rdfs:label "minValue"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#rcdSchema
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#rcdSchema> rdf:type owl:DatatypeProperty ;
                                                                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                   rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Metadata> ;
                                                                   rdfs:range xsd:string ;
                                                                   rdfs:comment "This optional data element is a label for the schema that defines and controls the RCD instance. If this data element is omitted from the RCD instance, then a value of  \"ieee.org/1484.20.1/2007\" shall be assumed."@en ;
                                                                   rdfs:label "rcdSchema"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#rcdSchemaVersion
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#rcdSchemaVersion> rdf:type owl:DatatypeProperty ;
                                                                          rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                          rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Metadata> ;
                                                                          rdfs:range xsd:string ;
                                                                          rdfs:comment """This optional data element describes the version of the schema described by the RCD schema element.
If this element is omitted, then a value of  \"1.0\" shall be assumed."""@en ;
                                                                          rdfs:label "rcdSchemaVersion"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#skillLevel
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#skillLevel> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                    rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill> ;
                                                                    rdfs:range xsd:int ;
                                                                    rdfs:label "skillLevel"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementName
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementName> rdf:type owl:DatatypeProperty ;
                                                                       rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                       rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Statement> ;
                                                                       rdfs:range xsd:string ;
                                                                       rdfs:comment """This conditionally mandatory data element is a name for the statement. This name shall be unique at least within the scope of the definition. 

Examples: \"Condition\", \"Action\", \"Standard\", \"Outcome\", and \"Criteria\". The characters in the string shall belong to the repertoire of ISO/IEC 10646."""@en ;
                                                                       rdfs:label "statementName"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbDescription
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbDescription> rdf:type owl:DatatypeProperty ;
                                                                         rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                         rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb> ;
                                                                         rdfs:range xsd:string ;
                                                                         rdfs:comment "A description of the cognitive action verb."@en ;
                                                                         rdfs:label "verbDescription"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbName
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbName> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb> ;
                                                                  rdfs:range xsd:string ;
                                                                  rdfs:comment "The name of the cognitive action verb."@en ;
                                                                  rdfs:label "verbName"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#vocabularySource
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#vocabularySource> rdf:type owl:DatatypeProperty ;
                                                                          rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                          rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Vocabulary> ;
                                                                          rdfs:range xsd:string ;
                                                                          rdfs:label "vocabularySource"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#vocabularyValue
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#vocabularyValue> rdf:type owl:DatatypeProperty ;
                                                                         rdfs:subPropertyOf <http://purl.org/nemo/gufo#hasQualityValue> ;
                                                                         rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Vocabulary> ;
                                                                         rdfs:range xsd:string ;
                                                                         rdfs:label "vocabularyValue"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/nemo/gufo#FunctionalComplex
<http://purl.org/nemo/gufo#FunctionalComplex> rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Kind
<http://purl.org/nemo/gufo#Kind> rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Situation
<http://purl.org/nemo/gufo#Situation> rdf:type owl:Class ;
                                      rdfs:comment """In GUFO, a Situation is an entity that captures a specific state of affairs involving objects, qualities, and relations at a particular time. It represents a context or a configuration of entities and their properties that holds under certain conditions. Situations can be used to model contexts, scenarios, and various configurations of entities in the world.

Key Characteristics of a Situation in GUFO
Temporal Aspect: Situations are temporally bound, meaning they are associated with a specific time or time interval.
Contextual: Situations provide a context for entities and their properties, indicating how things stand in a given configuration.
Relational: Situations often involve multiple entities and the relationships between them.
State of Affairs: Situations capture a specific state of affairs, which can include conditions, events, or states that are relevant in a particular context.""" .


###  http://purl.org/nemo/gufo#SituationType
<http://purl.org/nemo/gufo#SituationType> rdf:type owl:Class .


###  http://purl.org/nemo/gufo#SubKind
<http://purl.org/nemo/gufo#SubKind> rdf:type owl:Class .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Activity
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Activity> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Actor
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Actor> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isActorFor> ;
                                                                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment>
                                                                               ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Analyzing
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Analyzing> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Applying> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Apply
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Apply> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Explain> ,
                                                                               <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Remembering> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Applying
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Applying> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Understanding> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetenceEvidence> ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasActor> ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Actor>
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasProficiencyLevel> ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ProficiencyLevel>
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTask> ;
                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task>
                                                                                    ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AtomicCompetence
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AtomicCompetence> rdf:type owl:Class ;
                                                                          rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetenceACMModel> ,
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledgeSkill> ;
                                                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                            owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KnowledgeSkill>
                                                                                          ] ,
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isAtomicCompetencePartOf> ;
                                                                                            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                            owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ComposedCompetence>
                                                                                          ] ;
                                                                          owl:disjointWith <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ComposedCompetence> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Attitude
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Attitude> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Disposition> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#BloomCognitiveSkill
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#BloomCognitiveSkill> rdf:type owl:Class ;
                                                                             rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill> ,
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCognitiveActionVerb> ;
                                                                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                               owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb>
                                                                                             ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CS2023
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CS2023> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CSCompetenceArea
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CSCompetenceArea> rdf:type owl:Class ;
                                                                          rdfs:subClassOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetenceArea> ;
                                                                          owl:disjointWith <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ISCompetenceArea> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb> rdf:type owl:Class ;
                                                                             rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCognitiveActionVerbFor> ;
                                                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                               owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#BloomCognitiveSkill>
                                                                                             ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetencePart> ;
                                                                                      owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence>
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDisposition> ;
                                                                                      owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Disposition>
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledge> ;
                                                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                      owl:onClass <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Knowledge>
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasSkill> ;
