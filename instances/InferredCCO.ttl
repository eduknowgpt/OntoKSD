@prefix : <http://www.semanticweb.org/edeys/ontologies/2024/5/InferredCCO#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/edeys/ontologies/2024/5/InferredCCO> .

<http://www.semanticweb.org/edeys/ontologies/2024/5/InferredCCO> rdf:type owl:Ontology ;
                                                                  <http://purl.org/dc/terms/contributor> "Dave Beckett" ,
                                                                                                         "Nikki Rogers" ,
                                                                                                         "Participants in W3C's Semantic Web Deployment Working Group." ;
                                                                  <http://purl.org/dc/terms/creator> "Alistair Miles" ,
                                                                                                     "Sean Bechhofer" ;
                                                                  <http://purl.org/dc/terms/description> "An RDF vocabulary for describing the basic structure and content of concept schemes such as thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', other types of controlled vocabulary, and also concept schemes embedded in glossaries and terminologies."@en ;
                                                                  <http://purl.org/dc/terms/title> "SKOS Vocabulary"@en ;
                                                                  rdfs:seeAlso <http://www.w3.org/TR/skos-reference/> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#minQualifiedCardinality
owl:minQualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#qualifiedCardinality
owl:qualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty ;
                                               rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@en ,
                                                            "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
                                               rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                               rdfs:label "alternative label"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "An alternative lexical label for a resource."@en ;
                                               <http://www.w3.org/2004/02/skos/core#example> "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."@en .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty ;
                                                 rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                 rdfs:label "definition"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "A statement or formal explanation of the meaning of a concept."@en .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty ;
                                              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                              rdfs:label "example"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "An example of the use of a concept."@en .


###  http://www.w3.org/2004/02/skos/core#hiddenLabel
<http://www.w3.org/2004/02/skos/core#hiddenLabel> rdf:type owl:AnnotationProperty ;
                                                  rdfs:comment "The range of skos:hiddenLabel is the class of RDF plain literals."@en ,
                                                               "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
                                                  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                  rdfs:label "hidden label"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en .


###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty ;
                                                rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                rdfs:label "scope note"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A note that helps to clarify the meaning and/or the use of a concept."@en .


#################################################################
#    Object Properties
#################################################################

###  gufoi:hasComponent
<gufoi:hasComponent> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#isComponentOf
<http://purl.org/nemo/gufo#isComponentOf> rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#additionalMetadata
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#additionalMetadata> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Metadata> ;
                                                                            rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#void> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#contextDescription
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#contextDescription> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Context> ;
                                                                            rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                            rdfs:label "contextDescription"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#definitionStatement
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#definitionStatement> rdf:type owl:ObjectProperty ;
                                                                             rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Definition> ;
                                                                             rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Statement> ;
                                                                             rdfs:comment """Each instance of this data element is a description of a single characteristic of a Definition element. At least one Statement element is mandatory if a Definition element exists. 

A record of type Statement shall contain one or more of the elements defined in statement type. None of these elements is specifically required, but at least one shall be present."""@en ;
                                                                             rdfs:label "definitionStatement"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#dispositionName
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#dispositionName> rdf:type owl:ObjectProperty ;
                                                                         rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Disposition> ;
                                                                         rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                         rdfs:label "dispositionName"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasActor
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasActor> rdf:type owl:ObjectProperty ;
                                                                  owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isActorFor> ;
                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment> ;
                                                                  rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Actor> ;
                                                                  rdfs:label "hasActor" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasAppliedSkill
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasAppliedSkill> rdf:type owl:ObjectProperty ;
                                                                         owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isAppliedSkillFor> ;
                                                                         rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Knowledge> ;
                                                                         rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill> ;
                                                                         rdfs:label "hasAppliedSkill"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasAtomicCompetence
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasAtomicCompetence> rdf:type owl:ObjectProperty ;
                                                                             rdfs:subPropertyOf <gufoi:hasComponent> ;
                                                                             owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isAtomicCompetencePartOf> ;
                                                                             rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ComposedCompetence> ;
                                                                             rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AtomicCompetence> ;
                                                                             rdfs:label "hasAtomicCompetence"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCognitiveActionVerb
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCognitiveActionVerb> rdf:type owl:ObjectProperty ;
                                                                                owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCognitiveActionVerbFor> ;
                                                                                rdf:type owl:InverseFunctionalProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#BloomCognitiveSkill> ;
                                                                                rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb> ;
                                                                                rdfs:comment "Associates a Bloom's Cognitive Skill with its corresponding cognitive action verbs."@en ;
                                                                                rdfs:label "hasCognitiveActionVerb"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCognitiveActionVerb_2
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCognitiveActionVerb_2> rdf:type owl:ObjectProperty ;
                                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CS2023> ;
                                                                                  rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb> ;
                                                                                  rdfs:label "hasCognitiveActionVerb" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetence
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetence> rdf:type owl:ObjectProperty ;
                                                                       owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCompetenceFor> ;
                                                                       rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetenceArea
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetenceArea> rdf:type owl:ObjectProperty ;
                                                                           owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCompetenceAreaFor> ;
                                                                           rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                           rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetenceArea> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetenceAreaStatement
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetenceAreaStatement> rdf:type owl:ObjectProperty ;
                                                                                    rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetenceArea> ;
                                                                                    rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetencePart
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetencePart> rdf:type owl:ObjectProperty ;
                                                                           rdfs:subPropertyOf <gufoi:hasComponent> ;
                                                                           owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCompetencePartOf> ;
                                                                           rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                           rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                           rdfs:label "hasCompetencePart"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasContext
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasContext> rdf:type owl:ObjectProperty ;
                                                                    owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isContextFor> ;
                                                                    rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                    rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Context> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDefinition
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDefinition> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                       rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Definition> ;
                                                                       rdfs:comment """This data element is a structured description that provides a formal definition of the competency,usually using attributes taken from a specific model of how a competency should be structured or defined.

This data element shall contain zero or one Model source elements and at least one Statement element. It may contain multiple Statement elements."""@en ;
                                                                       rdfs:label "hasDefinition"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDescription
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDescription> rdf:type owl:ObjectProperty ;
                                                                        rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                        rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                        rdfs:comment "This optinal data element is a human-readable description of the competency. It is an unstructured character string meant to be interpretable only by humans."@en ;
                                                                        rdfs:label "hasDescription"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDisposition
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDisposition> rdf:type owl:ObjectProperty ;
                                                                        owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isDispositionFor> ;
                                                                        rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                        rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Disposition> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasEvidence
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasEvidence> rdf:type owl:ObjectProperty ;
                                                                     owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isEvidenceFor> ;
                                                                     rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetenceEvidence> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasIdentifier
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasIdentifier> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                       rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LongIdentifierType> ;
                                                                       rdfs:comment """This mandatory data element is a globally unique label that identifies the RCD (Reusable Competency Definition). 
The label shall be unique across all systems that store or process the RCD."""@en ;
                                                                       rdfs:label "hasIdentifier"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledge
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledge> rdf:type owl:ObjectProperty ;
                                                                      owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isKnowledgeFor> ;
                                                                      rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                      rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Knowledge> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledgePart
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledgePart> rdf:type owl:ObjectProperty ;
                                                                          rdfs:subPropertyOf <gufoi:hasComponent> ;
                                                                          owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isKnowledgePartOf> ;
                                                                          rdf:type owl:FunctionalProperty ;
                                                                          rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KnowledgeSkill> ;
                                                                          rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Knowledge> ;
                                                                          rdfs:label "hasKnowledgePart"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledgeSkill
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledgeSkill> rdf:type owl:ObjectProperty ;
                                                                           owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isKnowledgeSkillFor> ;
                                                                           rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AtomicCompetence> ;
                                                                           rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KnowledgeSkill> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasMetadata
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasMetadata> rdf:type owl:ObjectProperty ;
                                                                     rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                     rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Metadata> ;
                                                                     rdfs:comment "This optional data element consists of embedded metadata about the RCD. This data element does not preclude the use of external metadata about the RCD. Such external metadata are not defined by RCD Standard."@en ;
                                                                     rdfs:label "hasMetadata"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasPrerequisiteCompetence
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasPrerequisiteCompetence> rdf:type owl:ObjectProperty ;
                                                                                   owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isPrerequisiteCompetenceFor> ;
                                                                                   rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task> ;
                                                                                   rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasProficiencyLevel
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasProficiencyLevel> rdf:type owl:ObjectProperty ;
                                                                             owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isProficiencyLevelFor> ;
                                                                             rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment> ;
                                                                             rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ProficiencyLevel> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasSkill
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasSkill> rdf:type owl:ObjectProperty ;
                                                                  owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isSkillFor> ;
                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                  rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasSkillPart
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasSkillPart> rdf:type owl:ObjectProperty ;
                                                                      rdfs:subPropertyOf <gufoi:hasComponent> ;
                                                                      owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isSkillPartOf> ;
                                                                      rdf:type owl:FunctionalProperty ;
                                                                      rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KnowledgeSkill> ;
                                                                      rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill> ;
                                                                      rdfs:label "hasSkillPart"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTargetCompetence
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTargetCompetence> rdf:type owl:ObjectProperty ;
                                                                             owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isTargetCompetenceFor> ;
                                                                             rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task> ;
                                                                             rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTask
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTask> rdf:type owl:ObjectProperty ;
                                                                 owl:inverseOf <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isTaskFor> ;
                                                                 rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment> ;
                                                                 rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTitle
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTitle> rdf:type owl:ObjectProperty ;
                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competence> ;
                                                                  rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString> ;
                                                                  rdfs:comment """This mandatory data element is a single, text label for the RCD. 
The label is a human-readable name for the RCD. 

Because different application domains may coincidentally define the same title for different competency definitions, the Identifier element, not the Title, shall be used to distinguish among RCDs. 

The Title element is intended to provide a title, only, and should not be used to provide descriptive detail in lieu of the Description element."""@en ;
                                                                  rdfs:label "hasTitle"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isActorFor
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isActorFor> rdf:type owl:ObjectProperty ;
                                                                    rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Actor> ;
                                                                    rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment> ;
                                                                    rdfs:label "isActorFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isAppliedSkillFor
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isAppliedSkillFor> rdf:type owl:ObjectProperty ;
                                                                           rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill> ;
                                                                           rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Knowledge> .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isAtomicCompetencePartOf
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isAtomicCompetencePartOf> rdf:type owl:ObjectProperty ;
                                                                                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                                                                                  rdfs:domain <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AtomicCompetence> ;
                                                                                  rdfs:range <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ComposedCompetence> ;
                                                                                  rdfs:label "isAtomicCompetencePartOf"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCognitiveActionVerbFor
