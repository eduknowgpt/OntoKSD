                                                                                                                                                       <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Predict> ,
                                                                                                                                                       <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Summarize> ;
                                                                       <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isSkillPartOf> <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KS1_IS_A3.1.1_C1> ,
                                                                                                                                              <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KS2_IS_A3.1.1_C2> ,
                                                                                                                                              <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KS5_IS_A3.1.1_C1> ;
                                                                       <http://purl.org/nemo/gufo#hasQualityValue> 2 ;
                                                                       <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#level> 2 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Use
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Use> rdf:type owl:NamedIndividual ,
                                                                      <http://purl.org/nemo/gufo#FunctionalComplex> ,
                                                                      <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb> ;
                                                             <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCognitiveActionVerbFor> <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Applying> ;
