                                                                                                         "Use"^^xsd:string ;
                                                             <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbDescription> "Employing knowledge or skills in a practical situation."^^xsd:string ;
                                                             <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbName> "Use"^^xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Vocabulary
<http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Vocabulary> rdf:type owl:NamedIndividual ,
