###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CA_Description
:LS_CC2020_CA_Description rdf:type owl:NamedIndividual ,
                                   :LangString ;
                          :language "en" ;
                          :string "Manage the design of a computer system for a manufacturer using appropriate tools, design digital circuits including the basic building blocks of Boolean algebra, computer numbering systems, data encoding, combinatorial and sequential elements." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CA_Title
:LS_CC2020_CA_Title rdf:type owl:NamedIndividual ,
                             :LangString ;
                    :language "en" ;
                    :string "CC2020 Example A: From Computer Engineering." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CB_Description
:LS_CC2020_CB_Description rdf:type owl:NamedIndividual ,
                                   :LangString ;
                          :language "en" ;
                          :string "Analyze and compare several networking topologies in terms of robustness, expandability, and throughput used within a cloud enterprise." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CB_Title
:LS_CC2020_CB_Title rdf:type owl:NamedIndividual ,
                             :LangString ;
                    :language "en" ;
                    :string "CC2020 Example B: From Information Technology." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CC_001_Description
:LS_CC2020_CC_001_Description rdf:type owl:NamedIndividual ,
                                       :LangString ;
                              :language "en" ;
                              :string "Identify and document system requirements by applying a known requirements elicitation technique in work sessions with stakeholders, using facilitative skills, as a contributing member of a requirements team." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CC_001_Title
:LS_CC2020_CC_001_Title rdf:type owl:NamedIndividual ,
                                 :LangString ;
                        :language "en" ;
                        :string "Software Requirements: Identify & Document." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CC_002_Description
:LS_CC2020_CC_002_Description rdf:type owl:NamedIndividual ,
                                       :LangString ;
                              :language "en" ;
                              :string "Analyze an enterprise architecture against an organizational business model. Consider several appropriate cloud service approaches. Substantiate the recommendation with cost-benefit details to present to management decision-makers." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CC_002_Title
:LS_CC2020_CC_002_Title rdf:type owl:NamedIndividual ,
                                 :LangString ;
                        :language "en" ;
                        :string "Cloud Services in Enterprise Architecture." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CC_003_Description
:LS_CC2020_CC_003_Description rdf:type owl:NamedIndividual ,
                                       :LangString ;
                              :language "en" ;
                              :string "Propose an enterprise architecture based on the organizational business model and consistent with the mission and objectives of the organization. The architecture should propose appropriate leading-edge technologies consistent with the organizational requirements." .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LS_CC2020_CC_003_Title
:LS_CC2020_CC_003_Title rdf:type owl:NamedIndividual ,
                                 :LangString ;
                        :language "en" ;
                        :string "Cloud Services in Enterprise Architecture: Composite." .


