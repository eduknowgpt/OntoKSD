@prefix : <http://www.semanticweb.org/edeyson/ontologies/2024/CCO#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/edeyson/ontologies/2024/CCO> .

<http://www.semanticweb.org/edeyson/ontologies/2024/CCO> rdf:type owl:Ontology ;
                                                          owl:imports gufo: ,
                                                                      <http://www.w3.org/2004/02/skos/core> .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#language
:language rdf:type owl:AnnotationProperty ;
          rdfs:range xsd:string ;
          rdfs:domain :LangString .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#lsLanguage
:lsLanguage rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#lsString
:lsString rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#string
:string rdf:type owl:AnnotationProperty ;
        rdfs:range xsd:string ;
        rdfs:domain :LangString .


###  http://www.w3.org/2002/07/owl#minQualifiedCardinality
owl:minQualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#qualifiedCardinality
owl:qualifiedCardinality rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  gufoi:hasComponent
<gufoi:hasComponent> rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#isComponentOf
gufo:isComponentOf rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#additionalMetadata
:additionalMetadata rdf:type owl:ObjectProperty ;
                    rdfs:domain :Metadata ;
                    rdfs:range :void .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasActionVerb
:hasActionVerb rdf:type owl:ObjectProperty ;
               owl:inverseOf :isActionVerbFor ;
               rdf:type owl:InverseFunctionalProperty ;
               rdfs:domain :BloomCognitiveSkill ;
               rdfs:range :ActionVerb ;
               rdfs:comment "Associates a Bloom's Cognitive Skill with its corresponding cognitive action verbs."@en ;
               rdfs:label "hasActionVerb"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasActor
:hasActor rdf:type owl:ObjectProperty ;
          owl:inverseOf :isActorFor ;
          rdfs:domain :Assessment ;
          rdfs:range :Actor ;
          rdfs:label "hasActor" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetencyArea
:hasCompetencyArea rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isCompetencyAreaFor ;
                   rdfs:domain :Competency ;
                   rdfs:range :CompetencyArea .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetencyAreaStatement
:hasCompetencyAreaStatement rdf:type owl:ObjectProperty ;
                            rdfs:domain :CompetencyArea ;
                            rdfs:range :LangString .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasCompetencyPart
:hasCompetencyPart rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <gufoi:hasComponent> ;
                   owl:inverseOf :isCompetencyPartOf ;
                   rdfs:domain :CompositeCompetency ;
                   rdfs:range :Competency ;
                   rdfs:label "hasCompetencyPart"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasContext
:hasContext rdf:type owl:ObjectProperty ;
            owl:inverseOf :isContextFor ;
            rdfs:domain :Task ;
            rdfs:range :Context .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDefinition
:hasDefinition rdf:type owl:ObjectProperty ;
               rdfs:domain :Competency ;
               rdfs:range :Definition ;
               rdfs:comment """This data element is a structured description that provides a formal definition of the competency,usually using attributes taken from a specific model of how a competency should be structured or defined.

This data element shall contain zero or one Model source elements and at least one Statement element. It may contain multiple Statement elements."""@en ;
               rdfs:label "hasDefinition"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDescription
:hasDescription rdf:type owl:ObjectProperty ;
                rdfs:domain :Competency ;
                rdfs:range :LangString ;
                rdfs:comment "This optinal data element is a human-readable description of the competency. It is an unstructured character string meant to be interpretable only by humans."@en ;
                rdfs:label "hasDescription"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasDisposition
:hasDisposition rdf:type owl:ObjectProperty ;
                owl:inverseOf :isDispositionFor ;
                rdfs:domain :Competency ;
                rdfs:range :Disposition .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasIdentifier
:hasIdentifier rdf:type owl:ObjectProperty ;
               rdfs:domain :Competency ;
               rdfs:range :LongIdentifier ;
               rdfs:comment """This mandatory data element is a globally unique label that identifies the RCD (Reusable Competency Definition). 
The label shall be unique across all systems that store or process the RCD."""@en ;
               rdfs:label "hasIdentifier"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledgePart
:hasKnowledgePart rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <gufoi:hasComponent> ;
                  owl:inverseOf :isKnowledgePartOf ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain :KnowledgeSkill ;
                  rdfs:range :Knowledge ;
                  rdfs:label "hasKnowledgePart"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasKnowledgeSkill
:hasKnowledgeSkill rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isKnowledgeSkillFor ;
                   rdfs:domain :AtomicCompetency ;
                   rdfs:range :KnowledgeSkill .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasMetadata
:hasMetadata rdf:type owl:ObjectProperty ;
             rdfs:domain :Competency ;
             rdfs:range :Metadata ;
             rdfs:comment "This optional data element consists of embedded metadata about the RCD. This data element does not preclude the use of external metadata about the RCD. Such external metadata are not defined by RCD Standard."@en ;
             rdfs:label "hasMetadata"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasPrerequisiteCompetency
:hasPrerequisiteCompetency rdf:type owl:ObjectProperty ;
                           owl:inverseOf :isPrerequisiteCompetencyFor ;
                           rdfs:domain :Task ;
                           rdfs:range :Competency .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasProficiencyLevel
:hasProficiencyLevel rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isProficiencyLevelFor ;
                     rdfs:domain :Assessment ;
                     rdfs:range :ProficiencyLevel .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasSkillPart
:hasSkillPart rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <gufoi:hasComponent> ;
              owl:inverseOf :isSkillPartOf ;
              rdf:type owl:FunctionalProperty ;
              rdfs:domain :KnowledgeSkill ;
              rdfs:range :Skill ;
              rdfs:label "hasSkillPart"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasStatement
:hasStatement rdf:type owl:ObjectProperty ;
              rdfs:domain :Definition ;
              rdfs:range :Statement ;
              rdfs:comment """Each instance of this data element is a description of a single characteristic of a Definition element. At least one Statement element is mandatory if a Definition element exists. 

A record of type Statement shall contain one or more of the elements defined in statement type. None of these elements is specifically required, but at least one shall be present."""@en ;
              rdfs:label "hasStatement"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasStatementID
:hasStatementID rdf:type owl:ObjectProperty ;
                rdfs:domain :Statement ;
                rdfs:range :LongIdentifier ;
                rdfs:comment """This conditionally mandatory data element is a label for the statement. This label shall be unique at least within the scope of the definition.

The RCD Standard does not specify how IDs are created, assigned, or resolved."""@en ;
                rdfs:label "hasStatementID"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasStatementText
:hasStatementText rdf:type owl:ObjectProperty ;
                  rdfs:domain :Statement ;
                  rdfs:range :LangString ;
                  rdfs:comment """This conditionally mandatory data element is an unstructured, textual description of those aspects of the RCD referred to by the Statement name element.

A competency free-form statement represents the competency in terms that are familiar and comprehensible to a wide audience, typically using a vocabulary familiar to, and that resonates with, the audience. The competency statement is then structurally augmented and amplified in the enumeration of knowledge, skills, and dispositions that complete the competency specification"""@en ;
                  rdfs:label "hasStatementText"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasStatementToken
:hasStatementToken rdf:type owl:ObjectProperty ;
                   rdfs:domain :Statement ;
                   rdfs:range :Vocabulary ;
                   rdfs:comment """This conditionally mandatory data element consists of a vocabulary token, along with an identifier of the token�s source, which allows the use of controlled terms (vocabularies) instead of, or along with, free-form statement text.

A record of type vocabulary shall contain both a Source element and a Value element. 

The Source element indicates the source of the token value. The Source element may be a URI that identifies a formal vocabulary definition. """@en ;
                   rdfs:label "hasStatementToken"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTargetCompetency
:hasTargetCompetency rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isTargetCompetencyFor ;
                     rdfs:domain :Task ;
                     rdfs:range :Competency .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTask
:hasTask rdf:type owl:ObjectProperty ;
         owl:inverseOf :isTaskFor ;
         rdfs:domain :Assessment ;
         rdfs:range :Task .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#hasTitle
:hasTitle rdf:type owl:ObjectProperty ;
          rdfs:domain :Competency ;
          rdfs:range :LangString ;
          rdfs:comment """This mandatory data element is a single, text label for the RCD. 
The label is a human-readable name for the RCD. 

Because different application domains may coincidentally define the same title for different competency definitions, the Identifier element, not the Title, shall be used to distinguish among RCDs. 

The Title element is intended to provide a title, only, and should not be used to provide descriptive detail in lieu of the Description element."""@en ;
          rdfs:label "hasTitle"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isActionVerbFor
:isActionVerbFor rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ActionVerb ;
                 rdfs:range :BloomCognitiveSkill .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isActorFor
:isActorFor rdf:type owl:ObjectProperty ;
            rdfs:domain :Actor ;
            rdfs:range :Assessment ;
            rdfs:label "isActorFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCompetencyAreaFor
:isCompetencyAreaFor rdf:type owl:ObjectProperty ;
                     rdfs:domain :CompetencyArea ;
                     rdfs:range :Competency .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isCompetencyPartOf
:isCompetencyPartOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf gufo:isComponentOf ;
                    rdfs:domain :Competency ;
                    rdfs:range :CompositeCompetency .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isContextFor
:isContextFor rdf:type owl:ObjectProperty ;
              rdfs:domain :Context ;
              rdfs:range :Task ;
              rdfs:label "isContextFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isDispositionFor
:isDispositionFor rdf:type owl:ObjectProperty ;
                  rdfs:domain :Disposition ;
                  rdfs:range :Competency ;
                  rdfs:label "isDispositionFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isKnowledgePartOf
:isKnowledgePartOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf gufo:isComponentOf ;
                   rdfs:domain :Knowledge ;
                   rdfs:range :KnowledgeSkill ;
                   rdfs:label "isKnowledgePartOf"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isKnowledgeSkillFor
:isKnowledgeSkillFor rdf:type owl:ObjectProperty ;
                     rdfs:domain :KnowledgeSkill ;
                     rdfs:range :AtomicCompetency ;
                     rdfs:label "isKnowledgeSkillFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isPrerequisiteCompetencyFor
:isPrerequisiteCompetencyFor rdf:type owl:ObjectProperty ;
                             rdfs:domain :Competency ;
                             rdfs:range :Task ;
                             rdfs:label "isPrerequisiteCompetenceFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isProficiencyLevelFor
:isProficiencyLevelFor rdf:type owl:ObjectProperty ;
                       rdfs:domain :ProficiencyLevel ;
                       rdfs:range :Assessment ;
                       rdfs:label "isProficiencyLefelFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isSkillPartOf
:isSkillPartOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf gufo:isComponentOf ;
               rdfs:domain :Skill ;
               rdfs:range :KnowledgeSkill ;
               rdfs:label "isSkillPartOf"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isTargetCompetencyFor
:isTargetCompetencyFor rdf:type owl:ObjectProperty ;
                       rdfs:domain :Competency ;
                       rdfs:range :Task ;
                       rdfs:label "isTargetCompetenceFor"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#isTaskFor
:isTaskFor rdf:type owl:ObjectProperty ;
           rdfs:domain :Task ;
           rdfs:range :Assessment ;
           rdfs:label "isTaskFor"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/nemo/gufo#hasQualityValue
gufo:hasQualityValue rdf:type owl:DatatypeProperty .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#additionalMetadata
:additionalMetadata rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf gufo:hasQualityValue .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#assessmentDate
:assessmentDate rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf gufo:hasQualityValue ;
                rdfs:domain :Assessment ;
                rdfs:range xsd:dateTime ;
                rdfs:label "assessmentDate"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#catalog
:catalog rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf gufo:hasQualityValue ;
         rdfs:domain :LongIdentifier ;
         rdfs:range xsd:string ;
         rdfs:label "catalog"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#competencyAreaStatement
:competencyAreaStatement rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf gufo:hasQualityValue .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#contextDescription
:contextDescription rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf gufo:hasQualityValue ;
                    rdfs:domain :Context ;
                    rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf gufo:hasQualityValue ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#dispositionName
:dispositionName rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf gufo:hasQualityValue ;
                 rdfs:domain :Disposition ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#entry
:entry rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf gufo:hasQualityValue ;
       rdfs:domain :LongIdentifier ;
       rdfs:range xsd:string ;
       rdfs:label "entry"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#knowledgeName
:knowledgeName rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf gufo:hasQualityValue ;
               rdfs:domain :Knowledge ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#knowledgeURI
:knowledgeURI rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf gufo:hasQualityValue ;
              rdfs:domain :Knowledge ;
              rdfs:range xsd:anyURI .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#language
:language rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf gufo:hasQualityValue .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#level
:level rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf gufo:hasQualityValue ;
       rdfs:domain :BloomCognitiveSkill ;
       rdfs:range xsd:int .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#levelValue
:levelValue rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf gufo:hasQualityValue ;
            rdfs:domain :ProficiencyLevel ;
            rdfs:range xsd:int .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#maxValue
:maxValue rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf gufo:hasQualityValue ;
          rdfs:range xsd:int ;
          rdfs:label "maxValue"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#minValue
:minValue rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf gufo:hasQualityValue ;
          rdfs:range xsd:int ;
          rdfs:label "minValue"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#modelSource
:modelSource rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf gufo:hasQualityValue ;
             rdfs:domain :Definition ;
             rdfs:range xsd:string ;
             rdfs:comment """This optional data element is the source of the model used for the competency definition.

The value of this data element should be sufficiently specific to avoid conflict with other source names; therefore, the value should be a Uniform Resource Identifier (URI). If the value of this data element is a URI, it may point to an actual document that defines the source formally.

Typically, the models that underlie this data element define competencies in terms of \"statement, conditions, criteria,\" \"proficiency, criteria, indicators,\" \"standards, performance indicators, outcomes,\" \"abilities, basic skills, content, process,\" and similar sets of statements."""@en ;
             rdfs:label "modelSource"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#rcdSchema
:rcdSchema rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf gufo:hasQualityValue ;
           rdfs:domain :Metadata ;
           rdfs:range xsd:string ;
           rdfs:comment "This optional data element is a label for the schema that defines and controls the RCD instance. If this data element is omitted from the RCD instance, then a value of  \"ieee.org/1484.20.1/2007\" shall be assumed."@en ;
           rdfs:label "rcdSchema"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#rcdSchemaVersion
:rcdSchemaVersion rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf gufo:hasQualityValue ;
                  rdfs:domain :Metadata ;
                  rdfs:range xsd:string ;
                  rdfs:comment """This optional data element describes the version of the schema described by the RCD schema element.
If this element is omitted, then a value of  \"1.0\" shall be assumed."""@en ;
                  rdfs:label "rcdSchemaVersion"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#skillDescription
:skillDescription rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf gufo:hasQualityValue ;
                  rdfs:domain :Skill ;
                  rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#skillLevel
:skillLevel rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf gufo:hasQualityValue ;
            rdfs:domain :Skill ;
            rdfs:range xsd:int ;
            rdfs:label "skillLevel"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#skillName
:skillName rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf gufo:hasQualityValue ;
           rdfs:domain :Skill ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#statementName
:statementName rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf gufo:hasQualityValue ;
               rdfs:domain :Statement ;
               rdfs:range xsd:string ;
               rdfs:comment """This conditionally mandatory data element is a name for the statement. This name shall be unique at least within the scope of the definition. 

Examples: \"Condition\", \"Action\", \"Standard\", \"Outcome\", and \"Criteria\". The characters in the string shall belong to the repertoire of ISO/IEC 10646."""@en ;
               rdfs:label "statementName"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#string
:string rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf gufo:hasQualityValue .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#taskDescription
:taskDescription rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf gufo:hasQualityValue ;
                 rdfs:domain :Task ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#taskStatement
:taskStatement rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf gufo:hasQualityValue ;
               rdfs:domain :Task ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#taskTitle
:taskTitle rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf gufo:hasQualityValue ;
           rdfs:domain :Task ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbDescription
:verbDescription rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf gufo:hasQualityValue ;
                 rdfs:domain :ActionVerb ;
                 rdfs:range xsd:string ;
                 rdfs:comment "A description of the cognitive action verb."@en ;
                 rdfs:label "verbDescription"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#verbName
:verbName rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf gufo:hasQualityValue ;
          rdfs:domain :ActionVerb ;
          rdfs:range xsd:string ;
          rdfs:comment "The name of the cognitive action verb."@en ;
          rdfs:label "verbName"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#vocabularySource
:vocabularySource rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf gufo:hasQualityValue ;
                  rdfs:domain :Vocabulary ;
                  rdfs:range xsd:string ;
                  rdfs:label "vocabularySource"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#vocabularyValue
:vocabularyValue rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf gufo:hasQualityValue ;
                 rdfs:domain :Vocabulary ;
                 rdfs:range xsd:string ;
                 rdfs:label "vocabularyValue"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/nemo/gufo#FunctionalComplex
gufo:FunctionalComplex rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Kind
gufo:Kind rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Relator
gufo:Relator rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Situation
gufo:Situation rdf:type owl:Class ;
               rdfs:comment """In GUFO, a Situation is an entity that captures a specific state of affairs involving objects, qualities, and relations at a particular time. It represents a context or a configuration of entities and their properties that holds under certain conditions. Situations can be used to model contexts, scenarios, and various configurations of entities in the world.

Key Characteristics of a Situation in GUFO
Temporal Aspect: Situations are temporally bound, meaning they are associated with a specific time or time interval.
Contextual: Situations provide a context for entities and their properties, indicating how things stand in a given configuration.
Relational: Situations often involve multiple entities and the relationships between them.
State of Affairs: Situations capture a specific state of affairs, which can include conditions, events, or states that are relevant in a particular context.""" .


###  http://purl.org/nemo/gufo#SituationType
gufo:SituationType rdf:type owl:Class .


###  http://purl.org/nemo/gufo#SubKind
gufo:SubKind rdf:type owl:Class .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ActionVerb
:ActionVerb rdf:type owl:Class ;
            rdfs:subClassOf gufo:FunctionalComplex ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isActionVerbFor ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Skill
                            ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Activity
:Activity rdf:type owl:Class ;
          rdfs:subClassOf :Task .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Actor
:Actor rdf:type owl:Class ;
       rdfs:subClassOf gufo:FunctionalComplex ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isActorFor ;
                         owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                         owl:onClass :Assessment
                       ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Analyzing
:Analyzing rdf:type owl:Class ;
           rdfs:subClassOf :Applying .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Apply
:Apply rdf:type owl:Class ;
       rdfs:subClassOf :Explain .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Applying
:Applying rdf:type owl:Class ;
          rdfs:subClassOf :Understanding .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf :CompetencyEvidence ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasActor ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Actor
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasProficiencyLevel ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ProficiencyLevel
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTask ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Task
                            ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AtomicCompetency
:AtomicCompetency rdf:type owl:Class ;
                  rdfs:subClassOf :Competency ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasKnowledgeSkill ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :KnowledgeSkill
                                  ] ;
                  owl:disjointWith :CompositeCompetency ;
                  rdfs:comment "A singular (atomic) competency specification might address the goals for a solitary job function or curricular element constructed from a suitable competency statement and K, S, and D components."@en ;
                  rdfs:label "AtomicCompetency"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Attitude
:Attitude rdf:type owl:Class ;
          rdfs:subClassOf :Disposition .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#BloomCognitiveSkill
:BloomCognitiveSkill rdf:type owl:Class ;
                     rdfs:subClassOf :Skill .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CCCompetencyArea
:CCCompetencyArea rdf:type owl:Class ;
                  rdfs:subClassOf :CompetencyArea .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CS2023
:CS2023 rdf:type owl:Class ;
        rdfs:subClassOf :Skill .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CSCompetencyArea
:CSCompetencyArea rdf:type owl:Class ;
                  rdfs:subClassOf :CompetencyArea ;
                  owl:disjointWith :ISCompetencyArea .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Competency
:Competency rdf:type owl:Class ;
            rdfs:subClassOf gufo:FunctionalComplex ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDefinition ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onClass :Definition
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDisposition ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onClass :Disposition
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isCompetencyPartOf ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Competency
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isPrerequisiteCompetencyFor ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onClass :Task
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isTargetCompetencyFor ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onClass :Task
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasCompetencyArea ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :CompetencyArea
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasIdentifier ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :LongIdentifier
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTitle ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :LangString
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDescription ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :LangString
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasMetadata ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Metadata
                            ] ;
            owl:disjointUnionOf ( :AtomicCompetency
                                  :CompositeCompetency
                                ) ;
            rdfs:comment """A competency specification enumerates knowledge, skills, and dispositions that are observable in the accomplishment of a task, a task that prescribes purpose within a work context.

A competence is defined as the ability to mobilize and integrate knowledge, skills, attitudes, and values in real and varied contexts to perform activities or solve problems effectively and ethically. This definition encompasses several components:

Knowledge: Theoretical and practical information that an individual possesses about a specific topic or area of study.

Skills: Practical and technical abilities that enable an individual to apply their knowledge in concrete situations.

Attitudes and Values: Emotional and behavioral dispositions that influence how an individual behaves and interacts with others, including aspects such as ethics, responsibility, empathy, and teamwork.

Context: The specific environment or situation where the competence is applied, which can range from an academic setting to a professional or everyday environment.

Competency-based education focuses on the development and assessment of these competencies in an integrated and contextualized manner, ensuring that students not only acquire theoretical knowledge but also know how to apply it practically and relevantly in real situations. This approach promotes continuous and adaptive learning, preparing individuals to face constant challenges and changes in the modern world."""@en ;
            rdfs:label "Competency"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetencyArea
:CompetencyArea rdf:type owl:Class ;
                rdfs:subClassOf gufo:FunctionalComplex ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isCompetencyAreaFor ;
                                  owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Competency
                                ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompetencyEvidence
:CompetencyEvidence rdf:type owl:Class ;
                    rdfs:subClassOf gufo:FunctionalComplex .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CompositeCompetency
:CompositeCompetency rdf:type owl:Class ;
                     rdfs:subClassOf :Competency ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasCompetencyPart ;
                                       owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Competency
                                     ] ;
                     rdfs:comment """Composite competency specifications unfold as tree structures with branch and leaf
nodes. 

A composite competency specification (C) may combine (aggregate) both atomic (A) and other composite (C) competencies."""@en ;
                     rdfs:label "CompositeCompetency"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ComputingKnowledge
:ComputingKnowledge rdf:type owl:Class ;
                    rdfs:subClassOf :Knowledge .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Context
:Context rdf:type owl:Class ;
         rdfs:subClassOf gufo:Situation ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isContextFor ;
                           owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                           owl:onClass :Task
                         ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Creating
:Creating rdf:type owl:Class ;
          rdfs:subClassOf :Evaluating .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Definition
:Definition rdf:type owl:Class ;
            rdfs:subClassOf gufo:FunctionalComplex ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasStatement ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Statement
                            ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Develop
:Develop rdf:type owl:Class ;
         rdfs:subClassOf :Evaluate .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Disposition
:Disposition rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isDispositionFor ;
                               owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                               owl:onClass :Competency
                             ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#EducationalResource
:EducationalResource rdf:type owl:Class ;
                     rdfs:subClassOf :Task .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Evaluate
:Evaluate rdf:type owl:Class ;
          rdfs:subClassOf :Apply .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Evaluating
:Evaluating rdf:type owl:Class ;
            rdfs:subClassOf :Analyzing .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Explain
:Explain rdf:type owl:Class ;
         rdfs:subClassOf :CS2023 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#FoundationalProfessionalKnowledge
:FoundationalProfessionalKnowledge rdf:type owl:Class ;
                                   rdfs:subClassOf :Knowledge .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ISCompetencyArea
:ISCompetencyArea rdf:type owl:Class ;
                  rdfs:subClassOf :CompetencyArea .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Knowledge
:Knowledge rdf:type owl:Class ;
           rdfs:subClassOf gufo:FunctionalComplex ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isKnowledgePartOf ;
                             owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                             owl:onClass :KnowledgeSkill
                           ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#KnowledgeSkill
:KnowledgeSkill rdf:type owl:Class ;
                rdfs:subClassOf gufo:FunctionalComplex ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isKnowledgeSkillFor ;
                                  owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                  owl:onClass :AtomicCompetency
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasKnowledgePart ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Knowledge
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasSkillPart ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Skill
                                ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LangString
:LangString rdf:type owl:Class ;
            rdfs:subClassOf gufo:FunctionalComplex ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :language ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :string ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LongIdentifier
:LongIdentifier rdf:type owl:Class ;
                rdfs:subClassOf gufo:FunctionalComplex ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :catalog ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :entry ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ;
                rdfs:comment """This data type is an identifier (a label) that is intended to be unique among all contexts in which the identifier may be used. 

The Catalog element is the name or designator of the identification or cataloging
scheme for this entry, in other words, a namespace-scheme. 

The Entry element is the value of the identifier within the identification or cataloging scheme that designates or identifies this RCD, in other words, a namespace-specific string.

The catalog and entry values may be concatenated as a single character string in an
application profile or binding. If the catalog and entry values are concatenated, the resulting character string shall be a globally unique identifier in the form of a URI. The identifier shall be unique across all systems that store or process the RCD. The total length of a concatenated identifier shall be no longer than 4000 characters."""@en ;
                rdfs:label "LongIdentifier"@en .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#LongIdentifierType
:LongIdentifierType rdf:type owl:Class .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Metadata
:Metadata rdf:type owl:Class ;
          rdfs:subClassOf gufo:FunctionalComplex .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#ProficiencyLevel
:ProficiencyLevel rdf:type owl:Class ;
                  rdfs:subClassOf gufo:FunctionalComplex ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isProficiencyLevelFor ;
                                    owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Assessment
                                  ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Remembering
:Remembering rdf:type owl:Class ;
             rdfs:subClassOf :BloomCognitiveSkill .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Skill
:Skill rdf:type owl:Class ;
       rdfs:subClassOf gufo:FunctionalComplex ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasActionVerb ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :ActionVerb
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isSkillPartOf ;
                         owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                         owl:onClass :KnowledgeSkill
                       ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Statement
:Statement rdf:type owl:Class ;
           rdfs:subClassOf gufo:FunctionalComplex ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasStatementID ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :LongIdentifier
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasStatementText ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :LangString
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasStatementToken ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Vocabulary
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :statementName ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task
:Task rdf:type owl:Class ;
      rdfs:subClassOf gufo:FunctionalComplex ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasPrerequisiteCompetency ;
                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onClass :Competency
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasTargetCompetency ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Competency
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isTaskFor ;
                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onClass :Assessment
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasContext ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Context
                      ] .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Understanding
:Understanding rdf:type owl:Class ;
               rdfs:subClassOf :Remembering .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Vocabulary
:Vocabulary rdf:type owl:Class ;
            rdfs:subClassOf gufo:FunctionalComplex .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#void
:void rdf:type owl:Class .


