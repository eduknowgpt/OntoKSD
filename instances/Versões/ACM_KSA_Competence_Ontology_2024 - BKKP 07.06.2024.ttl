#    Individuals
#################################################################

###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AV1.0
:AV1.0 rdf:type owl:NamedIndividual ,
                :Assessment ;
       :assesses :Ana ;
       :hasProficiencyLevel :Competent ;
       :hasTask :T1 ;
       :isEvidenceFor :CE1.0 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AV1.1
:AV1.1 rdf:type owl:NamedIndividual ,
                :Assessment ;
       :assesses :Ana ;
       :hasProficiencyLevel :Proficient ;
       :hasTask :T2 ;
       :isEvidenceFor :CE1.1 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AV2.0
:AV2.0 rdf:type owl:NamedIndividual ,
                :Assessment ;
       :assesses :Bia ;
       :hasProficiencyLevel :Beginner ;
       :hasTask :T3 ;
       :isEvidenceFor :CE2.0 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AV5.0
:AV5.0 rdf:type owl:NamedIndividual ,
                :Assessment ;
       :assesses :Eve ;
       :hasProficiencyLevel :Competent ;
       :hasTask :T5 ;
       :isEvidenceFor :CE5.0 .


