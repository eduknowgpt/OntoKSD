    :hasTargetCompetence :CA4 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#T4
:T4 rdf:type owl:NamedIndividual ,
             :Task ;
    :hasTargetCompetence :Competence1 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#T5
:T5 rdf:type owl:NamedIndividual ,
             :Task ;
    :hasTargetCompetence :CC1 .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Task
:Task rdf:type owl:NamedIndividual ,
               gufo:Kind .


