:Appraise rdf:type owl:NamedIndividual ,
                   :CognitiveActionVerb ;
          :isActionVerbFor :Evaluating ;
          :verbDescription "Assessing the value or quality of something." ;
          :verbName "Appraise" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Argue
:Argue rdf:type owl:NamedIndividual ,
                :CognitiveActionVerb ;
       :isActionVerbFor :Evaluating ;
       :verbDescription "Presenting reasons for or against something." ;
       :verbName "Argue" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assemble
:Assemble rdf:type owl:NamedIndividual ,
                   :CognitiveActionVerb ;
          :isActionVerbFor :Creating ;
          :verbDescription "Putting together various elements." ;
          :verbName "Assemble" .


