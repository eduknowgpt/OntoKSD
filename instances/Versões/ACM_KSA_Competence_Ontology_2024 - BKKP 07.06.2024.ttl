:Check rdf:type owl:NamedIndividual ,
                :CognitiveActionVerb ;
       :isActionVerbFor :Evaluating ;
       :verbDescription "Assessing the validity of statements or arguments." ;
       :verbName "Check" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Classify
:Classify rdf:type owl:NamedIndividual ,
                   :CognitiveActionVerb ;
          :isActionVerbFor :Understanding ;
          :verbDescription "Grouping items into categories based on shared characteristics." ;
          :verbName "Classify" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CognitiveActionVerb
:CognitiveActionVerb rdf:type owl:NamedIndividual ,
                              gufo:Kind .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Collaborative
:Collaborative rdf:type owl:NamedIndividual ,
                        :Disposition ;
               rdfs:comment "The capability to work effectively within a team environment." ;
               rdfs:label "Collaborative" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Communicative
:Communicative rdf:type owl:NamedIndividual ,
                        :Disposition ;
