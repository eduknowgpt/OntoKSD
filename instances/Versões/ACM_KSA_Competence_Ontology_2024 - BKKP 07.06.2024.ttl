:Assess rdf:type owl:NamedIndividual ,
                 :CognitiveActionVerb ;
        :isActionVerbFor :Evaluating ;
        :verbDescription "Evaluating the nature or quality of something." ;
        :verbName "Assess" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Assessment
:Assessment rdf:type owl:NamedIndividual ,
                     gufo:Kind .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#AtomicCompetence
:AtomicCompetence rdf:type owl:NamedIndividual ,
                           gufo:SubKind .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Attitude
:Attitude rdf:type owl:NamedIndividual ,
                   gufo:SubKind .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Attribute
:Attribute rdf:type owl:NamedIndividual ,
                    :CognitiveActionVerb ;
           :isActionVerbFor :Analyzing ;
           :verbDescription "Determining the source or cause of something." ;
           :verbName "Attribute" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Beginner
:Beginner rdf:type owl:NamedIndividual ,
                   :ProficiencyLevel ;
          rdfs:comment """Description: The individual has a basic understanding and can perform simple tasks with some support. They are beginning to apply knowledge and skills in familiar contexts.
Characteristics: Can perform routine tasks, follows structured processes, and requires occasional assistance.
Example: A student who can write simple programs and debug basic errors with some help from a teacher or peers.""" ;
          <http://www.w3.org/2004/02/skos/core#hiddenLabel> "NP2" .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#Bia
:Bia rdf:type owl:NamedIndividual ,
              :Actor .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#BloomCognitiveSkill
:BloomCognitiveSkill rdf:type owl:NamedIndividual ,
                              gufo:SubKind .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CA1
:CA1 rdf:type owl:NamedIndividual ,
              :AtomicCompetence ;
     :hasDisposition :Collaborative ,
                     :Communicative ,
                     :Responsible ;
     :hasKnowledgeSkill :K1-Understanding ,
                        :K2-Applying .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CA2
:CA2 rdf:type owl:NamedIndividual ,
              :AtomicCompetence ;
     :hasDisposition :Creative ,
                     :Responsible ;
     :hasKnowledgeSkill :K1-Applying ,
                        :K2.1-Applying .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CA3
:CA3 rdf:type owl:NamedIndividual ,
              :AtomicCompetence ;
     :hasDisposition :Collaborative ,
                     :Creative ;
     :hasKnowledgeSkill :K1.1-Understanding .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CA4
:CA4 rdf:type owl:NamedIndividual ,
              :AtomicCompetence ;
     :hasDisposition :Communicative ,
                     :Responsible ;
     :hasKnowledgeSkill :K1.1-Applying ,
                        :K2.2-Applying .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CA5
:CA5 rdf:type owl:NamedIndividual ,
              :AtomicCompetence ;
     :hasDisposition :Collaborative ,
                     :Creative ;
     :hasKnowledgeSkill :K3-Remembering .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CC1
:CC1 rdf:type owl:NamedIndividual ,
              :ComposedCompetence ;
     :hasAtomicCompetence :CA1 ,
                          :CA3 ;
     :hasDisposition :Ethical .


###  http://www.semanticweb.org/edeyson/ontologies/2024/CCO#CE1.0
:CE1.0 rdf:type owl:NamedIndividual ,
                :CompetenceEvidence .


