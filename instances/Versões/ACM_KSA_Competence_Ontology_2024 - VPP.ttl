# Remember
:Recognize rdf:type :CognitiveActionVerbs ;
    :verbName "Recognize" ;
    :verbDescription "Identifying something previously learned." ;
    :hasCognitiveActionVerb :Remember .

:Recall rdf:type :CognitiveActionVerbs ;
    :verbName "Recall" ;
    :verbDescription "Retrieving relevant knowledge from long-term memory." ;
    :hasCognitiveActionVerb :Remember .

:List rdf:type :CognitiveActionVerbs ;
    :verbName "List" ;
    :verbDescription "Providing a series of related items." ;
    :hasCognitiveActionVerb :Remember .

:Define rdf:type :CognitiveActionVerbs ;
    :verbName "Define" ;
    :verbDescription "Stating the meaning of a term or concept." ;
    :hasCognitiveActionVerb :Remember .

:Describe rdf:type :CognitiveActionVerbs ;
    :verbName "Describe" ;
    :verbDescription "Giving a detailed account of something." ;
    :hasCognitiveActionVerb :Remember .

:Identify rdf:type :CognitiveActionVerbs ;
    :verbName "Identify" ;
    :verbDescription "Determining the identity of a subject or object." ;
    :hasCognitiveActionVerb :Remember .

:Retrieve rdf:type :CognitiveActionVerbs ;
    :verbName "Retrieve" ;
    :verbDescription "Recalling information from memory." ;
    :hasCognitiveActionVerb :Remember .

:Name rdf:type :CognitiveActionVerbs ;
    :verbName "Name" ;
    :verbDescription "Specifying the name of something." ;
    :hasCognitiveActionVerb :Remember .

:Label rdf:type :CognitiveActionVerbs ;
    :verbName "Label" ;
    :verbDescription "Assigning a label to something." ;
    :hasCognitiveActionVerb :Remember .

:Locate rdf:type :CognitiveActionVerbs ;
    :verbName "Locate" ;
    :verbDescription "Finding the position or place of something." ;
    :hasCognitiveActionVerb :Remember .

