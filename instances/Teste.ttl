@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com> .

<http://example.com> rdf:type owl:Ontology ;
                      owl:imports gufo: .

#################################################################
#    Object Properties
#################################################################

###  gufoi:hasComponent
<gufoi:hasComponent> rdf:type owl:ObjectProperty .


###  http://example.com#hasKnowledgePart
:hasKnowledgePart rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <gufoi:hasComponent> ;
                  owl:inverseOf :isKnowledgePartOf ;
                  rdfs:domain :KnowledgeSkill ;
                  rdfs:range :Knowledge ;
                  rdfs:label "hasKnowledgePart"@en .


###  http://example.com#hasSkillPart
:hasSkillPart rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <gufoi:hasComponent> ;
              owl:inverseOf :isSkillPartOf ;
              rdfs:domain :KnowledgeSkill ;
              rdfs:range :Skill ;
              rdfs:label "hasSkillPart"@en .


###  http://example.com#isKnowledgePartOf
:isKnowledgePartOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf gufo:isComponentOf ;
                   rdfs:domain :Knowledge ;
                   rdfs:range :KnowledgeSkill .


###  http://example.com#isSkillPartOf
:isSkillPartOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf gufo:isComponentOf ;
               rdfs:domain :Skill ;
               rdfs:range :KnowledgeSkill .


###  http://purl.org/nemo/gufo#isComponentOf
gufo:isComponentOf rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.com#Knowledge
:Knowledge rdf:type owl:Class ;
           rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#KnowledgeSkill
:KnowledgeSkill rdf:type owl:Class ;
                rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#Skill
:Skill rdf:type owl:Class ;
       rdfs:subClassOf gufo:FunctionalComplex .


###  http://purl.org/nemo/gufo#FunctionalComplex
gufo:FunctionalComplex rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Kind
gufo:Kind rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.com#Knowledge
:Knowledge rdf:type owl:NamedIndividual ,
                    gufo:Kind .


###  http://example.com#KnowledgeSkill
:KnowledgeSkill rdf:type owl:NamedIndividual ,
                         gufo:Kind .


###  http://example.com#Skill
:Skill rdf:type owl:NamedIndividual ,
                gufo:Kind .


###  http://example.com#k1
:k1 rdf:type owl:NamedIndividual ,
             :Knowledge .


###  http://example.com#k2
:k2 rdf:type owl:NamedIndividual ,
             :Knowledge .


###  http://example.com#ks1.1
:ks1.1 rdf:type owl:NamedIndividual ,
                :KnowledgeSkill ;
       :hasKnowledgePart :k1 ;
       :hasSkillPart :s1 .


###  http://example.com#s1
:s1 rdf:type owl:NamedIndividual ,
             :Skill .


###  http://example.com#s2
:s2 rdf:type owl:NamedIndividual ,
             :Skill .


#################################################################
