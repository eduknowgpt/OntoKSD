PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX bloom:     <http://example.org/bloom#>
PREFIX cs2013:    <http://purl.org/cs2013#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>

#############################
# 1) Upsert de KnowledgeSkill (KS)
#############################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cc2020fpk:ProblemSolving        		  ontoksd:analyzingSkill)
    (cs2013:Module_systems                    ontoksd:creatingSkill)
    (cs2013:Fundamental_Programming_Concepts  ontoksd:applyingSkill)
    (cs2013:Software_reuse                    ontoksd:applyingSkill)
  }
  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent     ?s .
  }
  BIND( IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks )
}.

#############################
# 2) Inserção da Competência EF69CO04
#############################

INSERT {
  ontoksd:competence_BNCC_EF69CO04 a ontoksd:Competence ;
    ontoksd:hasStructureType   ontoksd:Atomic ;
    ontoksd:hasCompetenceType  ontoksd:ComputingDomain ;
    dcterms:title        "Construir soluções de problemas usando a técnica de decomposição e automatizar tais soluções usando uma linguagem de programação"@pt ;
    dcterms:description  "Esta competência envolve a aplicação da técnica de decomposição para resolver problemas computacionais, dividindo-os em subproblemas gerenciáveis cujas soluções podem ser combinadas. O estudante deve estruturar a solução com clareza e autonomia, priorizando a reutilização e modularização. A automatização da solução ocorre por meio da implementação em linguagem de programação, reforçando o raciocínio computacional."@pt ;
    dcterms:source       "BNCC — Competência EF69CO04 (Ensino Fundamental, Anos Finais), com complementos para Computação"@pt ;
    skos:notation        "BNCC EF69CO04"@pt ;
    ontoksd:hasCompetenceElement ontoksd:creative ,
                                 ontoksd:responsible ,
                                 ontoksd:collaborative ,
                                 ontoksd:proactive .
}
WHERE {
}.

#############################
# 3) Vincular os KS criados à competência
#############################

INSERT {
  ontoksd:competence_BNCC_EF69CO04 ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  VALUES (?k ?s) {
    (cc2020fpk:ProblemSolving        		  ontoksd:analyzingSkill)
    (cs2013:Module_systems                    ontoksd:creatingSkill)
    (cs2013:Fundamental_Programming_Concepts  ontoksd:applyingSkill)
    (cs2013:Software_reuse                    ontoksd:applyingSkill)
  }
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}.

#############################
# 4) Verbos Bloom sugeridos para os pares KS
#############################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cc2020fpk:ProblemSolving        ontoksd:analyzingSkill    bloom:Decompose)
    (cc2020fpk:ProblemSolving        ontoksd:analyzingSkill    bloom:Analyze)

    (cs2013:Module_systems           ontoksd:creatingSkill     bloom:Structure)
    (cs2013:Module_systems           ontoksd:creatingSkill     bloom:Organize)

    (cs2013:Fundamental_Programming_Concepts ontoksd:applyingSkill     bloom:Implement)
    (cs2013:Fundamental_Programming_Concepts ontoksd:applyingSkill     bloom:Translate)

    (cs2013:Software_reuse                   ontoksd:applyingSkill     bloom:Reuse)
    (cs2013:Software_reuse                   ontoksd:applyingSkill     bloom:Adapt)
  }
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}.
