PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom:     <http://example.org/bloom#>
PREFIX cs2013:    <http://purl.org/cs2013#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>

#############################
# 1) Upsert de KnowledgeSkill (KS)
#############################

INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}
WHERE {
  VALUES (?k ?s) {
    (cc2020fpk:ProblemSolving      ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking  ontoksd:applyingSkill)
    (cs2013:Fundamental_Data_Structures      ontoksd:understandingSkill)
    (cs2013:Fundamental_Programming_Concepts ontoksd:creatingSkill)
  }
  FILTER NOT EXISTS {
    ?existing a ontoksd:KnowledgeSkill ;
              ontoksd:hasKnowledgeComponent ?k ;
              ontoksd:hasSkillComponent     ?s .
  }
  BIND( IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks )
}.


#############################
# 2) Inserção da Competência BNCC EF69CO03
#############################

INSERT {
  ontoksd:competence_BNCC_EF69CO03 a ontoksd:Competence ;
    ontoksd:hasStructureType   ontoksd:Atomic ;
    ontoksd:hasCompetenceType  ontoksd:ComputingDomain ;
    dcterms:title       "Descrever com precisão a solução de um problema, construindo o programa que implementa a solução descrita."@pt ;
    dcterms:description """Esta competência envolve a capacidade de expressar, com clareza e precisão, a solução de um problema computacional utilizando linguagem natural em alto nível de abstração, e posteriormente converter essa solução em um programa escrito em linguagem de programação. A ênfase está na compreensão de que o algoritmo é o núcleo do raciocínio computacional, e a programação é uma forma de tornar esse raciocínio executável por uma máquina. A competência é aplicada de forma individual ou colaborativa, envolvendo o uso apropriado de estruturas de dados como listas, registros, matrizes ou grafos."""@pt ;
    dcterms:source      "BNCC — Competência EF69CO03 (Ensino Fundamental Anos Finais), com complementos para Computação"@pt ;
    skos:notation       "BNCC EF69CO03"@pt ;
    ontoksd:hasCompetenceElement ontoksd:creative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive ,
                                 ontoksd:communicative ;
    skos:example "Se o ponteiro do mouse tocar no animal, então o animal andará 10 passos, 10 vezes seguidas."@pt ;
    skos:example "Dada uma pilha de cartas, se a pilha estiver vazia, dizer que não há ás; se a primeira carta for um ás, dizer que há ás na pilha; senão, remover a primeira carta e verificar se há ás no resto da pilha."@pt .
}
WHERE {
  # O vínculo com os KS será feito na próxima cláusula
}.

#############################
# 3) Vincular os KS criados à competência
#############################

INSERT {
  ontoksd:competence_BNCC_EF69CO03 ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  VALUES (?k ?s) {
    (cc2020fpk:ProblemSolving      ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking  ontoksd:applyingSkill)
    (cs2013:Fundamental_Data_Structures      ontoksd:understandingSkill)
    (cs2013:Fundamental_Programming_Concepts ontoksd:creatingSkill)
  }
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}.

#############################
# 4) Verbos sugeridos (Bloom)
#############################

INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cc2020fpk:ProblemSolving      ontoksd:applyingSkill     bloom:Design)
    (cc2020fpk:ProblemSolving      ontoksd:applyingSkill     bloom:Develop)
    
    (cc2020fpk:AnalyticalThinking  ontoksd:applyingSkill     bloom:Analyze)
    (cc2020fpk:AnalyticalThinking  ontoksd:applyingSkill     bloom:Differentiate)
    
    (cs2013:Fundamental_Data_Structures      ontoksd:understandingSkill bloom:Classify)
    (cs2013:Fundamental_Data_Structures      ontoksd:understandingSkill bloom:Select)
    
    (cs2013:Fundamental_Programming_Concepts ontoksd:creatingSkill       bloom:Construct)
    (cs2013:Fundamental_Programming_Concepts ontoksd:creatingSkill       bloom:Implement)
  }
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}.
