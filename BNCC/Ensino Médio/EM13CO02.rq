PREFIX ontoksd:   <http://purl.org/ontoksd#>
PREFIX dcterms:   <http://purl.org/dc/terms/>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX cs2013:    <http://purl.org/cs2013/>
PREFIX cc2020fpk: <http://purl.org/cc2020fpk/foundational#>
PREFIX bloom:     <http://example.org/bloom#>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>

############################################################
# 1) UPSERT dos pares Knowledge–Skill (KS) usados em EM13CO02
############################################################
INSERT {
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}
WHERE {
  VALUES (?k ?s) {
    # Engenharia de Requisitos
    (cs2013:Requirements_specification  ontoksd:applyingSkill)

    # Projeto de Software
    (cs2013:System_design_principles    ontoksd:applyingSkill)

    # Prototipação & Evolução
    (cs2013:Coding_practices            ontoksd:applyingSkill)
    (cs2013:Prototyping                 ontoksd:creatingSkill)
    (cs2013:Software_evolution          ontoksd:applyingSkill)

    # Fundamental & Profissional (FPK)
    (cc2020fpk:ProblemSolving           ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking       ontoksd:applyingSkill)  
  }
  FILTER NOT EXISTS {
    ?e a ontoksd:KnowledgeSkill ;
       ontoksd:hasKnowledgeComponent ?k ;
       ontoksd:hasSkillComponent     ?s .
  }
  BIND( IRI(CONCAT("http://purl.org/ontoksd#ks_", STRUUID())) AS ?ks )
}.

###############################################
# 2) Definição da competência EM13CO02 (integrada)
###############################################
INSERT {
  ontoksd:competence_BNCC_EM13CO02 a ontoksd:Competence ;
    ontoksd:hasStructureType   ontoksd:Atomic ;
    ontoksd:hasCompetenceType  ontoksd:ComputingDomain ;
    dcterms:title       "Explorar e construir a solução de problemas por meio de refinamentos, utilizando diversos níveis de abstração desde a especificação até a implementação (EM13CO02)"@pt ;
    dcterms:description "Esta competência envolve aplicar refinamentos sucessivos para solucionar problemas em Computação, operando em múltiplos níveis de abstração. No refinamento vertical, parte-se de requisitos → especificação → projeto → implementação → testes, assegurando rastreabilidade e coerência entre artefatos. No refinamento horizontal, evoluem-se protótipos em incrementos até um sistema funcional, incorporando requisitos priorizados, realizando avaliações contínuas (testes/qualidade) e ajustes (refatorações) com apoio de versionamento e colaboração. Exige justificar decisões, analisar trade-offs e evidenciar conformidade com as restrições do problema."@pt ;
    dcterms:source      "BNCC — EM13CO02 (complementos OntoKSD/CS2013/CC2020-FPK)"@pt ;
    skos:notation       "BNCC EM13CO02"@pt ;
    # Dispositions (use as que existem no seu vocabulário)
    ontoksd:hasCompetenceElement ontoksd:creative ,
                                 ontoksd:responsible ,
                                 ontoksd:proactive .
}.

##########################################################
# 3) Vincular todos os KS acima à competência EM13CO02
##########################################################
INSERT {
  ontoksd:competence_BNCC_EM13CO02 ontoksd:hasKnowledgeSkill ?ks .
}
WHERE {
  VALUES (?k ?s) {
    (cs2013:Requirements_specification  ontoksd:applyingSkill)
    (cs2013:System_design_principles    ontoksd:applyingSkill)
    (cs2013:Coding_practices            ontoksd:applyingSkill)
    (cs2013:Prototyping                 ontoksd:creatingSkill)
    (cs2013:Software_evolution          ontoksd:applyingSkill)
    (cc2020fpk:ProblemSolving           ontoksd:applyingSkill)
    (cc2020fpk:AnalyticalThinking       ontoksd:applyingSkill)
  }
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}.

##########################################################
# 4) Verbos sugeridos (opcional, úteis para enunciados)
##########################################################
INSERT {
  ?ks ontoksd:hasSuggestedVerb ?verb .
}
WHERE {
  VALUES (?k ?s ?verb) {
    (cs2013:Requirements_specification  ontoksd:applyingSkill   bloom:Specify)
    (cs2013:System_design_principles    ontoksd:applyingSkill   bloom:Design)
    (cs2013:Coding_practices            ontoksd:applyingSkill   bloom:Implement)
    (cs2013:Prototyping                 ontoksd:creatingSkill   bloom:Prototype)
    (cs2013:Software_evolution          ontoksd:applyingSkill   bloom:Iterate)
    (cc2020fpk:ProblemSolving           ontoksd:applyingSkill   bloom:Decompose)
    (cc2020fpk:AnalyticalThinking       ontoksd:applyingSkill   bloom:Compare)
  }
  ?ks a ontoksd:KnowledgeSkill ;
      ontoksd:hasKnowledgeComponent ?k ;
      ontoksd:hasSkillComponent     ?s .
}.















PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX gufo:    <http://purl.org/nemo/gufo#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

INSERT DATA {
  # ----------------- Tarefa (LearningTask) -----------------
  ontoksd:TASK_EM13CO02_REFINE_HS_01 a ontoksd:LearningTask ;
    ontoksd:hasAcquisitionContext ontoksd:contextBNCC_EM ;
    dcterms:title "Do esboço ao protótipo: catálogo de plantas da escola"@pt ;
    dcterms:description "A tarefa propõe criar, por refinamentos sucessivos, um catálogo de plantas do jardim da escola. O trabalho evidencia refinamento vertical (requisitos → especificação → projeto → implementação → testes) e horizontal (evolução de versões v0.1, v0.2, v0.3). Entregáveis: (1) requisitos com critérios de aceitação; (2) especificação simples (entradas/saídas) e fluxograma/pseudocódigo; (3) protótipo v0.1 (cadastrar e listar); (4) evolução v0.2 (busca/filtro) e v0.3 (editar/apagar ou exportar CSV); (5) 3–5 casos de teste com esperado/obtido; (6) README com changelog. Ferramentas sugeridas: Google Colab (Python) ou JavaScript (p5.js). Opcional: GitHub para versionamento."@pt ;
    dcterms:creator "Equipe docente"@pt ;
    dcterms:contributor "Turma do Ensino Médio"@pt .

  # -------- Associação de Competência (Relator gUFO opcional) --------
  ontoksd:TASK_EM13CO02_REFINE_HS_01_C a ontoksd:CompetenceAssociation, gufo:Relator ;
    ontoksd:mediatesInstructionalEntity ontoksd:TASK_EM13CO02_REFINE_HS_01 ;
    ontoksd:mediatesTargetCompetence   ontoksd:competence_BNCC_EM13CO02 ;
    dcterms:description "A tarefa requer que os estudantes apliquem refinamento vertical (requisitos → especificação → projeto → implementação → testes) e refinamento horizontal (evolução de protótipos em versões), mantendo rastreabilidade e documentação. O foco é justificar decisões, analisar trade-offs e demonstrar qualidade por testes simples."@pt .
}
