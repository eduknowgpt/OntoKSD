        cc2020foundconcept:WrittenCommunication ;
    skos:prefLabel "Professional Knowledge Elements"@en ;
    skos:scopeNote "An OntoKSD organizational subset, retained for compatibility. This allocation is a project interpretation, not an explicit subdivision asserted in CC2020 Table 4.2."@en .

cc2020found:AnalyticalThinking a ontoksd:Knowledge,
        owl:NamedIndividual ;
    rdfs:label "Analytical and Critical Thinking"@en ;
