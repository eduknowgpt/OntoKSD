# Reviewed against CC2020 Tables 4.1, 4.2, 4.4 and the published OntoKSD v7.
# INSERT DATA adds triples; use a clean vocabulary graph when replacing the old version.
# Definitions and modeling choices are OntoKSD interpretations, not report quotations.
# Load the current OntoKSD separately; this script creates no ontology classes or properties.

PREFIX cc2020found: <http://purl.org/cc2020/foundational#>
PREFIX cc2020foundconcept: <http://purl.org/cc2020/foundational/concept#>
PREFIX cc2020source: <http://purl.org/cc2020/source#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {
cc2020found:FoundationalKnowledgeCollection a skos:Collection ;
    skos:member cc2020foundconcept:AnalyticalThinking,
        cc2020foundconcept:MathematicsAndStatistics ;
    skos:prefLabel "Foundational Knowledge Elements"@en ;
    skos:scopeNote "An OntoKSD organizational subset, retained for compatibility. This allocation is a project interpretation, not an explicit subdivision asserted in CC2020 Table 4.2."@en .

cc2020found:ProfessionalKnowledgeCollection a skos:Collection ;
    skos:member cc2020foundconcept:Collaboration,
        cc2020foundconcept:EthicalPerspectives,
        cc2020foundconcept:MultiTaskPrioritizationAndManagement,
        cc2020foundconcept:OralCommunication,
        cc2020foundconcept:ProblemSolvingAndTroubleshooting,
