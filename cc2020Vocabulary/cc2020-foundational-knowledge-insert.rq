    dcterms:references cc2020source:Table4_2 ;
    dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> ;
    ontoksd:hasKnowledgeType ontoksd:foundationalKnowledgeType ;
    skos:definition "Knowledge of principles and methods for decomposing information, examining assumptions, and evaluating evidence and alternatives."@en ;
    skos:scopeNote "OntoKSD interprets this source entry as knowledge about relevant concepts, principles, and methods. This does not assert a capability, a willingness to act, or learner attainment. The foundational/professional type allocation is project-specific."@en .

