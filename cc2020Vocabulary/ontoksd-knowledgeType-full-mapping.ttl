<http://purl.org/ontoksd/mapping/knowledge>
    a owl:Ontology ;
    rdfs:label "Mapping of CC2020 Knowledge Concepts to OntoKSD KnowledgeType"@en ;
    rdfs:comment "Links each CC2020 knowledge concept to its corresponding KnowledgeType category in OntoKSD."@en .

