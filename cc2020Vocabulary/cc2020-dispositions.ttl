@prefix disp: <http://purl.org/cc2020/disposition#> .
@prefix ontoksd: <http://purl.org/ontoksd#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<http://purl.org/cc2020/disposition>
    a owl:Ontology ;
    rdfs:label "CC2020 Dispositions ABox"@en ;
    rdfs:comment "Assertional knowledge (instances) for dispositions proposed in the CC2020 report, linked to OntoKSD ontology."@en .

ontoksd:Adaptable a ontoksd:Disposition ;
    rdfs:label "Adaptable"@en ;
    rdfs:comment "The ability to adjust effectively to new situations and changes."@en .

ontoksd:Collaborative a ontoksd:Disposition ;
    rdfs:label "Collaborative"@en ;
    rdfs:comment "The capability to work effectively within a team environment."@en .

ontoksd:Communicative a ontoksd:Disposition ;
    rdfs:label "Communicative"@en ;
    rdfs:comment "Proficiency in clearly conveying information and ideas."@en .

ontoksd:Creative a ontoksd:Disposition ;
    rdfs:label "Creative"@en ;
    rdfs:comment "The talent for generating innovative ideas and solutions."@en .

ontoksd:Ethical a ontoksd:Disposition ;
    rdfs:label "Ethical"@en ;
    rdfs:comment "A commitment to ethical principles and conduct."@en .

ontoksd:Inclusive a ontoksd:Disposition ;
    rdfs:label "Inclusive"@en ;
    rdfs:comment "Promoting diversity and inclusiveness in all activities."@en .

ontoksd:LifelongLearner a ontoksd:Disposition ;
    rdfs:label "Lifelong Learner"@en ;
    rdfs:comment "A dedication to continuous learning and self-improvement."@en .

ontoksd:Professional a ontoksd:Disposition ;
    rdfs:label "Professional"@en ;
    rdfs:comment "Demonstrating professional behavior and work ethics."@en .

ontoksd:Resilient a ontoksd:Disposition ;
    rdfs:label "Resilient"@en ;
    rdfs:comment "The ability to recover quickly from setbacks and persist in the face of challenges."@en .

ontoksd:Responsible a ontoksd:Disposition ;
    rdfs:label "Responsible"@en ;
    rdfs:comment "Taking ownership of one's actions and their consequences."@en .

ontoksd:SelfDirected a ontoksd:Disposition ;
    rdfs:label "Self-directed"@en ;
    rdfs:comment "The ability to set goals, manage time effectively, and independently drive one's own learning and work."@en .
