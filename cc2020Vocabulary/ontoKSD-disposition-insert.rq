# Reviewed against CC2020 Tables 4.1, 4.2, 4.4 and the published OntoKSD v7.
# INSERT DATA adds triples; use a clean vocabulary graph when replacing the old version.
# Definitions and modeling choices are OntoKSD interpretations, not report quotations.
# Load the current OntoKSD separately; this script creates no ontology classes or properties.

PREFIX cc2020source: <http://purl.org/cc2020/source#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ontoksd: <http://purl.org/ontoksd#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

INSERT DATA {
ontoksd:adaptable a ontoksd:Disposition,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Adaptable"@en ;
    dcterms:identifier "adaptable" ;
    dcterms:references cc2020source:Table4_4 ;
    dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> ;
    skos:definition "A disposition characterized by openness and readiness to adjust effectively to new situations, evolving requirements, and changing conditions."@en ;
    skos:inScheme ontoksd:CC2020CoreDispositionScheme ;
    skos:prefLabel "Adaptable"@en ;
    skos:scopeNote "A reusable specification-level disposition, not a psychological property attributed to a learner or evidence of its demonstration. Definitions are OntoKSD glosses. This entry is explicitly listed in CC2020 Table 4.4."@en ;
    skos:topConceptOf ontoksd:CC2020CoreDispositionScheme .

ontoksd:analytical a ontoksd:Disposition,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Analytical"@en ;
    dcterms:identifier "analytical" ;
    dcterms:source <http://purl.org/ontoksd/source/ontoksd-extension> ;
    skos:definition "A specified inclination to examine parts, relationships, assumptions, and evidence carefully when approaching a problem or solution."@en ;
    skos:inScheme ontoksd:OntoKSDExtendedDispositionScheme ;
    skos:prefLabel "Analytical"@en ;
    skos:scopeNote "A reusable specification-level disposition, not a psychological property attributed to a learner or evidence of its demonstration. Definitions are OntoKSD glosses. This entry is an OntoKSD extension and is not separately listed in CC2020 Table 4.4."@en ;
    skos:topConceptOf ontoksd:OntoKSDExtendedDispositionScheme .

ontoksd:careful a ontoksd:Disposition,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Careful"@en ;
    dcterms:identifier "careful" ;
    dcterms:source <http://purl.org/ontoksd/source/ontoksd-extension> ;
    skos:definition "A disposition characterized by caution, attention to constraints, and concern for avoiding errors in interpretation, implementation, validation, or execution."@en ;
    skos:inScheme ontoksd:OntoKSDExtendedDispositionScheme ;
    skos:prefLabel "Careful"@en ;
    skos:scopeNote "A reusable specification-level disposition, not a psychological property attributed to a learner or evidence of its demonstration. Definitions are OntoKSD glosses. This entry is an OntoKSD extension and is not separately listed in CC2020 Table 4.4."@en ;
    skos:topConceptOf ontoksd:OntoKSDExtendedDispositionScheme .

ontoksd:collaborative a ontoksd:Disposition,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Collaborative"@en ;
    dcterms:identifier "collaborative" ;
    dcterms:references cc2020source:Table4_4 ;
    dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> ;
    skos:definition "A disposition characterized by willingness to work constructively with others, contribute to shared goals, and engage productively in team-based contexts."@en ;
    skos:inScheme ontoksd:CC2020CoreDispositionScheme ;
    skos:prefLabel "Collaborative"@en ;
    skos:scopeNote "A reusable specification-level disposition, not a psychological property attributed to a learner or evidence of its demonstration. Definitions are OntoKSD glosses. This entry is explicitly listed in CC2020 Table 4.4."@en ;
    skos:topConceptOf ontoksd:CC2020CoreDispositionScheme .

ontoksd:communicative a ontoksd:Disposition,
        owl:NamedIndividual,
