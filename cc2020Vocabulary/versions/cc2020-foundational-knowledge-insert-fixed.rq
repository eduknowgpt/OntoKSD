PREFIX cc2020found: <http://purl.org/cc2020/foundational#>
PREFIX rdfs:       <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos:       <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:        <http://www.w3.org/2002/07/owl#>
PREFIX ontoksd:    <http://purl.org/ontoksd#>

INSERT DATA {

  <http://purl.org/cc2020/foundational>
      a owl:Ontology ;
      rdfs:label "CC2020 Foundational and Professional Knowledge Vocabulary"@en ;
      rdfs:comment "Assertional foundational and professional knowledge concepts derived from CC2020 Table 4.2, modeled as SKOS concepts and OntoKSD Knowledge individuals."@en .

  cc2020found:AnalyticalThinking a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with analyzing complex situations, breaking problems into manageable parts, and evaluating alternatives to support sound judgment and decision making."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "AnalyticalThinking" ;
      skos:prefLabel "Analytical and Critical Thinking"@en .

  cc2020found:Collaboration a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with collaborating effectively with others, coordinating contributions, and supporting shared work toward common goals."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "Collaboration" ;
      skos:prefLabel "Collaboration and Teamwork"@en .

  cc2020found:EthicalPerspectives a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with ethical and intercultural perspectives used to analyze problems in light of human values, social responsibility, and multiple viewpoints."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "EthicalPerspectives" ;
      skos:prefLabel "Ethical and Intercultural Perspectives"@en .

  cc2020found:MathAndStatistics a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with mathematical reasoning and statistical methods used to represent, analyze, and interpret quantitative information."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "MathAndStatistics" ;
      skos:prefLabel "Mathematics and Statistics"@en .

  cc2020found:Multitasking a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with prioritizing, coordinating, and managing multiple tasks effectively according to relevance, urgency, and available resources."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "Multitasking" ;
      skos:prefLabel "Multi-Task Prioritization and Management"@en .

  cc2020found:OralCommunication a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with presenting ideas orally in a clear, structured, and audience-aware way, including the effective use of supporting materials when appropriate."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "OralCommunication" ;
      skos:prefLabel "Oral Communication and Presentation"@en .

  cc2020found:ProblemSolving a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with identifying, analyzing, and resolving problems through systematic reasoning, troubleshooting, and solution-oriented decision making."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "ProblemSolving" ;
      skos:prefLabel "Problem Solving and Trouble Shooting"@en .

  cc2020found:ProjectOrganization a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with organizing, planning, and coordinating project and task structures in order to support effective execution and successful outcomes."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "ProjectOrganization" ;
      skos:prefLabel "Project and Task Organization and Planning"@en .

  cc2020found:QualityControl a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with quality assurance and control practices used to define standards, identify defects, and improve the reliability of processes and outputs."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "QualityControl" ;
      skos:prefLabel "Quality Assurance / Control"@en .

  cc2020found:RelationshipManagement a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with establishing, maintaining, and improving productive relationships with clients, collaborators, stakeholders, or partner organizations."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "RelationshipManagement" ;
      skos:prefLabel "Relationship Management"@en .

  cc2020found:SelfLearning a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with self-directed learning, initiative in pursuing new knowledge, and the capacity to begin and sustain inquiry or work with limited external prompting."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "SelfLearning" ;
      skos:prefLabel "Research and Self-Starter/Learner"@en .

  cc2020found:TimeManagement a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with planning, allocating, and using time effectively in order to work productively and meet commitments."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "TimeManagement" ;
      skos:prefLabel "Time Management"@en .

  cc2020found:WrittenCommunication a skos:Concept , ontoksd:Knowledge ;
      skos:definition "A knowledge area concerned with communicating effectively in written form for professional, academic, and organizational purposes."@en ;
      skos:inScheme cc2020found:FoundationalAndProfessionalKnowledgeScheme ;
      skos:notation "WrittenCommunication" ;
      skos:prefLabel "Written Communication"@en .

  cc2020found:FoundationalAndProfessionalKnowledgeScheme a skos:ConceptScheme ;
      rdfs:label "Foundational and Professional Knowledge Areas"@en .

}
