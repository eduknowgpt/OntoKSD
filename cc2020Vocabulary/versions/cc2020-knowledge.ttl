@prefix cc2020: <http://purl.org/cc2020/knowledge#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ontoksd: <http://purl.org/ontoksd#> .

<http://purl.org/cc2020/knowledge>
    a owl:Ontology ;
    rdfs:label "CC2020 Knowledge ABox"@en ;
    rdfs:comment "Assertional knowledge (instances) for CC2020 in the OntoKSD ontology."@en .
	
cc2020:ArchitectureandOrganization a skos:Concept, ontoksd:Knowledge ;
    skos:inScheme cc2020:Hardware ;
    skos:notation "ArchitectureandOrganization" ;
    skos:prefLabel "Architecture and Organization"@en .

