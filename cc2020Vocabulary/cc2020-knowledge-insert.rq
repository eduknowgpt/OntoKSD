PREFIX cc2020:     <http://purl.org/cc2020/knowledge#>
PREFIX rdfs:       <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos:       <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:        <http://www.w3.org/2002/07/owl#>
PREFIX ontoksd:    <http://purl.org/ontoksd#>
PREFIX dcterms:    <http://purl.org/dc/terms/>


INSERT DATA {

<http://purl.org/cc2020/knowledge>
    a owl:Ontology ;
    rdfs:label "CC2020 Illustrative Computing Knowledge Vocabulary"@en ;
    rdfs:comment """A simplified illustrative vocabulary of computing knowledge concepts derived from the knowledge examples presented in CC2020.

	This ontology layer was created to support the specification of example competences in OntoKSD by providing a lightweight set of knowledge instances aligned with the competency-oriented perspective of CC2020. The represented items are modeled both as SKOS concepts and as OntoKSD Knowledge individuals in order to support semantic organization and direct reuse in competence specification.

	Unlike the CS2023 Body of Knowledge layer, this vocabulary is not intended as a full curricular reconstruction or as a formally separated curricular-semantic alignment model. Rather, it functions as a pragmatic and illustrative knowledge layer derived from the examples provided in CC2020, suitable for competence modeling, prototyping, and demonstration purposes."""@en ;
    dcterms:title "CC2020 Illustrative Computing Knowledge Vocabulary"@en ;
    dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .
	  
	  
	  

  cc2020:UsersAndOrganizations a skos:ConceptScheme ;
	  rdfs:label "Users and Organizations"@en ;
	  skos:notation "1" ;
	  skos:definition "An organizational category in the simplified CC2020 illustrative knowledge vocabulary, corresponding to Category 1 in the ordered sequence of computing knowledge categories presented in CC2020 Table 4.1."@en ;
	  dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:SystemsModeling a skos:ConceptScheme ;
      rdfs:label "Systems Modeling"@en ;
      skos:notation "2" ;
      skos:definition "An organizational category in the simplified CC2020 illustrative knowledge vocabulary, corresponding to Category 2 in the ordered sequence of computing knowledge categories presented in CC2020 Table 4.1."@en ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:SystemsArchitectureAndInfrastructure a skos:ConceptScheme ;
      rdfs:label "Systems Architecture and Infrastructure"@en ;
      skos:notation "3" ;
      skos:definition "An organizational category in the simplified CC2020 illustrative knowledge vocabulary, corresponding to Category 3 in the ordered sequence of computing knowledge categories in CC2020 Table 4.1."@en ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:SoftwareDevelopment a skos:ConceptScheme ;
      rdfs:label "Software Development"@en ;
      skos:notation "4" ;
      skos:definition "An organizational category in the simplified CC2020 illustrative knowledge vocabulary, corresponding to Category 4 in the ordered sequence of computing knowledge categories in CC2020 Table 4.1."@en ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:SoftwareFundamentals a skos:ConceptScheme ;
      rdfs:label "Software Fundamentals"@en ;
      skos:notation "5" ;
      skos:definition "An organizational category in the simplified CC2020 illustrative knowledge vocabulary, corresponding to Category 5 in the ordered sequence of computing knowledge categories in CC2020 Table 4.1."@en ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:Hardware a skos:ConceptScheme ;
      rdfs:label "Hardware"@en ;
      skos:notation "6" ;
      skos:definition "An organizational category in the simplified CC2020 illustrative knowledge vocabulary, corresponding to Category 6 in the ordered sequence of computing knowledge categories in CC2020 Table 4.1."@en ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:ArchitectureAndOrganization a skos:Concept , ontoksd:Knowledge ;
      skos:prefLabel "Architecture and Organization"@en ;
      skos:notation "ArchitectureAndOrganization" ;
      skos:definition "A computing knowledge area concerned with computer architecture, machine organization, and the structural principles that govern computing systems."@en ;
      skos:inScheme cc2020:Hardware ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:CircuitsAndElectronics a skos:Concept , ontoksd:Knowledge ;
      skos:prefLabel "Circuits and Electronics"@en ;
      skos:notation "CircuitsAndElectronics" ;
      skos:definition "A computing knowledge area concerned with electronic circuits, digital and analog components, and the electrical foundations of computing systems."@en ;
      skos:inScheme cc2020:Hardware ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:ComputerNetworks a skos:Concept , ontoksd:Knowledge ;
      skos:prefLabel "Computer Networks"@en ;
      skos:notation "ComputerNetworks" ;
      skos:definition "A computing knowledge area concerned with network architectures, protocols, communication mechanisms, and interconnected systems."@en ;
      skos:inScheme cc2020:SystemsArchitectureAndInfrastructure ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:ComputingSystemsFundamentals a skos:Concept , ontoksd:Knowledge ;
      skos:prefLabel "Computing Systems Fundamentals"@en ;
      skos:notation "ComputingSystemsFundamentals" ;
      skos:definition "A computing knowledge area concerned with core principles of computing systems, including their structure, behavior, and interaction."@en ;
      skos:inScheme cc2020:SoftwareFundamentals ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:DataAndInformationManagement a skos:Concept , ontoksd:Knowledge ;
      skos:prefLabel "Data and Information Management"@en ;
      skos:notation "DataAndInformationManagement" ;
      skos:definition "A computing knowledge area concerned with data modeling, storage, retrieval, organization, governance, and management of information resources."@en ;
      skos:inScheme cc2020:SystemsModeling ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:DataStructuresAlgorithmsAndComplexity a skos:Concept , ontoksd:Knowledge ;
      skos:prefLabel "Data Structures, Algorithms and Complexity"@en ;
      skos:notation "DataStructuresAlgorithmsAndComplexity" ;
      skos:definition "A computing knowledge area concerned with data structures, algorithmic design, computational complexity, and performance trade-offs in problem solving."@en ;
      skos:inScheme cc2020:SoftwareFundamentals ;
      ontoksd:hasKnowledgeType ontoksd:computingSpecificKnowledgeType ;
      dcterms:source <https://www.acm.org/binaries/content/assets/education/curricula-recommendations/cc2020.pdf> .

  cc2020:DigitalDesign a skos:Concept , ontoksd:Knowledge ;
      skos:prefLabel "Digital Design"@en ;
      skos:notation "DigitalDesign" ;
      skos:definition "A computing knowledge area concerned with the design of digital systems, logic structures, and hardware-level representations of computation."@en ;
      skos:inScheme cc2020:Hardware ;
